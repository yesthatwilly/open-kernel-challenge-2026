+# ---------------------------------------------------------------------------------------------------------------
+# experts-rega-w2-epilogue-prefetch-bulk-store (w2st): the fsilu module's w2 (REGA_W2ST_EDITS) in two arms, rega_gemm
+# which 1 = (a) the early gs / sorted_ids loads only (route ids via a shared table, master's st.global scatter) and
+# which 2 = (b) the early loads + one 256-B cp.async.bulk store per route row. No nvcc build of its own: both arms are
+# compiled into the fsilu module (whose build seconds are printed). Per class, after fsilu's gates, on the align and
+# gather the judge path uses: exactness first (master's w2 vs (a) vs (b) on the same hs from the w13 the class
+# dispatches, y torch.equal into sentinel-filled buffers on random, skewed, one and fsilu's calibrated judge-like pop
+# routing, error word 0 and the w2 marker per launch; an arm that misses is dropped); then w2-alone one-launch graphs,
+# master / (a) / (b) in the same 2 rounds x 11 alternations, cold-L2 (256 MB read flush) and warm-L2, judge-like and
+# random (_rega_fsilu_bench). An arm passes when arm / master <= REGA_W2ST_RATIO in every round, L2 mode and routing;
+# the passing arm with the lower geomean is routed (high, ft) once the two-state replay check passes with it ON, else
+# master's w2. low (T=753, HBM-bound) is print-only, never routed, and gated last. state['rega_w2st_ok'][cls] is a
+# plain bool, state['rega_w2st_which'][cls] a plain int (0 master, 1 (a), 2 (b)). OFF when rega_fsilu_ext is None.
+# ---------------------------------------------------------------------------------------------------------------
+REGA_W2ST_TAG = "[rega-w2st]"
+REGA_W2ST_ORDER = ("high", "ft", "low")     # the routable classes first; low (print-only) last
+REGA_W2ST_ROUTABLE = ("high", "ft")
+REGA_W2ST_RATIO = 0.99                      # w2 alone, arm / master, every round, both L2 modes, both routings
+REGA_W2ST_ARMS = {1: "a", 2: "b"}           # rega_gemm which of the fsilu module -> arm label
+REGA_W2ST_EXACT_KINDS = ("random", "skewed", "one")   # + the judge-like pop routing
+REGA_W2ST_SENTINEL = -3.0                   # y prefill: unwritten rows must match master's too
+REGA_W2ST_STEP_DEADLINE_S = REGA_FSILU_STEP_DEADLINE_S   # no class step after this (prepare() seconds)
+REGA_W2ST_STATE_KEYS = REGA_FSILU_STATE_KEYS + ("rega_w2st_ok", "rega_w2st_which")
+
+
+def _rega_w2st_gemm(state, ext, which, hs, y, tabs):
+    """One w2 launch with the arguments _experts_rega passes: master's module (which 1) or the fsilu module's arm
+    (a) / (b) (which 1 / 2): hs -> y."""
+    bank, err, grid = state["rega_bank"], state["rega_err"], state["rega_grid"]
+    sorted_ids, block_experts, n_padded, num_slots = tabs
+    ext.rega_gemm(which, hs, bank["q2"], bank["gs2"], sorted_ids, block_experts, n_padded, num_slots,
+                  D_EXPERT // 128, D_EXPERT, y, grid, err)
+
+
+def _rega_w2st_hs(state, device, cls, tokens, kind, prenorm, gen):
+    """prepare() only: one routing's tables and xs (the judge path's align + gather), then hs from the w13 this class
+    dispatches (fsilu's when ON, else master's); error word 0 and the w13 marker. Returns (tables, hs, local)."""
+    x, tw, lids = _rega_case(tokens, kind, gen, device)
+    local = int((lids >= 0).sum())
+    tabs, xs = _rega_fsilu_tables(state, x, lids, prenorm, cls)
+    w13 = state["rega_fsilu_ext"] if state.get("rega_fsilu_ok", {}).get(cls, False) else state["rega_ext"]
+    hs = torch.zeros((xs.shape[0], D_EXPERT), device=device, dtype=torch.bfloat16)
+    err = state["rega_err"]
+    err.zero_()
+    _rega_fsilu_gemm(state, w13, 0, xs, hs, tabs)
+    torch.cuda.synchronize()
+    word, m13, _ = _rega_marks(err)
+    del x, tw, lids, xs
+    if word != 0 or m13 != REGA_MAGIC:
+        raise RuntimeError(f"{kind}: w13 left error word {word} marker {m13:#x}")
+    return tabs, hs, local
+
+
+def _rega_w2st_exact(state, device, cls, tokens, kind, prenorm, gen, arms):
+    """prepare() only, one routing: master's w2, then each arm, on the same hs into y buffers prefilled with the same
+    sentinel (so skipped sentinel / remote rows are compared too); each launch error word 0 and the w2 marker; each
+    arm's y torch.equal to master's. Returns (None or why master's own launch failed, {which: why} per arm that
+    missed, compact text)."""
+    tabs, hs, local = _rega_w2st_hs(state, device, cls, tokens, kind, prenorm, gen)
+    err, bad, ref = state["rega_err"], {}, None
+    runs = (("m", state["rega_ext"], 1),) + tuple((REGA_W2ST_ARMS[w], state["rega_fsilu_ext"], w) for w in arms)
+    try:
+        for lab, ext, which in runs:
+            y = torch.full((tabs[3], D_EXPERT), REGA_W2ST_SENTINEL, device=device, dtype=torch.bfloat16)
+            err.zero_()
+            _rega_w2st_gemm(state, ext, which, hs, y, tabs)
+            torch.cuda.synchronize()
+            word, _, m2 = _rega_marks(err)
+            if word != 0 or m2 != REGA_MAGIC:
+                why = f"{kind}: w2:{lab} left error word {word} ({REGA_ERR_TEXT.get(word, '?')}) marker {m2:#x}"
+                if ref is None:
+                    return why, bad, ""
+                bad[which] = why
+            elif ref is None:
+                ref = y
+            elif not torch.equal(y, ref):
+                bad[which] = f"{kind}: w2:{lab} y not bit-identical to master's ({int((y != ref).sum())} elements)"
+            y = None
+    finally:
+        del ref, hs
+        torch.cuda.empty_cache()
+    return None, bad, f"{kind} {local}r"
+
+
+def _rega_w2st_time(state, device, cls, tokens, kind, prenorm, gen, arms):
+    """prepare() only: one routing's hs (_rega_w2st_hs), one w2-alone CUDA graph per arm (w2:m = master's module, w2:a
+    / w2:b = the fsilu module's which 1 / 2) into one y, plus an empty graph, timed together by _rega_fsilu_bench,
+    cold-L2 and warm-L2, REGA_FSILU_ROUNDS x REGA_FSILU_ALTERNATIONS. Returns ({mode: [per-round {name: us}]}, local
+    routes)."""
+    tabs, hs, local = _rega_w2st_hs(state, device, cls, tokens, kind, prenorm, gen)
+    ms, fs, err = state["rega_ext"], state["rega_fsilu_ext"], state["rega_err"]
+    y = torch.zeros((tabs[3], D_EXPERT), device=device, dtype=torch.bfloat16)
+    fns = {"w2:m": lambda: _rega_w2st_gemm(state, ms, 1, hs, y, tabs)}
+    for w in arms:
+        fns[f"w2:{REGA_W2ST_ARMS[w]}"] = lambda w=w: _rega_w2st_gemm(state, fs, w, hs, y, tabs)
+    graphs = {}
+    err.zero_()
+    try:
+        graphs = {name: _ssdq_graph_time(fn, device) for name, fn in fns.items()}
+        tiny = torch.zeros(16, dtype=torch.float32, device=device)
+        graphs["empty"] = _ssdq_graph_time(lambda: tiny.zero_(), device)
+        res = _rega_fsilu_bench(graphs, device, ("cold", "warm"), REGA_FSILU_ROUNDS, REGA_FSILU_ALTERNATIONS)
+        word = _rega_marks(err)[0]
+        if word != 0:
+            raise RuntimeError(f"timing replays left error word {word} ({REGA_ERR_TEXT.get(word, '?')})")
+        return res, local
+    finally:
+        del graphs, fns, hs, y
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+
+
+def _rega_w2st_verdict(res, arms):
+    """{mode: [per-round {name: us}]} -> ({which: [arm / master per round and mode]}, compact text: per mode the
+    round-mean us of master and each arm, and each arm's per-round ratios)."""
+    ratios, parts = {w: [] for w in arms}, []
+    for mode, rds in res.items():
+        n = max(len(rds), 1)
+        seg = f"{mode} m {sum(rd['w2:m'] for rd in rds) / n:.1f}"
+        for w in arms:
+            k = f"w2:{REGA_W2ST_ARMS[w]}"
+            r = [rd[k] / max(rd["w2:m"], 1e-9) for rd in rds]
+            ratios[w] += r
+            seg += f" {REGA_W2ST_ARMS[w]} {sum(rd[k] for rd in rds) / n:.1f} x{'/'.join(f'{v:.3f}' for v in r)}"
+        parts.append(seg)
+    return ratios, "; ".join(parts)
+
+
+def _rega_w2st_class(state, device, cls, weights, lines, t_start, info, arms):
+    """prepare() only: one class's checks and gate; (routed which or 0, reason). 1. the judge-like pop routing
+    (fsilu's calibrated alpha for this class, else calibrated here on master's w13); 2. exactness on random, skewed,
+    one and that routing (_rega_w2st_exact; a missing arm is dropped); 3. timing (_rega_w2st_time, cold + warm,
+    judge-like + random, master / (a) / (b) in the same alternations); 4. for a routable class with a passing arm,
+    the two-state replay check with that arm ON. No step starts after REGA_W2ST_STEP_DEADLINE_S. The low class
+    returns 0 (print-only) whatever its gate says."""
+    tokens = REGA_FSILU_TOKENS[cls]
+    tag = f"{REGA_W2ST_TAG} {cls} T={tokens}"
+    prenorm = bool(state.get("norm_gather_ok", {}).get(cls, False))
+    gen = torch.Generator(device=device).manual_seed(20261104)
+    arms = list(arms)
+
+    def late(step):
+        used = time.perf_counter() - t_start
+        if used > REGA_W2ST_STEP_DEADLINE_S:
+            return f"SKIPPED: {step} not started (prepare {used:.0f}s > {REGA_W2ST_STEP_DEADLINE_S:.0f}s)"
+        return None
+
+    # 1. the judge-like routing
+    alpha, src = info.get("alpha", {}).get(cls), "fsilu's"
+    if alpha is None:
+        why = late("alpha calibration")
+        if why:
+            return 0, why
+        alpha, src = _rega_fsilu_calibrate(state, device, cls, tokens, prenorm, gen)[0], "calibrated here"
+    pop_kind = f"pop:{alpha:g}"
+    # 2. exactness
+    parts, misses = [], []
+    for kind in REGA_W2ST_EXACT_KINDS + (pop_kind,):
+        why = late(f"exactness {kind}")
+        if why:
+            return 0, why
+        why, bad, text = _rega_w2st_exact(state, device, cls, tokens, kind, prenorm, gen, arms)
+        if why:
+            lines.append(f"{tag} exact: master's w2 launch failed: {why}"[:500])
+            print(lines[-1], flush=True)
+            return 0, f"master's w2 launch failed ({why})"
+        for w, b in bad.items():
+            arms.remove(w)
+            misses.append(f"arm {REGA_W2ST_ARMS[w]} DROPPED: {b}")
+        parts.append(text)
+        if not arms:
+            break
+    lines.append(f"{tag} exact (y torch.equal master's, word 0, w2 marker; {pop_kind} = {src} judge-like alpha; "
+                 f"prenorm {prenorm}): " + ", ".join(parts) + ("; " + "; ".join(misses) if misses else "; a, b pass"))
+    print(lines[-1], flush=True)
+    if not arms:
+        return 0, "no arm is bit-identical to master's w2"
+    # 3. timing: w2 alone, master / arms, cold + warm, judge-like then random
+    ratios = {w: [] for w in arms}
+    for kind in (pop_kind, "random"):
+        why = late(f"timing {kind}")
+        if why:
+            return 0, why
+        res, local = _rega_w2st_time(state, device, cls, tokens, kind, prenorm, gen, arms)
+        r, text = _rega_w2st_verdict(res, arms)
+        for w in arms:
+            ratios[w] += r[w]
+        lines.append(f"{tag} TIME {kind} {local}r: {text}")
+        print(lines[-1], flush=True)
+    need = 2 * 2 * REGA_FSILU_ROUNDS
+    geo = {w: _prod(r) ** (1.0 / max(len(r), 1)) for w, r in ratios.items()}
+    passing = [w for w, r in ratios.items() if len(r) == need and all(v <= REGA_W2ST_RATIO for v in r)]
+    best = min(passing, key=lambda w: geo[w]) if passing else 0
+    lines.append(f"{tag} GATE arm/master <= {REGA_W2ST_RATIO} every round, cold+warm, {pop_kind}+random: "
+                 + ", ".join(f"{REGA_W2ST_ARMS[w]} gm x{geo[w]:.3f} max x{max(r, default=0.0):.3f} "
+                             f"{'pass' if w in passing else 'MISS'}" for w, r in ratios.items())
+                 + f"; best {REGA_W2ST_ARMS.get(best, 'none')}")
+    print(lines[-1], flush=True)
+    if not best:
+        return 0, "timing gate missed by every arm"
+    if cls not in REGA_W2ST_ROUTABLE:
+        return 0, f"print-only (HBM-bound class): arm {REGA_W2ST_ARMS[best]} passed, never routed"
+    # 4. two-state replay check with the best arm ON for this class
+    why = late("replay check")
+    if why:
+        return 0, why
+    trial = dict(state)
+    trial["rega_w2st_ok"] = {c: c == cls for c in REGA_FSILU_CLASSES}
+    trial["rega_w2st_which"] = {c: (int(best) if c == cls else 0) for c in REGA_FSILU_CLASSES}
+    cache = {}
+    why, line = _rega_replay_check(trial, weights, cache, device, gen, plan=REGA_FSILU_REPLAY_PLAN[cls],
+                                   keys=REGA_W2ST_STATE_KEYS)
+    cache.clear()
+    torch.cuda.empty_cache()
+    if why:
+        return 0, f"two-state replay check failed: {why}"
+    print(f"{tag} two-state replay check (w2st arm {REGA_W2ST_ARMS[best]} ON): {line}", flush=True)
+    return int(best), ""
+
+
+def _prod(values):
+    out = 1.0
+    for v in values:
+        out *= v
+    return out
+
+
+def _rega_w2st_phase(state, weights, device, t_start, info):
+    """prepare() only, after _rega_fsilu_phase (info: its build seconds, w2 attribute rows and calibrated alphas).
+    OFF (reason line) when rega_fsilu_ext is None. Per class in REGA_W2ST_ORDER (on rega; low only when
+    rega_low_variant == 0, and print-only) _rega_w2st_class, restricted to the arms whose attribute rows passed.
+    Sets state['rega_w2st_ok'][class] (plain bools) and state['rega_w2st_which'][class] (plain ints). Never raises;
+    every miss leaves master's w2. Returns the compact summary lines; the PATH CHOSEN lines are last, each with
+    fsilu's own state for the class."""
+    t0 = time.perf_counter()
+    state["rega_w2st_ok"] = {c: False for c in REGA_FSILU_CLASSES}
+    state["rega_w2st_which"] = {c: 0 for c in REGA_FSILU_CLASSES}
+    lines, verdict, off, secs = [], {}, None, {}
+    v = int(state.get("rega_low_variant", 0))
+    fok = dict(state.get("rega_fsilu_ok", {}))
+    try:
+        routed = [c for c in REGA_W2ST_ORDER if state.get("rega_ok", {}).get(c, False)]
+        w2a = info.get("w2_attrs", {})
+        if state.get("rega_fsilu_ext") is None:
+            off = ("rega_fsilu_ext is None (fsilu OFF in every class, skipped or failed): the w2 arms live in that "
+                   "module")
+        elif not routed:
+            off = "no class is on rega (master's gates)"
+        else:
+            build_s = info.get("build_s", float("nan"))
+            lines.append(f"{REGA_W2ST_TAG} no build of its own: arms a/b compile into {REGA_FSILU_EXT_NAME} (6 "
+                         f"rega_kernel instantiations, was 4: that build {build_s:.1f}s); w2 attrs "
+                         + " ".join(f"{REGA_W2ST_ARMS[w]}{'ft' if b else 's1'} {'ok' if g else 'OFF'}"
+                                    for (w, b), g in sorted(w2a.items())))
+            print(lines[-1], flush=True)
+            stop = None
+            for cls in routed:
+                tc = time.perf_counter()
+                used = tc - t_start
+                arms = [w for w in REGA_W2ST_ARMS if w2a.get((w, cls == "ft"), False)]
+                if stop:
+                    verdict[cls] = (0, stop)
+                elif cls == "low" and v:
+                    verdict[cls] = (0, f"low runs rega_gemm_lo (rega_low_variant {v})")
+                elif not arms:
+                    verdict[cls] = (0, "attribute check failed for both w2 arms of this class")
+                elif used > REGA_W2ST_STEP_DEADLINE_S:
+                    verdict[cls] = (0, f"SKIPPED: deadline (prepare {used:.0f}s > {REGA_W2ST_STEP_DEADLINE_S:.0f}s)")
+                else:
+                    try:
+                        arm, why = _rega_w2st_class(state, device, cls, weights, lines, t_start, info, arms)
+                    except Exception as e:  # stop here: anything after a fault would be unreliable
+                        arm, why = 0, f"raised {e!r}"[:300]
+                        stop = f"an earlier class raised ({why[:80]})"
+                    if arm and cls in REGA_W2ST_ROUTABLE:
+                        state["rega_w2st_ok"][cls] = True
+                        state["rega_w2st_which"][cls] = int(arm)
+                    verdict[cls] = (int(arm), why)
+                state["rega_err"].zero_()
+                secs[cls] = time.perf_counter() - tc
+    except Exception as e:  # a device fault would have poisoned the context; anything else keeps master
+        off = f"w2st phase raised {e!r}"[:400]
+        state["rega_w2st_ok"] = {c: False for c in REGA_FSILU_CLASSES}
+        state["rega_w2st_which"] = {c: 0 for c in REGA_FSILU_CLASSES}
+    finally:
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+        if off:
+            lines.append(f"{REGA_W2ST_TAG} OFF: {off}")
+            print(lines[-1], flush=True)
+        lines.append(f"{REGA_W2ST_TAG} phase {time.perf_counter() - t0:.1f}s ("
+                     + ", ".join(f"{k} {s:.1f}s" for k, s in secs.items())
+                     + f"); prepare total {time.perf_counter() - t_start:.1f}s of 300s")
+        for cls in REGA_FSILU_CLASSES:
+            _, why = verdict.get(cls, (0, off or "class not on rega"))
+            w = int(state["rega_w2st_which"].get(cls, 0)) if state["rega_w2st_ok"].get(cls, False) else 0
+            chosen = {0: "master's w2", 1: "w2st a (early loads)", 2: "w2st b (early loads + bulk stores)"}[w]
+            lines.append(f"{REGA_W2ST_TAG} PATH CHOSEN {cls}: {chosen}" + (f" ({why[:160]})" if not w else "")
+                         + f"; fsilu={'ON' if fok.get(cls, False) else 'OFF'}"
+                         + (f"; rega_low_variant {v}" if cls == "low" else ""))
+        lines.append(f"{REGA_W2ST_TAG} PATH CHOSEN: rega_w2st_ok {state['rega_w2st_ok']} which "
+                     f"{state['rega_w2st_which']} (1 = a early gs/sid loads, 2 = b + bulk row stores; 0 = master's w2)")
+    return lines
+
+
 def kernel_fn(data, state):
     cfg = data["config"]
     batch, length, tokens = cfg["batch"], cfg["q_len"], cfg["tokens"]
