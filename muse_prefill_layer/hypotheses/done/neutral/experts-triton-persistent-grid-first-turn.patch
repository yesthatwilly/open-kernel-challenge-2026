+@triton.jit
+def _persistent_tile_coords(tile, num_pid_t, num_pid_w: tl.constexpr, GROUP_SIZE_T: tl.constexpr):
+    """Master's GROUP_SIZE_T swizzle of a linear tile id into (token tile, weight tile), with the
+    runtime num_pid_t. group_size_t is clamped to 1 so a tile id past the end (only ever used under
+    a false load mask) never divides by zero."""
+    num_pid_in_group = GROUP_SIZE_T * num_pid_w
+    group_id = tile // num_pid_in_group
+    first_pid_t = group_id * GROUP_SIZE_T
+    group_size_t = tl.maximum(min(num_pid_t - first_pid_t, GROUP_SIZE_T), 1)
+    pid_t = first_pid_t + ((tile % num_pid_in_group) % group_size_t)
+    pid_w = (tile % num_pid_in_group) // group_size_t
+    return pid_t, pid_w
+
+
+@triton.jit(do_not_specialize=["num_valid_tokens", "EM"])
+def _moe_nvfp4_gemm_persistent_kernel(
+    a_ptr, b_ptr, sf_ptr, gs_ptr, c_ptr, sorted_ids_ptr, expert_ids_ptr, n_padded_ptr,
+    num_valid_tokens, EM,
+    N: tl.constexpr, K: tl.constexpr, TOP_K: tl.constexpr,
+    BLOCK_T: tl.constexpr, BLOCK_W: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_SIZE_T: tl.constexpr,
+    ZERO_NONLOCAL: tl.constexpr,
+):
+    """_moe_nvfp4_gemm_kernel as a persistent grid (hypothesis experts-triton-persistent-grid-first-turn):
+    the grid is at most one program per SM and each strides over the tiles below the real padded
+    count (runtime n_padded), so the static-capacity tiles past it and nothing else never launch.
+    A -1 (remote) tile costs one scalar load: the next tile's expert id is prefetched at the loop
+    top, and sorted_ids is read only inside the live branch (and the zero-store). Same per-tile math
+    (_nvfp4_live_tile) and swizzle as the non-persistent kernel."""
+    pid = tl.program_id(axis=0)
+    nprog = tl.num_programs(axis=0)
+    num_tokens_post_padded = tl.load(n_padded_ptr)
+    num_pid_t = tl.cdiv(num_tokens_post_padded, BLOCK_T)
+    num_pid_w: tl.constexpr = N // BLOCK_W
+    num_tiles = num_pid_t * num_pid_w
+    first_t, first_w = _persistent_tile_coords(pid, num_pid_t, num_pid_w, GROUP_SIZE_T)
+    off_expert = tl.load(expert_ids_ptr + first_t, mask=pid < num_tiles, other=-1).to(tl.int64)
+    for tile in range(pid, num_tiles, nprog):
+        pid_t, pid_w = _persistent_tile_coords(tile, num_pid_t, num_pid_w, GROUP_SIZE_T)
+        nxt = tile + nprog
+        nxt_t, nxt_w = _persistent_tile_coords(nxt, num_pid_t, num_pid_w, GROUP_SIZE_T)
+        nxt_expert = tl.load(expert_ids_ptr + nxt_t, mask=nxt < num_tiles, other=-1).to(tl.int64)
+        if off_expert == -1:
+            # Routes to experts on other GPUs.
+            if ZERO_NONLOCAL:
+                offs_token_id = pid_t * BLOCK_T + tl.arange(0, BLOCK_T).to(tl.int64)
+                offs_token = tl.load(sorted_ids_ptr + offs_token_id).to(tl.int64)
+                token_mask = offs_token < num_valid_tokens
+                offs_w = pid_w * BLOCK_W + tl.arange(0, BLOCK_W)
+                c_ptrs = c_ptr + offs_token[None, :] * N + offs_w[:, None]
+                tl.store(c_ptrs, tl.zeros((BLOCK_W, BLOCK_T), dtype=c_ptr.dtype.element_ty),
+                         mask=token_mask[None, :])
+        else:
+            offs_token_id = pid_t * BLOCK_T + tl.arange(0, BLOCK_T).to(tl.int64)
+            offs_token = tl.load(sorted_ids_ptr + offs_token_id).to(tl.int64)
+            token_mask = offs_token < num_valid_tokens
+            _nvfp4_live_tile(a_ptr, b_ptr, sf_ptr, gs_ptr, c_ptr, offs_token, token_mask, off_expert, pid_w,
+                             N, K, TOP_K, BLOCK_T, BLOCK_W, BLOCK_K)
+        off_expert = nxt_expert
 
 
