+        print(f"[w2 zero-store] {'OFF (weighted sum skips remote slots)' if ok else 'ON: weighted sum reads remote rows'}",
+              flush=True)
+        return ok
+    except Exception as e:
+        print(f"[w2 zero-store] ON: probe raised {e!r}", flush=True)
+        return False
