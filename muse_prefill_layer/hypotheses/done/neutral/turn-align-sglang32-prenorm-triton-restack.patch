+def _pre_expert_rmsnorm_kernel(x_ptr, w_ptr, out_ptr, T, eps, H: tl.constexpr):
+    """out[r] = bf16(x[r] * rsqrt(mean(x[r]^2) + eps) * (1 + w)), fp32 math, w the bf16 checkpoint weight
+    (the +1 is added in fp32 here, no widened copy is stored). Persistent: program p takes rows p, p + P, ..."""
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    offs = tl.arange(0, H)
+    w = tl.load(w_ptr + offs).to(tl.float32) + 1.0
+    for r in range(pid, T, nprog):
+        base = r.to(tl.int64) * H
+        x = tl.load(x_ptr + base + offs).to(tl.float32)
+        rs = tl.rsqrt(tl.sum(x * x, axis=0) / H + eps)
+        tl.store(out_ptr + base + offs, (x * rs * w).to(tl.bfloat16))
+
