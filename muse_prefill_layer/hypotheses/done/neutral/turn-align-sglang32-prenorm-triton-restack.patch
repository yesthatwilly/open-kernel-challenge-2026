+def _gate_time(fns, flush):
+    """CUDA-graph replays with a cold L2 (a >= 256 MB write just before each replay), the candidates
+    interleaved with a rotating order, GATE_REPS each. Returns per candidate (median us, half-IQR us)."""
+    graphs = [_gate_graph(fn) for fn in fns]
+    times = [[] for _ in fns]
+    n = len(fns)
+    for rep in range(GATE_REPS):
+        for j in range(n):
+            which = (j + rep) % n
+            flush.zero_()
+            start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            start.record()
+            graphs[which].replay()
+            end.record()
+            end.synchronize()
+            times[which].append(start.elapsed_time(end) * 1000.0)
+    out = []
+    for t in times:
+        t = sorted(t)
+        out.append((t[len(t) // 2], (t[(3 * len(t)) // 4] - t[len(t) // 4]) / 2.0))
+    del graphs
+    return out
