+# ---------------------------------------------------------------------------------------------------------------
+# experts-rega-round-rotated-schedule: master's rega_kernel walks items it = blockIdx.x + r * G (G = 132 CTAs), and
+# decode_item gives CTA b chunk (b mod k) of every expert with k = 2 / 4 chunks (G and every group start f * T are
+# multiples of 4), so the short tail chunks pile onto the same CTAs; in the low class (k = 1) CTAs < 64 see mostly
+# even expert groups. A SEPARATE extension muse_prefill_rega_rot, built LAST in prepare(), DERIVED from master's
+# head + wgmma wrappers + body by exact-once text edits (any miss -> no build; master's strings, module, v1 fallback
+# and their sha256 checks are untouched), changes ONLY the item order: both the producer loop and the consumer loop
+# become for (rnd = 0;; ++rnd) { it = rot_item(rnd, shift); if (it >= total) break; <master's body> } with
+# rot_item = rnd * G + (b + rnd * shift) % G: each round still covers items [rnd * G, rnd * G + G) (a bijection
+# inside the round), but an odd shift moves every CTA's chunk index and group parity every round. Every item is
+# computed by master's code (decode_item, consume_item, epilogue unchanged), so the output is bit-identical by
+# construction; producer and consumers call the same rot_item with the same (rnd, shift), so the mbarrier ring
+# sees the same item / stage sequence on both sides (master's bounded-wait error word 1 stays: a mismatch would
+# end in error word 1 and the class OFF, never a hang). Shifts: coprime to the grid (67 for w13, 37 for w2 at
+# G = 132; n_tiles + 1 = 33 divides 132 for w2). A prepare-only diagnostic instantiation (template DIAG = true,
+# stage-1 tables only, its own host entry rega_gemm_rot_diag) records each CTA's clock64 span of the consumer item
+# loop, stages and bytes; the timed instantiations are DIAG = false (if constexpr: no clock code in them).
+# Per class (high T=3012, low T=753, ft T=16384): canary, bit-exact hs / y compare with master's rega_gemm on
+# random, skewed, one and pop routings, then 2 interleaved rounds x 11 cold-L2 graph alternations of master's
+# rega pair (w13 + w2) vs the rot pair on the pop routing (~1.83x uniform local routes) and the random routing,
+# then (timing ON only) the two-state replay check. ON when pop pair <= 0.98 in both rounds AND random pair (both
+# rounds pooled) <= 1.00 (low, ft) / 1.01 (high: random routing gives k = 1 for every expert there, so rotation
+# cannot act and the guard only rules out a regression). The low class only when rega_low_variant == 0.
+# state['rega_rot_ok'][class] is a plain bool, state['rega_rot_shift'] two ints, state['rega_rot_ext'] the module.
+# ---------------------------------------------------------------------------------------------------------------
+REGA_ROT_TAG = "[rega-rot]"
+REGA_ROT_EXT_NAME = "muse_prefill_rega_rot"
+REGA_ROT_FUNCS = ("rega_init_rot", "rega_gemm_rot", "rega_gemm_rot_diag")
+REGA_ROT_CLASSES = ("high", "low", "ft")    # gate order: the class the hypothesis expects most from first
+REGA_ROT_STATE_KEYS = REGA_STATE_KEYS + ("rega_rot_ext", "rega_rot_ok", "rega_rot_shift")
+REGA_ROT_SHIFT_PREF = (67, 37)              # (w13, w2); made coprime to the actual grid by _rega_rot_shift
+REGA_ROT_START_DEADLINE_S = 200.0           # no build once prepare() has used this many seconds
+REGA_ROT_CLASS_DEADLINE_S = {"high": 262.0, "low": 262.0, "ft": 248.0}   # no step of a class starts after this
+REGA_ROT_REPLAY_DEADLINE_S = 276.0          # no two-state replay check (so no ON) after this
+REGA_ROT_DIAG_DEADLINE_S = 280.0            # no print-only span diagnostic after this
+REGA_ROT_POP_RATIO = 0.98                   # rot pair / master pair on the pop routing, both rounds
+REGA_ROT_RANDOM_RATIO = {"high": 1.01, "low": 1.00, "ft": 1.00}   # rot pair / master pair, random, rounds pooled
+REGA_ROT_ROUNDS = 2
+REGA_ROT_ALTERNATIONS = 11
