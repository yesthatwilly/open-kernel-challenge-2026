+        torch.cuda.empty_cache()
+        if why:
+            return False, f"{NG_TAG} GATE {cls} T={tokens} random: two-state replay check missed ({why}): OFF"
+        print(f"{NG_TAG} two-state replay check {cls} T={tokens}: worst rel L2 {worst_rep:.2e} (bound 1e-3)",
