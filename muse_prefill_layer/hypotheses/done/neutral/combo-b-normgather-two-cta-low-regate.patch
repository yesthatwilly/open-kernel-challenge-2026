+        x, tw, lids = _rega_case(tokens, ("random", "skewed")[r % 2], gen, device)
+        for dst, src in zip(bufs[idx], (x, tw, lids)):
+            dst.copy_(src)
+        state["rega_err"].zero_()
+        graphs[idx].replay()
+        torch.cuda.synchronize()
