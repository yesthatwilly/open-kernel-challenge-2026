+        err, _ = _ssdq_metrics(new, ref)
+        worst = max(worst, err)
+        if word != 0 or not err <= 1e-3:
+            return worst, f"replay {r} state {'AB'[idx]}: error word {word}, rel L2 {err:.3e}"
+    del graphs, holders, bufs, sb
+    return worst, None
+
