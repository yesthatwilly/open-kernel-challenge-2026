+def _rega_kp_src():
+    """(cpp, cuda) of muse_prefill_rega_kp: _REGA_CPP with REGA_KP_CPP_EDIT, then _rega_fsilu_src() with the
+    REGA_KP_EDITS and the REGA_KP_SPAN replacement (consume_item), each target occurring exactly once (the span's
+    start before its end); else None. Master's strings are read, never edited."""
+    src = _rega_fsilu_src()
+    old, new = REGA_KP_CPP_EDIT
+    if src is None or _REGA_CPP.count(old) != 1:
+        return None
+    cpp = _REGA_CPP.replace(old, new)
+    for old, new in REGA_KP_EDITS:
+        if src.count(old) != 1:
+            return None
+        src = src.replace(old, new)
+    start, end, body = REGA_KP_SPAN
+    if src.count(start) != 1 or src.count(end) != 1 or not src.index(start) < src.index(end):
+        return None
+    return cpp, src[:src.index(start)] + body + src[src.index(end):]
+
+
+def _rega_kp_audit(cpp, src):
+    """Pre-build audit of the kp module (as _rega_fsilu_audit): no templated Tensor accessor, no mutable file-scope
+    / static / device globals. Returns the findings."""
+    bad = []
+    for name, text in (("cpp", cpp), ("cuda", src)):
+        for n, line in enumerate(text.splitlines(), 1):
+            if "data_ptr<" in line or "data_ptr <" in line or _SSDQ_TEMPLATED_ACCESSOR.search(line):
+                bad.append(f"{name} line {n}: {line.strip()[:100]}")
+    return bad + _rega_audit_cpp(cpp + "\n" + src)
+
+
+def _rega_kp_build(name, cpp, src, probe):
+    """Compile the kp module (prepare only): (ext or None, error text, seconds). Master's flags and
+    TORCH_CUDA_ARCH_LIST=9.0a around load_inline (restored after), as _rega_build; probe=True adds -Xptxas -Werror:
+    load_inline discards a good build's output, but a failed build's exception carries ptxas's, the only in-process
+    view of a ptxas warning (the C7510 / C7512 wgmma serialization ones)."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    flags = list(REGA_CUDA_CFLAGS) + (["-Xptxas", "-Werror"] if probe else [])
+    ext, err_text = None, ""
+    try:
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        ext = load_inline(name=name, cpp_sources=cpp, cuda_sources=src,
+                          functions=["rega_init", "rega_gather", "rega_gemm"], extra_cuda_cflags=flags,
+                          verbose=False)
+    except Exception as e:
+        err_text, ext = str(e), None
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    return ext, err_text, time.perf_counter() - t0
+
+
+def _rega_kp_ptxas(text):
+    """(sorted C75xx codes, up to 2 unique ptxas diagnostic lines) in a failed build's text."""
+    codes = sorted(set(re.findall(r"C75\d\d", text or "")))
+    seen = []
+    for line in (text or "").splitlines():
+        s = line.strip()
+        if "ptxas" in s and ("arning" in s or "rror" in s or "C75" in s) and "fatal" not in s:
+            key = s.split(" in function")[0][:140]
+            if key not in seen:
+                seen.append(key)
+    seen.sort(key=lambda w: "C75" not in w)
+    return codes, seen[:2]
+
+
+def _rega_kp_attrs(ext):
+    """Attributes of the two kp instantiations (w13, w2; T <= 4096 class) BEFORE any launch (rega_init sets each
+    one's dynamic smem attribute): launchable; numRegs x 640 >= REGA_KP_POOL (else setmaxnreg.inc waits forever); no
+    local memory (a spill at 112 registers is OFF, not a slow run); occupancy >= 1; dynamic smem == REGA_KP_SMEM and
+    static + dynamic <= REGA_SMEM_LIMIT; an sm_90 image. Returns (both ok, compact text)."""
+    info = ext.rega_init()
+    ok, parts = len(info) == 20, []
+    for i in range(0, len(info), 10):
+        flag, a_ok, regs, local_bytes, static_smem, dyn_smem, occ, e1, bin_v, _ = info[i:i + 10]
+        good = (bool(a_ok) and not (flag & 2) and occ >= 1 and dyn_smem == REGA_KP_SMEM
+                and static_smem + dyn_smem <= REGA_SMEM_LIMIT and regs * REGA_KP_THREADS >= REGA_KP_POOL
+                and local_bytes == 0 and bin_v == 90)
+        ok = ok and good
+        parts.append(f"<{'w13' if flag & 1 else 'w2'}> r{regs} l{local_bytes} s{static_smem}+{dyn_smem} o{occ} "
+                     f"b{bin_v} rc{e1}{'' if good else ' BAD'}")
+    return ok, "; ".join(parts)
+
+
+def _rega_kp_gemm(state, ext, which, src, dst, tabs, stagger=None):
+    """One rega GEMM launch with the arguments _experts_rega passes (w13: xs -> hs, w2: hs -> y) into
+    state['rega_err']; stagger=None: master's / the fsilu module's signature, else the kp module's."""
+    bank, err, grid = state["rega_bank"], state["rega_err"], state["rega_grid"]
+    sorted_ids, block_experts, n_padded, num_slots = tabs
+    q, gs, nt = ((bank["q13"], bank["gs13"], D_EXPERT // 64) if which == 0
+                 else (bank["q2"], bank["gs2"], D_EXPERT // 128))
+    args = (which, src, q, gs, sorted_ids, block_experts, n_padded, num_slots, nt, D_EXPERT, dst, grid, err)
+    if stagger is None:
+        ext.rega_gemm(*args)
+    else:
+        ext.rega_gemm(*args, stagger)
+
+
+def _rega_kp_dispatched(state, cls):
+    """The w13 and w2 launches master dispatches at this class (kp off): (w13 module, its name, w2 module, its
+    name): the fsilu module's w13 when rega_fsilu_ok[cls], its w2 (arm a) when rega_w2st_ok[cls], else master's."""
+    fext = state.get("rega_fsilu_ext")
+    f13 = fext is not None and bool(state.get("rega_fsilu_ok", {}).get(cls, False))
+    f2 = fext is not None and bool(state.get("rega_w2st_ok", {}).get(cls, False))
+    return (fext if f13 else state["rega_ext"], "fsilu" if f13 else "master",
+            fext if f2 else state["rega_ext"], "w2st a" if f2 else "master")
+
+
+def _rega_kp_trial(state, kp, cls, cfg):
+    """A shallow copy of state with kp ON for this class only, cfg = (w13 stagger or -1, w2 stagger or -1)."""
+    trial = dict(state)
+    trial["rega_kp_ext"] = kp
+    trial["rega_kp_ok"] = {c: c == cls for c in REGA_KP_CLASSES}
+    trial["rega_kp_cfg"] = {c: (tuple(cfg) if c == cls else (-1, -1)) for c in REGA_KP_CLASSES}
+    return trial
+
+
+def _rega_kp_rel(a, b):
+    """rel L2 |a - b| / |b| over bf16 tensors, in row slabs (prepare only)."""
+    num = den = 0.0
+    for i in range(0, a.shape[0], 16384):
+        x, y = a[i:i + 16384].float(), b[i:i + 16384].float()
+        num += float(((x - y) ** 2).sum())
+        den += float((y ** 2).sum())
+    return (num / max(den, 1e-30)) ** 0.5
+
+
+def _rega_kp_accuracy(state, kp, device, cls, tokens, kind, prenorm, gen, weights, cache):
+    """prepare() only, one routing, on the align and gather the judge path uses. (1) master's dispatched w13 (fsilu
+    when ON) and the kp w13 of every stagger arm on the same xs into zeroed hs: the arms torch.equal (the stagger
+    moves no arithmetic), kp finite and within REGA_FSILU_HS_REL rel L2 of master's (the K split reorders fp32 sums);
+    (2) master's dispatched w2 (w2st a when ON) and the kp w2 of every arm on master's hs into REGA_W2ST_SENTINEL-
+    filled y: the arms torch.equal, the rows left at the sentinel identical to master's, the written rows within
+    REGA_FSILU_HS_REL; every launch error word 0 and its marker; (3) the whole routed _experts_rega with kp ON for
+    this class (both GEMMs, stagger 0) and master's, on the prenorm dispatch, vs the fp64 reference: kp <=
+    REGA_FSILU_REF_MULT x master's, error word 0 and both markers. Returns (None or why, compact text)."""
+    err = state["rega_err"]
+    ext13, _, ext2, _ = _rega_kp_dispatched(state, cls)
+    arms = [("m", None)] + [(f"k{s}", s) for s in REGA_KP_STAGGERS]
+    k0 = arms[1][0]
+    x, tw, lids = _rega_case(tokens, kind, gen, device)
+    local = int((lids >= 0).sum())
+    tabs = xs = hs = ys = written = None
+    try:
+        tabs, xs = _rega_fsilu_tables(state, x, lids, prenorm, cls)
+        hs, ys = {}, {}
+        for lab, stg in arms:
+            hs[lab] = torch.zeros((xs.shape[0], D_EXPERT), device=device, dtype=torch.bfloat16)
+            err.zero_()
+            _rega_kp_gemm(state, ext13 if stg is None else kp, 0, xs, hs[lab], tabs, stg)
+            torch.cuda.synchronize()
+            word, m13, _ = _rega_marks(err)
+            if word != 0 or m13 != REGA_MAGIC:
+                return f"{kind}: w13:{lab} left error word {word} ({REGA_ERR_TEXT.get(word, '?')}) marker {m13:#x}", ""
+        if not all(torch.equal(hs[lab], hs[k0]) for lab, _ in arms[2:]):
+            return f"{kind}: kp w13 differs between stagger arms", ""
+        finite = bool(torch.isfinite(hs[k0].float()).all())
+        rel13 = _rega_kp_rel(hs[k0], hs["m"])
+        for lab, stg in arms:
+            ys[lab] = torch.full((tabs[3], D_EXPERT), REGA_W2ST_SENTINEL, device=device, dtype=torch.bfloat16)
+            err.zero_()
+            _rega_kp_gemm(state, ext2 if stg is None else kp, 1, hs["m"], ys[lab], tabs, stg)
+            torch.cuda.synchronize()
+            word, _, m2 = _rega_marks(err)
+            if word != 0 or m2 != REGA_MAGIC:
+                return f"{kind}: w2:{lab} left error word {word} ({REGA_ERR_TEXT.get(word, '?')}) marker {m2:#x}", ""
+        if not all(torch.equal(ys[lab], ys[k0]) for lab, _ in arms[2:]):
+            return f"{kind}: kp w2 differs between stagger arms", ""
+        sent_m = (ys["m"] == REGA_W2ST_SENTINEL).all(dim=1)
+        rows_ok = bool(torch.equal(sent_m, (ys[k0] == REGA_W2ST_SENTINEL).all(dim=1)))
+        written = ~sent_m
+        n_written = int(written.sum())
+        finite = finite and bool(torch.isfinite(ys[k0].float()).all())
+        rel2 = _rega_kp_rel(ys[k0][written], ys["m"][written]) if n_written else 0.0
+        hs = ys = written = xs = None
+        torch.cuda.empty_cache()
+        xin = state["pre_expert_norm"](x)
+        xa = x if prenorm else xin
+        ref = _rega_fsilu_reference_out(xin, tw, lids, state, weights, cache)
+        trial = _rega_kp_trial(state, kp, cls, (REGA_KP_STAGGERS[0], REGA_KP_STAGGERS[0]))
+        err.zero_()
+        out_k = _experts_rega(xa, tw, lids, trial, prenorm=prenorm)
+        torch.cuda.synchronize()
+        word, m13, m2 = _rega_marks(err)
+        out_m = _experts_rega(xa, tw, lids, state, prenorm=prenorm)
+        torch.cuda.synchronize()
+        e_k, w_k = _ssdq_metrics(out_k, ref)
+        e_m, _ = _ssdq_metrics(out_m, ref)
+        del xin, xa, ref, out_k, out_m, trial
+        text = (f"{kind} {local}r hs rel {rel13:.1e} y rel {rel2:.1e} ({n_written} rows, sentinel rows "
+                f"{'eq' if rows_ok else 'DIFF'}); out err k/m {e_k:.3e}/{e_m:.3e} x{e_k / max(e_m, 1e-30):.3f}")
+        ok = (finite and rel13 <= REGA_FSILU_HS_REL and rel2 <= REGA_FSILU_HS_REL and rows_ok and word == 0
+              and _rega_launched(m13, m2) and e_k < float("inf") and e_k <= REGA_FSILU_REF_MULT * e_m
+              and w_k < float("inf"))
+        if not ok:
+            return (f"{text}; finite {finite}, word {word}, markers {m13:#x}/{m2:#x} (bounds rel "
+                    f"{REGA_FSILU_HS_REL:g}, err x{REGA_FSILU_REF_MULT:g})"), text
+        return None, text
+    finally:
+        x = tw = lids = tabs = xs = hs = ys = written = None
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+
+
+def _rega_kp_time(state, kp, device, cls, tokens, kind, prenorm, gen):
+    """prepare() only: one routing's tables and xs (the judge path's align + gather) and hs from master's
+    dispatched w13; one w13-alone and one w2-alone CUDA graph each for master's dispatched launches ('m13', 'm2')
+    and every kp stagger arm ('k13:s', 'k2:s'), plus an empty graph, timed together by _rega_fsilu_bench (cold +
+    warm, REGA_FSILU_ROUNDS x REGA_FSILU_ALTERNATIONS). Every buffer and graph is local and dropped before
+    returning. Returns ({mode: [per-round {name: us}]}, local routes)."""
+    ext13, _, ext2, _ = _rega_kp_dispatched(state, cls)
+    err = state["rega_err"]
+    x, tw, lids = _rega_case(tokens, kind, gen, device)
+    local = int((lids >= 0).sum())
+    tabs = xs = hs = out13 = y = tiny = None
+    graphs, fns = {}, {}
+    try:
+        tabs, xs = _rega_fsilu_tables(state, x, lids, prenorm, cls)
+        x = tw = lids = None
+        hs = torch.zeros((xs.shape[0], D_EXPERT), device=device, dtype=torch.bfloat16)
+        out13 = torch.zeros_like(hs)
+        y = torch.zeros((tabs[3], D_EXPERT), device=device, dtype=torch.bfloat16)
+        err.zero_()
+        _rega_kp_gemm(state, ext13, 0, xs, hs, tabs)  # the w2 input, as kernel_fn computes it
+        fns = {"m13": (lambda: _rega_kp_gemm(state, ext13, 0, xs, out13, tabs)),
+               "m2": (lambda: _rega_kp_gemm(state, ext2, 1, hs, y, tabs))}
+        for s in REGA_KP_STAGGERS:
+            fns[f"k13:{s}"] = (lambda s=s: _rega_kp_gemm(state, kp, 0, xs, out13, tabs, s))
+            fns[f"k2:{s}"] = (lambda s=s: _rega_kp_gemm(state, kp, 1, hs, y, tabs, s))
+        graphs = {name: _ssdq_graph_time(fn, device) for name, fn in fns.items()}
+        tiny = torch.zeros(16, dtype=torch.float32, device=device)
+        graphs["empty"] = _ssdq_graph_time(lambda t=tiny: t.zero_(), device)
+        res = _rega_fsilu_bench(graphs, device, ("cold", "warm"), REGA_FSILU_ROUNDS, REGA_FSILU_ALTERNATIONS)
+        word = _rega_marks(err)[0]
+        if word != 0:
+            raise RuntimeError(f"timing replays left error word {word} ({REGA_ERR_TEXT.get(word, '?')})")
+        return res, local
+    finally:
+        graphs = fns = None
+        x = tw = lids = tabs = xs = hs = out13 = y = tiny = None
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+
+
+def _rega_kp_ratio(rd, num, den):
+    return sum(rd[n] for n in num) / max(sum(rd[d] for d in den), 1e-9)
+
+
+def _rega_kp_time_text(res):
+    """One routing's timing, compact: per L2 mode, per GEMM, master's round-mean us and each kp arm's round-mean us
+    with its per-round ratios."""
+    parts = []
+    for mode, rds in res.items():
+        n = max(len(rds), 1)
+        for g in ("13", "2"):
+            parts.append(f"{mode} w{g} m {sum(rd[f'm{g}'] for rd in rds) / n:.1f} " + " ".join(
+                f"s{s} {sum(rd[f'k{g}:{s}'] for rd in rds) / n:.1f} x"
+                + "/".join(f"{_rega_kp_ratio(rd, (f'k{g}:{s}',), (f'm{g}',)):.3f}" for rd in rds)
+                for s in REGA_KP_STAGGERS))
+    return "; ".join(parts) + " us"
+
+
+def _rega_kp_choose(res):
+    """res: {routing: {mode: [per-round {name: us}]}} ('pop', 'random' and, when timed, 'guard'). Per GEMM, the kp
+    arm with the lowest pop warm round-mean ratio among the arms <= REGA_KP_GEMM_RATIO in every round, L2 mode and
+    routing, else master's launch of that GEMM. ON when the chosen pair uses kp for at least one GEMM and is <=
+    REGA_KP_POP_RATIO on pop, <= REGA_KP_RANDOM_RATIO on random and <= REGA_KP_GUARD_RATIO on the guard, every
+    round and L2 mode. Returns ((w13 stagger or -1, w2 stagger or -1), ON, gate text, report text: the kp-both pair
+    of each GEMM's best arm (eligible or not) per routing and mode, and each GEMM alone on pop warm)."""
+    bars = {"pop": REGA_KP_POP_RATIO, "random": REGA_KP_RANDOM_RATIO, "guard": REGA_KP_GUARD_RATIO}
+
+    def every(num, den):
+        return {k: [_rega_kp_ratio(rd, num, den) for rds in r.values() for rd in rds] for k, r in res.items()}
+
+    def mean(kind, mode, num, den):
+        rds = res[kind][mode]
+        return sum(_rega_kp_ratio(rd, num, den) for rd in rds) / max(len(rds), 1)
+
+    cfg, best, parts = [], {}, []
+    for g in ("13", "2"):
+        cand = []
+        for s in REGA_KP_STAGGERS:
+            rs = every((f"k{g}:{s}",), (f"m{g}",))
+            cand.append((mean("pop", "warm", (f"k{g}:{s}",), (f"m{g}",)), s,
+                         max(v for r in rs.values() for v in r)))
+        best[g] = min(cand)[1]
+        elig = [(pw, s) for pw, s, mx in cand if mx <= REGA_KP_GEMM_RATIO]
+        cfg.append(min(elig)[1] if elig else -1)
+        parts.append(f"w{g} " + " ".join(f"s{s} pop-warm x{pw:.3f} max x{mx:.3f}" for pw, s, mx in cand)
+                     + f" -> {f's{cfg[-1]}' if cfg[-1] >= 0 else 'master'}")
+    num = tuple(f"k{g}:{c}" if c >= 0 else f"m{g}" for g, c in zip(("13", "2"), cfg))
+    den = ("m13", "m2")
+    ok = cfg != [-1, -1]
+    for kind, rs in every(num, den).items():
+        good = bool(rs) and all(v <= bars[kind] for v in rs)
+        ok = ok and good
+        parts.append(f"pair {kind} <= {bars[kind]}: max x{max(rs, default=0.0):.3f} {'pass' if good else 'MISS'}")
+    both = (f"k13:{best['13']}", f"k2:{best['2']}")
+    report = (f"kp-both (w13 s{best['13']}, w2 s{best['2']}): " + ", ".join(
+        f"{kind} warm x{mean(kind, 'warm', both, den):.3f} cold x{mean(kind, 'cold', both, den):.3f}" for kind in res)
+        + f"; alone pop warm w13 x{mean('pop', 'warm', both[:1], den[:1]):.3f} w2 "
+        f"x{mean('pop', 'warm', both[1:], den[1:]):.3f}")
+    return (cfg[0], cfg[1]), ok, "; ".join(parts), report
+
+
+def _rega_kp_class(state, kp, device, cls, weights, summary, t_start, info):
+    """prepare() only: one class's checks and gate. 1. the judge-like pop routing (fsilu's calibrated alpha for this
+    class, else calibrated here on master's w13); 2. accuracy on random, skewed, one and that routing
+    (_rega_kp_accuracy); 3. timing (_rega_kp_time) on pop and random, then at the low class the skew-guard routing
+    (rega-lo / w2st's alpha for ~REGA_LO_GUARD_ROUTES routes) when pop + random passed; _rega_kp_choose; 4. the
+    two-state replay check with the chosen config. No step after REGA_KP_STEP_DEADLINE_S. Detail lines are printed;
+    the GATE line also goes to summary. Returns (on, cfg or None, why, report)."""
+    tokens = REGA_FSILU_TOKENS[cls]
+    tag = f"{REGA_KP_TAG} {cls} T={tokens}"
+    prenorm = bool(state.get("norm_gather_ok", {}).get(cls, False))
+    gen = torch.Generator(device=device).manual_seed(20261106)
+    _, n13, _, n2 = _rega_kp_dispatched(state, cls)
+    report = ""
+
+    def late(step):
+        used = time.perf_counter() - t_start
+        if used > REGA_KP_STEP_DEADLINE_S:
+            return f"SKIPPED: {step} not started (prepare {used:.0f}s > {REGA_KP_STEP_DEADLINE_S:.0f}s)"
+        return None
+
+    # 1. the judge-like routing
+    alpha, src = info.get("alpha", {}).get(cls), "fsilu's"
+    if alpha is None:
+        why = late("alpha calibration")
+        if why:
+            return False, None, why, report
+        alpha, src = _rega_fsilu_calibrate(state, device, cls, tokens, prenorm, gen)[0], "calibrated here"
+    pop_kind = f"pop:{alpha:g}"
+    # 2. accuracy
+    cache, parts = {}, []
+    try:
+        for kind in REGA_KP_ACC_KINDS + (pop_kind,):
+            why = late(f"accuracy {kind}")
+            if why:
+                return False, None, why, report
+            why, text = _rega_kp_accuracy(state, kp, device, cls, tokens, kind, prenorm, gen, weights, cache)
+            if why:
+                print(f"{tag} accuracy MISS: {why}"[:700], flush=True)
+                return False, None, f"accuracy: {why}", report
+            parts.append(text)
+    finally:
+        cache.clear()
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+    print(f"{tag} accuracy vs {n13} w13 / {n2} w2 ({pop_kind} = {src} judge-like alpha; prenorm {prenorm}): "
+          + "; ".join(parts), flush=True)
+    # 3. timing: w13 alone and w2 alone, master's dispatched launches vs every kp arm, pop then random (then guard)
+    res = {}
+    for kk, kind in (("pop", pop_kind), ("random", "random")):
+        why = late(f"timing {kind}")
+        if why:
+            return False, None, why, report
+        res[kk], local = _rega_kp_time(state, kp, device, cls, tokens, kind, prenorm, gen)
+        print(f"{tag} TIME {kind} {local}r: {_rega_kp_time_text(res[kk])}"[:900], flush=True)
+    cfg, ok, text, report = _rega_kp_choose(res)
+    if cls == "low" and ok:
+        why = late("timing guard")
+        if why:
+            summary.append(f"{tag} GATE {text}; guard not timed"[:700])
+            print(summary[-1], flush=True)
+            return False, None, why, report
+        n_rnd, counts = _rega_pop_counts(tokens, device)
+        g_alpha, g_cnt = _rega_pop_pick(counts, REGA_LO_GUARD_ROUTES)
+        g_kind = f"pop:{g_alpha:g}"
+        res["guard"], local = _rega_kp_time(state, kp, device, cls, tokens, g_kind, prenorm, gen)
+        print(f"{tag} TIME guard {g_kind} {local}r (~{REGA_LO_GUARD_ROUTES} routes, calibrated {g_cnt:.0f} = "
+              f"{g_cnt / max(n_rnd, 1.0):.2f}x uniform): {_rega_kp_time_text(res['guard'])}"[:900], flush=True)
+        cfg, ok, text, report = _rega_kp_choose(res)
+    summary.append(f"{tag} GATE vs {n13} w13 / {n2} w2: {text}"[:700])
+    print(summary[-1], flush=True)
+    if not ok:
+        return False, None, "timing gate missed", report
+    # 4. two-state replay check with the chosen config ON for this class
+    why = late("replay check")
+    if why:
+        return False, None, why, report
+    trial = _rega_kp_trial(state, kp, cls, cfg)
+    cache = {}
+    why, line = _rega_replay_check(trial, weights, cache, device, gen, plan=REGA_FSILU_REPLAY_PLAN[cls],
+                                   keys=REGA_KP_STATE_KEYS)
+    cache.clear()
+    torch.cuda.empty_cache()
+    if why:
+        return False, None, f"two-state replay check failed: {why}", report
+    print(f"{tag} two-state replay check (kp ON, cfg {cfg}): {line}"[:700], flush=True)
+    return True, cfg, "", report
+
+
+def _rega_kp_phase(state, weights, device, t_start, info):
+    """prepare() only, after _rega_w2st_phase (it reads both per-class flag sets) and before fsilu_info is dropped
+    (its calibrated alphas). Derives, audits and builds muse_prefill_rega_kp (an -Xptxas -Werror probe first: a pass
+    is the module; a failure prints its C75xx codes / ptxas lines, then the plain build unless prepare() has used
+    REGA_KP_PLAIN_DEADLINE_S), checks both instantiations' attributes before any launch, then per routed class
+    (state['rega_ok']; low only when rega_low_variant == 0; high only before REGA_KP_HIGH_DEADLINE_S)
+    _rega_kp_class. No build once prepare() has used REGA_FSILU_START_DEADLINE_S. Sets state['rega_kp_ext'] (the
+    module, or None when every class is OFF), state['rega_kp_ok'][cls] and state['rega_kp_cfg'][cls]. Never raises;
+    every miss keeps master's launches. Returns the compact summary lines (PATH CHOSEN last)."""
+    t0 = time.perf_counter()
+    state["rega_kp_ext"] = None
+    state["rega_kp_ok"] = {c: False for c in REGA_KP_CLASSES}
+    state["rega_kp_cfg"] = {c: (-1, -1) for c in REGA_KP_CLASSES}
+    summary, verdict, reports, off, secs = [], {}, {}, None, {}
+    kp, attr_text = None, "n/a"
+    v = int(state.get("rega_low_variant", 0))
+
+    def say(text, n=700):
+        summary.append(text[:n])
+        print(summary[-1], flush=True)
+
+    try:
+        routed = [c for c in REGA_KP_CLASSES if state.get("rega_ok", {}).get(c, False) and not (c == "low" and v)]
+        used = time.perf_counter() - t_start
+        made = _rega_kp_src()
+        if not routed:
+            off = f"no class on master's rega_kernel (rega_ok {state.get('rega_ok')}, rega_low_variant {v})"
+        elif used > REGA_FSILU_START_DEADLINE_S:
+            off = (f"SKIPPED: prepare already used {used:.0f}s > {REGA_FSILU_START_DEADLINE_S:.0f}s before the nvcc "
+                   f"build")
+        elif not _rega_lo_identity()[0]:
+            off = "master's v2 rega source does not hash to master's (the kp module derives from it)"
+        elif made is None:
+            off = "a kp / fsilu / w2st edit target did not occur exactly once"
+        else:
+            cpp, src = made
+            bad = _rega_kp_audit(cpp, src)
+            if bad:
+                off = f"source audit failed: {bad[:3]}"
+            else:
+                print(f"{REGA_KP_TAG} derived source sha256 {hashlib.sha256((cpp + src).encode()).hexdigest()[:16]} "
+                      f"({len(src)} chars; fsilu_w2a + {len(REGA_KP_EDITS)} kp edits + the consume_item span + 1 cpp "
+                      f"edit); audit ok; prepare at {used:.1f}s", flush=True)
+                kp, etext, secs["probe"] = _rega_kp_build(REGA_KP_EXT_NAME + "_p", cpp, src, True)
+                if kp is not None:
+                    ptx = "-Werror probe passed: no ptxas warning (no C7510 / C7512 wgmma serialization)"
+                else:
+                    codes, warns = _rega_kp_ptxas(etext)
+                    ptx = (f"-Werror probe FAILED: C75xx {','.join(codes) if codes else 'none'}"
+                           + (": " + " | ".join(warns) if warns else f" (no ptxas line; tail {etext[-160:]!r})"))
+                    used = time.perf_counter() - t_start
+                    if used > REGA_KP_PLAIN_DEADLINE_S:
+                        off = f"SKIPPED: plain build not started (prepare {used:.0f}s > {REGA_KP_PLAIN_DEADLINE_S:.0f}s)"
+                    else:
+                        kp, etext, secs["build"] = _rega_kp_build(REGA_KP_EXT_NAME, cpp, src, False)
+                        if kp is None:
+                            off = f"build failed: {etext[-240:]!r}"
+                say(f"{REGA_KP_TAG} ptxas {ptx}; SASS WARPGROUP.DEPBAR per k loop: n/a (cuobjdump would start a "
+                    f"process)")
+                if kp is not None:
+                    attrs_ok, attr_text = _rega_kp_attrs(kp)
+                    say(f"{REGA_KP_TAG} attrs {attr_text} (need regs x {REGA_KP_THREADS} >= {REGA_KP_POOL}, local 0, "
+                        f"dyn {REGA_KP_SMEM})")
+                    if not attrs_ok:
+                        off = "attribute / register-pool / spill check failed: nothing launched"
+                    else:
+                        stop = None
+                        for cls in routed:
+                            tc = time.perf_counter()
+                            used = tc - t_start
+                            dl = REGA_KP_HIGH_DEADLINE_S if cls == "high" else REGA_KP_STEP_DEADLINE_S
+                            if stop:
+                                verdict[cls] = (False, stop)
+                            elif used > dl:
+                                verdict[cls] = (False, f"SKIPPED: prepare {used:.0f}s > {dl:.0f}s before the class")
+                            else:
+                                try:
+                                    on, cfg, why, reports[cls] = _rega_kp_class(state, kp, device, cls, weights,
+                                                                                summary, t_start, info)
+                                except Exception as e:  # stop here: anything after a fault would be unreliable
+                                    on, cfg, why = False, None, f"raised {e!r}"[:300]
+                                    stop = f"an earlier class raised ({why[:80]})"
+                                if on:
+                                    state["rega_kp_ok"][cls] = True
+                                    state["rega_kp_cfg"][cls] = (int(cfg[0]), int(cfg[1]))
+                                verdict[cls] = (bool(on), why)
+                            state["rega_err"].zero_()
+                            secs[cls] = time.perf_counter() - tc
+    except Exception as e:  # a device fault would have poisoned the context; anything else keeps master
+        off = f"kp phase raised {e!r}"[:400]
+        state["rega_kp_ok"] = {c: False for c in REGA_KP_CLASSES}
+    finally:
+        if any(state["rega_kp_ok"].values()):
+            state["rega_kp_ext"] = kp
+        else:
+            state["rega_kp_ext"] = None
+            state["rega_kp_cfg"] = {c: (-1, -1) for c in REGA_KP_CLASSES}
+        kp = None
+        try:
+            torch.cuda.synchronize()
+            torch.cuda.empty_cache()
+        except Exception as e:  # only after a device fault
+            off = (off or "") + f"; final synchronize raised {e!r}"[:200]
+    if off:
+        say(f"{REGA_KP_TAG} OFF: {off}")
+    say(f"{REGA_KP_TAG} phase {time.perf_counter() - t0:.1f}s (" + ", ".join(f"{k} {s:.1f}s" for k, s in secs.items())
+        + f"); prepare total {time.perf_counter() - t_start:.1f}s of 300s")
+    fok, wok = state.get("rega_fsilu_ok", {}), state.get("rega_w2st_ok", {})
+    for cls in REGA_KP_CLASSES:
+        on, why = verdict.get(cls, (False, off or "class not on rega"))
+        w13, w2 = state["rega_kp_cfg"][cls]
+        chosen = (f"kp (w13 {f'kp s{w13}' if w13 >= 0 else 'master'}, w2 {f'kp s{w2}' if w2 >= 0 else 'master'})"
+                  if on else "master")
+        say(f"{REGA_KP_TAG} PATH CHOSEN {cls}: {chosen}" + ("" if on else f" ({why[:160]})")
+            + (f"; {reports[cls]}" if reports.get(cls) else "") + f"; {attr_text}; fsilu "
+            f"{'ON' if fok.get(cls, False) else 'OFF'} w2st {'ON' if wok.get(cls, False) else 'OFF'}"
+            + (f"; rega_low_variant {v}" if cls == "low" else ""), 900)
+    return summary
+
+
 def kernel_fn(data, state):
     cfg = data["config"]
     batch, length, tokens = cfg["batch"], cfg["q_len"], cfg["tokens"]
