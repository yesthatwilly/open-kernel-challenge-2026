+REGA_KP_SPAN = (
+    "// wgmma_wait<0> right after the commit, BEFORE the next k-step's dequant rewrites the register-A\n",
+    "template <bool G, bool BIG>\n__global__ void __launch_bounds__(THREADS, 1)\nrega_kernel(",
+    r"""// ---- kp (experts-rega-low-kpair-four-consumer-wgs): K-pair consumers ----
+// 640 threads: the producer warpgroup (warps 0-3, master's) + four consumer warpgroups (warps 4-19) as two PAIRS
+// (pair = ctid >> 8, ctid = tid - 128). Within a pair, ptid = ctid & 255 and cw = ptid >> 5 index the 16-row weight
+// slice exactly as master's ctid / cw, so each pair covers all 128 weight rows of the item and thread ptid of pair 1
+// holds the same accumulator fragment slots as thread ptid of pair 0. Pair p dequantizes ONLY record p of every stage
+// (k [64p, 64p + 64) of the stage) and issues its 4 k16 wgmma steps against slab half p: a partial over half of K.
+// Both pairs wait on full[s]; the stage is released by all 16 consumer warps (empty[s] count 16).
+// stagger (kernel-uniform): 0 = the pairs drift freely (up to STAGES - 1 stages); 1 = pair 1's first full-barrier
+// wait of each item follows pair 0's first dequant (named barrier 2: pair 0 arrives, pair 1 syncs, 512 threads), so
+// pair 1 dequantizes while pair 0 issues its first wgmma group (an anti-phase start).
+static_assert(THREADS == 640, "kp: the producer warpgroup + four consumer warpgroups");
+static_assert(32 * 128 + 112 * 512 <= 96 * THREADS, "kp: the setmaxnreg 32 / 112 pool at 96 registers per thread");
+static_assert(Smem<true>::EPI == Smem<false>::EPI && 32 * 256 * 4 <= Smem<false>::EPI, "kp: reduction buffer");
+__device__ __forceinline__ void named_arrive(int id, int count) {
+  asm volatile("bar.arrive %0, %1;\n" :: "r"(id), "r"(count) : "memory");
+}
+// One 64-k record of this warp's 16 weight rows -> its 16 bf16x2 register-A fragments (4 k16 steps x 4 registers):
+// dq_stage's per-record body verbatim (rec = the stage base + r * REC).
+__device__ __forceinline__ void dq_rec(const uint8_t* rec, int cw, int lane, uint32_t (&a)[4][4]) {
+  const float P119 = __int_as_float(0x7B000000);  // 2^119
+  const int g = lane >> 2;
+  const uint4 q = *reinterpret_cast<const uint4*>(rec + cw * 512 + lane * 16);
+  const uint2 sc = *reinterpret_cast<const uint2*>(rec + REC_CODES + cw * 64 + g * 8);
+  uint32_t hs[4];
+  e4m3x4_to_f16x2x2(sc.x, hs[0], hs[1]);
+  e4m3x4_to_f16x2x2(sc.y, hs[2], hs[3]);
+  const uint32_t qw[4] = {q.x, q.y, q.z, q.w};
+#pragma unroll
+  for (int k = 0; k < 4; ++k) {
+    const float2 fs = __half22float2(*reinterpret_cast<const __half2*>(&hs[k]));
+    dequant8(qw[k], bf16x2_bcast(fs.x * P119), bf16x2_bcast(fs.y * P119), a[k]);
+  }
+}
