+// ctid: 0..511 (both pairs); cw: the warp's slice in its pair. wgmma_wait<0> right after each commit, as master's.
+template <int NB, bool G>
+__device__ __forceinline__ void consume_item(const Item& m, uint8_t* smem, uint8_t* ep, uint32_t full0,
+                                             uint32_t empty0, int& n, int KS, int cw, int lane, int ctid,
+                                             const float* __restrict__ gs, const int* __restrict__ sorted_ids,
+                                             int num_routes, __nv_bfloat16* __restrict__ out, int out_ld,
+                                             int* err, bool& dead, int stagger) {
+  constexpr int NA = NB / 2;
+  const int pair = ctid >> 8, ptid = ctid & 255;
+  float acc[NA];
+#pragma unroll
+  for (int i = 0; i < NA; ++i) acc[i] = 0.f;
+  uint32_t a0[4][4];
+  // w2st (a), w2 only: the global scale (pair 0, the epilogue math) and this thread's route id (pair 1, the route-id
+  // table), loaded before the k loop so their L2 round trips hide under it
+  [[maybe_unused]] float gsc_w2 = 0.f;
+  [[maybe_unused]] int sid_r = -1;
+  if constexpr (!G) {
+    if (pair == 0) {
+      gsc_w2 = __ldg(gs + m.e);
+    } else {
+      sid_r = ptid < m.nbk * 16 ? __ldg(sorted_ids + m.slot0 + ptid) : -1;
+    }
+  }
+  if (stagger == 1 && pair == 1) named_bar(2, 512);  // after pair 0's first dequant of this item
+  const int roff = pair * REC;
+  const uint32_t hoff = static_cast<uint32_t>(pair * SLAB_HALF);
+  for (int kb = 0; kb < KS; ++kb) {
+    const int s = n % STAGES;
+    mbar_wait(full0 + 8 * s, (n / STAGES) & 1, err, dead);
+    const uint8_t* st = smem + s * STAGE_BYTES;
+    dq_rec(st + roff, cw, lane, a0);
+    if (stagger == 1 && pair == 0 && kb == 0) named_arrive(2, 512);
+    const uint32_t slab = smem_u32(st + WST) + hoff;
+    fence_acc<NA>(acc);
+    wgmma_fence();
+#pragma unroll
+    for (int k = 0; k < 4; ++k) Wg<NB>::mma(acc, a0[k], make_desc(slab + k * 32));
+    wgmma_commit();
+    wgmma_wait<0>();  // group retired: a0[] may be rewritten and this stage released at once
+    fence_acc<NA>(acc);
+    if (lane == 0) mbar_arrive(empty0 + 8 * s);
+    ++n;
+  }
+  wgmma_wait<0>();
+  fence_acc<NA>(acc);
+
+  // Epilogue. (A) every consumer is done reading the previous item's staging tile (the reduction buffer aliases it);
+  // per round of RR accumulators: pair 1 stores its partial in fragment order (red[i][ptid]: 256 consecutive floats
+  // per i, conflict-free), barrier, pair 0 adds it into its registers; (B) the last reads are done: pair 0 stages the
+  // tile as master's (gsc, silu_mul / gsc_w2, stmatrix .trans) while pair 1 (w2) writes w2st's route-id table into
+  // the pad column; (C) then all 512 consumers run master's coalesced store loops. Barrier 1 = the 512 consumers.
+  const int nvalid = m.nbk * 16;
+  float gsc = 0.f;
+  if (pair == 0) {
+    if constexpr (G) {
+      gsc = __ldg(gs + m.e);
+    } else {
+      gsc = gsc_w2;
+    }
+  }
+  named_bar(1, 512);  // (A)
+  {
+    constexpr int RR = NA < 32 ? NA : 32;  // 32 floats x 256 threads = 32 KB per round
+    float* red = reinterpret_cast<float*>(ep);
+#pragma unroll
+    for (int r0 = 0; r0 < NA; r0 += RR) {
+      if (r0 > 0) named_bar(1, 512);  // the previous round's reads are done
+      if (pair == 1) {
+#pragma unroll
+        for (int i = 0; i < RR; ++i) red[i * 256 + ptid] = acc[r0 + i];
+      }
+      named_bar(1, 512);
+      if (pair == 0) {
+#pragma unroll
+        for (int i = 0; i < RR; ++i) acc[r0 + i] += red[i * 256 + ptid];
+      }
+    }
+  }
+  named_bar(1, 512);  // (B)
+  if (pair == 0) {
+    if (G) {
+      // acc[4i + 0/1]: gate (fragment row g) for tokens 8i + 2t4, +1; acc[4i + 2/3]: up (row g + 8).
+#pragma unroll
+      for (int i = 0; i < NB / 8; i += 2) {
+        const uint32_t r0 = pack_bf16(silu_mul(acc[4 * i] * gsc, acc[4 * i + 2] * gsc),
+                                      silu_mul(acc[4 * i + 1] * gsc, acc[4 * i + 3] * gsc));
+        const uint32_t r1 = pack_bf16(silu_mul(acc[4 * i + 4] * gsc, acc[4 * i + 6] * gsc),
+                                      silu_mul(acc[4 * i + 5] * gsc, acc[4 * i + 7] * gsc));
+        const int mi = (lane >> 3) & 1, rr = lane & 7;
+        const int tok = 8 * (i + mi) + rr;
+        stsm_x2_t(smem_u32(ep + tok * PITCH13 + cw * 16), r0, r1);
+      }
+    } else {
+#pragma unroll
+      for (int i = 0; i < NB / 8; i += 2) {
+        const uint32_t r0 = pack_bf16(acc[4 * i] * gsc, acc[4 * i + 1] * gsc);
+        const uint32_t r1 = pack_bf16(acc[4 * i + 2] * gsc, acc[4 * i + 3] * gsc);
+        const uint32_t r2 = pack_bf16(acc[4 * i + 4] * gsc, acc[4 * i + 5] * gsc);
+        const uint32_t r3 = pack_bf16(acc[4 * i + 6] * gsc, acc[4 * i + 7] * gsc);
+        const int mi = lane >> 3, rr = lane & 7;
+        const int tok = 8 * (i + (mi >> 1)) + rr;
+        const int col = 16 * cw + 8 * (mi & 1);
+        stsm_x4_t(smem_u32(ep + tok * PITCH2 + col * 2), r0, r1, r2, r3);
+      }
+    }
+  } else {
+    if constexpr (!G) {
+      // w2st (a): route ids into the staging rows' unused pad column (bytes 256..271 of each 272-B row; stmatrix
+      // writes bytes 0..255 only), read by the scatter loop after (C)
+      if (ptid < nvalid) *reinterpret_cast<int*>(ep + ptid * PITCH2 + 256) = sid_r;
+    }
+  }
+  named_bar(1, 512);  // (C)
+  if (G) {
+    // h_sorted[slot0 + t, 64 j .. 64 j + 64): 128 B per token row.
+    for (int v = ctid; v < nvalid * 8; v += 512) {
+      const int t = v >> 3, c = v & 7;
+      const uint4 val = *reinterpret_cast<const uint4*>(ep + t * PITCH13 + c * 16);
+      *reinterpret_cast<uint4*>(out + static_cast<size_t>(m.slot0 + t) * out_ld + m.j * 64 + c * 8) = val;
+    }
+  } else {
+    // cache3[route, 128 j .. 128 j + 128): 256 B per token row, real routes only (route id from the shared table).
+    for (int v = ctid; v < nvalid * 16; v += 512) {
+      const int t = v >> 4, c = v & 15;
+      const int sid = *reinterpret_cast<const int*>(ep + t * PITCH2 + 256);
+      if (sid >= 0 && sid < num_routes) {
+        const uint4 val = *reinterpret_cast<const uint4*>(ep + t * PITCH2 + c * 16);
+        *reinterpret_cast<uint4*>(out + static_cast<size_t>(sid) * out_ld + m.j * 128 + c * 8) = val;
+      }
+    }
+  }
+}
