+      int n = 0;
+      for (int it = blockIdx.x; it < total; it += gridDim.x) {
+        const Item m = decode_item(it, n_tw, be, s_cblk, s_cnb, s_gfirst, s_gcount);
+        const uint8_t* wsrcA = wbank + (static_cast<size_t>(m.e) * n_tiles + 2 * m.j) * tile_stride;
+        const uint8_t* wsrcB = wsrcA + tile_stride;
+        const uint64_t map = reinterpret_cast<uint64_t>(&maps.m[m.bucket]);
+        const uint32_t tx = WST2 + 2 * (16 << m.bucket) * 128;
+        for (int kb = 0; kb < KS; ++kb, ++n) {
+          const int s = n % STAGES_W;
+          mbar_wait(empty0 + 8 * s, ((n / STAGES_W) & 1) ^ 1, err, dead);
+          const uint32_t st = smem_u32(smem + s * STAGE_W);
+          const uint32_t fb = full0 + 8 * s;
+          mbar_expect_tx(fb, tx);
+          bulk_g2s(st, wsrcA + static_cast<size_t>(kb) * WST, WST, fb);
+          bulk_g2s(st + WST, wsrcB + static_cast<size_t>(kb) * WST, WST, fb);
+          tma_2d(st + WST2, map, kb * BK, m.slot0, fb);
+          tma_2d(st + WST2 + SLAB_HALF, map, kb * BK + 64, m.slot0, fb);
+        }
+      }
+    }
+  } else {
+    asm volatile("setmaxnreg.inc.sync.aligned.u32 232;\n" ::: "memory");
