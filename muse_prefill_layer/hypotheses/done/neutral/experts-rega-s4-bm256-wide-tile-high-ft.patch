+_REGA_WIDE_SRC = r"""
+// ---------------------------------------------------------------------------------------------
+// experts-rega-s4-bm256-wide-tile-high-ft (module muse_prefill_rega_wide): everything above is master's head + wgmma
+// wrappers + the namespace part of master's v2 body, read unchanged (Item, decode_item, dq_stage, Cap, BeSel, Maps,
+// helpers; master's own rega_kernel template is never instantiated in this module). New: rega_wide_kernel<G, BIG>.
+// Tile = 256 weight rows = master tiles j0 = 2J and j1 = 2J + 1 of the retiled bank, x the same <= 128-token chunk.
+// Stage = [tile j0 records 9216 B][tile j1 records 9216 B][slab 2 x 16384 B] = 51200 B, 3 stages. Per k-stage n a
+// consumer warp: wait full; dq(aA); 8 wgmma(aA -> accA); commit; [kb > 0: wait<1> (B(n-1) retired), release stage
+// n-1]; dq(aB); 8 wgmma(aB -> accB); commit; wait<1> (A(n) retired, aA free). After the item's last stage: wait<0>
+// and release it. A register set is never rewritten while its own group is in flight; the per-output k16
+// accumulation order equals master's, so outputs are bit-identical to rega_kernel.
+// ---------------------------------------------------------------------------------------------
+namespace {
+
+constexpr int STAGES_W = 3;
+constexpr int WST2 = 2 * WST;                      // 18432 B of weight records per stage (two adjacent tiles)
+constexpr int STAGE_W = WST2 + 2 * SLAB_HALF;      // 51200 B
+template <bool G>
+struct SmemW {
+  static constexpr int EPI = 128 * PITCH2;         // 128 token rows x 272 B (w13: 128 silu columns in one pass; w2: one 128-column pass)
+  static constexpr int BYTES = 1024 + STAGES_W * STAGE_W + EPI;   // 189440
+};
+static_assert(WST2 % 1024 == 0 && STAGE_W % 1024 == 0, "wide stage alignment (SWIZZLE_128B boxes)");
+static_assert(SmemW<true>::BYTES == 189440 && SmemW<false>::BYTES == 189440, "wide dynamic smem (spec)");
+static_assert(SmemW<false>::BYTES + 16384 + 1024 <= 227 * 1024, "shared memory budget");
+
+// w13 epilogue staging of one 64-silu-column half (acc of one master tile) at byte offset colbyte of the 272 B row.
+template <int NB>
+__device__ __forceinline__ void wide_stage_g(const float (&acc)[NB / 2], uint8_t* ep, int colbyte, int cw, int lane,
+                                             float gsc) {
+#pragma unroll
+  for (int i = 0; i < NB / 8; i += 2) {
+    const uint32_t r0 = pack_bf16(silu_mul(acc[4 * i] * gsc, acc[4 * i + 2] * gsc),
+                                  silu_mul(acc[4 * i + 1] * gsc, acc[4 * i + 3] * gsc));
+    const uint32_t r1 = pack_bf16(silu_mul(acc[4 * i + 4] * gsc, acc[4 * i + 6] * gsc),
+                                  silu_mul(acc[4 * i + 5] * gsc, acc[4 * i + 7] * gsc));
+    const int mi = (lane >> 3) & 1, rr = lane & 7;
+    const int tok = 8 * (i + mi) + rr;
+    stsm_x2_t(smem_u32(ep + tok * PITCH2 + colbyte + cw * 16), r0, r1);
+  }
+}
+
+// w2: one master tile's 128 output columns through the staging buffer, then coalesced stores to column block jj.
+template <int NB>
+__device__ __forceinline__ void wide_w2_pass(const float (&acc)[NB / 2], int jj, const Item& m, uint8_t* ep, int cw,
+                                             int lane, int ctid, float gsc, const int* __restrict__ sorted_ids,
+                                             int num_routes, __nv_bfloat16* __restrict__ out, int out_ld) {
+  named_bar(1, 256);  // every consumer is done reading the previous pass / item's staging tile
+#pragma unroll
+  for (int i = 0; i < NB / 8; i += 2) {
+    const uint32_t r0 = pack_bf16(acc[4 * i] * gsc, acc[4 * i + 1] * gsc);
+    const uint32_t r1 = pack_bf16(acc[4 * i + 2] * gsc, acc[4 * i + 3] * gsc);
+    const uint32_t r2 = pack_bf16(acc[4 * i + 4] * gsc, acc[4 * i + 5] * gsc);
+    const uint32_t r3 = pack_bf16(acc[4 * i + 6] * gsc, acc[4 * i + 7] * gsc);
+    const int mi = lane >> 3, rr = lane & 7;
+    const int tok = 8 * (i + (mi >> 1)) + rr;
+    const int col = 16 * cw + 8 * (mi & 1);
+    stsm_x4_t(smem_u32(ep + tok * PITCH2 + col * 2), r0, r1, r2, r3);
+  }
+  named_bar(1, 256);
+  const int nvalid = m.nbk * 16;
+  for (int v = ctid; v < nvalid * 16; v += 256) {
+    const int t = v >> 4, c = v & 15;
+    const int sid = __ldg(sorted_ids + m.slot0 + t);
+    if (sid >= 0 && sid < num_routes) {
+      const uint4 val = *reinterpret_cast<const uint4*>(ep + t * PITCH2 + c * 16);
+      *reinterpret_cast<uint4*>(out + static_cast<size_t>(sid) * out_ld + jj * 128 + c * 8) = val;
+    }
+  }
+}
+
+template <int NB, bool G>
+__device__ __forceinline__ void consume_item_wide(const Item& m, uint8_t* smem, uint8_t* ep, uint32_t full0,
+                                                  uint32_t empty0, int& n, int KS, int cw, int lane, int ctid,
+                                                  const float* __restrict__ gs, const int* __restrict__ sorted_ids,
+                                                  int num_routes, __nv_bfloat16* __restrict__ out, int out_ld,
+                                                  int* err, bool& dead) {
+  constexpr int NA = NB / 2;
+  float accA[NA], accB[NA];
+#pragma unroll
+  for (int i = 0; i < NA; ++i) {
+    accA[i] = 0.f;
+    accB[i] = 0.f;
+  }
+  uint32_t aA[8][4];
+  uint32_t aB[8][4];
+  int sprev = 0;
+  for (int kb = 0; kb < KS; ++kb) {
+    const int s = n % STAGES_W;
+    mbar_wait(full0 + 8 * s, (n / STAGES_W) & 1, err, dead);
+    const uint8_t* st = smem + s * STAGE_W;
+    const uint32_t slab = smem_u32(st + WST2);
+    // block A (tile j0): in flight at this point is at most B(n-1), which touches only accB / aB
+    dq_stage(st, cw, lane, aA);
+    fence_acc<NA>(accA);
+    wgmma_fence();
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+      for (int k = 0; k < 4; ++k) Wg<NB>::mma(accA, aA[r * 4 + k], make_desc(slab + r * SLAB_HALF + k * 32));
+    }
+    wgmma_commit();
+    if (kb > 0) {
+      wgmma_wait<1>();  // B(n-1) retired (groups retire in order): aB / accB free, stage n-1 can be released
+      if (lane == 0) mbar_arrive(empty0 + 8 * sprev);
+    }
+    // block B (tile j1)
+    dq_stage(st + WST, cw, lane, aB);
+    fence_acc<NA>(accB);
+    wgmma_fence();
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+      for (int k = 0; k < 4; ++k) Wg<NB>::mma(accB, aB[r * 4 + k], make_desc(slab + r * SLAB_HALF + k * 32));
+    }
+    wgmma_commit();
+    wgmma_wait<1>();  // A(n) retired: aA / accA free for the next stage; B(n) stays in flight under its dequant
+    sprev = s;
+    ++n;
+  }
+  wgmma_wait<0>();
+  if (lane == 0) mbar_arrive(empty0 + 8 * sprev);  // the item's last stage
+  fence_acc<NA>(accA);
+  fence_acc<NA>(accB);
+
+  const float gsc = __ldg(gs + m.e);
+  if (G) {
+    // tile j0's 64 silu columns at bytes [0, 128), tile j1's at [128, 256) of each 272 B row: 128 columns in one pass
+    named_bar(1, 256);  // every consumer is done reading the previous item's staging tile
+    wide_stage_g<NB>(accA, ep, 0, cw, lane, gsc);
+    wide_stage_g<NB>(accB, ep, 128, cw, lane, gsc);
+    named_bar(1, 256);
+    const int nvalid = m.nbk * 16;
+    // h_sorted[slot0 + t, 128 J .. 128 J + 128): 256 B per token row
+    for (int v = ctid; v < nvalid * 16; v += 256) {
+      const int t = v >> 4, c = v & 15;
+      const uint4 val = *reinterpret_cast<const uint4*>(ep + t * PITCH2 + c * 16);
+      *reinterpret_cast<uint4*>(out + static_cast<size_t>(m.slot0 + t) * out_ld + m.j * 128 + c * 8) = val;
+    }
+  } else {
+    wide_w2_pass<NB>(accA, 2 * m.j, m, ep, cw, lane, ctid, gsc, sorted_ids, num_routes, out, out_ld);
+    wide_w2_pass<NB>(accB, 2 * m.j + 1, m, ep, cw, lane, ctid, gsc, sorted_ids, num_routes, out, out_ld);
+  }
+}
+
+template <bool G, bool BIG>
+__global__ void __launch_bounds__(THREADS, 1)
+rega_wide_kernel(const __grid_constant__ Maps maps,
+                 const uint8_t* __restrict__ wbank,        // [E][T][K/64][REC], T = n_tiles (master's tiles)
+                 const float* __restrict__ gs,             // fp32 [E] global scale * 2^7
+                 const int* __restrict__ sorted_ids,       // block-16 align of the local ids
+                 const int* __restrict__ block_experts,
+                 const int* __restrict__ n_padded,
+                 int blocks_len, int num_routes, int n_tiles, int K, int n_experts,
+                 __nv_bfloat16* __restrict__ out, int out_ld, int* __restrict__ err) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  // Launch marker as master's kernel: err[1] (w13) / err[2] (w2) of the state's own error tensor.
+  if (blockIdx.x == 0 && threadIdx.x == 0) err[G ? 1 : 2] = 0x57474d4d;
+  extern __shared__ __align__(1024) uint8_t smem_raw[];
+  __shared__ __align__(8) uint64_t bars[2 * STAGES_W];
+  constexpr int CBLK = Cap<BIG>::BLK, CC = Cap<BIG>::C;
+  __shared__ int s_be[Cap<BIG>::SBE], s_cblk[CC], s_cnb[CC];
+  __shared__ int s_first[MAXE], s_gfirst[MAXE], s_gcount[MAXE];
+  __shared__ int s_wsum[THREADS / 32];
