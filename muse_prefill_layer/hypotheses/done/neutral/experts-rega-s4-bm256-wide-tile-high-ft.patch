+    wide instantiations' attributes before any launch, runs the exactness checks (wide == master bit for bit),
+    gates the wide block against master's routed block (both rounds <= REGA_WIDE_RATIO with the IQR condition),
+    and runs the copy / replay check with wide on, per class ('high', 'ft'), only for classes whose rega_ok is
+    ON. Sets only state['rega_wide'] = {class: mask} and state['rega_wide_ext']. Never raises. Returns the summary
+    lines; the last two are '[rega-wide] PATH CHOSEN high|ft: wide|master ...'."""
+    t0 = time.perf_counter()
+    state["rega_wide"] = {"high": 0, "ft": 0}
+    state["rega_wide_ext"] = None
+    lines, off, chosen = [], None, {"high": 0, "ft": 0}
+    before = time.perf_counter() - t_start
+    print(f"{REGA_WIDE_TAG} prepare total before the wide phase: {before:.1f}s", flush=True)
+    try:
+        used = before
+        if not any(state.get("rega_ok", {}).get(c, False) for c in REGA_WIDE_CLASSES):
+            off = "neither the high nor the ft class is on rega (master's gates), so there is nothing to replace"
+        elif used > REGA_WIDE_START_DEADLINE_S:
+            off = (f"skipped: deadline (prepare already used {used:.0f}s > {REGA_WIDE_START_DEADLINE_S:.0f}s wide "
+                   f"start deadline)")
+        else:
+            off, chosen = _rega_wide_run(state, weights, device, t_start, lines)
+    except Exception as e:  # a device fault would have poisoned the context; anything else keeps master
+        off, chosen = f"wide phase raised {e!r}"[:400], {"high": 0, "ft": 0}
+    finally:
+        for c in REGA_WIDE_CLASSES:
+            state["rega_wide"][c] = int(chosen.get(c, 0))
+        if not any(state["rega_wide"].values()):
+            state["rega_wide_ext"] = None
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+        if off:
+            lines.append(f"{REGA_WIDE_TAG} OFF: {off}")
+            print(lines[-1], flush=True)
+        lines.append(f"{REGA_WIDE_TAG} phase took {time.perf_counter() - t0:.1f}s; prepare total before {before:.1f}s, "
+                     f"after {time.perf_counter() - t_start:.1f}s")
+        for c in REGA_WIDE_CLASSES:
+            m = int(state["rega_wide"][c])
+            on = state.get("rega_ok", {}).get(c, False)
+            what = "master"
+            if m:
+                what = "wide (mask " + str(m) + " = " + ("w13+w2" if m == 3 else ("w13 only" if m == 1 else "w2 only")) + ")"
+            lines.append(f"{REGA_WIDE_TAG} PATH CHOSEN {c}: {what} (rega {'ON' if on else 'OFF'} for the class; "
+                         f"every other path as master)")
+    return lines
