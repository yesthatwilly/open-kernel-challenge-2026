+  for (int c = tid; c < nc; c += THREADS) {
+    const int e = be[s_cblk[c]];
+    atomicAdd(&s_gcount[e], 1);
+    if (c == 0 || be[s_cblk[c - 1]] != e) s_gfirst[e] = c;
+  }
+  __syncthreads();
+
+  // Wide items: (expert, wide tile J, chunk); wide tile J = master tiles 2J and 2J + 1 (n_tiles is even).
+  const int n_tw = n_tiles >> 1;
+  const int total = s_bad ? 0 : nc * n_tw;
+  const int KS = K / BK;
+  bool dead = false;
