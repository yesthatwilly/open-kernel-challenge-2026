+    int n = 0;
+    for (int it = blockIdx.x; it < total; it += gridDim.x) {
+      const Item m = decode_item(it, n_tw, be, s_cblk, s_cnb, s_gfirst, s_gcount);
+#define WGW_CONSUME(NB_)                                                                                     \
+  consume_item_wide<NB_, G>(m, smem, ep, full0, empty0, n, KS, cw, lane, ctid, gs, sorted_ids, num_routes,   \
+                            out, out_ld, err, dead)
+      switch (m.bucket) {
+        case 0: WGW_CONSUME(16); break;
+        case 1: WGW_CONSUME(32); break;
+        case 2: WGW_CONSUME(64); break;
+        default: WGW_CONSUME(128); break;
+      }
+#undef WGW_CONSUME
+    }
+  }
+#else
+  // Not the sm_90a image: no wgmma here. Flag it (error word 2) and do nothing else.
+  if (threadIdx.x == 0) atomicExch(err, 2);
+#endif
+}
+
+template <bool G, bool BIG>
+void info_wide(std::vector<int64_t>& r) {
+  const void* fn = reinterpret_cast<const void*>(rega_wide_kernel<G, BIG>);
+  const cudaError_t e1 = cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, SmemW<G>::BYTES);
+  cudaFuncAttributes a{};
+  const cudaError_t e2 = cudaFuncGetAttributes(&a, fn);
+  int occ = 0;
+  const cudaError_t e3 = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, fn, THREADS, SmemW<G>::BYTES);
+  if (e1 != cudaSuccess || e2 != cudaSuccess || e3 != cudaSuccess) (void)cudaGetLastError();
+  r.push_back((G ? 1 : 0) + (BIG ? 2 : 0));
+  r.push_back(e1 == cudaSuccess && e2 == cudaSuccess && e3 == cudaSuccess ? 1 : 0);
+  r.push_back(a.numRegs);
+  r.push_back(static_cast<int64_t>(a.localSizeBytes));
+  r.push_back(static_cast<int64_t>(a.sharedSizeBytes));
+  r.push_back(SmemW<G>::BYTES);
+  r.push_back(occ);
+  r.push_back(static_cast<int64_t>(e1));
+  r.push_back(a.binaryVersion);
+  r.push_back(a.ptxVersion);
+}
+
+}  // namespace
+
+// Per instantiation (w13 then w2 of the small class, then w13 then w2 of the first-turn class), 10 values each as
+// master's rega_init: flag (G + 2 BIG), attribute calls ok, numRegs, localSizeBytes, static smem, dynamic smem,
+// CTAs per SM, cudaFuncSetAttribute's rc, binaryVersion, ptxVersion. Also sets each dynamic smem attribute.
+std::vector<int64_t> rega_init_wide() {
+  std::vector<int64_t> r;
+  info_wide<true, false>(r);
+  info_wide<false, false>(r);
+  info_wide<true, true>(r);
+  info_wide<false, true>(r);
+  return r;
+}
+
+// rega_gemm of the wide kernel: same arguments as master's rega_gemm (n_tiles = MASTER's tile count, even); the
+// tensor maps are encoded from THIS call's bsrc into a stack-local Maps (the __grid_constant__ argument).
+void rega_gemm_wide(int64_t which, torch::Tensor bsrc, torch::Tensor wbank,
+                    torch::Tensor gs, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+                    int64_t num_routes, int64_t n_tiles, int64_t K, torch::Tensor out, int64_t grid, torch::Tensor err) {
+  TORCH_CHECK(which == 0 || which == 1, "rega_gemm_wide: which");
+  TORCH_CHECK(n_tiles > 0 && n_tiles % 2 == 0, "rega_gemm_wide: n_tiles must be even");
+  TORCH_CHECK(bsrc.is_cuda() && bsrc.is_contiguous() && bsrc.dim() == 2 && bsrc.scalar_type() == at::kBFloat16 &&
+              bsrc.size(0) > 0 && bsrc.size(1) > 0 && bsrc.size(1) == K,
+              "rega_gemm_wide: B-source scratch layout (cuda, contiguous, 2-D bf16, width K)");
+  TORCH_CHECK(wbank.is_contiguous() && gs.is_contiguous() && sorted_ids.is_contiguous() &&
+              block_experts.is_contiguous() && out.is_contiguous() && wbank.scalar_type() == at::kByte &&
+              gs.scalar_type() == at::kFloat && sorted_ids.scalar_type() == at::kInt &&
+              block_experts.scalar_type() == at::kInt && n_padded.scalar_type() == at::kInt &&
+              out.scalar_type() == at::kBFloat16 && err.scalar_type() == at::kInt && err.numel() >= 3,
+              "rega_gemm_wide: layout");
+  TORCH_CHECK(K % BK == 0 && block_experts.numel() <= MAXBLK_FT && gs.numel() <= MAXE &&
+              sorted_ids.numel() <= bsrc.size(0), "rega_gemm_wide: sizes");
+  TORCH_CHECK(wbank.numel() == gs.numel() * n_tiles * (K / 64) * REC, "rega_gemm_wide: weight bank size");
+  TORCH_CHECK(out.size(1) == (which == 0 ? n_tiles * 64 : n_tiles * 128), "rega_gemm_wide: output width");
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const int blocks_len = static_cast<int>(block_experts.numel());
+  const bool big = blocks_len > MAXBLK;   // capacity class from the table length (a shape), as master
+  EncodeTiledFn enc = get_encode();
+  TORCH_CHECK(enc != nullptr, "rega_gemm_wide: cuTensorMapEncodeTiled entry point missing");
+  Maps mp;
+  std::memset(&mp, 0, sizeof(Maps));
+  {
+    const cuuint64_t dims[2] = {static_cast<cuuint64_t>(bsrc.size(1)), static_cast<cuuint64_t>(bsrc.size(0))};
+    const cuuint64_t strides[1] = {static_cast<cuuint64_t>(bsrc.size(1)) * 2};
+    const cuuint32_t es[2] = {1, 1};
+    void* base = bsrc.data_ptr();
+    for (int b = 0; b < 4; ++b) {
+      const cuuint32_t box[2] = {64, static_cast<cuuint32_t>(16 << b)};
+      const CUresult rc = enc(&mp.m[b], CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, base, dims, strides, box, es,
+                              CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                              CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+      TORCH_CHECK(rc == CUDA_SUCCESS, "rega_gemm_wide: tensor map ", b, " rc ", static_cast<int>(rc));
+    }
+  }
+#define WGW_LAUNCH(G_, B_)                                                                                    \
+  rega_wide_kernel<G_, B_><<<static_cast<unsigned>(grid), THREADS, SmemW<G_>::BYTES, stream>>>(                \
+      mp, reinterpret_cast<uint8_t*>(wbank.data_ptr()), reinterpret_cast<float*>(gs.data_ptr()),              \
+      reinterpret_cast<int*>(sorted_ids.data_ptr()), reinterpret_cast<int*>(block_experts.data_ptr()),          \
+      reinterpret_cast<int*>(n_padded.data_ptr()), blocks_len, static_cast<int>(num_routes),                  \
+      static_cast<int>(n_tiles), static_cast<int>(K), static_cast<int>(gs.numel()),                           \
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), static_cast<int>(out.size(1)),                        \
+      reinterpret_cast<int*>(err.data_ptr()))
+  if (which == 0) {
+    if (big) WGW_LAUNCH(true, true); else WGW_LAUNCH(true, false);
+  } else {
+    if (big) WGW_LAUNCH(false, true); else WGW_LAUNCH(false, false);
+  }
+#undef WGW_LAUNCH
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+"""
+
+
+def _rega_wide_src():
+    """muse_prefill_rega_wide's CUDA source: master's head + wgmma wrappers + the namespace part of master's body
+    (shared helpers; master's templates in it are never instantiated here), the namespace closed, then
+    _REGA_WIDE_SRC (which reopens it). None when master's body does not have exactly one namespace end. Master's
+    strings are read, never edited."""
+    if _REGA_BODY.count(REGA_NS_END) != 1:
+        return None
+    return _REGA_HEAD + _rega_wgmma_src() + _REGA_BODY.split(REGA_NS_END)[0] + REGA_NS_END + _REGA_WIDE_SRC
+
+
+def _rega_wide_audit(src):
+    """Pre-build audit of the wide module: no templated Tensor accessor, no mutable file-scope / static / device
+    globals. Returns the findings."""
+    bad = []
+    for name, text in (("cpp", _REGA_WIDE_CPP), ("cuda", src)):
+        for n, line in enumerate(text.splitlines(), 1):
+            if "data_ptr<" in line or "data_ptr <" in line or _SSDQ_TEMPLATED_ACCESSOR.search(line):
+                bad.append(f"{name} line {n}: {line.strip()[:100]}")
+    return bad + _rega_audit_cpp(_REGA_WIDE_CPP + "\n" + src)
+
+
+def _rega_wide_build(src):
+    """Compile muse_prefill_rega_wide (prepare only, after master's whole setup): ext or None. Master's flags
+    (REGA_CUDA_CFLAGS) and TORCH_CUDA_ARCH_LIST=9.0a around load_inline, restored after; every wgmma / setmaxnreg
+    body is behind __CUDA_ARCH_FEAT_SM90_ALL (error word 2 otherwise). verbose=True so nvcc / ptxas warnings
+    (including 'wgmma serialization' ones) reach the run log; a serialized build is correct but loses the overlap."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    ext = None
+    try:
+        from torch.utils import cpp_extension
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        try:
+            arch_flags = cpp_extension._get_cuda_arch_flags()
+        except Exception as e:
+            print(f"{REGA_WIDE_TAG} TORCH_CUDA_ARCH_LIST=9.0a rejected ({e!r}); default list, error word 2 decides",
+                  flush=True)
+            if prev is None:
+                os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+            else:
+                os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+            arch_flags = ["<unknown>"]
+        print(f"{REGA_WIDE_TAG} build {REGA_WIDE_EXT_NAME}: TORCH_CUDA_ARCH_LIST="
+              f"{os.environ.get('TORCH_CUDA_ARCH_LIST')!r} -> {arch_flags}; extra_cuda_cflags {REGA_CUDA_CFLAGS}; "
+              f"nvcc / ptxas warnings (look for 'wgmma' serialization) follow in the build output", flush=True)
+        ext = load_inline(name=REGA_WIDE_EXT_NAME, cpp_sources=_REGA_WIDE_CPP, cuda_sources=src,
+                          functions=list(REGA_WIDE_FUNCS), extra_cuda_cflags=list(REGA_CUDA_CFLAGS), verbose=True)
+    except Exception as e:
+        ext = None
+        print(f"{REGA_WIDE_TAG} load_inline failed after {time.perf_counter() - t0:.1f}s: {str(e)[-400:]!r}",
+              flush=True)
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    if ext is not None:
+        print(f"{REGA_WIDE_TAG} nvcc + load {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext
+
+
+def _rega_wide_attrs(ext):
+    """Attributes of the four wide instantiations BEFORE any launch (rega_init_wide also sets each dynamic smem
+    attribute): attribute calls ok, no local memory (any spill turns that variant OFF), CTAs/SM >= 1, binaryVersion
+    90, static + dynamic smem within the SM limit, and the register pool numRegs x 384 >= 40 x 128 + 232 x 256
+    (setmaxnreg.inc would wait forever on a short pool). Returns {(gated, big): ok}."""
+    info = ext.rega_init_wide()
+    ok = {}
+    for i in range(0, len(info), 10):
+        flag, a_ok, regs, local_bytes, static_smem, dyn_smem, occ, e1, bin_v, ptx_v = info[i:i + 10]
+        gated, big = bool(flag & 1), bool(flag & 2)
+        pool_ok = regs * REGA_THREADS >= 40 * 128 + 232 * 256
+        good = (bool(a_ok) and pool_ok and local_bytes == 0 and occ >= 1 and bin_v == 90
+                and static_smem <= REGA_STATIC_SMEM_BOUND and static_smem + dyn_smem <= REGA_SMEM_LIMIT
+                and dyn_smem == REGA_WIDE_SMEM)
+        ok[(gated, big)] = good
+        print(f"{REGA_WIDE_TAG} kernel rega_wide_kernel<{'true' if gated else 'false'}, {'true' if big else 'false'}> "
+              f"({'w13+silu' if gated else 'w2'}, {'first-turn' if big else 'stage-1'} tables): attrs ok "
+              f"{bool(a_ok)} (SetAttribute rc {e1}), regs {regs} (pool {'ok' if pool_ok else 'SHORT'}), local bytes "
+              f"{local_bytes}{' (SPILL)' if local_bytes else ''}, static smem {static_smem} B, dynamic smem "
+              f"{dyn_smem} B, CTAs/SM {occ}, binaryVersion {bin_v}: {'ok' if good else 'OFF'}", flush=True)
+    return ok
+
+
+def _rega_wide_chunks(lids, state):
+    """prepare() only: the token rows (16 << bucket) of every chunk of the align tables kernel_fn runs
+    (_align_dispatch): chunks are cut every 8 blocks of 16 rows per expert, as master's and the wide kernel."""
+    _, (_, block_experts, n_padded) = _align_dispatch(lids, REGA_BSM, state)
+    used = min(int(n_padded.cpu()[0]) // REGA_BSM, block_experts.numel())
+    be = block_experts[:used].cpu().long()
+    counts = torch.bincount(be[(be >= 0) & (be < LOCAL_EXPERTS)], minlength=LOCAL_EXPERTS).tolist()
+    rows = []
+    for c in counts:
+        while c > 0:
+            nbk = min(c, 8)
+            rows.append(16 << (0 if nbk <= 1 else (1 if nbk <= 2 else (2 if nbk <= 4 else 3))))
+            c -= nbk
+    return rows
+
+
+def _rega_wide_load(rows, which, wide, grid):
+    """(items, min items per CTA, max items per CTA, bytes issued L2 -> SM) of one GEMM over these chunks: master
+    tile = n_tiles items per chunk of WST + rows x 256 B per k-stage; wide = n_tiles / 2 items of 2 WST + rows x 256 B."""
+    n_tiles = D_EXPERT // 64 if which == 0 else D_EXPERT // 128
+    per = n_tiles // 2 if wide else n_tiles
+    items = len(rows) * per
+    wst = (2 if wide else 1) * 2 * REGA_REC
+    issued = sum(per * REGA_WIDE_KS * (wst + r * 256) for r in rows)
+    return items, items // grid, -(-items // grid), issued
+
+
+def _rega_wide_mismatch(a, b, block_experts, sorted_ids, what, route_rows):
+    """The first differing element of two bf16 tensors compared by bit pattern: a printable description (the chunk
+    bucket of its token block, expert, row, column and both values). route_rows: rows are route ids (w2's y), else
+    sorted slots (w13's hs)."""
+    d = (a.view(torch.int16) != b.view(torch.int16)).nonzero()
+    if d.numel() == 0:
+        return "none"
+    r, c = int(d[0, 0]), int(d[0, 1])
+    if route_rows:
+        hit = (sorted_ids == r).nonzero()
+        slot = int(hit[0, 0]) if hit.numel() else -1
+    else:
+        slot = r
+    blk = slot // REGA_BSM if slot >= 0 else -1
+    be = block_experts.cpu().long()
+    expert = int(be[blk]) if 0 <= blk < be.numel() else -1
+    nbk, bucket = 0, -1
+    if expert >= 0:
+        first = int((be == expert).nonzero()[0])
+        run = int((be == expert).sum())
+        nbk = min(8, run - ((blk - first) // 8) * 8)
+        bucket = 16 << (0 if nbk <= 1 else (1 if nbk <= 2 else (2 if nbk <= 4 else 3)))
+    return (f"{what}: {int(d.shape[0])} differing elements; first at row {r} (slot {slot}, block {blk}, expert {expert}, "
+            f"chunk bucket {bucket} tokens), column {c}: master {float(a[r, c])!r} wide {float(b[r, c])!r}")
+
+
+def _rega_wide_exact(state, device, tokens, kind, gen, mask, tag):
+    """prepare() only: master's rega_gemm and the wide kernel on the SAME align tables / gather of one routing:
+    w13 into zeroed hs buffers, w2 (over master's hs for both) into zeroed y buffers; max |wide - master| must be
+    exactly 0 (bit patterns) on hs (mask bit 1) and y (mask bit 2), error word 0, launch markers of exactly the
+    wide kernels that ran. Every launch is announced by a flushed print before it and a synchronize + print after
+    it. Returns None or why."""
+    ext, wext, bank, err = state["rega_ext"], state["rega_wide_ext"], state["rega_bank"], state["rega_err"]
+    grid = int(state["rega_grid"])
+    x, tw, lids = _rega_case(tokens, kind, gen, device)
+    num_slots = tokens * TOP_K
+    _, (sorted_ids, block_experts, n_padded) = _align_dispatch(lids, REGA_BSM, state)
+    rows = block_experts.shape[0] * REGA_BSM
+    xs = torch.empty((rows, D_EXPERT), device=device, dtype=torch.bfloat16)
+    ext.rega_gather(x.contiguous(), sorted_ids, block_experts, n_padded, num_slots, LOCAL_EXPERTS, xs)
+    hs_m = torch.zeros((rows, D_EXPERT), device=device, dtype=torch.bfloat16)
+    hs_w = torch.zeros_like(hs_m)
+    y_m = torch.zeros((num_slots, D_EXPERT), device=device, dtype=torch.bfloat16)
+    y_w = torch.zeros_like(y_m)
+    a13 = (bank["q13"], bank["gs13"], sorted_ids, block_experts, n_padded, num_slots, D_EXPERT // 64, D_EXPERT)
+    a2 = (bank["q2"], bank["gs2"], sorted_ids, block_experts, n_padded, num_slots, D_EXPERT // 128, D_EXPERT)
+
+    def launch(fn, name, *args):
+        print(f"{REGA_WIDE_TAG} [{tag}] launching {name}", flush=True)
+        torch.cuda.synchronize()
+        fn(*args)
+        torch.cuda.synchronize()
+        print(f"{REGA_WIDE_TAG} [{tag}] {name} done", flush=True)
+
+    err.zero_()
+    launch(ext.rega_gemm, "master rega_kernel<w13+silu>", 0, xs, *a13, hs_m, grid, err)
+    launch(ext.rega_gemm, "master rega_kernel<w2>", 1, hs_m, *a2, y_m, grid, err)
+    master_word = _rega_marks(err)[0]
+    err.zero_()
+    if mask & 1:
+        launch(wext.rega_gemm_wide, "rega_wide_kernel<w13+silu>", 0, xs, *a13, hs_w, grid, err)
+    if mask & 2:
+        launch(wext.rega_gemm_wide, "rega_wide_kernel<w2>", 1, hs_m, *a2, y_w, grid, err)
+    word, m13, m2 = _rega_marks(err)
+    marks_ok = ((m13 == REGA_MAGIC) == bool(mask & 1)) and ((m2 == REGA_MAGIC) == bool(mask & 2))
+    eq13 = True if not mask & 1 else bool(torch.equal(hs_m.view(torch.int16), hs_w.view(torch.int16)))
+    eq2 = True if not mask & 2 else bool(torch.equal(y_m.view(torch.int16), y_w.view(torch.int16)))
+    ok = eq13 and eq2 and word == 0 and master_word == 0 and marks_ok
+    print(f"{REGA_WIDE_TAG} exact T={tokens} {kind}: {int((lids >= 0).sum())} local routes; wide vs master max "
+          f"|diff| == 0 (bitwise): hs {eq13 if mask & 1 else 'n/a'}, y {eq2 if mask & 2 else 'n/a'}; error word "
+          f"{word} ({REGA_ERR_TEXT.get(word, '?')}; master {master_word}); markers w13 {m13:#x} w2 {m2:#x}"
+          f"{'' if ok else '  <-- MISS'}", flush=True)
+    why = None
+    if not ok:
+        parts = []
+        if not eq13:
+            parts.append(_rega_wide_mismatch(hs_m, hs_w, block_experts, sorted_ids, "w13 hs", False))
+        if not eq2:
+            parts.append(_rega_wide_mismatch(y_m, y_w, block_experts, sorted_ids, "w2 y", True))
+        why = (f"exact T={tokens} {kind}: error word {word} (master {master_word}), markers {m13:#x}/{m2:#x}"
+               f"{'; ' if parts else ''}{'; '.join(parts)}")
+        print(f"{REGA_WIDE_TAG} first mismatch: {why}", flush=True)
+    del x, tw, lids, xs, hs_m, hs_w, y_m, y_w, sorted_ids, block_experts, n_padded
+    torch.cuda.synchronize()
+    torch.cuda.empty_cache()
+    return why
+
+
+def _rega_wide_gate(state, device, tokens, kind, cls, mask, prenorm):
+    """prepare() only: interleaved cold-L2 CUDA-graph replays at one T and routing of master's ACTUALLY ROUTED
+    block (_experts_rega with wide off, with the fused norm-gather when prenorm, as kernel_fn runs it), the same
+    block with wide on for this class, and the w13 / w2 kernels alone for both variants (over one align / gather
+    made here). REGA_WIDE_ROUNDS interleaved rounds of REGA_WIDE_ALTERNATIONS alternations (order rotated and
+    flipped, a 256 MB flush before each replay, empty-graph baseline of the round subtracted). Returns
+    ([per round {name: (median us, IQR us)}], local routes, lids)."""
+    gen = torch.Generator(device=device).manual_seed(20261031)
+    x, tw, lids = _rega_case(tokens, kind, gen, device)
+    ext, wext, bank, err = state["rega_ext"], state["rega_wide_ext"], state["rega_bank"], state["rega_err"]
+    grid = int(state["rega_grid"])
+    err.zero_()
+    num_slots = tokens * TOP_K
+    _, (sorted_ids, block_experts, n_padded) = _align_dispatch(lids, REGA_BSM, state)
+    rows = block_experts.shape[0] * REGA_BSM
+    xs = torch.empty((rows, D_EXPERT), device=device, dtype=torch.bfloat16)
+    ext.rega_gather(x.contiguous(), sorted_ids, block_experts, n_padded, num_slots, LOCAL_EXPERTS, xs)
+    hs = torch.zeros((rows, D_EXPERT), device=device, dtype=torch.bfloat16)
+    y = torch.zeros((num_slots, D_EXPERT), device=device, dtype=torch.bfloat16)
+
+    def gemm(wide, which):
+        if which == 0:
+            args = (xs, bank["q13"], bank["gs13"], sorted_ids, block_experts, n_padded, num_slots, D_EXPERT // 64,
+                    D_EXPERT, hs)
+        else:
+            args = (hs, bank["q2"], bank["gs2"], sorted_ids, block_experts, n_padded, num_slots, D_EXPERT // 128,
+                    D_EXPERT, y)
+        if wide:
+            wext.rega_gemm_wide(which, *args, grid, err)
+        else:
+            ext.rega_gemm(which, *args, grid, err)
+
+    gemm(False, 0)  # real hs for the w2-only graphs
+    torch.cuda.synchronize()
+    st_m, st_w = dict(state), dict(state)
+    st_m["rega_wide"] = {}
+    st_w["rega_wide"] = {cls: int(mask)}
+    fns = {"block:master": lambda: _experts_rega(x, tw, lids, st_m, prenorm=prenorm),
+           "block:wide": lambda: _experts_rega(x, tw, lids, st_w, prenorm=prenorm),
+           "w13:master": lambda: gemm(False, 0), "w13:wide": lambda: gemm(True, 0),
+           "w2:master": lambda: gemm(False, 1), "w2:wide": lambda: gemm(True, 1)}
+    graphs = {name: _ssdq_graph_time(fn, device) for name, fn in fns.items()}
+    tiny = torch.zeros(16, dtype=torch.float32, device=device)
+    graphs["empty"] = _ssdq_graph_time(lambda: tiny.zero_(), device)
+    flush = torch.empty(256 * 2 ** 20 // 4, dtype=torch.float32, device=device)  # > the 50 MB L2
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def once(graph):
+        flush.zero_()
+        ev[0].record()
+        graph.replay()
+        ev[1].record()
+        torch.cuda.synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1000.0
+
+    names = list(graphs)
+    for name in names:
+        once(graphs[name])  # warm-up replay
+    rounds = []
+    for rnd in range(REGA_WIDE_ROUNDS):
+        samples = {name: [] for name in names}
+        for i in range(REGA_WIDE_ALTERNATIONS):
+            k = (i + 3 * rnd) % len(names)
+            order = names[k:] + names[:k]
+            if (i + rnd) % 2:
+                order = order[::-1]
+            for name in order:
+                samples[name].append(once(graphs[name]))
