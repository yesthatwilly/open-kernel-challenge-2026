+def _rega_wide_gate_lines(tag, cls, tokens, kind, rounds, local, lids, mask, state):
+    """The WIDE GATE lines of one routing (per round: block medians / IQRs, ratio; per kernel us, TFLOP/s, issued
+    TB/s, items and items per CTA); returns (ratios per round, iqr ok per round, lines)."""
+    grid = int(state["rega_grid"])
+    chunks = _rega_wide_chunks(lids, state)
+    ratios, iqr_ok, lines = [], [], []
+    for r, res in enumerate(rounds, 1):
+        bm, bw = res["block:master"], res["block:wide"]
+        ratio = bw[0] / max(bm[0], 1e-9)
+        ok_iqr = bw[1] <= REGA_WIDE_IQR_RATIO * max(bm[1], REGA_WIDE_IQR_FLOOR_US)
+        ratios.append(ratio)
+        iqr_ok.append(ok_iqr)
+        lines.append(f"{REGA_WIDE_TAG} WIDE GATE {tag} {cls} T={tokens} {kind} round {r}/{len(rounds)} ({local} local "
+                     f"routes): master block (rega_kernel, as routed) median {bm[0]:.1f} us IQR {bm[1]:.1f}; wide "
+                     f"block (rega_wide_kernel mask {mask}) median {bw[0]:.1f} us IQR {bw[1]:.1f} "
+                     f"({bw[1] / max(bm[1], 1e-9):.2f}x master's, need <= {REGA_WIDE_IQR_RATIO}); ratio {ratio:.3f} "
+                     f"(need <= {REGA_WIDE_RATIO})")
+        for which, name, flop in ((0, "w13", 2.0 * 2 * D_EXPERT * D_EXPERT), (1, "w2", 2.0 * D_EXPERT * D_EXPERT)):
+            parts = []
+            for variant in ("master", "wide"):
+                us, iqr = res[f"{name}:{variant}"]
+                items, lo, hi, issued = _rega_wide_load(chunks, which, variant == "wide", grid)
+                parts.append(f"{variant} {'rega_wide_kernel' if variant == 'wide' else 'rega_kernel'}<{name}> "
+                             f"{us:.1f} us (IQR {iqr:.1f}) {local * flop / max(us, 1e-9) / 1e6:.0f} TFLOP/s, "
+                             f"{issued / max(us, 1e-9) / 1e6:.2f} TB/s issued L2->SM, {items} items "
+                             f"({lo}-{hi} per CTA of {grid})")
+            lines.append(f"{REGA_WIDE_TAG} KERNELS {tag} {cls} T={tokens} round {r}: " + "; ".join(parts))
+    for ln in lines:
+        print(ln, flush=True)
+    return ratios, iqr_ok, lines
