+# ---------------------------------------------------------------------------------------------------------------
+# experts-rega-stage-antiphase-ordered-issue (ap): master's rega w13 + w2 with the wgmma ISSUE of its two existing
+# consumer warpgroups ordered at stage granularity (FA3's warp-scheduler barrier): WG0 issues stage n, then WG1 issues
+# stage n, then WG0 stage n + 1, ... mbar_wait(full) and dq_stage stay outside any barrier, so in steady state one WG
+# dequantizes the next stage while the other WG's wgmma group runs. Master's 4-stage ring, 384 threads, 40 / 232
+# setmaxnreg split, items, chunking, buckets, producer and epilogue; wgmma_wait<0> every stage (variant A). A separate
+# module, muse_prefill_rega_ap, derived from _rega_fsilu_src() (the fsilu_w2a source master dispatches: fast-silu w13,
+# w2st arm a w2) by asserted (old, new) edits, each old occurring exactly once (else OFF: edit k); the source must
+# first have no 'bar.arrive' and no named_bar id other than 1. Master's rega_gemm / rega_init signatures, launch
+# markers, error words and four rega_kernel<G, BIG> instantiations (ft served too). Outputs are bit-identical by
+# construction (each WG's instruction sequence and accumulation order unchanged): the gate asserts torch.equal.
+# Built once with -Xptxas -Werror (a ptxas warning, e.g. C7510 / C7512 wgmma serialization, is the OFF answer).
+# In-run skew indicator: a prepare-only probe launch (error buffer >= 4 + 96 ints, err[0] = REGA_AP_PROBE_MAGIC; no
+# timed launch passes it) makes lane 0 of consumer warps 0 and 4 of CTA 0 accumulate clock64 at issue and at retire
+# per N bucket; printed as own-group latency and retire skew in units of the stage period (skew ~0: lockstep
+# fallback; ~0.3-0.6: anti-phase formed).
+# ---------------------------------------------------------------------------------------------------------------
+REGA_AP_TAG = "[rega-ap]"
+REGA_AP_EXT_NAME = "muse_prefill_rega_ap"
+REGA_AP_CLASSES = ("low", "high", "ft")      # fsilu's gate order: ft (the costliest) last
+REGA_AP_POP_RATIO = 0.97                     # pair ap / master's dispatched pair, pop routing, every round + L2 mode
+REGA_AP_RANDOM_RATIO = 1.00                  # same, random routing
+REGA_AP_GUARD_RATIO = 1.00                   # same, the skew guard (low: rega-lo's ~1350-route alpha; else 'skewed')
+REGA_AP_START_DEADLINE_S = REGA_FSILU_START_DEADLINE_S   # no nvcc build once prepare() has used this (200 s)
+REGA_AP_STEP_DEADLINE_S = REGA_FSILU_STEP_DEADLINE_S     # no class step after this (265 s)
+REGA_AP_CANARY = ((210, "one"), (300, "random"))          # small-class instantiations: CTAs with 0 and 1 items
+REGA_AP_FT_CANARY = (16384, "random")                    # first-turn instantiations, at the ft class's start
+REGA_AP_EXACT_KINDS = ("random", "skewed", "one")        # + the judge-like pop routing
+REGA_AP_MAX_REGS = 168                       # numRegs at launch (384 threads, 1 CTA/SM)
+REGA_AP_PROBE_MAGIC = 0x41505052             # C++ AP_PROBE_MAGIC: err[0] of a probe launch
+REGA_AP_PROBE_F = 6                          # C++ AP_PR_F: long longs per (probe warp, N bucket)
+REGA_AP_PROBE_INTS = 4 + 2 * 2 * len(REGA_BUCKETS) * REGA_AP_PROBE_F   # err[0..3] + 48 long longs at err + 4
+REGA_AP_STATE_KEYS = REGA_W2ST_STATE_KEYS + ("rega_ap_ext", "rega_ap_ok")
+REGA_AP_EDITS = (
+    # 0 (E1): the bar.arrive helper, the barrier ids, the probe layout and its accumulator
+    (r"""__device__ __forceinline__ void named_bar(int id, int count) {
+  asm volatile("bar.sync %0, %1;\n" :: "r"(id), "r"(count) : "memory");
+}
+""",
+     r"""__device__ __forceinline__ void named_bar(int id, int count) {
+  asm volatile("bar.sync %0, %1;\n" :: "r"(id), "r"(count) : "memory");
+}
+// rega-ap (experts-rega-stage-antiphase-ordered-issue): the two consumer warpgroups' wgmma ISSUE is ordered by two
+// named barriers (FA3's warp-scheduler barrier). bar 0 = __syncthreads, bar 1 = the epilogue (both consumer WGs);
+// AP_BAR_W0 = 2: WG0 may issue (WG1 arrives after committing a stage); AP_BAR_W1 = 3: WG1 may issue (WG0 arrives
+// after committing a stage). Count 256 = the 128 syncing + the 128 arriving threads of one phase.
+__device__ __forceinline__ void bar_arrive(int id, int count) {
+  asm volatile("bar.arrive %0, %1;\n" :: "r"(id), "r"(count) : "memory");
+}
+constexpr int AP_BAR_W0 = 2;
+constexpr int AP_BAR_W1 = 3;
+constexpr int AP_COUNT = 256;
+// Skew probe (prepare-time diagnostic launches only): ON in CTA 0 when err[0] == AP_PROBE_MAGIC at kernel start (a
+// timed launch's error word is 0..4). Shared accumulators per probe warp (consumer warps 0 / 4, lane 0) and N bucket,
+// AP_PR_F long longs: stages, sum(retire - issue), sum(issue - base), sum(retire - base), sum(retire - the previous
+// retire of the same item), periods; then the previous retire and the issue stamp per probe warp and the CTA's base
+// clock. Written to ((long long*)(err + 4))[0 .. 2 * AP_PR_W) after the item loop.
+constexpr int AP_PROBE_MAGIC = 0x41505052;
+constexpr int AP_PR_F = 6;
+constexpr int AP_PR_W = 4 * AP_PR_F;
+constexpr int AP_PR_PREV = 2 * AP_PR_W;
+constexpr int AP_PR_T0 = AP_PR_PREV + 2;
+constexpr int AP_PR_BASE = AP_PR_T0 + 2;
+constexpr int AP_PR_N = AP_PR_BASE + 1;
+template <int NB>
+__device__ __forceinline__ void ap_probe_acc(long long* aps, bool wg1, int kb, long long t1) {
+  constexpr int BI = NB == 16 ? 0 : (NB == 32 ? 1 : (NB == 64 ? 2 : 3));
+  const int w = wg1 ? 1 : 0;
+  long long* q = aps + w * AP_PR_W + BI * AP_PR_F;
+  const long long t0 = aps[AP_PR_T0 + w], base = aps[AP_PR_BASE];
+  q[0] += 1;
+  q[1] += t1 - t0;
+  q[2] += t0 - base;
+  q[3] += t1 - base;
+  if (kb > 0) {
+    q[4] += t1 - aps[AP_PR_PREV + w];
+    q[5] += 1;
+  }
+  aps[AP_PR_PREV + w] = t1;
+}
+"""),
+    # 1 (E2): consume_item's trailing parameters
+    (r"""int* err, bool& dead) {
+  constexpr int NA = NB / 2;""",
+     r"""int* err, bool& dead, bool wg1, bool& started, bool probe,
+                                             long long* aps) {
+  constexpr int NA = NB / 2;"""),
+    # 2 (E3a): the issue barrier, between fence_acc and wgmma_fence (dequant stays before it)
+    (r"""    const uint32_t slab = smem_u32(st + WST);
+    fence_acc<NA>(acc);
+    wgmma_fence();
+""",
+     r"""    const uint32_t slab = smem_u32(st + WST);
+    fence_acc<NA>(acc);
+    // rega-ap: wgmma ISSUE order WG0 n, WG1 n, WG0 n + 1, ...; mbar_wait(full) and dq_stage stay BEFORE (outside) the
+    // barrier. __syncwarp first: bar.sync is .aligned and mbar_wait's spin may have split the warp. WG0 holds the
+    // issue token at launch (its first stage of the launch syncs nothing: `started`, uniform over WG0). Unconditional
+    // on `dead`: a timed-out mbarrier still executes every AP op, so the barrier counts stay paired.
+    __syncwarp();
+    if (wg1) {
+      named_bar(AP_BAR_W1, AP_COUNT);
+    } else {
+      if (started) named_bar(AP_BAR_W0, AP_COUNT);
+      started = true;
+    }
+    if (probe) aps[AP_PR_T0 + (wg1 ? 1 : 0)] = clock64();  // probe warps only: issue stamp (one value per warp)
+    wgmma_fence();
+"""),
+    # 3 (E3b): the arrive between commit and wait<0> (FA3's warp_scheduler_barrier_arrive placement); probe retire
+    (r"""    wgmma_commit();
+    wgmma_wait<0>();  // group retired: a0[] may be rewritten and this stage released at once
+    fence_acc<NA>(acc);
+    if (lane == 0) mbar_arrive(empty0 + 8 * s);
+""",
+     r"""    wgmma_commit();
+    bar_arrive(wg1 ? AP_BAR_W0 : AP_BAR_W1, AP_COUNT);  // rega-ap: this WG's group of the stage is issued
+    wgmma_wait<0>();  // group retired: a0[] may be rewritten and this stage released at once
+    fence_acc<NA>(acc);
+    if (probe) {  // rega-ap skew probe: retire stamp, accumulated by lane 0 (outside the wgmma stage)
+      const long long t1 = clock64();
+      if (lane == 0) ap_probe_acc<NB>(aps, wg1, kb, t1);
+    }
+    if (lane == 0) mbar_arrive(empty0 + 8 * s);
+"""),
+    # 4: the probe's shared accumulators and flag
+    (r"""  __shared__ int s_bad;  // set when an expert owns two runs: the chunk groups would not be contiguous
+""",
+     r"""  __shared__ int s_bad;  // set when an expert owns two runs: the chunk groups would not be contiguous
+  __shared__ long long s_ap[AP_PR_N];  // rega-ap skew probe accumulators (CTA 0 of a probe launch only)
+  __shared__ int s_ap_on;              // rega-ap skew probe flag (read by the consumers after __syncthreads)
+"""),
+    # 5: the probe guard, read by thread 0 of CTA 0 before any error write of this thread
+    (r"""  int nb = __ldg(n_padded) / 16;
+  const int nb_wanted = nb;
+""",
+     r"""  // rega-ap skew probe guard: thread 0 of CTA 0 reads the error word BEFORE its own first error write (the overflow
+  // check below). Every other CTA and every launch whose err[0] is not the magic (all timed launches): off, no clock.
+  if (tid == 0) {
+    const int on = (blockIdx.x == 0 && *reinterpret_cast<volatile int*>(err) == AP_PROBE_MAGIC) ? 1 : 0;
+    s_ap_on = on;
+    if (on) {
+      for (int i = 0; i < AP_PR_N; ++i) s_ap[i] = 0;
+      s_ap[AP_PR_BASE] = clock64();
+    }
+  }
+  int nb = __ldg(n_padded) / 16;
+  const int nb_wanted = nb;
+"""),
+    # 6 (E4): the consumer's warpgroup id, issue token and probe flag
+    (r"""    const int ctid = tid - 128, cw = ctid >> 5;
+    int n = 0;
+""",
+     r"""    const int ctid = tid - 128, cw = ctid >> 5;
+    // rega-ap: wg1 is warp-uniform (consumer warps 4-7, weight rows 64-127); started (WG0 has issued >= 1 stage in
+    // this launch) is uniform over WG0: both WGs walk the same items, KS = K / BK stages each. probe: consumer warps
+    // 0 and 4 of CTA 0 of a probe launch.
+    const bool wg1 = cw >= 4;
+    bool started = false;
+    const bool probe = s_ap_on != 0 && (cw & 3) == 0;
+    int n = 0;
+"""),
+    # 7 (E4): consume_item's new arguments
+    (r"""                       out_ld, err, dead)
+      switch (m.bucket) {""",
+     r"""                       out_ld, err, dead, wg1, started, probe, s_ap)
+      switch (m.bucket) {"""),
+    # 8 (E4): WG0's final sync after the item loop; the probe's write-out
+    (r"""#undef WG_CONSUME
+    }
+  }
+#else""",
+     r"""#undef WG_CONSUME
+    }
+    // rega-ap: WG0's last sync absorbs WG1's arrive after its last stage. Over a launch of S consumed stages WG0 syncs
+    // AP_BAR_W0 (S - 1) + 1 = S times = WG1's arrives, and WG1 syncs AP_BAR_W1 S times = WG0's arrives; a CTA with no
+    // item (started false) does no AP op at all.
+    if (!wg1 && started) {
+      __syncwarp();
+      named_bar(AP_BAR_W0, AP_COUNT);
+    }
+    if (probe && lane == 0) {
+      long long* dst = reinterpret_cast<long long*>(err + 4) + (wg1 ? AP_PR_W : 0);
+      const long long* src = s_ap + (wg1 ? AP_PR_W : 0);
+      for (int i = 0; i < AP_PR_W; ++i) dst[i] = src[i];
+    }
+  }
+#else"""),
+)
