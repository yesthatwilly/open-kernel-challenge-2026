+def _attn_front(data, state, mode):
+    """qkv projection through o_norm_gate. mode None: master (one GEMM, one stream). mode (fork, prio):
+    q|k|v columns GEMM on the main stream; the gate-columns GEMM on state['side_stream'], forked from the
+    main stream right after the q|k|v GEMM (fork 'qkv') or from the chain stream right after store_cache
+    (fork 'store'); the attention chain on state['hp_stream'] (a priority -1 stream) when prio, else on
+    the main stream; every side stream joins the main stream before o_norm_gate. Event-based, so it
+    captures into a graph. All state is read from `state`."""
+    cfg = data["config"]
+    tokens = cfg["tokens"]
+    hq, hkv, d = cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"]
+    n_main = hq * d + 2 * hkv * d
+    x = data["attn_input"]
+    if mode is None:
+        qkv = _gemm(x, state["dense"]["qkv_gate"])
+        out = _attn_chain(data, state, qkv)
+    else:
+        fork_point, prio = mode
+        main = torch.cuda.current_stream()
+        side = state["side_stream"]
+        chain = state["hp_stream"] if prio else main
+        qkv = torch.empty((tokens, n_main + hq * d), dtype=torch.bfloat16, device=x.device)
+        torch.mm(x, state["qkv_w_main"].t(), out=qkv[:, :n_main])
+
+        def fork_gate(src):
+            side.wait_stream(src)
+            with torch.cuda.stream(side):
+                torch.mm(x, state["qkv_w_gate"].t(), out=qkv[:, n_main:])
+
+        if fork_point == "qkv":
+            fork_gate(main)
+        if prio:
+            chain.wait_stream(main)
+        with torch.cuda.stream(chain):
+            out = _attn_chain(data, state, qkv, (lambda: fork_gate(chain)) if fork_point == "store" else None)
+        if prio:
+            main.wait_stream(chain)
+        main.wait_stream(side)
+    gate = qkv[:, n_main:]
+    return state["o_norm_gate"](out.reshape(tokens, hq * d).to(torch.bfloat16), gate)
