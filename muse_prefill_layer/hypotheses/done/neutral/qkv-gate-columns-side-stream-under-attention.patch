+def _qkv_case(batch, length, ctx, windowed, device):
+    """One synthetic scored-shape input for the attention front (page size 1, random FP8 K/V rows, kv_scale
+    1, no scheduler metadata, as at prefill)."""
+    gen = torch.Generator(device=device).manual_seed(20261025)
+    tokens = batch * length
+    n = ctx + length
+    total = batch * n
+    page_table = torch.randperm(total, generator=gen, device=device).to(torch.int32).view(batch, n).contiguous()
+    k_cache = torch.randn((total, 1, 2, 64), generator=gen, device=device, dtype=torch.bfloat16).to(FP8)
+    v_cache = torch.randn((total, 1, 2, 64), generator=gen, device=device, dtype=torch.bfloat16).to(FP8)
+    pos = (ctx + torch.arange(length, device=device, dtype=torch.int64)).view(1, length).repeat(batch, 1)
+    cache_loc = page_table.long().gather(1, pos).reshape(-1)
+    return {
+        "attn_input": torch.randn((tokens, HIDDEN), generator=gen, device=device, dtype=torch.float32).to(torch.bfloat16),
+        "positions": pos.reshape(-1).contiguous(),
+        "cache_loc": cache_loc,
+        "cache_seqlens": torch.full((batch,), n, dtype=torch.int32, device=device),
+        "cu_seqlens_q": torch.arange(0, tokens + 1, length, dtype=torch.int32, device=device),
+        "scheduler_metadata": None,
+        "k_cache": k_cache,
+        "v_cache": v_cache,
+        "k_scale": torch.tensor(1.0, dtype=torch.float32, device=device),
+        "v_scale": torch.tensor(1.0, dtype=torch.float32, device=device),
+        "page_table": page_table,
+        "config": {"batch": batch, "q_len": length, "tokens": tokens, "num_q_heads": 16, "num_kv_heads": 2,
+                   "head_dim": 64, "window": 2048 if windowed else 0, "rope_theta": ROPE_THETA if windowed else 0.0,
+                   "qk_scale_factor": QKV_QK_SCALE_FACTOR, "sm_scale": 64 ** -0.5, "kv_scale": 1.0},
+    }
+
