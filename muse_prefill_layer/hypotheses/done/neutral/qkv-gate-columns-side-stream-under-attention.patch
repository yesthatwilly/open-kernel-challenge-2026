+def _qkv_no_copy_proof(state, device):
+    """prepare() only: one eager call of the split GEMM pair under torch.profiler. The column-slice out=
+    targets (row stride 2304, unit column stride) must reach cuBLAS as ldc = 2304: no copy / elementwise /
+    memset kernel, only GEMM-class kernels (2..4: a split-K reduce is allowed), qkv.data_ptr() unchanged.
+    Returns (ok, why)."""
+    x = torch.randn((753, HIDDEN), dtype=torch.bfloat16, device=device)
+    qkv = torch.empty((753, 2304), dtype=torch.bfloat16, device=device)
+    ptr = qkv.data_ptr()
+
+    def pair():
+        torch.mm(x, state["qkv_w_main"].t(), out=qkv[:, :1280])
+        torch.mm(x, state["qkv_w_gate"].t(), out=qkv[:, 1280:])
+
+    # Correctness first (fatal on a miss): NaN-filled qkv, the pair must write every element in place and match
+    # the one-GEMM product within bf16 accumulation-order noise.
+    qkv.fill_(float("nan"))
+    pair()
+    torch.cuda.synchronize()
+    ref = _gemm(x, state["dense"]["qkv_gate"]).float()
+    got = qkv.float()
+    if qkv.data_ptr() != ptr:
+        return False, "qkv data_ptr changed"
+    if not bool(torch.isfinite(got).all()):
+        return False, "column-slice out= left unwritten elements"
+    rel = float((got - ref).norm() / ref.norm().clamp_min(1e-12))
+    if rel > 1e-3:
+        return False, f"split pair vs one GEMM rel L2 {rel:.2e} > 1e-3"
+    # The no-copy proof is a performance check only (the timing gate also sees a copy), so a profiler that is
+    # unavailable in this process (CUPTI busy, a profiler already running) does not turn the path off.
+    try:
+        with torch.profiler.profile(activities=[torch.profiler.ProfilerActivity.CUDA]) as prof:
+            pair()
+            torch.cuda.synchronize()
+        names = [e.name for e in prof.events() if e.device_type == torch.autograd.DeviceType.CUDA]
+    except Exception as e:
+        print(f"{QKV_TAG} profiler unavailable ({e!r}); correctness proven, the timing gate decides", flush=True)
+        return True, "ok (profiler unavailable)"
+    if not names:
+        print(f"{QKV_TAG} profiler recorded no CUDA kernels; correctness proven, the timing gate decides", flush=True)
+        return True, "ok (profiler recorded nothing)"
+    bad = ("copy", "elementwise", "memcpy", "memset", "fill", "vectorized")
+    gemm_like = ("gemm", "nvjet", "cutlass", "cublas", "gemv", "splitk", "sm90", "sm80")
+    print(f"{QKV_TAG} profiler proof kernels: {names}", flush=True)
+    if qkv.data_ptr() != ptr:
+        return False, "qkv data_ptr changed"
+    if not 2 <= len(names) <= 4:
+        return False, f"{len(names)} kernels (want 2..4)"
+    for n in names:
+        low = n.lower()
+        if any(b in low for b in bad) or not any(g in low for g in gemm_like):
+            return False, f"non-GEMM kernel {n[:80]}"
+    return True, "ok"
+
