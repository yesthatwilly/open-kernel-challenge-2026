+def _qkv_rows_err(a, b):
+    """(rel L2 over all rows, worst row rel error with the row norm floored at a tenth of the mean row norm)."""
+    diff = (a - b).float().norm(dim=1)
+    ref = b.float().norm(dim=1)
+    floor = 0.1 * ref.mean()
+    rel = float((a - b).float().norm() / b.float().norm().clamp_min(1e-12))
+    worst = float((diff / torch.maximum(ref, floor).clamp_min(1e-12)).max())
+    return rel, worst
+
+
+def _qkv_parity(data, state, mode):
+    """Eager run of master then the split mode on the same inputs (the K/V rows master wrote are zeroed
+    before the split run, so a missed write shows). Returns (ok, text)."""
+    rows = data["cache_loc"]
+    ku = data["k_cache"].view(torch.uint8).view(-1, 128)
+    vu = data["v_cache"].view(torch.uint8).view(-1, 128)
+    # Gather through the uint8 views (index on float8 is not guaranteed), then reinterpret as FP8.
+    def kc_rows():
+        return ku[rows].view(FP8).float()
+
+    def vc_rows():
+        return vu[rows].view(FP8).float()
+    o_ref = _attn_front(data, state, None).float().clone()
+    torch.cuda.synchronize()
+    k_ref, v_ref = kc_rows(), vc_rows()
+    ku[rows] = 0
+    vu[rows] = 0
+    o_new = _attn_front(data, state, mode).float()
+    torch.cuda.synchronize()
+    k_new, v_new = kc_rows(), vc_rows()
+    o_rel = float((o_new - o_ref).norm() / o_ref.norm().clamp_min(1e-12))
+    k_rel, k_worst = _qkv_rows_err(k_new, k_ref)
+    v_rel, v_worst = _qkv_rows_err(v_new, v_ref)
+    differ_k = float(((k_new != k_ref).any(dim=1)).float().mean())
+    differ_v = float(((v_new != v_ref).any(dim=1)).float().mean())
+    finite = bool(torch.isfinite(o_new).all())
+    ok = (finite and o_rel <= QKV_OUT_REL_L2 and k_rel <= QKV_KV_REL_L2 and v_rel <= QKV_KV_REL_L2
+          and k_worst <= QKV_KV_WORST_ROW and v_worst <= QKV_KV_WORST_ROW)
+    text = (f"out rel L2 {o_rel:.2e} (<= {QKV_OUT_REL_L2:.0e}); K rel L2 {k_rel:.2e} worst row {k_worst:.2e}; "
+            f"V rel L2 {v_rel:.2e} worst row {v_worst:.2e} (<= {QKV_KV_REL_L2:.0e} / {QKV_KV_WORST_ROW:.0e}); "
+            f"differing K/V rows {differ_k:.3f}/{differ_v:.3f} (information only)")
+    return ok, text
+
+
+def _qkv_time(graphs, device):
+    """Interleaved cold-L2 graph replays (256 MiB flush write before each), QKV_ALTERNATIONS alternations,
+    the order rotated and flipped, empty-graph baseline subtracted. Returns {name: median us}."""
+    tiny = torch.zeros(16, dtype=torch.float32, device=device)
+    graphs = dict(graphs)
+    graphs["empty"] = _ssdq_graph_time(lambda: tiny.zero_(), device)
+    flush = torch.empty(256 * 2 ** 20 // 4, dtype=torch.float32, device=device)  # > the 50 MB L2
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def once(graph):
+        flush.zero_()
+        ev[0].record()
+        graph.replay()
+        ev[1].record()
+        torch.cuda.synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1000.0
+
+    names = list(graphs)
+    samples = {name: [] for name in names}
+    for name in names:
+        once(graphs[name])
+    for i in range(QKV_ALTERNATIONS):
+        order = names[i % len(names):] + names[:i % len(names)]
+        if i % 2:
+            order = order[::-1]
+        for name in order:
+            samples[name].append(once(graphs[name]))
+    med = {name: sorted(v)[len(v) // 2] for name, v in samples.items()}
+    base = med.pop("empty")
+    return {name: max(v - base, 0.0) for name, v in med.items()}
+
