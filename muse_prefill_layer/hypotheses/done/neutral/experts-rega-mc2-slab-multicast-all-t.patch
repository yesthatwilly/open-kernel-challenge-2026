+template <bool G, bool BIG>
+cudaError_t launch_mc(cudaStream_t stream, int grid, const Maps& mp, const uint8_t* wbank, const float* gs,
+                      const int* sorted_ids, const int* block_experts, const int* n_padded, int blocks_len,
+                      int num_routes, int n_tiles, int K, int n_experts, __nv_bfloat16* out, int out_ld, int* err) {
+  cudaLaunchConfig_t cfg;
+  cudaLaunchAttribute at[1];
+  mc_attrs<G, BIG>(cfg, at, stream, grid);
+  return cudaLaunchKernelEx(&cfg, rega_mc_kernel<G, BIG>, mp, wbank, gs, sorted_ids, block_experts, n_padded,
+                            blocks_len, num_routes, n_tiles, K, n_experts, out, out_ld, err);
+}
