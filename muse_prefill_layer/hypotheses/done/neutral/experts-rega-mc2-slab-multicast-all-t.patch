+
+// Per instantiation (w13 small, w2 small, w13 first-turn, w2 first-turn): flag (gated + 2 x first-turn), ok,
+// numRegs, localSizeBytes, static smem, dynamic smem, max active 2-CTA clusters at that smem, binaryVersion,
+// the occupancy query's error code.
+std::vector<int64_t> rega_mc_info() {
+  std::vector<int64_t> r;
+  mc_info_one<true, false>(r);
+  mc_info_one<false, false>(r);
+  mc_info_one<true, true>(r);
+  mc_info_one<false, true>(r);
+  return r;
+}
+
+void rega_gemm_mc(int64_t which, torch::Tensor bsrc, torch::Tensor wbank,
+             torch::Tensor gs, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+             int64_t num_routes, int64_t n_tiles, int64_t K, torch::Tensor out, int64_t grid, torch::Tensor err) {
+  TORCH_CHECK(which == 0 || which == 1, "rega_gemm_mc: which");
+  TORCH_CHECK(bsrc.is_cuda() && bsrc.is_contiguous() && bsrc.dim() == 2 && bsrc.scalar_type() == at::kBFloat16 &&
+              bsrc.size(0) > 0 && bsrc.size(1) > 0 && bsrc.size(1) == K,
+              "rega_gemm_mc: B-source scratch layout (cuda, contiguous, 2-D bf16, width K)");
+  TORCH_CHECK(wbank.is_contiguous() && gs.is_contiguous() && sorted_ids.is_contiguous() &&
+              block_experts.is_contiguous() && out.is_contiguous() && wbank.scalar_type() == at::kByte &&
+              gs.scalar_type() == at::kFloat && sorted_ids.scalar_type() == at::kInt &&
+              block_experts.scalar_type() == at::kInt && n_padded.scalar_type() == at::kInt &&
+              out.scalar_type() == at::kBFloat16 && err.scalar_type() == at::kInt && err.numel() >= 3,
+              "rega_gemm_mc: layout");
+  TORCH_CHECK(K % BK == 0 && block_experts.numel() <= MAXBLK_FT && gs.numel() <= MAXE && sorted_ids.numel() <= bsrc.size(0),
+              "rega_gemm_mc: sizes");
+  TORCH_CHECK(n_tiles > 0 && n_tiles % 2 == 0, "rega_gemm_mc: n_tiles must be even (tile pairs)");
+  TORCH_CHECK(grid >= 2 && grid % 2 == 0, "rega_gemm_mc: grid must be a positive multiple of the cluster size");
+  TORCH_CHECK(wbank.numel() == gs.numel() * n_tiles * (K / 64) * REC, "rega_gemm_mc: weight bank size");
+  TORCH_CHECK(out.size(1) == (which == 0 ? n_tiles * 64 : n_tiles * 128), "rega_gemm_mc: output width");
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const int blocks_len = static_cast<int>(block_experts.numel());
+  const bool big = blocks_len > MAXBLK;
+  EncodeTiledFn enc = get_encode();
+  TORCH_CHECK(enc != nullptr, "rega_gemm_mc: cuTensorMapEncodeTiled entry point missing");
+  Maps mp;
+  std::memset(&mp, 0, sizeof(Maps));
+  {
+    const cuuint64_t dims[2] = {static_cast<cuuint64_t>(bsrc.size(1)), static_cast<cuuint64_t>(bsrc.size(0))};
+    const cuuint64_t strides[1] = {static_cast<cuuint64_t>(bsrc.size(1)) * 2};
+    const cuuint32_t es[2] = {1, 1};
+    void* base = bsrc.data_ptr();
+    for (int b = 0; b < 4; ++b) {
+      const cuuint32_t box[2] = {64, static_cast<cuuint32_t>(16 << b)};
+      const CUresult rc = enc(&mp.m[b], CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, base, dims, strides, box, es,
+                              CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                              CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+      TORCH_CHECK(rc == CUDA_SUCCESS, "rega_gemm_mc: tensor map ", b, " rc ", static_cast<int>(rc));
+    }
+  }
+  const uint8_t* wp = reinterpret_cast<const uint8_t*>(wbank.data_ptr());
+  const float* gp = reinterpret_cast<const float*>(gs.data_ptr());
+  const int* sp = reinterpret_cast<const int*>(sorted_ids.data_ptr());
+  const int* bp = reinterpret_cast<const int*>(block_experts.data_ptr());
+  const int* np = reinterpret_cast<const int*>(n_padded.data_ptr());
+  __nv_bfloat16* op = reinterpret_cast<__nv_bfloat16*>(out.data_ptr());
+  int* ep = reinterpret_cast<int*>(err.data_ptr());
+  const int g = static_cast<int>(grid), nt = static_cast<int>(n_tiles), kk = static_cast<int>(K);
+  const int nr = static_cast<int>(num_routes), ne = static_cast<int>(gs.numel()), ol = static_cast<int>(out.size(1));
+  cudaError_t le;
+  if (which == 0) {
+    le = big ? launch_mc<true, true>(stream, g, mp, wp, gp, sp, bp, np, blocks_len, nr, nt, kk, ne, op, ol, ep)
+             : launch_mc<true, false>(stream, g, mp, wp, gp, sp, bp, np, blocks_len, nr, nt, kk, ne, op, ol, ep);
+  } else {
+    le = big ? launch_mc<false, true>(stream, g, mp, wp, gp, sp, bp, np, blocks_len, nr, nt, kk, ne, op, ol, ep)
+             : launch_mc<false, false>(stream, g, mp, wp, gp, sp, bp, np, blocks_len, nr, nt, kk, ne, op, ol, ep);
+  }
+  TORCH_CHECK(le == cudaSuccess, "rega_gemm_mc: cudaLaunchKernelEx ", cudaGetErrorString(le));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
