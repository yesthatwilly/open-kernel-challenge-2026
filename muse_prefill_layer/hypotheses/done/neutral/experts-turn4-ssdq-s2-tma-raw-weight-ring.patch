+_SSDQ2_HOST = r"""
+// regs, local bytes, static smem, dynamic smem, CTAs per SM, cudaFuncSetAttribute rc, binaryVersion,
+// ptxVersion, attribute calls ok. ssdq2 gets its OWN opt-in to SMEM2 (master's ssdq_info sets SMEM_BYTES).
+std::vector<int64_t> ssdq2_info() {
+  std::vector<int64_t> r;
+  const void* fn = reinterpret_cast<const void*>(ssdq2_kernel);
+  const cudaError_t e1 = cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM2);
+  cudaFuncAttributes a{};
+  const cudaError_t e2 = cudaFuncGetAttributes(&a, fn);
+  int occ = 0;
+  const cudaError_t e3 = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, ssdq2_kernel, THREADS, SMEM2);
+  const bool ok = e1 == cudaSuccess && e2 == cudaSuccess && e3 == cudaSuccess;
+  if (!ok) (void)cudaGetLastError();
+  r.push_back(a.numRegs);
+  r.push_back(static_cast<int64_t>(a.localSizeBytes));
+  r.push_back(static_cast<int64_t>(a.sharedSizeBytes));
+  r.push_back(SMEM2);
+  r.push_back(occ);
+  r.push_back(static_cast<int64_t>(e1));
+  r.push_back(a.binaryVersion);
+  r.push_back(a.ptxVersion);
+  r.push_back(ok ? 1 : 0);
+  return r;
+}
+
+// As ssdq_gemm, plus the weight code map: the weight tensor w (uint8 [E][N][K/2]) viewed as [E*N, K/2],
+// box {64 B, 256 rows}, encoded HERE on every call from the w passed in (never cached: the judge's two
+// states hold different tensors). Returns 0, 1 (no encode entry point), 1000 + CUresult (a map encode
+// failed), 2000 (the weight base is not 16 B aligned or its row stride is not a multiple of 16).
+int64_t ssdq2_gemm(int64_t mode, torch::Tensor a, torch::Tensor w, torch::Tensor sf, torch::Tensor gs,
+                   torch::Tensor sorted_ids, torch::Tensor block_experts, int64_t num_routes, torch::Tensor out,
+                   torch::Tensor err, torch::Tensor prof, int64_t use_prof, int64_t fence_variant) {
+  TORCH_CHECK(mode == 0 || mode == 1, "ssdq2_gemm: mode");
+  TORCH_CHECK(a.is_cuda() && a.is_contiguous() && w.is_contiguous() && sf.is_contiguous() && gs.is_contiguous() &&
+              sorted_ids.is_contiguous() && block_experts.is_contiguous() && out.is_contiguous(), "ssdq2_gemm: contiguous");
+  TORCH_CHECK(a.scalar_type() == at::kBFloat16 && out.scalar_type() == at::kBFloat16 && w.scalar_type() == at::kByte &&
+              sf.scalar_type() == at::kFloat8_e4m3fn && gs.scalar_type() == at::kFloat &&
+              sorted_ids.scalar_type() == at::kInt && block_experts.scalar_type() == at::kInt &&
+              err.scalar_type() == at::kInt && prof.scalar_type() == at::kLong && prof.numel() >= 10, "ssdq2_gemm: dtypes");
+  const int64_t E = w.size(0), N = w.size(1), K = w.size(2) * 2;
+  TORCH_CHECK(N % BN == 0 && K % 128 == 0 && a.size(1) == K && sf.size(2) * 16 == K && out.size(1) == N &&
+              gs.numel() == E && sf.size(0) == E && sf.size(1) == N, "ssdq2_gemm: shapes");
+  const int64_t nb = block_experts.numel();
+  TORCH_CHECK(a.size(0) == nb * BM && sorted_ids.numel() <= a.size(0), "ssdq2_gemm: rows");
+  TORCH_CHECK(mode == 0 ? out.size(0) == a.size(0) : out.size(0) == num_routes, "ssdq2_gemm: out rows");
+  if (nb == 0) return 0;
+  EncodeTiledFn enc = get_encode();
+  if (enc == nullptr) return 1;
+  if ((reinterpret_cast<uintptr_t>(w.data_ptr()) & 15u) != 0 || ((K / 2) % 16) != 0) return 2000;
+  Maps2 maps;
+  const cuuint64_t dims[2] = {static_cast<cuuint64_t>(K), static_cast<cuuint64_t>(a.size(0))};
+  const cuuint64_t strides[1] = {static_cast<cuuint64_t>(K) * 2};
+  const cuuint32_t box[2] = {64, static_cast<cuuint32_t>(BM)};
+  const cuuint32_t es[2] = {1, 1};
+  CUresult rc = enc(&maps.a, CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, a.data_ptr(), dims, strides, box, es,
+                    CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                    CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+  if (rc != CUDA_SUCCESS) return 1000 + static_cast<int64_t>(rc);
+  const cuuint64_t wdims[2] = {static_cast<cuuint64_t>(K / 2), static_cast<cuuint64_t>(E * N)};
+  const cuuint64_t wstrides[1] = {static_cast<cuuint64_t>(K / 2)};
+  const cuuint32_t wbox[2] = {64, static_cast<cuuint32_t>(BN)};
+  rc = enc(&maps.w, CU_TENSOR_MAP_DATA_TYPE_UINT8, 2, w.data_ptr(), wdims, wstrides, wbox, es,
