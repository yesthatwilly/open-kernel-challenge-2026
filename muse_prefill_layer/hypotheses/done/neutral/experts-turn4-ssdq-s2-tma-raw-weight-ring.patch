+// ------------------------------- ssdq2 (stage 2) -------------------------------
+constexpr int STAGES2 = 3;                    // bf16 stages (master's ssdq_kernel keeps STAGES = 4)
+constexpr int RAW_STAGES = 4;                 // raw weight ring entries, one 128-k chunk of 256 rows each
+constexpr int RAW_CODE_BYTES = BN * 64;       // 16384: 256 rows x 64 B packed codes (one TMA)
+constexpr int RAW_SF_BYTES = BN * 8;          // 2048: 256 rows x 8 e4m3 scales (cp.async, 8 B per row)
+constexpr int RAW_BYTES = RAW_CODE_BYTES + RAW_SF_BYTES;   // 18432
+constexpr int SMEM2 = 1024 + STAGES2 * STAGE_BYTES + RAW_STAGES * RAW_BYTES;   // 222208
+static_assert(SMEM2 == 222208, "SMEM2");
+static_assert(RAW_BYTES % 1024 == 0 && (STAGES2 * STAGE_BYTES) % 1024 == 0, "ring alignment");
+static_assert(SMEM2 + (2 * STAGES2 + RAW_STAGES) * 8 + 4096 <= 227 * 1024, "shared memory budget (ssdq2)");
+
+struct __align__(64) Maps2 { CUtensorMap a; CUtensorMap w; };
+
+__device__ __forceinline__ void cp_async8(uint32_t dst, const void* src) {
+  asm volatile("cp.async.ca.shared.global [%0], [%1], 8;\n" :: "r"(dst), "l"(src) : "memory");
+}
+// Arrive on the mbarrier when this thread's earlier cp.asyncs have landed; .noinc: the barrier's init
+// count already includes this arrive (no pending-count increment).
+__device__ __forceinline__ void cp_async_mbar_arrive_noinc(uint32_t bar) {
+  asm volatile("cp.async.mbarrier.arrive.noinc.shared.b64 [%0];\n" :: "r"(bar) : "memory");
+}
+__device__ __forceinline__ void producer_bar_sync() {   // the 128 producer threads only (named barrier 1)
+  asm volatile("bar.sync 1, 128;\n" ::: "memory");
+}
+
+// Fill raw ring entry c % RAW_STAGES with chunk c: thread 0 issues the code TMA (expect_tx 16384), every
+// producer thread copies 2 rows of scales and arrives (noinc) when they land. raw_full init count 1 + 128.
+__device__ __forceinline__ void raw_issue(int c, int p, uint32_t rawb, uint32_t rawfull0, uint64_t wmap, int wrow0,
+                                          const uint8_t* sbase, int K) {
+  const int r = c % RAW_STAGES;
+  const uint32_t ent = rawb + r * RAW_BYTES;
+  const uint32_t bar = rawfull0 + 8 * r;
+  if (p == 0) {
+    mbar_expect_tx(bar, RAW_CODE_BYTES);
+    tma_2d(ent, wmap, c * 64, wrow0, bar);
+  }
+#pragma unroll
+  for (int j = 0; j < 2; ++j) {
+    const int row = p + 128 * j;
+    cp_async8(ent + RAW_CODE_BYTES + row * 8, sbase + static_cast<size_t>(row) * (K / 16) + c * 8);
+  }
+  cp_async_mbar_arrive_noinc(bar);
