+def _e2m1x4_dequant_bf16(b, s_lo, s_hi):
+    """Packed form of the scalar dequant below: uint8 code bytes b and bf16 scales s_lo, s_hi (same
+    shape) -> (bf16 low-nibble value * s_lo, bf16 high-nibble value * s_hi), the same bit placement
+    (E2M1 * 2^-126, e = 0 codes on bf16 subnormals) and the same exact product. pack=4: $4 holds 4
+    code bytes (element j = byte j); each bf16 operand or result is two bf16x2 registers (element
+    2r + h in half h of register r). prmt spreads bytes (0, 1) and (2, 3) into the low byte of each
+    16-bit half; shifts and masks place each nibble's bits; fma with a -0.0 addend is the multiply."""
+    return tl.inline_asm_elementwise(
+        asm="""
+        {
+        .reg .b32 t0, t1, x, y, nz;
+        mov.b32 nz, 0x80008000;
+        prmt.b32 t0, $4, 0, 0x4140;
+        prmt.b32 t1, $4, 0, 0x4342;
+        shl.b32 x, t0, 6;
+        and.b32 x, x, 0x01C001C0;
+        shl.b32 y, t0, 12;
+        and.b32 y, y, 0x80008000;
+        or.b32 x, x, y;
+        fma.rn.bf16x2 $0, x, $5, nz;
+        shl.b32 x, t1, 6;
+        and.b32 x, x, 0x01C001C0;
+        shl.b32 y, t1, 12;
+        and.b32 y, y, 0x80008000;
+        or.b32 x, x, y;
+        fma.rn.bf16x2 $1, x, $6, nz;
+        shl.b32 x, t0, 2;
+        and.b32 x, x, 0x01C001C0;
+        shl.b32 y, t0, 8;
+        and.b32 y, y, 0x80008000;
+        or.b32 x, x, y;
+        fma.rn.bf16x2 $2, x, $7, nz;
+        shl.b32 x, t1, 2;
+        and.b32 x, x, 0x01C001C0;
+        shl.b32 y, t1, 8;
+        and.b32 y, y, 0x80008000;
+        or.b32 x, x, y;
+        fma.rn.bf16x2 $3, x, $8, nz;
+        }
+        """,
