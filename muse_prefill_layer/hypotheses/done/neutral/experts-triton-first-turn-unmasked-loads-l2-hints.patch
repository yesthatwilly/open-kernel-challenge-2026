+        state["loads_w13"] = state["loads_w2"] = LOADS_MASTER
+    print(f"{LOADS_TAG} PATH CHOSEN = w13 {LOADS_NAMES[state['loads_w13']]}, w2 {LOADS_NAMES[state['loads_w2']]} "
+          f"(gate: <= {LOADS_GATE_RATIO:g}x master)", flush=True)
