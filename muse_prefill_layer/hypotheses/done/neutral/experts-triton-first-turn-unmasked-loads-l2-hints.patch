+def _loads_ab(state, device):
+    """Untimed, prepare() only (hypothesis experts-triton-first-turn-unmasked-loads-l2-hints). On
+    synthetic T = 16384 data (random bf16 rows, random distinct top-8 experts of 256 mapped to this
+    GPU's 32, the first-turn BLOCK_T 256 config and the real align) times each GEMM (w13, w2) as a CUDA
+    graph replay of the three load variants (master / unmasked / unmasked+hints), interleaved over
+    LOADS_AB_ALTERNATIONS alternations with the L2 flushed before every timed replay. A variant is
+    chosen for a GEMM only when its median is <= LOADS_GATE_RATIO x master's; otherwise master's loads
+    stay. Sets state["loads_w13"] and state["loads_w2"]. Any failure keeps master's loads."""
+    state["loads_w13"] = state["loads_w2"] = LOADS_MASTER
+    chosen = {}
+    try:
+        bank = state["bank"]
+        gen = torch.Generator(device=device)
+        gen.manual_seed(1)
+        t = LOADS_AB_TOKENS
+        cfg = _expert_config(t)
+        assert cfg is EXPERT_CONFIGS[-1][1]
+        x = torch.randn((t, D_EXPERT), generator=gen, device=device, dtype=torch.float32).to(torch.bfloat16)
+        ids = torch.rand((t, N_EXPERTS), generator=gen, device=device).topk(TOP_K, dim=1).indices.to(torch.int32)
+        local_ids = torch.where(ids < LOCAL_EXPERTS, ids, torch.full_like(ids, -1)).contiguous()
+        del ids
+        sorted_ids, block_experts, n_padded = moe_align_block_size(local_ids, cfg["BLOCK_T"], LOCAL_EXPERTS)
+        num_slots = t * TOP_K
+        gemm1_n = bank["w13"].shape[1]
+        size_n = gemm1_n // 2
+        cache2 = torch.randn((num_slots, size_n), generator=gen, device=device, dtype=torch.float32).to(torch.bfloat16)
+        cache1 = torch.empty((num_slots, gemm1_n), device=device, dtype=torch.bfloat16)
+        cache3 = torch.empty((num_slots, D_EXPERT), device=device, dtype=torch.bfloat16)
+        flush = torch.empty(LOADS_AB_FLUSH_BYTES // 2, dtype=torch.bfloat16, device=device)
+        gemms = {
+            "w13": (x.contiguous(), bank["w13"], bank["w13_sf"], bank["w13_gs"], cache1, TOP_K, False),
+            "w2": (cache2, bank["w2"], bank["w2_sf"], bank["w2_gs"], cache3, 1, state["zero_nonlocal_w2"]),
+        }
+        variants = (LOADS_MASTER, LOADS_UNMASKED, LOADS_UNMASKED_HINTS)
+        for name, (a, w, sf, gs, out, top_k, zero_nonlocal) in gemms.items():
+            graphs, infos = {}, {}
+            for v in variants:
+                infos[v] = {}
+
+                def launch(v=v):
+                    _nvfp4_moe_gemm(a, w, sf, gs, out, sorted_ids, block_experts, n_padded, top_k, num_slots, cfg,
+                                    zero_nonlocal, loads=v, info=infos[v])
+
+                launch()  # compiled already by the check; this warms the launch path
+                torch.cuda.synchronize()
+                g = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(g):
+                    launch()
+                graphs[v] = g
+            times = {v: [] for v in variants}
+            for rep in range(LOADS_AB_ALTERNATIONS + 1):  # replay 0 is a warmup, dropped
+                order = variants[rep % 3:] + variants[:rep % 3]  # rotate so no variant always goes first
+                for v in order:
+                    flush.zero_()
+                    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                    start.record()
+                    graphs[v].replay()
+                    end.record()
+                    torch.cuda.synchronize()
+                    if rep > 0:
+                        times[v].append(start.elapsed_time(end) * 1e3)
+            med = {v: sorted(times[v])[len(times[v]) // 2] for v in variants}
+            best = min(variants, key=lambda v: med[v])
+            ratio = med[best] / med[LOADS_MASTER]
+            pick = best if (best != LOADS_MASTER and ratio <= LOADS_GATE_RATIO) else LOADS_MASTER
+            chosen[name] = pick
+            state["loads_" + name] = pick
+            for v in variants:
+                print(f"{LOADS_TAG} {name} T={t} {LOADS_NAMES[v]}: median {med[v]:.0f} us over {len(times[v])} "
+                      f"alternations, ratio {med[v] / med[LOADS_MASTER]:.4f}, n_regs={infos[v].get('n_regs')} "
+                      f"n_spills={infos[v].get('n_spills')}", flush=True)
+            del graphs
+        del x, cache1, cache2, cache3, flush
+    except Exception as e:
