+REGA_FINE_EXT_NAME = "muse_prefill_rega_fine"
+REGA_FINE_FUNCS = ("rega_init_fine", "rega_gemm_fine")
+REGA_FINE_NB = tuple(16 * (b + 1) for b in range(8))   # wgmma N of bucket b
+REGA_FINE_MODE = 1                         # the `fine` int kernel_fn passes: N = 16 * nbk (0 = master's mapping)
+REGA_FINE_CLASSES = ("low", "high", "ft")  # gate order; ft (expected flat, the costliest) last
+REGA_FINE_STATE_KEYS = REGA_STATE_KEYS + ("rega_fine_ext", "rega_fine_ok")
+REGA_FINE_START_DEADLINE_S = 200.0         # no nvcc build once prepare() has used this many seconds (300 s hard limit)
+REGA_FINE_CLASS_DEADLINE_S = {"low": 248.0, "high": 248.0, "ft": 236.0}   # no class starts after this
+REGA_FINE_TIMING_DEADLINE_S = {"low": 258.0, "high": 258.0, "ft": 248.0}  # no timing routing starts after this
+REGA_FINE_REPLAY_DEADLINE_S = {"low": 272.0, "high": 270.0, "ft": 260.0}  # no replay check (so no ON) after this
