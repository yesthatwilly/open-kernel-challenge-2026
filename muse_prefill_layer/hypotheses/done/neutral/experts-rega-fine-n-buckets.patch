+    ("body", "decode_item(it, n_tiles, be, s_cblk, s_cnb, s_gfirst, s_gcount)",
+     "decode_item(it, n_tiles, be, s_cblk, s_cnb, s_gfirst, s_gcount, fine)", 2),
+    ("body", "        const uint32_t tx = WST + 2 * (16 << m.bucket) * 128;\n",
+     "        const uint32_t tx = WST + 2 * (16 * (m.bucket + 1)) * 128;  // two boxes of 16 * (b + 1) rows x 128 B\n", 1),
+    ("body", _REGA_FINE_SWITCH_OLD, _REGA_FINE_SWITCH_NEW, 1),
+    ("body", "  const void* fn = reinterpret_cast<const void*>(rega_kernel<G, BIG>);\n",
+     "  const void* fn = reinterpret_cast<const void*>(rega_kernel_fine<G, BIG>);\n", 1),
+    ("body", "std::vector<int64_t> rega_init() {\n", "std::vector<int64_t> rega_init_fine() {\n", 1),
+    ("body", "void rega_gather(torch::Tensor x,", "void rega_gather_fine(torch::Tensor x,", 1),
+    ("body", "rega_gather_kernel", "rega_gather_fine_kernel", 2),
+    ("body", "void rega_gemm(int64_t which, torch::Tensor bsrc, torch::Tensor wbank,",
