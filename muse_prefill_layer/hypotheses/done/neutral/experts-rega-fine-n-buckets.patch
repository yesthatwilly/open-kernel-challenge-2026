+    ("body", "  rega_kernel<G_, B_><<<", "  rega_kernel_fine<G_, B_><<<", 1),
+    ("body", "reinterpret_cast<int*>(err.data_ptr()))\n",
+     "reinterpret_cast<int*>(err.data_ptr()), static_cast<int>(fine))\n", 1),
