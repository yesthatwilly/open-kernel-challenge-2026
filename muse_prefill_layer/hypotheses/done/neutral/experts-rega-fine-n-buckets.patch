+def _rega_fine_tables(x, lids, state):
+    """prepare() only: the align kernel_fn runs (_align_dispatch) and master's gather: ((sorted_ids, block_experts,
+    n_padded, num_slots), xs)."""
+    num_slots = x.shape[0] * TOP_K
+    _, (sorted_ids, block_experts, n_padded) = _align_dispatch(lids, REGA_BSM, state)
+    rows = block_experts.shape[0] * REGA_BSM
+    xs = torch.empty((rows, D_EXPERT), device=x.device, dtype=torch.bfloat16)
+    state["rega_ext"].rega_gather(x.contiguous(), sorted_ids, block_experts, n_padded, num_slots, LOCAL_EXPERTS, xs)
+    return (sorted_ids, block_experts, n_padded, num_slots), xs
+
+
+def _rega_fine_gemm(state, mode, which, src, dst, tabs):
+    """One rega GEMM launch over prepared tables with the arguments _experts_rega passes: master's rega_gemm (mode
+    None) or the fine module's with `fine` = mode (1: N = 16 * nbk, 0: master's mapping). w13 (which 0): xs -> hs;
+    w2 (which 1): hs -> y."""
+    bank, err, grid = state["rega_bank"], state["rega_err"], state["rega_grid"]
+    sorted_ids, block_experts, n_padded, num_slots = tabs
+    if which == 0:
+        args = (src, bank["q13"], bank["gs13"], sorted_ids, block_experts, n_padded, num_slots, D_EXPERT // 64,
+                D_EXPERT, dst)
+    else:
+        args = (src, bank["q2"], bank["gs2"], sorted_ids, block_experts, n_padded, num_slots, D_EXPERT // 128,
+                D_EXPERT, dst)
+    if mode is None:
+        state["rega_ext"].rega_gemm(which, *args, grid, err)
+    else:
+        state["rega_fine_ext"].rega_gemm_fine(which, *args, grid, err, int(mode))
+
+
+def _rega_fine_chunks(tabs):
+    """prepare() only: the kernel's chunk cut on these align tables (a chunk starts every 8 blocks of 16 rows into a
+    local expert's run): (nbk of every chunk, nbk of each used block's chunk)."""
+    _, block_experts, n_padded, _ = tabs
+    used = min(int(n_padded.cpu()[0]) // REGA_BSM, block_experts.numel())
+    be = block_experts[:used].cpu().tolist()
+    nbks, blk = [], [0] * used
+    b = 0
+    while b < used:
+        e, r = be[b], b + 1
+        while r < used and be[r] == e:
+            r += 1
+        if 0 <= e < LOCAL_EXPERTS:
+            for c0 in range(b, r, 8):
+                n = min(8, r - c0)
+                nbks.append(n)
+                blk[c0:c0 + n] = [n] * n
+        b = r
+    return nbks, blk
+
+
+def _rega_fine_hist(nbks):
+    """'1:a 2:b .. 8:h': chunks by nbk (16-route blocks per chunk)."""
+    return " ".join(f"{n}:{nbks.count(n)}" for n in range(1, 9))
+
+
+def _rega_fine_routes(lids):
+    """prepare() only: (local routes, mean routes per touched local expert, max routes of one expert)."""
+    routes = torch.bincount(lids[lids >= 0].long(), minlength=LOCAL_EXPERTS)[:LOCAL_EXPERTS].cpu()
+    touched = routes[routes > 0]
+    return int(routes.sum()), float(touched.float().mean()) if touched.numel() else 0.0, int(routes.max())
+
+
+def _rega_fine_first_diff(a, b, sorted_ids, blk, route_rows):
+    """prepare() only: (max |a - b| (NaN counts as inf), first mismatching row or -1, nbk of that row's chunk or 0).
+    route_rows: a's rows are route slots (y; mapped to the sorted slot through sorted_ids), else sorted slots (hs)."""
+    d = torch.nan_to_num((a.float() - b.float()).abs(), nan=float("inf"))
+    rows = (a != b).any(dim=1).nonzero().flatten()
+    mx = float(d.max()) if d.numel() else 0.0
+    if rows.numel() == 0:
+        return mx, -1, 0
+    r = int(rows[0])
+    slot = r
+    if route_rows:
+        pos = (sorted_ids == r).nonzero().flatten()
+        slot = int(pos[0]) if pos.numel() else -1
+    bi = slot // REGA_BSM if slot >= 0 else -1
+    return mx, r, blk[bi] if 0 <= bi < len(blk) else 0
+
+
+def _rega_fine_med(v):
+    s = sorted(v)
+    return s[len(s) // 2]
+
+
+def _rega_fine_time(state, device, tokens, kind, gen):
+    """prepare() only: interleaved cold-L2 CUDA-graph replays at one T and routing of the three pairs (w13 then w2,
+    one graph each: master's rega_gemm, the fine module with master's mapping (f4), the fine module (f)) and of each
+    kernel alone (w2 alone reads the real hs master's w13 wrote). REGA_FINE_ROUNDS rounds x REGA_FINE_ALTERNATIONS
+    alternations, order rotated and flipped, a 256 MB flush before every replay, an empty-graph baseline subtracted
+    per round (and over the pooled samples). Returns (per-round {name: us}, pooled {name: us}, local routes, nbk
+    histogram)."""
+    x, tw, lids = _rega_case(tokens, kind, gen, device)
+    err = state["rega_err"]
+    tabs, xs = _rega_fine_tables(x, lids, state)
+    hist = _rega_fine_hist(_rega_fine_chunks(tabs)[0])
+    hs_r = torch.zeros((xs.shape[0], D_EXPERT), device=device, dtype=torch.bfloat16)
+    hs_w = torch.zeros_like(hs_r)
+    y = torch.zeros((tabs[3], D_EXPERT), device=device, dtype=torch.bfloat16)
+    err.zero_()
+    _rega_fine_gemm(state, None, 0, xs, hs_r, tabs)  # the real hs for the w2-alone graphs
+    torch.cuda.synchronize()
+
+    def pair(mode):
+        _rega_fine_gemm(state, mode, 0, xs, hs_w, tabs)
+        _rega_fine_gemm(state, mode, 1, hs_w, y, tabs)
+
+    fns = {}
+    for lab, mode in REGA_FINE_VARIANTS:
+        fns[f"pair:{lab}"] = lambda mode=mode: pair(mode)
+        fns[f"w13:{lab}"] = lambda mode=mode: _rega_fine_gemm(state, mode, 0, xs, hs_w, tabs)
+        fns[f"w2:{lab}"] = lambda mode=mode: _rega_fine_gemm(state, mode, 1, hs_r, y, tabs)
+    graphs, flush = {}, None
+    try:
+        graphs = {name: _ssdq_graph_time(fn, device) for name, fn in fns.items()}
+        tiny = torch.zeros(16, dtype=torch.float32, device=device)
+        graphs["empty"] = _ssdq_graph_time(lambda: tiny.zero_(), device)
+        flush = torch.empty(256 * 2 ** 20 // 4, dtype=torch.float32, device=device)  # > the 50 MB L2
+        ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+        def once(name):
+            flush.zero_()
+            ev[0].record()
+            graphs[name].replay()
+            ev[1].record()
+            torch.cuda.synchronize()
+            return ev[0].elapsed_time(ev[1]) * 1000.0
+
+        names = list(graphs)
+        for name in names:
+            once(name)  # warm-up replay
+        rounds, pooled = [], {name: [] for name in names}
+        for r in range(REGA_FINE_ROUNDS):
+            samples = {name: [] for name in names}
+            for i in range(REGA_FINE_ALTERNATIONS):
+                k = (i + r) % len(names)
+                order = names[k:] + names[:k]
+                if i % 2:
+                    order = order[::-1]
+                for name in order:
+                    samples[name].append(once(name))
+            base = _rega_fine_med(samples["empty"])
+            rounds.append({n: max(_rega_fine_med(v) - base, 0.0) for n, v in samples.items() if n != "empty"})
+            for n, v in samples.items():
+                pooled[n].extend(v)
+        base = _rega_fine_med(pooled["empty"])
+        pooled = {n: max(_rega_fine_med(v) - base, 0.0) for n, v in pooled.items() if n != "empty"}
+        word = _rega_marks(err)[0]
+        if word != 0:
+            raise RuntimeError(f"timing replays left error word {word} ({REGA_ERR_TEXT.get(word, '?')})")
+        return rounds, pooled, int((lids >= 0).sum()), hist
+    finally:
+        del graphs, flush, fns, xs, hs_r, hs_w, y
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+
+
+def _rega_fine_exact(state, cls, tokens, real, gen, device, weights, cache, trial, tag):
+    """prepare() only, one routing: one align + gather, then master's w13 / w2, the fine module's w13 / w2 (f) and
+    with master's mapping (f4) into zeroed buffers (each w2 fed master's hs). Error word 0 and both launch markers
+    for every launch; fine's hs and y must be bit-identical to master's, else max |diff| and the first mismatching
+    (class, routing, nbk) are printed and the whole block with fine ON (trial) is held to master's fp32-reference
+    calibrated bound (max(2 x the incumbent's own error, 8e-3), worst row 5x). Returns (None or why, exact, f4
+    exact, note, (nbk histogram, chunks, route stats))."""
+    err = state["rega_err"]
+    x, tw, lids = _rega_case(tokens, real, gen, device)
+    tabs, xs = _rega_fine_tables(x, lids, state)
+    nbks, blk = _rega_fine_chunks(tabs)
+    stats = (_rega_fine_hist(nbks), len(nbks), _rega_fine_routes(lids))
+    out, words = {}, {}
+    for lab, mode in REGA_FINE_VARIANTS:
+        hs = torch.zeros((xs.shape[0], D_EXPERT), device=device, dtype=torch.bfloat16)
+        y = torch.zeros((tabs[3], D_EXPERT), device=device, dtype=torch.bfloat16)
+        err.zero_()
+        _rega_fine_gemm(state, mode, 0, xs, hs, tabs)
+        _rega_fine_gemm(state, mode, 1, out["m"][0] if lab != "m" else hs, y, tabs)
+        torch.cuda.synchronize()
+        word, m13, m2 = _rega_marks(err)
+        words[lab] = (word, _rega_launched(m13, m2))
+        out[lab] = (hs, y)
+    if not all(w == 0 and launched for w, launched in words.values()):
+        return f"exact step {real}: (error word, both markers) per variant {words}", False, False, "", stats
+    exact = bool(torch.equal(out["m"][0], out["f"][0])) and bool(torch.equal(out["m"][1], out["f"][1]))
+    f4 = bool(torch.equal(out["m"][0], out["f4"][0])) and bool(torch.equal(out["m"][1], out["f4"][1]))
+    note = ""
+    if not exact:
+        mh, rh, nh = _rega_fine_first_diff(out["m"][0], out["f"][0], tabs[0], blk, False)
+        my, ry, ny = _rega_fine_first_diff(out["m"][1], out["f"][1], tabs[0], blk, True)
+        where = f"hs row {rh}" if rh >= 0 else f"y row {ry}"
+        note = f"first mismatch ({cls}, {real}, nbk {nh if rh >= 0 else ny}) {where}; max|diff| hs {mh:.3e} y {my:.3e}"
+        print(f"{tag} exact MISS: {note}; fallback: master's fp32-reference calibrated bound", flush=True)
+        del out
+        inc_name, inc_fn = _rega_incumbent(tokens)
+        ref = _rega_reference_out(x, tw, lids, state, weights, cache)
+        err.zero_()
+        new = _experts_rega(x, tw, lids, trial)
+        torch.cuda.synchronize()
+        word, m13, m2 = _rega_marks(err)
+        inc = inc_fn(x, tw, lids, state)
+        torch.cuda.synchronize()
+        e_new, w_new = _ssdq_metrics(new, ref)
+        e_inc, _ = _ssdq_metrics(inc, ref)
+        bound = max(2.0 * e_inc, 8e-3)
+        ok = word == 0 and _rega_launched(m13, m2) and e_new <= bound and w_new <= 5.0 * bound
+        note += (f"; bound: rel L2 {e_new:.2e} row {w_new:.2e} vs {bound:.2e} ({inc_name} {e_inc:.2e}), word {word}: "
+                 f"{'ok' if ok else 'MISS'}")
+        print(f"{tag} exact fallback {real}: {note}", flush=True)
+        if not ok:
+            return f"exact compare and the fp32-reference bound both missed: {note}", False, f4, note, stats
+    return None, exact, f4, note, stats
+
+
+def _rega_fine_class(state, device, cls, weights, lines, t_start):
+    """prepare() only: one class's checks and gate; (on, reason). 1. an eager traced canary of the whole
+    _experts_rega call with fine ON for this class (the norm-gather form kernel_fn uses); 2. the exact compare per
+    routing (_rega_fine_exact); 3. the three-pair timing (_rega_fine_time) on the pop and random routings; 4. when
+    the timing passes, the two-state replay check with fine ON for this class. ON needs every step."""
+    tokens = REGA_GATE_TOKENS.get(cls, REGA_FT_GATE_TOKENS)
+    tag = f"{REGA_FINE_TAG} {cls} T={tokens}"
+    err = state["rega_err"]
+    n_rnd, counts = _rega_pop_counts(tokens, device)
+    alpha, cnt = _rega_pop_pick(counts, REGA_FINE_POP_MULT * n_rnd)
+    pop_kind = f"pop:{alpha:g}"
+    print(f"{tag} pop routing: alpha {alpha:g} -> {cnt:.0f} local routes = {cnt / max(n_rnd, 1.0):.2f}x uniform "
+          f"{n_rnd:.0f}", flush=True)
+    trial = dict(state)
+    trial["rega_fine_ok"] = {c: c == cls for c in REGA_FINE_CLASSES}
+    # 1. canary
+    prenorm = bool(state.get("norm_gather_ok", {}).get(cls, False))
+    gen = torch.Generator(device=device).manual_seed(20261102)
+    x0, tw0, l0 = _rega_case(tokens, "random", gen, device)
+    err.zero_()
+    out = _experts_rega(x0, tw0, l0, trial, tracer=_RegaTracer(f"fine canary {cls}"), prenorm=prenorm)
+    torch.cuda.synchronize()
+    word, m13, m2 = _rega_marks(err)
+    finite = bool(torch.isfinite(out.float()).all())
+    print(f"{tag} canary: error word {word} ({REGA_ERR_TEXT.get(word, '?')}), markers {m13:#x}/{m2:#x}, finite "
+          f"{finite}", flush=True)
+    del out, x0, tw0, l0
+    if word != 0 or not _rega_launched(m13, m2) or not finite:
+        return False, f"canary failed (error word {word}, markers {m13:#x}/{m2:#x}, finite {finite})"
+    # 2. exact compare against master's rega_gemm (fp32-reference bound as the fallback)
+    cache, exact_all, f4_all, notes, stats = {}, True, True, [], {}
+    try:
+        for kind in REGA_FINE_EXACT_KINDS:
+            real = pop_kind if kind == "pop" else kind
+            why, exact, f4, note, stats[real] = _rega_fine_exact(state, cls, tokens, real, gen, device, weights, cache,
+                                                                 trial, tag)
+            exact_all, f4_all = exact_all and exact, f4_all and f4
+            if note:
+                notes.append(f"{real}: {note}")
+            if why:
+                return False, why
+    finally:
+        cache.clear()
+        torch.cuda.empty_cache()
+    print(f"{tag} nbk chunks " + "; ".join(f"{k} {h} ({n} chunks; {r} routes, {m:.0f}/expert mean, max {mx})"
+                                           for k, (h, n, (r, m, mx)) in stats.items()), flush=True)
+    h, n, (r, m, mx) = stats[pop_kind]
+    lines.append(f"{tag} nbk {pop_kind} {h} ({n} chunks; {r} routes, {m:.0f}/expert mean, max {mx})")
+    lines.append(f"{tag} exact fine==master hs,y ({'/'.join(stats)}): {'yes' if exact_all else 'NO, fp32 bound ok'}; "
+                 f"f4==master {'yes' if f4_all else 'NO (control suspect)'}" + (f"; {'; '.join(notes)}" if notes else ""))
+    print(lines[-1], flush=True)
+    # 3. timing: the three pairs, pop then random
+    res = {}
+    for rt in ("pop", "random"):
+        used = time.perf_counter() - t_start
+        if used > REGA_FINE_TIMING_DEADLINE_S[cls]:
+            return False, f"SKIPPED: {rt} timing not started (prepare {used:.0f}s > {REGA_FINE_TIMING_DEADLINE_S[cls]:.0f}s)"
+        real = pop_kind if rt == "pop" else "random"
+        rounds, pooled, local, hist = _rega_fine_time(state, device, tokens, real, gen)
+        res[rt] = (rounds, pooled)
+
+        def trip(d, k):
+            return "/".join(f"{d[f'{k}:{lab}']:.1f}" for lab, _ in REGA_FINE_VARIANTS)
+
+        pp = pooled
+        lines.append(f"{tag} KERNELS {real} {local}r nbk {hist}; us m/f4/f: pair "
+                     + " ".join(f"r{i + 1} {trip(rd, 'pair')}" for i, rd in enumerate(rounds))
+                     + f" pooled {trip(pp, 'pair')} (f4/m {pp['pair:f4'] / max(pp['pair:m'], 1e-9):.3f} f/f4 "
+                       f"{pp['pair:f'] / max(pp['pair:f4'], 1e-9):.3f} f/m {pp['pair:f'] / max(pp['pair:m'], 1e-9):.3f})"
+                     + f"; w13 {trip(pp, 'w13')}; w2 {trip(pp, 'w2')}")
+        print(lines[-1], flush=True)
+    pop_r = [rd["pair:f"] / max(rd["pair:m"], 1e-9) for rd in res["pop"][0]]
+    rnd_r = res["random"][1]["pair:f"] / max(res["random"][1]["pair:m"], 1e-9)
+    timing_on = all(x <= REGA_FINE_POP_RATIO for x in pop_r) and rnd_r <= REGA_FINE_RANDOM_RATIO
+    low_v = f"; rega_low_variant {int(state.get('rega_low_variant', 0))}" if cls == "low" else ""
+    lines.append(f"{tag} GATE f/m pair: pop {'/'.join(f'{x:.3f}' for x in pop_r)} (<= {REGA_FINE_POP_RATIO} both), "
+                 f"random pooled {rnd_r:.3f} (<= {REGA_FINE_RANDOM_RATIO}): {'pass' if timing_on else 'MISS'}{low_v}")
+    print(lines[-1], flush=True)
+    if not timing_on:
+        return False, f"timing gate missed (pop {'/'.join(f'{x:.3f}' for x in pop_r)}, random {rnd_r:.3f})"
+    # 4. two-state replay check with fine ON for this class (A, B, C states; fp32-reference bound + markers)
+    used = time.perf_counter() - t_start
+    if used > REGA_FINE_REPLAY_DEADLINE_S[cls]:
+        return False, f"SKIPPED: replay check not started (prepare {used:.0f}s > {REGA_FINE_REPLAY_DEADLINE_S[cls]:.0f}s)"
+    cache = {}
+    why, line = _rega_replay_check(trial, weights, cache, device, gen, plan=REGA_FINE_REPLAY_PLAN[cls],
+                                   keys=REGA_FINE_STATE_KEYS)
+    del cache
+    torch.cuda.empty_cache()
+    if why:
+        return False, f"two-state replay check failed: {why}"
+    print(f"{tag} two-state replay check (fine ON): {line}", flush=True)
+    return True, ""
+
+
+def _rega_fine_phase(state, weights, device, t_start):
+    """prepare() only, LAST (after _rega_lo_phase, _fa3c_setup and _norm_gather_setup). Skips itself (OFF line)
+    when prepare() has used more than REGA_FINE_START_DEADLINE_S before the nvcc build. Builds the separate
+    muse_prefill_rega_fine module, checks its attributes before any launch, then per routed class
+    (state['rega_ok']) runs _rega_fine_class under the class's start deadline; the low class only when
+    rega_low_variant == 0 (rega_gemm_lo keeps precedence). Sets state['rega_fine_ok'][class] (plain bools) and
+    state['rega_fine_ext']. Never raises; every miss leaves master's rega_gemm. Returns the compact summary lines;
+    the PATH CHOSEN lines are last."""
+    t0 = time.perf_counter()
+    state["rega_fine_ext"], state["rega_fine_ok"] = None, {c: False for c in REGA_FINE_CLASSES}
+    lines, verdict, off, secs = [], {}, None, {}
+    v = int(state.get("rega_low_variant", 0))
+    try:
+        used = time.perf_counter() - t_start
+        routed = [c for c in REGA_FINE_CLASSES if state.get("rega_ok", {}).get(c, False)]
+        if not routed:
+            off = "no class is on rega (master's gates): nothing to re-bucket"
+        elif used > REGA_FINE_START_DEADLINE_S:
+            off = (f"SKIPPED: prepare already used {used:.0f}s > {REGA_FINE_START_DEADLINE_S:.0f}s before the nvcc "
+                   f"build")
+        elif not _rega_lo_identity()[0]:
+            off = "master's v2 rega source does not hash to master's (the fine module derives from it)"
+        else:
+            src = _rega_fine_src()
+            bad = ["a text anchor of master's source did not occur as expected"] if src is None else \
+                _rega_fine_audit(src)
+            if bad:
+                off = f"source derivation / audit failed: {bad[:3]}"
+            else:
+                print(f"{REGA_FINE_TAG} derived source sha256 "
+                      f"{hashlib.sha256((_REGA_FINE_CPP + src).encode()).hexdigest()[:16]} ({len(src)} chars); audit ok; "
+                      f"N buckets {REGA_FINE_NB}; prepare at {used:.1f}s", flush=True)
+                tb = time.perf_counter()
+                ext = _rega_fine_build(src)
+                secs["build"] = time.perf_counter() - tb
+                if ext is None:
+                    off = "build failed"
+                else:
+                    attrs_ok = _rega_fine_attrs(ext)
+                    state["rega_fine_ext"] = ext
+                    stop = None
+                    for cls in routed:
+                        tc = time.perf_counter()
+                        used = tc - t_start
+                        if stop:
+                            verdict[cls] = (False, stop)
+                        elif not attrs_ok[cls == "ft"]:
+                            verdict[cls] = (False, "attribute / register-pool check failed for this class's kernels")
+                        elif cls == "low" and v:
+                            verdict[cls] = (False, f"low runs rega_gemm_lo (rega_low_variant {v}); fine applies to "
+                                                   f"master's rega_gemm only")
+                        elif used > REGA_FINE_CLASS_DEADLINE_S[cls]:
+                            verdict[cls] = (False, f"SKIPPED: deadline (prepare {used:.0f}s > "
+                                                   f"{REGA_FINE_CLASS_DEADLINE_S[cls]:.0f}s)")
+                        else:
+                            try:
+                                on, why = _rega_fine_class(state, device, cls, weights, lines, t_start)
+                            except Exception as e:  # stop here: anything after a fault would be unreliable
+                                on, why = False, f"raised {e!r}"[:300]
+                                stop = f"an earlier class raised ({why[:80]})"
+                            state["rega_fine_ok"][cls] = bool(on)
+                            verdict[cls] = (bool(on), why)
+                        state["rega_err"].zero_()
+                        secs[cls] = time.perf_counter() - tc
+    except Exception as e:  # a device fault would have poisoned the context; anything else keeps master
+        off = f"fine phase raised {e!r}"[:400]
+        state["rega_fine_ok"] = {c: False for c in REGA_FINE_CLASSES}
+    finally:
+        if not any(state["rega_fine_ok"].values()):
+            state["rega_fine_ext"] = None
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+        if off:
+            lines.append(f"{REGA_FINE_TAG} OFF: {off}")
+            print(lines[-1], flush=True)
+        lines.append(f"{REGA_FINE_TAG} phase {time.perf_counter() - t0:.1f}s ("
+                     + ", ".join(f"{k} {s:.1f}s" for k, s in secs.items())
+                     + f"); prepare total {time.perf_counter() - t_start:.1f}s of 300s; rega_ok {state.get('rega_ok')}")
+        for cls in REGA_FINE_CLASSES:
+            on, why = verdict.get(cls, (False, off or "class not on rega"))
+            lines.append(f"{REGA_FINE_TAG} PATH CHOSEN {cls}: fine={'ON' if on else 'OFF'}"
+                         + ("" if on else f" ({why[:160]})") + (f"; rega_low_variant {v}" if cls == "low" else ""))
+        lines.append(f"{REGA_FINE_TAG} PATH CHOSEN: rega_fine_ok {state['rega_fine_ok']} (ON = N 16*nbk, 8 buckets; OFF = "
+                     f"master's rega_gemm)")
+    return lines
+
+
 def kernel_fn(data, state):
     cfg = data["config"]
     batch, length, tokens = cfg["batch"], cfg["q_len"], cfg["tokens"]
