+
+def _rega_fine_src():
+    """muse_prefill_rega_fine's CUDA source: master's head + the eight-N wgmma wrappers + master's body through
+    _REGA_FINE_EDITS, then sanity checks on the result (no master kernel name and no power-of-two bucket arithmetic
+    left, both decode_item calls pass `fine`, nine WG_CONSUME uses). None on any miss. Master's strings are read,
+    never edited."""
+    parts = {"head": _REGA_HEAD, "body": _REGA_BODY}
+    for part, old, new, n in _REGA_FINE_EDITS:
+        if parts[part].count(old) != n:
+            return None
+        parts[part] = parts[part].replace(old, new)
+    body = parts["body"]
+    if ("rega_kernel<" in body or "rega_kernel(" in body or "16 << " in body or "rega_gather_kernel" in body
+            or body.count("s_gfirst, s_gcount, fine)") != 2 or body.count("WG_CONSUME(") != 9
+            or "CUtensorMap m[8]" not in parts["head"]):
+        return None
+    return parts["head"] + _rega_wgmma_src(REGA_FINE_NB) + body
+
+
+def _rega_fine_audit(src):
+    """Pre-build audit of the fine module: no templated Tensor accessor, no mutable file-scope / static / device
+    globals. Returns the findings."""
+    bad = []
+    for name, text in (("cpp", _REGA_FINE_CPP), ("cuda", src)):
+        for n, line in enumerate(text.splitlines(), 1):
+            if "data_ptr<" in line or "data_ptr <" in line or _SSDQ_TEMPLATED_ACCESSOR.search(line):
+                bad.append(f"{name} line {n}: {line.strip()[:100]}")
+    return bad + _rega_audit_cpp(_REGA_FINE_CPP + "\n" + src)
+
+
+def _rega_fine_build(src):
+    """Compile muse_prefill_rega_fine (prepare only, last): ext or None. Master's flags and TORCH_CUDA_ARCH_LIST=9.0a
+    handling, restored after."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    ext = None
+    try:
+        from torch.utils import cpp_extension
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        try:
+            arch_flags = cpp_extension._get_cuda_arch_flags()
+        except Exception as e:
+            print(f"{REGA_FINE_TAG} TORCH_CUDA_ARCH_LIST=9.0a rejected ({e!r}); default list, error word 2 decides",
+                  flush=True)
+            if prev is None:
+                os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+            else:
+                os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+            arch_flags = ["<unknown>"]
+        print(f"{REGA_FINE_TAG} build {REGA_FINE_EXT_NAME}: arch {arch_flags}; cflags {REGA_CUDA_CFLAGS}", flush=True)
+        ext = load_inline(name=REGA_FINE_EXT_NAME, cpp_sources=_REGA_FINE_CPP, cuda_sources=src,
+                          functions=list(REGA_FINE_FUNCS), extra_cuda_cflags=list(REGA_CUDA_CFLAGS), verbose=False)
+    except Exception as e:
+        ext = None
+        print(f"{REGA_FINE_TAG} load_inline failed after {time.perf_counter() - t0:.1f}s: {str(e)[-400:]!r}",
+              flush=True)
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    if ext is not None:
+        print(f"{REGA_FINE_TAG} nvcc + load {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext
+
