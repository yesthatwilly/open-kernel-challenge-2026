+REGA_FINE_RANDOM_RATIO = 1.01              # fine pair / master pair on the random routing, rounds pooled
+REGA_FINE_ROUNDS = 2
+REGA_FINE_ALTERNATIONS = 11
+REGA_FINE_POP_MULT = 1.83                  # pop routing target: this x the uniform local routes (alpha ~2.2)
+REGA_FINE_EXACT_KINDS = ("random", "skewed", "one", "pop")
+REGA_FINE_REPLAY_PLAN = {"low": ((753, ("random", "skewed", "one")),), "high": ((3012, ("random", "skewed")),),
+                         "ft": ((16384, ("random", "local")),)}
+REGA_FINE_VARIANTS = (("m", None), ("f4", 0), ("f", 1))   # (label, fine module `fine` int; None = master's rega_gemm)
+
+_REGA_FINE_CPP = r"""
+#include <torch/extension.h>
+#include <vector>
+std::vector<int64_t> rega_init_fine();
+void rega_gemm_fine(int64_t which, torch::Tensor bsrc, torch::Tensor wbank,
