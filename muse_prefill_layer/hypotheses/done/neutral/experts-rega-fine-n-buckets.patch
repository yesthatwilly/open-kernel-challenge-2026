+def _rega_fine_attrs(ext):
+    """Attributes of the four instantiations (w13 / w2 x stage-1 / first-turn class) BEFORE any launch
+    (rega_init_fine sets each one's dynamic smem attribute; setmaxnreg.inc hangs on a short register pool): master's
+    criteria. Returns {big: ok}."""
+    info = ext.rega_init_fine()
+    ok = {False: True, True: True}
+    seen = 0
+    for i in range(0, len(info), 10):
+        flag, a_ok, regs, local_bytes, static_smem, dyn_smem, occ, e1, bin_v, _ = info[i:i + 10]
+        gated, big = bool(flag & 1), bool(flag & 2)
+        seen += 1
+        good = (bool(a_ok) and occ >= 1 and static_smem + dyn_smem <= REGA_SMEM_LIMIT
+                and regs * REGA_THREADS >= 40 * 128 + 232 * 256 and bin_v == 90)
+        ok[big] = ok[big] and good
+        print(f"{REGA_FINE_TAG} rega_kernel_fine<{'true' if gated else 'false'}, {'true' if big else 'false'}>: attrs "
+              f"{bool(a_ok)} (rc {e1}), regs {regs}, local {local_bytes} B{' SPILL' if local_bytes > 0 else ''}, "
+              f"smem {static_smem}+{dyn_smem} B, CTAs/SM {occ}, bin {bin_v}: {'ok' if good else 'OFF'}", flush=True)
+    if seen != 4:
+        return {False: False, True: False}
+    return ok
+
