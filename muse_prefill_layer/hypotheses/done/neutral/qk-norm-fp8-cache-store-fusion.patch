+@triton.jit
+def _qk_norm_fp8_store_kernel(
+    qkv_ptr, pos_ptr, loc_ptr, cos_sin_ptr, k_scale_ptr, v_scale_ptr,
+    q_out_ptr, k_cache_ptr, v_cache_ptr,
+    qkv_stride, cos_sin_stride, k_row_stride, k_head_stride, v_row_stride, v_head_stride,
+    HQ: tl.constexpr, HKV: tl.constexpr, D: tl.constexpr,
+    ROPE: tl.constexpr, SCALED: tl.constexpr, EPS: tl.constexpr,
+):
+    """One program per token row t of the qkv GEMM output [T, (2 HQ + 2 HKV) D] bf16.
+
+    Per q head (HQ) and k head (HKV): scaleless RMSNorm over D lanes in fp32, then on sliding
+    layers the interleaved RoPE (pairs (2i, 2i+1)) from the cos | sin table row at positions[t]
+    (cos lanes 0..D/2-1, sin lanes D/2..D-1). The result is rounded to bf16 (FusedQKNorm's output
+    dtype) and then to FP8 E4M3. q goes to q_out [T, HQ, D]. k, and v (the bf16 GEMM columns after
+    k, no norm), are divided by k_scale / v_scale when SCALED (after the bf16 rounding, and rounded
+    to bf16 again, as parity's bf16 tensor / fp32 scalar does) and stored as FP8 at cache row
+    cache_loc[t]. Every row is written (no reserved skip slot)."""
+    t = tl.program_id(0).to(tl.int64)
+    HALF: tl.constexpr = D // 2
+    i = tl.arange(0, HALF)[None, :]
+    row = qkv_ptr + t * qkv_stride
+
+    if ROPE:
+        pos = tl.load(pos_ptr + t).to(tl.int64)
+        cs = cos_sin_ptr + pos * cos_sin_stride
+        c = tl.load(cs + i)
+        s = tl.load(cs + HALF + i)
+    else:
+        c = tl.zeros([1, HALF], dtype=tl.float32)
+        s = tl.zeros([1, HALF], dtype=tl.float32)
+
+    # Queries: heads 0..HQ-1 at lanes h*D.
+    hq = tl.arange(0, HQ)[:, None]
+    q_even = hq * D + 2 * i
+    qe = tl.load(row + q_even).to(tl.float32)
+    qo = tl.load(row + q_even + 1).to(tl.float32)
+    r = 1.0 / tl.sqrt((tl.sum(qe * qe, axis=1) + tl.sum(qo * qo, axis=1)) / D + EPS)
+    qe = qe * r[:, None]
+    qo = qo * r[:, None]
+    if ROPE:
+        ye = qe * c - qo * s
+        yo = qe * s + qo * c
+        qe = ye
+        qo = yo
+    q_out = q_out_ptr + t * (HQ * D)
+    tl.store(q_out + q_even, qe.to(tl.bfloat16).to(tl.float32).to(tl.float8e4nv))
+    tl.store(q_out + q_even + 1, qo.to(tl.bfloat16).to(tl.float32).to(tl.float8e4nv))
+
+    # Keys: heads HQ..HQ+HKV-1 of the row.
+    hk = tl.arange(0, HKV)[:, None]
+    k_even = (HQ + hk) * D + 2 * i
+    ke = tl.load(row + k_even).to(tl.float32)
+    ko = tl.load(row + k_even + 1).to(tl.float32)
+    r = 1.0 / tl.sqrt((tl.sum(ke * ke, axis=1) + tl.sum(ko * ko, axis=1)) / D + EPS)
+    ke = ke * r[:, None]
+    ko = ko * r[:, None]
+    if ROPE:
+        ye = ke * c - ko * s
+        yo = ke * s + ko * c
+        ke = ye
+        ko = yo
+    ke = ke.to(tl.bfloat16).to(tl.float32)
+    ko = ko.to(tl.bfloat16).to(tl.float32)
+
+    # Values: the HKV heads after the keys, no norm and no RoPE.
+    j = tl.arange(0, D)[None, :]
+    v = tl.load(row + (HQ + HKV + hk) * D + j).to(tl.float32)
+
+    if SCALED:
+        k_scale = tl.load(k_scale_ptr)
+        v_scale = tl.load(v_scale_ptr)
+        ke = (ke / k_scale).to(tl.bfloat16).to(tl.float32)
+        ko = (ko / k_scale).to(tl.bfloat16).to(tl.float32)
+        v = (v / v_scale).to(tl.bfloat16).to(tl.float32)
+
+    loc = tl.load(loc_ptr + t).to(tl.int64)
+    k_out = k_cache_ptr + loc * k_row_stride + hk * k_head_stride
+    tl.store(k_out + 2 * i, ke.to(tl.float8e4nv))
+    tl.store(k_out + 2 * i + 1, ko.to(tl.float8e4nv))
+    v_out = v_cache_ptr + loc * v_row_stride + hk * v_head_stride
+    tl.store(v_out + j, v.to(tl.float8e4nv))
+
