 def _experts(x, topk_weights, local_ids, state):
+    """Shape gate: Marlin up to MARLIN_MAX_TOKENS tokens, the Triton NVFP4 GEMM above. Reads the
+    token count (a shape), never tensor values."""
+    if x.shape[0] <= MARLIN_MAX_TOKENS:
