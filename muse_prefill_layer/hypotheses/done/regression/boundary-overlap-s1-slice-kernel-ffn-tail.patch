+def _bnd_capture(fn, pool):
+    """Warm fn up on a side stream, then capture it once into the shared private pool; returns the graph."""
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        for _ in range(2):
+            fn()
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph, pool=pool):
+        fn()
+    torch.cuda.synchronize()
+    return graph
+
+
+def _bnd_rounds(graphs, pool, device):
+    """BND_ROUNDS interleaved rounds of BND_ALTERNATIONS alternations (rotated and flipped order), a 256 MiB flush
+    write before every replay, an empty-graph baseline subtracted from each round's median. Returns
+    {name: [(median us, IQR us) per round]}."""
+    tiny = torch.zeros(16, dtype=torch.float32, device=device)
+    graphs = dict(graphs)
+    graphs["empty"] = _bnd_capture(lambda: tiny.zero_(), pool)
+    flush = torch.empty(256 * 2 ** 20 // 4, dtype=torch.float32, device=device)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def once(graph):
+        flush.zero_()
+        ev[0].record()
+        graph.replay()
+        ev[1].record()
+        torch.cuda.synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1000.0
+
+    names = list(graphs)
+    for name in names:
+        once(graphs[name])
+    samples = {name: [[] for _ in range(BND_ROUNDS)] for name in names}
+    for rnd in range(BND_ROUNDS):
+        for i in range(BND_ALTERNATIONS):
+            k = (i + rnd * 5) % len(names)
+            order = names[k:] + names[:k]
+            if (i + rnd) % 2:
+                order = order[::-1]
+            for name in order:
+                samples[name][rnd].append(once(graphs[name]))
+    out = {}
+    base = [sorted(v)[len(v) // 2] for v in samples["empty"]]
+    for name in names:
+        if name == "empty":
+            continue
+        rows = []
+        for rnd in range(BND_ROUNDS):
+            v = sorted(samples[name][rnd])
+            n = len(v)
+            rows.append((max(v[n // 2] - base[rnd], 0.0), v[(3 * n) // 4] - v[n // 4]))
+        out[name] = rows
+    return out
+
+
+def _bnd_fmt(rows):
+    return " | ".join(f"r{i + 1} {m:.0f} (IQR {q:.0f})" for i, (m, q) in enumerate(rows))
+
+
+def _bnd_kernels(fn):
+    """prepare()-only: the CUDA kernel names one call of fn launches (torch.profiler); a PATH CHOSEN line proves the
+    selector, not the launched kernel. Raises if the profiler fails."""
+    from torch.profiler import ProfilerActivity, profile
+    fn()
+    torch.cuda.synchronize()
+    with profile(activities=[ProfilerActivity.CUDA]) as prof:
+        fn()
+        torch.cuda.synchronize()
+    return [e.name for e in prof.events() if "CUDA" in str(getattr(e, "device_type", ""))
+            and not e.name.startswith(("Activity Buffer Request", "Buffer Flush"))]
+
+
+def _bnd_tail(ext, coef, bnd_stream, unp_t, expert_output, stream, nch, grid, bufs=None):
+    """The chunked FFN tail: for each of nch row chunks, the unpooler GEMM into a row slice of ffn_output on the
+    current stream, then bnd_rows for the same rows on bnd_stream (it waits only for that chunk's GEMM); the current
+    stream joins bnd_stream at the end. Outputs are allocated here (shape-sized) unless bufs is given."""
+    tokens = expert_output.shape[0]
+    if bufs is None:
+        dev = expert_output.device
+        ffn_output = torch.empty((tokens, HIDDEN), dtype=torch.bfloat16, device=dev)
+        next_in = torch.empty((tokens, HIDDEN), dtype=torch.bfloat16, device=dev)
+        stream_out = torch.empty((tokens, HIDDEN), dtype=torch.float32, device=dev)
+    else:
+        ffn_output, next_in, stream_out = bufs
+    main = torch.cuda.current_stream()
+    step = tokens // nch
+    for c in range(nch):
+        r0 = c * step
+        n = tokens - r0 if c == nch - 1 else step
+        torch.mm(expert_output[r0:r0 + n], unp_t, out=ffn_output[r0:r0 + n])
+        bnd_stream.wait_stream(main)
+        with torch.cuda.stream(bnd_stream):
+            ext.bnd_rows(stream, ffn_output, r0, n, coef["alpha"], coef["beta"], coef["wpost"], coef["wpre"],
+                         POST_NORM_EPS, RMS_EPS, next_in, stream_out, grid)
+    main.wait_stream(bnd_stream)
+    if not torch.cuda.is_current_stream_capturing():
+        for tensor in (expert_output, stream, ffn_output, next_in, stream_out):
+            tensor.record_stream(bnd_stream)
+    return next_in, stream_out
+
+
+def _bnd_speed(state, ext, coefs, device, gen, pool):
+    """Milestone M1: bnd_rows over all rows at T = BND_TOKENS (one CTA per row, and the persistent grids) vs the
+    SGLang module, graph replay, flushed, interleaved. Returns the printed summary string."""
+    t = BND_TOKENS
+    stream = torch.randn((t, HIDDEN), generator=gen, device=device, dtype=torch.float32)
+    branch = torch.randn((t, HIDDEN), generator=gen, device=device, dtype=torch.float32).to(torch.bfloat16)
+    out_o = torch.empty((t, HIDDEN), dtype=torch.bfloat16, device=device)
+    out_s = torch.empty((t, HIDDEN), dtype=torch.float32, device=device)
+    c = coefs["ffn"]
+    graphs = {"module": _bnd_capture(lambda: _bnd_master(state, "ffn", stream, branch), pool)}
+    for grid in BND_GRIDS:
+        graphs[f"bnd_g{grid}"] = _bnd_capture(
+            lambda grid=grid: ext.bnd_rows(stream, branch, 0, t, c["alpha"], c["beta"], c["wpost"], c["wpre"],
+                                           POST_NORM_EPS, RMS_EPS, out_o, out_s, grid), pool)
+    stats = _bnd_rounds(graphs, pool, device)
+    parts = []
+    for name, rows in stats.items():
+        parts.append(f"{name} {_bnd_fmt(rows)}")
+    ratio = max(stats["bnd_g0"][r][0] / max(stats["module"][r][0], 1e-9) for r in range(BND_ROUNDS))
+    msg = (f"M1 T={t} FFN boundary kernel only (graph, cold L2, us): " + "; ".join(parts) +
+           f"; one-CTA-per-row / module = {ratio:.3f} (M1 target <= {BND_M1_RATIO}: "
+           f"{'met' if ratio <= BND_M1_RATIO else 'MISSED'})")
+    print(f"{BND_TAG} {msg}", flush=True)
+    del graphs, stream, branch, out_o, out_s
+    return msg, ratio
+
+
+def _bnd_tail_gate(state, ext, coefs, streams, device, gen, t_start, pool, lines):
+    """Master's routed tail (unpooler + module) vs the chunked tail at every (NCH, grid, priority) candidate on a
+    synthetic bf16 expert_output at T = BND_TOKENS: eager correctness first, then two interleaved graph rounds.
+    Returns the chosen (nch, grid, prio) or None; always prints every candidate's rounds and the kernel names."""
+    t = BND_TOKENS
+    unp_t = state["dense"]["unpooler"].t()
+    expert_output = torch.randn((t, D_EXPERT), generator=gen, device=device, dtype=torch.float32).to(torch.bfloat16)
+    stream = torch.randn((t, HIDDEN), generator=gen, device=device, dtype=torch.float32)
+    bufs = (torch.empty((t, HIDDEN), dtype=torch.bfloat16, device=device),
+            torch.empty((t, HIDDEN), dtype=torch.bfloat16, device=device),
+            torch.empty((t, HIDDEN), dtype=torch.float32, device=device))
+    c = coefs["ffn"]
+    want_o, want_s = _bnd_master_tail(state, expert_output, stream.clone())
+    torch.cuda.synchronize()
+    cands = {}
+    for nch in BND_NCH:
+        for grid in BND_GRIDS:
+            for prio in BND_PRIOS:
+                name = f"nch{nch}_g{grid}_p{prio}"
+                if time.perf_counter() - t_start > BND_GATE_DEADLINE_S:
+                    print(f"{BND_TAG} tail candidate {name} skipped: deadline", flush=True)
+                    continue
+                got_o, got_s = _bnd_step(f"tail eager {name}", lambda: _bnd_tail(
+                    ext, c, streams[prio], unp_t, expert_output, stream, nch, grid, bufs))
+                res = _bnd_compare(want_o, want_s, got_o, got_s, stream, c)
+                if not _bnd_ok_msg(res):
+                    print(f"{BND_TAG} tail candidate {name} dropped: {res}", flush=True)
+                    continue
+                cands[name] = (nch, grid, prio)
+    del want_o, want_s
+    if not cands:
+        lines.append(f"{BND_TAG} tail gate: no candidate passed the eager check")
+        return None
+    # The unpooler kernels the chunked tail launches (does the big nvjet tile survive at M = T / NCH?).
+    try:
+        for nch in BND_NCH:
+            first = next((n for n, v in cands.items() if v[0] == nch), None)
+            if first is None:
+                continue
+            _, grid, prio = cands[first]
+            names = _bnd_kernels(lambda: _bnd_tail(ext, c, streams[prio], unp_t, expert_output, stream, nch, grid, bufs))
+            uniq = list(dict.fromkeys(n[:140] for n in names))
+            print(f"{BND_TAG} chunked tail NCH={nch} kernels ({len(names)} launches): {uniq[:8]}", flush=True)
+            if names and not any("muse_prefill_bnd_rows_kernel" in n for n in names):
+                print(f"{BND_TAG} profiler saw no bnd_rows kernel for NCH={nch}; candidate group dropped", flush=True)
+                cands = {n: v for n, v in cands.items() if v[0] != nch}
+        base_names = _bnd_kernels(lambda: _bnd_master_tail(state, expert_output, stream))
+        print(f"{BND_TAG} master tail kernels: {list(dict.fromkeys(n[:140] for n in base_names))[:8]}", flush=True)
+    except Exception as e:
+        print(f"{BND_TAG} profiler kernel-name check unavailable: {str(e)[:160]!r} (candidates kept)", flush=True)
+    if not cands:
+        lines.append(f"{BND_TAG} tail gate: profiler saw no bnd_rows kernel in any candidate")
+        return None
+    if time.perf_counter() - t_start > BND_GATE_DEADLINE_S:
+        lines.append(f"{BND_TAG} tail gate skipped: deadline")
+        print(lines[-1], flush=True)
+        return None
+    # Master's ACTUALLY ROUTED tail, exactly as kernel_fn calls it (no clone: a copy would inflate master's side).
+    graphs = {"master": _bnd_capture(lambda: _bnd_master_tail(state, expert_output, stream), pool)}
+    for name, (nch, grid, prio) in cands.items():
+        graphs[name] = _bnd_capture(
+            lambda nch=nch, grid=grid, prio=prio: _bnd_tail(ext, c, streams[prio], unp_t, expert_output, stream, nch,
+                                                            grid, bufs), pool)
+    stats = _bnd_rounds(graphs, pool, device)
+    m = stats["master"]
+    best, best_ratio = None, 9.0
+    top = None   # the candidate closest to winning, reported even when master is kept
+    for name, rows in stats.items():
+        if name == "master":
+            print(f"{BND_TAG} tail T={t} master (routed unpooler + FFN boundary): {_bnd_fmt(rows)}", flush=True)
+            continue
+        ratios = [rows[r][0] / max(m[r][0], 1e-9) for r in range(BND_ROUNDS)]
+        iqr_ok = all(rows[r][1] <= BND_IQR_MAX * max(m[r][1], 0.5) for r in range(BND_ROUNDS))
+        worst = max(ratios)
+        verdict = "pass" if (worst <= BND_RATIO and iqr_ok) else "fail"
+        print(f"{BND_TAG} tail T={t} {name}: {_bnd_fmt(rows)}; / master {ratios[0]:.3f} {ratios[1]:.3f}; "
+              f"IQR {'ok' if iqr_ok else 'WIDE'}; {verdict}", flush=True)
+        if top is None or worst < top[0]:
+            top = (worst, name, rows, iqr_ok)
+        if verdict == "pass" and worst < best_ratio:
+            best, best_ratio = cands[name], worst
+    del graphs, bufs, expert_output, stream
+    if best is None:
+        lines.append(f"{BND_TAG} tail gate: no candidate <= {BND_RATIO}x master in both rounds (IQR <= "
+                     f"{BND_IQR_MAX}x), master kept; master {_bnd_fmt(m)}; closest {top[1]} {_bnd_fmt(top[2])} "
+                     f"({top[0]:.3f}x worst round, IQR {'ok' if top[3] else 'WIDE'})")
+    else:
+        lines.append(f"{BND_TAG} tail gate: best nch {best[0]} grid {best[1]} prio {best[2]} at {best_ratio:.3f}x master "
+                     f"(worst round); master {_bnd_fmt(m)}; winner {_bnd_fmt(top[2])}")
+    print(lines[-1], flush=True)
+    return best
+
