+def _bnd_replay_check(state, ext, coefs, streams, choice, device, gen, pool):
+    """The chosen tail captured once per state (two separately allocated states), replayed alternately with refilled
+    inputs and compared with the module's tail on the same data. Returns None or a reason."""
+    t = BND_TOKENS
+    nch, grid, prio = choice
+    unp_t = state["dense"]["unpooler"].t()
+    c = coefs["ffn"]
+    sets = []
+    for _ in range(2):
+        st = {"eo": torch.zeros((t, D_EXPERT), dtype=torch.bfloat16, device=device),
+              "stream": torch.zeros((t, HIDDEN), dtype=torch.float32, device=device),
+              "bufs": (torch.empty((t, HIDDEN), dtype=torch.bfloat16, device=device),
+                       torch.empty((t, HIDDEN), dtype=torch.bfloat16, device=device),
+                       torch.empty((t, HIDDEN), dtype=torch.float32, device=device))}
+        st["graph"] = _bnd_capture(
+            lambda st=st: _bnd_tail(ext, c, streams[prio], unp_t, st["eo"], st["stream"], nch, grid, st["bufs"]), pool)
+        sets.append(st)
+    for it in range(4):
+        st = sets[it % 2]
+        st["eo"].copy_(torch.randn((t, D_EXPERT), generator=gen, device=device, dtype=torch.float32).to(torch.bfloat16))
+        st["stream"].copy_(torch.randn((t, HIDDEN), generator=gen, device=device, dtype=torch.float32))
+        want_o, want_s = _bnd_master_tail(state, st["eo"], st["stream"].clone())
+        _bnd_step(f"replay check it={it} state {it % 2}", st["graph"].replay)
+        res = _bnd_compare(want_o, want_s, st["bufs"][1], st["bufs"][2], st["stream"], c)
+        print(f"{BND_TAG} replay check it={it} state {it % 2}: {res}", flush=True)
+        if not _bnd_ok_msg(res):
+            return f"it={it}: {res}"
+    return None
