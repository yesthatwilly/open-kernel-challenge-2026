+                       f"{prio} (T <= {MARLIN_MAX_TOKENS} and the attention boundary stay master); {time.perf_counter() - t0:.0f}s")
+        print(summary[-1], flush=True)
+    except Exception as e:
+        state["bnd_ok"] = False
+        state["bnd"] = None
+        summary.append(f"{BND_TAG} PATH CHOSEN T={BND_TOKENS} tail: master (setup raised {str(e)[:300]!r})")
+        print(summary[-1], flush=True)
+    finally:
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+    return summary
