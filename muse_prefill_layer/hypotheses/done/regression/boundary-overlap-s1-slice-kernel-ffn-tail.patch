+# ---------------------------------------------------------------------------------------------------------------
+# boundary-overlap-s1-slice-kernel-ffn-tail (rewrite stage 1): the FFN tail at T == BND_TOKENS (first_turn) as NCH row
+# chunks, unpooler chunk c (torch.mm into a row slice of ffn_output, main stream) then the post-FFN boundary of the
+# same rows on a per-state side stream (bnd_rows, a CUDA kernel writing ROW SLICES of preallocated outputs), so
+# boundary chunk c can run under unpooler chunk c + 1. Built last in prepare() (after rega-lo), with its own
+# deadlines; a build error, parity miss, exception, deadline or a tail that is not >= 1/BND_RATIO faster than master's
+# routed tail in BOTH interleaved rounds leaves master's exact path (state['bnd_ok'] False). Nothing here is
+# module-global device state: the extension handle, coefficients and stream live in the per-state dict state['bnd'].
+BND_TAG = "[bnd]"
+BND_EXT_NAME = "muse_prefill_bnd_v1"
+BND_CUDA_CFLAGS = ["-O3", "-std=c++20", "-lineinfo"]
+BND_TOKENS = 16384                 # the one T the chunked tail serves (the scored first_turn shapes): a shape check
+BND_NCH = (2, 4)                   # candidate chunk counts
+BND_GRIDS = (0, 32, 16)            # bnd_rows grid: 0 = one CTA per row, else that many persistent CTAs
+BND_PRIOS = (0, -1)                # side-stream priority candidates (does the captured graph keep it?)
+BND_RATIO = 0.95                   # ON only at <= this x master's routed tail in BOTH rounds (>= 1.053x)
+BND_IQR_MAX = 1.5                  # and candidate IQR <= this x master's IQR in both rounds
+BND_ROUNDS = 2
+BND_ALTERNATIONS = 15
+BND_M1_RATIO = 1.05                # milestone M1: bnd_rows over all rows <= this x the SGLang module (print only)
+BND_START_DEADLINE_S = 190.0       # no build once prepare() has used this many seconds (master ends ~140 s; build+gates ~60 s)
+BND_GATE_DEADLINE_S = 250.0        # no further phase after this: keeps margin if the 300 s clock also counts the import
+BND_RESID_TOL = 5e-3               # residual-update rel L2 vs the module (stream - alpha * stream_in)
+BND_OUT_TOL = 3e-3                 # next-input rel L2 vs the module
+BND_ROW_MULT = 5.0                 # worst row <= this x the tolerance
+BND_PARITY_T = (753, 16384)
+BND_COEF_TOL = 1e-2
+BND_SENTINEL = 7.0
+
+_BND_CPP = r"""
+#include <torch/extension.h>
+#include <vector>
+void bnd_rows(torch::Tensor stream_in, torch::Tensor branch, int64_t row0, int64_t nrows, torch::Tensor alpha,
+              torch::Tensor beta, torch::Tensor wpost, torch::Tensor wpre, double post_eps, double rms_eps,
+              torch::Tensor out_next, torch::Tensor out_stream, int64_t grid);
+std::vector<int64_t> bnd_info();
+"""
+
+_BND_CU = r"""
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <c10/cuda/CUDAException.h>
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <cstdint>
+#include <vector>
+
+namespace {
+
+constexpr int BND_N = 8192;
+constexpr int BND_THREADS = 512;
+
+__device__ __forceinline__ float bnd_warp_sum(float v) {
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+  return v;
+}
+
+// Block sum over 16 warps; each reduction uses its own 16-float shared slot (no reuse hazard across the two).
+__device__ __forceinline__ float bnd_block_sum(float v, float* red, int lane, int warp) {
+  v = bnd_warp_sum(v);
+  if (lane == 0) red[warp] = v;
+  __syncthreads();
+  float tot = 0.f;
+#pragma unroll
+  for (int i = 0; i < 16; ++i) tot += red[i];
+  return tot;
+}
+
+__device__ __forceinline__ void bnd_ld8(const float* p, float* o) {
+  const float4 a = *reinterpret_cast<const float4*>(p);
+  const float4 b = *reinterpret_cast<const float4*>(p + 4);
+  o[0] = a.x; o[1] = a.y; o[2] = a.z; o[3] = a.w;
+  o[4] = b.x; o[5] = b.y; o[6] = b.z; o[7] = b.w;
+}
+
+// One row per CTA iteration (CTA r, r + gridDim.x, ...); 512 threads x 16 elements. Thread t owns columns
+// (t + 512 j) * 8 .. + 7 for j = 0, 1: every global load of the row (2 x uint4 of branch, 4 x float4 of stream) is
+// issued before any math. post-norm of the branch (x wpost when given), norm-preserving residual mix, pre-norm of the
+// new stream; writes the new stream (fp32) and the next input (bf16) at the same rows.
+__global__ void __launch_bounds__(BND_THREADS) muse_prefill_bnd_rows_kernel(
+    const float* __restrict__ stream_in, const __nv_bfloat16* __restrict__ branch, int64_t row0, int nrows,
+    const float* __restrict__ alpha, const float* __restrict__ beta, const float* __restrict__ wpost,
+    const float* __restrict__ wpre, float post_eps, float rms_eps, __nv_bfloat16* __restrict__ out_next,
+    float* __restrict__ out_stream) {
+  __shared__ float red[2][16];
+  const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+  for (int r = blockIdx.x; r < nrows; r += gridDim.x) {
+    const int64_t base = (row0 + r) * static_cast<int64_t>(BND_N);
+    uint4 braw[2];
+    float4 sraw[4];
+#pragma unroll
+    for (int j = 0; j < 2; ++j) {
+      const int64_t col = base + static_cast<int64_t>(t + BND_THREADS * j) * 8;
+      braw[j] = *reinterpret_cast<const uint4*>(branch + col);
+      sraw[2 * j] = *reinterpret_cast<const float4*>(stream_in + col);
+      sraw[2 * j + 1] = *reinterpret_cast<const float4*>(stream_in + col + 4);
+    }
+    float b[16], s[16];
+#pragma unroll
+    for (int j = 0; j < 2; ++j) {
+      const uint32_t w[4] = {braw[j].x, braw[j].y, braw[j].z, braw[j].w};
+#pragma unroll
+      for (int q = 0; q < 4; ++q) {
+        b[j * 8 + 2 * q] = __uint_as_float(w[q] << 16);
+        b[j * 8 + 2 * q + 1] = __uint_as_float(w[q] & 0xffff0000u);
+      }
+      s[j * 8 + 0] = sraw[2 * j].x; s[j * 8 + 1] = sraw[2 * j].y;
+      s[j * 8 + 2] = sraw[2 * j].z; s[j * 8 + 3] = sraw[2 * j].w;
+      s[j * 8 + 4] = sraw[2 * j + 1].x; s[j * 8 + 5] = sraw[2 * j + 1].y;
+      s[j * 8 + 6] = sraw[2 * j + 1].z; s[j * 8 + 7] = sraw[2 * j + 1].w;
+    }
+    if (wpost != nullptr) {
+#pragma unroll
+      for (int j = 0; j < 2; ++j) {
+        float w8[8];
+        bnd_ld8(wpost + (t + BND_THREADS * j) * 8, w8);
+#pragma unroll
+        for (int k = 0; k < 8; ++k) b[j * 8 + k] *= w8[k];
+      }
+    }
+    float ss = 0.f;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) ss += b[i] * b[i];
+    ss = bnd_block_sum(ss, red[0], lane, warp);
+    const float inv = rsqrtf(ss * (1.0f / BND_N) + post_eps);
+    float ss2 = 0.f;
+#pragma unroll
+    for (int j = 0; j < 2; ++j) {
+      float a8[8], be8[8];
+      bnd_ld8(alpha + (t + BND_THREADS * j) * 8, a8);
+      bnd_ld8(beta + (t + BND_THREADS * j) * 8, be8);
+#pragma unroll
+      for (int k = 0; k < 8; ++k) {
+        const float sn = a8[k] * s[j * 8 + k] + be8[k] * (b[j * 8 + k] * inv);
+        s[j * 8 + k] = sn;
+        ss2 += sn * sn;
+      }
+    }
+    ss2 = bnd_block_sum(ss2, red[1], lane, warp);
+    const float inv2 = rsqrtf(ss2 * (1.0f / BND_N) + rms_eps);
+#pragma unroll
+    for (int j = 0; j < 2; ++j) {
+      const int64_t col = base + static_cast<int64_t>(t + BND_THREADS * j) * 8;
+      float p8[8];
+      bnd_ld8(wpre + (t + BND_THREADS * j) * 8, p8);
+      *reinterpret_cast<float4*>(out_stream + col) = make_float4(s[j * 8 + 0], s[j * 8 + 1], s[j * 8 + 2], s[j * 8 + 3]);
+      *reinterpret_cast<float4*>(out_stream + col + 4) = make_float4(s[j * 8 + 4], s[j * 8 + 5], s[j * 8 + 6], s[j * 8 + 7]);
+      uint32_t o[4];
+#pragma unroll
+      for (int q = 0; q < 4; ++q) {
+        const __nv_bfloat162 pr = __floats2bfloat162_rn(s[j * 8 + 2 * q] * inv2 * p8[2 * q],
+                                                        s[j * 8 + 2 * q + 1] * inv2 * p8[2 * q + 1]);
+        o[q] = *reinterpret_cast<const uint32_t*>(&pr);
+      }
+      *reinterpret_cast<uint4*>(out_next + col) = make_uint4(o[0], o[1], o[2], o[3]);
+    }
+  }
+}
+
+bool bnd_aligned(const torch::Tensor& t) { return reinterpret_cast<uintptr_t>(t.data_ptr()) % 16 == 0; }
+
+}  // namespace
+
+// stream_in fp32 [T, 8192], branch bf16 [T, 8192], alpha / beta / wpre fp32 [8192], wpost fp32 [8192] or an empty
+// tensor (no input scale), out_next bf16 [T, 8192], out_stream fp32 [T, 8192]; rows row0 .. row0 + nrows - 1 on the
+// current stream. grid 0: one CTA per row, else min(grid, nrows) persistent CTAs.
+void bnd_rows(torch::Tensor stream_in, torch::Tensor branch, int64_t row0, int64_t nrows, torch::Tensor alpha,
+              torch::Tensor beta, torch::Tensor wpost, torch::Tensor wpre, double post_eps, double rms_eps,
+              torch::Tensor out_next, torch::Tensor out_stream, int64_t grid) {
+  TORCH_CHECK(stream_in.is_cuda() && branch.is_cuda() && out_next.is_cuda() && out_stream.is_cuda(), "bnd_rows: cuda");
+  TORCH_CHECK(stream_in.scalar_type() == at::kFloat && out_stream.scalar_type() == at::kFloat &&
+              branch.scalar_type() == at::kBFloat16 && out_next.scalar_type() == at::kBFloat16, "bnd_rows: dtypes");
+  TORCH_CHECK(alpha.scalar_type() == at::kFloat && beta.scalar_type() == at::kFloat &&
+              wpre.scalar_type() == at::kFloat && wpost.scalar_type() == at::kFloat, "bnd_rows: coef dtypes");
+  TORCH_CHECK(stream_in.is_contiguous() && branch.is_contiguous() && out_next.is_contiguous() &&
+              out_stream.is_contiguous() && alpha.is_contiguous() && beta.is_contiguous() && wpre.is_contiguous() &&
+              wpost.is_contiguous(), "bnd_rows: contiguous");
+  TORCH_CHECK(stream_in.dim() == 2 && stream_in.size(1) == BND_N && branch.sizes() == stream_in.sizes() &&
+              out_next.sizes() == stream_in.sizes() && out_stream.sizes() == stream_in.sizes(), "bnd_rows: shapes");
+  TORCH_CHECK(alpha.numel() == BND_N && beta.numel() == BND_N && wpre.numel() == BND_N &&
+              (wpost.numel() == 0 || wpost.numel() == BND_N), "bnd_rows: coef sizes");
+  TORCH_CHECK(row0 >= 0 && nrows >= 0 && row0 + nrows <= stream_in.size(0), "bnd_rows: row range");
+  TORCH_CHECK(bnd_aligned(stream_in) && bnd_aligned(branch) && bnd_aligned(out_next) && bnd_aligned(out_stream) &&
+              bnd_aligned(alpha) && bnd_aligned(beta) && bnd_aligned(wpre) && (wpost.numel() == 0 || bnd_aligned(wpost)),
+              "bnd_rows: 16-byte alignment");
+  if (nrows == 0) return;
+  const c10::cuda::CUDAGuard guard(stream_in.device());
+  const int64_t blocks = (grid <= 0 || grid > nrows) ? nrows : grid;
+  auto stream = at::cuda::getCurrentCUDAStream();
+  muse_prefill_bnd_rows_kernel<<<static_cast<unsigned int>(blocks), BND_THREADS, 0, stream>>>(
+      reinterpret_cast<const float*>(stream_in.data_ptr()), reinterpret_cast<const __nv_bfloat16*>(branch.data_ptr()),
+      row0, static_cast<int>(nrows), reinterpret_cast<const float*>(alpha.data_ptr()),
+      reinterpret_cast<const float*>(beta.data_ptr()),
+      wpost.numel() == 0 ? nullptr : reinterpret_cast<const float*>(wpost.data_ptr()),
+      reinterpret_cast<const float*>(wpre.data_ptr()), static_cast<float>(post_eps), static_cast<float>(rms_eps),
+      reinterpret_cast<__nv_bfloat16*>(out_next.data_ptr()), reinterpret_cast<float*>(out_stream.data_ptr()));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// attributes ok, numRegs, localSizeBytes, static smem, CTAs per SM at 512 threads, binaryVersion, ptxVersion
+std::vector<int64_t> bnd_info() {
+  std::vector<int64_t> r;
+  const void* fn = reinterpret_cast<const void*>(muse_prefill_bnd_rows_kernel);
+  cudaFuncAttributes a{};
+  const cudaError_t e1 = cudaFuncGetAttributes(&a, fn);
+  int occ = 0;
+  const cudaError_t e2 = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, fn, BND_THREADS, 0);
+  if (e1 != cudaSuccess || e2 != cudaSuccess) (void)cudaGetLastError();
+  r.push_back(e1 == cudaSuccess && e2 == cudaSuccess ? 1 : 0);
+  r.push_back(a.numRegs);
+  r.push_back(static_cast<int64_t>(a.localSizeBytes));
+  r.push_back(static_cast<int64_t>(a.sharedSizeBytes));
+  r.push_back(occ);
+  r.push_back(a.binaryVersion);
+  r.push_back(a.ptxVersion);
+  return r;
+}
+"""
+
+
+def _bnd_build():
+    """Compile the small module (prepare only). Plain sm_90 (no wgmma / sm_90a PTX): TORCH_CUDA_ARCH_LIST is set to
+    9.0 around the build and restored after. Returns (ext or None, build seconds)."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    ext = None
+    try:
+        from torch.utils import cpp_extension
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0"
+        try:
+            arch_flags = cpp_extension._get_cuda_arch_flags()
+        except Exception as e:
+            arch_flags = [f"<unknown: {e!r}>"]
+        print(f"{BND_TAG} build {BND_EXT_NAME}: torch {torch.__version__} cuda {torch.version.cuda}; "
+              f"TORCH_CUDA_ARCH_LIST={os.environ.get('TORCH_CUDA_ARCH_LIST')!r} -> {arch_flags}; "
+              f"extra_cuda_cflags {BND_CUDA_CFLAGS}", flush=True)
+        ext = load_inline(name=BND_EXT_NAME, cpp_sources=_BND_CPP, cuda_sources=_BND_CU,
+                          functions=["bnd_rows", "bnd_info"], extra_cuda_cflags=list(BND_CUDA_CFLAGS), verbose=False)
+    except Exception as e:
+        ext = None
+        print(f"{BND_TAG} load_inline failed after {time.perf_counter() - t0:.1f}s: {str(e)[-400:]!r}", flush=True)
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    elapsed = time.perf_counter() - t0
+    if ext is not None:
+        print(f"{BND_TAG} load_inline compiled in {elapsed:.1f}s", flush=True)
+    return ext, elapsed
+
+
+def _bnd_source_audit():
+    """Pre-build audit of the sources: no templated tensor accessor, no mutable file-scope / static / device state."""
+    bad = []
+    for name, src in (("cpp", _BND_CPP), ("cuda", _BND_CU)):
+        for n, line in enumerate(src.splitlines(), 1):
+            if "data_ptr<" in line or "data_ptr <" in line:
+                bad.append(f"{name} line {n}: {line.strip()[:120]}")
+    bad.extend(_rega_audit_cpp(_BND_CPP + "\n" + _BND_CU))
+    return bad
+
+
+def _bnd_step(tag, fn):
+    """A launch announced before and synced + printed after, so a fault names its kernel."""
+    print(f"{BND_TAG} [{tag}] launching", flush=True)
+    out = fn()
+    torch.cuda.synchronize()
+    print(f"{BND_TAG} [{tag}] done", flush=True)
+    return out
+
+
+def _bnd_master(state, which, stream, branch):
+    """SGLang's boundary module, called as kernel_fn calls it: (next input bf16, new stream fp32)."""
+    if which == "attn":
+        out, s_new, _ = state["attn_boundary"](stream, branch, branch_dtype=torch.bfloat16, router_dtype=None)
+    else:
+        out, s_new, _ = state["ffn_boundary"](stream, branch, branch_dtype=torch.bfloat16)
+    return out, s_new
+
+
+def _bnd_master_tail(state, expert_output, stream):
+    """Master's routed FFN tail at T > MARLIN_MAX_TOKENS: the unpooler GEMM, then the boundary module."""
+    ffn_output = _gemm(expert_output, state["dense"]["unpooler"])
+    out, s_new, _ = state["ffn_boundary"](stream, ffn_output, branch_dtype=torch.bfloat16)
+    return out, s_new
+
+
+def _bnd_coefs(state, weights, device):
+    """Per-state fp32 [8192] alpha, beta, wpost (empty = none) and wpre for both boundaries. alpha and beta are probed
+    from the SGLang modules (stream = 1, branch = 0 gives alpha; stream = 0, branch = 1 gives beta over the normalized
+    branch), then cross-checked against the reference formula (> BND_COEF_TOL apart raises)."""
+    pre_ffn, next_pre_attn, _, post_ffn, _ = state["_modules"]
+
+    def eff(mod):
+        return mod._get_effective_weight().detach().float().contiguous()
+
+    wpost = eff(post_ffn)
+    ones = torch.ones((8, HIDDEN), dtype=torch.float32, device=device)
+    zeros = torch.zeros_like(ones)
+    out = {}
+    for which, gate_name, wp, wpre in (("attn", "attn_residual_gate", None, eff(pre_ffn)),
+                                       ("ffn", "ffn_residual_gate", wpost, eff(next_pre_attn))):
+        _, alpha_p = _bnd_master(state, which, ones.clone(), zeros.to(torch.bfloat16))
+        _, beta_raw = _bnd_master(state, which, zeros.clone(), ones.to(torch.bfloat16))
+        b = torch.ones(HIDDEN, dtype=torch.float32, device=device)
+        if wp is not None:
+            b = b * wp
+        b = b * torch.rsqrt((b * b).mean() + POST_NORM_EPS)
+        alpha_p, beta_p = alpha_p[0].float().contiguous(), (beta_raw[0].float() / b).contiguous()
+        w = weights[gate_name].float() / 0.3
+        beta_f = torch.sigmoid(w)
+        alpha_f = torch.sqrt(torch.clamp(torch.sigmoid(-w) * (1.0 + beta_f), min=1e-3))
+        d = max(float((alpha_p - alpha_f).abs().max()), float((beta_p - beta_f).abs().max()))
+        torch.cuda.synchronize()
+        print(f"{BND_TAG} coefficients {which}: probe vs formula max diff {d:.2e}", flush=True)
+        if not d <= BND_COEF_TOL:
+            raise RuntimeError(f"{which} alpha/beta probe differs from the reference formula by {d:.2e}")
+        out[which] = {"alpha": alpha_p, "beta": beta_p,
+                      "wpost": wp if wp is not None else torch.empty(0, dtype=torch.float32, device=device),
+                      "wpre": wpre}
+    return out
+
+
+def _bnd_rel(got, want, base=None):
+    """(whole-matrix rel L2, worst row rel) of got - want against base (default want); a row's denominator is at
+    least a tenth of the mean row norm, as the judge measures near-zero rows."""
+    g, w = got.float(), want.float()
+    ref = w if base is None else base.float()
+    diff = g - w
+    rn = ref.norm(dim=1)
+    rn = torch.maximum(rn, 0.1 * rn.mean())
+    return (float(diff.norm() / ref.norm().clamp_min(1e-30)), float((diff.norm(dim=1) / rn).max()))
+
+
+def _bnd_compare(want_o, want_s, got_o, got_s, stream_in, coef):
+    """None when the outputs match the module within the residual / next-input tolerances (whole and worst row), else
+    the reason; also prints nothing."""
+    if not (bool(torch.isfinite(got_o.float()).all()) and bool(torch.isfinite(got_s).all())):
+        return "NaN/Inf"
+    rel_s, row_s = _bnd_rel(got_s, want_s, base=want_s - coef["alpha"] * stream_in)
+    rel_o, row_o = _bnd_rel(got_o, want_o)
+    msg = f"stream {rel_s:.2e} (row {row_s:.2e}), next {rel_o:.2e} (row {row_o:.2e})"
+    if rel_s > BND_RESID_TOL or row_s > BND_ROW_MULT * BND_RESID_TOL:
+        return f"residual update too far: {msg}"
+    if rel_o > BND_OUT_TOL or row_o > BND_ROW_MULT * BND_OUT_TOL:
+        return f"next input too far: {msg}"
+    return msg
+
+
+def _bnd_ok_msg(res):
+    return res is not None and not res.startswith(("NaN", "residual", "next"))
+
+
+def _bnd_parity(state, ext, coefs, device, gen, t_start):
+    """bnd_rows (two row chunks, grids alternating one-CTA-per-row / 32 persistent) against the SGLang modules on
+    random rows at T in BND_PARITY_T, both boundaries, run four times alternating two separately allocated sets
+    (inputs, outputs, coefficient copies). Rows outside a chunk must keep the sentinel. Returns None or a reason."""
+    for t in BND_PARITY_T:
+        for which in ("attn", "ffn"):
+            if time.perf_counter() - t_start > BND_GATE_DEADLINE_S:
+                return f"skipped: deadline (T={t} {which})"
+            sets = []
+            for _ in range(2):
+                stream = torch.randn((t, HIDDEN), generator=gen, device=device, dtype=torch.float32)
+                branch = torch.randn((t, HIDDEN), generator=gen, device=device, dtype=torch.float32).to(torch.bfloat16)
+                want_o, want_s = _bnd_master(state, which, stream.clone(), branch)
+                sets.append({
+                    "stream": stream, "branch": branch, "want_o": want_o, "want_s": want_s,
+                    "coef": {k: v.clone() for k, v in coefs[which].items()},
+                    "out_o": torch.empty((t, HIDDEN), dtype=torch.bfloat16, device=device),
+                    "out_s": torch.empty((t, HIDDEN), dtype=torch.float32, device=device)})
+            torch.cuda.synchronize()
+            half = t // 2
+            worst = None
+            for it in range(4):
+                st = sets[it % 2]
+                st["out_o"].fill_(BND_SENTINEL)
+                st["out_s"].fill_(BND_SENTINEL)
+                grids = (0, 32) if it % 2 == 0 else (32, 0)
+                c = st["coef"]
+
+                def launch(r0, n, grid, st=st, c=c):
+                    ext.bnd_rows(st["stream"], st["branch"], r0, n, c["alpha"], c["beta"], c["wpost"], c["wpre"],
+                                 POST_NORM_EPS, RMS_EPS, st["out_o"], st["out_s"], grid)
+
+                _bnd_step(f"parity T={t} {which} it={it} chunk 0 (grid {grids[0]})",
+                          lambda: launch(0, half, grids[0]))
+                if it == 0:
+                    untouched = bool((st["out_s"][half:] == BND_SENTINEL).all()) and \
+                        bool((st["out_o"][half:] == BND_SENTINEL).all())
+                    if not untouched:
+                        return f"T={t} {which}: rows outside the chunk were written"
+                _bnd_step(f"parity T={t} {which} it={it} chunk 1 (grid {grids[1]})",
+                          lambda: launch(half, t - half, grids[1]))
+                res = _bnd_compare(st["want_o"], st["want_s"], st["out_o"], st["out_s"], st["stream"], coefs[which])
+                if not _bnd_ok_msg(res):
+                    return f"T={t} {which} it={it}: {res}"
+                worst = res
+            print(f"{BND_TAG} parity T={t} {which}: ok, last {worst}", flush=True)
