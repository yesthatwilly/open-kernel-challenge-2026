+        info = [int(v) for v in ext.bnd_info()]
+        print(f"{BND_TAG} bnd_rows attributes ok={info[0]}, regs {info[1]}, local (spill) bytes {info[2]}, static smem "
+              f"{info[3]}, occupancy {info[4]} CTAs/SM at 512 threads, binary {info[5]} ptx {info[6]} (the nvjet "
+              f"unpooler's regs/smem are not queryable in-process: kernel names are printed by the profiler below)",
+              flush=True)
+        if not info[0]:
