+        if why is not None:
+            summary.append(f"{BND_TAG} PATH CHOSEN T={BND_TOKENS} tail: master (parity: {why})")
+            print(summary[-1], flush=True)
+            return summary
+        summary.append(f"{BND_TAG} parity ok at T in {BND_PARITY_T} (both boundaries, 2 alternating sets, row slices)")
+        torch.cuda.synchronize()
+        if time.perf_counter() - t_start > BND_GATE_DEADLINE_S:
+            summary.append(f"{BND_TAG} PATH CHOSEN T={BND_TOKENS} tail: master (M1 / tail gate skipped: deadline)")
+            print(summary[-1], flush=True)
+            return summary
+        m1_msg, _ = _bnd_speed(state, ext, coefs, device, gen, pool)
+        summary.append(f"{BND_TAG} {m1_msg}")
+        streams = {p: torch.cuda.Stream(device, priority=p) for p in BND_PRIOS}
+        choice = _bnd_tail_gate(state, ext, coefs, streams, device, gen, t_start, pool, summary)
+        if choice is None:
+            summary.append(f"{BND_TAG} PATH CHOSEN T={BND_TOKENS} tail: master (no chunked candidate won)")
+            print(summary[-1], flush=True)
+            return summary
+        if time.perf_counter() - t_start > BND_GATE_DEADLINE_S:
+            summary.append(f"{BND_TAG} PATH CHOSEN T={BND_TOKENS} tail: master (replay check skipped: deadline)")
+            print(summary[-1], flush=True)
+            return summary
+        why = _bnd_replay_check(state, ext, coefs, streams, choice, device, gen, pool)
+        if why is not None:
+            summary.append(f"{BND_TAG} PATH CHOSEN T={BND_TOKENS} tail: master (replay check: {why})")
+            print(summary[-1], flush=True)
+            return summary
+        nch, grid, prio = choice
+        state["bnd"] = {"ext": ext, "coef": coefs["ffn"], "stream": streams[prio], "nch": nch, "grid": grid}
+        state["bnd_ok"] = True
