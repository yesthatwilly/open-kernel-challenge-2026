+# The prepare() check covers one full 128 (rows) x 64 (k) tile: four scale groups, every N column.
+CHECK_ROWS = 128
+CHECK_K = 64
+
+
+def _check_expert_gemms(bank):
+    """Untimed. Runs every kernel variant kernel_fn can launch (so each is compiled before capture)
+    on a synthetic case built from the weights alone, and asserts its in-kernel dequant equals
+    nvfp4.dequantize. Row r of A is one-hot at k0 + r % 64, so output row r is column k0 + r % 64
+    of the dequantized expert, through the real pointer arithmetic, K loop, nibble order, scale
+    indexing and epilogue. One -1 block and one block past the padded count must leave their
+    rows untouched (or zero, for the -1 block when zero-storing)."""
+    device = bank["w13"].device
+    e = LOCAL_EXPERTS - 1  # the largest expert offsets
+    for name, top_k, zero_nonlocal in (("w13", TOP_K, False), ("w2", 1, ZERO_NONLOCAL_W2)):
+        w, sf, gs = bank[name], bank[name + "_sf"], bank[name + "_gs"]
+        n, k = w.shape[1], w.shape[2] * 2
+        k0 = k // 2 + CHECK_K  # a tile in the middle of the K loop
+        ref = nvfp4.dequantize(w[e, :, k0 // 2:(k0 + CHECK_K) // 2], sf[e, :, k0 // 16:(k0 + CHECK_K) // 16], gs[e])
+        codes = nvfp4.unpack_e2m1(w[e, :, k0 // 2:(k0 + CHECK_K) // 2])
+        rows = torch.arange(CHECK_ROWS, device=device)
+        want = ref[:, rows % CHECK_K].t()          # [CHECK_ROWS, n]
+        want_codes = codes[:, rows % CHECK_K].t()
+        for _, cfg in EXPERT_CONFIGS:
+            bm = cfg["BLOCK_M"]
+            total = CHECK_ROWS + 2 * bm             # + one -1 block + one block past n_padded
+            x = torch.zeros((total, k), dtype=torch.bfloat16, device=device)
+            x[rows, k0 + rows % CHECK_K] = 1.0
+            sorted_ids = (torch.arange(total, device=device, dtype=torch.int32) * top_k).contiguous()
+            expert_ids = torch.full((total // bm,), e, dtype=torch.int32, device=device)
+            expert_ids[CHECK_ROWS // bm] = -1
+            expert_ids[CHECK_ROWS // bm + 1] = 0    # valid expert, but past n_padded: must not run
+            n_padded = torch.tensor([CHECK_ROWS + bm], dtype=torch.int32, device=device)
+            out = torch.full((total * top_k, n), float("nan"), dtype=torch.bfloat16, device=device)
+            _nvfp4_moe_gemm(x, w, sf, gs, out, sorted_ids, expert_ids, n_padded, top_k, total * top_k, cfg,
+                            zero_nonlocal)
+            torch.cuda.synchronize()
+            got = out[0:CHECK_ROWS * top_k:top_k].float()
+            bad = ((got - want).abs() > want.abs() * 2.0 ** -7) | got.isnan()
+            if bool(bad.any()):
+                halves = bool((want_codes[bad].abs() == 0.5).all())
+                raise AssertionError(
+                    f"NVFP4 in-kernel dequant mismatch: {name} BLOCK_M={bm}, {int(bad.sum())} of {bad.numel()} "
+                    f"values, max err {float((got - want).abs().max())}"
+                    + (" (only E2M1 +-0.5 codes: bf16 subnormals flushed to zero)" if halves else ""))
+            nonlocal_rows = out[CHECK_ROWS * top_k:(CHECK_ROWS + bm) * top_k:top_k].float()
+            if zero_nonlocal:
+                assert bool((nonlocal_rows == 0).all()), f"{name} BLOCK_M={bm}: -1 block not zeroed"
+            else:
+                assert bool(nonlocal_rows.isnan().all()), f"{name} BLOCK_M={bm}: -1 block was written"
+            past = out[(CHECK_ROWS + bm) * top_k::top_k].float()
+            assert bool(past.isnan().all()), f"{name} BLOCK_M={bm}: block past n_padded was written"
 
 
