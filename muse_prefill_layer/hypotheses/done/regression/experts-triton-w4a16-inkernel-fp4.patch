+def _e2m1_bits_to_bf16(bits):
+    """int32 BF16 bit patterns -> bfloat16 (a bitcast)."""
+    return bits.to(tl.uint16).to(tl.bfloat16, bitcast=True)
+
+
+@triton.jit(do_not_specialize=["num_valid_tokens", "EM"])
+def _moe_nvfp4_gemm_kernel(
+    a_ptr, b_ptr, sf_ptr, gs_ptr, c_ptr, sorted_ids_ptr, expert_ids_ptr, n_padded_ptr,
+    num_valid_tokens, EM,
+    N: tl.constexpr, K: tl.constexpr, TOP_K: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, GROUP_SIZE_M: tl.constexpr,
+    ZERO_NONLOCAL: tl.constexpr,
+):
+    """SGLang's fused_moe_kernel (fused_moe_triton/fused_moe.py) in its W4A16 form, with the B tile
+    dequantized from the stored NVFP4 layout in registers:
+
+      B codes   uint8 [E, N, K/2], N-major, element 2i in the low nibble, 2i + 1 in the high one
+      B scales  float8_e4m3fn [E, N, K/16], one per 16 k
+      B global  float32 [E], applied once to the fp32 accumulator in the epilogue
+
+    A is bf16 [M, K] (row = sorted id // TOP_K), C is bf16 [num_valid_tokens, N] (row = sorted
+    id). No routed-weight multiply. All strides follow from N and K (contiguous tensors)."""
+    pid = tl.program_id(axis=0)
+    num_pid_m = tl.cdiv(EM, BLOCK_M)
+    num_pid_n: tl.constexpr = N // BLOCK_N
+    num_pid_in_group = GROUP_SIZE_M * num_pid_n
+    group_id = pid // num_pid_in_group
+    first_pid_m = group_id * GROUP_SIZE_M
+    group_size_m = min(num_pid_m - first_pid_m, GROUP_SIZE_M)
+    pid_m = first_pid_m + ((pid % num_pid_in_group) % group_size_m)
+    pid_n = (pid % num_pid_in_group) // group_size_m
+
+    # The grid covers the static bound of sorted_ids; blocks past the real padded count exit here.
+    num_tokens_post_padded = tl.load(n_padded_ptr)
+    if pid_m * BLOCK_M >= num_tokens_post_padded:
+        return
+
+    offs_token_id = pid_m * BLOCK_M + tl.arange(0, BLOCK_M).to(tl.int64)
+    offs_token = tl.load(sorted_ids_ptr + offs_token_id).to(tl.int64)
+    token_mask = offs_token < num_valid_tokens
+    offs_cn = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    c_ptrs = c_ptr + offs_token[:, None] * N + offs_cn[None, :]
+
+    off_expert = tl.load(expert_ids_ptr + pid_m).to(tl.int64)
+    if off_expert == -1:
+        # Routes to experts on other GPUs.
+        if ZERO_NONLOCAL:
+            tl.store(c_ptrs, tl.zeros((BLOCK_M, BLOCK_N), dtype=c_ptr.dtype.element_ty),
+                     mask=token_mask[:, None])
+        return
+
+    offs_k = tl.arange(0, BLOCK_K)
+    offs_kh = tl.arange(0, BLOCK_K // 2)
+    a_ptrs = a_ptr + (offs_token[:, None] // TOP_K) * K + offs_k[None, :]
+    # [BLOCK_N, BLOCK_K // 2]: each byte holds k = 2i (low nibble) and 2i + 1 (high nibble).
+    b_ptrs = b_ptr + off_expert * (N * (K // 2)) + offs_cn[:, None] * (K // 2) + offs_kh[None, :]
+    # The block scale of byte i is at k // 16 = i // 8 (shared by both nibbles).
+    s_ptrs = sf_ptr + off_expert * (N * (K // 16)) + offs_cn[:, None] * (K // 16) + (offs_kh[None, :] // 8)
+
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for _ in range(0, K // BLOCK_K):
+        a = tl.load(a_ptrs, mask=token_mask[:, None], other=0.0)
+        b = tl.load(b_ptrs).to(tl.int32)
+        s = tl.load(s_ptrs)
+        # E2M1 -> BF16 by bit placement: the 3 magnitude bits go to bf16 bits 8..6 (exponent low
+        # bits and the top mantissa bit), the sign to bit 15. That is E2M1 * 2^-126 exactly,
+        # e = 0 codes landing on bf16 subnormals (0.5 -> 2^-127).
+        w_lo = _e2m1_bits_to_bf16(((b & 0x07) << 6) | ((b & 0x08) << 12))
+        w_hi = _e2m1_bits_to_bf16(((b & 0x70) << 2) | ((b & 0x80) << 8))
+        # Block scale * 2^119 (exact: e4m3 has 4 significant bits and 448 * 2^119 < bf16 max). The
+        # product E2M1 * scale * 2^-7 has at most 6 significant bits, so it is exact in BF16.
+        sb = (s.to(tl.float32) * SCALE_BIAS).to(tl.bfloat16)
+        w = tl.interleave(w_lo * sb, w_hi * sb)  # [BLOCK_N, BLOCK_K], k = 2i + j
+        acc += tl.dot(a, tl.trans(w))
+        a_ptrs += BLOCK_K
+        b_ptrs += BLOCK_K // 2
+        s_ptrs += BLOCK_K // 16
+
+    # The per-expert global scale (and the 2^7 the B tile left out), once per output.
+    gs = tl.load(gs_ptr + off_expert) * EPILOGUE_BIAS
+    tl.store(c_ptrs, (acc * gs).to(c_ptr.dtype.element_ty), mask=token_mask[:, None])
+
