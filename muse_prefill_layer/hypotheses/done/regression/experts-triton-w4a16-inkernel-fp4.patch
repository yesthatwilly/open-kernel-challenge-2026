+    assert a.shape[1] == k and out.shape[1] == n and sf.shape[2] * nvfp4.BLOCK == k
+    assert n % cfg["BLOCK_N"] == 0 and k % cfg["BLOCK_K"] == 0 and cfg["BLOCK_K"] % 32 == 0
+    em = sorted_ids.shape[0]
+    grid = (triton.cdiv(em, cfg["BLOCK_M"]) * (n // cfg["BLOCK_N"]),)
+    _moe_nvfp4_gemm_kernel[grid](
+        a, w, sf, gs, out, sorted_ids, expert_ids, n_padded, num_valid, em,
+        N=n, K=k, TOP_K=top_k, BLOCK_M=cfg["BLOCK_M"], BLOCK_N=cfg["BLOCK_N"], BLOCK_K=cfg["BLOCK_K"],
+        GROUP_SIZE_M=cfg["GROUP_SIZE_M"], ZERO_NONLOCAL=zero_nonlocal,
+        num_warps=cfg["num_warps"], num_stages=cfg["num_stages"])
+    return out
+
