+def _cuda_fragment_maps(device):
+    """The CUDA kernel's per-block permutations (stage-1 layout, see the kernel's comment). Each
+    (128-row tile, 64-k chunk) block holds 8192 nibbles in the order [warpgroup 2][thread 128][k16 step 4]
+    [nibble 8] and 512 scales in the order [warpgroup 2][warp 4][quad 8][k16 step 4][row half 2]. Returns
+    flat (row * 64 + k) and (row * 4 + k16 step) source indices; both are asserted to be permutations."""
+    wg = torch.arange(2, device=device).view(2, 1, 1, 1)
+    tid = torch.arange(128, device=device).view(1, 128, 1, 1)
+    step = torch.arange(4, device=device).view(1, 1, 4, 1)
+    nib = torch.arange(8, device=device).view(1, 1, 1, 8)
+    warp, g, t = tid // 32, (tid % 32) // 4, tid % 4
+    j, hi = nib % 4, nib // 4                     # register j of the step; low / high bf16 half
+    row = wg * 64 + warp * 16 + g + 8 * (j % 2)
+    k = 16 * step + 2 * t + 8 * (j // 2) + hi
+    code_idx = (row * CUDA_CHUNK_K + k).reshape(-1)
+    swg = torch.arange(2, device=device).view(2, 1, 1, 1, 1)
+    swarp = torch.arange(4, device=device).view(1, 4, 1, 1, 1)
+    sg = torch.arange(8, device=device).view(1, 1, 8, 1, 1)
+    sstep = torch.arange(4, device=device).view(1, 1, 1, 4, 1)
+    sh = torch.arange(2, device=device).view(1, 1, 1, 1, 2)
+    srow = swg * 64 + swarp * 16 + sg + 8 * sh
+    scale_idx = (srow * (CUDA_CHUNK_K // nvfp4.BLOCK) + sstep).reshape(-1)
+    assert torch.equal(code_idx.sort().values, torch.arange(CUDA_CODE_BYTES * 2, device=device)), "code map is not a permutation"
+    assert torch.equal(scale_idx.sort().values, torch.arange(CUDA_SCALE_BYTES, device=device)), "scale map is not a permutation"
+    return code_idx, scale_idx
+
