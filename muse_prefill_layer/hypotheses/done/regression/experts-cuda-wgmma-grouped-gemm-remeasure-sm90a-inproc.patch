+# --- CUDA sm_90a mixed-input grouped GEMM (hypothesis experts-cuda-wgmma-mixed-input-grouped-gemm, stage 1;
+# ported onto master as experts-cuda-wgmma-grouped-gemm-remeasure-sm90a-inproc: sm_90a-only build, guarded
+# wgmma, in-process canary, master's 32-local-expert align and its w2 zero-store flag) ---
+# Above MARLIN_MAX_TOKENS (the first turn) both expert GEMMs run a hand-written Hopper kernel in place of
+# _moe_nvfp4_gemm_kernel, with the same contract as _nvfp4_moe_gemm (out[sorted id] = a[sorted id // top_k] @
+# dequant(w[block expert]).T, -1 blocks zero-stored only when asked, blocks past n_padded untouched).
+#   * Persistent: one CTA per SM, 288 threads. Warps 0-3 and 4-7 are two COOPERATIVE consumer warpgroups:
+#     both read the same 256-token activation tile and take rows 0-63 / 64-127 of a 128-row weight tile
+#     (wgmma m64n256k16 each, fp32 accumulators in registers). Warp 8 is the producer.
+#   * Work item = (256-token block, 128-row weight tile); the order is a static function of the item index
+#     computed on the device (master's GROUP_SIZE_T grouping, token blocks fastest), bounded by the device
+#     n_padded. Items whose block expert is -1 never touch the pipeline.
+#   * Weights: prepare() lays every (expert, 128-row tile, 64-k chunk) block out contiguously, 4096 code bytes
+#     in each consumer thread's wgmma A-fragment order (16 bytes = its 32 nibbles) then 512 e4m3 scale bytes
+#     (8 per 4-thread quad), and the producer fetches it with ONE 1-D cp.async.bulk (4608 B, mbarrier tx).
+#     Activation rows are gathered by cp.async 16 B (zero-fill for padding slots) into the canonical
+#     128B-swizzled K-major wgmma B layout. 5 stages, full / empty mbarriers.
+#   * Consumers: per 64-k chunk one LDS.128 of codes and one LDS.64 of scales per thread, E2M1 -> BF16 by
+#     master's bit placement (E2M1 * 2^-126), times the e4m3 block scale * 2^119 by fma.rn.bf16x2 (no ftz:
+#     the +-0.5 codes are bf16 subnormals; no fast-math anywhere in this build), then 4 RS wgmma
+#     (A = the dequantized registers). Double-buffered A fragments: chunk c is dequantized and issued while
+#     chunk c-1's wgmma group is in flight, and a buffer is rewritten only after wgmma.wait_group 1 has
+#     retired the group that read it. Epilogue: acc * global scale * 2^7 -> bf16, stored by sorted id.
+#   * Every mbarrier wait is bounded (~2 s of clock64); a timeout sets an error bit that prepare()'s
+#     self-check reads, and the CTA drains instead of hanging the run.
+CUDA_BLOCK_T = 256        # token tile (wgmma N); moe_align_block_size pads to it, as the Triton config does
+CUDA_TILE_N = 128         # weight rows per work item (64 per consumer warpgroup)
+CUDA_CHUNK_K = 64         # k per pipeline stage (4 wgmma k16 steps)
+CUDA_CODE_BYTES = CUDA_TILE_N * CUDA_CHUNK_K // 2       # 4096
+CUDA_SCALE_BYTES = CUDA_TILE_N * CUDA_CHUNK_K // 16     # 512
+CUDA_WBLK_BYTES = CUDA_CODE_BYTES + CUDA_SCALE_BYTES    # 4608
+
+_WGMMA_SRC = (
+    "__device__ __forceinline__ void wgmma_m64n256k16_rs(float (&d)[128], uint32_t a0, uint32_t a1,\n"
+    "                                                    uint32_t a2, uint32_t a3, uint64_t desc) {\n"
+    "#if defined(__CUDA_ARCH_FEAT_SM90_ALL)\n"
+    "  asm volatile(\n"
+    "    \"{\\n\"\n"
+    "    \".reg .pred p;\\n\"\n"
+    "    \"setp.ne.b32 p, %133, 0;\\n\"\n"
+    "    \"wgmma.mma_async.sync.aligned.m64n256k16.f32.bf16.bf16 \"\n"
+    "    \"{" + ", ".join(f"%{i}" for i in range(128)) + "}, \"\n"
+    "    \"{%128, %129, %130, %131}, \"\n"
+    "    \"%132, p, 1, 1, 0;\\n\"\n"
+    "    \"}\\n\"\n"
+    "    : " + ", ".join(f"\"+f\"(d[{i}])" for i in range(128)) + "\n"
+    "    : \"r\"(a0), \"r\"(a1), \"r\"(a2), \"r\"(a3), \"l\"(desc), \"r\"(1)\n"
+    "    : \"memory\");\n"
+    "#endif\n"
+    "}\n"
+)
