+_CUDA_EXPERTS_CPP = r"""
+#include <torch/extension.h>
+#include <vector>
+void nvfp4_wgmma_gemm(torch::Tensor a, torch::Tensor wblk, torch::Tensor gs, torch::Tensor out,
+                      torch::Tensor sorted_ids, torch::Tensor expert_ids, torch::Tensor n_padded, torch::Tensor err,
+                      int64_t top_k, int64_t num_valid, int64_t zero_nonlocal, int64_t grid);
