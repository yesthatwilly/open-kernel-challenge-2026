+_CUDA_EXPERTS_CUDA = r"""
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAException.h>
+#include <cuda_runtime.h>
+#include <stdint.h>
+#include <vector>
+
+#define TILE_N 128
+#define TILE_T 256
+#define CHUNK_K 64
+#define STAGES 5
+#define B_BYTES (TILE_T * CHUNK_K * 2)          /* 32768: [256 tokens][64 k] bf16, 128B-swizzled */
+#define CODE_BYTES (TILE_N * CHUNK_K / 2)       /* 4096 */
+#define SCALE_BYTES (TILE_N * CHUNK_K / 16)     /* 512 */
+#define WBLK_BYTES (CODE_BYTES + SCALE_BYTES)   /* 4608 */
+#define STAGE_BYTES 37888                       /* B + weights, rounded up to 1024 (swizzle atom alignment) */
+#define BAR_OFFSET (STAGES * STAGE_BYTES)
+#define SMEM_BYTES (BAR_OFFSET + 128 + 1024)    /* + barriers/abort flag + alignment slack */
+#define GROUP_T 4
+#define N_THREADS 288
+#define PRODUCER_WARP 8
+#define FULL_COUNT 33                           /* 32 producer lanes (cp.async noinc) + 1 expect_tx arrive */
+#define EMPTY_COUNT 8                           /* one arrive per consumer warp */
+#define WAIT_TIMEOUT_CYCLES 4000000000ll
+
+static_assert(STAGE_BYTES >= B_BYTES + WBLK_BYTES, "stage too small");
+static_assert(STAGE_BYTES % 1024 == 0, "stage must keep the 1024 B swizzle alignment");
+static_assert(SMEM_BYTES <= 232448, "over the 227 KB dynamic shared memory limit");
+
+__device__ __forceinline__ uint32_t smem_u32(const void* p) {
+  return static_cast<uint32_t>(__cvta_generic_to_shared(p));
+}
+__device__ __forceinline__ void mbar_init(uint32_t bar, uint32_t count) {
+  asm volatile("mbarrier.init.shared::cta.b64 [%0], %1;" :: "r"(bar), "r"(count) : "memory");
+}
+__device__ __forceinline__ bool mbar_try_wait(uint32_t bar, uint32_t parity) {
+  uint32_t ok;
+  asm volatile(
+      "{\n"
+      ".reg .pred p;\n"
+      "mbarrier.try_wait.parity.shared::cta.b64 p, [%1], %2;\n"
+      "selp.u32 %0, 1, 0, p;\n"
+      "}\n"
+      : "=r"(ok) : "r"(bar), "r"(parity) : "memory");
+  return ok != 0;
+}
+// Bounded wait: false after a timeout (error bit set, abort flag raised) or once another role aborted.
+__device__ __forceinline__ bool mbar_wait(uint32_t bar, uint32_t parity, volatile int* abort_flag, int* err, int code) {
+  if (mbar_try_wait(bar, parity)) return true;
+  const long long t0 = clock64();
+  while (true) {
+    if (mbar_try_wait(bar, parity)) return true;
+    if (*abort_flag) return false;
+    if (clock64() - t0 > WAIT_TIMEOUT_CYCLES) {
+      *abort_flag = 1;
+      atomicOr(err, code);
+      return false;
+    }
+  }
+}
+__device__ __forceinline__ void mbar_arrive(uint32_t bar) {
+  asm volatile(
+      "{\n"
+      ".reg .b64 state;\n"
+      "mbarrier.arrive.shared::cta.b64 state, [%0];\n"
+      "}\n"
+      :: "r"(bar) : "memory");
+}
+__device__ __forceinline__ void mbar_arrive_expect_tx(uint32_t bar, uint32_t bytes) {
+  asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;" :: "r"(bar), "r"(bytes) : "memory");
+}
+__device__ __forceinline__ void bulk_g2s(uint32_t dst, const void* src, uint32_t bytes, uint32_t bar) {
+  asm volatile("cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1], %2, [%3];"
+               :: "r"(dst), "l"(src), "r"(bytes), "r"(bar) : "memory");
+}
+__device__ __forceinline__ void cp_async16(uint32_t dst, const void* src, uint32_t src_bytes) {
+  asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;" :: "r"(dst), "l"(src), "r"(src_bytes) : "memory");
+}
+__device__ __forceinline__ void cp_async_arrive_noinc(uint32_t bar) {
+  asm volatile("cp.async.mbarrier.arrive.noinc.shared::cta.b64 [%0];" :: "r"(bar) : "memory");
+}
+__device__ __forceinline__ void fence_proxy_async() {
+  asm volatile("fence.proxy.async.shared::cta;" ::: "memory");
+}
+__device__ __forceinline__ uint4 lds128(uint32_t addr) {
+  uint4 v;
+  asm volatile("ld.shared.v4.u32 {%0, %1, %2, %3}, [%4];" : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w) : "r"(addr));
+  return v;
+}
+__device__ __forceinline__ uint2 lds64(uint32_t addr) {
+  uint2 v;
+  asm volatile("ld.shared.v2.u32 {%0, %1}, [%2];" : "=r"(v.x), "=r"(v.y) : "r"(addr));
+  return v;
+}
+// sm_90a-only PTX (wgmma) sits under __CUDA_ARCH_FEAT_SM90_ALL: a stray plain compute_90 pass still compiles,
+// and its kernel only raises error bit 4 (see _nvfp4_wgmma_grouped_kernel), which the self-check reads.
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+__device__ __forceinline__ void wg_fence() { asm volatile("wgmma.fence.sync.aligned;" ::: "memory"); }
+__device__ __forceinline__ void wg_commit() { asm volatile("wgmma.commit_group.sync.aligned;" ::: "memory"); }
+template <int N>
+__device__ __forceinline__ void wg_wait() { asm volatile("wgmma.wait_group.sync.aligned %0;" :: "n"(N) : "memory"); }
+#else
+__device__ __forceinline__ void wg_fence() {}
+__device__ __forceinline__ void wg_commit() {}
+template <int N>
+__device__ __forceinline__ void wg_wait() {}
+#endif
+__device__ __forceinline__ void fence_acc(float (&d)[128]) {
+#pragma unroll
+  for (int i = 0; i < 128; ++i) asm volatile("" : "+f"(d[i]) :: "memory");
+}
+__device__ __forceinline__ void fence_a(uint32_t (&a)[16]) {
+#pragma unroll
+  for (int i = 0; i < 16; ++i) asm volatile("" : "+r"(a[i]) :: "memory");
+}
+
+@@WGMMA@@
+
+// E2M1 codes at bits 0-3 (low half) and 16-19 (high half) -> two BF16 = E2M1 * 2^-126 (master's placement:
+// magnitude bits to bf16 bits 8..6, sign to 15; e = 0 codes are bf16 subnormals).
+__device__ __forceinline__ uint32_t e2m1_pair(uint32_t x) {
+  return ((x & 0x00070007u) << 6) | ((x & 0x00080008u) << 12);
+}
+// a * b exactly (both factors carry <= 4 significant bits), subnormals kept: plain fma.rn, no .ftz.
+__device__ __forceinline__ uint32_t bf16x2_mul(uint32_t a, uint32_t b) {
+  uint32_t d;
+  asm("fma.rn.bf16x2 %0, %1, %2, %3;" : "=r"(d) : "r"(a), "r"(b), "r"(0x80008000u));
+  return d;
+}
+// e4m3 byte -> (scale * 2^119) as BF16 in both halves. Exact: 4 significant bits; 448 * 2^119 < bf16 max.
+__device__ __forceinline__ uint32_t scale_pair(uint32_t byte) {
+  const uint32_t e = (byte >> 3) & 0xFu, m = byte & 7u;
+  const float sub = static_cast<float>(m) * __uint_as_float((110u + 127u) << 23);   // m * 2^-9 * 2^119
+  uint32_t bits = e ? (((e + 239u) << 23) | (m << 20)) : __float_as_uint(sub);     // 2^(e-7)(1+m/8) * 2^119
+  bits = (bits >> 16) | ((byte & 0x80u) << 8);
+  return bits | (bits << 16);
+}
+// One thread's A fragments for one 64-k chunk (4 k16 steps x 4 registers) from its 16 code bytes and its
+// quad's 8 scale bytes. Word s = k16 step s; register j of step s holds nibbles j (low) and j + 4 (high):
+// j = 0: row r, k 2t,2t+1; j = 1: row r+8, same k; j = 2: row r, k 2t+8,2t+9; j = 3: row r+8, same k.
+// Scale byte 2s + h = row r + 8h, step s.
+__device__ __forceinline__ void dequant_chunk(uint32_t (&A)[16], uint4 q, uint2 sc) {
+  const uint32_t w[4] = {q.x, q.y, q.z, q.w};
+  const uint32_t sw[2] = {sc.x, sc.y};
+#pragma unroll
+  for (int s = 0; s < 4; ++s) {
+    const uint32_t word = sw[s >> 1] >> ((s & 1) * 16);
+    const uint32_t s_lo = scale_pair(word & 0xFFu);
+    const uint32_t s_hi = scale_pair((word >> 8) & 0xFFu);
+    A[4 * s + 0] = bf16x2_mul(e2m1_pair(w[s]), s_lo);
+    A[4 * s + 1] = bf16x2_mul(e2m1_pair(w[s] >> 4), s_hi);
+    A[4 * s + 2] = bf16x2_mul(e2m1_pair(w[s] >> 8), s_lo);
+    A[4 * s + 3] = bf16x2_mul(e2m1_pair(w[s] >> 12), s_hi);
+  }
+}
+__device__ __forceinline__ uint16_t f32_to_bf16(float x) {
+  uint16_t h;
+  asm("cvt.rn.bf16.f32 %0, %1;" : "=h"(h) : "f"(x));
+  return h;
+}
+// Static work order (master's GROUP_SIZE_T grouping): token blocks fastest within a group of GROUP_T, so
+// neighbouring CTAs share a weight tile through L2.
+__device__ __forceinline__ void item_coords(int item, int num_t, int nt, int& pid_t, int& pid_w) {
+  const int per_group = GROUP_T * nt;
+  const int group = item / per_group;
+  const int first_t = group * GROUP_T;
+  const int gsz = min(num_t - first_t, GROUP_T);
+  const int r = item - group * per_group;
+  pid_t = first_t + r % gsz;
+  pid_w = r / gsz;
+}
+
+// Wait for a stage, dequantize this thread's fragments into A, issue the chunk's 4 wgmma and commit.
+__device__ __forceinline__ bool issue_chunk(float (&acc)[128], uint32_t (&A)[16], uint32_t base, int stage,
+                                            uint32_t phase, uint32_t bar_full, int wg, int wtid,
+                                            volatile int* abort_flag, int* err) {
+  if (!mbar_wait(bar_full + 8 * stage, phase, abort_flag, err, 1)) return false;
+  fence_proxy_async();  // cp.async (generic proxy) writes -> wgmma (async proxy) reads
+  const uint32_t sb = base + stage * STAGE_BYTES;
+  const uint4 q = lds128(sb + B_BYTES + wg * (CODE_BYTES / 2) + wtid * 16);
+  const uint2 sc = lds64(sb + B_BYTES + CODE_BYTES + wg * (SCALE_BYTES / 2) + (wtid >> 2) * 8);
+  dequant_chunk(A, q, sc);
+  // K-major B, 128B swizzle: start address >> 4, LBO 1 (unused), SBO 1024 B (8-row groups), layout 1 (B128).
+  const uint64_t desc = (static_cast<uint64_t>(1024 >> 4) << 32) | (1ull << 62) | (1ull << 16) |
+                        static_cast<uint64_t>((sb >> 4) & 0x3FFFu);
+  wg_fence();
+  wgmma_m64n256k16_rs(acc, A[0], A[1], A[2], A[3], desc);
+  wgmma_m64n256k16_rs(acc, A[4], A[5], A[6], A[7], desc + 2);     // + 32 B = k + 16
+  wgmma_m64n256k16_rs(acc, A[8], A[9], A[10], A[11], desc + 4);
+  wgmma_m64n256k16_rs(acc, A[12], A[13], A[14], A[15], desc + 6);
+  wg_commit();
+  return true;
+}
+__device__ __forceinline__ void release_stage(uint32_t bar_empty, int stage, int lane) {
+  __syncwarp();
+  if (lane == 0) mbar_arrive(bar_empty + 8 * stage);
+}
+__device__ __forceinline__ void advance(int& stage, uint32_t& phase) {
+  if (++stage == STAGES) { stage = 0; phase ^= 1u; }
+}
+
+// extern "C": the profile row reads the bare name _nvfp4_wgmma_grouped_kernel (no C++ mangling).
+extern "C" __global__ void __launch_bounds__(N_THREADS, 1)
+_nvfp4_wgmma_grouped_kernel(const uint16_t* __restrict__ a, const uint8_t* __restrict__ wblk,
+                            const float* __restrict__ gsv, uint16_t* __restrict__ out,
+                            const int* __restrict__ sorted_ids, const int* __restrict__ expert_ids,
+                            const int* __restrict__ n_padded_ptr, int* __restrict__ err,
+                            int N, int K, int top_k, int num_valid, int em_blocks, int zero_nonlocal) {
+#if !defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  // Not the sm_90a image: no wgmma here. Flag it (bit 4) and do nothing; prepare() turns the path OFF.
+  if (threadIdx.x == 0 && blockIdx.x == 0) atomicOr(err, 4);
+#else
+  extern __shared__ uint8_t smem_raw[];
+  const uint32_t raw = smem_u32(smem_raw);
+  const uint32_t base = (raw + 1023u) & ~1023u;
+  uint8_t* base_ptr = smem_raw + (base - raw);
+  const uint32_t bar_full = base + BAR_OFFSET;
+  const uint32_t bar_empty = base + BAR_OFFSET + 8 * STAGES;
+  volatile int* abort_flag = reinterpret_cast<volatile int*>(base_ptr + BAR_OFFSET + 16 * STAGES);
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  if (tid == 0) {
+    for (int s = 0; s < STAGES; ++s) {
+      mbar_init(bar_full + 8 * s, FULL_COUNT);
+      mbar_init(bar_empty + 8 * s, EMPTY_COUNT);
+    }
+    *abort_flag = 0;
+    asm volatile("fence.mbarrier_init.release.cluster;" ::: "memory");
+  }
+  __syncthreads();
+
+  const int nt = N / TILE_N, kc = K / CHUNK_K;
+  int num_t = n_padded_ptr[0] / TILE_T;
+  num_t = max(0, min(num_t, em_blocks));
+  const int total = num_t * nt;
+
+  if (warp == PRODUCER_WARP) {
+    int stage = 0;
+    uint32_t phase = 0;
+    const int j = lane & 7;
+    for (int item = blockIdx.x; item < total; item += gridDim.x) {
+      int pid_t, pid_w;
+      item_coords(item, num_t, nt, pid_t, pid_w);
+      const int e = expert_ids[pid_t];
+      if (e < 0) continue;  // consumers skip the pipeline for this item too
+      int src_row[TILE_T / 4];
+#pragma unroll
+      for (int i = 0; i < TILE_T / 4; ++i) {
+        const int slot = sorted_ids[pid_t * TILE_T + (lane >> 3) + 4 * i];
+        src_row[i] = slot < num_valid ? slot / top_k : -1;
+      }
+      const uint8_t* wsrc = wblk + (static_cast<size_t>(e) * nt + pid_w) * static_cast<size_t>(kc) * WBLK_BYTES;
+#pragma unroll 1
+      for (int c = 0; c < kc; ++c) {
+        if (!mbar_wait(bar_empty + 8 * stage, phase ^ 1u, abort_flag, err, 2)) return;
+        const uint32_t sb = base + stage * STAGE_BYTES;
+        if (lane == 0) {
+          mbar_arrive_expect_tx(bar_full + 8 * stage, WBLK_BYTES);
+          bulk_g2s(sb + B_BYTES, wsrc + static_cast<size_t>(c) * WBLK_BYTES, WBLK_BYTES, bar_full + 8 * stage);
+        }
+#pragma unroll
+        for (int i = 0; i < TILE_T / 4; ++i) {
+          const int n = (lane >> 3) + 4 * i;   // token row of the tile; 8 lanes cover its 128 B
+          const int r = src_row[i];
+          const uint16_t* src = a + static_cast<size_t>(r < 0 ? 0 : r) * K + c * CHUNK_K + j * 8;
+          cp_async16(sb + n * 128 + ((j ^ (n & 7)) << 4), src, r < 0 ? 0u : 16u);
+        }
+        cp_async_arrive_noinc(bar_full + 8 * stage);
+        advance(stage, phase);
+      }
+    }
+    // drain before exiting: pending cp.async noinc arrivals must not depend on a live thread
+    asm volatile("cp.async.wait_all;" ::: "memory");
+    return;
+  }
+
+  // Consumers: warpgroup wg takes weight rows wg*64 .. wg*64+63 of the item's 128-row tile.
+  const int wg = warp >> 2, wtid = tid & 127, wwarp = warp & 3;
+  const int g = lane >> 2, t = lane & 3;
+  int stage = 0;
+  uint32_t phase = 0;
+  float acc[128];
+  uint32_t A0[16], A1[16];
+  for (int item = blockIdx.x; item < total; item += gridDim.x) {
+    int pid_t, pid_w;
+    item_coords(item, num_t, nt, pid_t, pid_w);
+    const int e = expert_ids[pid_t];
+    const int t0 = pid_t * TILE_T;
+    const int row = pid_w * TILE_N + wg * 64 + wwarp * 16 + g;   // accumulator rows row and row + 8
+    if (e < 0) {
