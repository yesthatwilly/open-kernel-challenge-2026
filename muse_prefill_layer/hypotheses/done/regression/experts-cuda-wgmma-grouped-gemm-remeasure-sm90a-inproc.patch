+def _cuda_bank(weights):
+    """The local experts for the CUDA kernel: uint8 [E, N/128, K/64, 4608] per GEMM, codes and e4m3 scales
+    permuted losslessly (new tensors; the weights are untouched). Global scales are the Triton bank's."""
+    device = weights["w13"].device
+    code_idx, scale_idx = _cuda_fragment_maps(device)
+    bank = {}
+    for name in ("w13", "w2"):
+        w, sf = weights[name], weights[name + "_sf"]
+        e, n, kh = w.shape
+        assert n % CUDA_TILE_N == 0 and (kh * 2) % (2 * CUDA_CHUNK_K) == 0 and sf.shape == (e, n, kh * 2 // nvfp4.BLOCK)
