+def _build_cuda_experts():
+    """Compile the CUDA expert GEMM in prepare() (never during capture). No fast-math: the bf16 dequant
+    relies on subnormals. Returns (ext, error, arch flags nvcc received); any failure keeps master's path."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    cflags = ["-O3", "-lineinfo"]
+    try:
+        from torch.utils import cpp_extension
+        os.environ["TORCH_CUDA_ARCH_LIST"] = CUDA_ARCH_LIST
+        torch_arch = list(cpp_extension._get_cuda_arch_flags())  # raises if this torch rejects 9.0a: OFF
+        stray = [f for f in torch_arch if "90a" not in f]
+        if stray or not torch_arch:
+            cflags.append(CUDA_GENCODE)
+        print(f"[cuda expert gemm] build: TORCH_CUDA_ARCH_LIST={os.environ['TORCH_CUDA_ARCH_LIST']} torch arch flags "
+              f"{torch_arch} extra_cuda_cflags {cflags}"
