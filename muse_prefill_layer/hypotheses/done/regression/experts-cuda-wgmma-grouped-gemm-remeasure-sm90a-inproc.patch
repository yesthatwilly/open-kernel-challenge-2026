+def _cuda_bank_one(packed, sf, code_idx, scale_idx):
+    """Lossless repack of one expert's uint8 [N, K/2] E2M1 codes (element 2i low nibble) and e4m3 [N, K/16]
+    scales into uint8 [N/128, K/64, 4608] blocks, then the exact inverse, asserted to give back both."""
+    n, kh = packed.shape
+    k = kh * 2
+    nt, kc = n // CUDA_TILE_N, k // CUDA_CHUNK_K
+    codes = torch.stack((packed & 0x0F, packed >> 4), dim=-1).reshape(n, k)
+    blocks = codes.reshape(nt, CUDA_TILE_N, kc, CUDA_CHUNK_K).permute(0, 2, 1, 3).reshape(nt, kc, -1)
+    nibs = blocks[:, :, code_idx]
+    code_bytes = nibs[..., 0::2] | (nibs[..., 1::2] << 4)
+    sf8 = sf.view(torch.uint8)
+    groups = CUDA_CHUNK_K // nvfp4.BLOCK
+    sblocks = sf8.reshape(nt, CUDA_TILE_N, kc, groups).permute(0, 2, 1, 3).reshape(nt, kc, -1)
+    out = torch.cat((code_bytes, sblocks[:, :, scale_idx]), dim=-1).contiguous()
+    # The exact inverse.
+    cb = out[..., :CUDA_CODE_BYTES]
+    nibs2 = torch.stack((cb & 0x0F, cb >> 4), dim=-1).reshape(nt, kc, -1)
+    blocks2 = torch.empty_like(nibs2)
+    blocks2[:, :, code_idx] = nibs2
+    codes2 = blocks2.reshape(nt, kc, CUDA_TILE_N, CUDA_CHUNK_K).permute(0, 2, 1, 3).reshape(n, k)
+    assert torch.equal(codes2[:, 0::2] | (codes2[:, 1::2] << 4), packed), "CUDA code permutation does not invert"
+    s2 = torch.empty_like(sblocks)
+    s2[:, :, scale_idx] = out[..., CUDA_CODE_BYTES:]
+    s2 = s2.reshape(nt, kc, CUDA_TILE_N, groups).permute(0, 2, 1, 3).reshape(n, k // nvfp4.BLOCK)
+    assert torch.equal(s2, sf8), "CUDA scale permutation does not invert"
+    return out
