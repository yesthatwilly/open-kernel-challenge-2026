+              f"local experts)", flush=True)
+    else:
+        state.pop("cuda_bank", None)
+        print(f"[cuda expert gemm] OFF: {reason}", flush=True)
+    CUDA_EXPERTS_OK = reason is None
+    torch.cuda.empty_cache()
+    return reason is None
