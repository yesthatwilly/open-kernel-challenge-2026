+    reason = None
+    cap = torch.cuda.get_device_capability(device)
+    print(f"[cuda expert gemm] device capability {cap}", flush=True)
+    if cap != (9, 0):
+        reason = f"needs sm_90 (H100/H200), device is {cap}"
+    else:
+        ext, build_error, seen = _build_cuda_experts()
+        if ext is None:
+            reason = build_error or "build failed"
+        else:
+            arch = [f for f in seen if not f.startswith("<")]
+            if any("90a" not in f for f in arch):
+                reason = f"nvcc arch flags are not sm_90a only: {seen}"
+            else:
+                _CUDA_EXT = ext
+    if reason is None:
+        try:
+            t0 = time.perf_counter()
+            state["cuda_err"] = torch.zeros(1, dtype=torch.int32, device=device)
+            state["cuda_grid"] = torch.cuda.get_device_properties(device).multi_processor_count
+            attrs = list(_CUDA_EXT.nvfp4_wgmma_attrs())
+            # Diagnostic only (binaryVersion / ptxVersion read 90 for sm_90 and sm_90a alike); the canary's
+            # error word (bit 4) is what proves the sm_90a image is the one that runs.
+            print(f"[cuda expert gemm] kernel _nvfp4_wgmma_grouped_kernel: regs={attrs[0]} local_bytes={attrs[1]} "
+                  f"static_smem={attrs[2]} max_threads={attrs[3]} dyn_smem={attrs[4]} ptx={attrs[5]} sass={attrs[6]} "
+                  f"ctas_per_sm={attrs[7]} grid={state['cuda_grid']}", flush=True)
+            assert attrs[6] == 90, f"kernel binary version {attrs[6]}, not 90"
+            assert attrs[7] >= 1, "kernel cannot be resident (occupancy 0)"
+            assert attrs[3] >= 288, f"max threads per block {attrs[3]} < 288 (registers)"
+            state["cuda_bank"] = _cuda_bank(weights)
+            torch.cuda.synchronize()
+            print(f"[cuda expert gemm] bank built and inverted exactly in {time.perf_counter() - t0:.1f}s", flush=True)
+            _check_cuda_canary(state)
+            _check_cuda_onehot(state, weights)
+            _check_cuda_e2e(state, device)
