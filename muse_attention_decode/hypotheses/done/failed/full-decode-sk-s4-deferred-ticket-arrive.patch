+def _sk_two_state_replay(gen, lens, kv_scale, tag):
+    """The judge's pattern for whatever route kernel_fn currently takes at len(lens): two prepared
+    states, one CUDA graph captured on each, replays alternated between them with refilled inputs
+    (refill A, replay A, refill B, replay B, ...), each output compared with an FP32 reference.
+    Returns None on success, else the failing round."""
+    dev = torch.device("cuda")
+    states = [_splitkv_synthetic(lens, kv_scale, gen, dev) for _ in range(2)]
+    graphs, outs = [], []
+    for i, st in enumerate(states):
+        _say(f"[sk4] {tag}: state {i} eager warm-up of kernel_fn on a side stream")
+        side = torch.cuda.Stream()
+        side.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(side):
+            kernel_fn(st)
+        torch.cuda.current_stream().wait_stream(side)
+        torch.cuda.synchronize()
+        _say(f"[sk4] {tag}: state {i} capturing kernel_fn")
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            o = kernel_fn(st)
+        torch.cuda.synchronize()
+        graphs.append(graph)
+        outs.append(o)
+    for rnd in range(4):
+        i = rnd & 1
+        fresh = _splitkv_synthetic(lens, kv_scale, gen, dev)
+        for key in ("qkv", "k_cache", "v_cache", "page_table", "cache_loc"):
+            states[i][key].copy_(fresh[key])
+        outs[i].fill_(float("nan"))
+        _say(f"[sk4] {tag}: round {rnd}: launching state {i} graph")
+        graphs[i].replay()
+        torch.cuda.synchronize()
+        err, finite = _rel_l2(outs[i], _splitkv_reference(states[i], lens))
+        ok = finite and err < 2e-2
+        _say(f"[sk4] {tag}: round {rnd} state {i}: rel L2 {err:.2e}, finite {finite} -> {'ok' if ok else 'FAIL'}")
+        if not ok:
+            return f"two-state replay {tag} round {rnd}"
+    del graphs
+    return None
+
