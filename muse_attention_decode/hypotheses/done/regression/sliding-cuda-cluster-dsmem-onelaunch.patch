+def _slide_self_check(ext, length: int, c16: bool, tag: str) -> bool:
+    """One-time eager check at import, on synthetic data only (never in the timed path): the
+    gated path for q_len `length` against the FP32 reference (B 1, 3, 5; seq 10, 17, 2046, 2047,
+    2048, 2049, 3000, 5000; window-edge keys; kv scale 1 and 1/64), its new cache rows against
+    master _pre_attention_kernel on cloned caches, and one CUDA-graph capture + replay."""
+    _SLIDE_MOD[length], _SLIDE_C16[length] = ext, c16
+    gen = torch.Generator(device="cuda").manual_seed(4321 + length)
+    dev = torch.device("cuda")
+    ok = True
+    try:
+        data = None
+        for lens, kv_scale in (([2049], 1.0), ([10, 2046, 5000], 1 / 64), ([2047, 2049, 17, 3000, 2048], 1.0),
+                               ([5000], 1 / 64)):
+            data = _slide_synthetic(lens, length, kv_scale, gen, dev)
+            cfg = data["config"]
+            assert _slide_gate(cfg)
+            tokens = cfg["batch"] * length
+            k_ref, v_ref = data["k_cache"].clone(), data["v_cache"].clone()
+            qkv2 = data["qkv"].reshape(tokens, -1)
+            _pre_attention_kernel[(tokens, 18)](
+                qkv2, data["positions"], data["cache_loc"], _inv_freq(cfg["rope_theta"], 64, dev),
+                data["k_scale"], data["v_scale"], torch.empty((tokens, 16, 64), dtype=FP8, device=dev),
+                k_ref, v_ref, qkv2.stride(0),
+                HQ=16, HKV=2, D=64, ROPE=True, EPS=RMS_EPS, PAIRED=False, G=8, num_warps=1)
+            out = kernel_fn(data).float()
+            ref = _slide_reference(data, lens)
+            err = float((out - ref).norm() / ref.norm())
+            finite = bool(torch.isfinite(out).all())
+            loc = data["cache_loc"]
+            cache_ok = True
+            notes = []
+            for name, mine, master in (("k", data["k_cache"], k_ref), ("v", data["v_cache"], v_ref)):
+                a = mine.view(-1, 2, 64)[loc]
+                m = master.view(-1, 2, 64)[loc]
+                match = float((a.view(torch.uint8) == m.view(torch.uint8)).float().mean())
+                rel = float((a.float() - m.float()).norm() / m.float().norm().clamp_min(1e-30))
+                notes.append(f"{name} match {match:.4f} rel {rel:.1e}")
+                cache_ok = cache_ok and rel < 5e-2  # master Triton RoPE uses fast sin/cos at ~5000 rad; byte match is info only
+            print(f"[slide] self-check {tag} L={length} B={cfg['batch']} C={_slide_clusters(cfg)} "
+                  f"kv_scale={kv_scale:g}: rel L2 {err:.2e}, finite {finite}, cache {', '.join(notes)}")
+            ok = ok and finite and err < 2e-2 and cache_ok
+        if ok:
+            # The judge replays kernel_fn as a CUDA graph: capture the cluster launch once.
+            eager = kernel_fn(data)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                static = kernel_fn(data)
+            graph.replay()
+            same = bool(torch.equal(static, eager))
+            print(f"[slide] self-check {tag} L={length}: graph capture + replay {'matches' if same else 'DIFFERS'}")
+            ok = ok and same
+            del graph
+    except Exception as e:
+        print(f"[slide] self-check {tag} L={length} raised: {e!r}")
+        ok = False
+    finally:
+        _SLIDE_MOD[length], _SLIDE_C16[length] = None, False
+    return ok
