+def _verify_synthetic(lens, kv_scale, gen, device):
+    """Gated verify inputs (full layer, q_len 8, tp8, page 1). lens are cache_seqlens (seq_lens +
+    8): a request of length 8 has seq_lens 0. Built as reference.generate_input builds them
