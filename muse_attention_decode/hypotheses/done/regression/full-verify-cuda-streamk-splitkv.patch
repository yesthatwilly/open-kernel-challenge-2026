+// [A8 registers, A8 local (spill) bytes, B8 registers, B8 local bytes, A8 dynamic smem], CPU int64.
+torch::Tensor splitkv_verify_attrs() {
+  cudaFuncAttributes a, b;
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&a, splitkv_verify_kernel));
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&b, splitkv_verify_combine_kernel));
+  auto t = torch::empty({5}, torch::dtype(torch::kInt64));
