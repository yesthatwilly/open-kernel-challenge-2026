+def _full_verify_splitkv(data: Inputs, q: torch.Tensor, qkv: torch.Tensor) -> torch.Tensor:
+    """Kernels A8 and B8 on the gated verify path; q is the unpaired FP8 query [B*8, 16, 64]. The
+    grid and workspace come from shapes and the device only: CTA c writes slot c + b for each
+    request b its range touches, so slots never exceed (grid - 1) + (B - 1)."""
+    cfg = data["config"]
