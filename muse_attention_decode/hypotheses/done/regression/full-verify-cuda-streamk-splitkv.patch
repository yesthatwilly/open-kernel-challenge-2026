+def _splitkv_verify_gate(cfg) -> bool:
+    """Config-only predicate for the CUDA stream-K verify path: full layer, q_len 8,
+    1 < batch <= 64, tp8 heads, head dim 64, page 1, and the verify self-check passed."""
+    return (_VEXT is not None and _VERIFY_ON and cfg["window"] == 0 and cfg["q_len"] == 8
+            and 1 < cfg["batch"] <= 64 and cfg["num_q_heads"] == 16 and cfg["num_kv_heads"] == 2
+            and cfg["head_dim"] == 64 and cfg["page_size"] == 1)
