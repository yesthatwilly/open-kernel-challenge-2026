+        print(f"[splitkv-verify] load_inline failed after {time.perf_counter() - t0:.1f}s, verify keeps FA3: {e!r}")
+        return None
+    print(f"[splitkv-verify] load_inline compiled in {time.perf_counter() - t0:.1f}s")
+    return ext
