+__global__ void __launch_bounds__(128)
+splitkv_verify_combine_kernel(const float* __restrict__ ws_acc, const float* __restrict__ ws_ml,
+                              const int* __restrict__ seqlens, int B, int grid,
+                              const float* __restrict__ v_scale,
+                              const __nv_bfloat16* __restrict__ qkv, int64_t qkv_stride,
+                              __nv_bfloat16* __restrict__ out, float eps) {
+  __shared__ int seq_s[MAXB];
+  __shared__ int pre_s[MAXB + 4];
+  __shared__ float red_m[4];
+  __shared__ float red_l[4];
+  __shared__ float red_acc[4][D];
+  const float NEG_INF = __int_as_float(0xff800000u);
+  const int b = blockIdx.x / QL, j = blockIdx.x % QL, h = blockIdx.y;
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  if (tid < B) seq_s[tid] = seqlens[tid];
+  __syncthreads();
+  if (warp == 0) tile_prefix(seq_s, pre_s, B, lane);
+  __syncthreads();
+  const int T = pre_s[B], x0 = pre_s[b], x1 = pre_s[b + 1];  // request b's flat tiles [x0, x1)
+  int c_lo = 0, c_hi = -1;
+  if (x1 > x0) {
+    c_lo = owner_of(x0, T, grid);
+    c_hi = owner_of(x1 - 1, T, grid);
+  }
+  // CTA c wrote slot c + b iff its range [start(c), start(c + 1)) meets [x0, x1).
+  auto covers = [&](int c) {
+    const int lo = max(start_of(c, T, grid), x0), hi = min(start_of(c + 1, T, grid), x1);
+    return lo < hi;
+  };
+  const int row = j * HQ + h;
+
+  float M = NEG_INF;
+  for (int c = c_lo + tid; c <= c_hi; c += 128)
+    if (covers(c)) M = fmaxf(M, ws_ml[static_cast<int64_t>(c + b) * 2 * QL * HQ + row]);
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1) M = fmaxf(M, __shfl_xor_sync(0xffffffffu, M, o));
+  if (lane == 0) red_m[warp] = M;
+  __syncthreads();
+  M = fmaxf(fmaxf(red_m[0], red_m[1]), fmaxf(red_m[2], red_m[3]));
+  const float Mu = M == NEG_INF ? 0.f : M;
+
+  float a0 = 0.f, a1 = 0.f, L = 0.f;
+  for (int c = c_lo + warp; c <= c_hi; c += 4) {
+    if (!covers(c)) continue;  // warp-uniform
+    const int64_t sl = static_cast<int64_t>(c + b);
+    const float m = ws_ml[sl * 2 * QL * HQ + row];
+    const float wt = m == NEG_INF ? 0.f : ex2(m - Mu);  // rows with no valid key here weigh 0
+    L += wt * ws_ml[sl * 2 * QL * HQ + QL * HQ + row];
+    const float2 a = *reinterpret_cast<const float2*>(ws_acc + (sl * QL * HQ + row) * D + lane * 2);
+    a0 += wt * a.x;
+    a1 += wt * a.y;
+  }
+  red_acc[warp][lane * 2] = a0;
+  red_acc[warp][lane * 2 + 1] = a1;
+  if (lane == 0) red_l[warp] = L;
+  __syncthreads();
+  if (warp == 0) {
+    float o0 = 0.f, o1 = 0.f, Ls = 0.f;
+#pragma unroll
+    for (int w = 0; w < 4; ++w) { o0 += red_acc[w][lane * 2]; o1 += red_acc[w][lane * 2 + 1]; Ls += red_l[w]; }
+    const float f = Ls > 0.f ? __ldg(v_scale) / Ls : 0.f;  // every row has key 0, so Ls > 0
+    o0 *= f;
+    o1 *= f;
+    float ss = o0 * o0 + o1 * o1;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+    const float r = 1.f / sqrtf(ss / D + eps);
+    const int64_t tok = static_cast<int64_t>(b) * QL + j;
+    const __nv_bfloat16* gp = qkv + tok * qkv_stride + (HQ + 2 * HKV) * D + h * D + lane * 2;
+    const float g0 = __bfloat162float(gp[0]), g1 = __bfloat162float(gp[1]);
+    const float y0 = o0 * r / (1.f + expf(-g0));
+    const float y1 = o1 * r / (1.f + expf(-g1));
+    *reinterpret_cast<__nv_bfloat162*>(out + (tok * HQ + h) * D + lane * 2) = __floats2bfloat162_rn(y0, y1);
+  }
+}
