+@triton.jit
+def _window_trim_kernel(
+    page_table_ptr, seqlens_ptr, pt_win_ptr, len_win_ptr,
+    pt_stride, max_pages,
+    W: tl.constexpr, P: tl.constexpr, NP: tl.constexpr, BLOCK: tl.constexpr,
+):
+    """One program per request: the NP pages that hold the union of the block's sliding windows,
+    starting at the page boundary at or before len - W, and the length measured from there."""
+    b = tl.program_id(0)
+    n = tl.load(seqlens_ptr + b)
+    first_page = tl.maximum(n - W, 0) // P
+    i = tl.arange(0, BLOCK)
+    src = first_page + i
+    pages = tl.load(page_table_ptr + b.to(tl.int64) * pt_stride + src,
+                    mask=(i < NP) & (src < max_pages), other=-1)
+    tl.store(pt_win_ptr + b * NP + i, pages, mask=i < NP)
+    tl.store(len_win_ptr + b, n - first_page * P)
+
