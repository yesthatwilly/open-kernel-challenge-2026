+# --- GATE B: the tiled first node per class -------------------------------------------------------------------
+
+def _nb_gate_b(cls: str, gen, flush, c320_on: bool, routable: bool, exact: bool) -> bool:
+    """Time the whole step kernel_fn would run for the class at its batch x 80000 with master's first node and
+    with the tiled one (the downstream held fixed), plus both first nodes alone: interleaved cold-L2 graph
+    replays, empty graph subtracted, median of 41. True if exact and tiled step / master step <= 0.98."""
+    batch = _NB_BATCH[cls[2:]]
+    data = _nb_synth(cls, [80000] * batch, 1.0, gen)
+    cfg = data["config"]
+    if cls[:2] == "FD" and _splitkv_gate(cfg) and _fused_gate(cfg):
+        _say(f"[nb-gateB] {cls}: FUSED_PRE is routed here (no separate first node): n/a")
+        return False
+    tokens = batch * cfg["q_len"]
+    qkv = data["qkv"].reshape(tokens, -1)
+    paired = _nb_paired(cfg)
+    qb = torch.empty((tokens, 16, 128 if paired else 64), dtype=FP8, device=qkv.device)
+    fns = {"step_m": (lambda: _nb_step(data, False, c320_on)), "step_t": (lambda: _nb_step(data, True, c320_on)),
+           "pre_m": (lambda: _nb_pre(data, qkv, qb, tokens, paired, False)),
+           "pre_t": (lambda: _nb_pre(data, qkv, qb, tokens, paired, True))}
+    _say(f"[nb-gateB] {cls}: B={batch} x 80000, {tokens} tokens: timing the step with each first node "
+         f"(interleaved, cold L2, median of 41)")
+    t = _sd_interleaved(fns, flush, reps=41)
+    b = t["empty"]
+    sm, st = max(t["step_m"] - b, 0.5), max(t["step_t"] - b, 0.5)
+    pm, pt = max(t["pre_m"] - b, 0.5), max(t["pre_t"] - b, 0.5)
+    ratio = st / sm
+    win = exact and ratio <= _NB_GATE
+    verdict = ("ROUTE tiled" if win else "master first node") if routable else "print-only diagnostic (not routable)"
+    _say(f"[nb-gateB] {cls}: step with master pre {sm:.1f} us, with tiled pre {st:.1f} us -> tiled / master "
+         f"{ratio:.3f} (gate <= {_NB_GATE:.2f}); pre-attention alone: master {pm:.1f} us, tiled {pt:.1f} us; exact "
+         f"{exact} -> {verdict}")
+    del data, fns, qb
+    torch.cuda.empty_cache()
+    return win and routable
+
