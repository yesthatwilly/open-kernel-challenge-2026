+def _nb_setup() -> None:
+    """The combination's phases after master's import sequence, then ONE atomic publish of _SD_ROUTE, _NB_TILED
+    and _NB_C320, then a post-publish kernel_fn check per changed class (any failure restores master's tables)."""
+    global _SD_ROUTE, _NB_TILED, _NB_C320, _C320_EXT, _NB_SNAP
+    dev = torch.device("cuda")
+    _NB_SNAP = (_SD_ROUTE, _NB_TILED, _NB_C320, _C320_EXT)
+    _nb_mark("master's import sequence done: combination phases begin")
+    new_sd = dict(_SD_ROUTE)
+    tiled = set()
+    c320_on = False
+    sk_ok = _EXT2 is not None and _PS_BUILT and _SD_VALID
+    sms = _sm_count(dev)
+    gen = torch.Generator(device="cuda").manual_seed(13579)
+    flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+    exact = {}
+    sd_tiled_ok = False
+    tiled_ok = False
+    why = {}
+
+    # P1: compile every tiled variant, exactness per routable class, master's _sd_validate cases with the tiled node.
+    name, dl = "P1 tiled compile + exactness + tiled-pre _sd_validate", 60.0
+    if _nb_can_start(name, dl):
+        t0 = time.perf_counter()
+        try:
+            _nb_compile_tiled(gen)
+            for cls in ("SD16", "SD32", "SV1", "SV16", "SV32", "FD1"):
+                exact[cls] = _nb_exact(cls, gen)
+            tiled_ok = True
+            if sk_ok:
+                r = _sd_validate(tiled=True)
+                sd_tiled_ok = r is None
