+                     f"{'all ok' if sd_tiled_ok else f'FAILED ({r})'}")
+        except Exception as e:
+            _say(f"[nb] {name} raised (no class takes the tiled node): {e!r}")
+            tiled_ok = sd_tiled_ok = False
+        if not _nb_in_time(name, t0, dl):
+            tiled_ok = sd_tiled_ok = False
+        _rezero_tickets()
+    elif sk_ok:
+        _say("[nb] P1 skipped: the tiled first node is offered to no class")
+
+    # P2: sliding decode band 2 (B=2..16), early.
+    band2 = None
+    name, dl = "P2 sliding decode band 2 (B=16) sk-window gate + replay", 40.0
+    if not sk_ok:
+        why[2] = "sk window unavailable (PSEUDO build, stage-2 module or master's _sd_validate)"
+    elif _nb_can_start(name, dl):
+        t0 = time.perf_counter()
+        try:
+            info = _nb_sd_band(16, gen, flush, sms, sd_tiled_ok and exact.get("SD16", False))
