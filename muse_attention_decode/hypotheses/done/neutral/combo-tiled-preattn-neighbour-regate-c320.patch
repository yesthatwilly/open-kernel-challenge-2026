+def _nb_sd_replay(batch: int, lens, kv_scale: float, v: int, spec: str, tiled: bool, gen, sms: int) -> "str | None":
+    """Two-state A B B A A B replay of [pre (tiled or master) + sk] for a new band route (refilled ragged lens)."""
+    dev = torch.device("cuda")
+    g = _sd_grid(spec, batch, sms)
+    sets = _alt_sets(lens)
+    mp = max(max(s) for s in sets) + 1 + 37
+    why = _nb_alt_check(f"[nb-sd] replay B={batch} ({'tiled' if tiled else 'master'} pre)",
+                        lambda l: _ps_synthetic(l, kv_scale, gen, dev, max_pages=mp, L=1), _ps_reference, sets,
+                        lambda d: _sd_run(d, v, g, tiled))
+    if why is None and _nb_tickets_left(dev):
+        why = "tickets not reset"
+    return why
+
+
+def _nb_post_check(classes, gen) -> "str | None":
+    """After publishing: one eager kernel_fn per changed class through the real dispatch (its predicate
+    asserted), against the FP32 reference."""
+    dev = torch.device("cuda")
+    for cls in classes:
+        batch = _NB_BATCH[cls[2:]]
+        lens = [80000] if batch == 1 else ([80000] + _SK_LENS16[1:] if batch == 16 else
+                                          [80000, 2047] + [300 + 371 * i for i in range(30)])
+        data = _nb_synth(cls, lens, 1.0, gen)
+        cfg = data["config"]
+        if _nb_class(cfg) != cls:
+            return f"{cls}: class predicate does not match"
+        if cls[:2] == "SD" and not _sd_gate(cfg):
+            return f"{cls}: sliding decode route not active"
+        if cls[:2] != "SD" and not (cls in _NB_TILED or (cls == "FD1" and _NB_C320)):
+            return f"{cls}: route not active"
+        _say(f"[nb-post] {cls}: launching kernel_fn (published tables)")
+        out = kernel_fn(data)
+        torch.cuda.synchronize()
+        ref = _splitkv_reference(data, lens) if cls[:2] == "FD" else _ps_reference(data, lens)
+        err, finite = _rel_l2(out, ref)
+        ok = finite and err < 2e-2
+        _say(f"[nb-post] {cls}: kernel_fn returned, rel L2 {err:.2e}, finite {finite} -> {'ok' if ok else 'FAIL'}")
+        if not ok:
+            return f"{cls}: post-publish kernel_fn check"
+    return None
+
