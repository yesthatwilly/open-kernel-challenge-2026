+# --- SOURCE E: the sk-window band gate with both first nodes in pass 2 -----------------------------------
+
+def _nb_sd_band(batch: int, gen, flush, sms: int, tiled_ok: bool) -> dict:
+    """Master's _sd_gate_band (pass 1: every TOK = 1 variant x grid with master's first node, interleaved with
+    Triton and the cluster incumbent) with pass 2 widened as the review asks: Triton, [master pre + sk],
+    [tiled pre + sk], both pre nodes alone, the sk kernel alone (and the cluster incumbent) in ONE interleaved
+    set, median of 31, both ratios printed. GATE B for the band = [tiled + sk] / [master + sk] <= 0.98; the
+    chosen pair routes only at incumbent / pair >= 1.05 (Triton) or 1.03 (cluster), master's rule."""
+    dev = torch.device("cuda")
+    lens = [80000] * batch
+    data = _ps_synthetic(lens, 1.0, gen, dev, L=1)
+    nbytes = batch * (_PS_WINDOW + 1) * 256
+    cands, seen = [], set()
+    for spec in _SD_SPECS:
+        g = _sd_grid(spec, batch, sms)
+        for v in (6, 7):
+            if (v, g) not in seen:
+                seen.add((v, g))
+                cands.append((v, spec, g))
+    _say(f"[nb-sd] B={batch}: launching _pre_attention_kernel")
+    q, qkv = _ps_prepare_q(data)
+    torch.cuda.synchronize()
+    _say(f"[nb-sd] B={batch}: pre-attention returned (new rows stored)")
+    ref = _ps_reference(data, lens)
+    ok_cands = []
+    for v, spec, g in cands:
+        label = f"{_SK_LABELS[v]} grid {g} ({spec})"
+        _say(f"[nb-sd] B={batch}: launching {label} (eager correctness run)")
+        out = _sd_sk_launch(data, q, qkv, v, g)
+        torch.cuda.synchronize()
+        err, finite = _rel_l2(out, ref)
+        _say(f"[nb-sd] B={batch}: {label} returned, rel L2 {err:.2e}, finite {finite}")
+        if finite and err < 2e-2:
+            ok_cands.append((v, spec, g))
+    cfg = data["config"]
+    cc = _slide_clusters(cfg) if _slide_gate(cfg) else 0
+    inc_name, need = (f"cluster C={cc}", 1.03) if cc else ("Triton", 1.05)
+    info = {"route": False, "tiled": False, "pick": None, "inc_name": inc_name, "need": need}
+    _say(f"[nb-sd] B={batch}: incumbent = master {inc_name}; a route needs incumbent / chosen pair >= {need:.2f}x "
+         f"in pass 2")
+    if not ok_cands:
+        _say(f"[nb-sd] B={batch}: no decode variant passed its correctness check")
+        return info
+    fns = {"triton": (lambda: _sliding_forward(data))}
+    if cc:
+        fns["cluster"] = (lambda: _slide_forward(data, cc))
+    for v, spec, g in ok_cands:
+        fns[f"pair {v} {spec} {g}"] = (lambda v=v, g=g: _sd_run(data, v, g))
+    _say(f"[nb-sd] B={batch}: pass 1: timing {len(fns)} graphs interleaved (+ empty), cold L2, median of 21")
+    t = _sd_interleaved(fns, flush)
+    base = t["empty"]
+    results = []
+    for v, spec, g in ok_cands:
+        net = max(t[f"pair {v} {spec} {g}"] - base, 0.5)
+        _say(f"[nb-sd] B={batch}: pass 1 [master pre + sk] {_SK_LABELS[v]} grid {g} ({spec}): {net:7.1f} us net")
+        results.append((net, v, spec, g))
+    _say(f"[nb-sd] B={batch}: pass 1 Triton {max(t['triton'] - base, 0.5):.1f} us net"
+         + (f", cluster C={cc} {max(t['cluster'] - base, 0.5):.1f} us net" if cc else ""))
+    net1, v, spec, g = min(results)
+    info["pick"] = (v, spec, g)
+    _say(f"[nb-sd] B={batch}: pass 1 picked {_SK_LABELS[v]} grid {g} ({spec}) at {net1:.1f} us net (first-pass "
+         f"minimum: biased, NOT the routing number)")
+    if tiled_ok:
+        _say(f"[nb-sd] B={batch}: launching [tiled pre + sk] {_SK_LABELS[v]} grid {g} (eager correctness run)")
+        out = _sd_run(data, v, g, True)
+        torch.cuda.synchronize()
+        err, finite = _rel_l2(out, _ps_reference(data, lens))
+        _say(f"[nb-sd] B={batch}: [tiled pre + sk] returned, rel L2 {err:.2e}, finite {finite}")
+        tiled_ok = finite and err < 2e-2
+    sub = {"triton": (lambda: _sliding_forward(data)), "pair_m": (lambda: _sd_run(data, v, g, False)),
+           "pre_m": (lambda: _ps_prepare_q(data)), "sk": (lambda: _sd_sk_launch(data, q, qkv, v, g))}
+    if tiled_ok:
+        sub["pair_t"] = (lambda: _sd_run(data, v, g, True))
+        sub["pre_t"] = (lambda: _ps_prepare_q_tiled(data))
+    if cc:
+        sub["cluster"] = (lambda: _slide_forward(data, cc))
+    _say(f"[nb-sd] B={batch}: pass 2: {', '.join(sub)} in ONE interleaved set (+ empty), cold L2, median of 31")
+    t2 = _sd_interleaved(sub, flush, reps=31)
+    b2 = t2["empty"]
+    n2 = {k: max(t2[k] - b2, 0.5) for k in sub}
+    tri, pm = n2["triton"], n2["pair_m"]
+    inc = n2["cluster"] if cc else tri
+    _say(f"[nb-sd] B={batch}: pass 2 (empty {b2:.1f} us): Triton {tri:.1f} us"
+         + (f", cluster C={cc} {inc:.1f} us" if cc else "")
+         + f", [master pre + sk] {pm:.1f} us, master pre alone {n2['pre_m']:.1f} us, sk alone {n2['sk']:.1f} us "
+           f"({nbytes / n2['sk'] / 1e6:.2f} TB/s of window bytes)"
+         + (f", [tiled pre + sk] {n2['pair_t']:.1f} us, tiled pre alone {n2['pre_t']:.1f} us" if tiled_ok else ""))
+    line = f"master-pre pair: Triton / pair {tri / pm:.3f}x, {inc_name} / pair {inc / pm:.3f}x"
+    gate_b = False
+    if tiled_ok:
+        pt = n2["pair_t"]
+        gate_b = pt / pm <= _NB_GATE
+        line += (f"; tiled-pre pair: Triton / pair {tri / pt:.3f}x, {inc_name} / pair {inc / pt:.3f}x; GATE B "
+                 f"[tiled + sk] / [master + sk] {pt / pm:.3f} ({'tiled' if gate_b else 'master'} first node)")
+    else:
+        line += "; tiled-pre pair not timed (tiled first node unavailable or failed a check)"
+    chosen = n2["pair_t"] if gate_b else pm
+    ratio = inc / chosen
+    info.update(route=ratio >= need, tiled=gate_b, line=line, ratio=ratio, m_cleared=inc / pm >= need)
+    _say(f"[nb-sd] B={batch}: {line}")
+    _say(f"[nb-sd] B={batch}: chosen pair ({'tiled' if gate_b else 'master'} pre + {_SK_LABELS[v]} grid {spec}) "
+         f"{inc_name} / pair {ratio:.3f}x vs need {need:.2f}x -> {'ROUTE' if info['route'] else 'master incumbent'}; "
+         f"the master-pre pair {'also clears' if info['m_cleared'] else 'does not clear'} {need:.2f}x")
+    del data, q, qkv, ref, fns, sub
+    torch.cuda.empty_cache()
+    return info
