+def _nb_replay_cls(cls: str, c320_on: bool, gen) -> "str | None":
+    """Two-state A B B A A B replay of the routed class's step with the tiled first node."""
+    dev = torch.device("cuda")
+    if cls == "FD1":
+        lens, kv = [80000], 1.0
+    elif cls == "SV1":
+        lens, kv = [80000], 1.0
+    elif cls == "SV16":
+        lens, kv = [80000] + _SK_LENS16[1:], 0.25
+    else:
+        rng = random.Random(77)
+        lens = [rng.randint(1, 12000) for _ in range(32)]
+        lens[0], lens[1] = 80000, 2047
+        kv = 1.0
+    sets = _alt_sets(lens)
+    mp = max(max(s) for s in sets) + 8 + 37
