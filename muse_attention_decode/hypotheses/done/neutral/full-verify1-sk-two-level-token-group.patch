+def _fv_two_state_check(lens_plan, kv_scale: float, gen) -> "str | None":
+    """The judge's recipe on the routed kernel_fn: TWO prepared states (setup copies: 2), kernel_fn captured once as
+    a CUDA graph on each, then replays alternating between the states, every replay preceded by an in-place refill
+    of that state's inputs with new values (A, B, A, B), the output poisoned with NaN and compared with the FP32
+    reference of that state's current inputs. lens_plan = ((state, lens), ...) with states 0 / 1 each used twice."""
+    dev = torch.device("cuda")
+    pages = max(n for _, n in lens_plan) + 8 + 37
+    first = {i: n for i, n in reversed(lens_plan)}
+    states = [_fv_synthetic([first[0]], kv_scale, gen, dev, max_pages=pages),
+              _fv_synthetic([first[1]], kv_scale, gen, dev, max_pages=pages)]
+    assert all(_fv_gate(s["config"]) for s in states), "route not active for the two-state case"
+    graphs, outs = [], []
+    side = torch.cuda.Stream()
+    for i, st in enumerate(states):
+        _say(f"[fv] two-state: state {'AB'[i]} eager warm-up of kernel_fn on a side stream")
+        side.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(side):
+            kernel_fn(st)
+        torch.cuda.current_stream().wait_stream(side)
+        torch.cuda.synchronize()
+        _say(f"[fv] two-state: state {'AB'[i]} capturing kernel_fn")
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            o = kernel_fn(st)
+        torch.cuda.synchronize()
+        graphs.append(g)
+        outs.append(o)
+    for rnd, (i, n) in enumerate(lens_plan):
+        new = _fv_synthetic([n], kv_scale, gen, dev, max_pages=pages)
+        _ps_refill(states[i], new)  # refill every replay (the first too: fresh values after the capture)
+        del new
+        outs[i].fill_(float("nan"))
+        _say(f"[fv] two-state round {rnd}: refilled state {'AB'[i]} (lens {n}), launching its graph")
+        graphs[i].replay()
+        torch.cuda.synchronize()
+        err, finite = _rel_l2(outs[i], _fv_reference(states[i], [n]))
+        ok = finite and err < 2e-2
+        _say(f"[fv] two-state round {rnd}: state {'AB'[i]} rel L2 {err:.2e}, finite {finite} -> {'ok' if ok else 'FAIL'}")
+        if not ok:
+            return f"two-state replay round {rnd} state {'AB'[i]} lens {n}"
+    del graphs, states, outs
+    return None
+
