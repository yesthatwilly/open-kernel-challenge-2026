+        nums = (f"; best {i['label']} {i['t_new']:.1f} us vs FA3 {i['t_fa3']:.1f} us ({i['raw']:.3f}x raw, {i['sub']:.3f}x "
+                f"subtracted)" if i else "")
+        _say(f"PATH CHOSEN: full verify_1 master FA3 (FULLV not >= {_FV_MARGIN}x faster in the printed timings, or "
+             f"failed a check{nums})")
