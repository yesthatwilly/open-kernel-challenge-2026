+        _say(f"PATH CHOSEN: full verify_1 master FA3 (FULLV dropped: {why})")
+        return
+    i = _FV_INFO
+    _say(f"PATH CHOSEN: full verify_1 stream-K two-level token-group {i['label']} (new {i['t_new']:.1f} us vs master FA3 "
+         f"{i['t_fa3']:.1f} us raw = {i['raw']:.3f}x; baseline {i['base']:.1f} us subtracted = {i['sub']:.3f}x; "
+         f">= {_FV_MARGIN}x gate; every other full / verify shape unchanged)")
