+def _fv_time_interleaved(fns: dict, flush, warm: int = 3, reps: int = 21) -> dict:
+    """Median cold-L2 CUDA-graph replay time (us) of every fn, replays interleaved round-robin (order reversed on
+    alternate rounds) so drift and order hit all candidates alike; the L2 is flushed by reading a 256 MB buffer
+    before each replay and events bracket the replay only."""
+    graphs = {}
+    side = torch.cuda.Stream()
+    for name, fn in fns.items():
+        side.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(side):
+            fn()
+            fn()
+        torch.cuda.current_stream().wait_stream(side)
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            fn()
+        torch.cuda.synchronize()
+        graphs[name] = g
+    names = list(fns)
+    ts = {n: [] for n in names}
+    for it in range(warm + reps):
+        for n in (names if it % 2 == 0 else names[::-1]):
+            flush.sum()
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            e0.record()
+            graphs[n].replay()
+            e1.record()
+            torch.cuda.synchronize()
+            if it >= warm:
+                ts[n].append(e0.elapsed_time(e1) * 1e3)
+    del graphs
+    return {n: sorted(v)[len(v) // 2] for n, v in ts.items()}
+
+
+_FV_INFO = {}
+
+
+def _fv_gate_time(sms: int, usable) -> "tuple | None":
+    """Time every usable variant x grid {SM/2, SM, 2xSM} (TG=1: SM only, for the record) and master FA3 at
+    B=1 x 80000 as interleaved graph replays, plus an empty-graph baseline (one trivial kernel) subtracted for the
+    judge-style numbers. Prints every number; returns (variant, grid) only if the best candidate beats FA3 by >= 1.05x
+    BOTH raw and baseline-subtracted (raw is the stricter), else None."""
+    dev = torch.device("cuda")
+    gen = torch.Generator(device="cuda").manual_seed(1357)
+    flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+    lens = [80000]
+    data = _fv_synthetic(lens, 1.0, gen, dev)
+    _say("[fv-gate] launching _pre_attention_kernel")
+    q, qkv = _fv_prepare_q(data)
+    torch.cuda.synchronize()
+    ref = _fv_reference(data, lens)
+    fns, meta = {}, {}
+    for v in sorted(usable):
+        for gname, grid in ((("SM", sms),) if v == 10 else (("SM/2", max(1, sms // 2)), ("SM", sms), ("2xSM", 2 * sms))):
+            label = f"{_fv_name(v)} grid {gname} ({grid})"
+            _say(f"[fv-gate] launching {label} (eager correctness run)")
+            out = _fv_launch(data, q, qkv, v, grid)
+            torch.cuda.synchronize()
+            err, finite = _rel_l2(out, ref)
+            _say(f"[fv-gate] {label} returned, rel L2 {err:.2e}, finite {finite}")
+            if not (finite and err < 2e-2):
+                _say(f"[fv-gate] {label} FAILED its correctness check: not timed")
+                continue
+            fns[label] = (lambda v=v, grid=grid: _fv_launch(data, q, qkv, v, grid))
+            meta[label] = (v, grid)
+    fa3_out = _fv_fa3(data, q, qkv)
+    torch.cuda.synchronize()
+    ferr, ffin = _rel_l2(fa3_out, ref)
+    _say(f"[fv-gate] master FA3 path: rel L2 {ferr:.2e}, finite {ffin}")
+    tiny = torch.zeros(1, dtype=torch.float32, device=dev)
+    fa3_key = "master FA3 (prepare + main + combine + norm-gate)"
+    empty_key = "empty graph (one trivial kernel)"
+    fns[fa3_key] = lambda: _fv_fa3(data, q, qkv)
+    fns[empty_key] = lambda: tiny.add_(1.0)
+    t = _fv_time_interleaved(fns, flush)
+    t_fa3, base = t[fa3_key], t[empty_key]
+    _say(f"[fv-gate] empty-graph baseline {base:.1f} us; master FA3 {t_fa3:.1f} us raw, {t_fa3 - base:.1f} us "
+         f"baseline-subtracted (pre-attention on neither side; interleaved graph replay, cold L2, median of 21)")
+    results = []
+    for label, (v, grid) in meta.items():
+        results.append((t[label], v, grid, label))
+        _say(f"[fv-gate] {label}: {t[label]:7.1f} us raw, {t[label] - base:7.1f} us subtracted "
+             f"-> {t_fa3 / t[label]:.3f}x raw, {(t_fa3 - base) / max(t[label] - base, 0.5):.3f}x subtracted vs FA3")
+    del data, q, qkv, ref, flush
+    torch.cuda.empty_cache()
+    if not results:
+        _say("[fv-gate] no FULLV candidate passed its correctness check")
+        return None
+    best_tg = {}
+    for tt, v, grid, label in sorted(results):
+        best_tg.setdefault(_fv_tg(v), (tt, label))
+    _say("[fv-gate] SUMMARY best per TG: " + " | ".join(f"TG={tg} {best_tg[tg][0]:.1f} us ({best_tg[tg][1]})"
+                                                        for tg in sorted(best_tg)) + f" | FA3 {t_fa3:.1f} us")
+    tb, v, grid, label = min(results)
+    raw, sub = t_fa3 / tb, (t_fa3 - base) / max(tb - base, 0.5)
+    ok = raw >= _FV_MARGIN and sub >= _FV_MARGIN
+    _FV_INFO.update({"t_new": tb, "t_fa3": t_fa3, "base": base, "label": label, "raw": raw, "sub": sub})
+    _say(f"[fv-gate] best {label}: {tb:.1f} us vs FA3 {t_fa3:.1f} us raw ({raw:.3f}x), {tb - base:.1f} vs "
+         f"{t_fa3 - base:.1f} us baseline-subtracted ({sub:.3f}x) -> "
+         f"{'ROUTE' if ok else f'below the {_FV_MARGIN}x gate: FA3'}")
+    return (v, grid) if ok else None
+
