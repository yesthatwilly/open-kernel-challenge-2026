+            _say(f"[fv] variant {v} refused: spills {a[3]} B to local memory")
+            continue
+        if a[6] < 2:
+            _say(f"[fv] WARNING: variant {v} does not reach 2 CTAs/SM (performance, not correctness)")
+        usable.add(v)
+    gen = torch.Generator(device="cuda").manual_seed(97531)
+    half, two = max(1, sms // 2), 2 * sms
+
+    def cases(v):
+        full = [
+            (f"v{v} lens 80000 grid SM", [80000], 1.0, sms, False),
+            (f"v{v} lens 80000 kv 0.25 grid SM/2", [80000], 0.25, half, False),
+            (f"v{v} lens 80000 grid 2xSM", [80000], 1.0, two, False),
+            (f"v{v} lens 80000 coherent grid SM", [80000], 1.0, sms, True),
+            (f"v{v} lens 5003 grid SM/2", [5003], 1.0, half, False),
+            (f"v{v} lens 5003 kv 0.25 grid SM", [5003], 0.25, sms, False),
+            (f"v{v} lens 5003 grid 2xSM", [5003], 1.0, two, False),
+            (f"v{v} lens 5003 coherent grid SM", [5003], 1.0, sms, True),
+            (f"v{v} lens 80000 grid 3", [80000], 1.0, 3, False),
+            (f"v{v} lens 4089 (S = 4097) grid 7", [4089], 0.25, 7, False),
+            (f"v{v} lens 57 (S = 65) grid 7", [57], 1.0, 7, False),
+            (f"v{v} lens 56 (S = 64, one tile) grid 3", [56], 1.0, 3, False),
+            (f"v{v} lens 3 (S = 11) kv 0.25 grid SM", [3], 0.25, sms, False),
+            (f"v{v} lens 0 (S = 8) grid 3", [0], 1.0, 3, False),
+        ]
+        return full[:1] + full[3:5] + full[7:8] + full[10:] if v == 10 else full  # TG=1 (8x reads): a subset
+
+    failed = {}
+    for v in sorted(usable):
+        for tag, lens, kv_scale, grid, plant in cases(v):
+            if not _fv_case(tag, lens, kv_scale, v, grid, gen, plant):
+                failed[v] = tag
+                break
