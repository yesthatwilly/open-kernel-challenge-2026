+        FM_DIV=c["DIV"], FM_TIE=c["TIE"]))
+
+
+def _fm_dummy(B: int, dev):
+    """Small token-only inputs for the production META launch (the metadata reads only cache_seqlens / cu_seqlens_q;
+    the body programs store into a private [tokens] cache)."""
+    tokens = B * 8
+    return {
+        "qkv": torch.zeros((B, 8, 2304), dtype=torch.bfloat16, device=dev),
+        "positions": torch.arange(tokens, dtype=torch.int64, device=dev),
+        "cache_loc": torch.arange(tokens, dtype=torch.int64, device=dev),
+        "cache_seqlens": torch.zeros(B, dtype=torch.int32, device=dev),
+        "cu_seqlens_q": torch.arange(0, tokens + 1, 8, dtype=torch.int32, device=dev),
+        "k_cache": torch.empty((tokens, 1, 2, 64), dtype=FP8, device=dev),
+        "v_cache": torch.empty((tokens, 1, 2, 64), dtype=FP8, device=dev),
+        "k_scale": torch.tensor(1.0, dtype=torch.float32, device=dev),
+        "v_scale": torch.tensor(1.0, dtype=torch.float32, device=dev),
+        "config": {"batch": B, "q_len": 8, "num_q_heads": 16, "num_kv_heads": 2, "head_dim": 64},
+    }
+
+
+def _fm_triton_meta(dummy, cs, size: int, kw):
+    """Gate (b): the production META launch (kernel_fn's grid and constexprs) for cache_seqlens cs; the buffer is
+    poisoned with -7 first, so an unwritten slot shows."""
+    B = len(cs)
+    dummy["cache_seqlens"].copy_(torch.tensor(cs, dtype=torch.int32))
+    meta = torch.full((size,), -7, dtype=torch.int32, device=dummy["qkv"].device)
+    q = torch.empty((B * 8, 16, 128 if B > 1 else 64), dtype=FP8, device=meta.device)
+    _fm_pre_launch(dummy, dummy["qkv"].reshape(B * 8, -1), q, dummy["k_scale"], meta, kw, B > 1)
+    torch.cuda.synchronize()
+    return meta.cpu().tolist()
+
+
+def _fm_synth(lens, gen, dev, max_pages: int):
+    """Full-layer verify inputs (window 0, no RoPE, q_len 8, page 1, tp8) at seq_lens = lens and the given page-table
+    width, built as reference.generate_input lays them out."""
+    data = _ps_synthetic(lens, 1.0, gen, dev, max_pages=max_pages, L=8)
+    data["config"] = dict(data["config"], window=0, rope_theta=0.0)
+    return data
+
+
+def _fm_clone(data):
+    return {k: (v.clone() if torch.is_tensor(v) else v) for k, v in data.items()}
+
+
+def _fm_run(route, fn):
+    """fn() with _FM_ROUTE temporarily set to route (import-time gates only; kernel_fn reads the module global when
+    it is called or captured)."""
+    global _FM_ROUTE
+    old = _FM_ROUTE
+    _FM_ROUTE = route
+    try:
+        return fn()
+    finally:
+        _FM_ROUTE = old
+
+
+def _fm_pre_only(data, kw, size: int):
+    """kernel_fn's pre-attention launch alone for these rows: master's (kw None) or the META one. Returns (q, meta)."""
+    cfg = data["config"]
+    B, hq, hkv, d = cfg["batch"], cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"]
+    tokens = B * cfg["q_len"]
+    paired = B > 1  # kernel_fn's predicate on these rows (window 0, Hkv even, not split-KV)
+    qkv = data["qkv"].reshape(tokens, -1)
+    q = torch.empty((tokens, hq, 2 * d if paired else d), dtype=FP8, device=qkv.device)
+    if kw is None:
+        _pre_attention_kernel[(tokens, hq + hkv)](
+            qkv, data["positions"], data["cache_loc"], data["k_scale"], data["k_scale"], data["v_scale"],
+            q, data["k_cache"], data["v_cache"],
+            qkv.stride(0),
+            HQ=hq, HKV=hkv, D=d, ROPE=False, EPS=RMS_EPS, PAIRED=paired, G=hq // hkv,
+            num_warps=1,
+        )
+        return q, None
+    meta = torch.empty(size, dtype=torch.int32, device=qkv.device)
+    _fm_pre_launch(data, qkv, q, data["k_scale"], meta, kw, paired)
+    return q, meta
+
+
+def _fm_fa3(data, q, metadata):
+    """kernel_fn's FA3 call on these rows (paired 128-wide view at B > 1) with the given scheduler_metadata."""
+    cfg = data["config"]
+    hkv, d = cfg["num_kv_heads"], cfg["head_dim"]
+    k_attn, v_attn = data["k_cache"], data["v_cache"]
+    if cfg["batch"] > 1:
+        pages, ps = k_attn.shape[0], k_attn.shape[1]
+        k_attn = k_attn.view(pages, ps, hkv // 2, 2 * d)
+        v_attn = v_attn.view(pages, ps, hkv // 2, 2 * d)
+    out = flash_attn_with_kvcache(
+        q=q, k_cache=k_attn, v_cache=v_attn, page_table=data["page_table"], cache_seqlens=data["cache_seqlens"],
+        cu_seqlens_q=data["cu_seqlens_q"], max_seqlen_q=cfg["q_len"],
+        softmax_scale=cfg["sm_scale"] * cfg["qk_scale_factor"], causal=True, window_size=(-1, -1),
+        scheduler_metadata=metadata)
+    return out[0] if isinstance(out, tuple) else out
+
+
+def _fm_equal_check(B: int, mp: int, on, kw, size: int, lib, gen, rng, dev) -> "str | None":
+    """Gate (c): 8 judge-shape draws (B = 1: 4 at 80000, 4 at other lengths): kernel_fn with the fold vs master
+    (route off) on cloned inputs: output, the WHOLE k_cache and v_cache torch.equal; FA3's output with this call's
+    folded metadata vs metadata None torch.equal, and the metadata equal to the library's. Then one captured graph of
+    the fold replayed twice (semaphore re-zeroed by the META program) and again after an in-place refill with other
+    lengths, each torch.equal to master on the same inputs. None on success, else the reason."""
+    off = MappingProxyType({})
+    BR = (B + 3) // 4 * 4
+    for k in range(8):
+        if B == 1:
+            lens = [80000] if k < 4 else [rng.randint(1, mp - 8)]
+        else:
+            lens = [c - 8 for c in _fm_draws(B, mp, rng, 1)[0]]
+        dm = _fm_synth(lens, gen, dev, mp)
+        df = _fm_clone(dm)
+        om = _fm_run(off, lambda: kernel_fn(dm))
+        of = _fm_run(on, lambda: kernel_fn(df))
+        torch.cuda.synchronize()
+        eq = (torch.equal(om, of), torch.equal(dm["k_cache"], df["k_cache"]), torch.equal(dm["v_cache"], df["v_cache"]))
+        if not all(eq):
+            return f"draw {k} (lens {lens[:2]}..): output / k_cache / v_cache equal {eq}"
+        q, meta = _fm_pre_only(df, kw, size)
+        a_meta = _fm_fa3(df, q, meta)
+        a_none = _fm_fa3(df, q, None)
+        torch.cuda.synchronize()
+        if not torch.equal(a_meta, a_none):
+            return f"draw {k}: FA3 output with the folded metadata != metadata None"
+        if not _fm_same(meta.cpu().tolist(), _fm_lib_meta(lib, [n + 8 for n in lens], mp, B > 1, dev), B, BR):
+            return f"draw {k}: folded metadata != library at the judge shape"
+        del dm, df, om, of, q, meta, a_meta, a_none
+    lens = [80000] if B == 1 else [c - 8 for c in _fm_draws(B, mp, rng, 1)[0]]
+    df = _fm_synth(lens, gen, dev, mp)
+    holder = {}
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        for _ in range(2):
+            _fm_run(on, lambda: kernel_fn(df))
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        holder["out"] = _fm_run(on, lambda: kernel_fn(df))
+    torch.cuda.synchronize()
+    graph.replay()
+    torch.cuda.synchronize()
+    r1 = holder["out"].clone()
+    graph.replay()
+    torch.cuda.synchronize()
+    r2 = holder["out"].clone()
+    om = _fm_run(off, lambda: kernel_fn(_fm_clone(df)))
+    torch.cuda.synchronize()
+    if not (torch.equal(r1, r2) and torch.equal(r1, om)):
+        return "graph replay: two consecutive replays differ or differ from master (semaphore reset)"
+    lens2 = [54321] if B == 1 else [rng.randint(1, mp - 8) for _ in range(B)]
+    new = _fm_synth(lens2, gen, dev, mp)
+    for key in _ALT_KEYS:
+        df[key].copy_(new[key])
+    del new
+    dm2 = _fm_clone(df)
+    graph.replay()
+    torch.cuda.synchronize()
+    r3 = holder["out"].clone()
+    om2 = _fm_run(off, lambda: kernel_fn(dm2))
+    torch.cuda.synchronize()
+    eq = (torch.equal(r3, om2), torch.equal(df["k_cache"], dm2["k_cache"]), torch.equal(df["v_cache"], dm2["v_cache"]))
+    del graph, holder, df, dm2
+    if not all(eq):
+        return f"graph replay after an in-place refill (lens {lens2[:2]}..): output / k_cache / v_cache equal {eq}"
+    return None
+
+
+def _fm_row(B: int, lib, gen, rng, flush, dev, nsm: int):
+    """Gates (a)-(d) for one row. Returns (route value | None, compact summary for the PATH CHOSEN line); the full
+    detail goes to a [fm] line."""
+    mp = _FM_ROWS[B]
+    paired = B > 1
+    BR = (B + 3) // 4 * 4
+    size = 4 * BR + 1
+    st = {"match": "not run", "kv": "not run", "race": "not run", "pre": "not run", "why": ""}
+    info = []
+    t0 = time.perf_counter()
+
+    def done(val, why):
+        st["why"] = why
+        _say(f"[fm] B={B}: {'; '.join(info + [why])} ({time.perf_counter() - t0:.1f} s)")
+        return val, (f"metadata-match {st['match']}; k/v-cache equal {st['kv']}; race {st['race']}; pre-attn "
+                     f"{st['pre']}; {why}")
+
+    rec = [(cs, _fm_lib_meta(lib, cs, mp, paired, dev)) for cs in _fm_draws(B, mp, rng, 64) + _fm_edges(B, mp, rng)]
+    found, why = _fm_recover(B, paired, rec, nsm)
+    if not found:
+        st["match"] = "NO (gate a)"
+        return done(None, f"gate a: {why}")
+    hold = [(cs, _fm_lib_meta(lib, cs, mp, paired, dev)) for cs in _fm_draws(B, mp, rng, 64)]
+    for c in found:
+        if not all(_fm_same(_fm_emulate(cs, c), lb, B, BR) for cs, lb in hold):
+            st["match"] = "NO (gate a holdout)"
+            return done(None, f"gate a: {len(found)} candidates match {len(rec)} samples but {_fm_name(c)} misses "
+                              f"the holdout")
+    c = found[0]
+    ties = sorted({x["TIE"] for x in found})
+    tie_txt = (f"tie rule {'stable' if ties[0] == 0 else 'reversed'} (the all-equal sets match only it)"
+               if len(ties) == 1 else "tie rule not discriminated (no ties possible)")
+    info.append(f"a: {len(found)} candidate(s) on {len(rec)} samples + {len(hold)} holdout, size {size}, "
+                f"{_fm_name(c)}, {tie_txt}")
+    kw = _fm_kwargs(c)
+    dummy = _fm_dummy(B, dev)
+    for cs, lb in rec + hold:
+        m = _fm_triton_meta(dummy, cs, size, kw)
+        pads = all(m[k * BR + j] == 0 for k in range(4) for j in range(B, BR))
+        if not (_fm_same(m, lb, B, BR) and pads):
+            st["match"] = "NO (gate b)"
+            return done(None, f"gate b: Triton META != library (pads 0: {pads}) at cache_seqlens {cs[:3]}..")
+    del dummy
+    st["match"] = f"yes ({len(rec) + len(hold)} samples, cap {c['CAP']}{' binding' if c['BIND'] else ' clamped'})"
+    info.append(f"b: Triton META == library on all {len(rec) + len(hold)} samples")
+    if _sw_elapsed() > _FM_BY:
+        return done(None, "gate c skipped: deadline")
+    on = MappingProxyType({(B, mp): (size, kw)})
+    why = _fm_equal_check(B, mp, on, kw, size, lib, gen, rng, dev)
+    torch.cuda.empty_cache()
+    if why is not None:
+        st["kv"] = "NO / not equal (gate c)"
+        return done(None, f"gate c: {why}")
+    st["kv"] = "yes (8 draws + replays; output and FA3 equal too)"
+    info.append("c: output / FA3 / k_cache / v_cache torch.equal on 8 draws, graph replays equal")
+    if _sw_elapsed() > _FM_BY:
+        return done(None, "race skipped: deadline")
+    off = MappingProxyType({})
+    lens = [80000] if B == 1 else [x - 8 for x in _fm_draws(B, mp, rng, 1)[0]]
+    dm = _fm_synth(lens, gen, dev, mp)
+    df = _fm_clone(dm)
+    lists, emp = _sw_rounds([lambda: _fm_pre_only(dm, None, size), lambda: _fm_pre_only(df, kw, size)], flush,
+                            warm=3, reps=15)
+    p_off, _ = _sw_stats(lists[0], emp)
+    p_on, _ = _sw_stats(lists[1], emp)
+    st["pre"] = f"META off {p_off:.2f} us / on {p_on:.2f} us ({p_on - p_off:+.2f})"
+    ratios, iqr_ok, steps = [], True, []
+    for rd in (1, 2):
+        lists, emp = _sw_rounds([lambda: _fm_run(off, lambda: kernel_fn(dm)), lambda: _fm_run(on, lambda: kernel_fn(df))],
+                                flush, warm=3, reps=31)
+        mm, mi = _sw_stats(lists[0], emp)
+        fa, fi = _sw_stats(lists[1], emp)
+        ratios.append(mm / max(fa, 1e-3))
+        iqr_ok = iqr_ok and fi <= _SW_IQR * max(mi, 0.05)
+        steps.append((mm, fa))
+        _say(f"[fm] B={B} race round {rd}: master {mm:.2f} us (IQR {mi:.2f}) vs fold {fa:.2f} us (IQR {fi:.2f}) -> "
+             f"{ratios[-1]:.3f}x")
+    del dm, df
+    torch.cuda.empty_cache()
+    bar = _FM_BAR[B]
+    good = min(ratios) >= bar and iqr_ok
+    mm = sum(x[0] for x in steps) / 2
+    fa = sum(x[1] for x in steps) / 2
+    st["race"] = (f"{ratios[0]:.3f}x / {ratios[1]:.3f}x (bar {bar}, IQR {'met' if iqr_ok else 'MISSED'}; step "
+                  f"{mm:.2f} -> {fa:.2f} us; prepare-node delta ~{(mm - fa) + (p_on - p_off):.2f} us)")
+    return done((size, kw) if good else None, "routed" if good else "race below the bar or IQR missed")
+
