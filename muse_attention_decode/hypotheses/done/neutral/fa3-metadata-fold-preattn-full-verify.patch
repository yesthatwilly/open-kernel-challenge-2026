+_FM_ROUTE = MappingProxyType({})  # (B, page-table width) -> (metadata size, constexpr kwargs); frozen at import
+_FM_BAR = MappingProxyType({1: 1.02, 16: 1.00, 32: 1.00})  # master / fold step time needed in BOTH race rounds
+_FM_BY = 480.0  # import-clock start rule (seconds), as the other phases
+_FM_BMS = (64, 128, 192)
+_FM_BNS = (64, 80, 96, 112, 128, 144, 160, 176, 192, 208, 224, 256)
