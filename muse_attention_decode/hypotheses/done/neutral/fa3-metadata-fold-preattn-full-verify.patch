+def _fm_pre_launch(data, qkv, q, inv_freq, fmeta, kw, paired: bool) -> None:
+    """kernel_fn's pre-attention launch on a routed full-verify row: master's programs (unchanged body) plus the META
+    program (t == tokens, h == 0) writing FA3's scheduler metadata for this call into fmeta."""
+    cfg = data["config"]
+    hq, hkv, d = cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"]
+    tokens = cfg["batch"] * cfg["q_len"]
+    _pre_attention_kernel[(tokens + 1, hq + hkv)](
