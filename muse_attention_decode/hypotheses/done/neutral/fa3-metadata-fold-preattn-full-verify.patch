+def _fm_cap(c, prepared):
+    """(cap, from_binding) for candidate c, or (None, False) if inconsistent. Binding: a request whose uncapped split
+    count exceeds the library's, which then IS the cap; all binding values must agree. With none binding, the
+    smallest cap consistent with every sample (the largest split seen), never larger."""
+    bind, lo = set(), 1
+    for cs, _, lsp in prepared:
+        _, _, raw = _fm_raw(cs, c)
+        for r, s in zip(raw, lsp):
+            if s < 1 or s > max(r, 1):
+                return None, False
+            if r > s:
+                bind.add(s)
+            lo = max(lo, s)
+    if len(bind) > 1:
+        return None, False
+    if bind:
+        cap = bind.pop()
+        return (cap, True) if cap >= lo else (None, False)
+    return lo, False
