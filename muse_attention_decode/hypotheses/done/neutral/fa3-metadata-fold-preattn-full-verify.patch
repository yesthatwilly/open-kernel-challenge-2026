+def _fm_recover(B: int, paired: bool, samples, nsm: int):
+    """Gate (a): every candidate constant set whose port reproduces the library on every sample. Returns
+    (candidates, reason when none)."""
+    BR = (B + 3) // 4 * 4
+    hk, dd = (1, 128) if paired else (2, 64)
+    qhpk = -(-16 // hk)
+    prepared = []
+    for cs, lib in samples:
+        if len(lib) != 4 * BR + 1:
+            return [], f"library metadata has {len(lib)} ints, not 4*{BR}+1 (layout differs)"
+        idx = lib[2 * BR:2 * BR + B]
+        if sorted(idx) != list(range(B)):
+            return [], "library varlen_batch_idx is not a permutation (layout differs)"
+        if lib[4 * BR] != 0:
+            return [], f"library semaphore slot {lib[4 * BR]} != 0 (layout differs)"
+        lsp = [0] * B
+        for r, b in enumerate(idx):
+            lsp[b] = lib[r]
+        prepared.append((cs, lib, lsp))
+    found = []
+    for bm in _FM_BMS:
+        for bn in _FM_BNS:
+            for pg in (True, False):
+                c = dict(B=B, BR=BR, BM=bm, BN=bn, PG=pg, QHPK=qhpk, NH=hk if pg else 16, NSM=nsm,
