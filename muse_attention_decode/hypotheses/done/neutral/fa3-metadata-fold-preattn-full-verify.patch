+        return out + [[rng.randint(8, top)] for _ in range(24)]
+    out.append([9 + 7 * b for b in range(B)])
+    out.append([8 + 64 * b for b in range(B)])
+    out.append([top - 97 * b for b in range(B)])
+    out.append([9 + (top - 9) * b // (B - 1) for b in range(B)])
