+def _fm_edges(B: int, max_pages: int, rng):
+    """Edge sets (cache_seqlens <= page-table width): all-equal lengths (every sort key ties: the tie rule), lengths
+    == q_len, below / at / above one block, ramps, one long + many short (the split cap binds), uniform."""
+    top = max_pages
+    out = [[n] * B for n in (8, 9, 100, 159, 160, 161, 1000, 40000, top - 1, top)]
