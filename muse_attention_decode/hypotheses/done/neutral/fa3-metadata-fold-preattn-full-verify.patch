+def _fm_setup() -> None:
+    """Gate the three full-verify rows (B = 1, 16, 32 at the judge's page-table widths) and freeze _FM_ROUTE. One
+    PATH CHOSEN line per row; any failure, deadline or exception leaves that row on master."""
+    global _FM_ROUTE
+    route, lines = {}, {}
+    try:
+        from sgl_kernel.flash_attn import get_scheduler_metadata as lib
+        why_lib = None
+    except Exception as e:
+        lib, why_lib = None, f"get_scheduler_metadata unavailable ({e!r})"
+    dev = torch.device("cuda", torch.cuda.current_device())
+    flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+    gen = torch.Generator(device="cuda").manual_seed(4251)
+    rng = random.Random(4251)
+    nsm = _sm_count(dev)
+    for B in (1, 16, 32):
+        if lib is None:
+            lines[B] = f"master (fallback: {why_lib})"
+            continue
+        if _sw_elapsed() > _FM_BY:
+            lines[B] = f"master (skipped: deadline, import clock {_sw_elapsed():.0f} s > {_FM_BY:.0f} s)"
+            continue
+        t0 = time.perf_counter()
+        try:
+            val, detail = _fm_row(B, lib, gen, rng, flush, dev, nsm)
+        except Exception as e:
+            val, detail = None, f"raised {e!r}"
+        torch.cuda.empty_cache()
+        if val is not None:
+            route[(B, _FM_ROWS[B])] = val
+        lines[B] = f"{'ROUTE folded metadata' if val is not None else 'master'}: {detail} [{time.perf_counter() - t0:.0f} s]"
+    del flush
+    _FM_ROUTE = MappingProxyType(route)
+    for B in (1, 16, 32):
+        _say(f"PATH CHOSEN: full verify B={B} [fm FA3 metadata folded into pre-attention]: {lines[B]}")
+
