+def _fm_draws(B: int, max_pages: int, rng, n: int):
+    """n cache_seqlens lists (seq_len + 8) from the judge's distribution for this row: B > 1 'agentic' (80000 +/- 7.5%);
+    B = 1 is 'fixed' (80000), so 8 judge draws plus uniform lengths (the B = 1 gate must see other lengths)."""
+    if B == 1:
