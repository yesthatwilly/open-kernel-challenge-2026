+def _fm_same(m, lib, B: int, BR: int) -> bool:
+    """m equals the library's metadata on every slot FA3 reads: [0, B) of each vector and the semaphore."""
+    return (all(m[k * BR + j] == lib[k * BR + j] for k in range(4) for j in range(B)) and m[4 * BR] == lib[4 * BR])
