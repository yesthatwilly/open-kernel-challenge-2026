+def _fm_gate(cfg, max_pages: int):
+    """Config-and-shape-only predicate: full-layer verify (window 0, q_len 8, tp8, d 64, page 1, unit kv scale) at a
+    routed (batch, page-table width). Returns (metadata size, constexpr kwargs) or None."""
