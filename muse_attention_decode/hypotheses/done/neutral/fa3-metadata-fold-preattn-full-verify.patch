+def _f32(v: float) -> float:
+    """v rounded to the nearest float32 (IEEE round to nearest even)."""
+    return struct.unpack("f", struct.pack("f", v))[0]
+
+
+def _fm_bps(total: int, nh: int, nsm: int) -> int:
+    """blocks_per_sm = int(ceilf(float(total) * 1.1f * float(num_head) / float(num_sm))) in float32, same order
+    (a float32 product or quotient computed in double and rounded once is the correctly rounded float32 result)."""
+    x = _f32(_f32(_f32(float(total)) * _f32(1.1)) * _f32(float(nh)))
+    x = _f32(x / _f32(float(nsm)))
+    return max(math.ceil(x), 1)
+
+
+def _fm_raw(cs, c):
+    """(num_m_blocks, num_n_blocks, uncapped split count) per request for cache_seqlens cs (q_len 8) under c."""
+    mb = -(-8 * (c["QHPK"] if c["PG"] else 1) // c["BM"])
+    nb = [-(-n // c["BN"]) for n in cs]
+    bps = _fm_bps(mb * sum(nb), c["NH"], c["NSM"])
+    return mb, nb, [-(-n // bps) for n in nb]
+
+
+def _fm_emulate(cs, c):
+    """Python port of prepare_varlen_num_blocks_kernel<NumWarps, Sort=true> (causal, not local) for one call: the
+    4*BR + 1 metadata list, None at the pad slots (never read by FA3)."""
+    B, BR = len(cs), c["BR"]
+    mb, nb, raw = _fm_raw(cs, c)
+    sp = [max(min(r, c["CAP"]), 1) for r in raw]
+    nbs = [-(-n // s) for n, s in zip(nb, sp)] if c["DIV"] else nb
+    key = [n * c["BN"] - mb * c["BM"] for n in nbs]
+    order = sorted(range(B), key=(lambda b: (-key[b], b)) if c["TIE"] == 0 else (lambda b: (-key[b], -b)))
+
+    def nheads(n):
+        n = max(n, 1)
+        k = 16 if n * 16 <= c["L2"] else 8 if n * 8 <= c["L2"] else 4 if n * 4 <= c["L2"] else 2 if n * 2 <= c["L2"] else 1
+        return min(k if c["PG"] else k * c["QHPK"], c["NH"])
+
+    out = [None] * (4 * BR + 1)
+    for r, b in enumerate(order):
+        out[r], out[BR + r], out[2 * BR + r], out[3 * BR + r] = sp[b], mb, b, nheads(nbs[b])
+    out[4 * BR] = 0
+    return out
