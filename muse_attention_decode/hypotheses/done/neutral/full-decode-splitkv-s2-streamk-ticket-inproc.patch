+def _sk_replay_check(gen):
+    """kernel_fn captured as a CUDA graph and replayed twice, the output poisoned with NaN before
+    each replay: the second replay is right only if the first left every ticket at 0."""
+    dev = torch.device("cuda")
+    data = _splitkv_synthetic(_SK_LENS16, 1.0, gen, dev)
+    _say("[sk] replay: eager warm-up of kernel_fn on a side stream")
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        kernel_fn(data)
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    _say("[sk] replay: warm-up returned")
+    ref = _splitkv_reference(data, _SK_LENS16)
+    graph = torch.cuda.CUDAGraph()
+    _say("[sk] replay: capturing kernel_fn")
+    with torch.cuda.graph(graph):
+        out = kernel_fn(data)
+    torch.cuda.synchronize()
+    for i in (1, 2):
+        out.fill_(float("nan"))
+        _say(f"[sk] replay {i}: launching graph (_pre_attention_kernel + splitkv_attn_sk_kernel)")
+        graph.replay()
+        torch.cuda.synchronize()
+        err, finite = _rel_l2(out, ref)
+        ok = finite and err < 2e-2
+        _say(f"[sk] replay {i}: rel L2 {err:.2e}, finite {finite} -> {'ok' if ok else 'FAIL'}")
+        if not ok:
+            return f"graph replay {i}"
+    del graph
+    return None
