+
+
+def _sk_combine(data: Inputs, qkv: torch.Tensor, out, ws_acc, ws_ml, grid: int) -> None:
+    _EXT2.sk_combine(ws_acc, ws_ml, data["cache_seqlens"], data["v_scale"], qkv, qkv.stride(0), out, grid, RMS_EPS)
