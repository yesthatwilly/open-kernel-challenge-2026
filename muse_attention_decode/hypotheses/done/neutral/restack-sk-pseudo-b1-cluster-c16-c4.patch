+def _slide_two_state_check(ext, c: int, tag: str) -> bool:
+    """The judge's pattern: prepare two states (same shapes, different seq lens / cache_loc / page
+    table / caches / scales), capture the launch ONCE on one buffer set, then alternate
+    refill A, replay, compare / refill B, replay, compare (twice), each against the FP32
+    reference with the output poisoned before every replay. Nothing the launch reads is global."""
+    batch, (lens_a, kv_a), (lens_b, kv_b) = _SLIDE_STATES[c]
+    dev = torch.device("cuda")
+    gen = torch.Generator(device="cuda").manual_seed(8642 + c)
+    max_pages = max(max(lens_a), max(lens_b)) + 1 + 29
+    state_a = _slide_synthetic(lens_a, 1, kv_a, gen, dev, max_pages)
+    state_b = _slide_synthetic(lens_b, 1, kv_b, gen, dev, max_pages)
+    data = _slide_synthetic(lens_a, 1, kv_a, gen, dev, max_pages)  # the captured buffer set
+    assert len(lens_a) == batch and len(lens_b) == batch
+    print(f"[slide] two-state check {tag} C={c} B={batch}: eager warm-up on a side stream", flush=True)
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        _slide_launch(ext, data, c)
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    print(f"[slide] two-state check {tag} C={c}: warm-up done; capturing once", flush=True)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        out = _slide_launch(ext, data, c)
+    torch.cuda.synchronize()
+    ok = True
+    for name, state, lens in (("A", state_a, lens_a), ("B", state_b, lens_b),
+                              ("A", state_a, lens_a), ("B", state_b, lens_b)):
+        for key, val in state.items():
+            if torch.is_tensor(val):
+                data[key].copy_(val)
+        out.fill_(float("nan"))
+        print(f"[slide] two-state check {tag} C={c}: refilled state {name}, replaying graph ...", flush=True)
+        graph.replay()
+        torch.cuda.synchronize()
+        print(f"[slide] two-state check {tag} C={c}: replay of state {name} done", flush=True)
+        ref = _slide_reference(data, lens)
+        err = float((out.float() - ref).norm() / ref.norm())
+        finite = bool(torch.isfinite(out).all())
+        good = finite and err < 2e-2
+        print(f"[slide] two-state check {tag} C={c} state {name}: rel L2 {err:.2e}, finite {finite} -> "
+              f"{'ok' if good else 'FAIL'}", flush=True)
+        ok = ok and good
+        if not ok:
+            break
+    del graph
+    return ok
+
+
+def _slide_self_check(ext, c: int, tag: str) -> bool:
+    """One-time check at import, on synthetic data only (never in the timed path): cluster size c at
+    batches of the range it serves against the FP32 reference (lens below, at and past the window,
+    window-edge keys, kv scale 1 and 0.25), its new cache rows against master _pre_attention_kernel
+    on cloned caches, then the two-state alternating-replay check."""
+    gen = torch.Generator(device="cuda").manual_seed(4321 + c)
+    dev = torch.device("cuda")
+    ok = True
+    try:
+        for lens, kv_scale in _SLIDE_CASES[c]:
+            data = _slide_synthetic(lens, 1, kv_scale, gen, dev)
+            cfg = data["config"]
+            tokens = cfg["batch"]
+            k_ref, v_ref = data["k_cache"].clone(), data["v_cache"].clone()
+            qkv2 = data["qkv"].reshape(tokens, -1)
+            print(f"[slide] launch master _pre_attention_kernel (reference store) B={tokens} ...", flush=True)
+            _pre_attention_kernel[(tokens, 18)](
+                qkv2, data["positions"], data["cache_loc"], _inv_freq(cfg["rope_theta"], 64, dev),
+                data["k_scale"], data["v_scale"], torch.empty((tokens, 16, 64), dtype=FP8, device=dev),
+                k_ref, v_ref, qkv2.stride(0),
+                HQ=16, HKV=2, D=64, ROPE=True, EPS=RMS_EPS, PAIRED=False, G=8, num_warps=1)
+            torch.cuda.synchronize()
+            print("[slide] launch master _pre_attention_kernel: done", flush=True)
+            out = _slide_run(ext, data, c, f"self-check {tag}").float()
+            ref = _slide_reference(data, lens)
+            err = float((out - ref).norm() / ref.norm())
+            finite = bool(torch.isfinite(out).all())
+            loc = data["cache_loc"]
+            cache_ok = True
+            notes = []
+            for name, mine, master in (("k", data["k_cache"], k_ref), ("v", data["v_cache"], v_ref)):
+                a = mine.view(-1, 2, 64)[loc]
+                m = master.view(-1, 2, 64)[loc]
+                match = float((a.view(torch.uint8) == m.view(torch.uint8)).float().mean())
+                rel = float((a.float() - m.float()).norm() / m.float().norm().clamp_min(1e-30))
+                notes.append(f"{name} match {match:.4f} rel {rel:.1e}")
+                cache_ok = cache_ok and rel < 5e-2  # master Triton RoPE uses fast sin/cos at ~5000 rad; byte match is info only
+            print(f"[slide] self-check {tag} C={c} B={cfg['batch']} kv_scale={kv_scale:g}: rel L2 {err:.2e}, "
+                  f"finite {finite}, cache {', '.join(notes)}", flush=True)
+            ok = ok and finite and err < 2e-2 and cache_ok
+        if ok:
+            ok = _slide_two_state_check(ext, c, tag)
+    except Exception as e:
+        print(f"[slide] self-check {tag} C={c} raised: {e!r}", flush=True)
+        ok = False
+    return ok
+
