+def _slide_interleaved_us(fns, flush, warm=3, reps=20):
+    """Median GPU time per fn of one CUDA-graph replay each, the graphs interleaved round-robin (order
+    flipped every other round), L2 made cold by reading a 256 MB buffer before each replay, with an
+    empty-graph baseline (one 1-element kernel) measured the same way and subtracted. Returns
+    ([median us minus baseline per fn], baseline us)."""
+    scratch = torch.zeros(1, device=flush.device)
+    fns = list(fns) + [lambda: scratch.add_(0)]  # last = the empty-graph baseline
+    graphs = []
+    for fn in fns:
+        side = torch.cuda.Stream()
+        side.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(side):
+            for _ in range(2):
+                fn()
+        torch.cuda.current_stream().wait_stream(side)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            fn()
+        torch.cuda.synchronize()
+        graphs.append(graph)
+    times = [[] for _ in graphs]
+    for it in range(warm + reps):
+        order = list(range(len(graphs)))
+        if it % 2:
+            order.reverse()
+        for i in order:
+            flush.sum()
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            e0.record()
+            graphs[i].replay()
+            e1.record()
+            torch.cuda.synchronize()
+            if it >= warm:
+                times[i].append(e0.elapsed_time(e1) * 1e3)
+    med = [sorted(t)[len(t) // 2] for t in times]
+    del graphs
+    return [m - med[-1] for m in med[:-1]], med[-1]
+
+
+def _slide_timing(ext, c: int, tag: str, flush) -> None:
+    """Print (information only: the route is config-only, no margin gates it) the interleaved
+    cold-L2 graph-replay time of the cluster kernel vs master's Triton _sliding_forward at the
+    largest batch of the band, every sequence holding a full window."""
+    batch = _SLIDE_STATES[c][0]
+    gen = torch.Generator(device="cuda").manual_seed(555 + c)
+    data = _slide_synthetic([8000] * batch, 1, 1.0, gen, torch.device("cuda"))
+    print(f"[slide-time] C={c} B={batch}: timing cluster vs master Triton (interleaved graph replays) ...",
+          flush=True)
+    (t_new, t_old), base = _slide_interleaved_us(
+        [lambda: _slide_launch(ext, data, c), lambda: _sliding_forward(data)], flush)
+    _SLIDE_TIME[c] = (t_new, t_old)
+    print(f"[slide-time] C={c} B={batch} lens 8000 ({tag}): cluster {t_new:.1f} us vs master Triton {t_old:.1f} us "
+          f"(empty-graph baseline {base:.1f} us subtracted; cold L2, interleaved median of 20) -> Triton / cluster "
+          f"{t_old / max(t_new, 1e-3):.3f}x; information only, the band is config-routed", flush=True)
+
