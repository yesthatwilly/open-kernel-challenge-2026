+def _sk_fused_case(tag, lens, kv_scale, grid, gen) -> bool:
+    """One synthetic batch-1 case for the fused kernel (variant 4). The same inputs run twice: master's
+    _pre_attention_kernel + the two-level kernel on cloned caches (the reference), and the fused kernel on
+    the originals. Each launch is announced before and synced + confirmed after. Checks: the fused output
+    against the FP32 reference (< 2e-2) and against the two-level kernel's (rel L2 < 5e-3); the new k/v row
+    against master's (at most 3 of its 128 bytes may differ: Triton's approximate sqrt/div vs IEEE can move
+    an e4m3 rounding tie; rel L2 < 2e-2); every other cache byte unchanged."""
+    dev = torch.device("cuda")
+    data = _splitkv_synthetic(lens, kv_scale, gen, dev)
+    assert _shape_gate(data["config"]) and len(lens) == 1
+    loc = data["cache_loc"]
+    if not bool(torch.equal(data["page_table"].gather(1, (data["cache_seqlens"] - 1).long()[:, None]).reshape(-1)
+                            .long(), loc)):
+        _say(f"[sk4] {tag}: cache_loc is not page_table[seq - 1]: FAIL")
+        return False
+    g = grid or _sm_count(dev)
+    data2 = dict(data)
+    data2["k_cache"], data2["v_cache"] = data["k_cache"].clone(), data["v_cache"].clone()
+    _say(f"[sk4] {tag}: launching _pre_attention_kernel (master reference, cloned caches)")
+    q, qkv2 = _sk_prepare_q(data2)
+    torch.cuda.synchronize()
+    _say(f"[sk4] {tag}: launching splitkv_attn_sk_kernel{_SK_LABELS[3]} (reference) grid {g}")
+    out2, _, _ = _sk_launch(data2, q, qkv2, 3, g)
+    torch.cuda.synchronize()
+    _say(f"[sk4] {tag}: launching splitkv_attn_sk_kernel{_SK_LABELS[4]} grid {g}")
+    out4, _, _ = _sk_launch(data, None, data["qkv"].reshape(1, -1), 4, g)
+    torch.cuda.synchronize()
+    _say(f"[sk4] {tag}: fused kernel returned")
+    e_ref, fin = _rel_l2(out4, _splitkv_reference(data, lens))
+    e_v3, fin2 = _rel_l2(out4, out2.float())
+    ok = fin and fin2 and e_ref < 2e-2 and e_v3 < 5e-3
+    for name in ("k_cache", "v_cache"):
+        a = data[name].view(torch.uint8).view(-1, 128)
+        b = data2[name].view(torch.uint8).view(-1, 128)
+        diff = int((a[loc] != b[loc]).sum())
+        e_row, fin_row = _rel_l2(a[loc].view(FP8).float(), b[loc].view(FP8).float())
+        a, b = a.clone(), b.clone()
+        a[loc] = 0
+        b[loc] = 0
+        same = bool(torch.equal(a, b))
+        _say(f"[sk4] {tag}: {name} new row: {diff}/128 bytes differ from master's, rel L2 {e_row:.2e}, "
+             f"finite {fin_row}, other rows unchanged {same}")
+        ok = ok and fin_row and e_row < 2e-2 and diff <= 3 and same
+    _say(f"[sk4] {tag}: out vs fp32 ref {e_ref:.2e}, vs two-level {e_v3:.2e}, finite {fin and fin2} -> "
+         f"{'ok' if ok else 'FAIL'}")
+    return ok
+
