+def _sk_fused_replay_check(gen) -> "str | None":
+    """Two states, one graph each (kernel_fn on the fused path, captured once per state), replayed
+    alternately with refilled inputs (qkv, caches, page table, rows): each replay is right only if its
+    graph reads its own state's tensors and the tickets were left at 0. The output is poisoned with NaN
+    before each replay."""
+    dev = torch.device("cuda")
+    specs = (([79999], 1.0), ([4096], 0.25))
+    states = [_splitkv_synthetic(lens, kvs, gen, dev) for lens, kvs in specs]
+    graphs, outs = [], []
+    for i, st in enumerate(states):
+        _say(f"[sk4] replay state {i}: eager warm-up of kernel_fn on a side stream")
+        side = torch.cuda.Stream()
+        side.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(side):
+            kernel_fn(st)
+        torch.cuda.current_stream().wait_stream(side)
+        torch.cuda.synchronize()
+        _say(f"[sk4] replay state {i}: capturing kernel_fn")
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            outs.append(kernel_fn(st))
+        graphs.append(graph)
+        torch.cuda.synchronize()
+    for i in range(6):
+        s = (i + i // 2) % 2 if i < 4 else i % 2  # 0 1 1 0 0 1: also back-to-back replays of one graph
+        lens, kvs = specs[s]
+        fresh = _splitkv_synthetic(lens, kvs, gen, dev)
+        for key in ("qkv", "page_table", "cache_loc", "cache_seqlens", "k_cache", "v_cache", "positions", "seq_lens"):
+            states[s][key].copy_(fresh[key])
+        outs[s].fill_(float("nan"))
+        torch.cuda.synchronize()
+        _say(f"[sk4] replay {i}: launching state {s}'s graph (splitkv_attn_sk_kernel{_SK_LABELS[4]})")
+        graphs[s].replay()
+        torch.cuda.synchronize()
+        err, finite = _rel_l2(outs[s], _splitkv_reference(states[s], lens))
+        ok = finite and err < 2e-2
+        _say(f"[sk4] replay {i} state {s} (refilled): rel L2 {err:.2e}, finite {finite} -> {'ok' if ok else 'FAIL'}")
+        if not ok:
+            return f"alternating graph replay {i} (state {s})"
+    del graphs
+    return None
+
