+def _sk_fused_gate(gen):
+    """Interleaved graph-replay A/B at B=1 x 80000 keys: [pre-attention + two-level kernel] (the
+    path it replaces) vs [fused two-level kernel], plus an empty-graph baseline subtracted from both.
+    Cold L2 (256 MB flush) before every replay, 4 warm-up + 41 timed repetitions, the order rotating each
+    repetition. Returns (old_us, new_us, ratio) with the baseline subtracted, medians."""
+    global _FUSED_B1
+    dev = torch.device("cuda")
+    data = _splitkv_synthetic([79999], 1.0, gen, dev)
+    graphs = {}
+    try:
+        for name, fused in (("old", False), ("new", True)):
+            _FUSED_B1 = fused
+            side = torch.cuda.Stream()
+            side.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(side):
+                kernel_fn(data)
+            torch.cuda.current_stream().wait_stream(side)
+            torch.cuda.synchronize()
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                kernel_fn(data)
+            graphs[name] = graph
+            torch.cuda.synchronize()
+    finally:
+        _FUSED_B1 = False
+    tiny = torch.zeros(1, dtype=torch.float32, device=dev)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        tiny.add_(1.0)
+    graphs["base"] = graph
+    torch.cuda.synchronize()
+    flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+    times = {k: [] for k in graphs}
+    orders = (("old", "new", "base"), ("base", "new", "old"))
+    for rep in range(45):
+        for name in orders[rep % 2]:
+            flush.zero_()
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            e0.record()
+            graphs[name].replay()
+            e1.record()
+            torch.cuda.synchronize()
+            if rep >= 4:
+                times[name].append(e0.elapsed_time(e1) * 1e3)
+    med = {k: sorted(v)[len(v) // 2] for k, v in times.items()}
+    old, new = med["old"] - med["base"], med["new"] - med["base"]
+    _say(f"[sk4] gate B=1 x 80000 keys, graph replay, cold L2, 41 interleaved reps: pre-attention + two-level "
+         f"{med['old']:.2f} us, fused {med['new']:.2f} us, empty graph {med['base']:.2f} us "
+         f"(baseline subtracted: {old:.2f} vs {new:.2f} us)")
+    del flush, graphs
+    torch.cuda.empty_cache()
+    return old, new, (old / new if new > 0 else 0.0)
