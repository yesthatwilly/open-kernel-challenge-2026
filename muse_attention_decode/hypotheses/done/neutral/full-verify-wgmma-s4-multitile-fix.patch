+        s0, s1 = c * total // grid, (c + 1) * total // grid
+        if s0 >= s1:
+            continue
+        for b in range(len(lens)):
+            lo, hi = max(s0, pre[b]), min(s1, pre[b + 1])
+            if lo < hi:
+                segs.append((c, b, lo, hi, s0, s1))
+    return pre, segs
