+def _wg_segments(lens, grid):
+    """The kernel's work split, on the host: request prefix of 64-token tiles and every (CTA, request)
+    segment (CTA c owns flat tiles [floor(c T / grid), floor((c + 1) T / grid)), slot c + b)."""
+    pre = [0]
