+constexpr int D = 64;              // head dim
+constexpr int HQ = 16;             // query heads
+constexpr int HKV = 2;             // kv heads
+constexpr int G = HQ / HKV;        // queries per kv head (8)
+constexpr int ROW = HKV * D;       // bytes per cache row (page 1: both kv heads, 128)
+constexpr int TILE = 64;           // tokens per pipeline tile
+constexpr int STAGES = 4;
+constexpr int THREADS = 256;
+constexpr int WARPS = THREADS / 32;
+constexpr int MAXB = 64;
+constexpr int STAGE_BYTES = 2 * TILE * ROW;                  // K tile + V tile = 16 KB
+constexpr int RING_OFF = 0;
+constexpr int IDX_OFF = RING_OFF + STAGES * STAGE_BYTES;     // int32 [2][CHUNK]
+// Shared-memory layout as constexpr functions of the work-item size CHUNK (tokens per item).
+__host__ __device__ constexpr int q_off(int chunk) { return IDX_OFF + 2 * chunk * 4; }                // e4m3 [2][HQ][D]
+__host__ __device__ constexpr int acc_off(int chunk) { return q_off(chunk) + 2 * HQ * D; }            // f32 [WARPS][G][D]
+__host__ __device__ constexpr int ml_off(int chunk) { return acc_off(chunk) + WARPS * G * D * 4; }    // f32 [WARPS][G][2]
+__host__ __device__ constexpr int seq_off(int chunk) { return ml_off(chunk) + WARPS * G * 2 * 4; }    // int32 [MAXB]
+__host__ __device__ constexpr int pre_off(int chunk) { return seq_off(chunk) + MAXB * 4; }            // int32 [MAXB + 1]
+__host__ __device__ constexpr int smem_a(int chunk) { return pre_off(chunk) + (MAXB + 4) * 4; }
+
+__device__ __forceinline__ uint32_t smem_u32(const void* p) {
+  return static_cast<uint32_t>(__cvta_generic_to_shared(p));
+}
+__device__ __forceinline__ void cp_async16(uint32_t dst, const void* src, int src_bytes) {
+  asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;\n" :: "r"(dst), "l"(src), "r"(src_bytes) : "memory");
+}
+__device__ __forceinline__ void cp_async4(uint32_t dst, const void* src, int src_bytes) {
+  asm volatile("cp.async.ca.shared.global [%0], [%1], 4, %2;\n" :: "r"(dst), "l"(src), "r"(src_bytes) : "memory");
