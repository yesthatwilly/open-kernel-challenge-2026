+_C320_ROUTE = False  # FD1 on chunk320; set once at import by GATE A (read-only in kernel_fn)
+_C320_ARCH_FLAGS = None
+_C320_GATE = 0.98  # route only if [kernel_fn route on] / [kernel_fn route off] <= this
+_TILED_GATE = 0.98  # route a verify class only if its whole-step ratio tiled / master <= this
+_TILED_ROUTE = {}   # verify class -> True; frozen to a MappingProxyType at import (empty = master everywhere)
+_TILED_CLASSES = ("SV1", "SV16", "SV32", "FV1", "FV16", "FV32")
