+def _sd_setup() -> None:
+    """Validate the TOK = 1 kernels, gate each band against master Triton on printed timings, replay-check the
+    routed bands with two states, and freeze _SD_ROUTE. Any failure leaves sliding decode on Triton; nothing
+    here raises."""
+    global _SD_ROUTE
+    dev = torch.device("cuda")
+    _ps_ticket(dev)
+    _ps_gticket(dev)
+    if not _PS_BUILT or _EXT2 is None:
+        _say("PATH CHOSEN: sliding decode Triton (fallback: PSEUDO build or stage-2 module unavailable)")
+        return
+    try:
+        reason = _sd_validate()
+    except Exception as e:
+        reason = f"self-check raised {e!r}"
+    if reason is not None:
+        _say(f"PATH CHOSEN: sliding decode Triton (fallback: {reason})")
+        return
+    sms = _sm_count(dev)
+    gen = torch.Generator(device="cuda").manual_seed(9753)
+    flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+    choice, nums = {}, {}
+    for band, batch in ((1, 1), (2, 16), (3, 32)):
+        try:
+            c, n = _sd_gate_band(batch, gen, flush, sms)
+        except Exception as e:
+            _say(f"[sd-gate] B={batch} raised (band stays on Triton): {e!r}")
+            c, n = None, None
+        nums[band] = n
+        if c is not None:
+            choice[band] = c
+    del flush
+    torch.cuda.empty_cache()
+    route = {}
+    if choice:
+        rng = random.Random(78)
+        lens32 = [rng.randint(1, 12000) for _ in range(32)]
+        lens32[0], lens32[1] = 80000, 2047
+        replay = {2: (16, [80000] + _SK_LENS16[1:], 0.25), 3: (32, lens32, 1.0)}
+        _SD_ROUTE.update(choice)
+        for band in sorted(choice):
+            batch, lens, kv_scale = replay[band]
+            try:
+                why = _sd_replay_check(batch, lens, kv_scale, gen)
+            except Exception as e:
+                why = f"replay raised {e!r}"
+            if why is not None:
+                _say(f"[sd] band {_PS_BAND_NAMES[band]} dropped to Triton ({why})")
+                _SD_ROUTE.pop(band, None)
+        left = int(_ps_ticket(dev).abs().sum().item()) + int(_ps_gticket(dev).abs().sum().item())
+        _say(f"[sd] tickets (both levels) after the replay checks: sum {left}")
+        if left:
+            _SD_ROUTE.clear()
+            _say("[sd] tickets not reset: every band dropped to Triton")
+        route = dict(_SD_ROUTE)
+    _SD_ROUTE = MappingProxyType(route)  # frozen: kernel_fn only reads it
+    for band in (1, 2, 3):
+        n = nums.get(band)
+        timing = ""
+        if n is not None and n[1]:
+            net, v, spec, g = min(n[1])
+            timing = f"; best printed pair {net:.1f} us net vs Triton {n[0]:.1f} us net ({n[0] / net:.3f}x)"
+        if band in _SD_ROUTE:
+            v, spec = _SD_ROUTE[band]
+            _say(f"PATH CHOSEN: sliding decode {_PS_BAND_NAMES[band]}: [pre-attn + stream-K sk window] {_SK_LABELS[v]} "
+                 f"grid {spec}{timing} (>= 1.05x)")
+        else:
+            _say(f"PATH CHOSEN: sliding decode {_PS_BAND_NAMES[band]}: master Triton _sliding_fused_kernel "
+                 f"(sk window not >= 1.05x in the printed timings, recorded only, or failed a check){timing}")
+
