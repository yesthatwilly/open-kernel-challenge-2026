+    _say(f"[sd-gate] B={batch}: empty graph replay {base:.1f} us (subtracted from every number below)")
+    t_tri = max(t["triton"] - base, 0.5)
+    _say(f"[sd-gate] B={batch}: master Triton _sliding_fused_kernel: {t['triton']:7.1f} us raw, {t_tri:7.1f} us net")
+    results = []
