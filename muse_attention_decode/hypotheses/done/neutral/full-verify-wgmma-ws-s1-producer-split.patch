+# The per-kernel setup shared by both kernels (smem carve-up differs, so each kernel declares its own pointers first).
+_WSV1_KERNELS = r"""
+template <int TL, int STAGES>
+struct WsLay {
+  static constexpr int STAGE_BYTES = 2 * TL * ROW;                       // K tile + V tile
+  static constexpr int VT_BYTES = D * TL;                                // one head's V^T: 64 dims x TL tokens
+  static constexpr int RING_OFF = 0;
+  static constexpr int VT_OFF = RING_OFF + STAGES * STAGE_BYTES;         // [HKV][2 buffers][VT_BYTES]
+  static constexpr int SEQ_OFF = VT_OFF + HKV * 2 * VT_BYTES;            // int32 [MAXB]
+  static constexpr int PRE_OFF = SEQ_OFF + MAXB * 4;                     // int32 [MAXB + 4]
+  static constexpr int BAR_OFF = PRE_OFF + (MAXB + 4) * 4;               // u64 FULL[STAGES], EMPTY[STAGES]
+  static constexpr int FLAG_OFF = BAR_OFF + 2 * STAGES * 8;              // int abort, last[HKV], pad
+  static constexpr int QS_OFF = FLAG_OFF + 16;                           // u32 [8][CT]: each thread's own Q A fragment
+  static constexpr int SMEM_USED = QS_OFF + 8 * CT * 4;
+  static constexpr int SMEM_A = SMEM_USED + 1024;                        // slack: the base is rounded up to 1024 B
+  static_assert(RING_OFF % 1024 == 0 && VT_OFF % 1024 == 0 && STAGE_BYTES % 1024 == 0 && VT_BYTES % 1024 == 0,
+                "swizzle atom alignment");
+  static_assert(BAR_OFF % 8 == 0, "mbarrier alignment");
+  static_assert(SMEM_A <= 227 * 1024, "dynamic shared memory exceeds the 227 KB per-CTA limit");
+};
+
+template <int STAGES>
+struct C2Lay {
+  static constexpr int STG8 = 2 * 64 * 64;                               // per-warpgroup stage: K 4 KB + V 4 KB (head g only)
+  static constexpr int VT_BYTES = D * 64;
+  static constexpr int RING_OFF = 0;                                     // [HKV][STAGES][STG8]
+  static constexpr int VT_OFF = RING_OFF + HKV * STAGES * STG8;          // [HKV][2][VT_BYTES]
+  static constexpr int SEQ_OFF = VT_OFF + HKV * 2 * VT_BYTES;
+  static constexpr int PRE_OFF = SEQ_OFF + MAXB * 4;
+  static constexpr int BAR_OFF = PRE_OFF + (MAXB + 4) * 4;               // FULL[HKV][STAGES], EMPTY[HKV][STAGES]
+  static constexpr int FLAG_OFF = BAR_OFF + 2 * HKV * STAGES * 8;
+  static constexpr int QS_OFF = FLAG_OFF + 16;
+  static constexpr int SMEM_USED = QS_OFF + 8 * CT * 4;
+  static constexpr int SMEM_A = SMEM_USED + 1024;
+  static_assert(VT_OFF % 1024 == 0 && STG8 % 1024 == 0 && VT_BYTES % 1024 == 0, "swizzle atom alignment");
+  static_assert(BAR_OFF % 8 == 0, "mbarrier alignment");
+  static_assert(2 * (SMEM_A + 1024) <= 227 * 1024, "two CTAs per SM do not fit in shared memory");
+};
+
+// ---- variants 0, 1, 3: warp-specialized, 384 threads, 1 CTA/SM.
+template <int TL, int STAGES, bool DUAL, bool DBG>
+__global__ void __launch_bounds__(384, 1)
+wsv1_ws_kernel(const uint8_t* __restrict__ q,          // e4m3 [B * QL, HQ, D]
+               const uint8_t* __restrict__ kc,         // e4m3 [rows, ROW]
+               const uint8_t* __restrict__ vc,         // e4m3 [rows, ROW]
+               int64_t rows,
+               const int* __restrict__ page_table, int64_t pt_stride,
+               const int* __restrict__ seqlens, int B,
+               const float* __restrict__ k_scale, const float* __restrict__ v_scale,
+               float score_scale,
+               const __nv_bfloat16* __restrict__ qkv, int64_t qkv_stride,
+               __nv_bfloat16* out, float eps,
+               float* ws_acc,                          // f32 [grid + B, QL, HQ, D]
+               float* ws_ml,                           // f32 [grid + B, 2, QL * HQ]
+               int* ticket,                            // int32 [MAXB * HKV], 0 between launches
+               int* err,
+               float* dbg,                             // DBG only: phase cycle counters
+               int go) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  using L = WsLay<TL, STAGES>;
+  constexpr int NS = TL / 2;      // S accumulator registers per thread
+  constexpr int NB = TL / 8;      // 8-token column blocks
+  constexpr int NK = TL / 32;     // PV k-steps (32 tokens each)
+  constexpr int VTB = L::VT_BYTES;
+  constexpr int PRODR = 56, CONSR = 224;  // 128 * 56 + 256 * 224 = 64512 registers
+  extern __shared__ __align__(1024) uint8_t wsv1_smem[];
+  // Swizzle atoms need 1024-byte-aligned bases: round the dynamic base up (SMEM_A has slack).
+  uint8_t* smem = wsv1_smem + ((1024u - (smem_u32(wsv1_smem) & 1023u)) & 1023u);
+  uint8_t* ring = smem + L::RING_OFF;
+  int* seq_s = reinterpret_cast<int*>(smem + L::SEQ_OFF);
+  int* pre_s = reinterpret_cast<int*>(smem + L::PRE_OFF);
+  volatile int* flag_s = reinterpret_cast<volatile int*>(smem + L::FLAG_OFF);  // [0] abort, [1 + g] last
+  const uint32_t ring_u = smem_u32(ring);
+  const uint32_t vt_u = smem_u32(smem + L::VT_OFF);
+  const uint32_t bar_u = smem_u32(smem + L::BAR_OFF);
