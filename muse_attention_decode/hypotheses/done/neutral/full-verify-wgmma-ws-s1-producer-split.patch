+def _ws_setup() -> None:
+    """Build, image check, quick check per variant, two-round gate per band, full self-check of the routed variants, then the
+    DIAGs. Any failure lands on master's paired FA3 path; every phase has its own start deadline. The compact PATH CHOSEN / GATE
+    summary is repeated as the LAST lines (the judge keeps only the log tail)."""
+    global _WSX, _WS_ERR, _WS_ROUTE, _WS_FORCE, _WS_GO, _WS_DBG, _WS_GRID, _WS_HOOK, _WS_KEEP, _WS_ANYB
+    summary = []
+    if torch.cuda.get_device_capability() != (9, 0):
+        _say("PATH CHOSEN: full verify B=16/B=32: master FA3 paired heads (wsv1 skipped: not an sm_90 device)")
+        return
+    if _ws_late("build", _WS_BUILD_BY):
+        _say("PATH CHOSEN: full verify B=16/B=32: master FA3 paired heads (wsv1 build skipped: deadline)")
+        return
+    ext, reason = _build_ws()
+    if ext is None:
+        _say(f"PATH CHOSEN: full verify B=16/B=32: master FA3 paired heads (wsv1 {reason})")
+        return
+    _WSX = ext
+    _WS_ERR = torch.zeros(1, dtype=torch.int32, device="cuda")
+    _ws_tickets(torch.device("cuda"))
+    usable = _ws_image_check()
+    ok = {}
+    try:
+        for v in (0, 1, 2):
+            if usable[v] is not None:
+                summary.append(f"GATE {_WS_NAMES[v]}: refused ({usable[v]})")
+                continue
+            if _ws_late(f"quick check {_WS_NAMES[v]}", _WS_QUICK_BY):
+                summary.append(f"GATE {_WS_NAMES[v]}: skipped: deadline (quick check)")
+                continue
+            good, why = _ws_selfcheck(v, True)
+            if good:
+                ok[v] = True
+            else:
+                summary.append(f"GATE {_WS_NAMES[v]}: quick check FAILED ({why})")
+        best = {}
+        if ok and not _ws_late("gate timing", _WS_GATE_BY):
+            gen = torch.Generator(device="cuda").manual_seed(99)
+            flush = torch.empty(64 << 20, dtype=torch.float32, device="cuda")  # 256 MB > L2
+            scratch = torch.zeros(16, dtype=torch.float32, device="cuda")
+            for B in (16, 32):
+                try:
+                    res = _ws_gate_band(B, sorted(ok), gen, flush, scratch)
+                except Exception as e:
+                    _say(f"[ws-gate] B={B} raised ({e!r}): band stays on master")
+                    summary.append(f"GATE B={B}: raised {type(e).__name__}")
+                    continue
+                order = sorted((v for v in res if res[v][1]), key=lambda v: -res[v][0])
+                for v in res:
+                    summary.append(f"GATE B={B} {_WS_NAMES[v]}: min ratio {res[v][0]:.3f}x -> {'clears' if res[v][1] else 'fails'}")
+                best[B] = order
+            del flush
+        full = {}
+        route = {}
+        for B in (16, 32):
+            for v in best.get(B, []):
+                if v not in full:
+                    if _ws_late(f"full self-check {_WS_NAMES[v]}", _WS_FULL_BY):
+                        full[v] = False
+                        summary.append(f"GATE {_WS_NAMES[v]}: full self-check skipped: deadline")
+                    else:
+                        good, why = _ws_selfcheck(v, False)
+                        full[v] = good
+                        if not good:
+                            summary.append(f"GATE {_WS_NAMES[v]}: full self-check FAILED ({why})")
+                if full[v]:
+                    route[B] = v
+                    break
+        _WS_ROUTE = MappingProxyType(route)
+        # DIAGs (informational, never gating) once the decision is frozen.
+        gen = torch.Generator(device="cuda").manual_seed(31)
+        if not _ws_late("roofline / phase DIAGs", _WS_DIAG_BY):
+            flush = torch.empty(64 << 20, dtype=torch.float32, device="cuda")  # 256 MB > L2
+            for v in sorted(ok):
+                try:
+                    _ws_diag_gather(v, 16, gen, flush)
+                except Exception as e:
+                    _say(f"[ws-diag] gather-only {_WS_NAMES[v]} raised {e!r}")
+            del flush
+            if usable.get(3) is None and 0 in ok:
+                try:
+                    _ws_diag_phases(16, gen)
+                except Exception as e:
+                    _say(f"[ws-diag] PHASE DIAG raised {e!r}")
+    except Exception as e:  # never raise at import: master's path everywhere
+        _WS_ROUTE = MappingProxyType({})
+        summary.append(f"setup raised {type(e).__name__}")
+        _say(f"[ws] setup raised {e!r}: every band on master")
+    finally:
+        # Setup-only overrides must never survive into the timed path (a gate exception can leave a forced variant behind).
+        _WS_FORCE, _WS_GO, _WS_DBG, _WS_GRID, _WS_HOOK, _WS_KEEP, _WS_ANYB = None, 0, None, None, None, None, False
+        try:
+            _ws_tickets(torch.device("cuda")).zero_()
+            torch.cuda.synchronize()
+        except Exception as e:
+            _say(f"[ws] ticket re-zero raised: {e!r}")
+    for B in (16, 32):
+        v = _WS_ROUTE.get(B)
+        summary.append(f"PATH CHOSEN: full verify B={B} band ({'1..24' if B == 16 else '25..64'}): "
+                       + (f"wsv1 {_WS_NAMES[v]} ({_WS_KERNELS[v]})" if v is not None else "master FA3 paired heads (wsv1 did not clear every gate)"))
+    for line in summary:
+        _say("[ws-summary] " + line if not line.startswith("PATH CHOSEN") else line)
+
