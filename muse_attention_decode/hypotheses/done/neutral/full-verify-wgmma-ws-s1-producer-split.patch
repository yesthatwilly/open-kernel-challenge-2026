+      mbar_init(bar_u + 8 * s, 128);                 // FULL[s]: one noinc arrival per producer thread
+      mbar_init(bar_u + 8 * (STAGES + s), CT);       // EMPTY[s]: one arrival per consumer thread
+    }
+    flag_s[0] = 0;
+    flag_s[1] = 0;
+    flag_s[2] = 0;
+    fence_mbar_init();
+  }
+  __syncthreads();
+  if (warp == 0) tile_prefix(seq_s, pre_s, B, lane, TL);
+  __syncthreads();
+  const int Ttot = pre_s[B];
+  const int s0 = start_of(bx, Ttot, gx), s1 = start_of(bx + 1, Ttot, gx);
+  if (s0 >= s1) return;  // empty range (grid > Ttot): writes nothing; uniform over the CTA
+  const int N = s1 - s0;  // tiles of this CTA, one flat pipeline (phases of every barrier are tracked on this index)
+  const float scale = score_scale * __ldg(k_scale);  // sm_scale * qk_scale_factor * log2(e) * k_scale
+  const int bfirst = req_of(pre_s, B, s0);
+  const int wg = warp >> 2;
+
+  // Bounded mbarrier wait: on timeout set the CTA abort flag and the device error flag; once the abort flag is set every wait
+  // returns at once, so the CTA runs to the end (garbage, no hang).
+  auto wait_bar = [&](uint32_t a, uint32_t parity) {
+    if (mbar_try_wait(a, parity)) return;
+    const long long t0 = clock64();
+    while (!flag_s[0]) {
+      if (mbar_try_wait(a, parity)) return;
+      if (clock64() - t0 > WAIT_LIMIT) {
+        flag_s[0] = 1;
