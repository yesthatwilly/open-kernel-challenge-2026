+# ---- synthetic data / reference (the gated verify shape: full layer, q_len 8, tp8, page 1), as stage 5's self-check built them.
+
+def _wsv_synth(lens, kv_scale, gen, device, coherent=False):
+    """lens are cache_seqlens (seq_lens + 8). Scattered pages, odd page-table stride, 8 positions / cache rows per request."""
+    batch, length, hq, hkv, d = len(lens), 8, 16, 2, 64
+    max_pages = max(lens) + 37
+    total = batch * max_pages
+    perm = torch.randperm(total, generator=gen, device=device).to(torch.int32)
+    page_table = torch.full((batch, max_pages), -1, dtype=torch.int32, device=device)
+    off = 0
+    for b, n in enumerate(lens):
+        page_table[b, :n] = perm[off:off + n]
+        off += n
+    seq = torch.tensor([n - length for n in lens], dtype=torch.int64, device=device)
+    pos = seq[:, None] + torch.arange(length, dtype=torch.int64, device=device)[None, :]
+    k_cache = (torch.randn((total, 1, hkv, d), generator=gen, device=device) / kv_scale).to(FP8)
+    v_cache = (torch.randn((total, 1, hkv, d), generator=gen, device=device) / kv_scale).to(FP8)
+    qkv = (2 * torch.randn((batch, length, (2 * hq + 2 * hkv) * d), generator=gen, device=device)).to(torch.bfloat16)
+    if coherent:
+        # Low-norm noise keys plus a few planted keys per request and kv head along the block's last query: a peaked softmax
+        # with a long low-weight tail (the regime that exercises the FP8 P operand's Max_offset 8 range).
+        kf = k_cache.float() * 0.3
+        qn = qkv[..., :hq * d].float().reshape(batch, length, hq, d)
+        qn = qn * torch.rsqrt(qn.pow(2).mean(-1, keepdim=True) + RMS_EPS)
+        for b, n in enumerate(lens):
+            rows = page_table[b, torch.randperm(n, generator=gen, device=device)[:4]].long()
+            for g in range(hkv):
+                kf[rows, 0, g] = qn[b, length - 1, g * (hq // hkv)] * (0.35 / kv_scale)
+        k_cache = kf.to(FP8)
+    return {
+        "qkv": qkv,
+        "positions": pos.reshape(-1).clone(),
+        "cache_loc": torch.gather(page_table.long(), 1, pos).reshape(-1),
+        "cache_seqlens": (seq + length).to(torch.int32),
+        "cu_seqlens_q": torch.arange(0, batch + 1, dtype=torch.int32, device=device) * length,
+        "scheduler_metadata": None,
+        "k_cache": k_cache,
+        "v_cache": v_cache,
+        "k_scale": torch.tensor(kv_scale, dtype=torch.float32, device=device),
+        "v_scale": torch.tensor(kv_scale, dtype=torch.float32, device=device),
+        "page_table": page_table,
+        "seq_lens": seq.to(torch.int32),
+        "config": {"batch": batch, "q_len": length, "num_q_heads": hq, "num_kv_heads": hkv, "head_dim": d,
+                   "page_size": 1, "window": 0, "rope_theta": 0.0, "qk_scale_factor": 5.4730064863875,
+                   "sm_scale": d ** -0.5, "kv_scale": kv_scale},
+    }
+
+
+def _wsv_ref(data, lens):
+    """FP32 causal attention over the cache as kernel_fn left it (the block's own keys included), FP8 queries: block token i
+    of request b sees keys t <= cache_seqlens[b] - 8 + i; then the master epilogue."""
+    cfg = data["config"]
+    batch, length = cfg["batch"], cfg["q_len"]
+    hq, hkv, d = cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"]
+    qkv = data["qkv"].reshape(batch, length, -1).float()
+    q = qkv[..., :hq * d].reshape(batch, length, hq, d)
+    q = q * torch.rsqrt(q.pow(2).mean(-1, keepdim=True) + RMS_EPS)
+    q = q.to(FP8).float() * cfg["qk_scale_factor"]
+    kf = data["k_cache"].view(-1, hkv, d)
+    vf = data["v_cache"].view(-1, hkv, d)
+    outs = []
+    for b, n in enumerate(lens):
+        rows = data["page_table"][b, :n].long()
+        keys = (kf[rows].float() * data["k_scale"]).repeat_interleave(hq // hkv, dim=1)
+        vals = (vf[rows].float() * data["v_scale"]).repeat_interleave(hq // hkv, dim=1)
+        s = torch.einsum("lhd,nhd->lhn", q[b], keys) * cfg["sm_scale"]
+        t = torch.arange(n, device=s.device)
+        lim = n - length + torch.arange(length, device=s.device)
+        s = s.masked_fill((t[None, :] > lim[:, None])[:, None, :], float("-inf"))
+        p = torch.softmax(s, dim=-1)
+        outs.append(torch.einsum("lhn,nhd->lhd", p, vals))
+    a = torch.stack(outs)
+    a = a * torch.rsqrt(a.pow(2).mean(-1, keepdim=True) + RMS_EPS)
+    gate = qkv[..., (hq + 2 * hkv) * d:].reshape(batch, length, hq, d)
+    return (a * torch.sigmoid(gate)).reshape(batch, length, hq * d)
+
+
+def _ws_trace(msg: str) -> None:
+    """Hook between launches: wait for the GPU, then say what finished, so a fault is attributed to the kernel before it."""
+    torch.cuda.synchronize()
+    print(f"[ws]   {msg}", flush=True)
+
+
+def _ws_lens80(B: int):
+    """The scored shapes' lengths: ctx 80000, agentic spread (uniform within +/- 7.5%)."""
+    return [int(80000 * (1 + 0.075 * (2 * ((i * 7) % 13) / 12 - 1))) for i in range(B)]
+
+
+_WS_LENS_A = [9000, 1025, 70, 4097, 1023, 8]
+_WS_LENS_B = [129, 66, 195, 260, 69, 70, 71, 9, 15, 8, 64, 65, 3000]
+# (name, lens, kv_scale, grid, coherent, second eager call). Stage 5's 19-case bisect table plus a 100-tile single request
+# (many ring wraps and barrier phase flips) and a 2-grid-CTA multi-request case.
+_WS_CASES = [("canary", [70, 13], 1.0, 4, False, False),
+             ("single-tile-lens_a-device", _WS_LENS_A, 1.0, None, False, True),
+             ("lens_a-grid3-kv1", _WS_LENS_A, 1.0, 3, False, False),
+             ("kv0.25-grid264", _WS_LENS_A, 0.25, 264, False, False),
+             ("B1-2t", [128], 1.0, 1, False, False),
+             ("B1-4t", [256], 1.0, 1, False, False),
+             ("B1-17t", [1088], 1.0, 1, False, False),
+             ("B1-34t", [2176], 1.0, 1, False, False),
+             ("B1-100t", [6400], 1.0, 1, False, False),
+             ("B1-4t-kv0.25", [256], 0.25, 1, False, False),
+             ("cross-2req-4t", [128, 128], 1.0, 1, False, False),
+             ("mid-1t-B1-3t-grid3", [192], 1.0, 3, False, False),
+             ("mid-1t-2req-grid3", [128, 128], 1.0, 3, False, False),
+             ("lens_a-grid3-kv0.25", _WS_LENS_A, 0.25, 3, False, False),
+             ("lens_a-grid7-kv1", _WS_LENS_A, 1.0, 7, False, False),
+             ("lens_a-grid61-kv0.25", _WS_LENS_A, 0.25, 61, False, False),
+             ("lens_b-device", _WS_LENS_B, 1.0, None, False, True),
+             ("lens_b-grid7-kv0.25", _WS_LENS_B, 0.25, 7, False, False),
+             ("coherent-lens_a-grid3", _WS_LENS_A, 1.0, 3, True, False),
+             ("coherent-lens_a-device", _WS_LENS_A, 1.0, None, True, False)]
+_WS_QUICK = ("canary", "single-tile-lens_a-device")
+
+
+def _ws_selfcheck(v: int, quick: bool):
+    """In-process eager check of variant v on synthetic data through kernel_fn (every launch traced: sync + print, the device
+    ERROR WORD printed per case). quick: the canary and the device-grid case only. Full: every case (all run even after a
+    failure, so one check bisects the failing variable), a second eager call on some, then the two-state alternating graph replay.
+    Returns (ok, reason)."""
+    global _WS_FORCE, _WS_GRID, _WS_HOOK, _WS_ANYB, _WS_KEEP
+    gen = torch.Generator(device="cuda").manual_seed(4321)
+    dev = torch.device("cuda")
+    tag = f"{_WS_NAMES[v]}{' quick' if quick else ''}"
+    _WS_FORCE = v
+    _WS_ANYB = True
+    results, fails = {}, []
+    try:
+        for name, lens, kv_scale, grid, coherent, second in _WS_CASES:
+            if quick and name not in _WS_QUICK:
+                continue
+            data = _wsv_synth(lens, kv_scale, gen, dev, coherent)
+            assert _ws_variant(data["config"]) == v
+            _WS_GRID = grid
+            _WS_ERR.zero_()
+            keep = {}
+            _WS_KEEP = keep
+            print(f"[ws] {tag} {name}: B={len(lens)} kv_scale={kv_scale} grid={grid or 'device'} coherent={coherent}; "
+                  f"launching kernel_fn (pre-attention first)", flush=True)
+            _WS_HOOK = _ws_trace
+            out = kernel_fn(data)
+            _WS_HOOK = None
+            _WS_KEEP = None
+            torch.cuda.synchronize()
+            flag = int(_WS_ERR.item())
+            ref = _wsv_ref(data, lens)
+            err = float((out.float() - ref).norm() / ref.norm())
+            finite = bool(torch.isfinite(out).all())
+            passed = finite and err < 3e-2 and not flag
+            results[name] = passed
+            print(f"[ws] {tag} {name}: rel L2 {err:.2e}, finite {finite}, ERROR WORD {flag} "
+                  f"(1: not sm_90a, 2: mbarrier wait timeout, 4: shape) -> {'PASS' if passed else 'FAIL'}", flush=True)
+            if not passed:
+                fails.append((name, err, finite, flag))
+                continue
+            if second and not quick:
+                again = kernel_fn(data)
+                torch.cuda.synchronize()
+                same = bool(torch.equal(again, out))
+                print(f"[ws] {tag} {name}: second eager call identical {same}", flush=True)
+                if not same or int(_WS_ERR.item()):
+                    fails.append((name + " (second call)", float("nan"), True, int(_WS_ERR.item())))
+        print(f"[ws] {tag} BISECT table: " + ", ".join(f"{k}={'ok' if r else 'FAIL'}" for k, r in results.items()), flush=True)
+        if fails:
+            n, e, f, w = fails[0]
+            return False, f"{n}, rel L2 {e:.2e}, finite {f}, error word {w}"
+        if not quick:
+            ok2, why2 = _ws_two_state_check(v, gen, dev)
+            if not ok2:
+                return False, why2
+    except Exception as e:
+        print(f"[ws] {tag} self-check raised: {e!r}", flush=True)
+        return False, f"raised {type(e).__name__}"
+    finally:
+        _WS_GRID = None
+        _WS_HOOK = None
+        _WS_KEEP = None
+        _WS_ANYB = False
+        _WS_FORCE = None
+        try:  # a failed or aborted case may leave tickets dirty: clean them so the next variant starts from 0
+            torch.cuda.synchronize()
+            _ws_tickets(dev).zero_()
+        except Exception as e:
+            print(f"[ws] ticket re-zero after self-check raised: {e!r}", flush=True)
+    return True, None
+
+
+def _ws_refill(data, gen, kv_scale=1.0) -> None:
+    """Overwrite a state's qkv / k_cache / v_cache IN PLACE with fresh random values (the judge refills its inputs between
+    repetitions); page table, lengths and every pointer stay."""
+    dev = data["qkv"].device
+    data["qkv"].copy_((2 * torch.randn(data["qkv"].shape, generator=gen, device=dev)).to(torch.bfloat16))
+    data["k_cache"].copy_((torch.randn(data["k_cache"].shape, generator=gen, device=dev) / kv_scale).to(FP8))
+    data["v_cache"].copy_((torch.randn(data["v_cache"].shape, generator=gen, device=dev) / kv_scale).to(FP8))
+
+
+def _ws_two_state_check(v: int, gen, dev):
+    """Two states, one CUDA graph each (variant v forced), alternating replays with refilled inputs (A B A B B A), each compared
+    with the fp32 reference of its own state. Nothing in the kernel may hold a pointer into either state."""
+    tag = _WS_NAMES[v]
+    states = [_wsv_synth(_WS_LENS_A, 1.0, gen, dev) for _ in range(2)]
+    assert _ws_variant(states[0]["config"]) == v
+    _WS_ERR.zero_()
+    for i, d in enumerate(states):
+        print(f"[ws] {tag} two-state: eager warm-up of state {'AB'[i]}", flush=True)
+        side = torch.cuda.Stream()
+        side.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(side):
+            kernel_fn(d)
+        torch.cuda.current_stream().wait_stream(side)
+        torch.cuda.synchronize()
+    graphs, outs = [], []
+    for i, d in enumerate(states):
+        print(f"[ws] {tag} two-state: capturing graph of state {'AB'[i]}", flush=True)
+        g = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(g):
+            outs.append(kernel_fn(d))
+        torch.cuda.synchronize()
+        graphs.append(g)
+    worst = 0.0
+    for step, i in enumerate((0, 1, 0, 1, 1, 0)):
+        _ws_refill(states[i], gen)
+        outs[i].fill_(float("nan"))
+        print(f"[ws] {tag} two-state: step {step} refilled state {'AB'[i]}, replaying its graph", flush=True)
+        graphs[i].replay()
+        torch.cuda.synchronize()
+        ref = _wsv_ref(states[i], _WS_LENS_A)
+        err = float((outs[i].float() - ref).norm() / ref.norm())
+        flag = int(_WS_ERR.item())
+        fin = bool(torch.isfinite(outs[i]).all())
+        worst = max(worst, err)
+        print(f"[ws] {tag} two-state: step {step} state {'AB'[i]} rel L2 {err:.2e}, finite {fin}, error word {flag}", flush=True)
+        if not fin or err >= 3e-2 or flag:
+            return False, f"two-state graph replay step {step} (state {'AB'[i]}): rel L2 {err:.2e}, finite {fin}, error word {flag}"
+    print(f"[ws] {tag} two-state graph replays PASS (worst rel L2 {worst:.2e})", flush=True)
+    del graphs, outs
+    return True, None
+
+
+def _ws_capture(fn):
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        fn()
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        o = fn()
+    torch.cuda.synchronize()
+    return g, o
+
+
+def _ws_quartiles(xs):
+    s = sorted(xs)
+    n = len(s)
+    return s[n // 2], s[(3 * n) // 4] - s[n // 4]
+
+
+def _ws_gate_band(B: int, cands, gen, flush, scratch):
+    """Two interleaved rounds (40 replays each, cold L2 via a 256 MB flush, empty-graph baseline subtracted) of master's
+    ACTUALLY ROUTED path (kernel_fn with no variant forced and an empty route) against each candidate variant through kernel_fn,
+    at batch B with ~80K-token contexts. Prints both rounds' medians / IQRs per cell. Returns {variant: (min ratio, passed, text)}."""
+    global _WS_FORCE
+    lens = _ws_lens80(B)
+    data = _wsv_synth(lens, 1.0, gen, torch.device("cuda"))
+    _WS_ERR.zero_()
+    graphs, outs = {}, {}
+    _WS_FORCE = None
+    graphs["master"], outs["master"] = _ws_capture(lambda: kernel_fn(data))
+    for v in cands:
+        _WS_FORCE = v
+        graphs[v], outs[v] = _ws_capture(lambda: kernel_fn(data))
+    _WS_FORCE = None
+    graphs["empty"], _ = _ws_capture(lambda: scratch.add_(0.0))
+    # A captured graph has not run: its output buffers are uninitialised until it is replayed. Replay each once before the
+    # agreement / finiteness / error-word reads below (otherwise the gate compares garbage and can never pass).
+    for k in graphs:
+        graphs[k].replay()
+    torch.cuda.synchronize()
+    om = outs["master"].float()
+    agree, fin = {}, {}
+    for v in cands:
+        ov = outs[v].float()
+        agree[v] = float((ov - om).norm() / om.norm())
+        fin[v] = bool(torch.isfinite(ov).all())
+    eword = int(_WS_ERR.item())
+    rounds = []
+    for rnd in range(2):
+        times = {k: [] for k in graphs}
+        order = list(graphs.keys())
+        for rep in range(40):
+            for label in (order if rep % 2 == 0 else order[::-1]):
+                flush.zero_()
+                e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                e0.record()
+                graphs[label].replay()
+                e1.record()
+                times[label].append((e0, e1))
+        torch.cuda.synchronize()
+        us = {k: [1000.0 * a.elapsed_time(b) for a, b in t] for k, t in times.items()}
+        base = _ws_quartiles(us["empty"])[0]
+        rounds.append({k: (_ws_quartiles(us[k])[0] - base, _ws_quartiles(us[k])[1]) for k in us if k != "empty"})
+    res = {}
+    for v in cands:
+        ratios, iqr_ok, parts = [], True, []
+        for rnd, rd in enumerate(rounds):
+            mm, mi = rd["master"]
+            cm, ci = rd[v]
+            ratio = mm / cm if cm > 0 else 0.0
+            ratios.append(ratio)
+            iqr_ok = iqr_ok and ci <= _WS_IQR_MAX * max(mi, _WS_IQR_FLOOR_US)
+            parts.append(f"round {rnd + 1}: master {mm:.1f} us (IQR {mi:.1f}) vs {_WS_NAMES[v]} {cm:.1f} us (IQR {ci:.1f}) -> {ratio:.3f}x")
+        passed = (min(ratios) >= _WS_THRESH and iqr_ok and agree[v] < 3e-2 and fin[v] and not eword)
+        txt = (f"B={B} {_WS_NAMES[v]}: " + "; ".join(parts) + f"; candidate IQR <= {_WS_IQR_MAX}x master's: {iqr_ok}; vs master rel L2 "
+               f"{agree[v]:.2e}, finite {fin[v]}, error word {eword}; kernels: pre-attention (Triton) + {_WS_KERNELS[v]} vs "
+               f"master pre-attention + FA3 + prepare + combine + _paired_norm_gate_kernel -> {'CLEARS' if passed else 'fails'} "
+               f"(needs min ratio >= {_WS_THRESH} in both rounds)")
+        _say("[ws-gate] " + txt)
+        res[v] = (min(ratios), passed, txt)
+    del graphs, outs, data
+    return res
