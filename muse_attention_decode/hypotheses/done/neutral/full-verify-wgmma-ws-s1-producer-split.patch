+  float sa[2][NS];
+  float oacc[32];
+  uint32_t qa[2][2][4];
+  uint32_t pa[NK][4];
+#pragma unroll
+  for (int i = 0; i < NS; ++i) { sa[0][i] = 0.f; sa[1][i] = 0.f; }
+#pragma unroll
+  for (int i = 0; i < 32; ++i) oacc[i] = 0.f;
