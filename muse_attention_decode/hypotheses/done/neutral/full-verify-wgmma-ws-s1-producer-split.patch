+    // (4 tiles) before the issue that uses it, so the dependent load never sits on the issue path.
+    auto fetch = [&](int k, int (&raw)[4], unsigned& okm) {
+      okm = 0u;
+#pragma unroll
+      for (int j = 0; j < 4; ++j) {
+        raw[j] = 0;
+        const int nn = 4 * k + j;
+        if (nn < N) {
+          const int f = s0 + nn;
+          while (f >= pre_s[ip + 1]) ++ip;
+          const int pos = (f - pre_s[ip]) * TL + tt;
+          if (pos < seq_s[ip]) {
+            raw[j] = __ldg(page_table + static_cast<int64_t>(ip) * pt_stride + pos);
+            okm |= (1u << j);
+          }
+        }
+      }
+    };
+    int rc[4], rn[4];
+    unsigned okc = 0u, okn = 0u;
+    fetch(0, rc, okc);
+    const int nblk = (N + 3) >> 2;
+    for (int k = 0; k < nblk; ++k) {
+      fetch(k + 1, rn, okn);
+#pragma unroll
+      for (int j = 0; j < 4; ++j) {
+        const int nn = 4 * k + j;
+        if (nn < N) {
+          const int st = nn % STAGES;
+          long long t_a = 0;
+          if (DBG) t_a = clock64();
+          if (nn >= STAGES) wait_bar(empty_of(st), (((nn / STAGES) - 1) & 1));  // the previous occupant of stage st was released
+          long long t_b = 0;
+          if (DBG) { t_b = clock64(); p_wait += t_b - t_a; }
+          int64_t row = 0;
+          const bool ok = ((okc >> j) & 1u) != 0u;
+          if (ok) {
+            row = static_cast<int64_t>(static_cast<uint32_t>(rc[j]));  // the page index is clamped into the cache
+            row = row < rows - 1 ? row : rows - 1;
+          }
+          const uint8_t* ks = kc + row * ROW;
+          const uint8_t* vs = vc + row * ROW;
+          const uint32_t stu = ring_u + st * L::STAGE_BYTES;
+#pragma unroll
+          for (int c = 0; c < CHK; ++c) {
+            const int cc = c0 + c;
+            const int dst = tt * ROW + ((cc ^ (tt & 7)) << 4);  // chunk cc at cc ^ (token % 8): the SW128 pattern
+            cp_async16(stu + dst, ks + cc * 16, ok ? 16 : 0);
+            cp_async16(stu + TL * ROW + dst, vs + cc * 16, ok ? 16 : 0);
+          }
+          cp_mbar_arrive_noinc(full_of(st));
+          if (DBG) p_issue += clock64() - t_b;
+        }
+      }
+#pragma unroll
+      for (int j = 0; j < 4; ++j) rc[j] = rn[j];
+      okc = okn;
+    }
+    cp_wait_all();
+    if (DBG) {
+      if (bx == 0 && tid == 0) {
+        dbg[13] = static_cast<float>(p_wait);
+        dbg[14] = static_cast<float>(p_issue);
+        dbg[15] = static_cast<float>(clock64() - p_t0);
+      }
+    }
+    return;
+  }
+
+  // ------------------------------------------------------------------ consumer warpgroups
+  reg_inc<CONSR>();
+  const int g = wg - 1;                    // warpgroup = kv head
+  const int w = warp & 3;                  // warp in the warpgroup: rows 16w .. 16w + 15
+  const int tw = tid & 127;
+  const int ctid = tid - 128;
+  const int r = lane >> 2, tig = lane & 3; // r = the block token of both rows of this thread
+  const int hA = g * G + 2 * w;            // row 16w + r: head hA; row 16w + r + 8: head hA + 1
+  const uint32_t qs_u = smem_u32(smem + L::QS_OFF) + 4u * ctid;
+  const uint32_t vt_gu = vt_u + g * 2 * VTB;
+  uint8_t* vt_base = smem + L::VT_OFF + g * 2 * VTB;
+  auto kdesc = [&](int s, int kk) -> uint64_t { return make_desc(ring_u + s * L::STAGE_BYTES + 64 * g + 32 * kk, 1024, 1); };
+  auto vstage = [&](int s) -> const uint8_t* { return ring + s * L::STAGE_BYTES + TL * ROW; };
+  auto vword = [&](const uint8_t* Vs, int t, int dg) -> uint32_t {
+    return *reinterpret_cast<const uint32_t*>(Vs + t * ROW + (((4 * g + (dg >> 2)) ^ (t & 7)) << 4) + ((dg & 3) << 2));
+  };
+  auto refill = [&](int mm) { (void)mm; };  // the producer warpgroup issues every load
+@CONSUMER@
+#else
+  // Not the sm_90a image: no wgmma / mbarrier here. Flag it; the self-check turns the path off.
+  if (threadIdx.x == 0) atomicOr(err, 1);
+#endif
+}
+
+// ---- variant 2: s5's layout (2 CTAs/SM, 256 threads, every thread issues) with the ring split per warpgroup.
+template <int STAGES>
+__global__ void __launch_bounds__(256, 2)
+wsv1_c2_kernel(const uint8_t* __restrict__ q, const uint8_t* __restrict__ kc, const uint8_t* __restrict__ vc,
+               int64_t rows, const int* __restrict__ page_table, int64_t pt_stride,
+               const int* __restrict__ seqlens, int B, const float* __restrict__ k_scale,
+               const float* __restrict__ v_scale, float score_scale,
+               const __nv_bfloat16* __restrict__ qkv, int64_t qkv_stride, __nv_bfloat16* out, float eps,
+               float* ws_acc, float* ws_ml, int* ticket, int* err, float* dbg, int go) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  using L = C2Lay<STAGES>;
+  constexpr int TL = 64;
+  constexpr bool DUAL = false;
+  constexpr bool DBG = false;
+  constexpr int NS = 32, NB = 8, NK = 2;
+  constexpr int VTB = L::VT_BYTES;
+  extern __shared__ __align__(1024) uint8_t wsv1_smem[];
+  uint8_t* smem = wsv1_smem + ((1024u - (smem_u32(wsv1_smem) & 1023u)) & 1023u);
+  uint8_t* ring = smem + L::RING_OFF;
+  int* seq_s = reinterpret_cast<int*>(smem + L::SEQ_OFF);
+  int* pre_s = reinterpret_cast<int*>(smem + L::PRE_OFF);
+  volatile int* flag_s = reinterpret_cast<volatile int*>(smem + L::FLAG_OFF);
+  const uint32_t ring_u = smem_u32(ring);
+  const uint32_t vt_u = smem_u32(smem + L::VT_OFF);
+  const uint32_t bar_u = smem_u32(smem + L::BAR_OFF);
+  const float NEG_INF = __int_as_float(0xff800000u);
+
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  const int bx = blockIdx.x, gx = gridDim.x;
+  if (blockDim.x != 256) {
+    if (tid == 0) atomicOr(err, 4);
+    return;
+  }
+  if (tid < B) seq_s[tid] = seqlens[tid];
+  if (tid == 0) {
+    for (int s = 0; s < HKV * STAGES; ++s) {
+      mbar_init(bar_u + 8 * s, 128);                          // FULL[g][s]: one noinc arrival per thread of warpgroup g
+      mbar_init(bar_u + 8 * (HKV * STAGES + s), 128);         // EMPTY[g][s]: one arrival per thread of warpgroup g
+    }
+    flag_s[0] = 0;
+    flag_s[1] = 0;
+    flag_s[2] = 0;
+    fence_mbar_init();
+  }
+  __syncthreads();
+  if (warp == 0) tile_prefix(seq_s, pre_s, B, lane, TL);
+  __syncthreads();
+  const int Ttot = pre_s[B];
+  const int s0 = start_of(bx, Ttot, gx), s1 = start_of(bx + 1, Ttot, gx);
+  if (s0 >= s1) return;
+  const int N = s1 - s0;
+  const float scale = score_scale * __ldg(k_scale);
+  const int bfirst = req_of(pre_s, B, s0);
+
+  auto wait_bar = [&](uint32_t a, uint32_t parity) {
+    if (mbar_try_wait(a, parity)) return;
+    const long long t0 = clock64();
+    while (!flag_s[0]) {
+      if (mbar_try_wait(a, parity)) return;
+      if (clock64() - t0 > WAIT_LIMIT) {
+        flag_s[0] = 1;
+        atomicOr(err, 2);
+        return;
+      }
+    }
+  };
+  const int g = warp >> 2;                 // warpgroup = kv head = this thread's ring
+  const int w = warp & 3;
+  const int tw = tid & 127;
+  const int ctid = tid;
+  const int r = lane >> 2, tig = lane & 3;
+  const int hA = g * G + 2 * w;
+  const uint32_t qs_u = smem_u32(smem + L::QS_OFF) + 4u * ctid;
+  const uint32_t vt_gu = vt_u + g * 2 * VTB;
+  uint8_t* vt_base = smem + L::VT_OFF + g * 2 * VTB;
+  uint8_t* ring_g = ring + g * STAGES * L::STG8;
+  const uint32_t ring_gu = ring_u + g * STAGES * L::STG8;
+  auto full_of = [&](int s) -> uint32_t { return bar_u + 8 * (g * STAGES + s); };
+  auto empty_of = [&](int s) -> uint32_t { return bar_u + 8 * (HKV * STAGES + g * STAGES + s); };
+  auto kdesc = [&](int s, int kk) -> uint64_t { return make_desc(ring_gu + s * L::STG8 + 32 * kk, 512, 2); };  // K: SW64, 64 B rows
+  auto vstage = [&](int s) -> const uint8_t* { return ring_g + s * L::STG8 + 4096; };
+  auto vword = [&](const uint8_t* Vs, int t, int dg) -> uint32_t {
+    return *reinterpret_cast<const uint32_t*>(Vs + t * 64 + (((dg >> 2) ^ ((t >> 1) & 3)) << 4) + ((dg & 3) << 2));
+  };
+  // This warpgroup's own gather (head g's 64-byte half of each cache row): thread tw -> token tw / 2, 16-byte chunks
+  // 2 (tw & 1) + {0, 1}; K tile at the stage base, V tile 4 KB above it, both SW64 (chunk ^ ((token >> 1) & 3)).
+  const int tt = tw >> 1;
+  const int c0 = (tw & 1) * 2;
+  int ip = bfirst;
+  auto fetch1 = [&](int nn, int& raw, bool& okv) {
+    okv = false;
+    raw = 0;
+    if (nn < N) {
+      const int f = s0 + nn;
+      while (f >= pre_s[ip + 1]) ++ip;
+      const int pos = (f - pre_s[ip]) * TL + tt;
+      if (pos < seq_s[ip]) {
+        raw = __ldg(page_table + static_cast<int64_t>(ip) * pt_stride + pos);
+        okv = true;
+      }
+    }
+  };
+  auto issue2 = [&](int nn, int raw, bool okv) {
+    int64_t row = 0;
+    if (okv) {
+      row = static_cast<int64_t>(static_cast<uint32_t>(raw));
+      row = row < rows - 1 ? row : rows - 1;
+    }
+    const uint8_t* ks = kc + row * ROW + g * 64;
+    const uint8_t* vs = vc + row * ROW + g * 64;
+    const uint32_t stu = ring_gu + (nn % STAGES) * L::STG8;
+#pragma unroll
+    for (int c = 0; c < 2; ++c) {
+      const int cc = c0 + c;
+      const int dst = tt * 64 + ((cc ^ ((tt >> 1) & 3)) << 4);
+      cp_async16(stu + dst, ks + cc * 16, okv ? 16 : 0);
+      cp_async16(stu + 4096 + dst, vs + cc * 16, okv ? 16 : 0);
+    }
+  };
+  int nraw = 0;
+  bool nok = false;
+  for (int j = 0; j < STAGES - 1; ++j) {  // prologue: tiles 0 .. STAGES - 2
+    if (j < N) {
+      int rw = 0;
+      bool ok = false;
+      fetch1(j, rw, ok);
+      issue2(j, rw, ok);
+      cp_mbar_arrive_noinc(full_of(j));
+    }
+  }
+  fetch1(STAGES - 1, nraw, nok);  // the next tile's index, prefetched a whole iteration ahead
+  auto refill = [&](int mm) {
+    const int nn = mm + STAGES - 1;
+    if (nn < N) {
+      if (mm >= 1) wait_bar(empty_of(nn % STAGES), (((mm - 1) / STAGES) & 1));  // stage of tile mm - 1: all 128 threads released it
+      issue2(nn, nraw, nok);
+      cp_mbar_arrive_noinc(full_of(nn % STAGES));
+      fetch1(nn + 1, nraw, nok);
+    }
+  };
+@CONSUMER@
+#else
+  if (threadIdx.x == 0) atomicOr(err, 1);
+#endif
+}
+
+template <typename Kern>
+void set_smem(Kern kernel, int bytes) {
+  C10_CUDA_CHECK(cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, bytes));
+}
+
+constexpr int V0_SMEM = WsLay<64, 8>::SMEM_A;
+constexpr int V1_SMEM = WsLay<128, 5>::SMEM_A;
+constexpr int V2_SMEM = C2Lay<5>::SMEM_A;
+
+void set_attrs_once() {
+  static bool done = false;
+  if (!done) {
+    set_smem(wsv1_ws_kernel<64, 8, true, false>, V0_SMEM);
+    set_smem(wsv1_ws_kernel<128, 5, false, false>, V1_SMEM);
+    set_smem(wsv1_c2_kernel<5>, V2_SMEM);
+    set_smem(wsv1_ws_kernel<64, 8, true, true>, V0_SMEM);  // PHASE DIAG instantiation (prepare only)
+    done = true;
+  }
+}
+
+int smem_of(int64_t variant) {
+  return variant == 1 ? V1_SMEM : (variant == 2 ? V2_SMEM : V0_SMEM);
+}
+
+template <typename Kern>
+void fill_attrs(int64_t* p, Kern kernel, int threads, int smem) {
+  cudaFuncAttributes a;
+  int occ = 0;
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&a, kernel));
+  C10_CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, kernel, threads, smem));
+  p[0] = a.numRegs;
+  p[1] = static_cast<int64_t>(a.localSizeBytes);
+  p[2] = static_cast<int64_t>(a.sharedSizeBytes);
+  p[3] = smem;
+  p[4] = occ;
+  p[5] = a.binaryVersion;
+  p[6] = a.ptxVersion;
+  p[7] = a.maxDynamicSharedSizeBytes;
+}
+
+}  // namespace
+
+void wsv1_attn(torch::Tensor q, torch::Tensor k_cache, torch::Tensor v_cache, torch::Tensor page_table,
+               torch::Tensor cache_seqlens, torch::Tensor k_scale, torch::Tensor v_scale, torch::Tensor qkv,
+               int64_t qkv_stride, torch::Tensor out, torch::Tensor ws_acc, torch::Tensor ws_ml,
+               torch::Tensor ticket, torch::Tensor err, torch::Tensor dbg, double score_scale, double eps,
+               int64_t grid, int64_t variant, int64_t go) {
+  const int B = static_cast<int>(cache_seqlens.size(0));
+  TORCH_CHECK(B >= 1 && B <= MAXB, "wsv1_attn: batch out of range");
+  TORCH_CHECK(variant >= 0 && variant <= 3, "wsv1_attn: variant");
+  TORCH_CHECK(grid >= 1, "wsv1_attn: grid");
+  TORCH_CHECK(q.size(0) == static_cast<int64_t>(B) * QL && q.size(1) == HQ && q.size(2) == D, "wsv1_attn: q shape");
+  TORCH_CHECK(ws_acc.size(0) >= grid + B && ws_ml.size(0) >= grid + B, "wsv1_attn: workspace too small");
+  TORCH_CHECK(ticket.numel() >= static_cast<int64_t>(MAXB) * HKV && err.numel() >= 1, "wsv1_attn: ticket/err");
+  TORCH_CHECK(k_cache.numel() % ROW == 0 && k_cache.numel() >= ROW, "wsv1_attn: cache rows");
+  TORCH_CHECK(page_table.stride(1) == 1 && q.is_contiguous() && k_cache.is_contiguous() && v_cache.is_contiguous()
+              && ws_acc.is_contiguous() && ws_ml.is_contiguous() && out.is_contiguous(), "wsv1_attn: layout");
+  if (variant == 3) TORCH_CHECK(dbg.numel() >= 16, "wsv1_attn: dbg buffer");
+  set_attrs_once();
+  int dev = 0, optin = 0;
+  C10_CUDA_CHECK(cudaGetDevice(&dev));
+  C10_CUDA_CHECK(cudaDeviceGetAttribute(&optin, cudaDevAttrMaxSharedMemoryPerBlockOptin, dev));
+  TORCH_CHECK(smem_of(variant) <= optin, "wsv1_attn: dynamic shared memory exceeds the device limit");
+  const int64_t rows = k_cache.numel() / ROW;
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const unsigned g = static_cast<unsigned>(grid);
+  float* dbgp = reinterpret_cast<float*>(dbg.data_ptr());
+#define WSV1_ARGS                                                                                                   \
+  reinterpret_cast<const uint8_t*>(q.data_ptr()), reinterpret_cast<const uint8_t*>(k_cache.data_ptr()),             \
+      reinterpret_cast<const uint8_t*>(v_cache.data_ptr()), rows, page_table.data_ptr<int>(), page_table.stride(0), \
+      cache_seqlens.data_ptr<int>(), B, k_scale.data_ptr<float>(), v_scale.data_ptr<float>(),                       \
+      static_cast<float>(score_scale), reinterpret_cast<const __nv_bfloat16*>(qkv.data_ptr()), qkv_stride,          \
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), static_cast<float>(eps), ws_acc.data_ptr<float>(),          \
+      ws_ml.data_ptr<float>(), ticket.data_ptr<int>(), err.data_ptr<int>(), dbgp, static_cast<int>(go)
+  if (variant == 0) {
+    wsv1_ws_kernel<64, 8, true, false><<<g, 384, V0_SMEM, stream>>>(WSV1_ARGS);
+  } else if (variant == 1) {
+    wsv1_ws_kernel<128, 5, false, false><<<g, 384, V1_SMEM, stream>>>(WSV1_ARGS);
+  } else if (variant == 2) {
+    wsv1_c2_kernel<5><<<g, 256, V2_SMEM, stream>>>(WSV1_ARGS);
+  } else {
+    wsv1_ws_kernel<64, 8, true, true><<<g, 384, V0_SMEM, stream>>>(WSV1_ARGS);
+  }
+#undef WSV1_ARGS
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// CPU int64 [33]: per variant 0..3 (ws64, ws128, c2, ws64 DBG): regs, local bytes, static smem, dynamic smem, CTAs/SM,
+// binaryVersion, ptxVersion, max dynamic smem attr; then the device's opt-in smem limit.
+torch::Tensor wsv1_attrs() {
+  set_attrs_once();
+  auto t = torch::zeros({33}, torch::dtype(torch::kInt64));
+  int64_t* p = t.data_ptr<int64_t>();
+  fill_attrs(p + 0, wsv1_ws_kernel<64, 8, true, false>, 384, V0_SMEM);
+  fill_attrs(p + 8, wsv1_ws_kernel<128, 5, false, false>, 384, V1_SMEM);
+  fill_attrs(p + 16, wsv1_c2_kernel<5>, 256, V2_SMEM);
+  fill_attrs(p + 24, wsv1_ws_kernel<64, 8, true, true>, 384, V0_SMEM);
+  int dev = 0, optin = 0;
+  C10_CUDA_CHECK(cudaGetDevice(&dev));
+  C10_CUDA_CHECK(cudaDeviceGetAttribute(&optin, cudaDevAttrMaxSharedMemoryPerBlockOptin, dev));
+  p[32] = optin;
+  return t;
+}
+"""
+
+
+def _wsv1_cuda_source() -> str:
+    """The module's CUDA source: head + generated wgmma wrappers (n64, n128) + the two kernels with the shared consumer."""
+    consumer = _ws_consumer_text()
+    kernels = _WSV1_KERNELS.replace("@CONSUMER@", consumer)
+    return _WSV1_HEAD + _ws_wgmma_src(64) + _ws_wgmma_src(128) + "#endif\n" + kernels
+
+
+_WS_NAMES = {0: "ws64", 1: "ws128", 2: "c2"}
+_WS_KERNELS = {0: "wsv1_ws_kernel<64,8,dual>", 1: "wsv1_ws_kernel<128,5,single>", 2: "wsv1_c2_kernel<5>"}
+_WS_THRESH = 1.05        # master paired FA3 time / candidate time, BOTH interleaved rounds
+_WS_IQR_MAX = 1.5        # candidate IQR / master IQR, both rounds
+_WS_IQR_FLOOR_US = 0.5   # absolute floor on master's IQR (timer resolution): a 0.2 us spread must not veto a real win
+# Phase start deadlines on the import clock (seconds since the top of this file), against the judge's 480 s start rule.
+_WS_BUILD_BY, _WS_QUICK_BY, _WS_GATE_BY, _WS_FULL_BY, _WS_DIAG_BY = 400.0, 440.0, 455.0, 465.0, 470.0
+
+_WSX = None            # the compiled module
+_WS_ERR = None         # int32 [1] device error flag (1: not the sm_90a image, 2: mbarrier timeout, 4: launch shape)
+_WS_TICKETS = {}
+_WS_ROUTE = MappingProxyType({})  # band (16 | 32) -> variant id; frozen after the gate, kernel_fn only reads it
+_WS_FORCE = None       # setup only: variant forced through kernel_fn (every band open)
+_WS_GRID = None        # setup only: grid override
+_WS_HOOK = None        # setup only: called between launches (sync + print)
+_WS_KEEP = None        # setup only: dict the launch fills with its workspaces
+_WS_ANYB = False       # setup only: let the gate accept batch 1 (the single-request bisect cases)
+_WS_GO = 0             # setup only: gather-only roofline launch
+_WS_DBG = None         # setup only: float32 [16] PHASE DIAG buffer (variant 3)
+
+
+def _ws_late(what: str, limit: float) -> bool:
+    """True (after printing 'skipped: deadline') when the import clock is already past a phase's start deadline."""
+    t = time.perf_counter() - _IMPORT_T0
+    if t > limit:
+        _say(f"[ws] {what}: skipped: deadline (import clock {t:.0f} s > start limit {limit:.0f} s)")
+        return True
+    return False
+
+
+def _ws_tickets(device) -> torch.Tensor:
+    """int32 [64 * 2] per-(request, kv head) tickets, this module's own. Zeroed once per device at setup (eager); every launch
+    leaves them at 0 again (the merging warpgroup resets its ticket), so they hold no data."""
+    dev = torch.device(device)
+    if dev.index is None:  # setup passes torch.device("cuda"), kernel_fn passes qkv.device (cuda:N): one key for both
+        dev = torch.device("cuda", torch.cuda.current_device())
+    key = str(dev)
+    buf = _WS_TICKETS.get(key)
+    if buf is None:
+        buf = _WS_TICKETS[key] = torch.zeros(64 * 2, dtype=torch.int32, device=device)
+    return buf
+
+
+def _ws_band(batch: int) -> int:
+    """Timing band of a batch: 16 for 1..24, 32 for 25..64 (config only)."""
+    return 16 if batch <= 24 else 32
+
+
+def _ws_variant(cfg):
+    """Config-only predicate: full layer, q_len 8, 1 < batch <= 64, tp8, head dim 64, page 1, and a variant that passed its checks
+    and the gate for this batch band (or the setup-only forced variant). None puts these shapes on master's paired FA3 path."""
+    if (_WSX is None or cfg["window"] != 0 or cfg["q_len"] != 8 or not (1 < cfg["batch"] or _WS_ANYB) or cfg["batch"] > 64
+            or cfg["num_q_heads"] != 16 or cfg["num_kv_heads"] != 2 or cfg["head_dim"] != 64 or cfg["page_size"] != 1):
+        return None
+    if _WS_FORCE is not None:
+        return _WS_FORCE
+    return _WS_ROUTE.get(_ws_band(cfg["batch"]))
+
+
+def _ws_launch(data: Inputs, q: torch.Tensor, qkv: torch.Tensor, variant: int, out, ws_acc, ws_ml, grid: int) -> None:
+    cfg = data["config"]
+    dbg = _WS_DBG if _WS_DBG is not None else _WS_ERR
+    _WSX.wsv1_attn(q, data["k_cache"], data["v_cache"], data["page_table"], data["cache_seqlens"], data["k_scale"],
+                   data["v_scale"], qkv, qkv.stride(0), out, ws_acc, ws_ml, _ws_tickets(qkv.device), _WS_ERR, dbg,
+                   cfg["sm_scale"] * cfg["qk_scale_factor"] * LOG2E, RMS_EPS, grid, variant, _WS_GO)
+
+
+def _ws_run(data: Inputs, q: torch.Tensor, qkv: torch.Tensor, variant: int) -> torch.Tensor:
+    """The wsv1 kernel (combine + norm-gate inside); q is the unpaired FP8 query [B*8, 16, 64]. Grid and workspace come from
+    shapes and the device only: CTA c writes slot c + b for each request b its range touches."""
+    cfg = data["config"]
+    batch, length, hq, d = cfg["batch"], cfg["q_len"], cfg["num_q_heads"], cfg["head_dim"]
+    device = qkv.device
+    grid = _WS_GRID or (2 if variant == 2 else 1) * _sm_count(device)
+    slots = grid + batch
+    ws_acc = torch.empty((slots, length, hq, d), dtype=torch.float32, device=device)
+    ws_ml = torch.empty((slots, 2, length * hq), dtype=torch.float32, device=device)
+    out = torch.empty((batch, length, hq * d), dtype=torch.bfloat16, device=device)
+    if _WS_KEEP is not None:
+        _WS_KEEP.update(ws_acc=ws_acc, ws_ml=ws_ml, grid=grid)
+    hook = _WS_HOOK
+    if hook is not None:
+        hook(f"pre-attention (Triton) done; launching {_WS_KERNELS.get(variant, 'wsv1 phase-diag kernel')} grid {grid}")
+    _ws_launch(data, q, qkv, variant, out, ws_acc, ws_ml, grid)
+    if hook is not None:
+        hook("wsv1 kernel done")
+    return out
+
+
+def _build_ws():
+    """Compile the module once per process (never during graph capture) for sm_90a ONLY (TORCH_CUDA_ARCH_LIST=9.0a around the
+    build, restored after). Returns (module, None) or (None, reason); a failure leaves every shape on master."""
+    t0 = time.perf_counter()
+    flags = ["-O3", "-lineinfo"]
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+    try:
+        from torch.utils.cpp_extension import load_inline
+        try:
+            from torch.utils.cpp_extension import _get_cuda_arch_flags
+            arch = list(_get_cuda_arch_flags())
+        except Exception as e:
+            arch = f"unreadable ({e!r})"
+        _say(f"[ws] building muse_full_verify_wgmma_ws_v1: TORCH_CUDA_ARCH_LIST=9.0a, arch flags {arch}, extra {flags}")
+        ext = load_inline(
+            name="muse_full_verify_wgmma_ws_v1",
+            cpp_sources=_WSV1_CPP,
+            cuda_sources=_wsv1_cuda_source(),
+            functions=["wsv1_attn", "wsv1_attrs"],
+            extra_cuda_cflags=flags,
+            verbose=False,
+        )
+    except Exception as e:
+        _say(f"[ws] load_inline failed after {time.perf_counter() - t0:.1f}s: {type(e).__name__}: ...{str(e)[-3000:]}")
+        return None, f"build failed ({type(e).__name__})"
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    _say(f"[ws] load_inline compiled in {time.perf_counter() - t0:.1f}s")
+    return ext, None
+
+
+def _ws_image_check() -> dict:
+    """Print regs / spill bytes / smem / occupancy per variant; return {variant: None (usable) or the reason it is refused}.
+    A variant is refused on local bytes > 0, a non-sm_90 image, dynamic smem above the device limit, or (c2) occupancy < 2."""
+    cap = torch.cuda.get_device_capability()
+    a = _WSX.wsv1_attrs().tolist()
+    optin = a[32]
+    res = {}
+    for v, name in ((0, "ws64"), (1, "ws128"), (2, "c2"), (3, "ws64-phase-diag")):
+        regs, local, sh, dyn, occ, binv, ptxv, maxdyn = a[8 * v: 8 * v + 8]
+        _say(f"[ws] {name}: regs {regs}, local bytes {local}, static smem {sh}, dynamic smem {dyn} B (device opt-in {optin}), "
+             f"CTAs/SM {occ}, binaryVersion {binv}, ptxVersion {ptxv}, max dyn attr {maxdyn}")
+        why = None
+        if cap != (9, 0):
+            why = f"device capability {cap} is not (9, 0)"
+        elif binv != 90:
+            why = f"loaded image is not sm_90 SASS (binaryVersion {binv})"
+        elif local > 0:
+            why = f"{local} local (spill) bytes"
+        elif dyn > optin:
+            why = f"dynamic smem {dyn} B > device limit {optin} B"
+        elif v != 2 and regs < 168:
+            # setmaxnreg: 128 * 56 + 256 * 224 = 64512 = 168 * 384. With fewer registers allocated at launch the consumers'
+            # setmaxnreg.inc would wait forever for registers the producer never frees (a hang, not a fallback).
+            why = f"{regs} registers/thread < 168: setmaxnreg.inc 224 could never be satisfied"
+        elif occ < (2 if v == 2 else 1):
+            why = f"occupancy {occ} CTAs/SM"
+        res[v] = why
+        if why is not None:
+            _say(f"[ws] {name} REFUSED: {why}")
+    return res
+
