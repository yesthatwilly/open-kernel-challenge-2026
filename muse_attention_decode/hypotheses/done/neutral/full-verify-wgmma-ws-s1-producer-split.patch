+_WS_T_SOFTMAX = _WsTemplate(r"""
+{
+  // Thread scores: sa[UB][4 nb + e] (head hA) and sa[UB][4 nb + 2 + e] (head hA + 1) at tile token nb * 8 + 2 tig + e, both for
+  // block token r. Key t valid iff t <= seq - QL + r, i.e. tile token < lim; only tiles reaching past seq - QL need the test.
+  const bool edge = lt_c * TL + TL + (QL - 1) > seq_c;
+  const int lim = seq_c - (QL - 1) + r - lt_c * TL;
+  float mxA = NEG_INF, mxB = NEG_INF;
