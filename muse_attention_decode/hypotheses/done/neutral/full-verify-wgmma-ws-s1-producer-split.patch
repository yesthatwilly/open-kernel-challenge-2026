+def _ws_wgmma_src(n: int) -> str:
+    """D (+)= A B, m64n<n>k32, A = e4m3 registers (4 x b32 per thread), B = e4m3 K-major smem descriptor; the accumulator
+    is n / 2 fp32 registers per thread. Overloaded on the accumulator array size (32 -> n64, 64 -> n128)."""
+    nreg = n // 2
+    outs = ", ".join('"+f"(d[%d])' % i for i in range(nreg))
+    regs = ", ".join("%%%d" % i for i in range(nreg))
+    a = ", ".join("%%%d" % (nreg + i) for i in range(4))
+    return (
+        "__device__ __forceinline__ void wgmma_s(float (&d)[%d], const uint32_t (&a)[4], uint64_t desc, int scale_d) {\n"
+        "  asm volatile(\n"
+        "      \"{\\n\\t.reg .pred p;\\n\\tsetp.ne.b32 p, %%%d, 0;\\n\\t\"\n"
+        "      \"wgmma.mma_async.sync.aligned.m64n%dk32.f32.e4m3.e4m3 \"\n"
+        "      \"{%s}, \"\n"
+        "      \"{%s}, %%%d, p, 1, 1;\\n\\t}\\n\"\n"
+        "      : %s\n"
+        "      : \"r\"(a[0]), \"r\"(a[1]), \"r\"(a[2]), \"r\"(a[3]), \"l\"(desc), \"r\"(scale_d)\n"
+        "      : \"memory\");\n"
+        "}\n" % (nreg, nreg + 5, n, regs, a, nreg + 4, outs)
+    )
+
+
+# Shared consumer machinery. The same text is expanded (python string templates, so the two parities of the S accumulator
+# sets are literal indices and nothing lands in local memory) into the warp-specialized kernel and the 2-CTA/SM kernel.
+# The kernel defines: TL, STAGES, DUAL, DBG, NS, NB, NK, VTB, tid/lane/warp, bx, gx, B, s0, N, bfirst, scale, g, tw, w, r, tig,
+# hA, qs_u, vt_gu, vt_base, flag_s, pre_s, seq_s and the small lambdas wait_bar, full_of, empty_of, kdesc, vstage, vword,
+# refill (loads issued by the consumers themselves; empty for the warp-specialized kernel).
+
+_WS_T_ISSUE = _WsTemplate(r"""
+{
+  if (${XSS}) {  // segment start: stage request ${XCB}'s FP8 query as this thread's wgmma A fragment words (once per segment)
+    const uint8_t* qra = q + (static_cast<int64_t>(${XCB}) * QL + r) * HQ * D + hA * D + tig * 4;
+    const uint8_t* qrb = qra + D;  // head hA + 1, same block token
+#pragma unroll
+    for (int kk = 0; kk < 2; ++kk) {
+      sts32(qs_u + 4u * CT * (4 * kk + 0), __ldg(reinterpret_cast<const unsigned int*>(qra + kk * 32)));
+      sts32(qs_u + 4u * CT * (4 * kk + 1), __ldg(reinterpret_cast<const unsigned int*>(qrb + kk * 32)));
+      sts32(qs_u + 4u * CT * (4 * kk + 2), __ldg(reinterpret_cast<const unsigned int*>(qra + kk * 32 + 16)));
+      sts32(qs_u + 4u * CT * (4 * kk + 3), __ldg(reinterpret_cast<const unsigned int*>(qrb + kk * 32 + 16)));
+    }
+  }
+  // qa is RELOADED from shared memory before every S issue (stage 5's fix), into the register set of this S buffer.
+#pragma unroll
+  for (int kk = 0; kk < 2; ++kk) {
+#pragma unroll
+    for (int j = 0; j < 4; ++j) qa[${BUF}][kk][j] = lds32(qs_u + 4u * CT * (4 * kk + j));
+  }
+  long long t_f0 = 0;
+  if (DBG) t_f0 = clock64();
+  wait_bar(full_of((${X}) % STAGES), (((${X}) / STAGES) & 1));
+  if (DBG) c_full += clock64() - t_f0;
+  fence_proxy_async();  // the cp.async (generic proxy) writes -> wgmma (async proxy) reads
+  __syncwarp();
+  fence_f(sa[${BUF}]);
+  wg_fence();
+  wgmma_s(sa[${BUF}], qa[${BUF}][0], kdesc((${X}) % STAGES, 0), 0);
+  wgmma_s(sa[${BUF}], qa[${BUF}][1], kdesc((${X}) % STAGES, 1), 1);
+  wg_commit();
+}
+""")
+
+_WS_T_PV = _WsTemplate(r"""
+{
+  named_bar(1 + g);  // every thread of the warpgroup finished V^T buffer (${PT}) & 1 (its stores + the proxy fence)
+  const uint32_t vtu_ = vt_gu + (((${PT}) & 1) * VTB);
+  fence_f(oacc);
+  wg_fence();
+#pragma unroll
+  for (int kt = 0; kt < NK; ++kt)
+    wgmma_s(oacc, pa[kt], make_desc(vtu_ + 32u * kt, TL == 64 ? 512u : 1024u, TL == 64 ? 2u : 1u), 1);
+  wg_commit();
+}
+""")
+
+_WS_T_STORE = _WsTemplate(r"""
+{
+  // Segment end of request ${CB} (last flat tile ${FL}): this warp's 16 rows of the partial at slot bx + request.
+  float la_ = ${LA}, lb_ = ${LB};
+  la_ += __shfl_xor_sync(0xffffffffu, la_, 1);
+  la_ += __shfl_xor_sync(0xffffffffu, la_, 2);
+  lb_ += __shfl_xor_sync(0xffffffffu, lb_, 1);
+  lb_ += __shfl_xor_sync(0xffffffffu, lb_, 2);
+  const int64_t slot = static_cast<int64_t>(bx) + (${CB});
+  float* pa_ = ws_acc + ((slot * QL + r) * HQ + hA) * D + 2 * tig;
+  float* pb_ = pa_ + D;  // head hA + 1
+#pragma unroll
+  for (int nd = 0; nd < 8; ++nd) {
+    *reinterpret_cast<float2*>(pa_ + nd * 8) = make_float2(oacc[4 * nd], oacc[4 * nd + 1]);
+    *reinterpret_cast<float2*>(pb_ + nd * 8) = make_float2(oacc[4 * nd + 2], oacc[4 * nd + 3]);
+  }
+  if (tig == 0) {
+    float* ml = ws_ml + slot * 2 * QL * HQ + r * HQ + hA;
+    ml[0] = ${MA};
+    ml[1] = ${MB};
+    ml[QL * HQ] = la_;
+    ml[QL * HQ + 1] = lb_;
+  }
+  // Release: every thread fences its partial at gpu scope, the warpgroup syncs, one thread adds this segment's tile count;
+  // the warpgroup completing the request's count merges.
+  __threadfence();
+  named_bar(1 + g);
+  if (tw == 0) {
+    const int add = (${FL}) + 1 - max(s0, pre_s[${CB}]);
+    const int old = atomicAdd(ticket + (${CB}) * HKV + g, add);
+    flag_s[1 + g] = (old + add == pre_s[(${CB}) + 1] - pre_s[${CB}]) ? 1 : 0;
+  }
+  named_bar(1 + g);
+  if (flag_s[1 + g]) {
+    __threadfence();  // acquire side, every thread, before the L2 (.cg) reloads
+    merge_head(${CB}, g, tw, pre_s, B, gx, ws_acc, ws_ml, v_scale, qkv, qkv_stride, out, eps);
+    if (tw == 0) ticket[(${CB}) * HKV + g] = 0;  // ready for the next launch / graph replay
+  }
+}
+""")
+
+_WS_T_TRANSPOSE = r"""
+{
+  // Head g's V half of tile m -> V^T buffer m & 1 (rows = dims, K-major, SW64 at TL 64 / SW128 at TL 128). Byte k' of row d =
+  // V[token(k')][d], token(32 kt + 16 h + 4 t + e) = 32 kt + 16 h + 8 (e >> 1) + 2 t + (e & 1) (the P fragment's token
+  // permutation). Unit u = (dim group dg, k' group kg): 4 tokens x 4 dims, 4 x 32-bit loads, byte transpose, 4 x 32-bit stores.
+  const uint8_t* Vs = vstage(st);
+  uint8_t* vt = vt_base + (m & 1) * VTB;
+#pragma unroll
+  for (int i = 0; i < TL / 32; ++i) {
+    const int u = tw + 128 * i, kg = u % (TL / 4), dg = u / (TL / 4);
+    const int T0 = 32 * (kg >> 3) + 16 * ((kg >> 2) & 1) + 2 * (kg & 3);
+    const uint32_t w0 = vword(Vs, T0, dg);
+    const uint32_t w1 = vword(Vs, T0 + 1, dg);
+    const uint32_t w2 = vword(Vs, T0 + 8, dg);
+    const uint32_t w3 = vword(Vs, T0 + 9, dg);
+    const uint32_t t0 = __byte_perm(w0, w1, 0x5140), t1 = __byte_perm(w0, w1, 0x7362);
+    const uint32_t t2 = __byte_perm(w2, w3, 0x5140), t3 = __byte_perm(w2, w3, 0x7362);
+    uint32_t o4[4];
+    o4[0] = __byte_perm(t0, t2, 0x5410);  // dim d0:     tokens T0, T0 + 1, T0 + 8, T0 + 9
+    o4[1] = __byte_perm(t0, t2, 0x7632);  // dim d0 + 1
+    o4[2] = __byte_perm(t1, t3, 0x5410);  // dim d0 + 2
+    o4[3] = __byte_perm(t1, t3, 0x7632);  // dim d0 + 3
+    // Odd dim groups store their rows in the order 1, 0, 3, 2 so the two half-warps hit rows of opposite parity.
+    const int odd = dg & 1;
+#pragma unroll
+    for (int ii = 0; ii < 4; ++ii) {
+      const int dd = 4 * dg + (ii ^ odd);
+      const uint32_t val = odd ? o4[ii ^ 1] : o4[ii];
+      const int chunk = (kg >> 2) ^ (TL == 64 ? ((dd >> 1) & 3) : (dd & 7));
+      *reinterpret_cast<uint32_t*>(vt + dd * (TL == 64 ? 64 : 128) + (chunk << 4) + (kg & 3) * 4) = val;
+    }
+  }
+}
+fence_proxy_async();  // this thread's V^T stores -> visible to the async proxy
