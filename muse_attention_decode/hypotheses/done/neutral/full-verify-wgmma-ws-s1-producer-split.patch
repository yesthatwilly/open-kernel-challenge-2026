+      if (edge && nb * 8 + 2 * tig + e >= lim) { xa = NEG_INF; xb = NEG_INF; }
+      sa[${UB}][4 * nb + e] = xa;
+      sa[${UB}][4 * nb + 2 + e] = xb;
+      mxA = fmaxf(mxA, xa);
+      mxB = fmaxf(mxB, xb);
+    }
+  }
+  mxA = fmaxf(mxA, __shfl_xor_sync(0xffffffffu, mxA, 1));
+  mxA = fmaxf(mxA, __shfl_xor_sync(0xffffffffu, mxA, 2));
+  mxB = fmaxf(mxB, __shfl_xor_sync(0xffffffffu, mxB, 1));
+  mxB = fmaxf(mxB, __shfl_xor_sync(0xffffffffu, mxB, 2));
+  const float nA = fmaxf(mA, mxA), nB = fmaxf(mB, mxB);
+  const float uA = nA == NEG_INF ? 0.f : nA, uB = nB == NEG_INF ? 0.f : nB;
+  aA = ex2(mA - uA);  // 0 while the row has seen no valid key (and at every segment start: mA was reset to -inf)
+  aB = ex2(mB - uB);
