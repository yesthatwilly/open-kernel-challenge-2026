+def _ws_diag_gather(v: int, B: int, gen, flush) -> None:
+    """Gather-only roofline DIAG: the same ring and producer, consumers only wait FULL / arrive EMPTY. Printed as achieved TB/s
+    over the K+V bytes of the batch (256 B per token); master decode's gather runs at ~3.0 TB/s."""
+    global _WS_GO
+    lens = _ws_lens80(B)
+    data = _wsv_synth(lens, 1.0, gen, torch.device("cuda"))
+    cfg = data["config"]
+    qkv = data["qkv"].reshape(B * 8, -1)
+    q = torch.zeros((B * 8, 16, 64), dtype=FP8, device=qkv.device)
+    sms = _sm_count(qkv.device)
+    grid = (2 if v == 2 else 1) * sms
+    ws_acc = torch.empty((grid + B, 8, 16, 64), dtype=torch.float32, device=qkv.device)
+    ws_ml = torch.empty((grid + B, 2, 8 * 16), dtype=torch.float32, device=qkv.device)
+    out = torch.empty((B, 8, 1024), dtype=torch.bfloat16, device=qkv.device)
+    _WS_GO = 1
+    try:
+        g = _ws_capture(lambda: _ws_launch(data, q, qkv, v, out, ws_acc, ws_ml, grid))[0]
+        ts = []
+        for _ in range(20):
+            flush.zero_()
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            e0.record()
+            g.replay()
+            e1.record()
+            torch.cuda.synchronize()
+            ts.append(1000.0 * e0.elapsed_time(e1))
+        med = sorted(ts)[len(ts) // 2]
+    finally:
+        _WS_GO = 0
+    nbytes = sum(lens) * 256
+    _say(f"[ws-diag] gather-only roofline {_WS_NAMES[v]} B={B} x ~80K: {med:.1f} us graph replay (incl. ~4 us launch), "
+         f"{nbytes / (med * 1e-6) / 1e12:.2f} TB/s over {nbytes / 1e6:.0f} MB (master decode gather ~3.0 TB/s; floor 4.8)")
+    del g, data
+
