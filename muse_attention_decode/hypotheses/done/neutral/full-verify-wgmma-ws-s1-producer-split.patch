+  float aA = 0.f, aB = 0.f;
+  ${SOFTMAX}
+  long long t_p0 = 0;
+  if (DBG) { t_p0 = clock64(); c_soft += t_p0 - t_m0; }
+  wg_wait_dyn((DUAL && m + 1 < N) ? 1 : 0);  // PV(m - 1) retired (S(m + 1) may still run)
+  fence_f(oacc);
+#pragma unroll
+  for (int kt = 0; kt < NK; ++kt) fence_u(pa[kt]);
+  if (DBG) { const long long t_p1 = clock64(); c_pvw += t_p1 - t_p0; }
+  if (m >= 1 && ss_c) ${STORE_PREV}
