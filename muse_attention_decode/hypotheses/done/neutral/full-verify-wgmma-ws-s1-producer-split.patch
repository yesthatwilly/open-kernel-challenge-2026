+def _ws_diag_phases(B: int, gen) -> None:
+    """PHASE DIAG: the ws64 kernel's PHASE instantiation (clock64 stamps, CTA 0), one eager launch, never timed or routed."""
+    global _WS_DBG, _WS_FORCE
+    lens = _ws_lens80(B)
+    data = _wsv_synth(lens, 1.0, gen, torch.device("cuda"))
+    _WS_DBG = torch.zeros(16, dtype=torch.float32, device="cuda")
+    _WS_FORCE = 3
+    try:
+        _WS_ERR.zero_()
+        kernel_fn(data)  # warm (module load / first launch)
+        torch.cuda.synchronize()
+        _WS_DBG.zero_()
+        e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        e0.record()
+        kernel_fn(data)
+        e1.record()
+        torch.cuda.synchronize()
+        d = _WS_DBG.cpu().tolist()
+        ms = e0.elapsed_time(e1)
+    finally:
+        _WS_FORCE = None
+        _WS_DBG = None
+    n = max(d[0], 1.0)
+    for g in range(2):
+        tot = max(d[11 + g], 1.0)
+        nsc = ms * 1e6 / tot  # cycles -> ns, calibrated on this CTA's own total (CTA 0 spans ~the whole launch)
+        names = ("FULL wait", "transpose", "S wait", "softmax+issue", "PV wait")
+        _say(f"[ws-diag] PHASE consumer WG{g} (CTA 0, {int(n)} tiles, ~{nsc:.3f} ns/cycle): "
+             + ", ".join(f"{nm} {d[1 + 5 * g + i] / n:.0f} cyc ({d[1 + 5 * g + i] / n * nsc:.0f} ns)/tile" for i, nm in enumerate(names))
+             + f"; total {tot / n:.0f} cyc ({tot / n * nsc:.0f} ns)/tile")
+    nsc = ms * 1e6 / max(d[15], 1.0)
+    _say(f"[ws-diag] PHASE producer (CTA 0): EMPTY wait {d[13] / n:.0f} cyc ({d[13] / n * nsc:.0f} ns)/tile, "
+         f"issue {d[14] / n:.0f} cyc ({d[14] / n * nsc:.0f} ns)/tile, total {d[15] / n:.0f} cyc/tile; launch {ms * 1e3:.1f} us eager")
+
