+  long long t_t0 = 0;
+  if (DBG) t_t0 = clock64();
+  ${TRANSPOSE}
+  long long t_s0 = 0;
+  if (DBG) { t_s0 = clock64(); c_trans += t_s0 - t_t0; }
+  wg_wait_dyn((m >= 1 ? 1 : 0) + ((DUAL && m + 1 < N) ? 1 : 0));  // S(m) retired
+  fence_f(sa[${UB}]);
+  fence_u(qa[${UB}][0]);
+  fence_u(qa[${UB}][1]);
