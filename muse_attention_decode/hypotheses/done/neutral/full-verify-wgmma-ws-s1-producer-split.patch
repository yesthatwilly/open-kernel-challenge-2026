+    reg_dec<PRODR>();
+    constexpr int TPT = 128 / TL;   // threads per token (2 at TL 64, 1 at TL 128)
+    constexpr int CHK = 8 / TPT;    // 16-byte chunks per thread per K / V row
+    const int tt = tid / TPT;       // token inside the tile
+    const int c0 = (tid % TPT) * CHK;
