+    const float p2 = ex2(sa[${UB}][4 * nb + 2] - vB), p3 = ex2(sa[${UB}][4 * nb + 3] - vB);
+    sumA += p0 + p1;
+    sumB += p2 + p3;
+    sa[${UB}][4 * nb] = p0;
+    sa[${UB}][4 * nb + 1] = p1;
+    sa[${UB}][4 * nb + 2] = p2;
+    sa[${UB}][4 * nb + 3] = p3;
+  }
