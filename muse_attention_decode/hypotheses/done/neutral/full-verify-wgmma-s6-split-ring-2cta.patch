+
+def _w6_self_check(variant: int):
+    """One-time eager check, in-process, on synthetic data only: the gated verify path through kernel_fn
+    against an FP32 causal reference, every launch traced (sync + print), the device ERROR WORD printed per
+    case (bounded-wait abort = 2). Every case runs even after a failure, so one check bisects the failing
+    variable (s5's 19-case table: canary, device grid, kv 0.25, single-request 2/4/17/34 tiles on one CTA,
+    request crossing, mid-request 1-tile segments, grids 3/7/61/264, lens_b, two coherent-key cases), and
+    the 'second eager call identical' test covers the ticket reset. Returns (ok, reason, table)."""
+    global _W6_GRID, _W6_FORCE, _W6_HOOK, _W6_ANYB, _W6_KEEP
+    lens_a = [9000, 1025, 70, 4097, 1023, 8]
+    lens_b = [129, 66, 195, 260, 69, 70, 71, 9, 15, 8, 64, 65, 3000]
+    # (name, lens, kv_scale, grid, coherent, second eager call)
+    cases = [("canary", [70, 13], 1.0, 4, False, False),
+             ("single-tile-lens_a-device", lens_a, 1.0, None, False, True),
+             ("lens_a-grid3-kv1", lens_a, 1.0, 3, False, False),
+             ("kv0.25-grid264", lens_a, 0.25, 264, False, False),
+             ("B1-2t", [128], 1.0, 1, False, False),
+             ("B1-4t", [256], 1.0, 1, False, False),
+             ("B1-17t", [1088], 1.0, 1, False, False),
+             ("B1-34t", [2176], 1.0, 1, False, False),
+             ("B1-4t-kv0.25", [256], 0.25, 1, False, False),
+             ("cross-2req-4t", [128, 128], 1.0, 1, False, False),
+             ("mid-1t-B1-3t-grid3", [192], 1.0, 3, False, False),
+             ("mid-1t-2req-grid3", [128, 128], 1.0, 3, False, False),
+             ("lens_a-grid3-kv0.25", lens_a, 0.25, 3, False, False),
+             ("lens_a-grid7-kv1", lens_a, 1.0, 7, False, False),
+             ("lens_a-grid61-kv0.25", lens_a, 0.25, 61, False, False),
+             ("lens_b-device", lens_b, 1.0, None, False, True),
+             ("lens_b-grid7-kv0.25", lens_b, 0.25, 7, False, False),
+             ("coherent-lens_a-grid3", lens_a, 1.0, 3, True, False),
+             ("coherent-lens_a-device", lens_a, 1.0, None, True, False)]
+    gen = torch.Generator(device="cuda").manual_seed(4321)
+    dev = torch.device("cuda")
+    tag = "AB"[variant]
+    _W6_FORCE = variant
+    _W6_ANYB = True
+    results, fails = {}, []
+    try:
+        for name, lens, kv_scale, grid, coherent, second in cases:
+            data = _w6_synthetic(lens, kv_scale, gen, dev, coherent)
+            assert _w6_gate(data["config"])
+            _W6_GRID = grid
+            _W6_ERR.zero_()
+            keep = {}
+            _W6_KEEP = keep
+            print(f"[s6] {tag} {name}: B={len(lens)} kv_scale={kv_scale} grid={grid or 'device'} coherent={coherent}; "
+                  f"launching kernel_fn (pre-attention first)", flush=True)
+            _W6_HOOK = _w6_trace
+            out = kernel_fn(data)
+            _W6_HOOK = None
+            _W6_KEEP = None
+            torch.cuda.synchronize()
+            flag = int(_W6_ERR.item())
+            ref = _w6_reference(data, lens)
+            err = float((out.float() - ref).norm() / ref.norm())
+            finite = bool(torch.isfinite(out).all())
+            passed = finite and err < 3e-2 and not flag
+            results[name] = passed
+            print(f"[s6] {tag} {name}: rel L2 {err:.2e}, finite {finite}, ERROR WORD {flag} "
+                  f"(1: not sm_90a, 2: mbarrier wait timeout, 4: shape) -> {'PASS' if passed else 'FAIL'}", flush=True)
+            if not passed:
+                fails.append((name, err, finite, flag))
+                if len([1 for f in fails if f[0] != name]) < 4 and "ws_acc" in keep:
+                    try:
+                        _w6_diagnose(data, lens, keep, f"{tag} {name}")
+                    except Exception as e:  # diagnosis must never take the check down
+                        print(f"[s6]   DIAG {tag} {name} raised {e!r}", flush=True)
+                continue
+            if second:
+                again = kernel_fn(data)
+                torch.cuda.synchronize()
+                same = bool(torch.equal(again, out))
+                print(f"[s6] {tag} {name}: second eager call identical {same}", flush=True)
+                if not same or int(_W6_ERR.item()):
+                    fails.append((name + " (second call)", float("nan"), True, int(_W6_ERR.item())))
+        for line in _w6_verdict(results):
+            print(f"[s6] {tag} BISECT: {line}", flush=True)
+        table = ", ".join(f"{k}={'ok' if v else 'FAIL'}" for k, v in results.items())
+        print(f"[s6] {tag} BISECT table: {table}", flush=True)
+        if fails:
+            n, e, f, w = fails[0]
+            return False, f"{n}, rel L2 {e:.2e}, finite {f}, error word {w}", results
+    except Exception as e:
+        print(f"[s6] {tag} self-check raised: {e!r}", flush=True)
+        return False, f"raised {type(e).__name__}", results
+    finally:
+        _W6_GRID = None
+        _W6_HOOK = None
+        _W6_KEEP = None
+        _W6_ANYB = False
+        _W6_FORCE = None
+    return True, None, results
