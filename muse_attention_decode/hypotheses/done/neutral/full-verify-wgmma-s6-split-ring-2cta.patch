+#ifndef W6_SET
+#define W6_SET 0   // 0: split-ring OVL=0 / OVL=1 (the routed candidates); 1: DIAG-only designs
+#endif
+
+namespace {
+
+constexpr int D = 64;              // head dim
+constexpr int HQ = 16;             // query heads
+constexpr int HKV = 2;             // kv heads
+constexpr int G = HQ / HKV;        // queries per kv head (8)
+constexpr int QL = 8;              // block tokens (q_len)
+constexpr int ROW = HKV * D;       // bytes per cache row (page 1: both kv heads, 128)
+constexpr int TILE = 64;           // tokens per tile (the stream-K unit)
+constexpr int IDX_TILES = 16;      // tiles per page-index prefetch block
+constexpr int IDX_N = IDX_TILES * TILE;
+constexpr int THREADS = 256;
+constexpr int MAXB = 64;
+constexpr int STAGE_BYTES = 2 * TILE * ROW;                  // K tile (8 KB) + V tile (8 KB), both heads' halves
+constexpr int VT_BYTES = D * TILE;                           // one head's V^T: 64 dims x 64 tokens
+constexpr long long WAIT_LIMIT = 2000000000LL;               // ~1 s of SM clock per mbarrier wait
+constexpr int SMEM_LIMIT = 232448;                           // sm_90 max dynamic smem per block (opt-in)
+
+// RING = 0: s5's layout exactly (one CTA-wide ring, 256-arrival FULL / EMPTY barriers, one shared
+// page-index block pair). RING = 1: the SAME 128-B-row SW128 ring and descriptors, but every stage's
+// two 64-B head halves have their own FULL / EMPTY barrier pair (128 arrivals: one warpgroup) and each
+// warpgroup prefetches its own page indices into a private block pair (so no cross-warpgroup wait
+// exists anywhere in the tile loop).
+template <int RING, int STAGES>
+struct Lay {
+  static constexpr int RING_OFF = 0;
+  static constexpr int VT_OFF = RING_OFF + STAGES * STAGE_BYTES;   // [HKV][2 buffers][VT_BYTES]
+  static constexpr int IDX_OFF = VT_OFF + HKV * 2 * VT_BYTES;
+  static constexpr int IDX_BYTES = (RING ? HKV : 1) * 2 * IDX_N * 4;  // int32 [(g)][2][IDX_N]
+  static constexpr int SEQ_OFF = IDX_OFF + IDX_BYTES;              // int32 [MAXB]
+  static constexpr int PRE_OFF = SEQ_OFF + MAXB * 4;               // int32 [MAXB + 4]
+  static constexpr int BAR_OFF = PRE_OFF + (MAXB + 4) * 4;         // u64 [NBAR]: FULL then EMPTY
+  static constexpr int NBAR = (RING ? 4 : 2) * STAGES;
+  static constexpr int FLAG_OFF = BAR_OFF + NBAR * 8;              // int abort, last[HKV], pad
+  static constexpr int QS_OFF = FLAG_OFF + 16;                     // u32 [8][THREADS]: each thread's own Q A fragment
+  static constexpr int USED = QS_OFF + 8 * THREADS * 4;
+  static constexpr int BYTES = USED + 1024;                        // slack: the base is rounded up to 1024 B
+  static_assert(VT_OFF % 1024 == 0 && STAGE_BYTES % 1024 == 0 && VT_BYTES % 512 == 0, "swizzle atom alignment");
+  static_assert(BAR_OFF % 8 == 0, "mbarrier alignment");
+  static_assert(STAGES >= 3 && STAGES <= IDX_TILES, "page-index block rotation needs STAGES <= IDX_TILES");
+};
+
+// The 1-CTA/SM ring depth: 12 stages if the whole layout fits the per-block limit, else 10.
+constexpr int S_OVL = (Lay<1, 12>::BYTES <= SMEM_LIMIT) ? 12 : 10;
+static_assert(Lay<1, S_OVL>::BYTES <= SMEM_LIMIT, "1-CTA/SM layout must fit");
+static_assert(Lay<1, 4>::BYTES <= 116000, "4-stage split layout must fit two CTAs per SM");
+
+__device__ __forceinline__ uint32_t smem_u32(const void* p) {
+  return static_cast<uint32_t>(__cvta_generic_to_shared(p));
+}
+__device__ __forceinline__ void cp_async16(uint32_t dst, const void* src, int src_bytes) {
+  asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;\n" :: "r"(dst), "l"(src), "r"(src_bytes) : "memory");
+}
+__device__ __forceinline__ void cp_async4(uint32_t dst, const void* src, int src_bytes) {
+  asm volatile("cp.async.ca.shared.global [%0], [%1], 4, %2;\n" :: "r"(dst), "l"(src), "r"(src_bytes) : "memory");
+}
+__device__ __forceinline__ void cp_commit() { asm volatile("cp.async.commit_group;\n" ::: "memory"); }
+__device__ __forceinline__ void cp_wait_all() { asm volatile("cp.async.wait_all;\n" ::: "memory"); }
+// Per-thread Q fragment staging: volatile shared accesses, so the compiler can neither keep the
+// fragment in registers across tiles nor move the reload relative to the barrier waits.
+__device__ __forceinline__ void sts32(uint32_t a, uint32_t v) {
+  asm volatile("st.shared.u32 [%0], %1;\n" :: "r"(a), "r"(v) : "memory");
+}
+__device__ __forceinline__ uint32_t lds32(uint32_t a) {
+  uint32_t v;
+  asm volatile("ld.shared.u32 %0, [%1];\n" : "=r"(v) : "r"(a) : "memory");
+  return v;
+}
+__device__ __forceinline__ float ex2(float x) {
+  float y;
+  asm("ex2.approx.ftz.f32 %0, %1;" : "=f"(y) : "f"(x));
+  return y;
+}
+
+// First flat tile of CTA c: floor(c * T / grid), int64 math.
+__device__ __forceinline__ int start_of(int c, int T, int grid) {
+  return static_cast<int>((static_cast<int64_t>(c) * T) / grid);
+}
+// The CTA whose range holds flat tile x (0 <= x < T): the largest c with start(c) <= x.
+__device__ __forceinline__ int owner_of(int x, int T, int grid) {
+  int c = static_cast<int>(((static_cast<int64_t>(x) + 1) * grid - 1) / T);
+  c = c < 0 ? 0 : (c > grid - 1 ? grid - 1 : c);
+  while (c > 0 && start_of(c, T, grid) > x) --c;
+  while (c + 1 < grid && start_of(c + 1, T, grid) <= x) ++c;
+  return c;
+}
+// Request of flat tile f: the largest b with pre[b] <= f.
+__device__ __forceinline__ int req_of(const int* pre, int B, int f) {
+  int lo = 0, hi = B - 1;
+  while (lo < hi) {
+    const int mid = (lo + hi + 1) >> 1;
+    if (pre[mid] <= f) lo = mid; else hi = mid - 1;
+  }
+  return lo;
+}
+// Warp 0: pre[0] = 0, pre[b + 1] = sum of tiles of batch rows 0..b (seq in smem, B <= 64).
+__device__ __forceinline__ void tile_prefix(const int* seq, int* pre, int B, int lane) {
+  const int i0 = lane * 2, i1 = lane * 2 + 1;
+  const int v0 = i0 < B ? (seq[i0] + TILE - 1) / TILE : 0;
+  const int v1 = i1 < B ? (seq[i1] + TILE - 1) / TILE : 0;
+  int s = v0 + v1;
+#pragma unroll
+  for (int o = 1; o < 32; o <<= 1) {
+    const int t = __shfl_up_sync(0xffffffffu, s, o);
+    if (lane >= o) s += t;
+  }
+  if (i0 < B) pre[i0 + 1] = s - v1;
+  if (i1 < B) pre[i1 + 1] = s;
+  if (lane == 0) pre[0] = 0;
+}
+
+// The LSE merge of request b's slots for kv head g's 8 q heads (64 rows x 64 dims), by the 128
+// threads of one warpgroup (thread tw: row tw / 2, dims (tw & 1) * 32 .. + 31), times v_scale, then
+// the master epilogue: scaleless RMSNorm over 64 (eps inside the sqrt) times sigmoid(gate), bf16.
+// Slots are read through L2 (__ldcg): other CTAs wrote them in this launch.
+__device__ __forceinline__ void merge_head(int b, int g, int tw, const int* pre_s, int B, int gx,
+                                           const float* ws_acc, const float* ws_ml, const float* v_scale,
+                                           const __nv_bfloat16* qkv, int64_t qkv_stride,
+                                           __nv_bfloat16* out, float eps) {
+  const float NEG_INF = __int_as_float(0xff800000u);
+  const int rr = tw >> 1, hh = rr >> 3, j = rr & 7, h = g * G + hh, dh = (tw & 1) * 32;
+  const int T = pre_s[B], x0 = pre_s[b], x1 = pre_s[b + 1];
+  const int c_lo = owner_of(x0, T, gx), c_hi = owner_of(x1 - 1, T, gx);
+  const int row = j * HQ + h;
+  float M = NEG_INF;
+  for (int c = c_lo; c <= c_hi; ++c) {
+    const int lo = max(start_of(c, T, gx), x0), hi = min(start_of(c + 1, T, gx), x1);
+    if (lo < hi) M = fmaxf(M, __ldcg(ws_ml + static_cast<int64_t>(c + b) * 2 * QL * HQ + row));
+  }
+  const float Mu = M == NEG_INF ? 0.f : M;
+  float o[32];
+#pragma unroll
+  for (int i = 0; i < 32; ++i) o[i] = 0.f;
+  float L = 0.f;
+  for (int c = c_lo; c <= c_hi; ++c) {
+    const int lo = max(start_of(c, T, gx), x0), hi = min(start_of(c + 1, T, gx), x1);
+    if (lo >= hi) continue;
+    const int64_t sl = static_cast<int64_t>(c + b);
+    const float m = __ldcg(ws_ml + sl * 2 * QL * HQ + row);
+    const float wt = m == NEG_INF ? 0.f : ex2(m - Mu);  // rows with no valid key here weigh 0
+    L += wt * __ldcg(ws_ml + sl * 2 * QL * HQ + QL * HQ + row);
+    const float4* src = reinterpret_cast<const float4*>(ws_acc + ((sl * QL + j) * HQ + h) * D + dh);
+#pragma unroll
+    for (int i = 0; i < 8; ++i) {
+      const float4 a = __ldcg(src + i);
+      o[4 * i] += wt * a.x; o[4 * i + 1] += wt * a.y; o[4 * i + 2] += wt * a.z; o[4 * i + 3] += wt * a.w;
+    }
+  }
+  const float fsc = L > 0.f ? __ldg(v_scale) / L : 0.f;  // every row has key 0, so L > 0
+  float ss = 0.f;
+#pragma unroll
+  for (int i = 0; i < 32; ++i) { o[i] *= fsc; ss += o[i] * o[i]; }
+  ss += __shfl_xor_sync(0xffffffffu, ss, 1);  // the other half of the row's 64 dims
+  const float rinv = 1.f / sqrtf(ss / D + eps);
+  const int64_t tok = static_cast<int64_t>(b) * QL + j;
+  const __nv_bfloat16* gp = qkv + tok * qkv_stride + (HQ + 2 * HKV) * D + h * D + dh;
+  __nv_bfloat16* op = out + (tok * HQ + h) * D + dh;
+#pragma unroll
+  for (int i = 0; i < 32; i += 2) {
+    const __nv_bfloat162 gg = *reinterpret_cast<const __nv_bfloat162*>(gp + i);
+    const float g0 = __low2float(gg), g1 = __high2float(gg);
+    *reinterpret_cast<__nv_bfloat162*>(op + i) =
+        __floats2bfloat162_rn(o[i] * rinv / (1.f + expf(-g0)), o[i + 1] * rinv / (1.f + expf(-g1)));
+  }
+}
+
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
