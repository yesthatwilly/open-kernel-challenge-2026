+                    _say(f"[s6-diag] gather-only {_W6_NAMES[v].split('gather-only ')[1]}: {tb16[v][0]:.1f} us, {tb16[v][1]:.2f} TB/s")
+            line = "; ".join(f"{_W6_NAMES[v].split(':')[0].split(',')[0]} {tb16[v][0]:.1f} us {tb16[v][1]:.2f} TB/s"
+                             for v in designs if v < 3)
+            _say(f"[s6-diag] B=16 x 80K agentic ({nbytes / 1e6:.0f} MB K+V rows) full kernels (bare, no pre-attention): {line}")
+        if ref is not None and 2 in bufs:
+            rel = float((bufs[2][2].float() - ref).norm() / ref.norm())
+            _say(f"[s6-diag] B={B}: s5-ring full output vs variant A rel L2 {rel:.2e}; device error word {eword}")
+        del data, q, qkv, kc, vc, pt, bufs
+        torch.cuda.empty_cache()
+    summary = []
+    for v in designs:
+        xs = [p[0] for p in pts[v]]
+        a, b = _w6_fit(xs, [p[1] for p in pts[v]])
+        line = (f"[s6-diag] fit variant {v} ({_W6_NAMES[v].split(',')[0]}): T = a + b * tiles/CTA: a = {a:.1f} us fixed, "
+                f"b = {b:.3f} us/tile; T(B=8/16/32) = " + " / ".join(f"{p[1]:.1f}" for p in pts[v]) + f" us at {xs[0]:.0f}/{xs[1]:.0f}/{xs[2]:.0f} tiles/CTA")
+        _say(line)
+        summary.append(f"[s6-diag] fit v{v}: a={a:.1f}us b={b:.3f}us/tile T8/16/32={'/'.join(f'{p[1]:.0f}' for p in pts[v])}us")
+    if have_diag:
+        for v in (3, 5, 7):
+            if v in tb16 and v + 1 in tb16:
+                summary.append(f"[s6-diag] gather-only v{v}/v{v + 1} (epilogue kept/removed) B=16: {tb16[v][0]:.1f}/{tb16[v + 1][0]:.1f} us "
+                               f"({tb16[v][1]:.2f}/{tb16[v + 1][1]:.2f} TB/s)")
+    del flush
+    torch.cuda.empty_cache()
+    return summary
