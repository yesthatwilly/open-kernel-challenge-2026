+def _w6_trace(msg: str) -> None:
+    """Self-check hook between launches: wait for the GPU, then say what finished, so a fault is attributed
+    to the kernel before it. Never installed during timed calls."""
+    torch.cuda.synchronize()
+    print(f"[s6]   {msg}", flush=True)
