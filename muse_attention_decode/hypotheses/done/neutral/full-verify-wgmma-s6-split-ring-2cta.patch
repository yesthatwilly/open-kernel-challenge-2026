+def _w6_prepare_q(data):
+    """The pre-attention launch as kernel_fn issues it for the unpaired verify layout (DIAG only)."""
+    cfg = data["config"]
+    batch, length, hq, hkv, d = cfg["batch"], cfg["q_len"], cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"]
+    tokens = batch * length
+    qkv = data["qkv"].reshape(tokens, -1)
+    q = torch.empty((tokens, hq, d), dtype=FP8, device=qkv.device)
+    _pre_attention_kernel[(tokens, hq + hkv)](
+        qkv, data["positions"], data["cache_loc"], data["k_scale"], data["k_scale"], data["v_scale"],
+        q, data["k_cache"], data["v_cache"], qkv.stride(0),
+        HQ=hq, HKV=hkv, D=d, ROPE=False, EPS=RMS_EPS, PAIRED=False, G=hq // hkv, num_warps=1,
+    )
+    return q, qkv
+
+
+def _w6_fit(xs, ts):
+    """Least squares T = a + b x over the points (x = tiles per CTA)."""
+    n = len(xs)
+    mx, mt = sum(xs) / n, sum(ts) / n
+    sxx = sum((x - mx) ** 2 for x in xs)
+    b = sum((x - mx) * (t - mt) for x, t in zip(xs, ts)) / sxx if sxx > 0 else 0.0
+    return mt - b * mx, b
+
+
+def _w6_diag(have_diag: bool, ok_vars) -> list:
+    """Prepare-only DIAG, never routed and never timed in kernel_fn. Times the bare kernels (cold L2 graph
+    replays, no pre-attention) at B = 8 / 16 / 32 x ~80K agentic lengths: the full s5 CTA-wide ring (v2), s6 A
+    (v0), s6 B (v1) and, when the DIAG module built, the six gather-only instantiations (each ring design with
+    and without the ticket epilogue). Prints the TB/s of every design and the fit T = a + b * tiles/CTA (a = the
+    fixed, B-independent component, b = the per-tile slope). Returns the compact summary lines."""
+    dev = torch.device("cuda")
+    sms = _sm_count(dev)
+    gen = torch.Generator(device="cuda").manual_seed(2468)
+    flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+    designs = [v for v in (2, 0, 1) if (v in ok_vars if v < 2 else have_diag)] + ([3, 4, 5, 6, 7, 8] if have_diag else [])
+    pts = {v: [] for v in designs}
