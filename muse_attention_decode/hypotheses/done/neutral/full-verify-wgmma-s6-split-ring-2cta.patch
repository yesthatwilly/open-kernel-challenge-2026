+        seql, ksc, vsc = data["cache_seqlens"], data["k_scale"], data["v_scale"]
+        nbytes = sum(lens) * 256
+        tiles = sum((n + 63) // 64 for n in lens)
+        tk = _w6_tickets(dev)
+        bufs = {}
+        for v in designs:
