+                       torch.empty((grid + B, 2, 128), dtype=torch.float32, device=dev),
+                       torch.empty((B, 8, 1024), dtype=torch.bfloat16, device=dev),
+                       torch.zeros(grid * 256, dtype=torch.int32, device=dev), grid)
