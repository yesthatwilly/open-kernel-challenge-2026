+# --- the prepare-time gate: two interleaved rounds against master's ROUTED path -------------------
+
+def _w6_capture(fn):
+    """fn captured as a CUDA graph after an eager warm-up on a side stream; returns (graph, output)."""
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        fn()
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        o = fn()
+    torch.cuda.synchronize()
+    return g, o
+
+
+def _w6_replay_times(graphs: dict, flush, reps: int, rot: int) -> dict:
+    """Replay every graph `reps` times, interleaved (the order reverses every rep and its start rotates with
+    `rot`), a 256 MB flush before each replay (cold L2). Returns {label: [us per replay]}."""
+    labels = list(graphs)
+    ev = {k: [] for k in labels}
+    for rep in range(reps):
+        k0 = (rot + rep) % len(labels)
+        order = labels[k0:] + labels[:k0]
+        if rep % 2:
+            order = order[::-1]
+        for k in order:
+            flush.zero_()
+            e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            e0.record()
+            graphs[k].replay()
+            e1.record()
+            ev[k].append((e0, e1))
+    torch.cuda.synchronize()
+    return {k: [1000.0 * a.elapsed_time(b) for a, b in v] for k, v in ev.items()}
+
+
+def _w6_stats(ts):
+    s = sorted(ts)
+    n = len(s)
+    return s[n // 2], s[(3 * n) // 4] - s[n // 4]
+
+
+def _w6_agentic_lens(B: int):
+    """The scored shapes' lengths: ctx 80000, agentic spread (74K-86K)."""
+    return [int(80000 * (1 + 0.075 * (2 * ((i * 7) % 13) / 12 - 1))) for i in range(B)]
+
+
+_W6_MASTER_KERNELS = "_pre_attention_kernel + FA3 paired + FlashAttnFwdCombine + _paired_norm_gate_kernel"
+_W6_THR = 1.05
+_W6_ROUNDS = 2
+_W6_REPS = 40
+
+
+def _w6_gate_band(B: int, cands, gen, flush, empty):
+    """Time master's ROUTED paired-FA3 path (kernel_fn with the s6 route off) against each candidate
+    variant's kernel_fn, as cold-L2 CUDA-graph replays, two interleaved rounds of 40, an empty-graph
+    baseline subtracted. A variant clears the cell only if BOTH rounds are >= 1.05x vs master, its IQR is
+    <= 1.5x master's in both, its output agrees with master's (rel L2 < 3e-2), it is finite and the device
+    error word is 0. Returns (best variant | None, numbers dict)."""
+    global _W6_FORCE
+    dev = torch.device("cuda")
+    lens = _w6_agentic_lens(B)
+    data = _w6_synthetic(lens, 1.0, gen, dev)
+    graphs, outs = {}, {}
+    _W6_ERR.zero_()
+    try:
+        for label, f in [("master", -1)] + [(f"v{v}", v) for v in cands]:
+            _W6_FORCE = f
+            graphs[label], outs[label] = _w6_capture(lambda: kernel_fn(data))
+    finally:
+        _W6_FORCE = None
+    graphs["empty"] = empty
+    rounds = []
+    for rd in range(_W6_ROUNDS):
+        t = _w6_replay_times(graphs, flush, _W6_REPS, rd)
+        rounds.append({k: _w6_stats(v) for k, v in t.items()})
+    eword = int(_W6_ERR.item())
+    om = outs["master"].float()
+    nums = {"B": B, "rounds": rounds, "eword": eword, "cand": {}}
+    best, best_ratio = None, 0.0
+    for v in cands:
+        ov = outs[f"v{v}"].float()
+        agree = float((ov - om).norm() / om.norm())
+        fin = bool(torch.isfinite(ov).all())
+        ratios, iqr_ok = [], True
+        for rd, st in enumerate(rounds):
+            e = st["empty"][0]
+            m_us, m_iqr = st["master"][0] - e, st["master"][1]
+            v_us, v_iqr = st[f"v{v}"][0] - e, st[f"v{v}"][1]
+            ratio = m_us / v_us if v_us > 0 else 0.0
+            ratios.append(ratio)
+            iqr_ok = iqr_ok and v_iqr <= 1.5 * max(m_iqr, 0.5)  # 0.5 us floor: a timer-resolution master IQR must not veto
+            _say(f"[s6-gate] B={B} round {rd + 1}: master routed path ({_W6_MASTER_KERNELS}) {m_us:.1f} us net "
+                 f"(IQR {m_iqr:.1f}) vs variant {v} [_pre_attention_kernel + w6_kernel] {v_us:.1f} us net (IQR {v_iqr:.1f}) "
+                 f"-> master / variant {ratio:.3f}x (empty graph {e:.1f} us subtracted)")
+        ok = min(ratios) >= _W6_THR and iqr_ok and agree < 3e-2 and fin and not eword
+        nums["cand"][v] = {"ratios": ratios, "iqr_ok": iqr_ok, "agree": agree, "finite": fin, "ok": ok}
+        _say(f"[s6-gate] B={B} variant {v}: ratios {ratios[0]:.3f}x / {ratios[1]:.3f}x (both need >= {_W6_THR}), IQR <= 1.5x master "
+             f"{iqr_ok}, rel L2 vs master {agree:.2e} (< 3e-2), finite {fin}, error word {eword} -> "
+             f"{'CLEARS the cell' if ok else 'does not clear'}")
+        mean = sum(ratios) / len(ratios)
+        if ok and mean > best_ratio:
+            best, best_ratio = v, mean
+    del graphs, outs, om
+    return best, nums
+
+
+def _w6_two_state(B: int, variant: int, gen):
+    """Two states, one CUDA graph each, captured once; alternating replays (A B A B B A, refilled in place with
+    different request lengths) through kernel_fn with the candidate route active, each against its own FP32
+    reference. Nothing in the kernel may hold a pointer into either state. None on success, else the reason."""
+    global _W6_ROUTE
+    dev = torch.device("cuda")
+    lens = _w6_agentic_lens(B)
+    top = max(lens)
+    sets = [[max(9, n) for n in s] for s in _alt_sets(lens)]
+
+    def synth(L):
+        return _w6_synthetic(L, 1.0, gen, dev, max_pages=top + 37)
+
+    prev = _W6_ROUTE
+    _W6_ROUTE = MappingProxyType({_w6_band(B): variant})
+    _W6_ERR.zero_()
+    try:
