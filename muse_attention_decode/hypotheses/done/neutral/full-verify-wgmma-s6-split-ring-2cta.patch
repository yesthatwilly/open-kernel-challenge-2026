+def _w6_image_check(ext, variants) -> dict:
+    """Per variant: regs, local (spill) bytes, binary version, CTAs/SM and dynamic smem, printed. A variant is
+    refused with local bytes > 0, a non-sm_90 image, or (variant 0) fewer than 2 CTAs/SM, which would measure
+    1-CTA/SM TLP instead of the premise. Returns {variant: None | refusal reason}."""
+    out = {}
+    cap = tuple(torch.cuda.get_device_capability())
+    try:
+        st = ext.w6_ovl_stages().tolist()
+        _say(f"[s6] 1-CTA/SM ring depth chosen {st[0]} stages: {st[1]} B of dynamic smem; 12 stages would need {st[2]} B "
+             f"against the {232448} B per-block limit ({'fits' if st[2] <= 232448 else 'does not fit, so 10'})")
+    except Exception as e:
+        _say(f"[s6] w6_ovl_stages raised {e!r}")
+    for v in variants:
+        try:
+            a = ext.w6_attrs(v).tolist()
+        except Exception as e:
+            out[v] = f"attrs raised {type(e).__name__}"
+            _say(f"[s6] variant {v} ({_W6_NAMES[v]}): attrs raised {e!r}")
+            continue
+        _say(f"[s6] variant {v} ({_W6_NAMES[v]}): regs {a[0]}, local bytes {a[1]}, binaryVersion {a[2]}, ptxVersion {a[3]}, "
+             f"CTAs/SM {a[4]}, dyn smem {a[5]} B (max attr {a[6]}, static {a[7]})")
+        if cap != (9, 0):
+            out[v] = f"device capability {cap}"
+        elif a[2] != 90:
+            out[v] = f"loaded image is not sm_90 SASS (binaryVersion {a[2]})"
+        elif a[1] > 0:
+            out[v] = f"local bytes {a[1]} > 0 (register spill)"
+        elif v in (0, 2, 3, 4, 5, 6) and a[4] < 2:
+            out[v] = f"CTAs/SM {a[4]} < 2 (the 2-CTA/SM premise is not met)"
+        elif a[4] < 1:
+            out[v] = "0 CTAs/SM"
+        else:
+            out[v] = None
+        if out[v] is not None:
+            _say(f"[s6] variant {v} REFUSED: {out[v]}")
+    return out
