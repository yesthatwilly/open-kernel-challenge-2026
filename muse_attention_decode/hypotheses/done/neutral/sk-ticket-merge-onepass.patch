+    gen = torch.Generator(device="cuda").manual_seed(5150)
+    S = 48
+    ninf = float("-inf")
+    acc = torch.randn((S, 16, 64), generator=gen, device=dev)
+    ml = torch.empty((S, 2, 16), device=dev)
+    ml[:, 0] = 4 * torch.randn((S, 16), generator=gen, device=dev)
+    ml[:, 1] = torch.rand((S, 16), generator=gen, device=dev) * 50 + 1
+    for sl in (1, 2, 3, 10, 11, 12, 13, 22, 23, 24, 25):
+        ml[sl, 0] = ninf               # empty slots: every head
+        ml[sl, 1] = 1e3                # finite garbage that must weigh 0
+        acc[sl] = 1e3
+    hit = torch.rand((S, 16), generator=gen, device=dev) < 0.25
+    hit[:30] = False
+    ml[:, 0][hit] = ninf               # per-head empty slots in 30..47
+    cases = ((0, 0), (1, 1), (5, 7), (2, 9), (2, 18), (10, 13), (22, 33), (30, 47), (26, 45), (0, 47))
+    lo = torch.tensor([c[0] for c in cases], dtype=torch.int32, device=dev)
+    hi = torch.tensor([c[1] for c in cases], dtype=torch.int32, device=dev)
+    n = len(cases)
+    for mb in mbs:
+        o1, o2 = (torch.full((n, 16, 64), float("nan"), device=dev) for _ in range(2))
+        l1, m1, l2, m2 = (torch.full((n, 16), float("nan"), device=dev) for _ in range(4))
+        _EXT2.sk_merge_test(acc, ml, lo, hi, o1, l1, m1, o2, l2, m2, mb)
+        torch.cuda.synchronize()
+        if not torch.equal(m1, m2):
+            return f"MB {mb}: M differs from merge_range"
+        if not (torch.isfinite(o2).all() and torch.isfinite(l2).all()):
+            return f"MB {mb}: non-finite o / L"
+        el = float(((l2 - l1).abs() / l1.abs().clamp_min(1e-30)).max())
+        eo = float(((o2 - o1).norm() / o1.norm().clamp_min(1e-30)))
+        if el > 1e-4 or eo > 1e-4:
+            return f"MB {mb}: L rel {el:.1e} / o rel {eo:.1e} vs merge_range"
+        k = cases.index((10, 13))  # every slot empty
+        if not (bool(torch.isneginf(m2[k]).all()) and float(l2[k].abs().max()) == 0.0 and float(o2[k].abs().max()) == 0.0):
+            return f"MB {mb}: every-slot-empty case is not (M -inf, L 0, o 0)"
+        _say(f"[op] merge canary MB {mb}: {n} cases (leading-empty, every-slot-empty, per-head -inf) match merge_range: "
+             f"M exact, L rel {el:.1e}, o rel {eo:.1e}")
+    return None
+
+
+def _op_run_cases(label: str, kind: str, variant: int, cases, gen) -> "str | None":
+    """The incumbent's own correctness cases run on twin `variant`, one compact line for the whole set (the line before
+    names the set, so a fault is attributable). kind: full (_splitkv_*), ps (verify, L 8) or sd (decode, L 1)."""
+    dev = torch.device("cuda")
+    _say(f"[op] {label}: launching {len(cases)} correctness cases on {_SK_LABELS[variant]}")
+    worst, wtag = 0.0, ""
+    for tag, lens, kv, grid in cases:
+        if kind == "full":
+            data = _splitkv_synthetic(lens, kv, gen, dev)
+            q, qkv = _sk_prepare_q(data)
+            out, _, _ = _sk_launch(data, q, qkv, variant, grid)
+            torch.cuda.synchronize()
+            err, fin = _rel_l2(out, _splitkv_reference(data, lens))
+        else:
+            data = _ps_synthetic(lens, kv, gen, dev, L=8 if kind == "ps" else 1)
+            q, qkv = _ps_prepare_q(data)
+            out = (_ps_launch if kind == "ps" else _sd_sk_launch)(data, q, qkv, variant, grid)
+            torch.cuda.synchronize()
+            err, fin = _rel_l2(out, _ps_reference(data, lens))
+        if not (fin and err < 2e-2):
+            _say(f"[op] {label}: case {tag} grid {grid} FAILED: rel L2 {err:.2e}, finite {fin}")
+            return f"case {tag} grid {grid}"
+        if err > worst:
+            worst, wtag = err, tag
+        del data, q, qkv, out
+    _say(f"[op] {label}: {len(cases)} cases ok, worst rel L2 {worst:.2e} ({wtag})")
+    return None
+
+
+def _op_rounds(fns, flush, nrounds=2):
+    """nrounds interleaved rounds (fresh graphs each, cold L2, empty graph subtracted): per round, per fn (median, IQR)."""
+    out = []
+    for _ in range(nrounds):
+        lists, emp = _sw_rounds(fns, flush, warm=3, reps=_OP_REPS)
+        out.append([_sw_stats(x, emp) for x in lists])
+    return out
+
+
+def _op_eager_ok(fn, ref) -> "tuple[bool, float]":
+    out = fn()
+    torch.cuda.synchronize()
+    err, fin = _rel_l2(out, ref)
+    return fin and err < 2e-2, err
+
+
+def _op_time_cell(cell: str, fns, ref, flush, slots: float, extra=None) -> "tuple[bool, str]":
+    """fns = [incumbent pair, twin pair, (readouts...)]: eager correctness of each on the timing data, then two
+    interleaved rounds. Decision on fns[0] vs fns[1] only. Returns (route the twin, the detail text)."""
+    for i, fn in enumerate(fns):
+        ok, err = _op_eager_ok(fn, ref)
+        if not ok:
+            if i < 2:
+                return False, f"{'incumbent' if i == 0 else 'twin'} failed the timing-data check (rel L2 {err:.2e})"
+            _say(f"[op] {cell}: readout {i} failed the timing-data check (rel L2 {err:.2e}): dropped")
+            fns = fns[:i]
+            break
+    rounds = _op_rounds(fns, flush)
+    ratios, iqr_ok, parts = [], True, []
+    for rd, st in enumerate(rounds, 1):
+        (ti, ii), (to, io) = st[0], st[1]
+        ti, to = max(ti, 0.5), max(to, 0.5)
+        ratios.append(ti / to)
+        iqr_ok = iqr_ok and io <= _OP_IQR * max(ii, _OP_IQR_FLOOR)
+        parts.append(f"r{rd} {ti:.1f} vs {to:.1f} us ({ti / to:.3f}x, IQR {ii:.1f}/{io:.1f})")
+        _say(f"[op] {cell} round {rd}: incumbent {ti:.1f} us IQR {ii:.1f}, onepass {to:.1f} us IQR {io:.1f} -> "
+             f"{ti / to:.3f}x" + "".join(f"; {extra[j - 2]} {max(st[j][0], 0.5):.1f} us ({ti / max(st[j][0], 0.5):.3f}x)"
+                                         for j in range(2, len(st)) if extra))
+    win = min(ratios) >= _OP_GATE and iqr_ok
+    detail = (f"{'; '.join(parts)}; ~{slots:.1f} slots/request; needs >= {_OP_GATE:.2f}x both rounds"
+              + ("" if iqr_ok else ", IQR bound MISSED"))
+    return win, detail
+
+
+def _op_readout(cell: str, fns, labels, ref, flush) -> None:
+    """Print-only: one interleaved round of fns (eager-checked first). Never routes."""
+    keep, names = [], []
+    for fn, lab in zip(fns, labels):
+        ok, err = _op_eager_ok(fn, ref)
+        if ok:
+            keep.append(fn)
+            names.append(lab)
+        else:
+            _say(f"[op] {cell} readout {lab}: failed the timing-data check (rel L2 {err:.2e}): not timed")
+    if len(keep) < 2:
+        return
+    st = _op_rounds(keep, flush, nrounds=1)[0]
+    _say(f"[op] {cell} readout (print only, 1 round of {_OP_REPS}): "
+         + ", ".join(f"{lab} {max(m, 0.5):.1f} us (IQR {q:.1f})" for lab, (m, q) in zip(names, st)))
+
+
+def _op_next_spec(specs, spec, grid_of):
+    """The first grid spec after `spec` whose grid differs (one grid step up), else None."""
+    g0 = grid_of(spec)
+    for sp in specs[specs.index(spec) + 1:]:
+        if grid_of(sp) != g0:
+            return sp
+    return None
+
+
+def _op_spill(attrs, v) -> "str | None":
+    a = attrs.get(v)
+    if a is None:
+        return "attributes unavailable"
+    if a[0] != 90:
+        return f"cubin version {a[0]} is not 90"
+    if a[3] > 0:
+        return f"local-memory spill ({a[3]} B)"
+    if a[6] < 1:
+        return "0 CTAs/SM"
+    return None
+
