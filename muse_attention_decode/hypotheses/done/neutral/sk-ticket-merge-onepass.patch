+        lens32 = [rng.randint(1, 12000) for _ in range(32)]
+        lens32[5], lens32[9], lens32[17] = 6, 64, 1
+        lens64 = [rng.randint(1, 70) if i % 3 == 0 else rng.randint(64, 6000) for i in range(64)]
+        cases = (("canary B=2 short", [4, 66], 1.0, two),
+                 ("B=2 one request spans every CTA, grid 7", [20000, 2], 1.0, 7),
+                 ("B=2 one request spans every CTA", [60000, 2], 0.25, two),
+                 ("B=16 ragged kv 0.25", _SK_LENS16, 0.25, two), ("B=16 ragged grid 3", _SK_LENS16, 1.0, 3),
+                 ("B=32 ragged grid 3", lens32, 1.0, 3), ("B=32 ragged kv 0.25", lens32, 0.25, two),
+                 ("B=64 mixed kv 0.25", lens64, 0.25, two), ("B=64 mixed grid 7", lens64, 1.0, 7))
+        _OP_FULL_CHECKED["r"] = _op_run_cases("full decode twin 8", "full", 8, cases, gen)
+    if _OP_FULL_CHECKED["r"] is not None:
+        return False, None, f"twin 8 failed {_OP_FULL_CHECKED['r']}"
+    if band == 2:
+        lens, kv = list(_SK_LENS16), 0.25
+    else:
+        rng = random.Random(77)
+        lens = [rng.randint(1, 12000) for _ in range(32)]
+        lens[0], kv = 9000, 1.0
+    dev = torch.device("cuda")
+    sets = _alt_sets(lens)
+    mp = max(max(s) for s in sets) + 1 + 37
+    saved = _SK_VARIANT
+    _SK_VARIANT = MappingProxyType({**dict(saved), band: 8})  # the replay check captures kernel_fn with the twin routed
+    try:
+        why = _op_quiet(_alt_check, f"[op] replay {name}",
+                        lambda l: _splitkv_synthetic(l, kv, gen, dev, max_pages=mp), _splitkv_reference, sets, None,
+                        lambda cfg: _splitkv_gate(cfg) and not _fused_gate(cfg) and _fused_band(cfg["batch"]) == band)
+    finally:
+        _SK_VARIANT = saved
+    _rezero_tickets()
+    if why is not None:
