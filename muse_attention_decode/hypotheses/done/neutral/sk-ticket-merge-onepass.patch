+    the band's variant (0), grid 2xSM. Skipped for a band routed to FUSED_PRE."""
+    global _SK_VARIANT
+    name = _FUSED_BAND_NAMES[band]
+    cell = f"full decode {name}"
+    if band in _FUSED_ROUTE and _EXTF is not None:
