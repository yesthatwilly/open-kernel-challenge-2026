+def _op_setup() -> None:
+    """Gate every cell, then swap the routed twins into the frozen tables at once. Never raises; every failure,
+    deadline or loss keeps that cell's incumbent exactly."""
+    global _SK_VARIANT, _SD_ROUTE
+    cells = ("sliding verify B=1", "full decode B=2..16", "full decode B=17..64", "sliding decode B=17..32")
+    if _EXT2 is None:
+        for c in cells:
+            _say(f"PATH CHOSEN: sk ticket merge [{c}]: incumbent (stage-2 module unavailable)")
+        return
+    dev = torch.device("cuda")
+    t_all = time.perf_counter()
+    res = {}
+    try:
+        if not _op_ok("attrs + merge canary", _OP_CHECK_BY):
+            for c in cells:
+                _say(f"PATH CHOSEN: sk ticket merge [{c}]: incumbent (skipped: deadline)")
+            return
+        vs = (0, 4, 6, 8, 9, 10, 11) if _PS_BUILT else (0, 8)
+        attrs = {}
+        for v in vs:
+            a = list(_EXT2.sk_attrs(v))
+            attrs[v] = a
+            _say(f"[op] {_SK_LABELS[v]} (v{v}): cubin {a[0]}, regs {a[2]}, local {a[3]} B, dyn smem {a[5]} B, "
+                 f"{a[6]} CTAs/SM" + (" <- twin of v%d" % {8: 0, 9: 4, 10: 6, 11: 4}[v] if v >= 8 else ""))
+        why = _op_merge_canary((8, 4))
+        if why is not None:
+            for c in cells:
+                _say(f"PATH CHOSEN: sk ticket merge [{c}]: incumbent (merge canary failed: {why})")
+            return
+        sms = _sm_count(dev)
+        gen = torch.Generator(device="cuda").manual_seed(6060)
