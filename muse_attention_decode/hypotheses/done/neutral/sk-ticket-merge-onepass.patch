+// ONEPASS (sk-ticket-merge-onepass): the same LSE merge in ONE pass over slots s_lo..s_hi, MB slots per batch.
+// Every load of a batch (m, l, the float4 of acc; __ldcg, other CTAs wrote them) is issued before any use; a
+// slot past s_hi reads as m = -inf, l = 0, a = 0. Then an online LSE fold in registers, the -inf handling of
+// c320 ONEPASS exactly: Mn = max(M, max_u m_u), Mnu = (Mn == -inf) ? 0 : Mn, alpha = (M == -inf) ? 0 :
+// ex2(M - Mnu) rescales L and o once per batch, w_u = (m_u == -inf) ? 0 : ex2(m_u - Mnu). o and L end relative
+// to the final raw M (Mout; -inf with L = 0, o = 0 when every slot is empty), as merge_range's are, so a
+// two-level group slot stored from it keeps its meaning. Same fp32 arithmetic up to summation order.
+template <int MB>
+__device__ __forceinline__ void merge_range_onepass(const float* ws_acc, const float* ws_ml, int s_lo, int s_hi,
+                                                    int h, int d0, float4& o, float& L, float& Mout) {
+  const float NEG_INF = __int_as_float(0xff800000u);
+  float M = NEG_INF;
+  o = make_float4(0.f, 0.f, 0.f, 0.f);
+  L = 0.f;
+  for (int c0 = s_lo; c0 <= s_hi; c0 += MB) {
+    float mv[MB], lv[MB];
+    float4 av[MB];
+#pragma unroll
+    for (int u = 0; u < MB; ++u) {  // every load of the batch before any use
+      const int c = c0 + u;
+      if (c <= s_hi) {
+        const int64_t sl = c;
+        mv[u] = __ldcg(ws_ml + sl * 2 * HQ + h);
+        lv[u] = __ldcg(ws_ml + sl * 2 * HQ + HQ + h);
+        av[u] = __ldcg(reinterpret_cast<const float4*>(ws_acc + (sl * HQ + h) * D + d0));
+      } else {
+        mv[u] = NEG_INF;
+        lv[u] = 0.f;
+        av[u] = make_float4(0.f, 0.f, 0.f, 0.f);
+      }
+    }
+    float gm = mv[0];
+#pragma unroll
+    for (int u = 1; u < MB; ++u) gm = fmaxf(gm, mv[u]);
+    const float Mn = fmaxf(M, gm);
+    const float Mnu = Mn == NEG_INF ? 0.f : Mn;
+    const float alpha = M == NEG_INF ? 0.f : ex2(M - Mnu);  // L and o are 0 while M is -inf
