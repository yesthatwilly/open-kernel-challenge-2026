+def _op_cell_ps(gen, flush, sms, attrs):
+    """Sliding verify B=1 (the PSEUDO route): twin 9 against routed variant 4; MB-4 twin 11 timed in the same rounds
+    (print only); twin 9 vs 4 one grid step up (print only)."""
+    cell = "sliding verify B=1"
