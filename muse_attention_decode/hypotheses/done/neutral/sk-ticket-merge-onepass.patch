+        return False, None, f"twin 8 not routable: {why}"
+    if not _op_ok(f"{cell} checks", _OP_CHECK_BY):
+        return False, None, "skipped: deadline before the checks"
+    two = 2 * sms
+    if "r" not in _OP_FULL_CHECKED:
