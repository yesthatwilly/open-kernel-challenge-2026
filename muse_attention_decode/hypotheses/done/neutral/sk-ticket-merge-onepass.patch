+        return False, None, "not on the PSEUDO route (FA3 incumbent): not gated"
+    inc, spec = _PS_ROUTE[1]
+    if inc != 4:
+        return False, None, f"incumbent is {_SK_LABELS[inc]} (no single-level twin): not gated"
+    why = _op_spill(attrs, 9)
+    if why is not None:
+        return False, None, f"twin 9 not routable: {why}"
+    if not _op_ok(f"{cell} checks", _OP_CHECK_BY):
+        return False, None, "skipped: deadline before the checks"
+    g1 = _ps_grid(spec, 8, sms)
+    cases = [(tag, lens, kv, _ps_grid(spec, 8 * len(lens), sms) if grid is None else grid)
+             for tag, lens, kv, grid in (
+                 ("canary lens 3", [3], 1.0, 3), ("lens 3", [3], 1.0, None), ("lens 7 kv 0.25", [7], 0.25, None),
+                 ("lens 0", [0], 1.0, None), ("lens 1500", [1500], 1.0, None), ("lens 2045 kv 0.25", [2045], 0.25, None),
+                 ("lens 2047", [2047], 1.0, None), ("lens 2055", [2055], 1.0, None), ("lens 80000", [80000], 1.0, None),
+                 ("lens 80000 kv 0.25", [80000], 0.25, None), ("lens 80000 grid 7", [80000], 1.0, 7),
+                 ("lens 80000 grid 2xSM", [80000], 1.0, 2 * sms),
+                 ("B=3 lens 5/2040/80000", [5, 2040, 80000], 1.0, None),
+                 ("B=3 lens 5/2040/80000 kv 0.25 grid 7", [5, 2040, 80000], 0.25, 7))]
+    reason = _op_run_cases(f"{cell} twin 9", "ps", 9, cases, gen)
+    if reason is not None:
+        return False, None, f"twin 9 failed {reason}"
+    mb4 = _op_spill(attrs, 11) is None and _op_run_cases(f"{cell} MB-4 twin 11", "ps", 11, cases[:3] + cases[8:10],
+                                                         gen) is None
+    _PS_ROUTE[1] = (9, spec)  # the replay check captures kernel_fn with the twin routed
+    try:
+        why = _op_quiet(_ps_replay_check, 1, [80000], 1.0, gen)
+    finally:
+        _PS_ROUTE[1] = (inc, spec)
+    _rezero_tickets()
+    if why is not None:
+        return False, None, f"twin 9 two-state replay failed ({why})"
+    _say(f"[op] {cell}: twin 9 two-state replay check ok")
+    if not _op_ok(f"{cell} timing", _OP_TIME_BY):
+        return False, None, "skipped: deadline before the timing"
+    dev = torch.device("cuda")
+    data = _ps_synthetic([80000], 1.0, gen, dev)
+    ref = _ps_reference(data, [80000])
+    fns = [lambda: _ps_launch(data, *_ps_prepare_q(data), 4, g1), lambda: _ps_launch(data, *_ps_prepare_q(data), 9, g1)]
+    extra = None
+    if mb4:
+        fns.append(lambda: _ps_launch(data, *_ps_prepare_q(data), 11, g1))
+        extra = ["onepass MB 4"]
+    win, detail = _op_time_cell(f"{cell} grid {g1} ({spec})", fns, ref, flush, g1 / 8, extra)
+    up = _op_next_spec(("p4", "p8", "sm", "2sm"), spec, lambda sp: _ps_grid(sp, 8, sms))
+    if up is not None and _op_clock() <= _OP_TIME_BY:
+        g2 = _ps_grid(up, 8, sms)
+        _op_readout(f"{cell} grid {g2} ({up})",
+                    [lambda: _ps_launch(data, *_ps_prepare_q(data), 4, g2),
+                     lambda: _ps_launch(data, *_ps_prepare_q(data), 9, g2)],
+                    [f"incumbent {up}", f"twin 9 {up}"], ref, flush)
+    del data, ref, fns
+    torch.cuda.empty_cache()
+    _rezero_tickets()
+    if win and _op_clock() > _OP_ROUTE_BY:
+        return False, None, f"{detail}; discarded: timing ended past {_OP_ROUTE_BY:.0f} s"
+    return win, (9, spec), detail + f"; grid {spec}" + ("" if mb4 else "; MB-4 readout n/a")
