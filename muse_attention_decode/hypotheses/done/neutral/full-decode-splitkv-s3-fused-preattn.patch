+def _sk3_owner_check(lens, grid) -> bool:
+    """Host check of the ownership invariant stage 3 relies on: for every request, exactly one CTA
+    of the effective grid min(grid, Ttot) has the request's last tile (the one holding key
+    seq_b - 1, the new token) in its stream-K range, and tile_owner names it. lens are positions
+    (cache_seqlens = lens + 1)."""
+    tp = [0]
+    for n in lens:
+        tp.append(tp[-1] + (n + 1 + 63) // 64)
+    T = tp[-1]
+    gx = min(grid, T)
+    starts = [c * T // gx for c in range(gx + 1)]
+    for b in range(len(lens)):
+        last = tp[b + 1] - 1
+        owners = [c for c in range(gx) if starts[c] <= last < starts[c + 1]]
+        if owners != [((last + 1) * gx - 1) // T]:
+            return False
+    return True
