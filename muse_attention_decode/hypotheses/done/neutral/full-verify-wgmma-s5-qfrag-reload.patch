+// {binaryVersion, ptxVersion, numRegs, localSizeBytes, maxThreadsPerBlock, dynamic smem, CTAs/SM}
+std::vector<int64_t> sk_attrs(int64_t variant) {
+  TORCH_CHECK(variant >= 0 && variant <= 3, "sk_attrs: variant");
+  sk_prepare(variant);
+  cudaFuncAttributes a;
