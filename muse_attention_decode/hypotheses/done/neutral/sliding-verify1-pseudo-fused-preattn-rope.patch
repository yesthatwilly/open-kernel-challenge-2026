+def _sv1_setup() -> None:
+    """Build, validate, gate and replay-check the B=1 FUSED PSEUDO route; set _SV1_ROUTE (frozen) once. Any miss keeps
+    kernel_fn's [pre-attn + PSEUDO] at B=1; nothing here raises. Re-zeroes the shared tickets afterwards."""
+    global _SV1_EXT, _SV1_ROUTE
+    dev = torch.device("cuda")
+    t_all = time.perf_counter()
+    route, why, line = {}, None, ""
+    try:
+        if _EXT2 is None or not _PS_BUILT or 1 not in _PS_ROUTE:
+            why = "B=1 is not on the PSEUDO route (nothing to fold into)"
+        elif not _sv1_ok_to_start("build", _SV1_BUILD_BY):
+            why = "build deadline"
+        else:
+            _SV1_EXT = _build_sv1()
+            if _SV1_EXT is None:
+                why = "build failed"
+        if why is None:
+            v, spec = _PS_ROUTE[1]
+            two = v == 5
+            sms = _sm_count(dev)
+            if not _sv1_ok_to_start("checks", _SV1_CHECK_BY):
+                why = "check deadline"
+            else:
+                try:
+                    why = _sv1_validate(two, _ps_grid(spec, 8, sms))
+                except Exception as e:
+                    why = f"self-check raised {e!r}"
+            if why is None:
+                if not _sv1_ok_to_start("gate", _SV1_GATE_BY):
+                    why = "gate deadline"
+                else:
+                    gen = torch.Generator(device="cuda").manual_seed(4242)
+                    flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+                    win, line = _sv1_gate_b1(gen, flush, sms, two, spec)
+                    del flush
+                    torch.cuda.empty_cache()
+                    if not win:
+                        why = f"not >= {_SV1_GATE:.2f}x: {line}"
+            if why is None:
+                if not _sv1_ok_to_start("replay", _SV1_REPLAY_BY):
+                    why = "replay deadline"
+                else:
+                    route[1] = (two, spec)
+                    _SV1_ROUTE = MappingProxyType(dict(route))  # live for the replay check through kernel_fn
+                    gen = torch.Generator(device="cuda").manual_seed(4343)
+                    sets = _alt_sets([80000])
+                    mp = max(max(s) for s in sets) + 8 + 37
+                    try:
+                        why = _alt_check("[sv1] replay B=1", lambda l: _ps_synthetic(l, 1.0, gen, dev, max_pages=mp),
+                                         _ps_reference, sets, gate=_sv1_gate)
+                    except Exception as e:
+                        why = f"replay raised {e!r}"
+                    if why is not None:
+                        route.clear()
+    except Exception as e:
+        route.clear()
+        why = f"setup raised {e!r}"
+    finally:
+        _SV1_ROUTE = MappingProxyType(dict(route))  # frozen: kernel_fn only reads it
+        if not _SV1_ROUTE:
+            _SV1_EXT = None
+        try:
+            _rezero_tickets()
+        except Exception as e:
+            _say(f"[sv1] ticket re-zero raised: {e!r}")
+        _say(f"[sv1] total setup {time.perf_counter() - t_all:.1f} s (import clock "
+             f"{time.perf_counter() - _IMPORT_T0:.0f} s)")
+    if _SV1_ROUTE:
+        two, spec = _SV1_ROUTE[1]
+        _say(f"PATH CHOSEN: sliding verify B=1 [sv1 FUSED PSEUDO]: one launch {_SV1_LABELS[two]} grid {spec} ({line})")
+    else:
+        _say(f"PATH CHOSEN: sliding verify B=1 [sv1 FUSED PSEUDO]: pre-attn + PSEUDO (fallback: {why})")
+
