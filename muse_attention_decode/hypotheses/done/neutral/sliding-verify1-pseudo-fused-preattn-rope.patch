+def _sv1_gate_b1(gen, flush, sms: int, two: bool, spec: str):
+    """B=1 x 80000: kernel_fn's routed [pre-attn + PSEUDO] against [FUSED] at the routed variant and grid spec (and,
+    printed only, FUSED at every grid spec p4 / p8 / SM), eager correctness first, then interleaved cold-L2 graph
+    replays with the empty graph subtracted. Returns (route?, the line with both numbers)."""
+    dev = torch.device("cuda")
+    lens = [80000]
+    data = _ps_synthetic(lens, 1.0, gen, dev)
+    cfg = data["config"]
+    if not _ps_gate(cfg) or _sv1_gate(cfg):
+        return False, "kernel_fn's B=1 path is not [pre-attn + PSEUDO] at the gate shape"
+    v = 5 if two else 4
+    inc = f"[pre-attn + PSEUDO {_SK_LABELS[v]} grid {spec}]"
+    _say(f"[sv1-gate] B=1: launching kernel_fn incumbent {inc} (eager correctness run)")
+    out = kernel_fn(data)
+    torch.cuda.synchronize()
+    err, fin = _rel_l2(out, _ps_reference(data, lens))
+    _say(f"[sv1-gate] B=1: incumbent returned, rel L2 {err:.2e}, finite {fin}")
+    if not (fin and err < 2e-2):
+        return False, "incumbent failed its correctness check"
+    fns, names = [lambda: kernel_fn(data)], [inc]
+    for sp in ["p4", "p8", "sm"] + ([spec] if spec not in ("p4", "p8", "sm") else []):
+        g = _ps_grid(sp, 8, sms)
+        name = f"[FUSED {_SV1_LABELS[two]} grid {g} ({sp})]"
+        _say(f"[sv1-gate] B=1: launching {name} (eager correctness run)")
+        out = _sv1_launch(data, g, two)
+        torch.cuda.synchronize()
+        err, fin = _rel_l2(out, _ps_reference(data, lens))
+        _say(f"[sv1-gate] B=1: {name} returned, rel L2 {err:.2e}, finite {fin}")
+        if not (fin and err < 2e-2):
+            if sp == spec:
+                return False, f"FUSED grid {spec} failed its correctness check"
+            continue
+        fns.append(lambda g=g: _sv1_launch(data, g, two))
+        names.append(name)
+        if sp == spec:
+            routed = len(fns) - 1
+    _say(f"[sv1-gate] B=1: timing {len(fns)} paths interleaved (graph replays, cold L2, empty graph subtracted)")
+    ts = _interleaved_us(fns, flush)
+    for name, t in zip(names, ts):
+        _say(f"[sv1-gate] B=1 x 80000: {name}: {t:7.1f} us")
+    t_inc, t_f = ts[0], ts[routed]
+    ratio = t_inc / t_f if t_f > 0 else 0.0
+    win = ratio >= _SV1_GATE
+    line = (f"{inc} {t_inc:.1f} us vs [FUSED grid {spec}] {t_f:.1f} us -> {ratio:.3f}x "
+            f"({'>=' if win else '<'} {_SV1_GATE:.2f}x)")
+    _say(f"[sv1-gate] B=1 x 80000: {line} -> {'ROUTE' if win else 'below the gate: pre-attn + PSEUDO'}")
+    del data, out
+    torch.cuda.empty_cache()
+    return win, line
+
