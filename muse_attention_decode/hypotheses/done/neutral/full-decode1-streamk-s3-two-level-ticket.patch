+                                 (0, sms, "(b) single-level grid SM"),
+                                 (3, sms, "(c) two-level grid SM (timed path)"),
+                                 (3, 2 * sms, "(d) two-level grid 2xSM"))),
+                            (16, ((3, 2 * sms, "two-level grid 2xSM at B=16 (diagnostic)"),
+                                  (0, 2 * sms, "single-level grid 2xSM at B=16 (stage 2)")))):
