+        if batch == 1:
+            fastest = min(range(len(times)), key=times.__getitem__)
+            _say(f"[sk3-diag] fastest of the four: {labels[fastest]}; timed path (c) is {times[2]:.1f} us, "
+                 f"(a) control {times[0]:.1f} us, (c)/(a) {times[2] / times[0]:.3f}x")
+            if fastest != 2:
