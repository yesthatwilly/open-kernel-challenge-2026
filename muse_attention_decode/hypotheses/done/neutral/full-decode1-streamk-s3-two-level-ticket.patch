+            ga = torch.empty((ng, 16, 64), dtype=torch.float32, device=dev)
+            gm = torch.empty((ng, 2, 16), dtype=torch.float32, device=dev)
+            out = torch.empty((batch, 1, 1024), dtype=torch.bfloat16, device=dev)
