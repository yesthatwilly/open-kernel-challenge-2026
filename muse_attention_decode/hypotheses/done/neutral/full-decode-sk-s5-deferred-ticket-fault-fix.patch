+        ("B=16 ragged grid SM", _SK_LENS16, 1.0, sms),
+        ("B=32 ragged grid 3", lens32, 1.0, 3),
+        ("B=32 ragged kv 0.25 grid device", lens32, 0.25, None),
+        ("B=32 ragged grid SM", lens32, 1.0, sms),
+        ("B=24 80000 keys grid device", [80000] * 24, 1.0, None),
+    )
+    for tag, lens, kv_scale, grid in cases:
+        if not _s5_case(tag, lens, kv_scale, grid, gen):
+            return f"self-check {tag}"
+    left = int(_sk_ticket(dev).abs().sum().item())
+    _say(f"[sk5] tickets (and error word) after the DEFER self-check: sum {left}")
+    if left:
+        return "tickets not reset / error word set (DEFER)"
+    for mult in (2, 1):
+        reason = _s5_two_state_replay(gen, _SK_LENS16, 0.25, f"B=16 grid {mult}xSM", mult * sms)
+        if reason is not None:
+            return reason
+    left = int(_sk_ticket(dev).abs().sum().item())
+    _say(f"[sk5] tickets (and error word) after the two-state replays: sum {left}")
+    return "tickets not reset (DEFER replays)" if left else None
+
+
+def _s5_pct(t, p):
+    t = sorted(t)
+    return t[min(len(t) - 1, int(p * len(t)))]
+
+
+def _s5_time_rounds(graphs, base_graph, flush, rounds=2, warm=3, reps=20):
+    """Interleaved cold-L2 graph-replay timings: per round, every cell's graph replays once per rep in a
+    rotating order (reversed rotation on round 1), the 256 MB flush before every replay, the empty
+    graph's median subtracted. Returns per round [(median, q1, q3) us per cell]."""
+    n = len(graphs)
+    res = []
+    for r in range(rounds):
+        per = [[] for _ in range(n)]
+        base = []
+        for it in range(warm + reps):
+            order = [((n - 1 - i) + it) % n if r % 2 else (i + it) % n for i in range(n)]
+            for i in order + [-1]:
+                flush.zero_()
+                e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                e0.record()
+                (base_graph if i < 0 else graphs[i]).replay()
+                e1.record()
+                torch.cuda.synchronize()
+                if it >= warm:
+                    (base if i < 0 else per[i]).append(e0.elapsed_time(e1) * 1e3)
+        b0 = _s5_pct(base, 0.5)
+        res.append([(max(_s5_pct(t, 0.5) - b0, 1e-3), _s5_pct(t, 0.25), _s5_pct(t, 0.75)) for t in per])
+    return res
+
+
+def _s5_band(batch, flush, base_graph, gen, route: bool) -> None:
+    """One matrix band at B x 80000: canaries (lengths 1..130, same B and grid) per cell, then two
+    interleaved rounds of master variant 0 (the routed grid) / variant 0 at SM / DEFER at 2xSM / DEFER at
+    SM. route=True (B=16 only) routes DEFER when a cell beats master in BOTH rounds by >= 1.03x with its
+    IQR <= 1.5x master's; route=False prints the numbers and never routes."""
+    dev = torch.device("cuda")
+    sms = _sm_count(dev)
+    if _s5_elapsed() > _S5_BAND_DEADLINE_S:
+        _s5_note(f"PATH CHOSEN: full decode_{batch} master <4,ticket> (DEFER matrix skipped: deadline, import clock "
+                 f"{_s5_elapsed():.0f} s)")
+        return
+    mg = _SPLITKV_GRID or 2 * sms  # master's actually routed grid (flag-off path)
+    cells = ((0, mg, f"master v0 {mg}"), (0, sms, f"v0 SM {sms}"), (8, 2 * sms, f"DEFER 2xSM {2 * sms}"),
+             (8, sms, f"DEFER SM {sms}"))
+    canary_lens = [1 + (i * 129) // max(batch - 1, 1) for i in range(batch)]
+    for v, grid, label in cells:  # a canary per cell before its 80K timing
+        if v == 8:
+            if not _s5_case(f"canary B={batch} lens 1..130 grid {grid}", canary_lens, 1.0, grid, gen):
+                _s5_note(f"PATH CHOSEN: full decode_{batch} master <4,ticket> (DEFER canary failed: {label})")
+                return
+        elif not _sk_case(f"s5 canary B={batch} lens 1..130 grid {grid} (v0)", canary_lens, 1.0, grid, gen):
+            _s5_note(f"PATH CHOSEN: full decode_{batch} master <4,ticket> (master canary failed: {label})")
+            return
+    lens = [80000] * batch
+    data = _splitkv_synthetic(lens, 1.0, gen, dev)
+    _say(f"[sk5] B={batch}: launching _pre_attention_kernel")
+    q, qkv = _sk_prepare_q(data)
+    torch.cuda.synchronize()
+    cfg = data["config"]
+    scale = cfg["sm_scale"] * cfg["qk_scale_factor"] * LOG2E
+    kc, vc, pt = data["k_cache"], data["v_cache"], data["page_table"]
+    seql, ksc, vsc = data["cache_seqlens"], data["k_scale"], data["v_scale"]
+    nbytes = sum(n + 1 for n in lens) * 256
+    tk, gtk = _sk_ticket(dev), _sk_gticket(dev)
+    ga = torch.empty((1, 16, 64), dtype=torch.float32, device=dev)
+    gm = torch.empty((1, 2, 16), dtype=torch.float32, device=dev)
+    tiny = torch.zeros(1, dtype=torch.float32, device=dev)
+    graphs, outs, keep = [], [], []
+    for v, grid, label in cells:  # workspaces per cell from that cell's grid and B
+        wa = torch.empty((grid + batch, 16, 64), dtype=torch.float32, device=dev)
+        wm = torch.empty((grid + batch, 2, 16), dtype=torch.float32, device=dev)
+        out = torch.empty((batch, 1, 1024), dtype=torch.bfloat16, device=dev)
+        keep.append((wa, wm))
+
+        def launch(v=v, grid=grid, wa=wa, wm=wm, out=out):
+            _EXT2.sk_attn(q, kc, vc, pt, seql, ksc, vsc, qkv, qkv.stride(0), out, wa, wm, tk, gtk, ga, gm,
+                          scale, RMS_EPS, grid, v)
+
+        if v == 8:
+            _s5_assert_defer(wa, wm, tk, grid, batch)
+        _say(f"[sk5] launching v{v} B={batch} grid={grid} ({label}, eager, 80000 keys)")
+        launch()
+        torch.cuda.synchronize()
+        _say(f"[sk5] v{v} B={batch} grid={grid} returned (error word {_s5_err_word(dev)})")
+        graph = torch.cuda.CUDAGraph()
+        _say(f"[sk5] capturing v{v} B={batch} grid={grid}")
+        with torch.cuda.graph(graph):
+            launch()
+        torch.cuda.synchronize()
+        graphs.append(graph)
+        outs.append(out)
+    base_graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(base_graph):
+        tiny.add_(1.0)
+    ref = outs[0].float()
+    rels = [float((o.float() - ref).norm() / ref.norm()) for o in outs]
+    if _s5_err_word(dev) or any(r > 2e-2 or r != r for r in rels):
+        _s5_note(f"PATH CHOSEN: full decode_{batch} master <4,ticket> (80000-key outputs differ from master "
+                 f"{['%.1e' % r for r in rels]} or error word set)")
+        del data, q, qkv, kc, vc, pt, graphs, outs, keep
+        torch.cuda.empty_cache()
+        return
+    rounds = _s5_time_rounds(graphs, base_graph, flush)
+    _say(f"[sk5] B={batch} x 80000: {nbytes / 1e6:.0f} MB of K+V rows, graph replay, cold L2, interleaved, 2 rounds, "
+         f"empty-graph baseline subtracted, median / IQR of 20 (kernels: splitkv_attn_sk_kernel{_SK_LABELS[0]} vs "
+         f"splitkv_attn_sk_kernel{_SK_LABELS[8]})")
+    for ri, rd in enumerate(rounds):
+        for (v, grid, label), (t, q1, q3), rel in zip(cells, rd, rels):
+            _say(f"[sk5]   round {ri + 1} {label:22s} {t:7.1f} us  IQR {q3 - q1:5.1f} us  "
+                 f"{nbytes / (t * 1e-6) / 1e12:.2f} TB/s  (rel vs master {rel:.1e})")
+    best = None
+    for ci in (2, 3):
+        gains = [rd[0][0] / rd[ci][0] for rd in rounds]
+        iqr_ok = all((rd[ci][2] - rd[ci][1]) <= 1.5 * max(rd[0][2] - rd[0][1], 0.5) for rd in rounds)  # 0.5 us floor on master's IQR
+        _say(f"[sk5] B={batch} {cells[ci][2]}: gain over master v0 round 1 {gains[0]:.3f}x, round 2 {gains[1]:.3f}x, "
+             f"IQR within 1.5x of master (floor 0.5 us): {iqr_ok}")
+        if min(gains) >= 1.03 and iqr_ok and (best is None or min(gains) > best[1]):
+            best = (ci, min(gains))
+    if not route:
+        _s5_note(f"GATE: full decode_{batch} DEFER numbers printed only, never routed (round gains "
+                 f"{rounds[0][0][0] / rounds[0][2][0]:.3f}x/{rounds[1][0][0] / rounds[1][2][0]:.3f}x at 2xSM, "
+                 f"{rounds[0][0][0] / rounds[0][3][0]:.3f}x/{rounds[1][0][0] / rounds[1][3][0]:.3f}x at SM)")
+        _s5_note(f"PATH CHOSEN: full decode_{batch} master <4,ticket> {mg} (DEFER not routable at this band)")
+    elif best is None:
+        _s5_note(f"PATH CHOSEN: full decode_{batch} master <4,ticket> {mg} (DEFER best round gains "
+                 f"{max(min(rd[0][0] / rd[ci][0] for rd in rounds) for ci in (2, 3)):.3f}x < 1.03x in both rounds "
+                 f"or IQR too wide; master {rounds[0][0][0]:.1f}/{rounds[1][0][0]:.1f} us)")
+    elif _fused_gate(cfg):
+        _s5_note(f"PATH CHOSEN: full decode_{batch} fused pre-attention [skF] (DEFER {cells[best[0]][2]} passed "
+                 f"{best[1]:.3f}x but skF owns this band: DEFER not routed)")
+    else:
+        _SK_ROUTE[batch] = (8, cells[best[0]][1] // sms)
+        t_m = [rd[0][0] for rd in rounds]
+        t_d = [rd[best[0]][0] for rd in rounds]
+        _s5_note(f"PATH CHOSEN: full decode_{batch} streamk DEFER {cells[best[0]][2]} ({t_d[0]:.1f}/{t_d[1]:.1f} us vs "
+                 f"master v0 {t_m[0]:.1f}/{t_m[1]:.1f} us, both rounds >= {best[1]:.3f}x >= 1.03x)")
+    del data, q, qkv, kc, vc, pt, graphs, outs, keep
+    torch.cuda.empty_cache()
+
+
+def _s5_probe_b64() -> None:
+    """One eager variant-0 launch at B=64 x 80000 (never run before for any sk variant), synced and
+    printed, after the matrix: was the s4 fault specific to B=64 at 80K on master's own code?"""
+    dev = torch.device("cuda")
+    if _s5_elapsed() > _S5_BAND_DEADLINE_S:
+        _s5_note("GATE: B=64 x 80000 variant-0 probe skipped: deadline")
+        return
+    gen = torch.Generator(device="cuda").manual_seed(64064)
+    data = _splitkv_synthetic([80000] * 64, 1.0, gen, dev)
+    _say("[sk5] B=64: launching _pre_attention_kernel")
+    q, qkv = _sk_prepare_q(data)
+    torch.cuda.synchronize()
+    g = _SPLITKV_GRID or 2 * _sm_count(dev)
+    _say(f"[sk5] launching v0 B=64 grid={g} (eager, 80000 keys, master code, probe)")
+    out, _, _ = _sk_launch(data, q, qkv, 0, g)
+    torch.cuda.synchronize()
+    finite = bool(torch.isfinite(out.float()).all())
+    _say(f"[sk5] v0 B=64 grid={g} returned: finite {finite}, tickets sum {int(_sk_ticket(dev).abs().sum().item())}")
+    _s5_note(f"GATE: master variant 0 at B=64 x 80000 eager launch returned, finite {finite}")
+    del data, q, qkv, out
+    torch.cuda.empty_cache()
+
+
+def _s5_phase() -> None:
+    """Stage 5, last prepare phase: DEFER validation, then the B=16 (routable) and B=32 (numbers only)
+    matrices, then the B=64 variant-0 probe."""
+    dev = torch.device("cuda")
+    if _s5_elapsed() > _S5_START_DEADLINE_S:
+        _s5_note(f"PATH CHOSEN: full decode 1<B<=64 master <4,ticket> (DEFER phase skipped: deadline, import clock "
+                 f"{_s5_elapsed():.0f} s)")
+        return
+    t_start = time.perf_counter()
+    try:
+        reason = _s5_validate()
+    except Exception as e:
+        reason = f"DEFER validation raised {e!r}"
+    try:
+        _rezero_tickets()  # also clears the error word
+    except Exception as e:
+        reason = f"ticket re-zero raised {e!r}"
+    if reason is not None:
+        _s5_note(f"PATH CHOSEN: full decode 1<B<=64 master <4,ticket> (DEFER not routed: {reason})")
+    else:
+        gen = torch.Generator(device="cuda").manual_seed(31337)
+        flush = torch.empty(64 << 20, dtype=torch.float32, device=dev)  # 256 MB > L2
+        try:
+            for batch, route in ((16, True), (32, False)):
+                _s5_band(batch, flush, None, gen, route)
+        except Exception as e:
+            _s5_note(f"PATH CHOSEN: full decode DEFER matrix raised {e!r}: bands printed above keep their route, "
+                     f"the rest stay on master variant 0")
+        finally:
+            del flush
+            try:
+                _rezero_tickets()
+            except Exception as e:
+                _say(f"[sk5] ticket re-zero raised: {e!r}")
+    _s5_probe_b64()
+    _say(f"[sk5] DEFER phase took {time.perf_counter() - t_start:.1f} s (import clock {_s5_elapsed():.0f} s)")
+
+
+def _s5_elapsed() -> float:
+    return time.perf_counter() - _S5_T0
+
