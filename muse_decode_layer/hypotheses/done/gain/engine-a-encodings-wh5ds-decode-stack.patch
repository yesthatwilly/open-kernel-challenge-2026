+
+def _eae_canary(state, device, gens, T, base, a):
+    ea = state["ea"]
+    for n in EAE_CANARY.get(T, ()):
+        _eae_zero(ea)
+        ex = {a: True}
+        _eae_exact(state, "cold", T, base, _eae_draw(state, device, gens, T, "cold", n), [a], ex)
+        torch.cuda.synchronize()
+        if not ex[a] or _eae_sums(ea):
