+          a[0] = mul_bf16x2_h<0>(ext_a4b<0>(qg[wd]), sg);
+          a[2] = mul_bf16x2_h<0>(ext_a4b<1>(qg[wd]), sg);
+          a[1] = mul_bf16x2_h<1>(ext_a4b<0>(qu[wd]), sg);
