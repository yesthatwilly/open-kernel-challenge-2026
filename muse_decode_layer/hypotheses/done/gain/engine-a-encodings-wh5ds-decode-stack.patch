+    ce = hc.get("cold_e") or {}
+    return [f"{HC_TAG} PATH " + " | ".join(
+        f"T={c} H{(hc.get('on') or {}).get(c, 0)} cold {(hc.get('cold_x') or {}).get(c) or hc.get('cold', '-')}"
+        + (f"+{_eae_lab(str(ce[c]))}" if ce.get(c) else "") + f" hot {'wh5ds' if wk.get(c) else 'master wg'}"
