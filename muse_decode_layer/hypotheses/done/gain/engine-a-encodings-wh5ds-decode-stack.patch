+        ldsm_x4(xb + static_cast<uint32_t>((kq * 8 + 2 * p) * 32), bk[2 * p][0], bk[2 * p][1], bk[2 * p + 1][0],
+                bk[2 * p + 1][1]);
+    }
+    const uint32_t qg[4] = {c0.x, c0.y, c0.z, c0.w};
+    const uint32_t qu[4] = {c1.x, c1.y, c1.z, c1.w};
