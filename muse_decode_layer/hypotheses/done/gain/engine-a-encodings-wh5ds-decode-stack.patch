+        } else {
+          a[0] = mul_bf16x2_h<0>(ext_a4b<2>(qg[wd]), sg);
+          a[2] = mul_bf16x2_h<0>(ext_a4b<3>(qg[wd]), sg);
+          a[1] = mul_bf16x2_h<1>(ext_a4b<2>(qu[wd]), sg);
+          a[3] = mul_bf16x2_h<1>(ext_a4b<3>(qu[wd]), sg);
