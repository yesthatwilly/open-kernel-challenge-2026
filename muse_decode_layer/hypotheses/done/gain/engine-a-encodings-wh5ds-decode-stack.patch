+        uint32_t sg;
+        if constexpr (DQ == 4) {
+          const uint32_t w = (j & 1) ? __byte_perm(sw[j >> 1], sw[j >> 1], 0x2103u) : sw[j >> 1];
+          asm("lop3.b32 %0, %1, %2, %3, 0xEA;\n" : "=r"(sg) : "r"(w), "n"(0x07F007F0), "r"(m78));
+        } else {
+          sg = scale_pair_imad_rt(j < 4 ? sw[0] : sw[1], j < 4 ? sw[2] : sw[3], j & 3, m16);
+        }
+        uint32_t a[4];
