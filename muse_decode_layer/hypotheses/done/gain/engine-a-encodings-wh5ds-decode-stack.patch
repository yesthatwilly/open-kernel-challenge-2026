+def _eae_off(state):
+    ea, hc = state.get("ea") or {}, state.get("hc") or {}
+    for t, v in list((ea.get("on") or {}).items()):
+        if isinstance(v, str) and ":e" in v:
+            ea["on"][t] = v.split(":e")[0]
