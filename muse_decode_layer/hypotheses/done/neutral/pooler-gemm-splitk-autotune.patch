+# Pooler GEMM forms prepare() chooses between per tuned T. 0 is SGLang's bf16_gemm_dispatch; the
+# others are (splits, weight layout) for a split-K as torch.bmm with fp32 partials: "nn" reads
+# [S, K/S, N] chunks of pooler.T (one buffer serves every S), "tn" reads [S, N, K/S] chunks through
+# a transpose (the TN operand cuBLAS gets today). F.linear is not a candidate: on H200 it resolves to
+# the same cuBLAS kernel as bf16_gemm_dispatch.
+POOLER_FORMS = {0: None, 1: (2, "nn"), 2: (4, "nn"), 3: (2, "tn"), 4: (4, "tn")}
+POOLER_FORM_NAMES = {0: "dispatch", 1: "bmm2_nn", 2: "bmm4_nn", 3: "bmm2_tn", 4: "bmm4_tn"}
+POOLER_TUNE_TOKENS = (1, 8, 16, 32, 128, 256)
+POOLER_TUNE_WARMUP = 5
+POOLER_TUNE_REPLAYS = 50
+# A split-K form replaces SGLang's GEMM only when its median beats it by 3% or by 0.5 us.
+POOLER_MIN_GAIN_FRAC = 0.03
+POOLER_MIN_GAIN_US = 0.5
+L2_FLUSH_BYTES = 256 << 20
 
 
 def _gemm(x, w):
     return _bf16_gemm_dispatch_impl(x, w, None)
 
 
+def _pooler_split(x, w_chunks, splits):
+    """x @ pooler.T as a split-K: fp32 partials over K-chunks, summed in fp32, rounded to bf16 once."""
+    tokens, k = x.shape
+    chunks = x.view(tokens, splits, k // splits).transpose(0, 1)
+    return torch.bmm(chunks, w_chunks, out_dtype=torch.float32).sum(0).to(torch.bfloat16)
+
+
+def _pooler(x, state, tokens):
+    form = state["pooler_form"].get(tokens, 0)
+    if form == 0:
+        return _gemm(x, state["dense"]["pooler"])
+    return _pooler_split(x, state["pooler_chunks"][form], POOLER_FORMS[form][0])
+
+
+def _pooler_chunks(w, form, w_t):
+    """The bf16 pooler weight [N, K] relaid (losslessly) as the bmm operand [S, K/S, N]."""
+    splits, layout = POOLER_FORMS[form]
+    n, k = w.shape
+    if layout == "nn":
+        return w_t.view(splits, k // splits, n)
+    return w.view(n, splits, k // splits).permute(1, 0, 2).contiguous().transpose(1, 2)
+
+
+def _bmm_fp32_out_ok(device):
+    """Whether torch.bmm takes out_dtype=float32 on bf16 inputs (and strided x chunks) here."""
+    try:
+        gen = torch.Generator(device=device).manual_seed(0)
+        a = torch.randn(8, 64, device=device, dtype=torch.bfloat16, generator=gen)
+        b = torch.randn(2, 32, 16, device=device, dtype=torch.bfloat16, generator=gen)
+        chunks = a.view(8, 2, 32).transpose(0, 1)
+        out = torch.bmm(chunks, b, out_dtype=torch.float32)
+        ref = torch.bmm(chunks.float(), b.float())
+        return out.dtype == torch.float32 and bool(torch.allclose(out, ref, rtol=1e-3, atol=1e-3))
+    except (TypeError, RuntimeError, NotImplementedError):
+        return False
+
+
+def _tune_pooler(w, device):
+    """Per tuned T, the fastest pooler form under CUDA graph replay with a cold L2.
+
+    Runs on synthetic inputs only. Returns ({T: form}, {form: weight chunks}) holding only the
+    chunk copies the table uses; every graph, flush buffer and synthetic tensor is freed here."""
+    forms = [0]
+    if _bmm_fp32_out_ok(device):
+        forms += [f for f in POOLER_FORMS if f]
+    else:
+        print("pooler autotune: torch.bmm(out_dtype=float32) unsupported; split-K candidates dropped")
+    if len(forms) == 1:
+        return {}, {}
+    n, k = w.shape
+    w_t = w.t().contiguous()
+    chunks = {f: _pooler_chunks(w, f, w_t) for f in forms if f}
+
+    def run(form, x):
+        return _gemm(x, w) if form == 0 else _pooler_split(x, chunks[form], POOLER_FORMS[form][0])
+
+    saved = torch.cuda.current_stream(device)
+    gen = torch.Generator(device=device).manual_seed(0)
+    flush = torch.empty(L2_FLUSH_BYTES, dtype=torch.uint8, device=device)
+    table = {}
+    try:
+        for tokens in POOLER_TUNE_TOKENS:
+            x = torch.randn(tokens, k, device=device, dtype=torch.bfloat16, generator=gen)
+            ref = run(0, x).float()
+            graphs = {}
+            for form in forms:
+                if form and (run(form, x).float() - ref).norm() > 1e-2 * ref.norm():
+                    print(f"pooler autotune T={tokens}: {POOLER_FORM_NAMES[form]} disagrees with dispatch; dropped")
+                    continue
+                warm = torch.cuda.Stream(device)
+                warm.wait_stream(saved)
+                with torch.cuda.stream(warm):
+                    for _ in range(3):
+                        run(form, x)
+                saved.wait_stream(warm)
+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph):
+                    run(form, x)
+                graphs[form] = graph
+            times = {f: [] for f in graphs}
+            for rep in range(POOLER_TUNE_WARMUP + POOLER_TUNE_REPLAYS):
+                for form, graph in graphs.items():
+                    flush.zero_()
+                    start = torch.cuda.Event(enable_timing=True)
+                    end = torch.cuda.Event(enable_timing=True)
+                    start.record()
+                    graph.replay()
+                    end.record()
+                    if rep >= POOLER_TUNE_WARMUP:
+                        times[form].append((start, end))
+            torch.cuda.synchronize(device)
+            med = {f: statistics.median(s.elapsed_time(e) * 1000.0 for s, e in ev) for f, ev in times.items()}
+            base = med[0]
+            best = min((f for f in med if f), key=med.get, default=0)
+            gain = base - med[best] if best else 0.0
+            win = best if best and (gain >= POOLER_MIN_GAIN_FRAC * base or gain >= POOLER_MIN_GAIN_US) else 0
+            table[tokens] = win
+            cands = " ".join(f"{POOLER_FORM_NAMES[f]}={us:.2f}" for f, us in med.items())
+            print(f"pooler autotune T={tokens}: {cands} us -> {POOLER_FORM_NAMES[win]} "
+                  f"(dispatch median {base:.2f} us, pick median {med[win]:.2f} us)")
+            del graphs, times, x, ref
+    finally:
+        torch.cuda.synchronize(device)
+        torch.cuda.set_stream(saved)
+    kept = {f: chunks[f] for f in set(table.values()) if f}
+    del chunks, w_t, flush
+    torch.cuda.empty_cache()
+    print("pooler autotune table: " + ", ".join(f"T={t}:{POOLER_FORM_NAMES[f]}" for t, f in table.items()))
+    return table, kept
+
