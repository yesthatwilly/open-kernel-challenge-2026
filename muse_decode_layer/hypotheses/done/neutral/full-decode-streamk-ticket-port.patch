+def _sk_prepare(device):
+    """Once per process from prepare(), after _splitkv_prepare, outside graph capture: zero the
+    tickets, run the canary + self-check + graph replays, zero the tickets again, then pick the
+    path per batch class. Any failure keeps kernels A + B (never raises)."""
+    global _SK_OK
+    reason = None
+    try:
+        if _SK is None:
+            reason = "build failed"
+        elif _EXT is None:
+            reason = "incumbent split-KV path is off"
+        else:
+            _sk_ws(device)
+            _sk_dummies(device)
+            _sk_ticket(device).zero_()
+            torch.cuda.synchronize()
+            reason = _sk_validate(device)
+            left = int(_sk_ticket(device).abs().sum().item())
+            _say(f"[sk] tickets after the self-check: sum {left}")
+            _sk_ticket(device).zero_()
+            torch.cuda.synchronize()
+            if reason is None and left:
+                reason = "tickets not reset"
+    except Exception as e:
+        reason = f"self-check raised {e!r}"
+    if reason is not None:
+        _SK_OK = False
+        for b in (16, 32):
+            _say(f"PATH CHOSEN: full decode attention batch {b}: splitkv A+B incumbent (fallback: {reason})")
+        return
+    _SK_OK = True
+    try:
+        for b in (16, 32):
+            _SK_CHOICE[b] = _sk_select(b, device)
+            left = int(_sk_ticket(device).abs().sum().item())
+            _sk_ticket(device).zero_()
+            torch.cuda.synchronize()
+            if left:
+                _say(f"[sk] selector B={b}: tickets left dirty (sum {left}), stream-K disabled")
+                _SK_CHOICE[b] = False
+                _SK_OK = False
+                break
+    except Exception as e:
+        _say(f"PATH CHOSEN: full decode attention: splitkv A+B incumbent (fallback: selector raised {e!r})")
+        _SK_OK = False
+        _SK_CHOICE.clear()
+    finally:
+        try:
+            _sk_ticket(device).zero_()
+            torch.cuda.synchronize()
+            torch.cuda.empty_cache()
+        except Exception as e:
+            _say(f"[sk] final ticket zero raised: {e!r}")
+    _say(f"[sk] ON={_SK_OK} choice {dict(_SK_CHOICE)}: batch <= 23 follows 16, batch >= 24 follows 32 "
+         f"(gated range 1 < batch <= 64)")
+
+
+if torch.cuda.is_available():
+    _SK = _build_sk()  # at import, never during graph capture; None keeps kernels A + B
+    try:
+        _sk_ticket(torch.device("cuda", torch.cuda.current_device()))  # zeroed once, here
+    except Exception as e:
+        _say(f"[sk] ticket allocation raised: {e!r}")
+        _SK = None
+
