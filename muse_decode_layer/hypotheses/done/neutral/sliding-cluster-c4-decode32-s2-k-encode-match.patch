+def _slide_probe_nan_thr(device):
+    """Measure torch's own E4M3 overflow edge on the exact op master uses (bf16 tensor .to(float8_e4m3fn)).
+    The review expects NaN (0x7F | sign) only from |x| >= 480; a plain reading of c10's round-to-nearest-even
+    puts the edge just above 464 (the tie, which rounds to the even 0x7E). bf16 values here are 2 apart, so
+    the probe tells which. Returns the smallest |x| that maps to the NaN code, or None if torch's behaviour is
+    not 'RNE below an edge, NaN code at and above it' (then the path stays off)."""
+    mags = torch.arange(400.0, 520.0, 2.0)
+    x = torch.cat([mags, -mags, torch.tensor([float("inf"), float("-inf"), float("nan")])]).to(device).to(torch.bfloat16)
+    b = x.to(FP8).view(torch.uint8).cpu().tolist()
+    xs = x.float().cpu().tolist()
+    nan_mags = sorted({abs(v) for v, c in zip(xs, b) if v == v and abs(v) != float("inf") and (c & 0x7F) == 0x7F})
+    if not nan_mags:
+        print(f"{SLIDE_TAG} probe: torch's cast never produced a NaN code below 520", flush=True)
+        return None
+    edge = nan_mags[0]
+    bad = []
+    for v, c in zip(xs, b):
+        if v != v or abs(v) == float("inf"):
+            want = 0x7F | (0x80 if (v < 0) else 0)
+        elif abs(v) >= edge:
+            want = 0x7F | (0x80 if v < 0 else 0)
+        elif 448.0 <= abs(v):
+            want = 0x7E | (0x80 if v < 0 else 0)
+        else:
+            continue
+        if c != want:
+            bad.append((v, c, want))
+    at = {v: c for v, c in zip(xs, b) if v in (448.0, 450.0, 464.0, 466.0, 478.0, 480.0, 482.0)}
+    print(f"{SLIDE_TAG} probe: torch float8_e4m3fn cast NaN edge: first NaN |x| = {edge:g}; bytes at "
+          + ", ".join(f"{v:g}->0x{c:02X}" for v, c in sorted(at.items())) + f"; inconsistent {len(bad)}", flush=True)
+    return float(edge) if not bad else None
+
