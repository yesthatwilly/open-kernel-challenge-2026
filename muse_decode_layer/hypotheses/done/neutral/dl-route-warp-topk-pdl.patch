+      if (lane >= o) incl += up;
+    }
+    s_count[lane] = run;
+    s_seg0[lane] = incl - padded;
+    s_seg1[lane] = incl;
+    if (lane == 31) s_total = incl;
+  }
+  __syncthreads();
+  const int total = s_total;
+  if (lid >= 0) sorted_ids[s_seg0[lid] + s_off[warp][lid] + rank] = tid;
+  for (int idx = tid; idx < cap; idx += 256) {  // padding slots (disjoint from the real ones)
