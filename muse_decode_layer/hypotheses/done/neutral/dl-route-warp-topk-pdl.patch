+      const unsigned long long k = warp_max_u64(a0 > a1 ? a0 : a1);
+      if (c0 == k) t0 = true;
+      if (c1 == k) t1 = true;
+      if (lane == 0) s_sel[r] = k;
+    }
+  }
+  __syncthreads();
+  if (tid < 8) {
+    float sum = 0.f;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) sum += s_score[255 - static_cast<int>(s_sel[j] & 0xffffffffull)];
+    const int ex = 255 - static_cast<int>(s_sel[tid] & 0xffffffffull);
