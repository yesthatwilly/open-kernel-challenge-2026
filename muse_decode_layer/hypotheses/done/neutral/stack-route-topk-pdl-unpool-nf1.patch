+def _build_boundary_unpool():
+    """Compile the boundary/unpooler TU once per process, at import. Any failure leaves the landed
+    dense chain (and master) as the path."""
+    t0 = time.perf_counter()
+    flags = ["-O3", "-arch=sm_90a", "-lineinfo"]
