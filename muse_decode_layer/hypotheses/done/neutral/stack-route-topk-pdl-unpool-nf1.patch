+        v[h * 8 + 2 * q] = f2.x;
+        v[h * 8 + 2 * q + 1] = f2.y;
+      }
+    }
+    float ss = 0.f;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) ss += v[i] * v[i];
+#pragma unroll
