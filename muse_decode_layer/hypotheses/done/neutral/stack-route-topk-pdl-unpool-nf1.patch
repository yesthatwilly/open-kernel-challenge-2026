+            cpp_sources=_DLB_CPP,
+            cuda_sources=_DLB_CUDA,
+            functions=["dl_boundary", "dl_unpool"],
+            extra_cuda_cflags=flags,
+            verbose=False,
+        )
+    except Exception as e:
+        dt = time.perf_counter() - t0
+        print(f"{DLB_TAG} load_inline FAILED after {dt:.1f}s, flags {flags}, boundary/unpool path OFF: {e!r}", flush=True)
+        return None, dt
+    dt = time.perf_counter() - t0
