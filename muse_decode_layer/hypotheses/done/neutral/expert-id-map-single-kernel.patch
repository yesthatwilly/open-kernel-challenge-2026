+# One fixed block for the expert-id map: every T up to 256 is a single program, larger T a grid.
+LOCAL_ID_BLOCK = 2048
+
+
+@triton.jit(do_not_specialize=["n"])
+def _local_expert_ids_kernel(topk_ids_ptr, local_start_ptr, out_ptr, n, BLOCK: tl.constexpr):
+    """out = (id - local_start) mod 256 where that is < 32, else -1: SGLang's expert_map[id] on
+    this EP rank, in one launch. The & 255 is the non-negative mod (Triton's % truncates)."""
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < n
+    ids = tl.load(topk_ids_ptr + offs, mask=mask, other=0).to(tl.int32)
+    local_start = tl.load(local_start_ptr).to(tl.int32)
+    local = (ids - local_start) & 255
+    local = tl.where(local < 32, local, -1)
+    tl.store(out_ptr + offs, local, mask=mask)
+
+
+def _local_expert_ids(topk_ids, local_start):
+    """int32 [T, 8] local expert ids (0..31, or -1 for another GPU's expert)."""
+    topk_ids = topk_ids.contiguous()
+    out = torch.empty(topk_ids.shape, dtype=torch.int32, device=topk_ids.device)
+    n = topk_ids.numel()
+    _local_expert_ids_kernel[(triton.cdiv(n, LOCAL_ID_BLOCK),)](
+        topk_ids, local_start, out, n, BLOCK=LOCAL_ID_BLOCK)
+    return out
 
 
