+# ---------------------------------------------------------------------------------------------
+# SKW (hypothesis sliding-sk-window-port-decode32-verify1): muse_attention_decode master's windowed stream-K sliding
+# routes, ported for exactly two sliding bands (page 1, tp8 heads, head dim 64, RoPE theta 500000, window 2048):
+#   b32  sliding decode 17 <= B <= 32 (q_len 1): skw_pre_kernel + skw_attn_kernel PSEUDO TOK=1 single-level ticket (variant 6)
+#   v1   sliding verify B = 1 (q_len 8):         skw_pre_kernel + skw_attn_kernel PSEUDO TOK=8, single-level (4) or two-level (5)
+# skw_pre_kernel is _pre_attention_kernel verbatim (unpaired, RoPE from the state's cos | sin table) under its own name; the CUDA
+# TU is attention master's sk TU reduced to its PSEUDO instantiations (kernel renamed skw_attn_kernel) in a NEW module
+# muse_decode_sk_window_v1 next to decode's _SK module, which is untouched. The kernel reads the unpaired FP8 q the
+# pre-attention kernel wrote and writes the normed, sigmoid(gate)-gated bf16 [T, Hq*D] input of the o GEMM (the gate sits
+# at element 1280 of the qkv row, the layout of master's qkv GEMM; the host asserts it). No spin or mbarrier exists in it
+# (every CTA arrives at a ticket; the last arrival merges), so no wait needs a bound. Tickets, workspaces and the per-band
+# route live in state["skw"] (per prepare() call). Each band is its own flag, selected in prepare() by a variant x grid
+# sub-race against master's ACTUALLY ROUTED path (two interleaved rounds, both >= 1.03x, candidate IQR <= 1.5 x master's);
+# any miss lands on master's exact path and touches no other flag.
+# ---------------------------------------------------------------------------------------------
+SKW_TAG = "[skw]"
+SKW_WINDOW = 2048
+SKW_MARGIN = 1.03          # master / new needed in BOTH interleaved rounds
+SKW_IQR_RATIO = 1.5        # candidate IQR <= this x master's IQR (master's floored at the 0.5 us event resolution)
+SKW_IQR_FLOOR_US = 0.5
+SKW_REPS = 41
+SKW_BANDS = ("b32", "v1")
+SKW_CANDS = {  # band -> (variant, grid spec) sub-race candidates (review: SV1 {4,5} x {p4,p8,sm}; SB32 {6} x {p2,p4,p8})
+    "b32": ((6, "p2"), (6, "p4"), (6, "p8")),
+    "v1": ((4, "p4"), (4, "p8"), (4, "sm"), (5, "p4"), (5, "p8"), (5, "sm")),
+}
+SKW_SELECT = {"b32": (32, 1), "v1": (1, 8)}   # (batch, q_len) of the selector and the layer check
+SKW_CHECK_B = {"b32": (17, 32), "v1": (1,)}   # the band's edge batches for the alternation / kernel cases
+SKW_QKV_COLS = (16 + 2 * 2 + 16) * 64         # q | k | v | gate bf16 columns of a qkv row (the kernel's gate offset)
+SKW_TOL_TOTAL = 1.5e-2     # kernel level, vs the fp64 reference fed the kernel's OWN q bytes
+SKW_TOL_ROW = 5e-2
+SKW_LENS = (1, 63, 2047, 2048, 2049, 80000)
+_SKW = None                # the compiled module; None keeps master everywhere
+_SKW_RES = {}              # band -> plain verdict of the first prepare() (winner / times / reason); no tensors
+_SKW_ATTRS_DONE = False
