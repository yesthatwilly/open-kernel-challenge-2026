+def _dl2_time(state):
+    """Print-only: Q's and O's own stream time per launch at T = 1, PDL off and on (20 launches
+    in a graph, CUDA events), so the milestones read the rows, not a profiler row that includes a wait."""
+    dev = state["dense"]["qkv_gate"].device
+    gen = torch.Generator(device=dev)
+    gen.manual_seed(7)
+    rows = []
+    for tokens in (1,):
+        data = _dl2_make_data(dev, gen, tokens, 1, 2048, 1.0)
+        x = torch.randn((tokens, HIDDEN), device=dev, generator=gen).to(torch.bfloat16)
+        fa = torch.randn((tokens, 16, 64), device=dev, generator=gen).to(torch.bfloat16)
+        gate = torch.randn((tokens, 1024), device=dev, generator=gen).to(torch.bfloat16)
+        for name, nbytes, run in (
+                ("Q", DL2_Q_ROWS * HIDDEN * 2, lambda p: _dl2_q(data, x, state, p, False)),
+                ("O", HIDDEN * 1024 * 2, lambda p: _dl2_o(fa, gate, state, p, 0, 1))):
+            row = [f"{name} T={tokens}"]
+            for pdl in (0, 1):
+                try:
+                    graph = torch.cuda.CUDAGraph()
+                    with torch.cuda.graph(graph):
+                        for _ in range(20):
+                            run(pdl)
+                    _dl2_launch(f"time {name} T={tokens} pdl={pdl} warm replay", graph.replay)
+                    start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                    start.record()
+                    for _ in range(5):
+                        graph.replay()
+                    end.record()
+                    torch.cuda.synchronize()
+                    us = start.elapsed_time(end) * 1e3 / 100
+                    row.append(f"pdl={pdl} {us:.1f} us ({nbytes / us / 1e6:.2f} TB/s)")
+                    del graph
+                except Exception as e:
+                    row.append(f"pdl={pdl} timing raised {e!r}")
+            rows.append(" ".join(row))
+    return rows
