+def _dl2_compare(state):
+    """Print + decide (LESSONS 163): at full decode_1 (T = 1), graph-timed Q + O against master's qkv GEMM +
+    FusedQKNorm + casts + store_cache + unpad + o_norm_gate + o GEMM on the same inputs (FA3 is identical on
+    both paths, so it is left out). Returns True when the custom path is faster."""
+    dev = state["dense"]["qkv_gate"].device
+    gen = torch.Generator(device=dev)
+    gen.manual_seed(11)
+    data = _dl2_make_data(dev, gen, 1, 1, 0, 1.0)
+    x = torch.randn((1, HIDDEN), device=dev, generator=gen).to(torch.bfloat16)
+    fa = torch.randn((1, 16, 64), device=dev, generator=gen).to(torch.bfloat16)
+    pdl = state["dl2"]["pdl"]
+    kc, vc = data["k_cache"].clone(), data["v_cache"].clone()
+
+    def custom():
+        _, gate = _dl2_q(data, x, state, pdl, False)
+        return _dl2_o(fa, gate, state, pdl, 0, 1)
+
+    def master():
+        _, gate, _ = _dl2_ref_q(data, x, state, kc, vc)
+        return _dl2_ref_o(fa, gate, state, 0)
+
+    us = {}
+    for name, run in (("custom Q+O", custom), ("master qkv+norm+casts+store+norm_gate+o", master)):
+        best = None
+        for rep in range(3):
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                for _ in range(20):
+                    run()
+            _dl2_launch(f"compare {name} rep{rep} warm replay", graph.replay)
+            start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            start.record()
+            for _ in range(5):
+                graph.replay()
+            end.record()
+            torch.cuda.synchronize()
+            t = start.elapsed_time(end) * 1e3 / 100
+            best = t if best is None else min(best, t)
+            del graph
+        us[name] = best
+    custom_us, master_us = us["custom Q+O"], us["master qkv+norm+casts+store+norm_gate+o"]
+    state["dl2"]["cnt_q"].zero_()
+    state["dl2"]["cnt_o"].zero_()
+    _dl2_say(f"compare T=1 full: custom Q+O {custom_us:.1f} us vs master attention side (sans FA3) {master_us:.1f} us "
+             f"-> {'custom wins' if custom_us < master_us else 'MASTER wins'}")
+    return custom_us < master_us
