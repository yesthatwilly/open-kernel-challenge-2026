+    except Exception as e:
+        pick = {}
+        out.append(f"{WH_TAG} OFF at {stp[0]}: {type(e).__name__}: {str(e)[:160]}")
+    for cls, n in list(pick.items()):
+        gl, pick[cls] = [], None
