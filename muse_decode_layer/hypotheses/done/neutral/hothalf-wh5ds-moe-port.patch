+        out.append(f"{WH_TAG} final sync raised {type(e).__name__}")
+    for c in whk:
+        whk[c] = arm[pick[c]] if pick.get(c) else None
+    vs = [v for v in whk.values() if v]
+    if not any(v & 8 for v in vs):
