+    out.append(f"{WH_TAG} PATH CHOSEN " + ", ".join(
+        f"T={c} " + (f"{pick[c]} wg_kernel<G,{whk[c]}>" if whk[c] else "master wg_kernel<G>") for c in HC_CLASSES)
+        + f" ({time.perf_counter() - t1:.1f}s, prepare at {time.perf_counter() - t0:.1f}s)")
+    return out
