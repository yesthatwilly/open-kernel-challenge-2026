+    try:
+        _wh_join(job)
+        res = job["res"]
+        out.append(f"{WH_TAG} BUILD {res.get('secs', 0):.0f}s bg from {job.get('t', 0):.1f}s, join waited "
+                   f"{job['wait']:.0f}s; ptxas -Werror {'clean' if res.get('probe') else 'NOT clean'}, C75xx "
