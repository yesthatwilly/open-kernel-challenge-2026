+            gl.append(f"raised at {stp[0]}: {type(e).__name__}: {str(e)[:100]}")
+        out.append(f"{WH_TAG} GATE T={cls} layer/m: " + "; ".join(gl))
+    for t in list(_EAD_INPUTS):
