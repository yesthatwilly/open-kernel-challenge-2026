+                           f"wh/m {_wh_fmt(ratio('wh', 'm'))} wh/D0 {_wh_fmt(ratio('wh', 'D0'))} wh5ds/wh "
+                           f"{_wh_fmt(ratio('wh5ds', 'wh'))} a3/m<={max(ratio('a3', 'm')):.3f} D0/m "
+                           f"{min(fd):.3f}..{max(fd):.3f}; us " + " ".join(f"{n} {mu[n]:.1f}" for n in mu)
+                           + f"; exact 6/6{' but ' + ','.join(sorted(bad)) if bad else ''}{nrep}")
+            except Exception as e:
