+@triton.jit
+def _cache_store_q_fp8_kernel(
+    q_ptr, k_ptr, v_ptr, loc_ptr, k_scale_ptr, v_scale_ptr,
+    q_out_ptr, k_cache_ptr, v_cache_ptr,
+    q_s0, q_s1, q_s2, k_s0, k_s1, k_s2, v_s0, v_s1, cache_row_stride,
+    HQ: tl.constexpr, HKV: tl.constexpr, D: tl.constexpr, SCALED: tl.constexpr,
+):
+    """One program per token: the k row (normed, roped, bf16) and the v row (the strided slice
+    of the qkv GEMM output) go to FP8 at cache row cache_loc[t]; the q row goes to FP8 in a
+    contiguous [T, HQ, D] buffer for FA3. Every row is stored (reserved_skip_index=-1)."""
+    t = tl.program_id(0).to(tl.int64)
+    j = tl.arange(0, D)[None, :]
+
+    hq = tl.arange(0, HQ)[:, None]
+    q = tl.load(q_ptr + t * q_s0 + hq * q_s1 + j * q_s2)
+    tl.store(q_out_ptr + (t * HQ + hq) * D + j, q.to(tl.float32).to(tl.float8e4nv))
+
+    loc = tl.load(loc_ptr + t).to(tl.int64)
+    hk = tl.arange(0, HKV)[:, None]
+    k = tl.load(k_ptr + t * k_s0 + hk * k_s1 + j * k_s2).to(tl.float32)
+    v = tl.load(v_ptr + t * v_s0 + (hk * D + j) * v_s1).to(tl.float32)
+    if SCALED:
+        k = k / tl.load(k_scale_ptr)
+        v = v / tl.load(v_scale_ptr)
+    dst = loc * cache_row_stride + hk * D + j
+    tl.store(k_cache_ptr + dst, k.to(tl.float8e4nv))
+    tl.store(v_cache_ptr + dst, v.to(tl.float8e4nv))
+
+
