+def _wh_bits():
+    d = [0] * 32
+    for p in range(4):
+        dst = [6 - 3 * p, 7 - 3 * p, 8 - 3 * p, 15 - 3 * p] if p < 3 else [13, 10, 11, 14]
+        for h in range(2):
+            for k in range(4):
+                d[4 * (3 - p) + 16 * h + k] = dst[k] + 16 * h
+    if sorted(d) != list(range(32)):
+        raise RuntimeError("code permutation is not a bit permutation")
+    return d
+
+
+def _wh_perm(wb):
+    # A COPY of the whole wg bank, every 32-bit code word permuted for ext_prop (master pair p: low nibble 3 - p, high
+    # 7 - p; to bits {6,7,8,15} - 3p, pair 3 to m 13, e 10/11, s 14; +16 high), scales untouched; lossless per chunk.
+    d = _wh_bits()
+    out = {}
+    for key in ("q13", "q2"):
+        src = wb[key].view(-1, WH_REC)
+        dst = src.clone()
+        for i in range(0, src.shape[0], WH_PERM_CHUNK):
+            w = src[i:i + WH_PERM_CHUNK, :WH_CODES].contiguous().view(torch.int32).long() & 0xFFFFFFFF
+            p, back = torch.zeros_like(w), torch.zeros_like(w)
+            for s in range(32):
+                p |= ((w >> s) & 1) << d[s]
+            for s in range(32):
+                back |= ((p >> d[s]) & 1) << s
+            if not torch.equal(back, w):
+                raise RuntimeError(f"{key} chunk {i}: permutation not lossless")
+            dst[i:i + WH_PERM_CHUNK, :WH_CODES] = (p - ((p >> 31) & 1) * (1 << 32)).to(torch.int32).view(
+                torch.uint8).view(-1, WH_CODES)
+            w = p = back = None
+        if not torch.equal(dst[:, WH_CODES:], src[:, WH_CODES:]):
+            raise RuntimeError(f"{key}: scale bytes changed")
+        out[key] = dst.view(-1)
+    return out
+
+
+def _wh_inputs(state, device, gen, gcpu, cls, h, synth=None):
+    # synth None: a router draw (_ead_cases, the gates' inputs); else every expert of residue `synth` mod 4 hot with a
+    # WH_COUNTS route count (nbk 1..8 at T=256, 2..8 at T=128), local_start 96 (wraps), the rest remote.
+    if synth is None:
+        data = _ead_cases(state, device, gen, cls)
+        ids = _cb_router_scores(_dl3_clone_data(data), state).topk(TOP_K, dim=-1).indices.to(torch.int32).contiguous()
+        ls = data["local_start"]
+    else:
+        ids = torch.arange(LOCAL_EXPERTS, LOCAL_EXPERTS + TOP_K).repeat(cls, 1)
+        for j, e in enumerate(range(synth, LOCAL_EXPERTS, 4)):
+            c = min(WH_COUNTS[(j + 2 * synth) % len(WH_COUNTS)], cls)
+            ids[torch.randperm(cls, generator=gcpu)[:c], j] = e
+        ids = ((ids + 96) % N_EXPERTS).to(torch.int32).to(device)
+        ls = torch.tensor([96], dtype=torch.int32, device=device)
+    tw = torch.full((cls, TOP_K), 1.0 / TOP_K, dtype=torch.float32, device=device)
+    _, _, align = _hc_dispatch(ids, tw, ls, h)
+    return torch.randn((cls, D_EXPERT), generator=gen, device=device).to(torch.bfloat16), align[3:6]
+
+
+def _wh_exact(state, x, al, arms):
+    nh = int(al[2][0])
+    out = torch.empty((x.shape[0] * TOP_K, x.shape[1]), dtype=x.dtype, device=x.device)
+    ref = _wh_run(state, None, x, al, out).clone()
+    hs = state["wg_hs"][:nh].clone()
+    return {n for n, v in arms if not (torch.equal(_wh_run(state, v, x, al, out), ref)
+                                       and torch.equal(state["wg_hs"][:nh], hs))}
+
+
+def _wh_time(state, device, x, al, arms):
+    sh, bh, nh = al
+    routes, size_k = x.shape[0] * TOP_K, x.shape[1]
+    out = torch.empty((routes, size_k), dtype=x.dtype, device=x.device)
+    state["wg_ext"].wg_gather(x, sh, bh, nh, routes, LOCAL_EXPERTS, state["wg_xs"])
+    sz = state["bank"]["size_n"]
+    graphs = {n: _rt_graph(lambda v=v: _wh_pair(state, v, sh, bh, nh, routes, sz, size_k, out))[0]
+              for n, v in (("m", None),) + arms}
+    rounds = _rt_time(graphs, device)
+    del graphs
+    return [{n: _rt_stats(ts[n])[0] for n in ts if n != "__baseline_us__"} for ts in rounds]
+
+
+def _wh_replay(state, device, gen, gcpu, cls, h):
+    # wh graphs (gather + w13 + w2) on two scratch sets, refilled WH_REFILLS times (router draws and all-N synthetic
+    # routings alternate), replayed in alternating order: each output bitwise vs master's eager pair.
+    x0, al0 = _wh_inputs(state, device, gen, gcpu, cls, h)
+    x, al = x0.clone(), [t.clone() for t in al0]
+    sb = {"wg_xs": torch.zeros_like(state["wg_xs"]), "wg_hs": torch.zeros_like(state["wg_hs"]),
+          "whk_err": torch.zeros_like(state["whk_err"])}
+    outs = [torch.empty((cls * TOP_K, D_EXPERT), dtype=torch.bfloat16, device=device) for _ in range(2)]
+    gs = [_rt_graph(lambda o=o, s=s: _wh_run(state, WH_V, x, al, o, s))[0] for o, s in zip(outs, (state, sb))]
+    ref_o = torch.empty_like(outs[0])
+    bad = 0
+    for k in range(WH_REFILLS):
+        x1, al1 = _wh_inputs(state, device, gen, gcpu, cls, h, None if k % 2 == 0 else (k // 2) % 4)
+        x.copy_(x1)
+        for t, s in zip(al, al1):
+            t.copy_(s)
+        ref = _wh_run(state, None, x, al, ref_o)
+        for g in (gs if k % 2 == 0 else gs[::-1]):
+            g.replay()
+        torch.cuda.synchronize()
+        bad += sum(0 if torch.equal(o, ref) else 1 for o in outs)
+    e = [int(v) for v in sb["whk_err"].tolist()]
+    del gs
+    return bad + (0 if e == [0, WH_MAGIC] else 100), 2 * WH_REFILLS
+
+
+def _wh_fmt(vals):
+    return "/".join(f"{v:.3f}".lstrip("0") for v in vals)
+
+
+def _wh_fork(state, device, cls):
+    whk, keep = state["whk"], state["whk"].get(cls)
+
+    def st(v, ser):
+        def f():
+            whk[cls] = v
+            state["side_serial"] = ser
+        return f
+
+    try:
+        per = _ead_layer_gate(state, device, cls, {"ms": st(None, True), "mf": st(None, False), "ws": st(WH_V, True),
+                                                   "wf": st(WH_V, False)}, 20261192 + cls)
+    finally:
+        whk[cls] = keep
+        state["side_serial"] = False
+    med = {k: [_rt_stats(ts[k])[0] for rounds in per.values() for ts in rounds] for k in ("ms", "mf", "ws", "wf")}
+    avg = {k: sum(v) / len(v) for k, v in med.items()}
+
+    def rr(a, b):
+        return _wh_fmt([p / max(q, 1e-3) for p, q in zip(med[a], med[b])])
+    return (f"{WH_TAG} FORK T={cls} layer us m s/f {avg['ms']:.1f}/{avg['mf']:.1f} wh s/f {avg['ws']:.1f}/"
+            f"{avg['wf']:.1f}; wh/m fork {rr('wf', 'mf')} serial {rr('ws', 'ms')}; fork/serial m {rr('mf', 'ms')}")
+
+
+def _wh_phase(state, device, t0, job):
+    whk = state["whk"] = {c: None for c in HC_CLASSES}
+    out, exact, t1 = [], {}, time.perf_counter()
+    n_in = {t: len(v) for t, v in _EAD_INPUTS.items()}
+
+    def late(what):
+        if time.perf_counter() - t0 > WH_DL:
+            raise RuntimeError(f"deadline before {what} ({time.perf_counter() - t0:.0f} s)")
+
+    def mark(what):  # the previous step's launches are done (synced) and the next one is named before it launches
+        torch.cuda.synchronize()
+        print(f"{WH_TAG} > {what}", flush=True)
+    try:
+        _wh_join(job)
+        res = job["res"]
+        out.append(f"{WH_TAG} BUILD {res.get('secs', 0):.0f}s bg from {job.get('t', 0):.1f}s, join waited "
+                   f"{job['wait']:.0f}s; ptxas -Werror {'clean' if res.get('probe') else 'not clean'}, C75xx "
+                   f"{res.get('c75') or 'none'}")
+        if job.get("off"):
+            raise RuntimeError(job["off"])
+        ext = res.get("ext")
+        if ext is None:
+            raise RuntimeError(f"build failed: {res.get('err', '')[-160:]}")
+        hc = state.get("hc") or {}
+        cls_on = [c for c in HC_CLASSES if hc.get("on", {}).get(c, 0) in HC_WG_HOT]
+        if not cls_on or "wg_banks" not in state:
+            raise RuntimeError("master's wgmma hot half is not routed")
+        mark("wh_init")
+        rows, attrs, good = [int(v) for v in ext.wh_init()], {}, True
+        for i in range(0, len(rows), 10):
+            f, a_ok, regs, lb, ss, ds, occ, _, bv, _ = rows[i:i + 10]
+            ok = (a_ok and occ >= 1 and ss + ds <= WG_SMEM_LIMIT and bv == 90 and lb == 0
+                  and regs * WG_THREADS >= 40 * 128 + 232 * 256)
+            attrs[(f & 1, f >> 1)] = f"r{regs}/l{lb}" + ("" if ok else "/BAD")
+            good = good and bool(ok)
+        out.append(f"{WH_TAG} ATTRS regs/spill " + "; ".join(
+            ("w13 " if g else "w2 ") + " ".join(f"{n} {attrs.get((g, v), '?')}" for n, v in WH_ARMS) for g in (1, 0)))
+        if not good:
+            raise RuntimeError("kernel attributes (launchable, occupancy, sm_90a image, register pool, no spill)")
+        wb = state["wg_banks"][(0, LOCAL_EXPERTS)]
+        late("scale scan")
+        tp = time.perf_counter()
+        sc = [wb[k].view(-1, WH_REC)[:, WH_CODES:] for k in ("q13", "q2")]
+        nbad = sum(int(((s < WH_SCALE[0]) | (s > WH_SCALE[1])).sum()) for s in sc)
+        if nbad:
+            raise RuntimeError(f"{nbad} of {sum(s.numel() for s in sc)} scale bytes outside 0x08..0x7E")
+        state["whk_bank"] = dict(_wh_perm(wb), gs13=wb["gs13"], gs2=wb["gs2"])
+        state["whk_ext"], state["whk_err"] = ext, torch.zeros((2,), dtype=torch.int32, device=device)
+        torch.cuda.synchronize()
+        out.append(f"{WH_TAG} SCALES all {sum(s.numel() for s in sc)} in 0x08..0x7E; whole bank permuted, lossless "
+                   f"({time.perf_counter() - tp:.1f}s)")
+        del sc
+        gen = torch.Generator(device=device)
+        gen.manual_seed(20261190)
+        gcpu = torch.Generator().manual_seed(20261191)
+        for cls in cls_on:
+            h = hc["on"][cls]
+            late(f"exact T={cls}")
+            mark(f"exact T={cls}")
+            ins = [_wh_inputs(state, device, gen, gcpu, cls, h) for _ in range(2)]
+            bad = set()
+            for x, al in ins + [_wh_inputs(state, device, gen, gcpu, cls, h, r) for r in range(4)]:
+                bad |= _wh_exact(state, x, al, WH_ARMS)
+            torch.cuda.synchronize()
+            e = [int(v) for v in state["whk_err"].tolist()]
+            if e != [0, WH_MAGIC]:
+                bad.add(f"err {e}")
+            exact[cls] = not ({"D0", "wh"} & bad) and not any(b.startswith("err") for b in bad)
+            late(f"time T={cls}")
+            mark(f"time T={cls}")
+            rnd = [r for x, al in ins for r in _wh_time(state, device, x, al, WH_ARMS)]
+
+            def ratio(a, b):
+                return [r[a] / max(r[b], 1e-3) for r in rnd]
+            wm, wd, fd = ratio("wh", "m"), ratio("wh", "D0"), ratio("D0", "m")
+            why = ""
+            if not exact[cls]:
+                why = "not bit-exact: " + ",".join(sorted(bad))
+            elif not all(WH_FID[0] <= v <= WH_FID[1] for v in fd):
+                why = "INVALID: D0/m outside 0.97..1.03"
+            elif max(wm) > WH_ROUTE or max(wd) > WH_ROUTE:
+                why = f"ratio above {WH_ROUTE} in a round"
+            nrep = ""
+            if not why:
+                late(f"replay T={cls}")
+                mark(f"replay T={cls}")
+                nb, n = _wh_replay(state, device, gen, gcpu, cls, h)
+                nrep = f"; replay {n - nb}/{n} exact"
+                if nb:
+                    why = f"replay: {nb} of {n} differ" + (" or err" if nb >= 100 else "")
+            if not why:
+                whk[cls] = WH_V
+
+            fmt = _wh_fmt
+            mu = {k: sum(r[k] for r in rnd) / len(rnd) for k in ("m", "D0", "wh")}
+            out.append(f"{WH_TAG} ROUTE T={cls} {'ON wg_kernel<G,7>' if whk[cls] else 'OFF (' + why + ')'}: wh/m "
+                       f"{fmt(wm)} wh/D0 {fmt(wd)} D0/m {fmt(fd)} a3/D0 {fmt(ratio('a3', 'D0'))} a3nx/D0 "
+                       f"{fmt(ratio('a3nx', 'D0'))}; us m {mu['m']:.1f} D0 {mu['D0']:.1f} wh {mu['wh']:.1f}; 6 "
+                       f"routings exact{' except ' + ','.join(sorted(bad)) if bad else ''}{nrep}")
+    except Exception as e:
+        for c in whk:
+            whk[c] = None
+        out.append(f"{WH_TAG} OFF: {type(e).__name__}: {str(e)[:200]}")
+    for cls in [c for c in HC_CLASSES if exact.get(c)]:
+        if time.perf_counter() - t0 > WH_DL:
+            out.append(f"{WH_TAG} FORK T={cls}: skipped (deadline)")
+            continue
+        try:
+            mark(f"fork T={cls}")
+            out.append(_wh_fork(state, device, cls))
+        except Exception as e:
+            out.append(f"{WH_TAG} FORK T={cls} raised {type(e).__name__}: {str(e)[:100]}")
+    for t in list(_EAD_INPUTS):
+        if t in n_in:
+            del _EAD_INPUTS[t][n_in[t]:]
+        else:
+            del _EAD_INPUTS[t]
+    try:
+        torch.cuda.synchronize()
+    except Exception as e:
+        for c in whk:
+            whk[c] = None
+        out.append(f"{WH_TAG} final sync raised {type(e).__name__}")
+    if not any(whk.values()):
+        state.pop("whk_bank", None)
+    try:
+        mark("done")
+    except Exception:
+        pass
+    out.append(f"{WH_TAG} PATH CHOSEN " + ", ".join(
+        f"T={c} {'wh wg_kernel<G,7>' if whk[c] else 'master wg_kernel<G>'}" for c in HC_CLASSES)
+        + f" ({time.perf_counter() - t1:.1f}s, prepare at {time.perf_counter() - t0:.1f}s)")
+    return out
+
