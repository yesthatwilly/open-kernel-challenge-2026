+  } else if constexpr (I == 1) {
+    return (q << 3) & 0x81C081C0u;
+  } else if constexpr (I == 2) {
+    return (q << 6) & 0x81C081C0u;
+  } else {
+    return ((q >> 3) & 0x01800180u) | ((q >> 7) & 0x00400040u) | ((q << 1) & 0x80008000u);
