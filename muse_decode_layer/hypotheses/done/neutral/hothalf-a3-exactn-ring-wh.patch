+def _wh_build_bg(cpp, src, res):
+    # The background thread: no print, no CUDA call. Nice +10 (per thread on Linux, inherited by ninja / nvcc) so
+    # master's own builds keep the CPUs. ptxas -Werror first (any C75xx serialization warning fails it; the failure
+    # text is grepped for C75xx); without C75xx a plain rebuild follows if the time allows.
+    import re
+    t0 = time.perf_counter()
+    try:
+        os.setpriority(os.PRIO_PROCESS, 0, min(19, os.getpriority(os.PRIO_PROCESS, 0) + 10))
+    except Exception:
+        pass
+    try:
+        from torch.utils.cpp_extension import load_inline
+        for probe in (True, False):
+            try:
+                res["ext"] = load_inline(name=WH_EXT_NAME + ("_p" if probe else ""), cpp_sources=cpp, cuda_sources=src,
+                                         functions=["wh_init", "wh_gemm"], verbose=False,
+                                         extra_cuda_cflags=list(WG_CUDA_CFLAGS) + (["-Xptxas", "-Werror"] if probe else []))
+                res["probe"] = probe
+                break
+            except Exception as e:
+                text = str(e)
+                res["err"] = text[-300:]
+                res["c75"] = sorted(set(re.findall(r"C75\d\d", text))) or res.get("c75")
+                if res.get("c75") or not probe or time.perf_counter() - t0 > WH_REBUILD_S:
+                    break
+    except BaseException as e:
+        res["ext"], res["err"] = None, f"{type(e).__name__}: {str(e)[-300:]}"
+    finally:
+        res["secs"] = time.perf_counter() - t0
+
+
+def _wh_start(t0):
+    job = {"res": {}, "th": None, "env": None, "off": None, "wait": 0.0}
+    try:
+        import threading
+        cpp, src = _wh_src()
+        job["env"] = (os.environ.get("TORCH_CUDA_ARCH_LIST"),)
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        th = threading.Thread(target=_wh_build_bg, args=(cpp, src, job["res"]), name="hh-wh-nvcc", daemon=False)
+        job["t"] = time.perf_counter() - t0
+        th.start()
+        job["th"] = th
+    except Exception as e:
+        job["off"] = f"start {type(e).__name__}: {str(e)[:120]}"
+    return job
+
+
+def _wh_join(job, restore=False):
+    try:
+        th = job.get("th")
+        if th is not None:
+            tw = time.perf_counter()
+            th.join()
+            job["th"] = None
+            job["wait"] += time.perf_counter() - tw
+        if restore and job.get("env") is not None:
+            prev, job["env"] = job["env"][0], None
+            if prev is None:
+                os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+            else:
+                os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    except Exception as e:
+        job["off"] = f"join raised {e!r}"[:160]
