+def _wh_pair(state, v, sh, bh, nh, routes, size_n, size_k, out, sc=None):
+    # v None: master's dispatched launches (master's module and bank). Else the wh module's wg_kernel<G, v> on the
+    # permuted bank (v & 1) or master's bank, with master's w2 PDL setting; sc: the scratch set (wg_xs, wg_hs, whk_err).
+    if v is None:
+        wb = state["wg_banks"][(0, LOCAL_EXPERTS)]
+        _wg_gemm(state, 0, wb["q13"], wb["gs13"], sh, bh, nh, routes, size_n // 64, size_k, state["wg_hs"])
+        _wg_gemm(state, 1, wb["q2"], wb["gs2"], sh, bh, nh, routes, size_k // 128, size_n, out)
+        return
+    sc = state if sc is None else sc
+    wb = state["whk_bank"] if v & 1 else state["wg_banks"][(0, LOCAL_EXPERTS)]
+    ext, grid, err = state["whk_ext"], state["wg_grid"], sc["whk_err"]
+    ext.wh_gemm(0, sc["wg_xs"], wb["q13"], wb["gs13"], sh, bh, nh, routes, size_n // 64, size_k, sc["wg_hs"], grid,
+                err, 0, v)
+    ext.wh_gemm(1, sc["wg_hs"], wb["q2"], wb["gs2"], sh, bh, nh, routes, size_k // 128, size_n, out, grid, err,
+                1 if state.get("wg_pdl", False) else 0, v)
+
