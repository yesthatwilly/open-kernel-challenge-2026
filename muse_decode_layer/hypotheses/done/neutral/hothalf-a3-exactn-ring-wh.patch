+// step's two scale bytes (rows g, g + 8) are adjacent in one word: a one-source prmt. As hh2 hh_wh.cuh, prefill rega A3.
+__device__ __forceinline__ uint32_t hh_rt16(int n) {  // 16, known only at run time (keeps t * m16 + C an IMAD)
+  uint32_t z;
+  asm("shr.u32 %0, %1, 30;\n" : "=r"(z) : "r"(n));
+  return 16u << z;
+}
+template <int J0>
+__device__ __forceinline__ uint32_t hh_scale_pair(uint32_t w, uint32_t m16) {  // {S(b_g), S(b_g8)}, S = b << 4 + 239 << 7
+  uint32_t t, d;
+  asm("prmt.b32 %0, %1, 0, %2;\n" : "=r"(t) : "r"(w), "n"((4 << 12) | ((J0 + 1) << 8) | (4 << 4) | J0));
+  asm("mad.lo.u32 %0, %1, %2, %3;\n" : "=r"(d) : "r"(t), "r"(m16), "r"(0x77807780u));
+  return d;
+}
+template <int H>
+__device__ __forceinline__ uint32_t hh_mul_h(uint32_t a, uint32_t s) {  // a * {S_H, S_H} + (-0), bf16x2 rn
+  uint32_t d;
+  if constexpr (H == 0)
+    asm("{\n\t.reg .b16 l, h;\n\t.reg .b32 t;\n\tmov.b32 {l, h}, %2;\n\tmov.b32 t, {l, l};\n\t"
+        "fma.rn.bf16x2 %0, %1, t, %3;\n\t}\n" : "=r"(d) : "r"(a), "r"(s), "r"(0x80008000u));
+  else
+    asm("{\n\t.reg .b16 l, h;\n\t.reg .b32 t;\n\tmov.b32 {l, h}, %2;\n\tmov.b32 t, {h, h};\n\t"
+        "fma.rn.bf16x2 %0, %1, t, %3;\n\t}\n" : "=r"(d) : "r"(a), "r"(s), "r"(0x80008000u));
