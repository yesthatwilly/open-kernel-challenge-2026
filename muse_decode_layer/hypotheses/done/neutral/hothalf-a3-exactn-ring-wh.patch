+  a[0] = hh_mul_h<0>(hh_ext_prop<0>(qk), S);
+  a[1] = hh_mul_h<1>(hh_ext_prop<1>(qk), S);
+  a[2] = hh_mul_h<0>(hh_ext_prop<2>(qk), S);
+  a[3] = hh_mul_h<1>(hh_ext_prop<3>(qk), S);
