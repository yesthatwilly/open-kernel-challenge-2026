+             "B<=23": (decision["n"][16], 16, "stream-K single-level ticket, grid 2 x SM", "splitkv A+B"),
+             "B>=24": (decision["n"][32], 32, "stream-K single-level ticket, grid 2 x SM", "splitkv A+B")}
