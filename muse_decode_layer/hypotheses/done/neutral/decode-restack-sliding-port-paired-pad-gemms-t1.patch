+def _fallback(layer, x):
+    """A routed T whose tensors miss the Triton path's shape preconditions: say so once per
+    (layer, shape, stride) in the run log, then take cuBLAS. Shapes only, never values."""
+    key = (layer, tuple(x.shape), tuple(x.stride()), x.dtype)
+    if key not in _FALLBACK_SEEN:
+        _FALLBACK_SEEN.add(key)
+        print(f"[small-t-gemm] {layer}: x {tuple(x.shape)} stride {tuple(x.stride())} {x.dtype} "
+              f"misses the Triton preconditions; using _bf16_gemm_dispatch_impl", flush=True)
+
