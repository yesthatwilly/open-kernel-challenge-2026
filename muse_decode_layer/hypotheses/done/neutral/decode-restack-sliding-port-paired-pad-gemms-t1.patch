+    torch.cuda.synchronize()
+    # The split-K kernels self-reset, but re-zero every counter after the warm-ups regardless.
+    for name in ("pooler_cnt", "qkv_cnt", "unpool_cnt"):
+        small[name].zero_()
+    torch.cuda.synchronize()
