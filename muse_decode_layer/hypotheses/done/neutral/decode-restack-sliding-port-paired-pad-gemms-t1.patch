+# Sliding batch-1 decode: muse_attention_decode's _sliding_fused_kernel and its helpers,
+# ported verbatim (hypothesis sliding-fused-triton-decode1-port).
+_INV_FREQ = {}
+
+
+def _inv_freq(theta: float, d: int, device) -> torch.Tensor:
+    """[d/2] float32 theta^(-2i/d), built exactly as the reference builds it; cached per theta."""
+    key = (theta, d, str(device))
+    cache = _INV_FREQ.get(key)
+    if cache is None:
+        cache = _INV_FREQ[key] = 1.0 / (theta ** (torch.arange(0, d, 2, device=device).float() / d))
+    return cache
+
+
+LOG2E = 1.4426950408889634
+_COUNTERS = {}
+
+
+def _counters(batch: int, hkv: int, device) -> torch.Tensor:
+    """int32 [B*Hkv] ticket counters for the in-kernel split combine. Zeroed once per
+    (B, Hkv, device) on the first (eager) call; every launch leaves them at 0 again (the
+    program that draws the last ticket resets its counter), so they hold no data."""
+    key = (batch, hkv, str(device))
+    buf = _COUNTERS.get(key)
+    if buf is None:
+        buf = _COUNTERS[key] = torch.zeros(batch * hkv, dtype=torch.int32, device=device)
+    return buf
+
+
+def _num_splits(batch: int, hkv: int) -> int:
+    """Window splits per (request, kv head), from config only: the power of two that brings
+    the grid to ~128 CTAs, capped at 16 (B=1: 16, B=16: 4, B=32: 2, B>=64: 1)."""
+    s = 1
+    while s < 16 and batch * hkv * s * 2 <= 128:
+        s *= 2
+    return s
+
+
+@triton.jit
+def _norm_rope(x, xs, pos, freq, d, D: tl.constexpr, ROPE: tl.constexpr, EPS: tl.constexpr):
+    """Rows of x [R, D] (xs: the same rows with each pair swapped, xs[:, d] = x[:, d ^ 1]):
+    scaleless RMSNorm, then interleaved RoPE at pos [R] with freq [D] = inv_freq[d // 2].
+    Even d: x_e cos - x_o sin; odd d: x_o cos + x_e sin, as _pre_attention_kernel."""
+    r = 1.0 / tl.sqrt(tl.sum(x * x, axis=1) / D + EPS)
+    x = x * r[:, None]
+    if ROPE:
+        xs = xs * r[:, None]
+        ang = pos[:, None] * freq[None, :]
+        sign = tl.where(d % 2 == 0, -1.0, 1.0)
+        x = x * tl.cos(ang) + sign[None, :] * xs * tl.sin(ang)
+    return x
+
+
+@triton.jit
+def _gpu_fence(x):
+    """fence.acq_rel.gpu executed by every thread holding an element of x (int32)."""
+    return tl.inline_asm_elementwise("fence.acq_rel.gpu;\n\tmov.b32 $0, $1;", "=r,r", [x],
+                                     dtype=tl.int32, is_pure=False, pack=1)
+
+
+@triton.jit
+def _online_update(qk, valid, v, m_i, l_i, acc):
+    """One key block of the online softmax (base-2 logits qk [M, N], values v [N, D] bf16).
+    -inf safe: a row with no valid key so far keeps m = -inf, l = 0, acc = 0, never NaN."""
+    qk = tl.where(valid, qk, float("-inf"))
+    m_new = tl.maximum(m_i, tl.max(qk, axis=1))
+    m_use = tl.where(m_new == float("-inf"), 0.0, m_new)
+    alpha = tl.exp2(m_i - m_use)
+    p = tl.exp2(qk - m_use[:, None])
+    l_i = l_i * alpha + tl.sum(p, axis=1)
+    acc = acc * alpha[:, None] + tl.dot(p.to(tl.bfloat16), v)
+    return m_new, l_i, acc
+
+
+@triton.jit
+def _gate_epilogue(o, qkv_ptr, out_ptr, tok, head, rvalid, d, qkv_stride,
+                   HQ: tl.constexpr, HKV: tl.constexpr, D: tl.constexpr, EPS: tl.constexpr):
+    """out[tok, head] = rmsnorm(o) * sigmoid(gate), o [M, D] fp32 (no bf16 rounding before)."""
+    r = 1.0 / tl.sqrt(tl.sum(o * o, axis=1) / D + EPS)
+    gptr = qkv_ptr + tok.to(tl.int64)[:, None] * qkv_stride + (HQ + 2 * HKV) * D + head[:, None] * D + d[None, :]
+    gate = tl.load(gptr, mask=rvalid[:, None], other=0.0).to(tl.float32)
+    y = o * r[:, None] * tl.sigmoid(gate)
+    optr = out_ptr + (tok.to(tl.int64)[:, None] * HQ + head[:, None]) * D + d[None, :]
+    tl.store(optr, y.to(tl.bfloat16), mask=rvalid[:, None])
+
+
+@triton.jit
+def _sliding_fused_kernel(
+    qkv_ptr, pos_ptr, loc_ptr, seq_ptr, pt_ptr, inv_freq_ptr, k_scale_ptr, v_scale_ptr,
+    k_cache_ptr, v_cache_ptr, ws_acc_ptr, ws_ml_ptr, cnt_ptr, out_ptr,
+    qkv_stride, pt_stride, q_scale, score_scale,
+    HQ: tl.constexpr, HKV: tl.constexpr, D: tl.constexpr, L: tl.constexpr, M: tl.constexpr,
+    LN: tl.constexpr, WINDOW: tl.constexpr, PAGE: tl.constexpr, S: tl.constexpr,
+    BLOCK_N: tl.constexpr, ROPE: tl.constexpr, EPS: tl.constexpr,
+):
+    """Sliding-window layer, one launch: pre-attention, attention, output norm x gate.
+    Grid (B, HKV, S). Program (b, g, s) serves kv head g's GROUP query heads for the block's L
+    tokens as one M-row tile (row r = j * GROUP + hh; rows past GROUP * L are padding), over
+    chunk s of the old keys [lo, seq - 1], lo = max(0, seq - (WINDOW - 1)). Program S - 1 also
+    builds the L new keys/values, stores them (E4M3) at cache_loc and attends them from
+    registers (causal i <= j). Splits combine in-kernel through a ticket counter."""
+    b = tl.program_id(0)
+    g = tl.program_id(1)
+    s = tl.program_id(2)
+    GROUP: tl.constexpr = HQ // HKV
+    d = tl.arange(0, D)
+    dsw = d ^ 1
+    freq = tl.load(inv_freq_ptr + d // 2) if ROPE else tl.zeros([D], dtype=tl.float32)
+
+    # Query rows: token j = r // GROUP (clamped for padding rows, which stay finite), head h.
+    r = tl.arange(0, M)
+    rvalid = r < GROUP * L
+    j = tl.minimum(r // GROUP, L - 1)
+    head = g * GROUP + r % GROUP
+    tok = b * L + j
+    qrow = qkv_ptr + tok.to(tl.int64)[:, None] * qkv_stride + head[:, None] * D
+    xq = tl.load(qrow + d[None, :], mask=rvalid[:, None], other=0.0).to(tl.float32)
+    xqs = tl.load(qrow + dsw[None, :], mask=rvalid[:, None], other=0.0).to(tl.float32)
+    qpos = tl.load(pos_ptr + tok).to(tl.float32)
+    q = _norm_rope(xq, xqs, qpos, freq, d, D, ROPE, EPS)
+    # bf16 operands (finer than FA3's E4M3), rounded after qk_scale_factor as the reference.
+    q = (q * q_scale).to(tl.bfloat16)
+
+    k_scale = tl.load(k_scale_ptr)
+    v_scale = tl.load(v_scale_ptr)
+    qk_scale = score_scale * k_scale  # sm_scale * log2(e) * k_scale
+    seq = tl.load(seq_ptr + b)
+    p_row = seq + j  # each row's token position
+
+    m_i = tl.full([M], float("-inf"), dtype=tl.float32)
+    l_i = tl.zeros([M], dtype=tl.float32)
+    acc = tl.zeros([M, D], dtype=tl.float32)
+
+    if s == S - 1:
+        # The block's new keys/values for head g: never read back from the cache.
+        i = tl.arange(0, LN)
+        ivalid = i < L
+        ntok = b * L + tl.minimum(i, L - 1)
+        nrow = qkv_ptr + ntok.to(tl.int64)[:, None] * qkv_stride
+        xk = tl.load(nrow + (HQ + g) * D + d[None, :], mask=ivalid[:, None], other=0.0).to(tl.float32)
+        xks = tl.load(nrow + (HQ + g) * D + dsw[None, :], mask=ivalid[:, None], other=0.0).to(tl.float32)
+        kpos = tl.load(pos_ptr + ntok).to(tl.float32)
+        kn = _norm_rope(xk, xks, kpos, freq, d, D, ROPE, EPS)
+        k8 = (kn / k_scale).to(tl.float8e4nv)
+        vn = tl.load(nrow + (HQ + HKV + g) * D + d[None, :], mask=ivalid[:, None], other=0.0).to(tl.float32)
+        v8 = (vn / v_scale).to(tl.float8e4nv)
+        loc = tl.load(loc_ptr + ntok).to(tl.int64)
+        cptr = (loc[:, None] * HKV + g) * D + d[None, :]
+        tl.store(k_cache_ptr + cptr, k8.to(tl.uint8, bitcast=True), mask=ivalid[:, None])
+        tl.store(v_cache_ptr + cptr, v8.to(tl.uint8, bitcast=True), mask=ivalid[:, None])
+        # Attend the stored E4M3 values (dequantized via the scales), causal inside the block.
+        qk = tl.dot(q, tl.trans(k8.to(tl.bfloat16))) * qk_scale
+        valid = ivalid[None, :] & (i[None, :] <= j[:, None])
+        m_i, l_i, acc = _online_update(qk, valid, v8.to(tl.bfloat16), m_i, l_i, acc)
+
+    # Old keys: chunk s of [lo, seq - 1]; every key of every row's window is scored.
+    lo = tl.maximum(seq - (WINDOW - 1), 0)
+    count = seq - lo
+    chunk = ((count + S - 1) // S + BLOCK_N - 1) // BLOCK_N * BLOCK_N
+    start = lo + s * chunk
+    end = tl.minimum(start + chunk, seq)
+    n = tl.arange(0, BLOCK_N)
+    for n0 in range(start, end, BLOCK_N):
+        t = n0 + n
+        tmask = t < end
+        page = tl.load(pt_ptr + b.to(tl.int64) * pt_stride + t // PAGE, mask=tmask, other=0)
+        row = page.to(tl.int64) * PAGE + t % PAGE
+        kvoff = (row[:, None] * HKV + g) * D + d[None, :]
+        kb = tl.load(k_cache_ptr + kvoff, mask=tmask[:, None], other=0).to(tl.float8e4nv, bitcast=True)
+        vb = tl.load(v_cache_ptr + kvoff, mask=tmask[:, None], other=0).to(tl.float8e4nv, bitcast=True)
+        qk = tl.dot(q, tl.trans(kb.to(tl.bfloat16))) * qk_scale
+        # t <= p_j for every old key; the window's lower edge is per row.
+        valid = tmask[None, :] & (t[None, :] >= p_row[:, None] - (WINDOW - 1))
+        m_i, l_i, acc = _online_update(qk, valid, vb.to(tl.bfloat16), m_i, l_i, acc)
+
+    if S == 1:
+        # Program 0 holds the new keys, so l > 0 on every row.
+        o = acc / l_i[:, None] * v_scale
+        _gate_epilogue(o, qkv_ptr, out_ptr, tok, head, rvalid, d, qkv_stride, HQ, HKV, D, EPS)
+    else:
+        bg = b * HKV + g
+        part = (bg * S + s).to(tl.int64)
+        tl.store(ws_acc_ptr + (part * M + r[:, None]) * D + d[None, :], acc)
+        tl.store(ws_ml_ptr + part * 2 * M + r, m_i)
+        tl.store(ws_ml_ptr + part * 2 * M + M + r, l_i)
+        # Release: every thread fences its partial stores at gpu scope, the CTA syncs, then one
+        # acq_rel gpu-scope ticket. The program drawing the last ticket combines.
+        _gpu_fence(r)
+        tl.debug_barrier()
+        ticket = tl.atomic_add(cnt_ptr + bg, 1, sem="acq_rel", scope="gpu")
+        tl.debug_barrier()
+        if ticket == S - 1:
+            _gpu_fence(r)  # acquire side, every thread, before the L2 (.cg) reloads
+            base = (bg * S).to(tl.int64)
+            m_max = tl.full([M], float("-inf"), dtype=tl.float32)
+            for s2 in tl.static_range(S):
+                m_s = tl.load(ws_ml_ptr + (base + s2) * 2 * M + r, cache_modifier=".cg")
+                m_max = tl.maximum(m_max, m_s)
+            # Partial S - 1 holds the new keys and is finite on every row, so m_max is too;
+            # empty or fully masked partials (m = -inf) get weight 0, never exp2(-inf - -inf).
+            m_max = tl.where(m_max == float("-inf"), 0.0, m_max)
+            l_sum = tl.zeros([M], dtype=tl.float32)
+            o = tl.zeros([M, D], dtype=tl.float32)
+            for s2 in tl.static_range(S):
+                m_s = tl.load(ws_ml_ptr + (base + s2) * 2 * M + r, cache_modifier=".cg")
+                l_s = tl.load(ws_ml_ptr + (base + s2) * 2 * M + M + r, cache_modifier=".cg")
+                a_s = tl.load(ws_acc_ptr + ((base + s2) * M + r[:, None]) * D + d[None, :], cache_modifier=".cg")
+                w = tl.where(m_s == float("-inf"), 0.0, tl.exp2(m_s - m_max))
+                l_sum += l_s * w
+                o += a_s * w[:, None]
+            o = o / l_sum[:, None] * v_scale
+            _gate_epilogue(o, qkv_ptr, out_ptr, tok, head, rvalid, d, qkv_stride, HQ, HKV, D, EPS)
+            tl.store(cnt_ptr + bg, 0)  # ready for the next launch / graph replay
+
+
+def _sliding_forward(data, qkv):
+    """Sliding batch-1 decode: one launch of _sliding_fused_kernel on the qkv GEMM's [T, 2304]
+    output, returning the [T, 1024] bf16 normed-and-gated attention output (master's FusedQKNorm,
+    FP8 casts, store_cache, FA3 and FusedRMSNormGate at that shape). Branches on config only."""
+    cfg = data["config"]
+    batch, length = cfg["batch"], cfg["q_len"]
+    hq, hkv, d = cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"]
+    tokens = batch * length
+    device = qkv.device
+    theta = cfg["rope_theta"]
+    group = hq // hkv
+    m = max(16, triton.next_power_of_2(group * length))
+    splits = _num_splits(batch, hkv)
+    out = torch.empty((tokens, hq * d), dtype=torch.bfloat16, device=device)
+    if splits > 1:
+        ws_acc = torch.empty((batch * hkv * splits, m, d), dtype=torch.float32, device=device)
+        ws_ml = torch.empty((batch * hkv * splits, 2, m), dtype=torch.float32, device=device)
+        counters = _counters(batch, hkv, device)
+    else:
+        ws_acc = ws_ml = counters = out  # unused when S == 1
+    inv_freq = _inv_freq(theta, d, device) if theta else data["k_scale"]  # unused when ROPE is off
+    page_table = data["page_table"]
+    _sliding_fused_kernel[(batch, hkv, splits)](
+        qkv, data["positions"], data["cache_loc"], data["seq_lens"], page_table, inv_freq,
+        data["k_scale"], data["v_scale"],
+        data["k_cache"].view(torch.uint8), data["v_cache"].view(torch.uint8), ws_acc, ws_ml, counters, out,
+        qkv.stride(0), page_table.stride(0), cfg["qk_scale_factor"], cfg["sm_scale"] * LOG2E,
+        HQ=hq, HKV=hkv, D=d, L=length, M=m, LN=max(16, triton.next_power_of_2(length)),
+        WINDOW=cfg["window"], PAGE=cfg["page_size"], S=splits, BLOCK_N=64, ROPE=bool(theta), EPS=RMS_EPS,
+        num_warps=4, num_stages=2,
+    )
+    return out
+
+
+@triton.jit
+def _pair_pad_q_kernel(
+    q_ptr, out_ptr, q_stride_t, q_stride_h,
+    HQ: tl.constexpr, D: tl.constexpr, G: tl.constexpr,
+):
+    """Paired-path FA3 query, one program per (token, query head): reads head h's D values of
+    FusedQKNorm's q through its strides, rounds them to FP8 E4M3 and writes them into the half
+    (h // G) % 2 of the [tokens, HQ, 2*D] FP8 query (its KV head's half of the paired 128-byte
+    row), and D FP8 zeros into the other half, so every byte of the buffer is written each call."""
+    t = tl.program_id(0)
+    h = tl.program_id(1)
+    j = tl.arange(0, D)
+    half = (h // G) % 2
+    x = tl.load(q_ptr + t.to(tl.int64) * q_stride_t + h * q_stride_h + j).to(tl.float32)
+    qrow = out_ptr + (t.to(tl.int64) * HQ + h) * (2 * D)
+    tl.store(qrow + half * D + j, x.to(tl.float8e4nv))
+    tl.store(qrow + (1 - half) * D + j, tl.zeros([D], dtype=tl.float32).to(tl.float8e4nv))
+
+
+@triton.jit
+def _paired_norm_gate_kernel(
+    attn_ptr, qkv_ptr, out_ptr,
+    attn_stride_t, attn_stride_h, qkv_stride,
+    HQ: tl.constexpr, HKV: tl.constexpr, D: tl.constexpr, G: tl.constexpr, EPS: tl.constexpr,
+):
+    """Full-layer epilogue for the paired path, one program per (token, query head): reads head
+    h's own half (h // G) % 2 of FA3's [tokens, HQ, 2*D] output (the other half is the other KV
+    head's P@V and is never read), applies the scaleless RMSNorm (eps inside the sqrt of the mean
+    of D squares, fp32) times sigmoid(gate) and stores bf16 into the [tokens, HQ*D] output."""
+    t = tl.program_id(0)
+    h = tl.program_id(1)
+    j = tl.arange(0, D)
+    half = (h // G) % 2
+    src = attn_ptr + t.to(tl.int64) * attn_stride_t + h * attn_stride_h + half * D
+    x = tl.load(src + j).to(tl.float32)
+    r = 1.0 / tl.sqrt(tl.sum(x * x, axis=0) / D + EPS)
+    gate = tl.load(qkv_ptr + t.to(tl.int64) * qkv_stride + (HQ + 2 * HKV) * D + h * D + j)
+    gate = gate.to(tl.float32)
+    y = x * r * tl.sigmoid(gate)
+    tl.store(out_ptr + (t.to(tl.int64) * HQ + h) * D + j, y.to(tl.bfloat16))
+
+
+# --- Shape-gated Triton dense GEMMs at T == 1 (hypothesis bf16-shape-gated-triton-gemms-small-t) --
+# Ported verbatim from muse_bf16_proj's bf16-shape-gated-triton-winners-combo (its m <= 16 paths
+# only; its 17 <= m <= 32 swap-AB code is not ported). muse_bf16_proj's guards read its Config's
+# m / n / k; this problem's Config has none, so the guards below read the tensors' shapes, and the
+# routing in kernel_fn is by the token count only. The kernels accept m <= 16, but only T == 1
+# routes to them (restack decode-restack-sliding-port-paired-pad-gemms-t1: at T = 8 / 16 they
+# lost wall time); every T > 1 keeps _bf16_gemm_dispatch_impl.
+#   qkv_gate, T == 1:       _qkv_splitk_sem_kernel, grid (36, 4), split-K 4 ticket reduce
+#   o,        T == 1:       _pooler_skinny_kernel, full K, grid (128,)
+#   pooler,   T == 1:       _bf16_splitk_kernel, grid (64, 2), BLOCK_K 256, split-K 2
+#   unpooler slice, T == 1: _bf16_splitk_kernel on rows 0-1023 read in place, grid (16, 8)
+SMALL_T_TRITON_GEMM = 1  # the only token count routed to the Triton GEMMs
+
+
+@triton.jit(do_not_specialize=["M"])
+def _bf16_splitk_kernel(
+    x_ptr, w_ptr, out_ptr, ws_ptr, cnt_ptr,
+    M,
+    stride_xm, stride_wn, stride_om,
+    N: tl.constexpr, WS_M: tl.constexpr, K_SLICE: tl.constexpr, SPLIT_K: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    """out[M, N] bf16 = x[M, K] @ w[N, K]^T, split-K with an in-kernel semaphore reduce.
+
+    Program (pid_n, pid_k) covers rows of N [pid_n*BLOCK_N, +BLOCK_N), K [pid_k*K_SLICE,
+    +K_SLICE) and all M rows (M <= BLOCK_M <= WS_M; rows >= M masked). w may be the leading N
+    rows of a taller row-major weight (stride_wn is its row stride). ws: fp32 [SPLIT_K, WS_M, N]
+    scratch; cnt: int32 [N // BLOCK_N], 0 between launches. There is no early exit: every CTA
+    stores its partial and takes exactly one ticket, so the counter always returns to 0.
+    """
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    k_start = pid_k * K_SLICE
+
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_k = k_start + tl.arange(0, BLOCK_K)
+    offs_m = tl.arange(0, BLOCK_M)
+    m_mask = offs_m < M
+    # Weight tiles read directly as [BLOCK_K, BLOCK_N] from the row-major [N, K] weight.
+    w_ptrs = w_ptr + offs_k[:, None] + offs_n[None, :] * stride_wn
+    x_ptrs = x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :]
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for kk in range(0, K_SLICE // BLOCK_K):
+        x_tile = tl.load(x_ptrs, mask=m_mask[:, None], other=0.0)
+        w_tile = tl.load(w_ptrs)
+        acc = tl.dot(x_tile, w_tile, acc)
+        x_ptrs += BLOCK_K
+        w_ptrs += BLOCK_K
+
+    # fp32 partial -> workspace slice pid_k, rows < M only (the reducer reads the same mask).
+    ws_tile = offs_m[:, None] * N + offs_n[None, :]
+    tl.store(ws_ptr + pid_k * (WS_M * N) + ws_tile, acc, mask=m_mask[:, None])
+    # All threads' partial stores precede the (single, scalar) gpu-scope acq_rel ticket.
+    tl.debug_barrier()
+    ticket = tl.atomic_add(cnt_ptr + pid_n, 1, sem="acq_rel", scope="gpu")
+    # Order the other threads' reloads after the ticket's acquire.
+    tl.debug_barrier()
+    if ticket == SPLIT_K - 1:
+        total = tl.load(ws_ptr + ws_tile, mask=m_mask[:, None], other=0.0, cache_modifier=".cg")
+        for s in tl.static_range(1, SPLIT_K):
+            total += tl.load(ws_ptr + s * (WS_M * N) + ws_tile, mask=m_mask[:, None], other=0.0,
+                             cache_modifier=".cg")
+        out_ptrs = out_ptr + offs_m[:, None] * stride_om + offs_n[None, :]
+        tl.store(out_ptrs, total.to(tl.bfloat16), mask=m_mask[:, None])
+        # Self-reset so the next launch / graph replay starts from 0.
+        tl.atomic_xchg(cnt_ptr + pid_n, 0, sem="relaxed", scope="gpu")
+
+
+def _bf16_x_ok(x, max_m, k):
+    """x is a bf16 [1..max_m, k] activation with unit inner stride (shapes only)."""
+    return (x.dim() == 2 and x.dtype == torch.bfloat16 and x.stride(1) == 1
+            and 1 <= x.shape[0] <= max_m and x.shape[1] == k)
+
+
+def _bf16_w_ok(w, n, k):
+    """w is the problem's bf16 [n, k] row-major weight (shapes only)."""
+    return w.dim() == 2 and w.dtype == torch.bfloat16 and tuple(w.shape) == (n, k) and w.stride(1) == 1
+
+
+# (1) pooler, T <= 16
+POOLER_N = 4096
+POOLER_K = 8192
+POOLER_MAX_M = 16
+POOLER_BLOCK_N = 64
+POOLER_BLOCK_K = 256  # 16 K-steps per 4096 K-slice
+POOLER_SPLIT_K = 2
+POOLER_NUM_WARPS = 4
+POOLER_NUM_STAGES = 4
+
+
+def _pooler_shape_ok(x, w):
+    return _bf16_x_ok(x, POOLER_MAX_M, POOLER_K) and _bf16_w_ok(w, POOLER_N, POOLER_K)
+
+
+def _pooler_forward(x, w, ws, cnt):
+    """x bf16 [m <= 16, 8192] @ w.T -> bf16 [m, 4096], one launch. Branches only on shapes."""
+    m, k = x.shape
+    out = torch.empty((m, POOLER_N), dtype=torch.bfloat16, device=x.device)
+    grid = (POOLER_N // POOLER_BLOCK_N, POOLER_SPLIT_K)
+    _bf16_splitk_kernel[grid](
+        x, w, out, ws, cnt,
+        m,
+        x.stride(0), w.stride(0), out.stride(0),
+        N=POOLER_N, WS_M=POOLER_MAX_M, K_SLICE=k // POOLER_SPLIT_K, SPLIT_K=POOLER_SPLIT_K,
+        BLOCK_M=16, BLOCK_N=POOLER_BLOCK_N, BLOCK_K=POOLER_BLOCK_K,
+        num_warps=POOLER_NUM_WARPS, num_stages=POOLER_NUM_STAGES,
+    )
+    return out
+
+
+# (2) qkv_gate, 1 <= T <= 16
+QKV_N = 2304
+QKV_K = 8192
+QKV_MAX_M = 16
+QKV_BLOCK_N = 64
+QKV_BLOCK_K = 128
+QKV_SPLIT_K = 4
+QKV_NUM_WARPS = 4
+QKV_NUM_STAGES = 4
+
+
+@triton.jit(do_not_specialize=["M"])
+def _qkv_splitk_sem_kernel(
+    x_ptr, w_ptr, ws_ptr, cnt_ptr, out_ptr,
+    M,
+    stride_xm, stride_wn, stride_ws_s, stride_ws_m, stride_om,
+    K_SLICE: tl.constexpr, SPLIT_K: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    """out[M, N] = x[M, K] @ w[N, K]^T in one launch, split-K with a ticket-semaphore epilogue.
+
+    Grid (N // BLOCK_N, SPLIT_K). Program (pid_n, pid_k) streams w rows [pid_n*BLOCK_N, +BLOCK_N)
+    over K [pid_k*K_SLICE, +K_SLICE) with one M-block (M <= BLOCK_M, rows >= M masked), stores its
+    fp32 partial to ws[pid_k, :M, n-tile], then draws one ticket on cnt[pid_n]. The program that
+    draws ticket SPLIT_K-1 (all partials of this n-tile are written by then) reloads the SPLIT_K
+    partials (.cg, bypassing L1), sums them in fixed order 0..SPLIT_K-1, stores bf16 once and
+    resets cnt[pid_n] to 0 for the next launch. No program waits on another, so it cannot
+    deadlock whether or not the CTAs are co-resident.
+    """
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    k_start = pid_k * K_SLICE
+
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_k = k_start + tl.arange(0, BLOCK_K)
+    offs_m = tl.arange(0, BLOCK_M)
+    m_mask = offs_m < M
+    # Weight tiles read directly as [BLOCK_K, BLOCK_N] from the row-major [N, K] weight (K
+    # contiguous), i.e. w.T for this tile; no repack.
+    w_ptrs = w_ptr + offs_k[:, None] + offs_n[None, :] * stride_wn
+    x_ptrs = x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :]
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for kk in range(0, K_SLICE // BLOCK_K):
+        x_tile = tl.load(x_ptrs, mask=m_mask[:, None], other=0.0)
+        w_tile = tl.load(w_ptrs)
+        acc = tl.dot(x_tile, w_tile, acc)
+        x_ptrs += BLOCK_K
+        w_ptrs += BLOCK_K
+
+    # fp32 partial for rows < M only; the reducer reads exactly the same (masked) rows, so every
+    # value it reads was written in this launch and nothing from an earlier call can reach out.
+    tile_off = offs_m[:, None] * stride_ws_m + offs_n[None, :]
+    tl.store(ws_ptr + pid_k * stride_ws_s + tile_off, acc, mask=m_mask[:, None])
+    # All threads' partial stores precede the (single, scalar) release atomic below.
+    tl.debug_barrier()
+    ticket = tl.atomic_add(cnt_ptr + pid_n, 1, sem="acq_rel", scope="gpu")
+    # The acquire done by the atomic's issuing thread is ordered before every thread's reloads.
+    tl.debug_barrier()
+    if ticket == SPLIT_K - 1:
+        total = tl.load(ws_ptr + tile_off, mask=m_mask[:, None], other=0.0, cache_modifier=".cg")
+        for s in tl.static_range(1, SPLIT_K):
+            part = tl.load(ws_ptr + s * stride_ws_s + tile_off, mask=m_mask[:, None], other=0.0,
+                           cache_modifier=".cg")
+            total += part
+        out_ptrs = out_ptr + offs_m[:, None] * stride_om + offs_n[None, :]
+        tl.store(out_ptrs, total.to(tl.bfloat16), mask=m_mask[:, None])
+        # Reset for the next launch (all SPLIT_K tickets of this n-tile are drawn).
+        tl.atomic_xchg(cnt_ptr + pid_n, 0, sem="relaxed", scope="gpu")
+
+
+def _qkv_shape_ok(x, w):
+    return _bf16_x_ok(x, QKV_MAX_M, QKV_K) and _bf16_w_ok(w, QKV_N, QKV_K)
+
+
+def _qkv_forward(x, w, ws, cnt):
+    """x bf16 [m, 8192] @ w[2304, 8192].T -> bf16 [m, 2304], m <= 16, ONE launch. Branches only on
+    shapes; ws (fp32 [SPLIT_K, 16, 2304]) and cnt (int32 [36], all zero between launches) come
+    from prepare()."""
+    m, k = x.shape
+    n = w.shape[0]
+    out = torch.empty((m, n), dtype=torch.bfloat16, device=x.device)
+    grid = (n // QKV_BLOCK_N, QKV_SPLIT_K)
+    _qkv_splitk_sem_kernel[grid](
+        x, w, ws, cnt, out,
+        m,
+        x.stride(0), w.stride(0), ws.stride(0), ws.stride(1), out.stride(0),
+        K_SLICE=k // QKV_SPLIT_K, SPLIT_K=QKV_SPLIT_K,
+        BLOCK_M=16, BLOCK_N=QKV_BLOCK_N, BLOCK_K=QKV_BLOCK_K,
+        num_warps=QKV_NUM_WARPS, num_stages=QKV_NUM_STAGES,
+    )
+    return out
+
+
+# (3) unpooler slice (rows 0-1023 of the [8192, 4096] weight, row stride 4096), T <= 8
+UNPOOL_N = 1024
+UNPOOL_K = 4096
+UNPOOL_MAX_M = 16    # one BLOCK_M=16 tile; rows >= m masked
+UNPOOL_BLOCK_N = 64
+UNPOOL_BLOCK_K = 128
+UNPOOL_SPLIT_K = 8   # K-slice 512, 4 K-steps
+UNPOOL_NUM_WARPS = 4
+UNPOOL_NUM_STAGES = 3
+
+
+def _unpool_shape_ok(x, w):
+    """x bf16 [1..16, 4096]; w the leading >= 1024 rows of a bf16 row-major [*, 4096] weight."""
+    return (_bf16_x_ok(x, UNPOOL_MAX_M, UNPOOL_K)
+            and w.dim() == 2 and w.dtype == torch.bfloat16 and w.shape[0] >= UNPOOL_N
+            and w.shape[1] == UNPOOL_K and w.stride(1) == 1)
+
+
+def _unpool_forward(x, w, ws, cnt):
+    """x bf16 [m <= 16, 4096] @ w[:1024].T -> bf16 [m, 1024], one launch, w read in place
+    (stride_wn = w.stride(0) = 4096, no slice copy). Branches only on shapes."""
+    m, k = x.shape
+    out = torch.empty((m, UNPOOL_N), dtype=torch.bfloat16, device=x.device)
+    grid = (UNPOOL_N // UNPOOL_BLOCK_N, UNPOOL_SPLIT_K)
+    _bf16_splitk_kernel[grid](
+        x, w, out, ws, cnt,
+        m,
+        x.stride(0), w.stride(0), out.stride(0),
+        N=UNPOOL_N, WS_M=UNPOOL_MAX_M, K_SLICE=k // UNPOOL_SPLIT_K, SPLIT_K=UNPOOL_SPLIT_K,
+        BLOCK_M=UNPOOL_MAX_M, BLOCK_N=UNPOOL_BLOCK_N, BLOCK_K=UNPOOL_BLOCK_K,
+        num_warps=UNPOOL_NUM_WARPS, num_stages=UNPOOL_NUM_STAGES,
+    )
+    return out
+
+
+# (4) o, T <= 16: full K, no reduce
+O_SKINNY_MAX_M = 16
+O_N = 8192
+O_K = 1024
+O_BLOCK_N = 64    # 8192 / 64 = 128 programs: one wave on 132 SMs
+O_BLOCK_K = 256   # 1024 / 256 = 4 K steps per program, all covered by the 4-stage pipeline
+O_NUM_WARPS = 4
+O_NUM_STAGES = 4  # 4 x (64 x 256 + BLOCK_M x 256) x 2 B: 160 KB at BLOCK_M 16
+
+
+@triton.jit(do_not_specialize=["M"])
+def _pooler_skinny_kernel(
+    x_ptr, w_ptr, out_ptr,
+    M,
+    stride_xm, stride_wn, stride_om,
+    K: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    """out[:M, n0:n0+BLOCK_N] = x[:M, :K] @ w[n0:n0+BLOCK_N, :K].T for program n0 = pid * BLOCK_N.
+
+    One program owns BLOCK_N rows of the row-major [N, K] weight and walks the whole K in
+    BLOCK_K steps, so each weight byte is read once and there is no split-K reduce. Rows of x
+    at or past M load as zero and are not stored, so M need not fill BLOCK_M. The dot is bf16 x
+    bf16 with an fp32 accumulator; the only bf16 rounding is at the store."""
+    pid = tl.program_id(0)
+    offs_m = tl.arange(0, BLOCK_M)
+    offs_n = pid * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_k = tl.arange(0, BLOCK_K)
+    row_ok = offs_m < M
+
+    x_ptrs = x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :]   # [BLOCK_M, BLOCK_K]
+    w_ptrs = w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :]   # [BLOCK_N, BLOCK_K], as stored
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for _ in range(0, K, BLOCK_K):
+        x_tile = tl.load(x_ptrs, mask=row_ok[:, None], other=0.0)
+        w_tile = tl.load(w_ptrs)
+        acc = tl.dot(x_tile, tl.trans(w_tile), acc)
+        x_ptrs += BLOCK_K
+        w_ptrs += BLOCK_K
+
+    out_ptrs = out_ptr + offs_m[:, None] * stride_om + offs_n[None, :]
+    tl.store(out_ptrs, acc.to(tl.bfloat16), mask=row_ok[:, None])
+
+
+def _o_shape_ok(x, w):
+    return _bf16_x_ok(x, O_SKINNY_MAX_M, O_K) and _bf16_w_ok(w, O_N, O_K)
+
+
+def _o_skinny_gemm(x, w):
+    """x [m, 1024] bf16 @ w [8192, 1024] bf16 .T -> [m, 8192] bf16, m <= 16."""
+    m = x.shape[0]
+    out = torch.empty((m, O_N), dtype=torch.bfloat16, device=x.device)
+    _pooler_skinny_kernel[(O_N // O_BLOCK_N,)](
+        x, w, out,
+        m,
+        x.stride(0), w.stride(0), out.stride(0),
+        K=O_K, BLOCK_M=16, BLOCK_N=O_BLOCK_N, BLOCK_K=O_BLOCK_K,
+        num_warps=O_NUM_WARPS, num_stages=O_NUM_STAGES,
+    )
+    return out
+
+
+_FALLBACK_SEEN = set()
+
