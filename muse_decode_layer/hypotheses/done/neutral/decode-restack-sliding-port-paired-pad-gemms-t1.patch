+def _prepare_small_t_gemms(state):
+    """Allocate each Triton path's own split-K workspace and ticket counters, warm every routed
+    specialization on synthetic bf16 inputs (T == 1, the only routed token count, for qkv / o /
+    pooler / unpooler slice), synchronise and zero every counter."""
+    dense = state["dense"]
+    device = dense["qkv_gate"].device
+    small = {
+        "pooler_ws": torch.empty((POOLER_SPLIT_K, POOLER_MAX_M, POOLER_N), dtype=torch.float32, device=device),
+        "pooler_cnt": torch.zeros(POOLER_N // POOLER_BLOCK_N, dtype=torch.int32, device=device),
+        "qkv_ws": torch.empty((QKV_SPLIT_K, QKV_MAX_M, QKV_N), dtype=torch.float32, device=device),
+        "qkv_cnt": torch.zeros(QKV_N // QKV_BLOCK_N, dtype=torch.int32, device=device),
+        "unpool_ws": torch.empty((UNPOOL_SPLIT_K, UNPOOL_MAX_M, UNPOOL_N), dtype=torch.float32, device=device),
+        "unpool_cnt": torch.zeros(UNPOOL_N // UNPOOL_BLOCK_N, dtype=torch.int32, device=device),
+    }
+    state["small_t"] = small
+    unpool_w = dense["unpooler"][:UNPOOL_SLICE]
+    for m in (SMALL_T_TRITON_GEMM,):
+        x = torch.randn((m, QKV_K), device=device, dtype=torch.float32).to(torch.bfloat16)
+        if _qkv_shape_ok(x, dense["qkv_gate"]):
+            _qkv_forward(x, dense["qkv_gate"], small["qkv_ws"], small["qkv_cnt"])
+        if _pooler_shape_ok(x, dense["pooler"]):
+            _pooler_forward(x, dense["pooler"], small["pooler_ws"], small["pooler_cnt"])
+        xo = torch.randn((m, O_K), device=device, dtype=torch.float32).to(torch.bfloat16)
+        if _o_shape_ok(xo, dense["o"]):
