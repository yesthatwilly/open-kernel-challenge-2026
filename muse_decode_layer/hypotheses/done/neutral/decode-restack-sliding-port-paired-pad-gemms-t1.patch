+        if m <= SLICED_UNPOOL_MAX_TOKENS:  # always true at m == 1; kept as in the source branch
+            xu = torch.randn((m, UNPOOL_K), device=device, dtype=torch.float32).to(torch.bfloat16)
+            if _unpool_shape_ok(xu, unpool_w):
