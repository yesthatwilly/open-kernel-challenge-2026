+def _rega_prepare(state, device, t_prepare0, clones):
+    """prepare(), after master's own setup and the combination phases: M1's build check, retile from the clones,
+    per-bucket canary, correctness + copy check, per-class selector, one PATH CHOSEN line per class. Never
+    raises; every miss leaves state["rega"] all False (master's Marlin path) and frees M1's memory."""
+    t0 = time.perf_counter()
+    rg = state["rega"]
+    why = None
+    wcache = {}
+    sel = {}
+    try:
+        since = t0 - t_prepare0
+        if since > RG_START_DEADLINE:
+            raise _RgSkip(f"start deadline {RG_START_DEADLINE:.0f}s passed ({since:.1f}s into prepare())")
+        if clones is None:
+            raise _RgSkip("weight clone failed")
+        if not state.get("align_par_ok", False):
+            # wg_gemm's TORCH_CHECK caps block_experts at WG_MAX_BLOCKS: only _align_parallel's capacity
+            # (n + 32 * 15 rows) fits at every T <= 512; the 256-expert moe_align_block_size fallback does not.
+            raise _RgSkip("align_par_ok is False for this state: the side-stream align is not _align_parallel")
+        if _WG_EXT is None:
+            raise _RgSkip(f"module {WG_EXT_NAME} unavailable (import-time build failed or sm_90 not present)")
+        if WG_BSM != MARLIN_BLOCK_SIZE_M_CAP or any(_block_size_m(t) != WG_BSM for t in range(128, 513)):
+            raise _RgSkip(f"decode's align block size at 128 <= T <= 512 is not WG_BSM {WG_BSM}")
+        if tuple(clones["w13"].shape) != (LOCAL_EXPERTS, 2 * D_EXPERT, D_EXPERT // 2) or \
+                tuple(clones["w2"].shape) != (LOCAL_EXPERTS, D_EXPERT, D_EXPERT // 2):
+            raise _RgSkip(f"unexpected expert weight shapes {tuple(clones['w13'].shape)} / {tuple(clones['w2'].shape)}")
+        for gated in (True, False):
+            need = WG_SMEM[gated] + WG_STATIC_SMEM_BOUND
+            if need > WG_SMEM_LIMIT:
+                raise _RgSkip(f"smem {need} B > {WG_SMEM_LIMIT} B")
+        info = _WG_EXT.wg_init()
+        attrs_ok = True
+        for i in range(0, len(info), 10):
+            gated, a_ok, regs, local_bytes, static_smem, dyn_smem, occ, e1, bin_v, ptx_v = info[i:i + 10]
+            _rg_say(f"kernel {'w13+silu' if gated else 'w2'}: attrs ok {bool(a_ok)} (rc {e1}), numRegs {regs}, "
+                    f"local {local_bytes} B, smem {static_smem}+{dyn_smem} B, CTAs/SM {occ}, binary {bin_v}, ptx {ptx_v}")
+            attrs_ok = (attrs_ok and bool(a_ok) and occ >= 1 and static_smem + dyn_smem <= WG_SMEM_LIMIT
+                        and regs * WG_THREADS >= 40 * 128 + 232 * 256 and bin_v == 90)
+        if not attrs_ok:
+            raise _RgSkip("cudaFuncSetAttribute / cudaFuncGetAttributes / occupancy check failed")
+        _wg_attach_scratch(state, device, D_EXPERT, D_EXPERT)
+        t_r = time.perf_counter()
+        state["wg_bank"] = _wg_bank(clones, 0, LOCAL_EXPERTS)
+        torch.cuda.synchronize()
+        _rg_say(f"retiled {LOCAL_EXPERTS} experts losslessly (round trips exact) from the clones in "
+                f"{time.perf_counter() - t_r:.1f}s")
+        t_c = time.perf_counter()
+        if not _rg_canary(state, clones, wcache, device):
+            raise _RgSkip("bucket canary failed")
+        _rg_say(f"canary passed ({time.perf_counter() - t_c:.1f}s)")
+        t_c = time.perf_counter()
+        ok, summary = _rg_copy_check(state, clones, wcache, device)
+        _rg_say(f"copy check {'PASS' if ok else 'FAIL'} ({time.perf_counter() - t_c:.1f}s): {summary}")
+        if not ok:
+            raise _RgSkip("copy check failed")
+        del wcache
+        wcache = {}
+        if time.perf_counter() - t_prepare0 > RG_TIMING_DEADLINE:
+            raise _RgSkip(f"selector skipped: {time.perf_counter() - t_prepare0:.1f}s into prepare() "
+                          f"(deadline {RG_TIMING_DEADLINE:.0f}s)")
+        for tokens, name, _hi in RG_CLASSES:
+            sel[tokens] = _rg_select(state, device, tokens, name)
+    except Exception as e:
+        why = str(e) if isinstance(e, _RgSkip) else f"{type(e).__name__}: {str(e)[:300]}"
+    rg[128] = rg[256] = False
+    for tokens, name, _hi in RG_CLASSES:
+        if tokens in sel:
+            win, res = sel[tokens]
+            rg[tokens] = bool(win and why is None)
+            soft, skew = res["soft"], res["skew"]
+            nums = (f"rega {soft[0]:.1f} / {skew[0]:.1f} us vs marlin {soft[1]:.1f} / {skew[1]:.1f} us on soft / skew, "
+                    f"local routes {soft[2]} / {skew[2]}")
+            print(f"{RG_TAG} PATH CHOSEN {name} = {'REGA' if rg[tokens] else 'MARLIN'} [{nums}]"
+                  + ("" if why is None else f" (fallback: {why})"), flush=True)
+            print(f"PATH CHOSEN: M1 {name}: {'NEW rega' if rg[tokens] else 'MASTER marlin'} "
+                  f"[new {soft[0]:.2f} us vs master {soft[1]:.2f} us (soft; skew {skew[0]:.2f} vs {skew[1]:.2f})]",
+                  flush=True)
+        else:
+            print(f"{RG_TAG} PATH CHOSEN {name} = MARLIN (fallback: {why or 'selector did not run'})", flush=True)
+            print(f"PATH CHOSEN: M1 {name}: MASTER marlin [not timed] (fallback: {why or 'selector did not run'})",
+                  flush=True)
+    if not (rg[128] or rg[256]):  # nothing enabled: free the bank and the scratch
+        for key in ("wg_bank", "wg_xs", "wg_hs", "wg_err", "wg_grid"):
+            state.pop(key, None)
+    del wcache
+    gc.collect()
+    torch.cuda.synchronize()
+    torch.cuda.empty_cache()
+    now = time.perf_counter()
+    _rg_say(f"phase M1: {now - t0:.1f}s wall, this prepare() {now - t_prepare0:.1f}s, all prepare() calls "
+            f"{_PREPARE_WALL_S + now - t_prepare0:.1f}s")
+    for key in ("wg_xs", "wg_hs", "wg_err"):
+        if key in state:
+            state[key].zero_()
+    torch.cuda.synchronize()
+
