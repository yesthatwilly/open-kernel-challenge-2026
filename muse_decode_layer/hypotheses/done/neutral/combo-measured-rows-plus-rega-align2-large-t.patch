+def _rg_select(state, device, tokens, name):
+    """Per class: master's whole expert block (dispatch + Marlin w13 + act_and_mul + Marlin w2 + post-norm) against
+    rega's (dispatch + gather + w13+silu + w2 + post-norm), both from the same static raw routing, as cold-L2
+    CUDA-graph replays (_cb_time: 256 MB flush, interleaved reps, empty-graph baseline subtracted), on (a)
+    judge-like routing (the real router weights and bias through FusedMuseSparkRouting on synthetic rmsnormed
+    inputs) and (b) zipf a=0.3 skew. Returns (win, line fields). Enabled only if rega / Marlin <= RG_RATIO on both."""
+    if tokens in _RG_SELECT:
+        return _RG_SELECT[tokens]
+    gen = torch.Generator().manual_seed(20261103 + tokens)
+    x = torch.randn((tokens, D_EXPERT), generator=gen).to(torch.bfloat16).to(device)
+    xffn = torch.randn((tokens, HIDDEN), generator=gen).to(torch.bfloat16).to(device)
+    logits = torch.mm(xffn, state["router_hi_t"], out_dtype=torch.float32)
+    logits += torch.mm(xffn, state["router_lo_t"], out_dtype=torch.float32)
+    tw_s, ids_s = state["routing"](None, logits, TOP_K, True)
+    local_set = list(range(LOCAL_EXPERTS))
+    ids_z = _wg_zipf_ids(tokens, RG_SEL_ALPHA, gen, local_set).to(device)
+    tw_z = torch.full((tokens, TOP_K), 1.0 / TOP_K, dtype=torch.float32, device=device)
+    routings = (("soft", ids_s, tw_s), ("skew", ids_z, tw_z))
+    res = {}
+    for label, ids, tw_in in routings:
+        ids_buf, tw_buf = ids.clone(), tw_in.to(torch.float32).clone()
+
+        def rega_fn():
+            return _rg_graph_fn(state, (x, ids_buf, tw_buf))
+
+        def marlin_fn():
+            local_ids, tw, align = _expert_dispatch(ids_buf, tw_buf, 0, tokens, state)
+            return _experts(x, None, None, state, dispatch=(local_ids, tw, align))
+
+        local_ids, _, _ = _expert_dispatch(ids_buf, tw_buf, 0, tokens, state)
+        n_local = int((local_ids >= 0).sum())
+        (t_new, t_old), base = _cb_time([rega_fn, marlin_fn], device)
+        res[label] = (t_new, t_old, n_local, base)
+        _rg_say(f"  select {name} T={tokens} {label}: {n_local} local routes: rega {t_new:.1f} us vs Marlin {t_old:.1f} us "
+                f"(cold graph replay, {CB_FLUSH_BYTES >> 20} MB flush, {CB_REPS} interleaved reps, baseline {base:.1f} us "
+                f"subtracted), rega/Marlin {t_new / t_old:.3f}, need <= {RG_RATIO}")
+        del ids_buf, tw_buf
+    win = all(res[k][0] <= RG_RATIO * res[k][1] for k in res)
+    out = (win, res)
+    _RG_SELECT[tokens] = out
+    return out
+
