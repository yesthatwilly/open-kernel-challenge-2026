+
+def _slide_rms(x):
+    return x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + RMS_EPS)
+
+
+def _slide_rope(x, pos, inv_freq):
+    """Interleaved RoPE of x [..., heads, 64] at pos [...] (fp32 angle), as the reference."""
+    ang = pos.float()[..., None] * inv_freq
+    cos, sin = ang.cos().unsqueeze(-2), ang.sin().unsqueeze(-2)
+    even, odd = x[..., 0::2], x[..., 1::2]
+    return torch.stack([even * cos - odd * sin, even * sin + odd * cos], -1).flatten(-2)
+
+
+def _slide_synthetic(lens, kv_scale, gen, device):
+    """Synthetic gated-shape sliding decode inputs (tp8, page 1, window 2048), never judge data:
+    scattered cache rows (request 0's new row is slot 0), a bf16 qkv [B, 2304], and per request a
+    key aligned with its query planted at the window's oldest position (inside) and just outside
+    it, as reference.generate_input's dist="edges" does."""
+    batch, hq, hkv, d, window = len(lens), 16, 2, 64, 2048
+    max_pages = max(lens) + 1 + 29
+    total = batch * max_pages
+    perm = torch.randperm(total, generator=gen, device=device).to(torch.int32)
+    zero_at = int((perm == 0).nonzero()[0, 0])
+    perm[[zero_at, lens[0]]] = perm[[lens[0], zero_at]]  # request 0's new token lands in slot 0
+    page_table = torch.full((batch, max_pages), -1, dtype=torch.int32, device=device)
+    off = 0
+    for b, n in enumerate(lens):
+        page_table[b, :n + 1] = perm[off:off + n + 1]
+        off += n + 1
+    seq = torch.tensor(lens, dtype=torch.int64, device=device)
+    k_cache = (torch.randn((total, 1, hkv, d), generator=gen, device=device) / kv_scale).clamp(-448, 448).to(FP8)
+    v_cache = (torch.randn((total, 1, hkv, d), generator=gen, device=device) / kv_scale).clamp(-448, 448).to(FP8)
+    qkv = (2 * torch.randn((batch, (2 * hq + 2 * hkv) * d), generator=gen, device=device)).to(torch.bfloat16)
+    qn = _slide_rope(_slide_rms(qkv[:, :hq * d].float().view(batch, hq, d)), seq, _inv_freq(ROPE_THETA, d, device))
+    planted = (qn[:, ::hq // hkv] / kv_scale).clamp(-448, 448).to(FP8)  # [B, Hkv, 64]
+    k_flat = k_cache.view(-1, hkv, d)
+    for b, p in enumerate(lens):
+        for t in (p - window + 1, p - window):
+            if 0 <= t < p:
+                k_flat[page_table[b, t].long()] = planted[b]
+    cache_loc = torch.gather(page_table.long(), 1, seq.view(batch, 1)).reshape(-1)
+    return {
+        "positions": seq.clone(),
+        "cache_loc": cache_loc,
+        "cache_seqlens": (seq + 1).to(torch.int32),
+        "cu_seqlens_q": torch.arange(0, batch + 1, dtype=torch.int32, device=device),
+        "scheduler_metadata": None,
+        "k_cache": k_cache,
+        "v_cache": v_cache,
+        "k_scale": torch.tensor(kv_scale, dtype=torch.float32, device=device),
+        "v_scale": torch.tensor(kv_scale, dtype=torch.float32, device=device),
+        "page_table": page_table,
+        "seq_lens": seq.to(torch.int32),
+        "config": {"batch": batch, "q_len": 1, "tokens": batch, "num_q_heads": hq, "num_kv_heads": hkv,
+                   "head_dim": d, "page_size": 1, "window": window, "rope_theta": ROPE_THETA,
+                   "qk_scale_factor": 5.4730064863875, "sm_scale": d ** -0.5, "kv_scale": kv_scale},
+    }, qkv
+
+
+def _slide_clone(data):
+    """The same step on cloned caches (every path stores its new rows in place)."""
+    out = dict(data)
+    out["k_cache"], out["v_cache"] = data["k_cache"].clone(), data["v_cache"].clone()
+    return out
+
+
+def _slide_reference(data, qkv, lens, k_cache, v_cache, scale_first):
+    """FP32 windowed attention over the cache as a path left it (its new rows included), then
+    rmsnorm x sigmoid(gate). scale_first rounds q * qk_scale_factor to E4M3 (the cluster kernel's
+    query), otherwise q stays fp32 (calibrates every path's own FP8/bf16 query error)."""
+    cfg = data["config"]
+    batch, hq, hkv, d, window = cfg["batch"], cfg["num_q_heads"], cfg["num_kv_heads"], cfg["head_dim"], cfg["window"]
+    qf = qkv.float()
+    q = _slide_rope(_slide_rms(qf[:, :hq * d].reshape(batch, hq, d)), data["positions"],
+                    _inv_freq(cfg["rope_theta"], d, qf.device)) * cfg["qk_scale_factor"]
+    if scale_first:
+        q = q.to(FP8).float()
+    kf, vf = k_cache.view(-1, hkv, d), v_cache.view(-1, hkv, d)
+    out = torch.empty((batch, hq, d), device=qf.device)
+    for b, n in enumerate(lens):
+        rows = data["page_table"][b, :n + 1].long()
+        keys = (kf[rows].float() * data["k_scale"]).repeat_interleave(hq // hkv, dim=1)
+        vals = (vf[rows].float() * data["v_scale"]).repeat_interleave(hq // hkv, dim=1)
+        s0 = max(0, n - window + 1)
+        att = torch.einsum("hd,thd->ht", q[b], keys[s0:n + 1]) * cfg["sm_scale"]
+        out[b] = torch.einsum("ht,thd->hd", att.softmax(-1), vals[s0:n + 1])
+    gate = qf[:, (hq + 2 * hkv) * d:].reshape(batch, hq, d)
+    return (_slide_rms(out) * torch.sigmoid(gate)).reshape(batch, hq * d)
+
+
+def _slide_run(name, fn, batch):
+    """An announced, synchronized launch (prepare only), so a fault names its kernel."""
+    print(f"{SLIDE_TAG} launching {name} B={batch} ...", flush=True)
+    out = fn()
+    torch.cuda.synchronize()
+    print(f"{SLIDE_TAG} {name} B={batch} ok", flush=True)
+    return out
+
+
+def _slide_rel(a, b):
+    return float((a.float() - b.float()).norm() / b.float().norm().clamp_min(1e-30))
+
+
+def _slide_cache_ok(mine, master, loc, exact):
+    """New rows (at cache_loc) of a path vs master's, and nothing else written. v rows must be byte
+    exact (a bf16 / 2^-n division is exact); k rows may differ by one E4M3 code in a few percent of
+    bytes (master rounds through bf16 first, the kernels from fp32). Returns (ok, note)."""
+    a = mine.view(torch.uint8).view(-1, 128)
+    m = master.view(torch.uint8).view(-1, 128)
+    af, mf = a[loc].view(FP8).float(), m[loc].view(FP8).float()
+    mism = float((a[loc] != m[loc]).float().mean())
+    within = bool(((af - mf).abs() <= 0.126 * mf.abs() + 2.0 ** -9).all())
+    a[loc] = m[loc]
+    rest = bool(torch.equal(a, m))
+    ok = rest and within and (mism == 0.0 if exact else mism < 0.06)
+    return ok, f"byte mismatch {mism:.4f}, within one code {within}, other rows untouched {rest}"
+
+
+def _slide_canary(device) -> bool:
+    """A tiny synthetic first launch of the cluster kernel (B=1, 40 keys, slot 0 as the new row)."""
+    try:
+        gen = torch.Generator(device=device).manual_seed(97)
+        data, qkv = _slide_synthetic([40], 1.0, gen, device)
+        out = _slide_run("sliding_cluster_kernel canary", lambda: _slide_launch(data, qkv), 1)
+        ok = bool(torch.isfinite(out).all())
+        print(f"{SLIDE_TAG} canary: output finite {ok}", flush=True)
+        return ok
+    except Exception as e:
+        print(f"{SLIDE_TAG} canary raised: {e!r}", flush=True)
+        return False
+
+
+_SLIDE_LENS17 = [2049, 17, 3000, 2048, 2047, 10, 5000, 2046, 1, 600, 2055, 129, 4096, 2000, 33, 2050, 2051]
+_SLIDE_CASES = (  # (lens, kv_scale): below, at and past the window; batches 17 and 32
+    (_SLIDE_LENS17, 0.25),
+    (_SLIDE_LENS17 + [n + 7 for n in _SLIDE_LENS17[:15]], 1.0),
+    ([2300 + 61 * i for i in range(32)], 0.25),
+)
