+def _slide_select(state, device, candidates):
+    """Time the WHOLE master chain and each candidate as a CUDA graph at B=32, the L2 flushed by a
+    320 MB write before every replay, interleaved. Returns (medians in us by name, or None)."""
+    lens = [3000 + 97 * i for i in range(32)]  # every window full, as the scored decode_32
+    gen = torch.Generator(device=device).manual_seed(777)
+    data, qkv = _slide_synthetic(lens, 1.0, gen, device)
+    fns = {"master": lambda: _master_attn(data, state, qkv)}
+    if "cluster" in candidates:
+        fns["cluster"] = lambda: _slide_launch(data, qkv)
+    if "triton16" in candidates:
+        fns["triton16"] = lambda: _sliding_forward(data, qkv, splits=SLIDE_SPLITS)
+    flush = torch.empty(SLIDE_FLUSH_BYTES, dtype=torch.uint8, device=device)
+    graphs = {}
+    for name, fn in fns.items():
+        _slide_run(f"timing warm-up {name}", fn, 32)
+        graph = torch.cuda.CUDAGraph()
+        print(f"{SLIDE_TAG} capturing {name} ...", flush=True)
+        with torch.cuda.graph(graph):
+            fn()
+        torch.cuda.synchronize()
+        print(f"{SLIDE_TAG} captured {name} ok", flush=True)
+        graphs[name] = graph
+    events = []
+    print(f"{SLIDE_TAG} timing {', '.join(graphs)} (graph replays, L2 flushed each) ...", flush=True)
+    for rep in range(SLIDE_TIME_REPS + 5):
+        for name, graph in graphs.items():
+            flush.zero_()
+            start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            start.record()
+            graph.replay()
+            end.record()
+            if rep >= 5:
+                events.append((name, start, end))
+    torch.cuda.synchronize()
+    print(f"{SLIDE_TAG} timing done", flush=True)
+    times = {name: [] for name in graphs}
+    for name, start, end in events:
+        times[name].append(1000.0 * start.elapsed_time(end))
+    return {name: sorted(v)[len(v) // 2] for name, v in times.items()}
