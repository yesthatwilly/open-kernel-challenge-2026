+            and cfg["rope_theta"] != 0 and SLIDE_B_LO <= cfg["batch"] <= SLIDE_B_HI
+            and cfg["num_q_heads"] == 16 and cfg["num_kv_heads"] == 2 and cfg["head_dim"] == 64
+            and cfg["page_size"] == 1)
