+def _slide_self_check(state, device, do_cluster, do_triton):
+    """Eager check on synthetic data only, never in the timed path: master's own chain (_master_attn)
+    against the fp32 reference, then each candidate against the fp32 reference (own query rounding
+    and unrounded, calibrated against master's own error) and against master's new cache rows, and
+    one graph capture + replay of the cluster launch. Returns (cluster_ok, triton_ok)."""
+    gen = torch.Generator(device=device).manual_seed(4321)
+    c_ok, t_ok = do_cluster, do_triton
+    try:
+        data = None
+        for lens, kv_scale in _SLIDE_CASES:
+            data, qkv = _slide_synthetic(lens, kv_scale, gen, device)
+            batch = len(lens)
+            d_m, d_c, d_t = _slide_clone(data), _slide_clone(data), _slide_clone(data)
+            o_m = _slide_run("master chain (FusedQKNorm .. FusedRMSNormGate)",
+                             lambda: _master_attn(d_m, state, qkv).float(), batch)
+            ref_none = _slide_reference(data, qkv, lens, d_m["k_cache"], d_m["v_cache"], False)
+            err_m = _slide_rel(o_m, ref_none)
+            note = f"{SLIDE_TAG} self-check B={batch} kv_scale={kv_scale:g}: master rel L2 {err_m:.2e}"
+            loc = data["cache_loc"]
+            if do_cluster and c_ok:
+                o_c = _slide_run("sliding_cluster_kernel", lambda: _slide_launch(d_c, qkv).float(), batch)
+                ref_own = _slide_reference(data, qkv, lens, d_c["k_cache"], d_c["v_cache"], True)
+                e_own = _slide_rel(o_c, ref_own)
+                e_none = _slide_rel(o_c, ref_none)
+                kok, knote = _slide_cache_ok(d_c["k_cache"], d_m["k_cache"], loc, False)
+                vok, vnote = _slide_cache_ok(d_c["v_cache"], d_m["v_cache"], loc, True)
+                ok = (bool(torch.isfinite(o_c).all()) and e_own < 2e-2 and e_none <= 2.5 * err_m + 5e-3
+                      and kok and vok)
+                note += (f"; cluster own-rounding rel L2 {e_own:.2e}, vs fp32 {e_none:.2e}, k [{knote}], "
+                         f"v [{vnote}] -> {'ok' if ok else 'FAIL'}")
+                c_ok = c_ok and ok
+            if do_triton and t_ok:
+                o_t = _slide_run(f"_sliding_fused_kernel splits={SLIDE_SPLITS}",
+                                 lambda: _sliding_forward(d_t, qkv, splits=SLIDE_SPLITS).float(), batch)
+                e_t = _slide_rel(o_t, ref_none)
+                kok, knote = _slide_cache_ok(d_t["k_cache"], d_m["k_cache"], loc, False)
+                vok, vnote = _slide_cache_ok(d_t["v_cache"], d_m["v_cache"], loc, True)
+                ok = bool(torch.isfinite(o_t).all()) and e_t < 2e-2 and kok and vok
+                note += f"; triton16 vs fp32 {e_t:.2e}, k [{knote}], v [{vnote}] -> {'ok' if ok else 'FAIL'}"
+                t_ok = t_ok and ok
+            print(note, flush=True)
+        if do_cluster and c_ok:
+            # The judge replays kernel_fn as a CUDA graph: capture the cluster launch once.
+            d_g = _slide_clone(data)
+            eager = _slide_run("sliding_cluster_kernel graph-eager", lambda: _slide_launch(d_g, qkv), len(_SLIDE_CASES[-1][0]))
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                static = _slide_launch(d_g, qkv)
+            print(f"{SLIDE_TAG} replaying the captured sliding_cluster_kernel graph ...", flush=True)
+            graph.replay()
+            torch.cuda.synchronize()
+            same = bool(torch.equal(static, eager))
+            print(f"{SLIDE_TAG} graph capture + replay {'matches eager' if same else 'DIFFERS'}", flush=True)
+            c_ok = c_ok and same
+            del graph
+    except Exception as e:
+        print(f"{SLIDE_TAG} self-check raised: {e!r}", flush=True)
+        return False, False
+    return c_ok, t_ok
