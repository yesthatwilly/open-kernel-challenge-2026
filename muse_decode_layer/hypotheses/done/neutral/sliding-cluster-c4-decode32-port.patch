+def _build_slide():
+    """Compile the sliding cluster module once per process, at import (never during capture), for
+    sm_90a only (TORCH_CUDA_ARCH_LIST=9.0a, restored afterwards); -std=c++20 because the flags are
+    overridden. None keeps master on the whole band."""
