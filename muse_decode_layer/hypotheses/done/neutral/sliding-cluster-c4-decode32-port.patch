+def _slide_launch(data: Inputs, qkv: torch.Tensor) -> torch.Tensor:
+    """One launch of sliding_cluster_kernel (C = 4) on the qkv GEMM output [B, 2304]; returns the
+    normed-and-gated [B, 1024] bf16 input of the o GEMM. No sync, no query, no timing."""
+    cfg = data["config"]
+    batch, hq, d = cfg["batch"], cfg["num_q_heads"], cfg["head_dim"]
+    out = torch.empty((batch, hq * d), dtype=torch.bfloat16, device=qkv.device)
+    _SLIDE_EXT.slide_attn(
+        qkv, data["positions"], data["cache_loc"], data["seq_lens"], data["page_table"],
+        _inv_freq(cfg["rope_theta"], d, qkv.device), data["k_scale"], data["v_scale"],
+        data["k_cache"], data["v_cache"], out,
+        SLIDE_C, cfg["window"], cfg["qk_scale_factor"], cfg["sm_scale"] * LOG2E, RMS_EPS)
+    return out
