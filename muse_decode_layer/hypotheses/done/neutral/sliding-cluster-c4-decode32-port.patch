+                print(f"{SLIDE_TAG} PATH CHOSEN: sliding decode batch {SLIDE_B_LO}..{SLIDE_B_HI}: {best} "
+                      f"(medians at B=32, L2 flushed: {line})", flush=True)
+            else:
+                print(f"{SLIDE_TAG} PATH CHOSEN: sliding decode batch {SLIDE_B_LO}..{SLIDE_B_HI}: master chain "
+                      f"(fallback: no candidate faster; medians at B=32, L2 flushed: {line})", flush=True)
+    except Exception as e:
