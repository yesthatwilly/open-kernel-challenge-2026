+@triton.jit
+def _gpu_fence(x):
+    """fence.acq_rel.gpu executed by every thread holding an element of x (int32)."""
+    return tl.inline_asm_elementwise("fence.acq_rel.gpu;\n\tmov.b32 $0, $1;", "=r,r", [x],
+                                     dtype=tl.int32, is_pure=False, pack=1)
