+@triton.jit
+def _pair_pad_q_kernel(
+    q_ptr, out_ptr, q_stride_t, q_stride_h,
+    HQ: tl.constexpr, D: tl.constexpr, G: tl.constexpr,
+):
+    """Paired-path FA3 query, one program per (token, query head): reads head h's D values of
+    FusedQKNorm's q through its strides, rounds them to FP8 E4M3 and writes them into the half
+    (h // G) % 2 of the [tokens, HQ, 2*D] FP8 query (its KV head's half of the paired 128-byte
+    row), and D FP8 zeros into the other half, so every byte of the buffer is written each call."""
+    t = tl.program_id(0)
+    h = tl.program_id(1)
+    j = tl.arange(0, D)
+    half = (h // G) % 2
+    x = tl.load(q_ptr + t.to(tl.int64) * q_stride_t + h * q_stride_h + j).to(tl.float32)
+    qrow = out_ptr + (t.to(tl.int64) * HQ + h) * (2 * D)
+    tl.store(qrow + half * D + j, x.to(tl.float8e4nv))
+    tl.store(qrow + (1 - half) * D + j, tl.zeros([D], dtype=tl.float32).to(tl.float8e4nv))
+
+
+@triton.jit
+def _paired_norm_gate_kernel(
+    attn_ptr, qkv_ptr, out_ptr,
+    attn_stride_t, attn_stride_h, qkv_stride,
+    HQ: tl.constexpr, HKV: tl.constexpr, D: tl.constexpr, G: tl.constexpr, EPS: tl.constexpr,
+):
+    """Full-layer epilogue for the paired path, one program per (token, query head): reads head
+    h's own half (h // G) % 2 of FA3's [tokens, HQ, 2*D] output (the other half is the other KV
+    head's P@V and is never read), applies the scaleless RMSNorm (eps inside the sqrt of the mean
+    of D squares, fp32) times sigmoid(gate) and stores bf16 into the [tokens, HQ*D] output."""
+    t = tl.program_id(0)
+    h = tl.program_id(1)
+    j = tl.arange(0, D)
+    half = (h // G) % 2
+    src = attn_ptr + t.to(tl.int64) * attn_stride_t + h * attn_stride_h + half * D
+    x = tl.load(src + j).to(tl.float32)
+    r = 1.0 / tl.sqrt(tl.sum(x * x, axis=0) / D + EPS)
+    gate = tl.load(qkv_ptr + t.to(tl.int64) * qkv_stride + (HQ + 2 * HKV) * D + h * D + j)
+    gate = gate.to(tl.float32)
+    y = x * r * tl.sigmoid(gate)
+    tl.store(out_ptr + (t.to(tl.int64) * HQ + h) * D + j, y.to(tl.bfloat16))
+
+
