+          slo += __ldcg(ws + ((int64_t)p * MAXT + t) * ROWS + rlo);
+        }
+        logits[t * 256 + expert] = shi + slo;
+      }
+    }
+    if (tid == 0) atomicExch(cnt + ntile, 0);
+  }
+}
