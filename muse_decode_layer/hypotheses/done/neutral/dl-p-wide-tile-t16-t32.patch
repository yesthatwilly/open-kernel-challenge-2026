+      for (int e = tid; e < m * WN; e += WTHREADS) {
+        const int t = e / WN, r = n0 + (e % WN);
+        float s = 0.f;
+#pragma unroll
+        for (int p = 0; p < WSPLIT; ++p) s += __ldcg(ws + ((int64_t)p * MAXT + t) * ROWS + r);
+        ei[(int64_t)t * POOL_ROWS + r] = __float2bfloat16_rn(s);
+      }
+    } else {
+      // Router tile: local rows 4 x [hi 16 | lo 16] = experts 64*(ntile - 32) + 0..63.
+      for (int e = tid; e < m * 64; e += WTHREADS) {
