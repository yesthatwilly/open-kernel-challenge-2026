+constexpr int WSPLIT = 6;
+constexpr int WNTILES = ROWS / WN;                // 36
+constexpr int WTHREADS = 256;
+constexpr int WROW_BYTES = WK * 2;                // 128 B = 8 chunks of 16 B
+constexpr int WW_STAGE = WN * WROW_BYTES;         // 16384
+template <int NF> struct WSmem {
+  static constexpr int X_STAGE = NF * 8 * WROW_BYTES;          // 2048 / 4096
+  static constexpr int STAGE_BYTES = WW_STAGE + X_STAGE;
+  static constexpr int BYTES = STAGES * STAGE_BYTES;           // 73728 / 81920
+};
+
+template <int NF>
+__global__ void __launch_bounds__(WTHREADS, 2)
+dl_pooler_router_wide_kernel(const __nv_bfloat16* __restrict__ x, const __nv_bfloat16* __restrict__ w,
+                             __nv_bfloat16* __restrict__ ei, float* __restrict__ logits,
+                             float* __restrict__ ws, int* __restrict__ cnt, int m) {
+  using S = WSmem<NF>;
+  extern __shared__ __align__(128) uint8_t smem[];
+  __shared__ int s_last;
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  const int ntile = blockIdx.x / WSPLIT, sidx = blockIdx.x % WSPLIT;
+  const int n0 = ntile * WN;
+  const int kb0 = sidx * WKB / WSPLIT, kb1 = (sidx + 1) * WKB / WSPLIT;
+  const int nsteps = kb1 - kb0;
+  const __nv_bfloat16* wbase = w + (int64_t)n0 * KDIM;
+
+  // Weight part of stage j: 128 rows x 8 chunks = 4 per thread.
+  auto issue_w = [&](int j) {
+    uint8_t* sw = smem + (j % STAGES) * S::STAGE_BYTES;
+    const int kel = (kb0 + j) * WK;
+#pragma unroll
+    for (int u = 0; u < (WN * 8) / WTHREADS; ++u) {
+      const int q = tid + u * WTHREADS;
+      const int row = q >> 3, c = q & 7;
+      cp_async16(smem_u32(sw + row * WROW_BYTES + ((c ^ (row & 7)) << 4)),
+                 wbase + (int64_t)row * KDIM + kel + c * 8, 16);
+    }
+  };
+  // Token part of stage j: 8 * NF rows x 8 chunks (NF * 64 chunks); rows >= m zero-filled.
+  auto issue_x = [&](int j) {
+    uint8_t* sx = smem + (j % STAGES) * S::STAGE_BYTES + WW_STAGE;
+    const int kel = (kb0 + j) * WK;
+#pragma unroll
+    for (int u = 0; u < (NF * 64 + WTHREADS - 1) / WTHREADS; ++u) {
+      const int q = tid + u * WTHREADS;
+      if (q < NF * 64) {
+        const int row = q >> 3, c = q & 7;
+        const bool ok = row < m;
+        const __nv_bfloat16* src = x + (ok ? (int64_t)row * KDIM : (int64_t)0) + kel + c * 8;
+        cp_async16(smem_u32(sx + row * WROW_BYTES + ((c ^ (row & 7)) << 4)), src, ok ? 16 : 0);
+      }
+    }
+  };
+
+  // Prologue as kernel P: weight copies of stages 0..2 before the PDL wait, x after it.
+#pragma unroll
+  for (int j = 0; j < STAGES - 1; ++j)
+    if (j < nsteps) issue_w(j);
+  griddep_wait();
+#pragma unroll
+  for (int j = 0; j < STAGES - 1; ++j) {
+    if (j < nsteps) issue_x(j);
+    cp_commit();
+  }
+
+  float acc[2][NF][4];
+#pragma unroll
+  for (int h = 0; h < 2; ++h)
+#pragma unroll
+    for (int f = 0; f < NF; ++f)
+#pragma unroll
+      for (int r = 0; r < 4; ++r) acc[h][f][r] = 0.f;
+  const int arow = warp * 16 + (lane & 15);
+  const int asw = arow & 7;
+  const int ahalf = lane >> 4;
+  const int xrow = lane & 7;
+  const int xq = lane >> 3;
+
+  for (int i = 0; i < nsteps; ++i) {
+    cp_wait<STAGES - 2>();
+    __syncthreads();
+    {
+      const int nx = i + STAGES - 1;
+      if (nx < nsteps) { issue_w(nx); issue_x(nx); }
+      cp_commit();
+    }
+    const uint8_t* sw = smem + (i % STAGES) * S::STAGE_BYTES;
+    const uint32_t a_base = smem_u32(sw) + arow * WROW_BYTES;
+    const uint32_t b_base = smem_u32(sw + WW_STAGE) + xrow * WROW_BYTES;
+#pragma unroll
+    for (int kp = 0; kp < WK / 32; ++kp) {
+      uint32_t a0[4], a1[4];
+      ldsm_x4(a0, a_base + ((((kp * 2 + 0) * 2 + ahalf) ^ asw) << 4));
+      ldsm_x4(a1, a_base + ((((kp * 2 + 1) * 2 + ahalf) ^ asw) << 4));
+#pragma unroll
+      for (int f = 0; f < NF; ++f) {
+        uint32_t b[4];
+        ldsm_x4(b, b_base + f * 8 * WROW_BYTES + (((kp * 4 + xq) ^ xrow) << 4));
+        mma_bf16(acc[0][f], a0, b[0], b[1]);
+        mma_bf16(acc[1][f], a1, b[2], b[3]);
+      }
+    }
+  }
