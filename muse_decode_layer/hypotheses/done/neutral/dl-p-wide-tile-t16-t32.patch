+template <typename F>
+int64_t kernel_info(F kernel, int threads, size_t smem, int64_t what) {
+  cudaFuncAttributes a;
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&a, kernel));
+  if (what == 0) return a.numRegs;
+  if (what == 1) return static_cast<int64_t>(a.localSizeBytes);
+  if (what == 3) return static_cast<int64_t>(a.sharedSizeBytes + smem);
+  int blocks = 0;
+  C10_CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocks, kernel, threads, smem));
+  return blocks;
+}
