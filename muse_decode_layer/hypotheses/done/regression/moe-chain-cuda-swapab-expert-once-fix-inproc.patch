+void lt_canary(int64_t which, torch::Tensor a, torch::Tensor b, torch::Tensor c, torch::Tensor out) {
+  TORCH_CHECK(a.is_cuda() && b.is_cuda() && c.is_cuda() && out.is_cuda(), "lt_canary: device");
+  TORCH_CHECK(a.is_contiguous() && b.is_contiguous() && c.is_contiguous() && out.is_contiguous(), "lt_canary: layout");
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const int64_t na = a.numel() * a.element_size(), nb = b.numel() * b.element_size();
+  const int64_t nc = c.numel() * c.element_size(), no = out.numel() * out.element_size();
+  if (which == 3) {
+    TORCH_CHECK(no >= 8, "lt_canary: probe out");
+    lt_arch_probe<<<1, 32, 0, stream>>>(reinterpret_cast<int*>(out.data_ptr()));
+  } else if (which == 4) {
+    const int n = static_cast<int>(na / 4);
+    TORCH_CHECK(n >= 1 && no >= 8 * n, "lt_canary: cvt sizes");
+    lt_canary_cvt<<<(n + 255) / 256, 256, 0, stream>>>(reinterpret_cast<const uint32_t*>(a.data_ptr()),
