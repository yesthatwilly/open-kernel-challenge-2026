+// kv head g = w % 2 and the 16 query rows (w / 2) * 16 .. +16 of that head's 64 (row r = token
+// 2 * (w / 2) + r / 8, query head g * 8 + r % 8) over the WHOLE 64-token tile, so the warps own
+// disjoint rows and nothing is merged inside the CTA: each warp stores its rows' partial itself.
+__global__ void __launch_bounds__(THREADS, 2)
+splitkv_attn_verify_kernel(const uint8_t* __restrict__ q,          // e4m3 [B * 8, HQ, D]
+                           const uint8_t* __restrict__ kc,         // e4m3 [rows, ROW]
+                           const uint8_t* __restrict__ vc,         // e4m3 [rows, ROW]
