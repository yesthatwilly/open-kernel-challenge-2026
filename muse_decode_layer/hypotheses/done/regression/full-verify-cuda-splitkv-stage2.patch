+          const int p = pbase + nb * 8 + e;
+          xa[nb * 2 + e] = p < vis_a ? s[nb][e] * scale : NEG_INF;
+          xb[nb * 2 + e] = p < vis_b ? s[nb][2 + e] * scale : NEG_INF;
+        }
+      }
+      float mxa = fmaxf(fmaxf(fmaxf(xa[0], xa[1]), fmaxf(xa[2], xa[3])), fmaxf(fmaxf(xa[4], xa[5]), fmaxf(xa[6], xa[7])));
+      float mxb = fmaxf(fmaxf(fmaxf(xb[0], xb[1]), fmaxf(xb[2], xb[3])), fmaxf(fmaxf(xb[4], xb[5]), fmaxf(xb[6], xb[7])));
+      mxa = fmaxf(mxa, __shfl_xor_sync(0xffffffffu, mxa, 1));
+      mxa = fmaxf(mxa, __shfl_xor_sync(0xffffffffu, mxa, 2));
+      mxb = fmaxf(mxb, __shfl_xor_sync(0xffffffffu, mxb, 1));
+      mxb = fmaxf(mxb, __shfl_xor_sync(0xffffffffu, mxb, 2));
+      const float mna = fmaxf(m_a, mxa), mnb = fmaxf(m_b, mxb);
+      const float mua = mna == NEG_INF ? 0.f : mna, mub = mnb == NEG_INF ? 0.f : mnb;
+      const float alpha_a = ex2(m_a - mua), alpha_b = ex2(m_b - mub);
+      float sa = 0.f, sb = 0.f;
+#pragma unroll
+      for (int j = 0; j < 8; ++j) {
+        xa[j] = ex2(xa[j] - mua);
+        xb[j] = ex2(xb[j] - mub);
+        sa += xa[j];
+        sb += xb[j];
+      }
+      l_a = l_a * alpha_a + sa;  // this lane's columns; quad-reduced at item end
+      l_b = l_b * alpha_b + sb;
