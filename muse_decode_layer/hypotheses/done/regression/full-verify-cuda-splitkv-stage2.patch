+// Grid (B * 8, HQ), one warp per (token, head): LSE merge of the request's partials, x v_scale,
+// scaleless RMSNorm (eps inside the sqrt), x sigmoid(gate of qkv row b * 8 + i), bf16 out [B * 8, HQ, D].
+__global__ void __launch_bounds__(32)
+splitkv_combine_verify_kernel(const float* __restrict__ ws_acc, const float* __restrict__ ws_ml,
+                              const int* __restrict__ seqlens, const float* __restrict__ v_scale,
+                              const __nv_bfloat16* __restrict__ qkv, int64_t qkv_stride,
+                              __nv_bfloat16* __restrict__ out, int max_chunks, float eps) {
+  const float NEG_INF = __int_as_float(0xff800000u);
+  const int row = blockIdx.x, h = blockIdx.y;
+  const int b = row / VTOK, i = row % VTOK;
+  const int lane = threadIdx.x;
+  const int n = (seqlens[b] + CHUNK - 1) / CHUNK;
+  const int64_t base = (int64_t)b * max_chunks;
+  const int mlo = i * HQ + h;
+
+  float M = NEG_INF;
+  for (int c = lane; c < n; c += 32) M = fmaxf(M, ws_ml[(base + c) * 2 * VTOK * HQ + mlo]);
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1) M = fmaxf(M, __shfl_xor_sync(0xffffffffu, M, o));
+  const float Mu = M == NEG_INF ? 0.f : M;
+
+  float a0 = 0.f, a1 = 0.f, L = 0.f;
+#pragma unroll 4
+  for (int c = 0; c < n; ++c) {
+    const int64_t sl = base + c;
+    const float m = ws_ml[sl * 2 * VTOK * HQ + mlo];
+    const float wt = m == NEG_INF ? 0.f : ex2(m - Mu);  // empty / fully masked partials weigh 0
+    L += wt * ws_ml[sl * 2 * VTOK * HQ + VTOK * HQ + mlo];
+    const float2 a = *reinterpret_cast<const float2*>(ws_acc + ((sl * VTOK + i) * HQ + h) * D + lane * 2);
+    a0 += wt * a.x;
+    a1 += wt * a.y;
+  }
+  const float vs = __ldg(v_scale);
+  a0 = a0 / L * vs;
+  a1 = a1 / L * vs;
+  float ss = a0 * a0 + a1 * a1;
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+  const float r = 1.f / sqrtf(ss / D + eps);
+  const __nv_bfloat16* gp = qkv + (int64_t)row * qkv_stride + (HQ + 2 * HKV) * D + h * D + lane * 2;
+  const float g0 = __bfloat162float(gp[0]), g1 = __bfloat162float(gp[1]);
+  const float y0 = a0 * r / (1.f + expf(-g0));
+  const float y1 = a1 * r / (1.f + expf(-g1));
+  *reinterpret_cast<__nv_bfloat162*>(out + ((int64_t)row * HQ + h) * D + lane * 2) = __floats2bfloat162_rn(y0, y1);
+}
