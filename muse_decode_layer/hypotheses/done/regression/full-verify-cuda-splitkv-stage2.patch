+#pragma unroll
+      for (int j = 0; j < 2; ++j) {
+        const uint32_t pa0 = pack_f16x2(xa[4 * j], xa[4 * j + 1]);
+        const uint32_t pa1 = pack_f16x2(xb[4 * j], xb[4 * j + 1]);
