+// ---- Verify blocks (q_len 8, causal inside the block): kernel A-verify and its combine. ----
+constexpr int VTOK = 8;                                      // query tokens per request
+constexpr int VQ_BYTES = VTOK * HQ * D;                      // e4m3 [8][HQ][D] = 8 KB per item
+constexpr int VQ_OFF = IDX_OFF + 2 * CHUNK * 4;              // e4m3 [2][8][HQ][D]
+constexpr int VSEQ_OFF = VQ_OFF + 2 * VQ_BYTES;              // int32 [MAXB]
