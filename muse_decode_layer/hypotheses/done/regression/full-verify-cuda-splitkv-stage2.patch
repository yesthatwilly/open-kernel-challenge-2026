+  extern __shared__ __align__(128) uint8_t smem[];
+  uint8_t* ring = smem + RING_OFF;
+  int* idx_s = reinterpret_cast<int*>(smem + IDX_OFF);
+  uint8_t* q_s = smem + VQ_OFF;
+  int* seq_s = reinterpret_cast<int*>(smem + VSEQ_OFF);
+  int* pre_s = reinterpret_cast<int*>(smem + VPRE_OFF);
+  const float NEG_INF = __int_as_float(0xff800000u);
+
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  const int bx = blockIdx.x, gx = gridDim.x;
+  if (tid < B) seq_s[tid] = seqlens[tid];
+  __syncthreads();
+  if (tid == 0) {
+    int run = 0;
+    pre_s[0] = 0;
+    for (int b = 0; b < B; ++b) {
+      run += (seq_s[b] + CHUNK - 1) / CHUNK;
+      pre_s[b + 1] = run;
+    }
+  }
+  __syncthreads();
+  const int total = pre_s[B];
