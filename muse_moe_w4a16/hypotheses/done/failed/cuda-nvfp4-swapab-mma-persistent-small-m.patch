+std::vector<int64_t> w4a16_init() {
+  std::vector<int64_t> r;
+  info_one<1, true>(r);
+  info_one<2, true>(r);
+  info_one<4, true>(r);
+  info_one<1, false>(r);
+  info_one<2, false>(r);
+  info_one<4, false>(r);
+  return r;
+}
+
+void w4a16_gemm(torch::Tensor wq, torch::Tensor wsf, torch::Tensor gs, torch::Tensor act, int64_t a_shift,
+                torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+                int64_t num_routes, int64_t n_tiles, int64_t K, int64_t nt, int64_t sk, int64_t gated,
+                int64_t blocks_cap, torch::Tensor ws, torch::Tensor tickets, torch::Tensor out, int64_t grid) {
+  TORCH_CHECK(wq.is_contiguous() && wsf.is_contiguous() && gs.is_contiguous() && act.is_contiguous() &&
+              sorted_ids.is_contiguous() && block_experts.is_contiguous() && out.is_contiguous(), "w4a16: layout");
+  TORCH_CHECK(act.scalar_type() == at::kBFloat16 && out.scalar_type() == at::kBFloat16 &&
+              gs.scalar_type() == at::kFloat && sorted_ids.scalar_type() == at::kInt &&
+              block_experts.scalar_type() == at::kInt && n_padded.scalar_type() == at::kInt &&
+              ws.scalar_type() == at::kFloat && tickets.scalar_type() == at::kInt, "w4a16: dtype");
+  TORCH_CHECK(K % (BK * sk) == 0 && act.size(-1) == K, "w4a16: K");
+  TORCH_CHECK(nt == 1 || nt == 2 || nt == 4, "w4a16: nt");
+  TORCH_CHECK(tickets.numel() >= blocks_cap * n_tiles, "w4a16: tickets");
+  TORCH_CHECK(sk == 1 || ws.numel() >= blocks_cap * n_tiles * sk * THREADS * nt * 4, "w4a16: workspace");
+  TORCH_CHECK(wq.numel() >= (int64_t)gs.numel() * n_tiles * (K / BK) * W_BYTES, "w4a16: weights");
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const int out_ld = static_cast<int>(out.size(1));
+#define W4A16_LAUNCH(NT_, G_)                                                                           \
+  w4a16_kernel<NT_, G_><<<static_cast<unsigned>(grid), THREADS, Cfg<NT_>::SMEM, stream>>>(            \
+      wq.data_ptr<uint8_t>(), wsf.data_ptr<uint8_t>(), gs.data_ptr<float>(),                          \
+      reinterpret_cast<const __nv_bfloat16*>(act.data_ptr()), static_cast<int>(a_shift),               \
+      sorted_ids.data_ptr<int>(), block_experts.data_ptr<int>(), n_padded.data_ptr<int>(),             \
+      static_cast<int>(num_routes), static_cast<int>(n_tiles), static_cast<int>(K), static_cast<int>(sk), \
+      static_cast<int>(blocks_cap), ws.data_ptr<float>(), tickets.data_ptr<int>(),                     \
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), out_ld)
+  if (gated) {
+    if (nt == 1) W4A16_LAUNCH(1, true); else if (nt == 2) W4A16_LAUNCH(2, true); else W4A16_LAUNCH(4, true);
+  } else {
+    if (nt == 1) W4A16_LAUNCH(1, false); else if (nt == 2) W4A16_LAUNCH(2, false); else W4A16_LAUNCH(4, false);
+  }
+#undef W4A16_LAUNCH
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+"""
+
+
+def _cuda_nt(num_tokens):
+    """n8 fragments per m-block: 1 for M <= 8, 2 for M <= 16, 4 for M <= 32."""
+    return 1 if num_tokens <= 8 else 2 if num_tokens <= 16 else 4
+
+
+def _cuda_bsm(num_tokens):
+    """The CUDA path's block_size_m (8, 16, 32): one m-block holds all of an expert's routes."""
+    return 8 * _cuda_nt(num_tokens)
+
+
+def _build_cuda():
+    """Compile the CUDA module once (prepare only, never during capture); None on failure."""
+    t0 = time.perf_counter()
+    try:
+        from torch.utils.cpp_extension import load_inline
+        ext = load_inline(
+            name="muse_moe_w4a16_swapab_v1",
+            cpp_sources=_CUDA_CPP,
+            cuda_sources=_CUDA_SRC,
+            functions=["w4a16_init", "w4a16_gemm"],
+            extra_cuda_cflags=["-O3", "-arch=sm_90a"],
+            verbose=False,
+        )
+    except Exception as e:  # keep the master path if the build fails
+        print(f"{CUDA_TAG} load_inline failed after {time.perf_counter() - t0:.1f}s, Marlin kept: {e!r}")
+        return None
+    print(f"{CUDA_TAG} load_inline compiled in {time.perf_counter() - t0:.1f}s")
+    return ext
+
+
+def _nibbles(packed):
+    """uint8 [..., n] -> uint8 [..., 2n]: element 2i is the low nibble, as nvfp4 packs."""
+    return torch.stack((packed & 0x0F, packed >> 4), dim=-1).flatten(-2)
+
+
+def _pack_nibbles(nib):
+    """Inverse of _nibbles."""
+    nib = nib.reshape(*nib.shape[:-1], -1, 2)
+    return nib[..., 0] | (nib[..., 1] << 4)
+
+
+def _code_dims(rows, k, gated):
+    """Source view and permutation for one expert's [rows, k] nibbles. Source dims: rh (gate/up
+    half, w13) or rh (row half of the warp's 16, w2), j (N-tile), w (warp), g (lane / 4), kb
+    (256-k stage), kk (64-k sub-tile), s (k16 step), kh (k 8-15 half), t (lane % 4), kl (k
+    parity). Target: j kb w kk g t s kl kh rh, then kh and rh are reversed, so the nibble index
+    in the lane's word is 4 kl + 2 (1 - kh) + (1 - rh): register pair i = rh + 2 kh at nibbles
+    3 - i (kl = 0) and 7 - i (kl = 1)."""
+    kb = k // 256
+    if gated:  # row = rh * I + 64 j + 8 w + g
+        return (2, rows // 128, 8, 8, kb, 4, 4, 2, 4, 2), (1, 4, 2, 5, 3, 8, 6, 9, 7, 0)
+    # row = 128 j + 16 w + 8 rh + g
+    return (rows // 128, 8, 2, 8, kb, 4, 4, 2, 4, 2), (0, 4, 1, 5, 3, 8, 6, 9, 7, 2)
+
+
+def _scale_dims(rows, kg, gated):
+    """Source view and permutation for one expert's [rows, k / 16] scale bytes. Target: j kb w kk
+    g s rh, i.e. per lane group g 8 bytes, byte 2 s + rh = row g + 8 rh at k16 step s."""
+    kb = kg // 16
+    if gated:
+        return (2, rows // 128, 8, 8, kb, 4, 4), (1, 4, 2, 5, 3, 6, 0)
+    return (rows // 128, 8, 2, 8, kb, 4, 4), (0, 4, 1, 5, 3, 6, 2)
+
+
+def _inverse(perm):
+    inv = [0] * len(perm)
+    for i, p in enumerate(perm):
+        inv[p] = i
+    return inv
+
+
+def _tile_codes(packed, gated):
+    """One expert's uint8 [rows, k / 2] E2M1 codes -> the kernel's tiled bytes (flat, same bytes
+    count), asserting the inverse retiling gives the source bytes back exactly."""
+    rows, k = packed.shape[0], packed.shape[1] * 2
+    shape, perm = _code_dims(rows, k, gated)
+    tiled = _pack_nibbles(_nibbles(packed).view(shape).permute(perm).flip(-1, -2).reshape(-1, 8)).reshape(-1)
+    back = _nibbles(tiled).view([shape[p] for p in perm]).flip(-1, -2).permute(_inverse(perm)).reshape(rows, k)
+    assert torch.equal(_pack_nibbles(back), packed), "code retiling is not lossless"
+    return tiled
+
+
+def _tile_scales(sf, gated):
+    """One expert's float8_e4m3fn [rows, k / 16] -> the kernel's tiled scale bytes (flat uint8),
+    asserting the round trip."""
+    rows, kg = sf.shape
+    src = sf.contiguous().view(torch.uint8)
+    shape, perm = _scale_dims(rows, kg, gated)
+    tiled = src.view(shape).permute(perm).reshape(-1)
+    back = tiled.view([shape[p] for p in perm]).permute(_inverse(perm)).reshape(rows, kg)
+    assert torch.equal(back, src), "scale retiling is not lossless"
+    return tiled
+
+
+def _cuda_bank(weights, start, count):
+    """The CUDA path's lossless retiling of experts [start, start + count): codes and E4M3 scales
+    stay NVFP4 bytes, global scales stay fp32 with the dequant bias 2^7 folded in (exact)."""
+    w13, w2 = weights["w13"], weights["w2"]
+    q13 = torch.empty((count, w13[0].numel()), dtype=torch.uint8, device=w13.device)
+    s13 = torch.empty((count, weights["w13_sf"][0].numel()), dtype=torch.uint8, device=w13.device)
+    q2 = torch.empty((count, w2[0].numel()), dtype=torch.uint8, device=w2.device)
+    s2 = torch.empty((count, weights["w2_sf"][0].numel()), dtype=torch.uint8, device=w2.device)
+    for i in range(count):
+        e = start + i
+        q13[i] = _tile_codes(w13[e].contiguous(), True)
+        s13[i] = _tile_scales(weights["w13_sf"][e], True)
+        q2[i] = _tile_codes(w2[e].contiguous(), False)
+        s2[i] = _tile_scales(weights["w2_sf"][e], False)
+    sl = slice(start, start + count)
+    return {
+        "q13": q13, "s13": s13, "gs13": (weights["w13_gs"][sl].float() * 128.0).contiguous(),
+        "q2": q2, "s2": s2, "gs2": (weights["w2_gs"][sl].float() * 128.0).contiguous(),
+    }
+
+
+def _decode_nvfp4(packed, sf, gs):
+    """fp32 dequant of one expert, written locally (E2M1 grid x E4M3 block scale x global)."""
+    nib = _nibbles(packed).long()
+    grid = torch.tensor(_E2M1_GRID, dtype=torch.float32, device=packed.device)
+    mag = grid[nib & 7]
+    val = torch.where((nib & 8) != 0, -mag, mag)
+    rows, k = val.shape
+    return (val.view(rows, k // 16, 16) * (sf.float() * gs.float()).unsqueeze(-1)).view(rows, k)
+
+
+def _row_rel(a, b):
+    """Max over rows of |a - b| / |b| (rows of b that are 0 must match exactly)."""
+    a, b = a.float().reshape(-1, a.shape[-1]), b.float().reshape(-1, b.shape[-1])
+    if a.shape[0] == 0:
+        return 0.0
+    d = (a - b).norm(dim=-1)
+    r = b.norm(dim=-1)
+    rel = torch.where(r > 0, d / r.clamp_min(1e-30), torch.where(d > 0, torch.full_like(d, float("inf")), d))
+    return float(rel.max())
+
+
+def _cuda_self_check(weights, bank, state, device):
+    """Untimed, prepare() only, synthetic inputs (fixed seed): the CUDA path against master's
+    Marlin path for M in 1..32 over every NT class (cache2 and y per local route, out per row),
+    plus one expert against a local fp32 dequant. Returns (ok, max rel-L2)."""
+    gen = torch.Generator().manual_seed(20261025)
+    start, count = bank["start"], bank["count"]
+    hidden = weights["w2"].shape[1]
+    local_set = list(range(start, start + count))
+    remote_set = [e for e in range(N_EXPERTS) if e not in local_set]
+    worst = 0.0
+    ok = True
+    for tokens in (1, 2, 4, 8, 12, 16, 24, 32):
+        cases = {
+            "random": [torch.randperm(N_EXPERTS, generator=gen)[:TOP_K].tolist() for _ in range(tokens)],
+            "skewed": [[local_set[0], local_set[count - 1], local_set[5]] +
+                       [remote_set[i] for i in torch.randperm(len(remote_set), generator=gen)[:5].tolist()]
+                       for _ in range(tokens)],
+            "all-one-expert": [[local_set[3]] + remote_set[7 * t % 200: 7 * t % 200 + 7] for t in range(tokens)],
+            "all-remote": [[remote_set[i] for i in torch.randperm(len(remote_set), generator=gen)[:TOP_K].tolist()]
+                           for _ in range(tokens)],
+            "all-local": [local_set[8:16] for _ in range(tokens)],
+        }
+        m_worst = 0.0
+        for name, ids in cases.items():
+            topk_ids = torch.tensor(ids, dtype=torch.int32, device=device)
+            x = torch.randn((tokens, hidden), generator=gen).to(torch.bfloat16).to(device)
+            tw = torch.rand((tokens, TOP_K), generator=gen)
+            tw = (tw / tw.sum(-1, keepdim=True)).to(device)
+            r_out, r_local, r_c2, r_y = _moe(x, topk_ids, tw, bank, state, False)
+            n_out, n_local, n_c2, n_y = _moe(x, topk_ids, tw, bank, state, True)
+            torch.cuda.synchronize()
+            local = r_local.reshape(-1) >= 0
+            errs = (_row_rel(n_c2[local], r_c2[local]),
+                    _row_rel(n_y.reshape(-1, hidden)[local], r_y.reshape(-1, hidden)[local]),
+                    _row_rel(n_out, r_out))
+            finite = bool(torch.isfinite(n_out).all())
+            same_ids = torch.equal(n_local, r_local)
+            err = max(errs)
+            m_worst = max(m_worst, err)
+            if not (finite and same_ids and err <= 1e-2):
+                ok = False
+                print(f"{CUDA_TAG}   FAIL M={tokens} {name}: cache2 {errs[0]:.2e} y {errs[1]:.2e} "
+                      f"out {errs[2]:.2e} finite {finite} local_ids equal {same_ids}")
+            if name == "all-one-expert" and tokens in (1, 8, 16, 32):
+                # One expert against a local fp32 dequant (catches an error Marlin would share).
+                e = local_set[3]
+                routes = (n_local.reshape(-1) == 3).nonzero().flatten()
+                w13f = _decode_nvfp4(weights["w13"][e], weights["w13_sf"][e], weights["w13_gs"][e])
+                h = x[routes // TOP_K].float() @ w13f.T
+                inter = torch.nn.functional.silu(h[:, :bank["size_n"]]) * h[:, bank["size_n"]:]
+                del w13f
+                w2f = _decode_nvfp4(weights["w2"][e], weights["w2_sf"][e], weights["w2_gs"][e])
+                y_ref = n_c2[routes].float() @ w2f.T
+                del w2f
+                f_errs = (_row_rel(n_c2[routes], inter), _row_rel(n_y.reshape(-1, hidden)[routes], y_ref))
+                print(f"{CUDA_TAG}   fp32-dequant M={tokens} expert {e}: {routes.numel()} routes, "
+                      f"cache2 {f_errs[0]:.2e} y {f_errs[1]:.2e}")
+                m_worst = max(m_worst, *f_errs)
+                if max(f_errs) > 1e-2:
+                    ok = False
+        print(f"{CUDA_TAG}   self-check M={tokens} (NT={_cuda_nt(tokens)} BSM={_cuda_bsm(tokens)}): "
+              f"max per-row rel-L2 vs Marlin {m_worst:.2e}")
+        worst = max(worst, m_worst)
+    return ok, worst
+
+
+def _cuda_setup(weights, banks, state, device):
+    """Build, retile, warm and self-check the CUDA path. Sets state['cuda_ok']; on any failure
+    every M keeps master's Marlin path. Nothing here sees any input."""
+    state["cuda_ok"] = False
