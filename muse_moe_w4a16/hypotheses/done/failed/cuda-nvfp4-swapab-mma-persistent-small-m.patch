+            print(f"{CUDA_TAG} kernel {'w13+silu' if gated else 'w2'} NT={nt}: attrs ok {bool(a_ok)}, "
+                  f"numRegs {regs}, localSizeBytes {local_bytes}"
+                  f"{' (SPILL, not fatal)' if local_bytes > 0 else ''}, dynamic smem {smem} B")
+            attrs_ok = attrs_ok and bool(a_ok)
+        if not attrs_ok:
+            raise RuntimeError("cudaFuncSetAttribute / cudaFuncGetAttributes failed")
+        t0 = time.perf_counter()
+        state["cuda_banks"] = {(start, count): _cuda_bank(weights, start, count)}
+        torch.cuda.synchronize()
+        print(f"{CUDA_TAG} retiled {count} experts losslessly (round trips exact) in {time.perf_counter() - t0:.1f}s")
+        n_tiles13, n_tiles2 = bank["size_n"] // 64, weights["w2"].shape[1] // 128
+        state["cuda_ext"] = ext
+        state["cuda_grid"] = torch.cuda.get_device_properties(device).multi_processor_count
+        ws_floats = max(count * n * sk * CUDA_THREADS * nt * 4
+                        for n, table in ((n_tiles13, CUDA_SK13), (n_tiles2, CUDA_SK2)) for nt, sk in table.items())
+        state["cuda_ws"] = torch.empty((ws_floats,), dtype=torch.float32, device=device)
+        # Separate tickets for the w13 and w2 launches; zero between launches (the last arriver resets).
+        state["cuda_tk13"] = torch.zeros((count * n_tiles13,), dtype=torch.int32, device=device)
+        state["cuda_tk2"] = torch.zeros((count * n_tiles2,), dtype=torch.int32, device=device)
+        print(f"{CUDA_TAG} grid {state['cuda_grid']}, SK w13 {CUDA_SK13}, SK w2 {CUDA_SK2}, "
+              f"workspace {ws_floats * 4 / 2**20:.0f} MiB")
+        ok, worst = _cuda_self_check(weights, bank, state, device)
+        torch.cuda.synchronize()
+        tickets_zero = int(torch.count_nonzero(state["cuda_tk13"])) == 0 and \
+            int(torch.count_nonzero(state["cuda_tk2"])) == 0
+        if not tickets_zero:
+            print(f"{CUDA_TAG} tickets not back to 0 after the self-check")
+            ok = False
+        print(f"{CUDA_TAG} SELF-CHECK {'PASSED' if ok else 'FAILED'}: max rel-L2 {worst:.3e} "
+              f"(bound 1e-2), tickets zero {tickets_zero}")
+    except Exception as e:
+        print(f"{CUDA_TAG} CUDA path setup raised: {e!r}")
+        ok = False
+    state["cuda_ok"] = ok
+    print(f"{CUDA_TAG} PATH CHOSEN = {'CUDA' if ok else 'MARLIN'} for num_tokens <= {CUDA_MAX_TOKENS}; "
+          f"MARLIN above")
 
 
