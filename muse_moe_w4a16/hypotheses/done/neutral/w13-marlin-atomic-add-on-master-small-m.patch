+# Hypothesis w13-marlin-atomic-add-on-master-small-m: up to this many tokens the w13 Marlin call may
+# use use_atomic_add=True (use_fp32_reduce stays True); prepare()'s self-check picks the mode per T band.
+W13_ATOMIC_MAX_TOKENS = 32
+W13_POISON = 3.0e4
+# Pre-flight audit: 5e-3 is about the noise floor here. Landed w2 atomic alone is 4.79e-3 vs non-atomic, and
+# the w13 delta changes w2's input by ~1 bf16 ulp, which decorrelates w2's atomic rounding between ref and
+# candidate, so a correct candidate can read 6-8e-3 at T=1. A missing zero or a wrong write reads >> 1e-1.
+# Candidate vs FP32 stays well inside the judge's 1.5%.
+W13_ATOMIC_TOL = 1e-2
+W13_CHECK_TOKENS = (1, 4, 8, 16, 32)
+
+
+def _w13_band(tokens):
+    """The self-check T each token count is served by (None above W13_ATOMIC_MAX_TOKENS)."""
+    for t in W13_CHECK_TOKENS:
+        if tokens <= t:
+            return t
+    return None
+
+
+def _rel_l2(a, b):
+    return ((a.float() - b.float()).norm() / b.float().norm().clamp_min(1e-12)).item()
+
+
+def _synthetic_decode_data(bank, gen, device, tokens, pool=None):
+    ids = torch.randint(0, N_EXPERTS, (tokens, TOP_K), generator=gen, device=device, dtype=torch.int32)
+    lo = bank["start"]
+    hi = bank["start"] + (bank["count"] if pool is None else pool)
+    ids[:, :3] = torch.randint(lo, hi, (tokens, 3), generator=gen, device=device, dtype=torch.int32)
+    return {
+        "hidden_states": torch.randn((tokens, 4096), generator=gen, device=device, dtype=torch.bfloat16),
+        "topk_ids": ids,
+        "topk_weights": torch.rand((tokens, TOP_K), generator=gen, device=device, dtype=torch.float32),
+        "config": {"bs": tokens, "d_hidden": 4096, "d_expert": 4096, "n_experts": N_EXPERTS,
+                   "local_start": bank["start"], "local_count": bank["count"], "top_k": TOP_K,
+                   "sharding": "ep8"},
+    }
+
