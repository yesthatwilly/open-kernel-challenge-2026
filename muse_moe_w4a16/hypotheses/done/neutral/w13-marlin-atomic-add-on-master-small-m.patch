+def _marlin_exec_config_probe(state, device):
+    tag = "[marlin-exec-probe]"
+    t0 = time.perf_counter()
+    try:
+        print(tag, "module", getattr(moe_wna16_marlin_gemm, "__module__", "?"),
+              "signature", inspect.signature(moe_wna16_marlin_gemm), flush=True)
+    except Exception as e:
+        print(tag, "signature unavailable: %s: %s" % (type(e).__name__, str(e)[:150]), flush=True)
+    doc = getattr(moe_wna16_marlin_gemm, "__doc__", None)
+    print(tag, "__doc__:", (doc or "none")[:600].replace("\n", " "), flush=True)
+    bank = state["banks"][(0, 32)]
+    ws = state["workspace"]
+    w2_mode = state.get("w2_mode", "master")
+    flush_buf = torch.empty(PROBE_FLUSH_BYTES, dtype=torch.uint8, device=device)
+    configs = [("binding-default", {})]
+    for tk, tn in ((-1, -1), (128, 128), (64, 256), (128, 64)):
+        for bpsm in (-1, 1, 2):
+            configs.append(("tk%d_tn%d_b%d" % (tk, tn, bpsm),
+                            dict(thread_k=tk, thread_n=tn, blocks_per_sm=bpsm)))
+    gen = torch.Generator(device=device)
+    gen.manual_seed(777)
+    seen_err = {}
+    for kernel in ("w13", "w2"):
+        for tokens in (8, 16, 32):
+            for seed_i, pool in enumerate((10, 13)):
+                if time.perf_counter() - t0 > PROBE_BUDGET_S:
+                    print(tag, "time budget reached, table truncated", flush=True)
+                    return _probe_cleanup(flush_buf)
+                data = _synthetic_decode_data(bank, gen, device, tokens, pool)
+                bsm = _block_size_m(tokens, bank["count"])
+                _, (sorted_ids, block_experts, n_padded) = _align_small(
+                    data["topk_ids"], bank["start"], bank["count"], bsm)
+                tw = data["topk_weights"]
+                base = dict(moe_block_size=bsm, mul_topk_weights=False, is_ep=True,
+                            b_q_type=scalar_types.float4_e2m1f, is_k_full=True, use_atomic_add=False,
+                            use_fp32_reduce=True, is_zp_float=False)
+                if kernel == "w13":
+                    a = data["hidden_states"]
+                    out = torch.zeros((tokens * TOP_K, 2 * bank["size_n"]), device=device, dtype=torch.bfloat16)
+                    args = (a, out, bank["w13"], None, bank["w13_s"], bank["w13_gs"], None, None, None, ws,
+                            sorted_ids, block_experts, n_padded, tw)
+                    kw0 = dict(base, top_k=TOP_K, size_m=tokens, size_n=2 * bank["size_n"], size_k=4096)
+                    pre = None
+                else:
+                    a = (torch.randn((tokens * TOP_K, bank["size_n"]), generator=gen, device=device,
+                                     dtype=torch.bfloat16) * 0.5)
+                    out = torch.zeros((tokens * TOP_K, 4096), device=device, dtype=torch.bfloat16)
+                    args = (a, out, bank["w2"], None, bank["w2_s"], bank["w2_gs"], None, None, None, ws,
+                            sorted_ids, block_experts, n_padded, tw)
+                    kw0 = dict(base, top_k=1, size_m=tokens * TOP_K, size_n=4096, size_k=bank["size_n"])
+                    pre = None
+                    if w2_mode != "master":  # master's own w2 mode
+                        kw0["use_atomic_add"] = True
+                        pre = out.zero_ if w2_mode == "atomic_zero" else None
+
+                def run(kw, args=args, kw0=kw0, pre=pre):
+                    if pre is not None:
+                        pre()
+                    return moe_wna16_marlin_gemm(*args, **dict(kw0, **kw))
+
+                graphs, rels, ref_out = {}, {}, None
+                for name, kw in configs:
+                    try:
+                        res = run(kw)
+                        torch.cuda.synchronize()
+                        cur = res.clone()
+                        if ref_out is None:
+                            ref_out = cur
+                        rels[name] = _rel_l2(cur, ref_out)
+                        g = torch.cuda.CUDAGraph()
+                        with torch.cuda.graph(g):
+                            run(kw)
+                        graphs[name] = g
+                    except Exception as e:
+                        msg = "%s: %s" % (type(e).__name__, str(e).strip().split("\n")[0][:140])
+                        if seen_err.get(name) != msg:
+                            seen_err[name] = msg
+                            print(tag, "config %s REJECTED: %s" % (name, msg), flush=True)
+                        # A device-side fault (not an argument check) or a capture left open: stop the probe
+                        # at once rather than launch more; the routing state is unaffected.
+                        low = str(e).lower()
+                        if torch.cuda.is_current_stream_capturing() or "illegal" in low or "misaligned" in low \
+                                or "unspecified launch" in low or "device-side" in low:
+                            print(tag, "ABORT: device fault or open capture after config %s" % name, flush=True)
+                            return _probe_cleanup(flush_buf)
+                if "binding-default" not in graphs:
+                    print(tag, "%s T=%d: no default graph, skipping" % (kernel, tokens), flush=True)
+                    continue
+                evs = {n: [] for n in graphs}
+                for _ in range(PROBE_REPS):
+                    for n, g in graphs.items():
+                        flush_buf.zero_()
+                        s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                        s.record()
+                        g.replay()
+                        e.record()
+                        evs[n].append((s, e))
+                torch.cuda.synchronize()
+                med = {n: sorted(s.elapsed_time(e) for s, e in v)[len(v) // 2] * 1000.0 for n, v in evs.items()}
+                base_us = med["binding-default"]
+                rows = sorted(med.items(), key=lambda kv: kv[1])
+                print(tag, "%s T=%d bsm=%d routing%d (pool %d experts, cold L2 %d MB, %d reps, w2_mode=%s): %s"
+                      % (kernel, tokens, bsm, seed_i, pool, PROBE_FLUSH_BYTES >> 20, PROBE_REPS, w2_mode,
+                         "; ".join("%s %.1fus x%.3f rel%.1e" % (n, us, us / base_us, rels.get(n, 0.0))
+                                   for n, us in rows)), flush=True)
+                del graphs
+    print(tag, "done in %.1f s; accepted kwargs configs: %s"
+          % (time.perf_counter() - t0, sorted(set(n for n, _ in configs) - set(seen_err))), flush=True)
+    _probe_cleanup(flush_buf)
+
+
+def _probe_cleanup(flush_buf):
+    del flush_buf
+    torch.cuda.synchronize()
+    torch.cuda.empty_cache()
