+def _print_slice_estimate(state, device, gen):
+    """Print-only. Marlin's real thread_k/thread_n and grid are not readable here, so these are
+    ESTIMATES assuming a 128x128 tile, 4 CTAs/SM (the workspace's max_blocks_per_sm) and an even
+    stripe of (m-block, n-tile, k-tile) work over the grid; m-blocks come from the real align."""
+    bank = state["banks"][(0, 32)]
+    sms = torch.cuda.get_device_properties(device).multi_processor_count
+    grid = sms * 4
+    for tokens in (1, 8):
+        data = _synthetic_decode_data(bank, gen, device, tokens)
+        bsm = _block_size_m(tokens, bank["count"])
+        _, (_, _, n_padded) = _align_small(data["topk_ids"], bank["start"], bank["count"], bsm)
+        torch.cuda.synchronize()
+        m_blocks = max(1, int(n_padded.item()) // bsm)
+        for name, n, k in (("w13", 2 * bank["size_n"], 4096), ("w2", 4096, bank["size_n"])):
+            n_tiles, k_tiles = n // 128, k // 128
+            per_cta = -(-(m_blocks * n_tiles * k_tiles) // grid)
+            slices = max(1, -(-k_tiles // max(per_cta, 1)))
+            print("[w13-atomic] slice estimate T=%d %s: block_size_m=%d n_padded/bsm=%d m_blocks=%d n_tiles=%d "
+                  "k_tiles=%d grid~%d work/CTA~%d k-tiles => split-K slices ~%d (ESTIMATE, 128x128 tile)"
+                  % (tokens, name, bsm, int(n_padded.item()), m_blocks, n_tiles, k_tiles, grid, per_cta, slices),
+                  flush=True)
