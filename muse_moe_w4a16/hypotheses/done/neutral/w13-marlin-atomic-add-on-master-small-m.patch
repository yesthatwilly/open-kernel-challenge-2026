+# Print-only probe (hypothesis marlin-exec-config-autotune-mid-m): does the binding take
+# thread_k / thread_n / blocks_per_sm, and what does each config time at T=8/16/32? Affects nothing.
+PROBE_BUDGET_S = 13.0
+PROBE_REPS = 15
+PROBE_FLUSH_BYTES = 320 * 2**20
