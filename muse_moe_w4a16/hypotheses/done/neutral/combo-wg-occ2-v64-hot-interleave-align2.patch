+            lines = [f"{COMBO_TAG} phase {name} raised {type(e).__name__}: {str(e)[:240]}: its flags stay master"]
+        for ln in lines:
+            print(ln, flush=True)
+        out.extend(lines)
+        secs.append(f"{name} {time.perf_counter() - t0:.1f}s")
