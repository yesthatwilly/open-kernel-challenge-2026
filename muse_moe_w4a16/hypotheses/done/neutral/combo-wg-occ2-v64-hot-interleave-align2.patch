+    if time.perf_counter() - t_prepare > COMBO_C2_SELECT_DEADLINE_S:
+        return lines + [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (deadline: selector past "
+                        f"{COMBO_C2_SELECT_DEADLINE_S:.0f}s)"]
