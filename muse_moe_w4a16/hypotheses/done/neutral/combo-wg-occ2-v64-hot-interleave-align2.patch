+def _f1_ref_fp32(weights, bank, data):
+    """reference.ref_kernel's math, written locally (no reference import): fp32 dequant, fp32 matmuls, the post
+    norm y * (1 + w) * rsqrt(mean(y^2) + eps) per route, weighted sum. fp32 [M, H]."""
+    x = data["hidden_states"].float()
+    ids = data["topk_ids"].long()
+    tw = data["topk_weights"].float()
+    inter = bank["size_n"]
+    lo, hi = bank["start"], bank["start"] + bank["count"]
+    w = weights["post_norm_w"].float()
+    out = torch.zeros(x.shape, dtype=torch.float32, device=x.device)
+    for e in torch.unique(ids).tolist():
+        if not lo <= e < hi:
+            continue
+        tok, slot = (ids == e).nonzero(as_tuple=True)
+        h = x[tok] @ _wg_decode_nvfp4(weights["w13"][e], weights["w13_sf"][e], weights["w13_gs"][e]).T
+        a = torch.nn.functional.silu(h[:, :inter]) * h[:, inter:]
+        y = a @ _wg_decode_nvfp4(weights["w2"][e], weights["w2_sf"][e], weights["w2_gs"][e]).T
+        y = y * (1.0 + w)
+        y = y * torch.rsqrt(y.pow(2).mean(-1, keepdim=True) + POST_NORM_EPS)
+        out.index_add_(0, tok, y * tw[tok, slot].unsqueeze(1))
+    return out
