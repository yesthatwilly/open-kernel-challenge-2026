+template <bool G, int NMAX, int STG, int OCC, int ORD>
+__global__ void __launch_bounds__(THREADS, OCC)
+wg2_kernel(const __grid_constant__ Maps maps,
+           const uint8_t* __restrict__ wbank,        // [E][T][K/64][REC]
+           const float* __restrict__ gs,             // fp32 [E] global scale * 2^7
+           const int* __restrict__ sorted_ids,       // block-16 align of the local ids
+           const int* __restrict__ block_experts,
+           const int* __restrict__ n_padded,
+           int blocks_len, int num_routes, int n_tiles, int K, int n_experts,
+           __nv_bfloat16* __restrict__ out, int out_ld, int* __restrict__ err) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  using Geo = Geo2<NMAX, STG, OCC>;
+  // Launch marker (its own magic, so prepare can tell wg2 from master's kernel); the error word stays err[0].
+  if (blockIdx.x == 0 && threadIdx.x == 0) err[1] = MAGIC2;
+  extern __shared__ __align__(1024) uint8_t smem_raw[];
+  __shared__ __align__(8) uint64_t bars[2 * STG];
+  __shared__ int s_be[MAXB], s_cblk[MAXB], s_cnb[MAXB], s_gf[MAXB], s_gk[MAXB];
+  __shared__ int s_wsum[THREADS / 32];
+  __shared__ int s_nc;
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  const uint32_t raw = smem_u32(smem_raw);
+  uint8_t* smem = smem_raw + ((1024u - (raw & 1023u)) & 1023u);
+  uint8_t* ep = smem + STG * Geo::STAGE_B;
+  const uint32_t full0 = smem_u32(&bars[0]), empty0 = smem_u32(&bars[STG]);
+
+  int nb = __ldg(n_padded) / 16;
+  nb = nb < blocks_len ? nb : blocks_len;
+  nb = nb < MAXB ? nb : MAXB;
+  if (tid < nb) s_be[tid] = __ldg(block_experts + tid);
+  if (tid == 0) {
+#pragma unroll
+    for (int s = 0; s < STG; ++s) {
+      mbar_init(full0 + 8 * s, 1);
+      mbar_init(empty0 + 8 * s, 8);  // one arrive per consumer warp
+    }
+    fence_barrier_init();
+  }
+  __syncthreads();
+
+  // Chunks: a block starts a chunk when its expert is local and it is 0 mod CH into its run.
+  int flag = 0, cn = 0;
+  if (tid < nb) {
+    const int e = s_be[tid];
+    if (e >= 0 && e < n_experts) {
+      int rs = tid;
+      while (rs > 0 && s_be[rs - 1] == e) --rs;
+      if (((tid - rs) & (Geo::CH - 1)) == 0) {
+        flag = 1;
+        cn = 1;
+        while (cn < Geo::CH && tid + cn < nb && s_be[tid + cn] == e) ++cn;
+      }
+    }
+  }
+  const unsigned ball = __ballot_sync(0xffffffffu, flag);
+  if (lane == 0) s_wsum[warp] = __popc(ball);
+  __syncthreads();
+  if (flag) {
+    int off = 0;
+    for (int w = 0; w < warp; ++w) off += s_wsum[w];
+    const int idx = off + __popc(ball & ((1u << lane) - 1u));
+    s_cblk[idx] = tid;
+    s_cnb[idx] = cn;
+  }
+  if (tid == 0) {
+    int t = 0;
+    for (int w = 0; w < THREADS / 32; ++w) t += s_wsum[w];
+    s_nc = t;
+  }
+  __syncthreads();
+  const int nc = s_nc;
+  if (tid < nc) {
+    const int e = s_be[s_cblk[tid]];
+    int f = tid;
+    while (f > 0 && s_be[s_cblk[f - 1]] == e) --f;
+    int k = tid - f + 1;
+    while (f + k < nc && s_be[s_cblk[f + k]] == e) ++k;
+    s_gf[tid] = f;
+    s_gk[tid] = k;
+  }
+  __syncthreads();
+
+  const int total = nc * n_tiles;
+  const int KS = K / BK;
+  bool dead = false;
+  if (warp < 4) {
+    asm volatile("setmaxnreg.dec.sync.aligned.u32 %0;\n" :: "n"(Geo::RDEC) : "memory");
+    if (tid == 0) {
+      const int KC = K / 64;
+      int n = 0;
+      for (int it = blockIdx.x; it < total; it += gridDim.x) {
+        const Item m = decode_item2<ORD>(it, n_tiles, s_be, s_cblk, s_cnb, s_gf, s_gk);
+        // Unreachable (a chunk has <= CH blocks): a table bug sets error word 3 and the item is skipped by the
+        // producer and (switch default below) every consumer alike, so the ring stays in step.
+        if (m.bucket > Geo::BMAX) {
+          atomicExch(err, 3);
+          continue;
+        }
+        const uint8_t* wsrc = wbank + (static_cast<size_t>(m.e) * n_tiles + m.j) * static_cast<size_t>(KC) * REC;
+        const uint64_t map = reinterpret_cast<uint64_t>(&maps.m[m.bucket]);
+        const uint32_t tx = WST + 2 * (16 << m.bucket) * 128;
+        for (int kb = 0; kb < KS; ++kb, ++n) {
+          const int s = n % STG;
+          mbar_wait(empty0 + 8 * s, ((n / STG) & 1) ^ 1, err, dead);
+          const uint32_t st = smem_u32(smem + s * Geo::STAGE_B);
+          const uint32_t fb = full0 + 8 * s;
+          mbar_expect_tx(fb, tx);
+          bulk_g2s(st, wsrc + static_cast<size_t>(kb) * WST, WST, fb);  // weights: constant, no dependency
+          // PDL (master's call sites): the B slab is the predecessor's output; nothing reads it before this wait.
+          if (n == 0) griddep_wait();
+          tma_2d(st + WST, map, kb * BK, m.slot0, fb);
+          tma_2d(st + WST + Geo::SLAB_H, map, kb * BK + 64, m.slot0, fb);
+        }
+      }
+    }
+  } else {
+    asm volatile("setmaxnreg.inc.sync.aligned.u32 %0;\n" :: "n"(Geo::RINC) : "memory");
+    const int ctid = tid - 128, cw = ctid >> 5;
+    int n = 0;
+    // PDL: no consumer global store before the predecessor grid has completed (a no-op without the attribute).
+    griddep_wait();
+    for (int it = blockIdx.x; it < total; it += gridDim.x) {
+      const Item m = decode_item2<ORD>(it, n_tiles, s_be, s_cblk, s_cnb, s_gf, s_gk);
+#define WG2_CONSUME(NB_)                                                                                     \
+  consume_item2<NB_, G, NMAX, STG, OCC>(m, smem, ep, full0, empty0, n, KS, cw, lane, ctid, gs, sorted_ids,     \
+                                        num_routes, out, out_ld, err, dead)
+      // A chunk never carries more than NMAX tokens, so the buckets above NMAX are never instantiated.
+      switch (m.bucket) {
+        case 0: WG2_CONSUME(16); break;
+        case 1: if constexpr (NMAX >= 32) { WG2_CONSUME(32); } break;
+        case 2: if constexpr (NMAX >= 64) { WG2_CONSUME(64); } break;
+        default: if constexpr (NMAX >= 128) { WG2_CONSUME(128); } break;
+      }
+#undef WG2_CONSUME
+    }
+  }
+  // PDL: let the next grid's CTAs take the SMs freed in the tail (every thread executes it or has exited).
+  griddep_launch();
+#else
+  // Not the sm_90a image: no wgmma here. Flag it (error word 2) and do nothing else.
+  if (threadIdx.x == 0) atomicExch(err, 2);
+#endif
+}
+
+typedef CUresult (*EncodeTiledFn)(CUtensorMap*, CUtensorMapDataType, cuuint32_t, void*, const cuuint64_t*,
+                                  const cuuint64_t*, const cuuint32_t*, const cuuint32_t*, CUtensorMapInterleave,
+                                  CUtensorMapSwizzle, CUtensorMapL2promotion, CUtensorMapFloatOOBfill);
+
+EncodeTiledFn get_encode2() {
+  void* fn = nullptr;
+  cudaDriverEntryPointQueryResult q = cudaDriverEntryPointSymbolNotFound;
+#if CUDART_VERSION >= 12050
+  const cudaError_t e = cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &fn, 12000, cudaEnableDefault, &q);
+#else
+  const cudaError_t e = cudaGetDriverEntryPoint("cuTensorMapEncodeTiled", &fn, cudaEnableDefault, &q);
+#endif
+  if (e != cudaSuccess || q != cudaDriverEntryPointSuccess || fn == nullptr) {
+    (void)cudaGetLastError();
+    return nullptr;
+  }
+  return reinterpret_cast<EncodeTiledFn>(fn);
+}
+
+template <bool G, int NMAX, int STG, int OCC, int ORD>
+void info2(std::vector<int64_t>& r, int64_t variant) {
+  const void* fn = reinterpret_cast<const void*>(wg2_kernel<G, NMAX, STG, OCC, ORD>);
+  const int bytes = Smem2<G, NMAX, STG, OCC>::BYTES;
+  const cudaError_t e1 = cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, bytes);
+  cudaFuncAttributes a{};
+  const cudaError_t e2 = cudaFuncGetAttributes(&a, fn);
+  int occ = 0;
+  const cudaError_t e3 = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, fn, THREADS, bytes);
+  if (e1 != cudaSuccess || e2 != cudaSuccess || e3 != cudaSuccess) (void)cudaGetLastError();
+  r.push_back(variant);
+  r.push_back(G ? 1 : 0);
+  r.push_back(e1 == cudaSuccess && e2 == cudaSuccess && e3 == cudaSuccess ? 1 : 0);
+  r.push_back(a.numRegs);
+  r.push_back(static_cast<int64_t>(a.localSizeBytes));
+  r.push_back(static_cast<int64_t>(a.sharedSizeBytes));
+  r.push_back(bytes);
+  r.push_back(occ);
+  r.push_back(static_cast<int64_t>(e1));
+  r.push_back(a.binaryVersion);
+  r.push_back(NMAX * 1000 + STG * 10 + OCC);
+}
+
+}  // namespace
+
+// Per instantiation (11 values each; variant 1 = V64 w13 then w2, variant 2 = V64s w13 then w2): variant, gated,
+// attribute calls ok, numRegs, localSizeBytes, static smem, dynamic smem, CTAs per SM, cudaFuncSetAttribute's rc,
+// binaryVersion, NMAX * 1000 + STG * 10 + OCC. Also sets each one's dynamic smem attribute (needed before launch).
+std::vector<int64_t> wg2_init() {
+  std::vector<int64_t> r;
+  info2<true, 64, 3, 2, 0>(r, 1);
+  info2<false, 64, 3, 2, 0>(r, 1);
+  info2<true, 64, 3, 2, 1>(r, 2);
+  info2<false, 64, 3, 2, 1>(r, 2);
+  return r;
+}
+
+// One wg2 launch, plain or (pdl != 0, the w2 launch only, as master) with programmatic stream serialization.
+template <bool G, int ORD>
+void launch2(const Maps& mp, const torch::Tensor& wbank, const torch::Tensor& gs, const torch::Tensor& sorted_ids,
+             const torch::Tensor& block_experts, const torch::Tensor& n_padded, int blocks_len, int64_t num_routes,
+             int64_t n_tiles, int64_t K, const torch::Tensor& out, int64_t grid, const torch::Tensor& err,
+             int64_t pdl, cudaStream_t stream) {
+  const uint8_t* wb = wbank.data_ptr<uint8_t>();
+  const float* g = gs.data_ptr<float>();
+  const int* si = sorted_ids.data_ptr<int>();
+  const int* be = block_experts.data_ptr<int>();
+  const int* np = n_padded.data_ptr<int>();
+  __nv_bfloat16* o = reinterpret_cast<__nv_bfloat16*>(out.data_ptr());
+  int* e = err.data_ptr<int>();
+  const int nr = static_cast<int>(num_routes), nt = static_cast<int>(n_tiles), kk = static_cast<int>(K);
+  const int ne = static_cast<int>(gs.numel()), ld = static_cast<int>(out.size(1));
+  if (pdl == 0) {
+    wg2_kernel<G, 64, 3, 2, ORD><<<static_cast<unsigned>(grid), THREADS, Smem2<G, 64, 3, 2>::BYTES, stream>>>(
+        mp, wb, g, si, be, np, blocks_len, nr, nt, kk, ne, o, ld, e);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return;
+  }
+  cudaLaunchConfig_t cfg{};
+  cfg.gridDim = dim3(static_cast<unsigned>(grid));
+  cfg.blockDim = dim3(THREADS);
+  cfg.dynamicSmemBytes = Smem2<G, 64, 3, 2>::BYTES;
+  cfg.stream = stream;
+  cudaLaunchAttribute attr[1];
+  attr[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+  attr[0].val.programmaticStreamSerializationAllowed = 1;
+  cfg.attrs = attr;
+  cfg.numAttrs = 1;
+  const cudaError_t le = cudaLaunchKernelEx(&cfg, wg2_kernel<G, 64, 3, 2, ORD>, mp, wb, g, si, be, np, blocks_len,
+                                            nr, nt, kk, ne, o, ld, e);
+  TORCH_CHECK(le == cudaSuccess, "wg2_gemm: PDL launch: ", cudaGetErrorString(le));
+}
+
+void wg2_gemm(int64_t which, int64_t variant, torch::Tensor bsrc, torch::Tensor wbank,
+              torch::Tensor gs, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+              int64_t num_routes, int64_t n_tiles, int64_t K, torch::Tensor out, int64_t grid, torch::Tensor err,
+              int64_t pdl) {
+  TORCH_CHECK(which == 0 || which == 1, "wg2_gemm: which");
+  TORCH_CHECK(variant == 1 || variant == 2, "wg2_gemm: variant");
+  TORCH_CHECK(bsrc.is_cuda() && bsrc.is_contiguous() && bsrc.dim() == 2 && bsrc.scalar_type() == at::kBFloat16 &&
+              bsrc.size(0) > 0 && bsrc.size(1) > 0 && bsrc.size(1) == K,
+              "wg2_gemm: B-source scratch layout (cuda, contiguous, 2-D bf16, width K)");
+  TORCH_CHECK(wbank.is_contiguous() && gs.is_contiguous() && sorted_ids.is_contiguous() &&
+              block_experts.is_contiguous() && out.is_contiguous() && wbank.scalar_type() == at::kByte &&
+              gs.scalar_type() == at::kFloat && sorted_ids.scalar_type() == at::kInt &&
+              block_experts.scalar_type() == at::kInt && n_padded.scalar_type() == at::kInt &&
+              out.scalar_type() == at::kBFloat16 && err.scalar_type() == at::kInt && err.numel() >= 2,
+              "wg2_gemm: layout");
+  TORCH_CHECK(K % BK == 0 && block_experts.numel() <= MAXB && sorted_ids.numel() <= bsrc.size(0), "wg2_gemm: sizes");
+  TORCH_CHECK(wbank.numel() == gs.numel() * n_tiles * (K / 64) * REC, "wg2_gemm: weight bank size");
+  TORCH_CHECK(out.size(1) == (which == 0 ? n_tiles * 64 : n_tiles * 128), "wg2_gemm: output width");
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const int blocks_len = static_cast<int>(block_experts.numel());
+  EncodeTiledFn enc = get_encode2();
+  TORCH_CHECK(enc != nullptr, "wg2_gemm: cuTensorMapEncodeTiled entry point missing");
+  Maps mp;
+  std::memset(&mp, 0, sizeof(Maps));
+  {
+    const cuuint64_t dims[2] = {static_cast<cuuint64_t>(bsrc.size(1)), static_cast<cuuint64_t>(bsrc.size(0))};
+    const cuuint64_t strides[1] = {static_cast<cuuint64_t>(bsrc.size(1)) * 2};
+    const cuuint32_t es[2] = {1, 1};
+    void* base = bsrc.data_ptr();
+    for (int b = 0; b < 4; ++b) {
+      const cuuint32_t box[2] = {64, static_cast<cuuint32_t>(16 << b)};
+      const CUresult rc = enc(&mp.m[b], CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, base, dims, strides, box, es,
+                              CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                              CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+      TORCH_CHECK(rc == CUDA_SUCCESS, "wg2_gemm: tensor map ", b, " rc ", static_cast<int>(rc));
+    }
+  }
+#define WG2_LAUNCH(G_, ORD_) \
+  launch2<G_, ORD_>(mp, wbank, gs, sorted_ids, block_experts, n_padded, blocks_len, num_routes, n_tiles, K, out, grid, \
+                    err, pdl, stream)
+  if (variant == 1) {
+    if (which == 0) WG2_LAUNCH(true, 0); else WG2_LAUNCH(false, 0);
+  } else {
+    if (which == 0) WG2_LAUNCH(true, 1); else WG2_LAUNCH(false, 1);
+  }
+#undef WG2_LAUNCH
+}
+"""
