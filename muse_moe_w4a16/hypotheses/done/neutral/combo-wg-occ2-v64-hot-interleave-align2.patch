+
+def _wg2_src():
+    """The wg2 module's CUDA source: master's wg head (helpers, wgmma wrappers) verbatim + the wg2 body."""
+    return _WG_SRC_HEAD + _wg_wgmma_src() + _WG2_SRC_BODY
+
+
+def _wg2_build(werror):
+    """Compile the wg2 module (prepare only): (ext or None, captured error text, arch flags). sm_90a only
+    (TORCH_CUDA_ARCH_LIST=9.0a around load_inline, restored after), -O3 -lineinfo; werror adds -Xptxas -Werror so
+    any ptxas warning (setmaxnreg's included) fails the build and its text becomes visible in-process."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    flags = list(WG_CUDA_CFLAGS) + (["-Xptxas", "-Werror"] if werror else [])
+    name = WG2_EXT_NAME + ("_werror" if werror else "")
+    ext, err_text, arch_flags = None, "", None
+    try:
+        from torch.utils import cpp_extension
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        try:
+            arch_flags = cpp_extension._get_cuda_arch_flags()
+        except Exception as e:
+            arch_flags = [f"<rejected: {e!r}>"[:120]]
+        print(f"{WG2_TAG} build {name}: TORCH_CUDA_ARCH_LIST='9.0a' -> {arch_flags}; extra_cuda_cflags {flags}",
+              flush=True)
+        ext = load_inline(name=name, cpp_sources=_WG2_CPP, cuda_sources=_wg2_src(), functions=["wg2_init", "wg2_gemm"],
+                          extra_cuda_cflags=flags, verbose=False)
+    except Exception as e:
+        err_text = str(e)
+        ext = None
+        print(f"{WG2_TAG} load_inline {name} failed after {time.perf_counter() - t0:.1f}s: {err_text[:240]!r}",
+              flush=True)
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    if ext is not None:
+        print(f"{WG2_TAG} load_inline {name} compiled in {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext, err_text, arch_flags
+
+
+def _c2_build_phase(weights, state, device, t_prepare, ctx):
+    """C2 build + hang-safety gate, BEFORE any wg2 launch: -Xptxas -Werror build (a ptxas warning that mentions
+    setmaxnreg = C2 OFF; another warning allows one plain rebuild before the deadline), then per instantiation
+    numRegs == 80, localSizeBytes == 0, CTAs/SM >= 2, smem within budget at 2 CTAs/SM, binaryVersion 90, and the
+    static / global audit of the new source. Sets ctx['c2_ok'] {variant: bool} and state['wg2_ext' / 'wg2_grid']."""
+    ctx["c2_ok"] = {1: False, 2: False}
+    if not state.get("wgmma_ok", False):
+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (wgmma path off: C2 not built)"]
+    if time.perf_counter() - t_prepare > COMBO_C2_BUILD_DEADLINE_S:
+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (deadline: build past {COMBO_C2_BUILD_DEADLINE_S:.0f}s)"]
+    findings = _wg_audit_cpp(_WG2_CPP + "\n" + _wg2_src())
+    print(f"{WG2_TAG} static/global audit of the wg2 source: {findings if findings else 'none'}", flush=True)
+    if findings:
+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: audit findings {findings})"[:400]]
+    ext, text, arch = _wg2_build(werror=True)
+    warn_text = "none (the -Werror build passed)"
+    if ext is None:
+        ptx = [ln.strip() for ln in (text or "").splitlines() if "ptxas" in ln]
+        setm = [ln for ln in ptx if "setmaxnreg" in ln]
+        warns = _wg_ptxas_warnings(text)
+        warn_text = f"{len(ptx)} ptxas lines, setmaxnreg lines {len(setm)}: {(setm or warns or ['-'])[0][:200]}"
+        print(f"{WG2_TAG} -Werror build failed: {warn_text}", flush=True)
+        for w in warns:
+            print(f"{WG2_TAG}   ptxas: {w}", flush=True)
+        if setm:
+            return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: setmaxnreg ptxas warning: {setm[0][:200]})"]
+        if time.perf_counter() - t_prepare > COMBO_C2_BUILD_DEADLINE_S + 20.0:
+            return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: -Werror build failed, no time to rebuild)"]
+        ext, text, arch = _wg2_build(werror=False)
+        if ext is None:
+            return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: build failed: {text[:200]!r})"]
+    info = ext.wg2_init()
+    ok = {1: True, 2: True}
+    rows = []
+    for i in range(0, len(info), 11):
+        v, gated, a_ok, regs, local_b, st_smem, dyn, occ, e1, bin_v, geo = info[i:i + 11]
+        fits = WG2_OCC * (st_smem + dyn + 1024) <= WG2_SM_SMEM and st_smem <= WG2_STATIC_BOUND
+        good = bool(a_ok) and regs == WG2_REGS and local_b == 0 and occ >= WG2_OCC and fits and bin_v == 90
+        ok[v] = ok[v] and good
+        row = (f"{WG2_NAMES[v]} {'w13+silu' if gated else 'w2'} wg2_kernel<NMAX,STG,OCC={geo}>: attrs ok {bool(a_ok)} "
+               f"(rc {e1}), numRegs {regs} (need == {WG2_REGS}), localSizeBytes {local_b} (need 0), static smem "
+               f"{st_smem} B, dynamic {dyn} B, 2 CTAs fit {fits}, CTAs/SM {occ} (need >= {WG2_OCC}), binaryVersion "
+               f"{bin_v}: {'ok' if good else 'FAIL'}")
+        rows.append(row)
+        print(f"{WG2_TAG} {row}", flush=True)
+    sm = torch.cuda.get_device_properties(device).multi_processor_count
+    ctx["c2_ok"] = dict(ok)
+    ctx["c2_build"] = (f"arch {arch}; cflags {WG_CUDA_CFLAGS} (+ -Xptxas -Werror first); ptxas warnings: "
+                       f"{warn_text}; " + " | ".join(r.split(":")[0] + (" ok" if r.endswith("ok") else " FAIL")
+                                                     for r in rows))
+    if not ok[1]:
+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: V64 attribute gate failed: hang safety, no "
+                f"wg2 launch ever made)"]
+    state["wg2_ext"] = ext
+    state["wg2_grid"] = WG2_OCC * sm
+    return [f"{WG2_TAG} C2 build ok: V64 attrs pass, V64s attrs {'pass' if ok[2] else 'FAIL (not timed)'}; grid "
+            f"{state['wg2_grid']} = {WG2_OCC} x {sm} SMs"]
+
