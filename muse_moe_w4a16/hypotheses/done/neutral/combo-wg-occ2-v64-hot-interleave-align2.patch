+_WG2_SRC_BODY = r"""
+// ---------------------------------------------------------------------------------------------
+// combo-wg-occ2-v64-hot-interleave-align2 (C2): wg2_kernel<G, NMAX, STG, OCC, ORD>. The helpers above are master's
+// wg module head verbatim (this is a separate extension; master's module stays loaded unchanged). Kernel body =
+// master's s5 wg_kernel with c30fd0cc's <NMAX, STG> ring geometry (chunks cut every NMAX / 16 blocks, buckets
+// above NMAX never instantiated) and dfb755d3's OCC 2 register split: __launch_bounds__(384, 2), 80 registers per
+// thread at launch, producer setmaxnreg.dec 32, consumers setmaxnreg.inc 104 (32 x 128 + 104 x 256 = 80 x 384).
+// ORD 0 = master's item order (chunk-within-expert fastest: V64); ORD 1 = chunk slowest (V64s, print-only).
+// No file-scope or static variable: the encode entry point is resolved per call, the tensor maps are encoded per
+// call from the bsrc passed in THAT call into a stack-local __grid_constant__.
+// ---------------------------------------------------------------------------------------------
+constexpr int MAGIC2 = 0x57473232;
+constexpr int STATIC2 = 8192;  // static smem bound: five int tables [MAXB] + barriers + warp sums
+static_assert(5 * MAXB * 4 + 2 * 8 * 8 + (THREADS / 32) * 4 + 4 <= STATIC2, "static smem tables");
+static_assert(32 * 128 + 104 * 256 == 80 * 384, "setmaxnreg register balance at OCC 2");
+
+template <int NMAX, int STG, int OCC>
+struct Geo2 {
+  static constexpr int SLAB_H = NMAX * 128;          // one SWIZZLE_128B box: NMAX rows x 64 bf16
+  static constexpr int STAGE_B = WST + 2 * SLAB_H;   // weight record pair + two slab halves
+  static constexpr int CH = NMAX / 16;               // blocks of 16 rows per chunk
+  static constexpr int BMAX = NMAX == 32 ? 1 : (NMAX == 64 ? 2 : 3);  // largest token bucket
+  static constexpr int RDEC = OCC == 2 ? 32 : 40;    // producer warpgroup after setmaxnreg.dec
+  static constexpr int RINC = OCC == 2 ? 104 : 232;  // consumer warpgroups after setmaxnreg.inc
+  static constexpr int REGS = OCC == 2 ? 80 : 168;   // registers per thread the split needs at launch
+  static_assert(NMAX == 32 || NMAX == 64 || NMAX == 128, "NMAX in {32, 64, 128}");
+  static_assert(OCC == 1 || OCC == 2, "OCC in {1, 2}");
+  static_assert(STG >= 2, "ring depth");
+  static_assert(SLAB_H % 1024 == 0 && STAGE_B % 1024 == 0, "stage alignment (SWIZZLE_128B boxes)");
+  static_assert(RDEC % 8 == 0 && RINC % 8 == 0 && RDEC >= 24 && RINC <= 256, "setmaxnreg immediates");
+  static_assert(RDEC * 128 + RINC * 256 <= REGS * THREADS, "register pool");
+  static_assert(REGS * THREADS * OCC <= 65536, "register file");
+};
+template <bool G, int NMAX, int STG, int OCC>
+struct Smem2 {
+  static constexpr int EPI = NMAX * (G ? PITCH13 : PITCH2);  // epilogue staging: NMAX token rows
+  static constexpr int BYTES = 1024 + STG * Geo2<NMAX, STG, OCC>::STAGE_B + EPI;
+  static_assert(BYTES + STATIC2 <= 227 * 1024, "shared memory budget per CTA");
+  // OCC CTAs per SM, each with its static tables and the 1 KB per-CTA reserve, in the 228 KB SM
+  static_assert(OCC * (BYTES + STATIC2 + 1024) <= 228 * 1024, "shared memory budget at OCC CTAs per SM");
+};
+static_assert(Smem2<false, 64, 3, 2>::BYTES == 95232, "V64 w2 dynamic smem (spec)");
+static_assert(Smem2<true, 64, 3, 2>::BYTES == 87040, "V64 w13 dynamic smem");
+static_assert(Geo2<64, 3, 2>::RDEC * 128 + Geo2<64, 3, 2>::RINC * 256 == Geo2<64, 3, 2>::REGS * THREADS,
+              "OCC 2 split uses exactly the 80 x 384 pool");
+
+struct Item {
+  int j, e, slot0, nbk, bucket, multi;
+};
+// Item it of the (expert group, ...) order. Expert group = chunks [f, f + k) of one expert, items
+// [f * T, (f + k) * T); it / T always lands inside its own group. ORD 0: (tile, chunk) with the chunk fastest
+// (master's decode_item); ORD 1: (chunk, tile) with the tile fastest (the chunk index slowest).
+template <int ORD>
+__device__ __forceinline__ Item decode_item2(int it, int T, const int* be, const int* cblk, const int* cnb,
+                                             const int* gf, const int* gk) {
+  const int cg = it / T;
+  const int f = gf[cg], k = gk[cg];
+  const int local = it - f * T;
+  const int c = ORD == 0 ? f + local % k : f + local / T;
+  Item m;
+  m.j = ORD == 0 ? local / k : local % T;
+  const int b0 = cblk[c];
+  m.slot0 = b0 * 16;
+  m.nbk = cnb[c];
+  m.e = be[b0];
+  m.bucket = m.nbk <= 1 ? 0 : (m.nbk <= 2 ? 1 : (m.nbk <= 4 ? 2 : 3));
+  m.multi = k > 1 ? 1 : 0;
+  return m;
+}
+
+// Master's dq_stage verbatim.
+__device__ __forceinline__ void dq_stage(const uint8_t* st, int cw, int lane, uint32_t (&a)[8][4]) {
+  const float P119 = __int_as_float(0x7B000000);  // 2^119
+  const int g = lane >> 2;
+#pragma unroll
+  for (int r = 0; r < 2; ++r) {
+    const uint4 q = *reinterpret_cast<const uint4*>(st + r * REC + cw * 512 + lane * 16);
+    const uint2 sc = *reinterpret_cast<const uint2*>(st + r * REC + REC_CODES + cw * 64 + g * 8);
+    uint32_t hs[4];
+    e4m3x4_to_f16x2x2(sc.x, hs[0], hs[1]);
+    e4m3x4_to_f16x2x2(sc.y, hs[2], hs[3]);
+    const uint32_t qw[4] = {q.x, q.y, q.z, q.w};
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+      const float2 fs = __half22float2(*reinterpret_cast<const __half2*>(&hs[k]));
+      dequant8(qw[k], bf16x2_bcast(fs.x * P119), bf16x2_bcast(fs.y * P119), a[r * 4 + k]);
+    }
+  }
+}
+
+// Master's consume_item with the <NMAX, STG> ring geometry (dfb755d3 consume_item_lo).
+template <int NB, bool G, int NMAX, int STG, int OCC>
+__device__ __forceinline__ void consume_item2(const Item& m, uint8_t* smem, uint8_t* ep, uint32_t full0,
+                                              uint32_t empty0, int& n, int KS, int cw, int lane, int ctid,
+                                              const float* __restrict__ gs, const int* __restrict__ sorted_ids,
+                                              int num_routes, __nv_bfloat16* __restrict__ out, int out_ld,
+                                              int* err, bool& dead) {
+  static_assert(NB <= NMAX, "token bucket above the slab");
+  constexpr int NA = NB / 2;
+  constexpr int SLAB_H = Geo2<NMAX, STG, OCC>::SLAB_H;
+  constexpr int STAGE_B = Geo2<NMAX, STG, OCC>::STAGE_B;
+  float acc[NA];
+#pragma unroll
+  for (int i = 0; i < NA; ++i) acc[i] = 0.f;
+  uint32_t a0[8][4];
+  for (int kb = 0; kb < KS; ++kb) {
+    const int s = n % STG;
+    mbar_wait(full0 + 8 * s, (n / STG) & 1, err, dead);
+    const uint8_t* st = smem + s * STAGE_B;
+    dq_stage(st, cw, lane, a0);
+    const uint32_t slab = smem_u32(st + WST);
+    fence_acc<NA>(acc);
+    wgmma_fence();
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+      for (int k = 0; k < 4; ++k) Wg<NB>::mma(acc, a0[r * 4 + k], make_desc(slab + r * SLAB_H + k * 32));
+    }
+    wgmma_commit();
+    wgmma_wait<0>();  // group retired: a0[] may be rewritten and this stage released at once
+    fence_acc<NA>(acc);
+    if (lane == 0) mbar_arrive(empty0 + 8 * s);
+    ++n;
+  }
+  wgmma_wait<0>();
+  fence_acc<NA>(acc);
+
+  const int nvalid = m.nbk * 16;
+  const float gsc = __ldg(gs + m.e);
+  named_bar(1, 256);  // the 256 consumer threads of THIS CTA
+  if (G) {
+#pragma unroll
+    for (int i = 0; i < NB / 8; i += 2) {
+      const uint32_t r0 = pack_bf16(silu_mul(acc[4 * i] * gsc, acc[4 * i + 2] * gsc),
+                                    silu_mul(acc[4 * i + 1] * gsc, acc[4 * i + 3] * gsc));
+      const uint32_t r1 = pack_bf16(silu_mul(acc[4 * i + 4] * gsc, acc[4 * i + 6] * gsc),
+                                    silu_mul(acc[4 * i + 5] * gsc, acc[4 * i + 7] * gsc));
+      const int mi = (lane >> 3) & 1, rr = lane & 7;
+      const int tok = 8 * (i + mi) + rr;
+      stsm_x2_t(smem_u32(ep + tok * PITCH13 + cw * 16), r0, r1);
+    }
+  } else {
+#pragma unroll
+    for (int i = 0; i < NB / 8; i += 2) {
+      const uint32_t r0 = pack_bf16(acc[4 * i] * gsc, acc[4 * i + 1] * gsc);
+      const uint32_t r1 = pack_bf16(acc[4 * i + 2] * gsc, acc[4 * i + 3] * gsc);
+      const uint32_t r2 = pack_bf16(acc[4 * i + 4] * gsc, acc[4 * i + 5] * gsc);
+      const uint32_t r3 = pack_bf16(acc[4 * i + 6] * gsc, acc[4 * i + 7] * gsc);
