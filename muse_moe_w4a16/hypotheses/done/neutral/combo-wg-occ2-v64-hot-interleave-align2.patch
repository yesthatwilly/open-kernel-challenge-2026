+def _combo_phases(weights, state, device, t_prepare):
+    """Run F1, F2, the C2 build, then the C2 checks + selector, in that order, each after master's prepare work
+    (pre-flight audit: F2 before the C2 build, as the spec orders it, so a slow or repeated -Werror/plain wg2 build
+    can never push F2 past its 150 s start deadline; the C2 build keeps its own 140 s start deadline).
+    A phase that raises leaves its own flags at master (and C2 restores master's wg_on_256). Returns the PATH
+    CHOSEN / summary lines prepare() prints again at the very end."""
+    ctx = {}
+    out = []
+    secs = []
+    master_on_256 = bool(state.get("wg_on_256", False))
+    phases = (("F1", _f1_setup), ("F2", _f2_setup), ("C2-build", _c2_build_phase), ("C2", _c2_phase))
+    for name, fn in phases:
+        t0 = time.perf_counter()
+        print(f"{COMBO_TAG} phase {name} starting at {t0 - t_prepare:.1f}s into prepare", flush=True)
+        try:
+            lines = fn(weights, state, device, t_prepare, ctx)
+            torch.cuda.synchronize()
+        except Exception as e:
