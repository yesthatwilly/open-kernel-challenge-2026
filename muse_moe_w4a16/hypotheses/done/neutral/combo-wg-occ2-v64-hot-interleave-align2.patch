+        if not any(start <= e < start + count for e in row):
+            free = [e for e in range(start, start + count) if e not in row]
+            row[0] = free[int(torch.randint(0, len(free), (1,), generator=gen))]
+    tw = torch.rand((1, TOP_K), generator=gen)
+    return {
+        "hidden_states": torch.randn((1, hidden), generator=gen).to(torch.bfloat16).to(device),
+        "topk_ids": torch.tensor([row], dtype=torch.int32, device=device),
+        "topk_weights": (tw / tw.sum(-1, keepdim=True)).to(device),
+        "config": {"bs": 1, "d_hidden": hidden, "d_expert": bank["size_n"], "n_experts": N_EXPERTS,
