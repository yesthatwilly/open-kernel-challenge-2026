+def _c2_checks(weights, state, device, t_prepare, ctx):
+    """V64 (selectable): master's s5 bucket canary on N16/N32/N64, _wg_self_check and the three-state
+    _wg_copy_check, each run with variant 1 (the copy check forces flags on A, B and C; the real state's flags are
+    restored after). V64s (print-only): the bucket canary. Returns (lines, {variant: checked ok})."""
+    bank = state["banks"][(0, 32)]
+    lines, passed = [], {1: False, 2: False}
