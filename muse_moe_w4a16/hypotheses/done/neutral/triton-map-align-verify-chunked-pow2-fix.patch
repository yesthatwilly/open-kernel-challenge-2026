+        n_blocks, CHUNK=ALIGN_CHUNK, BSM=block_size_m, NUM_E=triton.next_power_of_2(local_count),
+        BSM_P2=triton.next_power_of_2(block_size_m), num_warps=8)
+    return local_ids, (sorted_ids, block_experts, n_padded)
