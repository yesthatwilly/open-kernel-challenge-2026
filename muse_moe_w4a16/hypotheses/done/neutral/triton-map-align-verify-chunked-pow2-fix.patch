+@triton.jit(do_not_specialize=["local_start", "local_count", "n", "cap", "n_blocks"])
+def _align_chunked_kernel(topk_ids_ptr, local_ids_ptr, sorted_ids_ptr, block_experts_ptr, n_padded_ptr,
+                          local_start, local_count, n, cap, n_blocks, CHUNK: tl.constexpr,
+                          BSM: tl.constexpr, NUM_E: tl.constexpr, BSM_P2: tl.constexpr):
+    """_align_small_kernel's outputs for any n, one program, in CHUNK-route chunks.
+
+    Pass 1 maps the ids, stores local_ids and accumulates the per-expert counts. Pass 2 recomputes
+    the local ids from topk_ids (it never reloads local_ids: those stores by other threads of this
+    program are not ordered before the loads) and places each real route at its expert's segment
+    start plus the routes of that expert already placed by earlier chunks (base) plus its rank
+    within the chunk. Then the padding slots, the slots past the used length and block_experts.
+    The store sets into sorted_ids are disjoint, so no ordering is needed."""
+    offs0 = tl.arange(0, CHUNK)
+    experts = tl.arange(0, NUM_E)
+
+    counts = tl.zeros([NUM_E], dtype=tl.int32)
+    for c in range(0, n, CHUNK):
+        offs = c + offs0
+        mask = offs < n
+        ids = tl.load(topk_ids_ptr + offs, mask=mask, other=0).to(tl.int32)
+        local = ids - local_start
+        local = tl.where(mask & (local >= 0) & (local < local_count), local, -1)
+        tl.store(local_ids_ptr + offs, local, mask=mask)
+        onehot = (local[:, None] == experts[None, :]).to(tl.int32)    # [CHUNK, NUM_E]
+        counts += tl.sum(onehot, axis=0)
+
+    padded = (counts + BSM - 1) // BSM * BSM
+    seg_end = tl.cumsum(padded, axis=0)
+    seg_start = seg_end - padded
+    total = tl.sum(padded, axis=0)
+
+    base = seg_start
+    for c in range(0, n, CHUNK):
+        offs = c + offs0
+        mask = offs < n
+        ids = tl.load(topk_ids_ptr + offs, mask=mask, other=0).to(tl.int32)
+        local = ids - local_start
+        local = tl.where(mask & (local >= 0) & (local < local_count), local, -1)
+        onehot = (local[:, None] == experts[None, :]).to(tl.int32)
+        rank = tl.sum(onehot * (tl.cumsum(onehot, axis=0) - 1), axis=1)
+        pos = tl.sum(onehot * base[None, :], axis=1) + rank
+        tl.store(sorted_ids_ptr + pos, offs, mask=mask & (local >= 0))
+        base += tl.sum(onehot, axis=0)
+
+    # Each expert's padding slots (one [NUM_E, BSM] tile, as in _align_small_kernel).
+    # BSM_P2 = next_power_of_2(BSM): tl.arange needs a power of 2 (block 48 is not).
+    j = tl.arange(0, BSM_P2)
+    pad_ptrs = sorted_ids_ptr + (seg_start + counts)[:, None] + j[None, :]
+    sentinel = tl.zeros([NUM_E, BSM_P2], dtype=tl.int32) + n
+    tl.store(pad_ptrs, sentinel, mask=j[None, :] < (padded - counts)[:, None])
+    # Every slot past the used length.
+    for s in range(0, cap, CHUNK):
+        slots = s + offs0
+        tl.store(sorted_ids_ptr + slots, tl.zeros([CHUNK], dtype=tl.int32) + n,
+                 mask=(slots >= total) & (slots < cap))
+
+    for b in range(0, n_blocks, CHUNK):
+        blocks = b + offs0
+        block_start = blocks * BSM
+        inseg = (block_start[:, None] >= seg_start[None, :]) & (block_start[:, None] < seg_end[None, :])
+        block_expert = tl.sum(tl.where(inseg, experts[None, :], 0), axis=1)
+        block_expert = tl.where(tl.sum(inseg.to(tl.int32), axis=1) > 0, block_expert, -1)
+        tl.store(block_experts_ptr + blocks, block_expert, mask=blocks < n_blocks)
+    tl.store(n_padded_ptr, total)
+
