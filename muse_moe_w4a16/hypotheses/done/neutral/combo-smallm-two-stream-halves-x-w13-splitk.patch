+    lines.append(f"{WG_TAG} B256 PATH CHOSEN = {'WGMMA' if state.get('wg_on_256', False) else 'MARLIN'} "
+                 f"(wg_on_256 {state.get('wg_on_256', False)}, wg_on_128 {state.get('wg_on_128', False)}); "
+                 f"F2 wg_align2 = {state['wg_align2']} ({'inert' if not state.get('wg_on_256', False) and not state.get('wg_on_128', False) else 'live'})")
+    lines.append(f"{COMBO_TAG} FINAL flags: w13_t1 {state['w13_t1']}, wg_align2 {state['wg_align2']}, sm_mode "
+                 + ", ".join(f"[{lo},{hi}] {SM_NAMES[state['sm_mode'][rep]]}" for lo, hi, rep in SM_BANDS)
+                 + f", sm_w13 {state['sm_w13']}, sm_w2 {state['sm_w2']}, w2_mode {state.get('w2_mode')}")
+    lines.append(f"{COMBO_TAG} phase seconds: " + ", ".join(f"{k} {v:.1f}" for k, v in phases.items())
+                 + f"; combo total {time.perf_counter() - t_begin:.1f}s; prepare at {elapsed():.1f}s")
+    return lines
