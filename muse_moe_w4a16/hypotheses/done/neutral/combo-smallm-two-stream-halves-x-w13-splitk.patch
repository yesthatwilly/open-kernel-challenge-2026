+    """The C3 band (its representative T) of a token count, or None. Shape only."""
+    for lo, hi, rep in SM_BANDS:
+        if lo <= num_tokens <= hi:
+            return rep
+    return None
+
+
+@triton.jit(do_not_specialize=["local_start", "local_count", "n", "cap", "cap_stride", "n_blocks"])
+def _align_small_halves_kernel(topk_ids_ptr, local_ids_ptr, local_ids_h_ptr, sorted_ids_ptr,
+                               block_experts_ptr, n_padded_ptr, local_start, local_count, n, cap,
+                               cap_stride, n_blocks, BLOCK_N: tl.constexpr, CAP_BLOCK: tl.constexpr,
+                               MB_BLOCK: tl.constexpr, BSM: tl.constexpr, HALF: tl.constexpr,
+                               HALF_E: tl.constexpr):
+    """_align_small_kernel's work, one program per expert half h (local experts [h*HALF, h*HALF+HALF)).
+
+    Program h treats every route outside its half like a remote route and writes its own
+    sorted_ids[h] (row stride cap_stride, capacity cap, sentinel n in every unused slot),
+    block_experts[h] (expert ids stay bank-local, h*HALF + j; -1 past its used blocks), n_padded[h]
+    and local_ids_h[h] (the local id if in its half, else -1). Program 0 also writes the full
+    local_ids (both halves' routes as local ids, remote routes as -1) for the post-norm."""
+    h = tl.program_id(0)
+    lo = h * HALF
+    offs = tl.arange(0, BLOCK_N)
+    mask = offs < n
+    ids = tl.load(topk_ids_ptr + offs, mask=mask, other=0).to(tl.int32)
+    local = ids - local_start
+    local = tl.where(mask & (local >= 0) & (local < local_count), local, -1)
+    tl.store(local_ids_ptr + offs, local, mask=mask & (h == 0))
+    inhalf = (local >= lo) & (local < lo + HALF)
+    tl.store(local_ids_h_ptr + h * n + offs, tl.where(inhalf, local, -1), mask=mask)
+    rel = tl.where(inhalf, local - lo, -1)
+
+    experts = tl.arange(0, HALF_E)
+    onehot = (rel[:, None] == experts[None, :]).to(tl.int32)          # [BLOCK_N, HALF_E]
+    counts = tl.sum(onehot, axis=0)                                    # [HALF_E]
+    padded = (counts + BSM - 1) // BSM * BSM
+    seg_end = tl.cumsum(padded, axis=0)
+    seg_start = seg_end - padded
+    total = tl.sum(padded, axis=0)
+
+    s_ptr = sorted_ids_ptr + h * cap_stride
+    rank = tl.sum(onehot * (tl.cumsum(onehot, axis=0) - 1), axis=1)
+    pos = tl.sum(onehot * seg_start[None, :], axis=1) + rank
+    tl.store(s_ptr + pos, offs, mask=mask & inhalf)
+    j = tl.arange(0, BSM)
+    pad_ptrs = s_ptr + (seg_start + counts)[:, None] + j[None, :]
+    sentinel = tl.zeros([HALF_E, BSM], dtype=tl.int32) + n
+    tl.store(pad_ptrs, sentinel, mask=j[None, :] < (padded - counts)[:, None])
+    slots = tl.arange(0, CAP_BLOCK)
+    tl.store(s_ptr + slots, tl.zeros([CAP_BLOCK], dtype=tl.int32) + n,
+             mask=(slots >= total) & (slots < cap))
+
+    blocks = tl.arange(0, MB_BLOCK)
+    block_start = blocks * BSM
+    inseg = (block_start[:, None] >= seg_start[None, :]) & (block_start[:, None] < seg_end[None, :])
+    block_expert = tl.sum(tl.where(inseg, experts[None, :] + lo, 0), axis=1)
+    block_expert = tl.where(tl.sum(inseg.to(tl.int32), axis=1) > 0, block_expert, -1)
+    tl.store(block_experts_ptr + h * n_blocks + blocks, block_expert, mask=blocks < n_blocks)
+    tl.store(n_padded_ptr + h, total)
+
+
+def _align_small_halves(topk_ids, local_start, local_count, block_size_m):
+    """Two-half align in one 2-program launch (source marlin-two-stream-expert-halves-small-m).
+
+    Returns the full local_ids [M, 8], local_ids_h [2, M*8] and per half h Marlin's
+    (sorted_ids, block_experts, n_padded) as views into one stacked allocation per kind. Each half
+    covers local_count // 2 experts, so its capacity is M*8 + (local_count // 2)*(block_size_m - 1)."""
+    topk_ids = topk_ids.contiguous()
+    device = topk_ids.device
+    n = topk_ids.numel()
+    half = local_count // 2
+    cap = n + half * (block_size_m - 1)
+    cap_stride = triton.cdiv(cap, HALF_SORTED_ALIGN) * HALF_SORTED_ALIGN
+    n_blocks = triton.cdiv(cap, block_size_m)
+    local_ids = torch.empty(topk_ids.shape, dtype=torch.int32, device=device)
+    local_ids_h = torch.empty((2, n), dtype=torch.int32, device=device)
+    sorted_ids = torch.empty((2, cap_stride), dtype=torch.int32, device=device)
+    block_experts = torch.empty((2, n_blocks), dtype=torch.int32, device=device)
+    n_padded = torch.empty((2,), dtype=torch.int32, device=device)
+    _align_small_halves_kernel[(2,)](
+        topk_ids, local_ids, local_ids_h, sorted_ids, block_experts, n_padded, local_start,
+        local_count, n, cap, cap_stride, n_blocks, BLOCK_N=triton.next_power_of_2(n),
+        CAP_BLOCK=triton.next_power_of_2(cap), MB_BLOCK=triton.next_power_of_2(n_blocks),
+        BSM=block_size_m, HALF=half, HALF_E=triton.next_power_of_2(half), num_warps=4)
+    triples = [(sorted_ids[h, :cap], block_experts[h], n_padded[h:h + 1]) for h in range(2)]
+    return local_ids, local_ids_h, triples
+
+
+def _sm_post_norm(y, local_ids, topk_weights, state):
+    """Master's post-expert norm choice by shape (unchanged). Below SMALL_M_POST_NORM the Triton combine
+    skips every remote slot (local id -1) and never loads its row, so the halves' separate cache3 junk in
+    remote rows is masked (review fix 4); at T == 32 SGLang's fused kernel gets slot_expert_ids, and the
+    NaN-poisoned self-check of the halves path proves it ignores those rows too."""
+    num_tokens, _, size_k = y.shape
+    if num_tokens < SMALL_M_POST_NORM:
+        out = torch.empty((num_tokens, size_k), device=y.device, dtype=torch.bfloat16)
+        _post_norm_combine_kernel[(num_tokens,)](
+            y, local_ids, topk_weights, state["post_norm_w"], out, size_k, POST_NORM_EPS,
+            TOP_K_C=TOP_K, BLOCK_H=triton.next_power_of_2(size_k), num_warps=8)
+        return out
+    return fused_post_expert_norm_weighted_sum(
+        y, topk_weights, norm_weight=state["norm_w"], eps=POST_NORM_EPS, weight_first=True,
+        slot_expert_ids=local_ids)
+
+
+def _experts_two_stream(x, topk_ids, topk_weights, bank, state, w13_atomic, poison=False):
+    """C3 H (w13_atomic False) / H+A (True): the expert work split by local expert into half A (0-15) on the
+    current stream and half B (16-31) on the prepare-time side stream state["sm_side"], each running
+    w13 Marlin -> silu_and_mul -> w2 Marlin over its own routes only, with its own Marlin lock workspace
+    (state["workspace"] / state["sm_workspace_b"], both made in prepare).
+
+    Graph-safe fork/join (review fix 3): every buffer is allocated on the current stream BEFORE the fork
+    (stacked cache1 / cache2, one shared cache3, a separate buffer: master's cache13 aliasing would race
+    across streams); any atomic_zero zero_() runs here, on the current stream, before the fork, on every
+    call (review fix 1); the current stream waits on the side stream before the post-norm; no
+    record_stream (the buffers are freed on the current stream after the join). w2 runs with
+    state["sm_w2"], which prepare's cross-half wipe test sets (non-atomic if a half's atomic w2 call
+    touched the other half's rows). poison (prepare self-checks only): junk in the stacked cache1 and NaN
+    in the shared cache3 first."""
+    num_tokens, size_k = x.shape
+    size_n = bank["size_n"]
+    gemm1_n = 2 * size_n
+    routes = num_tokens * TOP_K
+    topk_weights = topk_weights.to(torch.float32).contiguous()
+    block_size_m = _block_size_m(num_tokens, bank["count"])
+    local_ids, local_ids_h, triples = _align_small_halves(topk_ids, bank["start"], bank["count"], block_size_m)
+    cache1 = torch.empty((2, routes, gemm1_n), device=x.device, dtype=x.dtype)
+    cache2 = torch.empty((2, routes, size_n), device=x.device, dtype=x.dtype)
+    cache3 = torch.empty((routes, size_k), device=x.device, dtype=x.dtype)
+    if poison:
+        cache1.fill_(W13_POISON)
+        cache3.fill_(float("nan"))
+    common = dict(moe_block_size=block_size_m, mul_topk_weights=False, is_ep=True,
+                  b_q_type=scalar_types.float4_e2m1f, is_k_full=True, use_atomic_add=False,
+                  use_fp32_reduce=True, is_zp_float=False)
+    w13_kw = common
+    if w13_atomic:
+        w13_kw = dict(common, use_atomic_add=True)
+        if state["sm_w13"] == "atomic_zero":
+            cache1.zero_()
+    w2_kw = common
+    if state["sm_w2"] != "master":
+        w2_kw = dict(common, use_atomic_add=True)
+        if state["sm_w2"] == "atomic_zero":
+            cache3.zero_()
+    current, side = torch.cuda.current_stream(), state["sm_side"]
+    side.wait_stream(current)
+    for h, ws, stream in ((0, state["workspace"], current), (1, state["sm_workspace_b"], side)):
+        sorted_ids, block_experts, n_padded = triples[h]
+        with torch.cuda.stream(stream):
+            c1 = moe_wna16_marlin_gemm(
+                x, cache1[h], bank["w13"], None, bank["w13_s"], bank["w13_gs"], None, None, None, ws,
+                sorted_ids, block_experts, n_padded, topk_weights, top_k=TOP_K,
+                size_m=num_tokens, size_n=gemm1_n, size_k=size_k, **w13_kw)
+            silu_and_mul(c1.view(-1, gemm1_n), cache2[h], expert_ids=local_ids_h[h], expert_step=1)
+            moe_wna16_marlin_gemm(
+                cache2[h], cache3, bank["w2"], None, bank["w2_s"], bank["w2_gs"], None, None, None, ws,
+                sorted_ids, block_experts, n_padded, topk_weights, top_k=1,
+                size_m=routes, size_n=size_k, size_k=size_n, **w2_kw)
+    current.wait_stream(side)
+    return _sm_post_norm(cache3.view(num_tokens, TOP_K, size_k), local_ids, topk_weights, state)
+
+
+def _align_halves_self_check(device, count):
+    """Untimed, prepare() only (ported from the source): for each half of _align_small_halves, per-expert
+    route sets and block counts against SGLang's moe_align_block_size(ref_local with the other half set to
+    -1, bsm, count), plus the full and per-half local_ids, on synthetic routings. Returns (cases, bad)."""
+    gen = torch.Generator().manual_seed(20261025)
+    half = count // 2
+    bad = []
+    cases = 0
+    for tokens in (8, 16, 24, 32):
+        for start in (0, 32, N_EXPERTS - count):
+            local_set = list(range(start, start + count))
+            remote_set = [e for e in range(N_EXPERTS) if e not in local_set]
+            rows = {
+                "random": [torch.randperm(N_EXPERTS, generator=gen)[:TOP_K].tolist() for _ in range(tokens)],
+                "skewed": [[local_set[0], local_set[count - 1], local_set[5]] +
+                           [remote_set[i] for i in torch.randperm(len(remote_set), generator=gen)[:5].tolist()]
+                           for _ in range(tokens)],
+                "all-remote": [[remote_set[i] for i in torch.randperm(len(remote_set), generator=gen)[:TOP_K].tolist()]
+                               for _ in range(tokens)],
+                "half-a-only": [local_set[0:8] for _ in range(tokens)],
+                "half-b-only": [local_set[half:half + 8] for _ in range(tokens)],
+                "all-local": [[local_set[i] for i in torch.randperm(count, generator=gen)[:TOP_K].tolist()]
+                              for _ in range(tokens)],
+            }
+            for name, ids in rows.items():
+                cases += 1
+                tag = f"T={tokens} local_start={start} {name}"
+                topk_ids = torch.tensor(ids, dtype=torch.int32, device=device)
+                bsm = _block_size_m(tokens, count)
+                local_ids, local_ids_h, triples = _align_small_halves(topk_ids, start, count, bsm)
+                ref_map = torch.full((N_EXPERTS,), -1, dtype=torch.int32, device=device)
+                ref_map[start:start + count] = torch.arange(count, dtype=torch.int32, device=device)
+                ref_local = ref_map[topk_ids].contiguous()
+                if not torch.equal(local_ids, ref_local):
+                    bad.append(f"{tag}: full local_ids differ")
+                    continue
+                numel = tokens * TOP_K
+                for h, (s_ids, b_exp, n_pad) in enumerate(triples):
+                    in_half = (ref_local >= h * half) & (ref_local < h * half + half)
+                    ref_h = torch.where(in_half, ref_local, torch.full_like(ref_local, -1)).contiguous()
+                    if not torch.equal(local_ids_h[h], ref_h.view(-1)):
+                        bad.append(f"{tag} half {h}: local_ids_h differ")
+                        continue
+                    r_ids, r_exp, r_pad = moe_align_block_size(ref_h, bsm, count)
+                    torch.cuda.synchronize()
+                    s_l, b_l, n_p = s_ids.tolist(), b_exp.tolist(), int(n_pad.item())
+                    r_l, re_l, r_p = r_ids.tolist(), r_exp.tolist(), int(r_pad.item())
+
+                    def per_expert(sorted_ids, block_experts, used):
+                        groups, blocks = {}, {}
+                        for b in range(used // bsm):
+                            e = block_experts[b]
+                            if e < 0:
+                                continue
+                            blocks[e] = blocks.get(e, 0) + 1
+                            groups.setdefault(e, []).extend(i for i in sorted_ids[b * bsm:(b + 1) * bsm] if i < numel)
+                        return groups, blocks
+
+                    mine, mine_blocks = per_expert(s_l, b_l, n_p)
+                    ref, ref_blocks = per_expert(r_l, re_l, r_p)
+                    if {e: sorted(v) for e, v in mine.items()} != {e: sorted(v) for e, v in ref.items()}:
+                        bad.append(f"{tag} half {h}: per-expert routes differ")
+                    if mine_blocks != ref_blocks or n_p != bsm * sum(ref_blocks.values()):
+                        bad.append(f"{tag} half {h}: blocks {mine_blocks} n_padded {n_p} vs SGLang "
+                                   f"{ref_blocks} {r_p}")
+                    used_blocks = n_p // bsm
+                    if any(e < h * half or e >= h * half + half for e in b_l[:used_blocks]) \
+                            or any(e != -1 for e in b_l[used_blocks:]) \
+                            or b_l[:used_blocks] != sorted(b_l[:used_blocks]):
+                        bad.append(f"{tag} half {h}: block_experts layout {b_l}")
+                    real = sum(len(v) for v in mine.values())
+                    if sum(1 for i in s_l if i == numel) != len(s_l) - real or any(i > numel for i in s_l):
+                        bad.append(f"{tag} half {h}: sorted_ids sentinel fill")
+    return cases, bad
+
+
+def _combo_judge_ids(tokens, gen, device):
+    """Judge-like routing (the 'normal' dist with heavy-tailed per-expert popularity, then rotated so this
+    GPU's experts 0-31 are the busiest), written here from TASK.md's description; global ids [T, 8] int32."""
+    scores = torch.rand((tokens, N_EXPERTS), generator=gen)
+    z = torch.randn((N_EXPERTS,), generator=gen)
+    u = torch.rand((N_EXPERTS,), generator=gen).clamp(min=1e-12)
+    scores = scores + 0.03 * z / (-u.log()).sqrt()
+    ids = scores.topk(TOP_K, dim=-1).indices
+    pairs = torch.bincount((ids // SM_COUNT).flatten(), minlength=N_EXPERTS // SM_COUNT)
+    ids = (ids - SM_COUNT * pairs.argmax()) % N_EXPERTS
+    return ids.to(torch.int32).to(device).contiguous()
+
+
+def _combo_routings(tokens, gen, device):
+    """The six _align2_routings (local_start 0) plus the judge-like one, name -> topk_ids on device."""
+    out = dict(_align2_routings(tokens, 0, SM_COUNT, gen, device))
+    out["judge-like"] = _combo_judge_ids(tokens, gen, device)
+    return out
+
+
+def _combo_xw(tokens, hidden, gen, device):
+    x = torch.randn((tokens, hidden), generator=gen).to(torch.bfloat16).to(device)
+    tw = torch.rand((tokens, TOP_K), generator=gen)
+    return x, (tw / tw.sum(-1, keepdim=True)).to(device)
+
+
+def _combo_fp32_ref(weights, state, bank, x, topk_ids, tw):
+    """fp32 reference: fp32-dequant weights (E2M1 x E4M3 x global scale), fp32 matmuls, silu in fp32, the
+    post-expert norm and weighted sum in fp32; decodes only the local experts this routing uses."""
+    inter = bank["size_n"]
+    start, count = bank["start"], bank["count"]
+    tokens, hidden = x.shape
+    ids = topk_ids.long()
+    local = (ids >= start) & (ids < start + count)
+    y = torch.zeros((tokens, TOP_K, hidden), dtype=torch.float32, device=x.device)
+    xf = x.float()
+    for e in torch.unique(ids[local]).tolist():
+        t_idx, s_idx = (ids == e).nonzero(as_tuple=True)
+        w13 = _wg_decode_nvfp4(weights["w13"][e], weights["w13_sf"][e], weights["w13_gs"][e])
+        hh = xf[t_idx] @ w13.T
+        del w13
+        h = torch.nn.functional.silu(hh[:, :inter]) * hh[:, inter:]
+        w2 = _wg_decode_nvfp4(weights["w2"][e], weights["w2_sf"][e], weights["w2_gs"][e])
+        y[t_idx, s_idx] = h @ w2.T
+        del w2
+    yv = y * (1.0 + state["post_norm_w"].float())
+    yn = yv * torch.rsqrt(yv.pow(2).mean(-1, keepdim=True) + POST_NORM_EPS)
+    g = tw.float() * local.float()
+    return (yn * g.unsqueeze(-1)).sum(1)
+
+
+def _combo_gate(meds_by_routing, cands):
+    """{cand: worse-routing ratio new / master} from {routing: {name: us}}; cands present in every routing."""
+    ratios = {}
+    for c in cands:
+        if all(c in m and "master" in m for m in meds_by_routing.values()):
+            ratios[c] = max(m[c] / max(m["master"], 1e-9) for m in meds_by_routing.values())
+    return ratios
+
+
+def _combo_f1(weights, state, device, gen):
+    """F1: w13 atomic at T == 1. Correctness first (poisoned cache13, six routings plus judge-like, rel-L2 vs
+    current master <= W13_ATOMIC_TOL AND vs the fp32 reference <= W13_FP32_TOL, finite), then the component
+    graph (the w13 Marlin call alone at T=1, judge-like and random-local routings) <= COMBO_GATE_RATIO on the
+    worse routing. Returns (mode, lines)."""
+    bank = state["banks"][(0, SM_COUNT)]
+    w2_mode = state["w2_mode"]
+    hidden = state["post_norm_w"].numel()
+    lines = []
+    cases = [(name, ids) + _combo_xw(1, hidden, gen, device) for name, ids in _combo_routings(1, gen, device).items()]
+    mode = "master"
+    for cand in ("atomic", "atomic_zero"):
+        w_m = w_f = w_mf = 0.0
+        why = ""
+        for name, ids, x, tw in cases:
+            print(f"{COMBO_TAG} F1 launching master + {cand} T=1 {name}", flush=True)
+            ref = _moe_marlin(x, ids, tw, bank, state, w2_mode, "master")[0].clone()
+            out = _moe_marlin(x, ids, tw, bank, state, w2_mode, cand, poison=True)[0].clone()
+            torch.cuda.synchronize()
+            print(f"{COMBO_TAG} F1 done master + {cand} T=1 {name}", flush=True)
+            f32 = _combo_fp32_ref(weights, state, bank, x, ids, tw)
+            r_m, r_f, r_mf = _wg_rel(out, ref), _wg_rel(out, f32), _wg_rel(ref, f32)
+            w_m, w_f, w_mf = max(w_m, r_m), max(w_f, r_f), max(w_mf, r_mf)
+            if not (r_m <= W13_ATOMIC_TOL and r_f <= W13_FP32_TOL):
+                why = f"{name}: rel-L2 vs master {r_m:.3g}, vs fp32 {r_f:.3g}"
+                break
+        print(f"{COMBO_TAG} F1 {cand} T=1: worst rel-L2 vs master {w_m:.3g} (<= {W13_ATOMIC_TOL:g}), vs fp32 "
+              f"{w_f:.3g} (<= {W13_FP32_TOL:g}); master vs fp32 {w_mf:.3g}; "
+              + ("ok" if not why else f"FAIL {why}"), flush=True)
+        if not why:
+            mode = cand
+            lines.append(f"{COMBO_TAG} F1 correctness {cand}: worst vs master {w_m:.3g}, vs fp32 {w_f:.3g} "
+                         f"(master vs fp32 {w_mf:.3g})")
+            break
+    if mode == "master":
+        lines.append(f"{COMBO_TAG} F1 PATH CHOSEN T==1 = master (no w13 atomic mode passed correctness)")
+        return "master", lines
+    # Component graph: the w13 Marlin call alone (atomic_zero's zero_ inside the timed graph).
+    size_n = bank["size_n"]
+    bsm = _block_size_m(1, bank["count"])
+    meds_by = {}
+    for routing in ("judge-like", "all-local-saturated"):
+        ids = _combo_routings(1, gen, device)[routing]
+        x, tw = _combo_xw(1, hidden, gen, device)
+        _, (sorted_ids, block_experts, n_padded) = _align_small(ids, bank["start"], bank["count"], bsm)
+        c1 = torch.empty((TOP_K, 2 * size_n), device=device, dtype=torch.bfloat16)
+        common = dict(moe_block_size=bsm, mul_topk_weights=False, is_ep=True, b_q_type=scalar_types.float4_e2m1f,
+                      is_k_full=True, use_fp32_reduce=True, is_zp_float=False)
+
+        def w13(atomic, zero, x=x, tw=tw, c1=c1, s=sorted_ids, b=block_experts, n=n_padded, common=common):
+            if zero:
+                c1.zero_()
+            return moe_wna16_marlin_gemm(
+                x, c1, bank["w13"], None, bank["w13_s"], bank["w13_gs"], None, None, None, state["workspace"],
+                s, b, n, tw, top_k=TOP_K, size_m=1, size_n=2 * size_n, size_k=hidden, use_atomic_add=atomic,
+                **common)
+
+        meds_by[routing] = _align2_gate_time(
+            {"master": lambda: w13(False, False), "new": lambda: w13(True, mode == "atomic_zero")}, device)
+    ratio = _combo_gate(meds_by, ["new"])["new"]
+    on = ratio <= COMBO_GATE_RATIO
+    lines.append(f"{COMBO_TAG} F1 PATH CHOSEN T==1 = {mode if on else 'master'}: w13 Marlin alone cold-L2 graph "
+                 f"medians " + "; ".join(f"{r} master {m['master']:.2f} us, {mode} {m['new']:.2f} us"
+                                         for r, m in meds_by.items())
+                 + f"; worse-routing ratio {ratio:.3f} (ON at <= {COMBO_GATE_RATIO})")
+    return (mode if on else "master"), lines
+
+
+def _combo_f2(state, device, gen):
+    """F2: _moe_wgmma's front end via _align_two_phase at block 16 for whichever wgmma bucket is ON. Warm
+    every T of the ON buckets for every chunk; equivalence torch.equal on all four outputs against
+    _align_parallel at block 16 (which master validates per expert against SGLang; NEVER torch.equal against
+    SGLang's tables, which keep -1 routes in blocks of their own) on F2_TEST_T x three local_starts x six
+    routings, local_ids against the expert_map gather, capacity within WG_MAX_BLOCKS / WG_CAP_ROWS; then
+    the full _moe_wgmma output must be BITWISE equal to master's front end (two routings per T); then the
+    front-end component graph at the bucket's T <= COMBO_GATE_RATIO on the worse routing. Returns (chunk, lines)."""
+    bank = state["banks"][(0, SM_COUNT)]
+    start, count = bank["start"], bank["count"]
+    hidden = state["post_norm_w"].numel()
+    ranges = []
+    if state.get("wg_on_128", False):
+        ranges.append((WG_MIN_TOKENS, WG_B256_MIN_TOKENS - 1))
+    if state.get("wg_on_256", False):
+        ranges.append((WG_B256_MIN_TOKENS, WG_MAX_TOKENS))
+    if not ranges:
+        return 0, [f"{COMBO_TAG} F2 PATH CHOSEN wgmma front end = master (inert: wg_on_128 "
+                   f"{state.get('wg_on_128', False)}, wg_on_256 {state.get('wg_on_256', False)})"]
+    lines = []
+    top = max(hi for _, hi in ranges)
+    chunks = tuple(c for c in ALIGN2_CHUNKS if c <= triton.next_power_of_2(top * TOP_K))
+    n_warm = 0
+    print(f"{COMBO_TAG} F2 warming _align_two_phase at bsm {WG_BSM} for T in {ranges}, chunks {chunks}", flush=True)
+    for lo, hi in ranges:
+        for tokens in range(lo, hi + 1):
+            cap = tokens * TOP_K + count * (WG_BSM - 1)
+            if triton.cdiv(cap, WG_BSM) > WG_MAX_BLOCKS or cap > WG_CAP_ROWS:
+                return 0, [f"{COMBO_TAG} F2 PATH CHOSEN wgmma front end = master (T={tokens}: capacity {cap} rows / "
+                           f"{triton.cdiv(cap, WG_BSM)} blocks exceeds WG_CAP_ROWS / WG_MAX_BLOCKS)"]
+            ids = torch.full((tokens, TOP_K), start, dtype=torch.int32, device=device)
+            for chunk in chunks:
+                _align_two_phase(ids, start, count, WG_BSM, chunk)
+                n_warm += 1
+    torch.cuda.synchronize()
+    print(f"{COMBO_TAG} F2 warm done: {n_warm} calls", flush=True)
+    tests = [t for t in F2_TEST_T if any(lo <= t <= hi for lo, hi in ranges)]
+    bad, n_ok = {}, {c: 0 for c in chunks}
+    for tokens in tests:
+        for cstart in ALIGN2_STARTS:
+            for name, ids in _align2_routings(tokens, cstart, count, gen, device).items():
+                ref = _align_parallel(ids, cstart, count, WG_BSM)
+                ref_local = torch.where((ids >= cstart) & (ids < cstart + count), ids - cstart, torch.full_like(ids, -1))
+                if not torch.equal(ref[0], ref_local):
+                    return 0, [f"{COMBO_TAG} F2 PATH CHOSEN wgmma front end = master (_align_parallel local_ids differ "
+                               f"from the expert_map gather at T={tokens} local_start={cstart} {name})"]
+                for chunk in chunks:
+                    if chunk in bad:
+                        continue
+                    new = _align_two_phase(ids, cstart, count, WG_BSM, chunk)
+                    why = _align2_first_mismatch(ref, new)
+                    if why is None and int(new[1][2].item()) > WG_BSM * WG_MAX_BLOCKS:
+                        why = f"n_padded {int(new[1][2].item())} > {WG_BSM} x WG_MAX_BLOCKS"
+                    if why:
+                        bad[chunk] = f"T={tokens} local_start={cstart} {name}: {why}"
+                    else:
+                        n_ok[chunk] += 1
+    torch.cuda.synchronize()
+    for chunk, why in bad.items():
+        print(f"{COMBO_TAG} F2 chunk {chunk} OFF (tables): {why}", flush=True)
+    good = [c for c in chunks if c not in bad]
+    # Full _moe_wgmma output, bitwise, against master's front end (same kernels, layout-agnostic consumers).
+    st0 = dict(state)
+    st0["wg_align2"] = 0
+    n_bit = 0
+    for tokens in tests:
+        for name in ("judge-like", "random"):
+            if not good:
+                break
+            ids = _combo_routings(tokens, gen, device)[name]
+            x, tw = _combo_xw(tokens, hidden, gen, device)
+            state["wg_err"].zero_()
+            print(f"{COMBO_TAG} F2 launching _moe_wgmma master front end T={tokens} {name}", flush=True)
+            ref = _moe_wgmma(x, ids, tw, bank, st0)[0].clone()
+            torch.cuda.synchronize()
+            for c in list(good):
+                st1 = dict(state)
+                st1["wg_align2"] = c
+                out = _moe_wgmma(x, ids, tw, bank, st1)[0].clone()
+                torch.cuda.synchronize()
+                if not torch.equal(out, ref):
+                    bad[c] = f"T={tokens} {name}: _moe_wgmma output not bitwise equal (rel-L2 {_wg_rel(out, ref):.2e})"
+                    good.remove(c)
+                else:
+                    n_bit += 1
+            err = int(state["wg_err"][0].item())
+            print(f"{COMBO_TAG} F2 done _moe_wgmma T={tokens} {name}: error word {err}", flush=True)
+            if err != 0:
+                return 0, [f"{COMBO_TAG} F2 PATH CHOSEN wgmma front end = master (wg error word {err})"]
+    state["wg_err"].zero_()
+    if not good:
+        return 0, [f"{COMBO_TAG} F2 PATH CHOSEN wgmma front end = master (no chunk passed: "
+                   + "; ".join(f"chunk {c}: {w}" for c, w in bad.items())[:300] + ")"]
+    rep_t = WG_B256_MIN_TOKENS if state.get("wg_on_256", False) else WG_MIN_TOKENS
+    meds_by = {}
+    for routing in ("judge-like", "random"):
+        ids = _combo_routings(rep_t, gen, device)[routing]
+
+        def fe_master(ids=ids):
+            local = bank["expert_map"][ids.to(torch.int32)].contiguous()
+            return moe_align_block_size(local, WG_BSM, count)
+
+        fns = {"master": fe_master,
+               "align_parallel16 (info)": lambda ids=ids: _align_parallel(ids, start, count, WG_BSM)}
+        for c in good:
+            fns[f"c{c}"] = lambda ids=ids, c=c: _align_two_phase(ids, start, count, WG_BSM, c)
+        meds_by[routing] = _align2_gate_time(fns, device)
+    ratios = _combo_gate(meds_by, [f"c{c}" for c in good])
+    best = min(good, key=lambda c: ratios[f"c{c}"])
+    ratio = ratios[f"c{best}"]
+    on = ratio <= COMBO_GATE_RATIO
+    lines.append(f"{COMBO_TAG} F2 PATH CHOSEN wgmma front end (T={rep_t}, bsm {WG_BSM}) = "
+                 + (f"align2 chunk {best}" if on else "master") + ": cold-L2 graph medians "
+                 + "; ".join(f"{r}: " + ", ".join(f"{k} {v:.2f} us" for k, v in m.items()) for r, m in meds_by.items())
+                 + f"; best chunk {best} worse-routing ratio {ratio:.3f} (ON at <= {COMBO_GATE_RATIO}); tables ok "
+                 f"{n_ok[best]} cases, bitwise _moe_wgmma {n_bit} cases")
+    return (best if on else 0), lines
+
+
+def _sm_cross_half(bank, state, device, gen, w2_mode):
+    """Review fix 2, serialized: per representative T and two routings, run both halves' w13 + silu, then
+    for each half h fill cache3 with junk, run ONLY half h's w2 Marlin call (w2_mode's kwargs, its own
+    workspace) and require every row half h does not own (the other half's routes and the remote routes)
+    to be bitwise unchanged, and half h's own rows to have changed. Returns (ok, detail)."""
+    size_n = bank["size_n"]
+    gemm1_n = 2 * size_n
+    hidden = state["post_norm_w"].numel()
+    n_cases = 0
+    for _, _, tokens in SM_BANDS:
+        for name in ("all-local-saturated", "judge-like"):
+            ids = _combo_routings(tokens, gen, device)[name]
+            x, tw = _combo_xw(tokens, hidden, gen, device)
+            routes = tokens * TOP_K
+            bsm = _block_size_m(tokens, bank["count"])
+            _, local_ids_h, triples = _align_small_halves(ids, bank["start"], bank["count"], bsm)
+            cache1 = torch.zeros((2, routes, gemm1_n), device=device, dtype=torch.bfloat16)
+            cache2 = torch.zeros((2, routes, size_n), device=device, dtype=torch.bfloat16)
+            common = dict(moe_block_size=bsm, mul_topk_weights=False, is_ep=True,
+                          b_q_type=scalar_types.float4_e2m1f, is_k_full=True, use_atomic_add=False,
+                          use_fp32_reduce=True, is_zp_float=False)
+            for h in (0, 1):
+                s, b, n = triples[h]
+                moe_wna16_marlin_gemm(
+                    x, cache1[h], bank["w13"], None, bank["w13_s"], bank["w13_gs"], None, None, None,
+                    state["workspace"], s, b, n, tw, top_k=TOP_K, size_m=tokens, size_n=gemm1_n, size_k=hidden,
+                    **common)
+                silu_and_mul(cache1[h], cache2[h], expert_ids=local_ids_h[h], expert_step=1)
+            junk = torch.randn((routes, hidden), generator=gen).to(torch.bfloat16).to(device)
+            w2_kw = common if w2_mode == "master" else dict(common, use_atomic_add=True)
+            for h in (0, 1):
+                s, b, n = triples[h]
+                cache3 = junk.clone()
+                ws = state["workspace"] if h == 0 else state["sm_workspace_b"]
+                print(f"{COMBO_TAG} C3 cross-half launching half {h} w2 alone ({w2_mode}) T={tokens} {name}", flush=True)
+                moe_wna16_marlin_gemm(
+                    cache2[h], cache3, bank["w2"], None, bank["w2_s"], bank["w2_gs"], None, None, None, ws,
+                    s, b, n, tw, top_k=1, size_m=routes, size_n=hidden, size_k=size_n, **w2_kw)
+                torch.cuda.synchronize()
+                print(f"{COMBO_TAG} C3 cross-half done half {h} T={tokens} {name}", flush=True)
+                own = local_ids_h[h] >= 0
+                other = ~own
+                n_cases += 1
+                if not torch.equal(cache3[other], junk[other]):
+                    n_bad = int((cache3[other] != junk[other]).any(-1).sum())
+                    return False, (f"T={tokens} {name}: half {h}'s w2 ({w2_mode}) changed {n_bad} of "
+                                   f"{int(other.sum())} rows it does not own")
+                if bool(own.any()) and torch.equal(cache3[own], junk[own]):
+                    return False, f"T={tokens} {name}: half {h}'s w2 ({w2_mode}) left its own rows unwritten"
+    return True, f"{n_cases} half launches, other half's and remote rows bitwise unchanged"
+
+
+def _sm_time_band(state, device, gen, rep, cands):
+    """Full kernel_fn per candidate (state variants that differ only in sm_mode[rep]), each captured as a CUDA
+    graph (the fork/join included), cold-L2 graph medians over ALIGN2_REPLAYS interleaved replays with the
+    empty-graph baseline subtracted, on the judge-like and a random routing. Returns {routing: {name: us}}."""
+    hidden = state["post_norm_w"].numel()
+    x = torch.zeros((rep, hidden), dtype=torch.bfloat16, device=device)
+    ids = torch.zeros((rep, TOP_K), dtype=torch.int32, device=device)
+    tw = torch.full((rep, TOP_K), 1.0 / TOP_K, dtype=torch.float32, device=device)
+    data = {"hidden_states": x, "topk_ids": ids, "topk_weights": tw,
+            "config": {"local_start": 0, "local_count": SM_COUNT}}
+    variants = {}
+    for c in cands:
+        st = dict(state)
+        st["sm_mode"] = dict(state["sm_mode"])
+        st["sm_mode"][rep] = c
+        variants[SM_NAMES[c]] = st
+    meds_by = {}
+    for routing in ("judge-like", "random"):
+        ids.copy_(_combo_routings(rep, gen, device)[routing])
+        xx, ttw = _combo_xw(rep, hidden, gen, device)
+        x.copy_(xx)
+        tw.copy_(ttw)
+        fns = {}
+        for name, st in variants.items():
+            fn = (lambda st=st: kernel_fn(data, st))
+            try:
+                _align2_graph(fn, device)  # capture test (fork/join under capture)
+                fns[name] = fn
+            except Exception as e:
+                print(f"{COMBO_TAG} C3 T={rep} {routing}: {name} capture raised {type(e).__name__}: {str(e)[:160]}",
+                      flush=True)
+        if "master" not in fns:
+            return None
+        meds_by[routing] = _align2_gate_time(fns, device)
+    return meds_by
+
+
+def _combo_c3(weights, state, device, gen, elapsed):
+    """C3 per band: halves align self-check, the w13 atomic flavour (A, poisoned), the cross-half w2 wipe test,
+    poisoned H / H+A self-checks (stacked cache1 junk, shared cache3 NaN) on six routings plus judge-like
+    against current master, then the four-way timing gate. Returns lines."""
+    bank = state["banks"][(0, SM_COUNT)]
+    w2_mode = state["w2_mode"]
+    hidden = state["post_norm_w"].numel()
+    lines = []
+    print(f"{COMBO_TAG} C3 warming _align_small_halves for T {SM_BANDS[0][0]}..{SM_BANDS[-1][1]}", flush=True)
+    for tokens in range(SM_BANDS[0][0], SM_BANDS[-1][1] + 1):
+        _align_small_halves(torch.full((tokens, TOP_K), bank["start"], dtype=torch.int32, device=device),
+                            bank["start"], bank["count"], _block_size_m(tokens, bank["count"]))
+    torch.cuda.synchronize()
+    print(f"{COMBO_TAG} C3 warm done", flush=True)
+    cases, bad = _align_halves_self_check(device, bank["count"])
+    halves_ok = not bad
+    lines.append(f"{COMBO_TAG} C3 halves align self-check vs moe_align_block_size (other half -1): {cases} cases, "
+                 f"{len(bad)} mismatches" + (f"; first: {bad[0]}" if bad else ""))
+    reps = [rep for _, _, rep in SM_BANDS]
+    checks = {rep: [(name, ids) + _combo_xw(rep, hidden, gen, device)
+                    for name, ids in _combo_routings(rep, gen, device).items()] for rep in reps}
+    refs = {rep: [_moe_marlin(x, ids, tw, bank, state, w2_mode, "master")[0].clone() for _, ids, x, tw in checks[rep]]
+            for rep in reps}
+    torch.cuda.synchronize()
+
+    def run_check(label, fn, only=None):
+        worst = 0.0
+        for rep in (reps if only is None else (only,)):
+            for (name, ids, x, tw), ref in zip(checks[rep], refs[rep]):
+                print(f"{COMBO_TAG} C3 launching {label} T={rep} {name}", flush=True)
+                out = fn(x, ids, tw).clone()
+                torch.cuda.synchronize()
+                print(f"{COMBO_TAG} C3 done {label} T={rep} {name}", flush=True)
+                rel = _wg_rel(out, ref)
+                worst = max(worst, rel)
+                if not rel <= SM_TOL:
+                    return worst, f"T={rep} {name}: rel-L2 vs master {rel:.3g}"
+        return worst, ""
+
+    # A: the w13 atomic flavour (poisoned cache13), also the flavour H+A uses.
+    a_flavor = None
+    for flavor in ("atomic", "atomic_zero"):
+        worst, why = run_check(f"A ({flavor})", lambda x, ids, tw, f=flavor:
+                               _moe_marlin(x, ids, tw, bank, state, w2_mode, f, poison=True)[0])
+        lines.append(f"{COMBO_TAG} C3 A w13 {flavor} (poisoned): worst rel-L2 vs master {worst:.3g} "
+                     + ("ok" if not why else f"FAIL {why}"))
+        if not why:
+            a_flavor = flavor
+            break
+    state["sm_w13"] = a_flavor or "master"
+    # Cross-half w2 wipe test (review fix 2).
+    if halves_ok:
+        mode = w2_mode
+        ok, detail = _sm_cross_half(bank, state, device, gen, mode)
+        if not ok and mode != "master":
+            lines.append(f"{COMBO_TAG} C3 cross-half w2 test FAILED with w2 {mode} ({detail}): the halves run w2 "
+                         f"NON-ATOMIC")
+            mode = "master"
+            ok, detail = _sm_cross_half(bank, state, device, gen, mode)
+        if not ok:
+            halves_ok = False
+            lines.append(f"{COMBO_TAG} C3 cross-half w2 test FAILED non-atomic too ({detail}): H and H+A OFF")
+        state["sm_w2"] = mode
+        lines.append(f"{COMBO_TAG} C3 cross-half w2 wipe test: {'ok' if ok else 'FAILED'} ({detail}); halves w2 mode "
+                     f"= {state['sm_w2']} (master's w2_mode {w2_mode})")
+    # H / H+A per band (a T == 32 failure, e.g. the fused post-norm not masking cache3's NaN rows, must not
+    # take the 8 / 16 bands down with it).
+    passed = {r: {SM_MASTER} | ({SM_A} if a_flavor else set()) for r in reps}
+    for cand in (SM_H, SM_HA):
+        if not halves_ok or (cand == SM_HA and not a_flavor):
+            continue
+        for r in reps:
+            worst, why = run_check(SM_NAMES[cand], lambda x, ids, tw, c=cand:
+                                   _experts_two_stream(x, ids, tw, bank, state, c == SM_HA, poison=True), r)
+            lines.append(f"{COMBO_TAG} C3 {SM_NAMES[cand]} T={r} (poisoned cache1 junk / cache3 NaN, w13 "
+                         f"{state['sm_w13'] if cand == SM_HA else 'master'}, w2 {state['sm_w2']}): worst rel-L2 vs "
+                         f"master {worst:.3g} " + ("ok" if not why else f"FAIL {why}"))
+            if not why:
+                passed[r].add(cand)
+    if elapsed() > C3_GATE_DEADLINE_S:
+        lines.append(f"{COMBO_TAG} C3 PATH CHOSEN every band = master (deadline: gate start at {elapsed():.1f}s > "
+                     f"{C3_GATE_DEADLINE_S:.0f}s)")
+        return lines
+    for lo, hi, rep in SM_BANDS:
+        cands = sorted(passed[rep])
+        if len(cands) == 1:
+            lines.append(f"{COMBO_TAG} C3 PATH CHOSEN band [{lo}, {hi}] rep T={rep} = master (no candidate passed)")
+            continue
+        if elapsed() > COMBO_TIMING_DEADLINE_S:
+            lines.append(f"{COMBO_TAG} C3 PATH CHOSEN band [{lo}, {hi}] rep T={rep} = master (deadline)")
+            continue
+        meds_by = _sm_time_band(state, device, gen, rep, cands)
+        if meds_by is None:
+            lines.append(f"{COMBO_TAG} C3 PATH CHOSEN band [{lo}, {hi}] rep T={rep} = master (master capture failed)")
+            continue
+        ratios = _combo_gate(meds_by, [SM_NAMES[c] for c in cands if c != SM_MASTER])
+        choice = SM_MASTER
+        if ratios:
+            best = min(ratios, key=ratios.get)
+            if ratios[best] <= COMBO_GATE_RATIO:
+                choice = [c for c in cands if SM_NAMES[c] == best][0]
+        state["sm_mode"][rep] = choice
+        four = "; ".join(f"{r}: " + ", ".join(f"{SM_NAMES[c]} {m[SM_NAMES[c]]:.1f}" if SM_NAMES[c] in m
+                                              else f"{SM_NAMES[c]} n/a" for c in (SM_MASTER, SM_H, SM_HA, SM_A))
+                         for r, m in meds_by.items())
+        lines.append(f"{COMBO_TAG} C3 PATH CHOSEN band [{lo}, {hi}] rep T={rep} = {SM_NAMES[choice]}: medians us "
+                     f"(master / H / H+A / A) {four}; worse-routing ratios "
+                     + ", ".join(f"{k} {v:.3f}" for k, v in ratios.items()) + f" (ON at <= {COMBO_GATE_RATIO})")
+    return lines
+
+
+def _combo_replay_check(state, device, gen):
+    """The judge model: capture kernel_fn as a CUDA graph on the prepared state A and on a tensor-cloning copy C
+    (the ext module and the side stream shared, as the judge's copy shares non-tensors), then replay
+    A, C, A, C with refilled inputs on four routings, each against master's flags (eager), for every shape
+    class whose combo flag is on. A failing class goes back to master. Returns lines."""
+    shapes = []
+    if state["w13_t1"] != "master":
+        shapes.append(1)
+    shapes += [rep for _, _, rep in SM_BANDS if state["sm_mode"][rep] != SM_MASTER]
+    if state["wg_align2"]:
+        shapes.append(WG_B256_MIN_TOKENS if state.get("wg_on_256", False) else WG_MIN_TOKENS)
+    if not shapes:
+        return [f"{COMBO_TAG} replay check: no combo flag on, nothing to replay"]
+    hidden = state["post_norm_w"].numel()
+    base = dict(state)
+    base["w13_t1"], base["wg_align2"] = "master", 0
+    base["sm_mode"] = {rep: SM_MASTER for _, _, rep in SM_BANDS}
+    clone = _wg_copy_tree(state)
+    torch.cuda.synchronize()
+    states = {"A": state, "C": clone}
+    lines = []
+
+    def data_of(bufs):
+        return {"hidden_states": bufs[0], "topk_ids": bufs[1], "topk_weights": bufs[2],
+                "config": {"local_start": 0, "local_count": SM_COUNT}}
+
+    for tokens in shapes:
+        graphs = {}
+        for name, st in states.items():
+            bufs = (torch.zeros((tokens, hidden), dtype=torch.bfloat16, device=device),
+                    _combo_judge_ids(tokens, gen, device),
+                    torch.full((tokens, TOP_K), 1.0 / TOP_K, dtype=torch.float32, device=device))
+            print(f"{COMBO_TAG} replay check T={tokens} state {name}: eager warm-up + capture of kernel_fn", flush=True)
+            kernel_fn(data_of(bufs), st)
+            torch.cuda.synchronize()
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                out = kernel_fn(data_of(bufs), st)
+            torch.cuda.synchronize()
+            graphs[name] = (graph, out, bufs)
+        worst, n, ok = 0.0, 0, True
+        for kind in ("judge-like", "random", "all-local-saturated", "all-one-expert"):
+            for name in ("A", "C", "A", "C"):
+                graph, out, bufs = graphs[name]
+                x, tw = _combo_xw(tokens, hidden, gen, device)
+                bufs[0].copy_(x)
+                bufs[1].copy_(_combo_routings(tokens, gen, device)[kind])
+                bufs[2].copy_(tw)
+                graph.replay()
+                torch.cuda.synchronize()
+                got = out.clone()
+                ref = kernel_fn(data_of(bufs), base)
+                torch.cuda.synchronize()
