+            lines.append(f"{COMBO_TAG} {phase} PATH CHOSEN = master (raised {type(e).__name__}: {str(e)[:200]})")
+        torch.cuda.synchronize()
+        phases[phase] = time.perf_counter() - t0
+        print(f"{COMBO_TAG} phase {phase} done in {phases[phase]:.1f}s", flush=True)
+    t0 = time.perf_counter()
+    try:
+        if elapsed() > COMBO_REPLAY_DEADLINE_S:
+            raise RuntimeError(f"deadline: replay check would start at {elapsed():.1f}s > {COMBO_REPLAY_DEADLINE_S:.0f}s")
+        lines += _combo_replay_check(state, device, gen)
+    except Exception as e:
+        state["w13_t1"], state["wg_align2"] = "master", 0
+        state["sm_mode"] = {rep: SM_MASTER for _, _, rep in SM_BANDS}
+        lines.append(f"{COMBO_TAG} replay check raised {type(e).__name__}: {str(e)[:200]}; every combo class = master")
+    phases["replay"] = time.perf_counter() - t0
+    if "wg_err" in state:
