+FSI_IQR_FLOOR_US = 0.5           # absolute floor on the incumbent's spread: a timer-resolution IQR must not veto a win
+FSI_ERR_FACTOR = 2.0             # aggregate bound: max(FSI_ERR_FACTOR x master's own error, FSI_ERR_FLOOR)
