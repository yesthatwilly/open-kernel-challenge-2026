+FSI_MIN_TOKENS = 9
+FSI_MAX_TOKENS = 32
+FSI_CLASSES = ((0, 9, 16, 16, "9..16"), (1, 17, 32, 32, "17..32"))  # (class, lo, hi, judged T, label)
+FSI_VARIANTS = ((2, 4), (4, 4), (2, 1), (4, 1))  # (NT, CL): KC = 64 NT columns per unit, cluster size CL
+FSI_XS_ROWS = 1280               # token-slab scratch rows (>= 32 * 8 + 32 * 31 = 1248 sorted slots at T = 32)
+FSI_MAGIC = 0x46534931           # block 0 of fsi_midt_kernel writes it into fsi_err[1] (the launch marker)
