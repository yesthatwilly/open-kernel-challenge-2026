+// Bounded wait: after 2^26 cycles without the phase, record `code` in the error word and stop waiting
+// (dead), so a broken pipeline ends in a failed self-check instead of a hang. Applies to the ring
+// barriers (code 1) and the cluster barriers (code 3) alike.
+__device__ __forceinline__ void mbar_wait(uint32_t a, uint32_t parity, int* err, bool& dead, int code) {
+  if (dead || mbar_try(a, parity)) return;
+  const long long t0 = clock64();
+  while (!mbar_try(a, parity)) {
+    if (clock64() - t0 > (1ll << 26)) {
+      dead = true;
+      atomicExch(err, code);
+      return;
+    }
+  }
+}
+// Plain 1-D bulk copy: no createpolicy / .L2::cache_hint operand.
+__device__ __forceinline__ void bulk_g2s(uint32_t dst, const void* src, uint32_t bytes, uint32_t bar) {
