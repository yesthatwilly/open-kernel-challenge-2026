+_FSI_SRC_BODY = r"""
+// Fused split-I MoE for 9 <= T <= 32. Unit (expert e, chunk jc): jc = qd * CL + rank covers intermediate columns
+// [64 NT jc, 64 NT (jc + 1)). Phase 1: h[:, chunk] = silu(gate) * up over the full K = H for the 32 token rows of
+// e's block (swap-AB wgmma m64n32k16: dequantized weight rows as register A, the TMA'd token slab as B), kept in
+// shared memory as bf16 in SWIZZLE_128B K-major groups. Phase 2: for each H tile, y_partial[:, 128 rows] over the
+// chunk's K = 64 NT columns (the same wgmma with h as the shared-memory B operand), written to a double-buffered
+// fp32 tile; the CL CTAs of a cluster (CL consecutive chunks of the SAME expert) then each sum 128 / CL rows of the
+// tile across all CL partials through distributed shared memory, in rank order, and add them to y32[route] (real
+// routes only) with a global fp32 add. Every weight byte is read exactly once per call.
+template <int NT, int CL>
+__global__ void __launch_bounds__(THREADS, 1)
+fsi_midt_kernel(const __grid_constant__ CUtensorMap xmap,
+                const uint8_t* __restrict__ wq13,        // [E][NTILE13][KREC][REC]
+                const float* __restrict__ gs13,          // fp32 [E], global scale * 2^7
+                const uint8_t* __restrict__ wq2,         // [E][NTILE2][KREC][REC]
+                const float* __restrict__ gs2,           // fp32 [E], global scale * 2^7
+                const int* __restrict__ sorted_ids,      // block-32 align of the local ids
+                const int* __restrict__ block_experts,
+                const int* __restrict__ n_padded,
+                int blocks_len, int num_routes, int n_experts,
+                float* __restrict__ y32, int* __restrict__ err) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  using C = Cf<NT, CL>;
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  uint32_t rank = 0;
+  if (CL > 1) {
+    // A launch without the cluster attribute (or with another size) is refused uniformly by every CTA, before any
+    // cluster operation.
+    if (cluster_nctarank() != static_cast<uint32_t>(CL)) {
+      if (tid == 0) atomicExch(err, 4);
+      return;
+    }
+    rank = cluster_ctarank();
+  }
+  if (blockIdx.x == 0 && tid == 0) err[1] = FSI_MAGIC;
+  extern __shared__ __align__(1024) uint8_t smem_raw[];
+  __shared__ __align__(8) uint64_t bars[2 * C::STAGES + 2];
+  const uint32_t raw = smem_u32(smem_raw);
+  uint8_t* smem = smem_raw + ((1024u - (raw & 1023u)) & 1023u);
+  uint8_t* hbuf = smem + C::STAGES * C::STAGE_BYTES;
+  float* pbuf = reinterpret_cast<float*>(hbuf + C::HBYTES);
+  const uint32_t full0 = smem_u32(&bars[0]), empty0 = smem_u32(&bars[C::STAGES]);
+  const uint32_t cb0 = smem_u32(&bars[2 * C::STAGES]), cb1 = cb0 + 8;
+  if (tid == 0) {
+#pragma unroll
+    for (int s = 0; s < C::STAGES; ++s) {
+      mbar_init(full0 + 8 * s, 1);
+      mbar_init(empty0 + 8 * s, 8);  // one arrive per consumer warp
+    }
+    mbar_init(cb0, CL * 8);
+    mbar_init(cb1, CL * 8);
+    fence_barrier_init();
+  }
+  __syncthreads();
+  if (CL > 1) cluster_barrier_all();  // every CTA's barriers are initialised before any remote arrive
+
+  int nb = __ldg(n_padded) / 32;
+  nb = nb < blocks_len ? nb : blocks_len;
+  const int ngroups = nb * C::NQ;
+  const int cid = static_cast<int>(blockIdx.x) / CL, ncl = static_cast<int>(gridDim.x) / CL;
+  bool dead = false;
+
+  if (warp < 4) {
+    // Producer warpgroup: one thread streams every unit of this CTA, in the order the consumers consume them.
+    if (tid == 0) {
+      const uint64_t map = reinterpret_cast<uint64_t>(&xmap);
+      int n = 0;
+      for (int g = cid; g < ngroups; g += ncl) {
+        const int b = g / C::NQ, qd = g - b * C::NQ;
+        const int e = __ldg(block_experts + b);
+        if (e < 0 || e >= n_experts) continue;
+        const int jc = qd * CL + static_cast<int>(rank);
+        const int slot0 = b * 32;
+        for (int kb = 0; kb < KSTEPS13; ++kb, ++n) {  // w13: NT tiles x one 128-k pair, plus the token slab
+          const int s = n % C::STAGES;
+          mbar_wait(empty0 + 8 * s, ((n / C::STAGES) & 1) ^ 1, err, dead, 1);
+          const uint32_t st = smem_u32(smem + s * C::STAGE_BYTES);
+          const uint32_t fb = full0 + 8 * s;
+          mbar_expect_tx(fb, C::WSTAGE + 2 * SLAB);
+#pragma unroll
+          for (int t = 0; t < NT; ++t) {
+            const uint8_t* src = wq13 + ((static_cast<size_t>(e) * NTILE13 + jc * NT + t) * KREC + 2 * kb) * REC;
+            bulk_g2s(st + t * PAIR, src, PAIR, fb);
+          }
+          tma_2d(st + C::WSTAGE, map, kb * 128, slot0, fb);
+          tma_2d(st + C::WSTAGE + SLAB, map, kb * 128 + 64, slot0, fb);
+        }
+        for (int s2 = 0; s2 < NTILE2 / 2; ++s2, ++n) {  // w2: two H tiles x this chunk's NT records
+          const int s = n % C::STAGES;
+          mbar_wait(empty0 + 8 * s, ((n / C::STAGES) & 1) ^ 1, err, dead, 1);
+          const uint32_t st = smem_u32(smem + s * C::STAGE_BYTES);
+          const uint32_t fb = full0 + 8 * s;
+          mbar_expect_tx(fb, C::WSTAGE);
+#pragma unroll
+          for (int hh = 0; hh < 2; ++hh) {
+            const uint8_t* src = wq2 + ((static_cast<size_t>(e) * NTILE2 + 2 * s2 + hh) * KREC + jc * NT) * REC;
+            bulk_g2s(st + hh * NT * REC, src, NT * REC, fb);
+          }
+        }
+      }
+    }
+  } else {
+    const int ctid = tid - 128, cw = ctid >> 5;  // cw 0..7: this warp's 16 weight rows of a 128-row tile
+    const int g8 = lane >> 2, t4 = lane & 3;
+    const uint32_t hsm = smem_u32(hbuf);
+    int n = 0, ks = 0;
+    for (int g = cid; g < ngroups; g += ncl) {
+      const int b = g / C::NQ, qd = g - b * C::NQ;
+      const int e = __ldg(block_experts + b);
+      if (e < 0 || e >= n_experts) continue;
+      const int slot0 = b * 32;
+      // ---------------- phase 1: w13 + silu * up -> h (shared memory, bf16) ----------------
+      float acc[NT][16];
+#pragma unroll
+      for (int t = 0; t < NT; ++t) {
+#pragma unroll
+        for (int i = 0; i < 16; ++i) acc[t][i] = 0.f;
+      }
+      for (int kb = 0; kb < KSTEPS13; ++kb, ++n) {
+        const int s = n % C::STAGES;
+        mbar_wait(full0 + 8 * s, (n / C::STAGES) & 1, err, dead, 1);
+        const uint8_t* st = smem + s * C::STAGE_BYTES;
+        const uint32_t slab = smem_u32(st + C::WSTAGE);
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+          uint32_t a0[8][4];
+          dq_stage(st + t * PAIR, cw, lane, a0);
+          fence_acc<16>(acc[t]);
+          wgmma_fence();
+#pragma unroll
+          for (int r = 0; r < 2; ++r) {
+#pragma unroll
+            for (int k = 0; k < 4; ++k) Wg<32>::mma(acc[t], a0[r * 4 + k], make_desc(slab + r * SLAB + k * 32));
+          }
+          wgmma_commit();
+          wgmma_wait<0>();  // group retired: a0[] may be rewritten and the slab / stage released at once
+          fence_acc<16>(acc[t]);
+        }
+        if (lane == 0) mbar_arrive(empty0 + 8 * s);
+      }
+      named_bar(1, 256);  // the previous unit's wgmmas (h reads) and partial-tile reads are finished everywhere
+      {
+        const float gsc = __ldg(gs13 + e);
+        // acc[t][4i + 0/1]: gate (fragment row g8) tokens 8i + 2 t4, +1; acc[t][4i + 2/3]: up (row g8 + 8).
+        // h[token][64 t + 8 cw + g8], stored at the SWIZZLE_128B K-major address: 64-column group t (4096 B),
+        // token row n (128 B), 16-byte chunk (cw ^ (n & 7)), element g8.
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+#pragma unroll
+          for (int i = 0; i < 4; ++i) {
+            const int n0 = 8 * i + 2 * t4, n1 = n0 + 1;
+            const float v0 = silu_mul(acc[t][4 * i] * gsc, acc[t][4 * i + 2] * gsc);
+            const float v1 = silu_mul(acc[t][4 * i + 1] * gsc, acc[t][4 * i + 3] * gsc);
+            *reinterpret_cast<__nv_bfloat16*>(hbuf + t * SLAB + n0 * 128 + ((cw ^ (n0 & 7)) << 4) + g8 * 2) =
+                __float2bfloat16_rn(v0);
+            *reinterpret_cast<__nv_bfloat16*>(hbuf + t * SLAB + n1 * 128 + ((cw ^ (n1 & 7)) << 4) + g8 * 2) =
+                __float2bfloat16_rn(v1);
+          }
+        }
+      }
+      fence_proxy_async();  // generic-proxy h writes -> visible to the wgmma (async proxy) B reads
+      named_bar(1, 256);
+      // ---------------- phase 2: w2 over this chunk's K, cluster reduction into y32 ----------------
+      const float gsc2 = __ldg(gs2 + e);
+      for (int s2 = 0; s2 < NTILE2 / 2; ++s2, ++n) {
+        const int s = n % C::STAGES;
+        mbar_wait(full0 + 8 * s, (n / C::STAGES) & 1, err, dead, 1);
+        const uint8_t* st = smem + s * C::STAGE_BYTES;
+#pragma unroll
+        for (int hp = 0; hp < 2 / C::PT; ++hp) {
+#pragma unroll
+          for (int u = 0; u < C::PT; ++u) {
+            const int hh = hp * C::PT + u;
+            float a2[16];
+#pragma unroll
+            for (int i = 0; i < 16; ++i) a2[i] = 0.f;
+#pragma unroll
+            for (int pr = 0; pr < NT / 2; ++pr) {
+              uint32_t a0[8][4];
+              dq_stage(st + hh * NT * REC + pr * PAIR, cw, lane, a0);
+              fence_acc<16>(a2);
+              wgmma_fence();
+#pragma unroll
+              for (int r = 0; r < 2; ++r) {
+#pragma unroll
+                for (int k = 0; k < 4; ++k)
+                  Wg<32>::mma(a2, a0[r * 4 + k], make_desc(hsm + (pr * 2 + r) * SLAB + k * 32));
+              }
+              wgmma_commit();
+              wgmma_wait<0>();
+              fence_acc<16>(a2);
+            }
+            // Partial tile P[token][H row]: rows 16 cw + g8 (acc 4i, 4i+1) and 16 cw + g8 + 8 (acc 4i+2, 4i+3).
+            float* P = pbuf + ((ks & 1) * C::PT + u) * (32 * PP);
+            const int row0 = 16 * cw + g8;
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+              const int n0 = 8 * i + 2 * t4;
+              P[n0 * PP + row0] = a2[4 * i];
+              P[(n0 + 1) * PP + row0] = a2[4 * i + 1];
+              P[n0 * PP + row0 + 8] = a2[4 * i + 2];
+              P[(n0 + 1) * PP + row0 + 8] = a2[4 * i + 3];
+            }
+          }
+          if (hp == 2 / C::PT - 1) {
+            if (lane == 0) mbar_arrive(empty0 + 8 * s);  // the weights of this stage are all in registers
+          }
+          const int kk = ks;
+          tile_sync<CL>(cb0, cb1, kk, lane, err, dead);
+          ++ks;
+#pragma unroll
+          for (int u = 0; u < C::PT; ++u) {
+            const int ht = 2 * s2 + hp * C::PT + u;
+            const float* Pl = pbuf + ((kk & 1) * C::PT + u) * (32 * PP);
+            for (int it = ctid; it < 32 * (C::RPR / 4); it += 256) {
+              const int nn = it / (C::RPR / 4), f = it - nn * (C::RPR / 4);
+              const int row = static_cast<int>(rank) * C::RPR + f * 4;
+              const float* pl = Pl + nn * PP + row;
+              float4 sum;
+              if (CL == 1) {
+                sum = *reinterpret_cast<const float4*>(pl);
+              } else {
+                const uint32_t la = smem_u32(pl);
+                sum = ld_cluster_f4(mapa_u32(la, 0u));
+#pragma unroll
+                for (int q = 1; q < CL; ++q) {
+                  const float4 v = ld_cluster_f4(mapa_u32(la, static_cast<uint32_t>(q)));
+                  sum.x += v.x;
+                  sum.y += v.y;
+                  sum.z += v.z;
+                  sum.w += v.w;
+                }
+              }
+              const int sid = __ldg(sorted_ids + slot0 + nn);
+              if (sid >= 0 && sid < num_routes)
+                red_add4(y32 + static_cast<size_t>(sid) * HID + ht * 128 + row, sum.x * gsc2, sum.y * gsc2,
+                         sum.z * gsc2, sum.w * gsc2);
+            }
+          }
+        }
+        // (n advances in the for-increment)
+      }
+    }
+    // No CTA may exit while a peer can still read its partial tiles through distributed shared memory.
+    tile_sync<CL>(cb0, cb1, ks, lane, err, dead);
+  }
+#else
+  // Not the sm_90a image: no wgmma here. Flag it (error word 2) and do nothing else.
+  if (threadIdx.x == 0) atomicExch(err, 2);
+#endif
+}
+
+// xs[slot] = x[sorted_ids[slot] / 8] for the slots of local 32-row blocks (sentinel slots: zeros); slots past
+// n_padded and slots of remote (-1) blocks are skipped.
+__global__ void __launch_bounds__(256)
+fsi_midt_gather_kernel(const __nv_bfloat16* __restrict__ x, const int* __restrict__ sorted_ids,
+                       const int* __restrict__ block_experts, const int* __restrict__ n_padded, int num_routes,
+                       int n_experts, __nv_bfloat16* __restrict__ xs) {
+  const int slot = blockIdx.x;
+  if (slot >= __ldg(n_padded)) return;
+  const int be = __ldg(block_experts + slot / 32);
+  if (be < 0 || be >= n_experts) return;
+  const int sid = __ldg(sorted_ids + slot);
+  uint4* dst = reinterpret_cast<uint4*>(xs + static_cast<size_t>(slot) * HID);
+  const int nv = HID / 8;
+  if (sid >= 0 && sid < num_routes) {
+    const uint4* src = reinterpret_cast<const uint4*>(x + static_cast<size_t>(sid >> 3) * HID);
+    for (int v = threadIdx.x; v < nv; v += blockDim.x) dst[v] = __ldg(src + v);
+  } else {
+    const uint4 z = make_uint4(0u, 0u, 0u, 0u);
+    for (int v = threadIdx.x; v < nv; v += blockDim.x) dst[v] = z;
+  }
+}
+
+typedef CUresult (*EncodeTiledFn)(CUtensorMap*, CUtensorMapDataType, cuuint32_t, void*, const cuuint64_t*,
+                                  const cuuint64_t*, const cuuint32_t*, const cuuint32_t*, CUtensorMapInterleave,
+                                  CUtensorMapSwizzle, CUtensorMapL2promotion, CUtensorMapFloatOOBfill);
+
+// The ONLY file-scope variable: a host driver function pointer (resolved in fsi_init, outside any capture). No
+// device pointer, tensor map or buffer outlives a call: every fsi_run encodes its own tensor map into a
+// stack-local CUtensorMap from the tensor passed in THAT call.
+static EncodeTiledFn g_encode_pfn = nullptr;
+
+EncodeTiledFn get_encode() {
+  void* fn = nullptr;
+  cudaDriverEntryPointQueryResult q = cudaDriverEntryPointSymbolNotFound;
+#if CUDART_VERSION >= 12050
+  const cudaError_t e = cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &fn, 12000, cudaEnableDefault, &q);
+#else
+  const cudaError_t e = cudaGetDriverEntryPoint("cuTensorMapEncodeTiled", &fn, cudaEnableDefault, &q);
+#endif
+  if (e != cudaSuccess || q != cudaDriverEntryPointSuccess || fn == nullptr) {
+    (void)cudaGetLastError();
+    return nullptr;
+  }
+  return reinterpret_cast<EncodeTiledFn>(fn);
+}
+
+template <int NT, int CL>
+void info_one(std::vector<int64_t>& r, int sms) {
+  using C = Cf<NT, CL>;
+  const void* fn = reinterpret_cast<const void*>(fsi_midt_kernel<NT, CL>);
+  const cudaError_t e1 = cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, C::BYTES);
+  cudaFuncAttributes a{};
+  const cudaError_t e2 = cudaFuncGetAttributes(&a, fn);
+  int occ = 0;
+  const cudaError_t e3 = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, fn, THREADS, C::BYTES);
+  int ncl = 0;
+  cudaError_t e4 = cudaSuccess;
+  if (CL > 1) {
+    cudaLaunchConfig_t cfg{};
+    cfg.gridDim = dim3(static_cast<unsigned>((sms / CL) * CL));
+    cfg.blockDim = dim3(THREADS);
+    cfg.dynamicSmemBytes = C::BYTES;
+    cudaLaunchAttribute attr[1];
+    attr[0].id = cudaLaunchAttributeClusterDimension;
+    attr[0].val.clusterDim.x = CL;
+    attr[0].val.clusterDim.y = 1;
+    attr[0].val.clusterDim.z = 1;
+    cfg.attrs = attr;
+    cfg.numAttrs = 1;
+    e4 = cudaOccupancyMaxActiveClusters(&ncl, fn, &cfg);
+  } else {
+    ncl = occ * sms;
+  }
+  const bool ok = e1 == cudaSuccess && e2 == cudaSuccess && e3 == cudaSuccess && e4 == cudaSuccess;
+  if (!ok) (void)cudaGetLastError();
+  r.push_back(NT);
+  r.push_back(CL);
+  r.push_back(ok ? 1 : 0);
+  r.push_back(a.numRegs);
+  r.push_back(static_cast<int64_t>(a.localSizeBytes));
+  r.push_back(static_cast<int64_t>(a.sharedSizeBytes));
+  r.push_back(C::BYTES);
+  r.push_back(occ);
+  r.push_back(ncl);
+  r.push_back(static_cast<int64_t>(e1));
+  r.push_back(static_cast<int64_t>(e4));
+  r.push_back(a.binaryVersion);
+}
+
+template <int NT, int CL>
+void run_one(const CUtensorMap& xmap, torch::Tensor wq13, torch::Tensor gs13, torch::Tensor wq2, torch::Tensor gs2,
+             torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded, int num_routes,
+             torch::Tensor y32, torch::Tensor err, int grid) {
+  using C = Cf<NT, CL>;
+  auto stream = at::cuda::getCurrentCUDAStream();
+  cudaLaunchConfig_t cfg{};
+  cfg.gridDim = dim3(static_cast<unsigned>(grid));
+  cfg.blockDim = dim3(THREADS);
+  cfg.dynamicSmemBytes = C::BYTES;
+  cfg.stream = stream;
+  cudaLaunchAttribute attr[1];
+  attr[0].id = cudaLaunchAttributeClusterDimension;
+  attr[0].val.clusterDim.x = CL;
+  attr[0].val.clusterDim.y = 1;
+  attr[0].val.clusterDim.z = 1;
+  cfg.attrs = attr;
+  cfg.numAttrs = CL > 1 ? 1 : 0;
+  const cudaError_t le = cudaLaunchKernelEx(
+      &cfg, fsi_midt_kernel<NT, CL>, xmap, wq13.data_ptr<uint8_t>(), gs13.data_ptr<float>(),
+      wq2.data_ptr<uint8_t>(), gs2.data_ptr<float>(), sorted_ids.data_ptr<int>(), block_experts.data_ptr<int>(),
+      n_padded.data_ptr<int>(), static_cast<int>(block_experts.numel()), num_routes, static_cast<int>(gs13.numel()),
+      y32.data_ptr<float>(), err.data_ptr<int>());
+  TORCH_CHECK(le == cudaSuccess, "fsi_run: launch: ", cudaGetErrorString(le));
+}
+
+}  // namespace
+
+// Per variant (NT 2 / CL 4, NT 4 / CL 4, NT 2 / CL 1, NT 4 / CL 1), 12 values each: NT, CL, attribute and
+// occupancy calls ok, numRegs, localSizeBytes, static smem, dynamic smem, CTAs per SM, max co-resident clusters
+// (CL 1: CTAs), SetAttribute rc, ActiveClusters rc, binaryVersion.
+std::vector<int64_t> fsi_init() {
+  std::vector<int64_t> r;
+  if (g_encode_pfn == nullptr) g_encode_pfn = get_encode();
+  const int sms = at::cuda::getCurrentDeviceProperties()->multiProcessorCount;
+  info_one<2, 4>(r, sms);
+  info_one<4, 4>(r, sms);
+  info_one<2, 1>(r, sms);
+  info_one<4, 1>(r, sms);
+  return r;
+}
+
+void fsi_gather(torch::Tensor x, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+                int64_t num_routes, int64_t n_experts, torch::Tensor xs) {
+  TORCH_CHECK(x.is_contiguous() && xs.is_contiguous() && sorted_ids.is_contiguous() && block_experts.is_contiguous() &&
+              x.scalar_type() == at::kBFloat16 && xs.scalar_type() == at::kBFloat16 &&
+              sorted_ids.scalar_type() == at::kInt && block_experts.scalar_type() == at::kInt &&
+              n_padded.scalar_type() == at::kInt, "fsi_gather: layout");
+  TORCH_CHECK(x.size(1) == HID && xs.size(1) == HID && sorted_ids.numel() <= xs.size(0) &&
+              block_experts.numel() * 32 >= sorted_ids.numel(), "fsi_gather: sizes");
+  const int slots = static_cast<int>(sorted_ids.numel());
+  if (slots == 0) return;
+  auto stream = at::cuda::getCurrentCUDAStream();
+  fsi_midt_gather_kernel<<<slots, 256, 0, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(x.data_ptr()), sorted_ids.data_ptr<int>(), block_experts.data_ptr<int>(),
+      n_padded.data_ptr<int>(), static_cast<int>(num_routes), static_cast<int>(n_experts),
+      reinterpret_cast<__nv_bfloat16*>(xs.data_ptr()));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void fsi_run(int64_t nt, int64_t cl, torch::Tensor xs, torch::Tensor wq13, torch::Tensor gs13, torch::Tensor wq2,
+             torch::Tensor gs2, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+             int64_t num_routes, torch::Tensor y32, torch::Tensor err, int64_t grid) {
+  TORCH_CHECK(xs.is_cuda() && xs.is_contiguous() && xs.dim() == 2 && xs.scalar_type() == at::kBFloat16 &&
+              xs.size(0) > 0 && xs.size(1) == HID, "fsi_run: token-slab scratch layout");
+  TORCH_CHECK(wq13.is_contiguous() && wq2.is_contiguous() && gs13.is_contiguous() && gs2.is_contiguous() &&
+              sorted_ids.is_contiguous() && block_experts.is_contiguous() && y32.is_contiguous() &&
+              wq13.scalar_type() == at::kByte && wq2.scalar_type() == at::kByte &&
+              gs13.scalar_type() == at::kFloat && gs2.scalar_type() == at::kFloat &&
+              sorted_ids.scalar_type() == at::kInt && block_experts.scalar_type() == at::kInt &&
+              n_padded.scalar_type() == at::kInt && y32.scalar_type() == at::kFloat &&
+              err.scalar_type() == at::kInt && err.numel() >= 2, "fsi_run: layout");
+  const int64_t n_experts = gs13.numel();
+  TORCH_CHECK(gs2.numel() == n_experts && wq13.numel() == n_experts * NTILE13 * KREC * REC &&
+              wq2.numel() == n_experts * NTILE2 * KREC * REC, "fsi_run: weight bank size");
+  TORCH_CHECK(y32.dim() == 2 && y32.size(1) == HID && y32.size(0) >= num_routes, "fsi_run: y32 shape");
+  TORCH_CHECK(sorted_ids.numel() <= xs.size(0) && grid > 0, "fsi_run: sizes");
+  TORCH_CHECK((nt == 2 || nt == 4) && (cl == 1 || cl == 4) && grid % cl == 0, "fsi_run: variant");
+  EncodeTiledFn enc = g_encode_pfn;
+  if (enc == nullptr) {  // normally resolved by fsi_init in prepare
+    enc = get_encode();
+    g_encode_pfn = enc;
+  }
+  TORCH_CHECK(enc != nullptr, "fsi_run: cuTensorMapEncodeTiled entry point missing");
+  CUtensorMap xmap;
+  std::memset(&xmap, 0, sizeof(CUtensorMap));
+  {
+    const cuuint64_t dims[2] = {static_cast<cuuint64_t>(xs.size(1)), static_cast<cuuint64_t>(xs.size(0))};
+    const cuuint64_t strides[1] = {static_cast<cuuint64_t>(xs.size(1)) * 2};
+    const cuuint32_t box[2] = {64, 32};
+    const cuuint32_t es[2] = {1, 1};
+    const CUresult rc = enc(&xmap, CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, xs.data_ptr(), dims, strides, box, es,
+                            CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                            CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+    TORCH_CHECK(rc == CUDA_SUCCESS, "fsi_run: tensor map rc ", static_cast<int>(rc));
+  }
+  const int nr = static_cast<int>(num_routes), g = static_cast<int>(grid);
+  if (nt == 2 && cl == 4) run_one<2, 4>(xmap, wq13, gs13, wq2, gs2, sorted_ids, block_experts, n_padded, nr, y32, err, g);
+  else if (nt == 4 && cl == 4) run_one<4, 4>(xmap, wq13, gs13, wq2, gs2, sorted_ids, block_experts, n_padded, nr, y32, err, g);
+  else if (nt == 2) run_one<2, 1>(xmap, wq13, gs13, wq2, gs2, sorted_ids, block_experts, n_padded, nr, y32, err, g);
+  else run_one<4, 1>(xmap, wq13, gs13, wq2, gs2, sorted_ids, block_experts, n_padded, nr, y32, err, g);
+}
+"""
+
+
+def _fsi_src():
+    return _FSI_SRC_HEAD + _wg_wgmma_src() + _FSI_SRC_BODY
+
+
+@triton.jit
+def _fsi_combine_kernel(y_ptr, ids_ptr, tw_ptr, w_ptr, out_ptr, H, eps,
+                        TOP_K_C: tl.constexpr, BLOCK_H: tl.constexpr):
+    """out[t] = sum over local slots s of g[t, s] * rmsnorm(y[t, s] * (1 + w)) from the fsi kernel's FP32 y rows, master's
+    formula (all slot rows loaded as one [TOP_K_C, BLOCK_H] tile, as the hoisted post-norm kernel). Remote slots
+    (local id -1) are masked off the load: their y rows were never written and stay zero. The rows read are zeroed
+    after the read (the fsi kernel adds into zeros on the next call); a token with no local slot stores zeros."""
+    t = tl.program_id(0)
+    offs = tl.arange(0, BLOCK_H)
+    mask = offs < H
+    slots = tl.arange(0, TOP_K_C)
+    ids = tl.load(ids_ptr + t * TOP_K_C + slots)
+    gs = tl.load(tw_ptr + t * TOP_K_C + slots)
+    local = ids >= 0
+    nw = tl.load(w_ptr + offs, mask=mask, other=0.0).to(tl.float32) + 1.0
+    rows = (t * TOP_K_C + slots).to(tl.int64) * H
+    ptrs = y_ptr + rows[:, None] + offs[None, :]
+    m2 = local[:, None] & mask[None, :]
+    v = tl.load(ptrs, mask=m2, other=0.0) * nw[None, :]
+    r = tl.rsqrt(tl.sum(v * v, axis=1) / H + eps)
+    coef = tl.where(local, gs, 0.0) * r
+    acc = tl.sum(v * coef[:, None], axis=0)
+    tl.store(out_ptr + t.to(tl.int64) * H + offs, acc.to(tl.bfloat16), mask=mask)
+    tl.store(ptrs, tl.zeros([TOP_K_C, BLOCK_H], dtype=tl.float32), mask=m2)
+
+
+def _fsi_combine(y32, local_ids, topk_weights, post_norm_w, num_tokens, hidden):
+    """out [T, H] bf16 from y32 rows [T * 8, H] fp32 (zeroed again for the rows it read)."""
+    out = torch.empty((num_tokens, hidden), device=y32.device, dtype=torch.bfloat16)
+    _fsi_combine_kernel[(num_tokens,)](
+        y32, local_ids, topk_weights, post_norm_w, out, hidden, POST_NORM_EPS,
+        TOP_K_C=TOP_K, BLOCK_H=triton.next_power_of_2(hidden), num_warps=16)
+    return out
+
+
+def _fsi_class(num_tokens):
+    """The fsi T class (0: 9..16, 1: 17..32) of a token count, or None (T <= 8 and T >= 33 are master's). Shape only."""
+    if num_tokens < FSI_MIN_TOKENS or num_tokens > FSI_MAX_TOKENS:
+        return None
+    return 0 if num_tokens <= 16 else 1
+
+
+def _fsi_label(variant):
+    return f"KC{64 * variant[0]}/CL{variant[1]}"
+
+
+def _moe_fsi(x, topk_ids, topk_weights, bank, state, variant):
+    """The fused split-I path: master's _align_small at block 32, the gather, one fsi_midt_kernel launch, the fp32
+    combine. Everything it reads comes from `state` and this call's arguments (every scratch is per state; the
+    tensor map is encoded in C++ from THIS call's token slab)."""
+    num_tokens, hidden = x.shape
+    ext = state["fsi_ext"]
+    routes = num_tokens * TOP_K
+    tw = topk_weights.to(torch.float32).contiguous()
+    local_ids, (sorted_ids, block_experts, n_padded) = _align_small(topk_ids, bank["start"], bank["count"], 32)
+    ext.fsi_gather(x, sorted_ids, block_experts, n_padded, routes, bank["count"], state["fsi_xs"])
+    wb = state["wg_banks"][(bank["start"], bank["count"])]
+    ext.fsi_run(variant[0], variant[1], state["fsi_xs"], wb["q13"], wb["gs13"], wb["q2"], wb["gs2"], sorted_ids,
+                block_experts, n_padded, routes, state["fsi_y32"], state["fsi_err"], state["fsi_grid"][variant])
+    return _fsi_combine(state["fsi_y32"], local_ids, tw, state["post_norm_w"], num_tokens, hidden)
+
+
+def _fsi_build(red_mode):
+    """Compile the fsi module (prepare only, never during capture): (ext or None, error text). sm_90a only
+    (TORCH_CUDA_ARCH_LIST=9.0a around load_inline, -gencode compute_90a/sm_90a, -O3 -lineinfo); red_mode 1 uses
+    atomicAdd(float4*) for the global add, 0 four scalar adds."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    flags = list(WG_CUDA_CFLAGS) + [f"-DFSI_RED_MODE={red_mode}"]
+    name = f"{FSI_EXT_NAME}_red{red_mode}"
+    ext, err_text = None, ""
+    try:
+        from torch.utils import cpp_extension
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        try:
+            arch_flags = cpp_extension._get_cuda_arch_flags()
+        except Exception as e:  # this torch does not know the 'a' suffix: the guards + error word 2 decide
+            print(f"{FSI_TAG} TORCH_CUDA_ARCH_LIST=9.0a rejected ({e!r}); default list (error word 2 decides)", flush=True)
+            if prev is None:
+                os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+            else:
+                os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+            try:
+                arch_flags = cpp_extension._get_cuda_arch_flags()
+            except Exception as e2:
+                arch_flags = [f"<unknown: {e2!r}>"]
+        print(f"{FSI_TAG} build arch flags: TORCH_CUDA_ARCH_LIST={os.environ.get('TORCH_CUDA_ARCH_LIST')!r} -> "
+              f"{arch_flags}; extra_cuda_cflags {flags}", flush=True)
+        ext = load_inline(name=name, cpp_sources=_FSI_CPP, cuda_sources=_fsi_src(),
+                          functions=["fsi_init", "fsi_gather", "fsi_run"], extra_cuda_cflags=flags, verbose=False)
+    except Exception as e:  # keep master's path if the build fails
+        err_text = str(e)
+        ext = None
+        print(f"{FSI_TAG} load_inline {name} failed after {time.perf_counter() - t0:.1f}s: {err_text[-300:]!r}",
+              flush=True)
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    if ext is not None:
+        print(f"{FSI_TAG} load_inline {name} compiled in {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext, err_text
+
+
+def _fsi_routings(tokens, gen, local_set, device):
+    """Named routings [tokens, 8] int32 (global ids): 'zipf' (judge-like, this GPU's experts the busiest),
+    'random-local' (3 distinct random local + 5 distinct random remote experts per token), 'skewed-4hot' (4 hot
+    local experts take every token), 'one-expert' (one local expert with every token's route), 'all-remote'."""
+    remote = [e for e in range(N_EXPERTS) if e not in set(local_set)]
+    rl = []
+    for _ in range(tokens):
+        loc = [local_set[i] for i in torch.randperm(len(local_set), generator=gen)[:3].tolist()]
+        rem = [remote[i] for i in torch.randperm(len(remote), generator=gen)[:5].tolist()]
+        rl.append(loc + rem)
+    ar = [[remote[i] for i in torch.randperm(len(remote), generator=gen)[:TOP_K].tolist()] for _ in range(tokens)]
+    out = {
+        "zipf": _wg_zipf_ids(tokens, 0.9, gen, local_set),
+        "random-local": torch.tensor(rl, dtype=torch.int32),
+        "skewed-4hot": torch.tensor(_wg_routing("skewed-4hot", tokens, gen, local_set, remote), dtype=torch.int32),
+        "one-expert": torch.tensor(_wg_routing("all-one-expert", tokens, gen, local_set, remote), dtype=torch.int32),
+        "all-remote": torch.tensor(ar, dtype=torch.int32),
+    }
+    return {k: v.to(device).contiguous() for k, v in out.items()}
+
+
+def _fsi_data(tokens, ids, gen, device, cfg_base):
+    x = torch.randn((tokens, cfg_base["d_hidden"]), generator=gen).to(torch.bfloat16).to(device)
+    tw = torch.rand((tokens, TOP_K), generator=gen)
+    tw = (tw / tw.sum(-1, keepdim=True)).to(device)
+    return {"hidden_states": x, "topk_ids": ids, "topk_weights": tw, "config": dict(cfg_base, bs=tokens)}
+
+
+def _fsi_call(state, data, variant):
+    """kernel_fn on `data` with the fsi path forced to `variant` for this call's T class (None: master's path)."""
+    saved = state.get("fsi_sel", {})
+    cls = _fsi_class(data["hidden_states"].shape[0])
+    state["fsi_sel"] = {} if variant is None else {cls: variant}
+    try:
+        return kernel_fn(data, state)
+    finally:
+        state["fsi_sel"] = saved
+
+
+def _fsi_errs(out, ref):
+    """(aggregate rel-L2, worst per-row rel error with a near-zero row measured against a tenth of the average
+    row); inf for non-finite output. A zero reference needs a zero output."""
+    o, r = out.float(), ref.float()
+    if not bool(torch.isfinite(o).all()):
+        return float("inf"), float("inf")
+    d = (o - r).norm(dim=-1)
+    rn = r.norm(dim=-1)
+    floor = 0.1 * rn.mean()
+    tot = float(r.norm())
+    agg = float((o - r).norm()) / tot if tot > 0 else (0.0 if float((o - r).abs().max()) == 0.0 else float("inf"))
+    row = float((d / torch.maximum(rn, floor).clamp_min(1e-30)).max())
+    return agg, row
+
+
+def _fsi_graph_for(state, data, sel):
+    """Capture kernel_fn(data, state) with state['fsi_sel'] = sel (the captured launches keep it); returns the graph."""
+    saved = state.get("fsi_sel", {})
+    state["fsi_sel"] = sel
+    try:
+        graph, _ = _wg_graph_of(lambda: kernel_fn(data, state))
+    finally:
+        state["fsi_sel"] = saved
+    return graph
+
+
+def _fsi_quartiles(samples):
+    s = sorted(samples)
+    n = len(s)
+    return s[n // 2], s[n // 4], s[(3 * n) // 4]
+
+
+def _fsi_round(graphs, flush, empty, reps, rot):
+    """One interleaved cold-L2 round: every graph replayed `reps` times (order rotated by `rot`, flipped on odd reps),
+    the >= 256 MB flush written before EVERY replay, events around each replay, the empty-graph baseline's median
+    subtracted. Returns {name: (median us, q1, q3)}."""
+    names = list(graphs) + ["empty"]
+    allg = dict(graphs)
+    allg["empty"] = empty
+    samples = {n: [] for n in names}
+    for n in names:
+        allg[n].replay()
+    torch.cuda.synchronize()
+    for rep in range(reps):
+        k = (rep + rot) % len(names)
+        order = names[k:] + names[:k]
+        if rep % 2:
+            order = order[::-1]
+        for n in order:
+            flush.zero_()
+            s_, e_ = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+            s_.record()
+            allg[n].replay()
+            e_.record()
+            e_.synchronize()
+            samples[n].append(s_.elapsed_time(e_) * 1000.0)
+    base = _fsi_quartiles(samples["empty"])[0]
+    out = {}
+    for n in graphs:
+        med, q1, q3 = _fsi_quartiles(samples[n])
+        out[n] = (max(med - base, 0.0), q1 - base, q3 - base)
+    return out
+
+
+class _FsiSkip(Exception):
+    """A fsi phase could not start before its deadline."""
+
+
+def _fsi_parse_info(info, sms):
+    """The 12-value rows of ext.fsi_init() as dicts, plus each variant's grid (whole clusters, <= SM count)."""
+    rows = []
+    for i in range(0, len(info), 12):
+        nt, cl, ok, regs, local_bytes, static_smem, dyn_smem, occ, ncl, e1, e4, bin_v = info[i:i + 12]
+        grid = (min(ncl, sms // cl) * cl) if cl > 1 else min(ncl, sms)
+        rows.append({"v": (int(nt), int(cl)), "ok": bool(ok), "regs": regs, "local": local_bytes,
+                     "static": static_smem, "dyn": dyn_smem, "occ": occ, "ncl": ncl, "e1": e1, "e4": e4,
+                     "bin": bin_v, "grid": int(grid)})
+    return rows
+
+
+def _fsi_ref_case(state, bank, wref, data):
+    """(fp32-dequant reference output, master's output, master's (agg, row) errors) for one input."""
+    ref = _wg_ref_fp32(bank, state, wref, data["hidden_states"], data["topk_ids"], data["topk_weights"])
+    m_out = _fsi_call(state, data, None)
+    torch.cuda.synchronize()
+    return ref, m_out, _fsi_errs(m_out, ref)
+
+
+def _fsi_bounds(m_errs):
+    agg = max(FSI_ERR_FACTOR * m_errs[0], FSI_ERR_FLOOR)
+    return agg, FSI_ROW_FACTOR * agg
+
+
+def _fsi_units_text(v, row, a_experts):
+    nj = 64 // v[0]
+    units = a_experts * nj
+    return (f"{_fsi_label(v)}: active experts {a_experts} x {nj} chunks = {units} units on {row['grid']} CTAs "
+            f"({units / max(row['grid'], 1):.2f} waves), {row['ncl']} max co-resident {'clusters of ' + str(v[1]) if v[1] > 1 else 'CTAs'}, "
+            f"smem {row['static']}+{row['dyn']} B, regs {row['regs']}, spill {row['local']} B")
+
+
+def _fsi_diag(state, bank, device, flush, tokens, ids, cfg_base, rows, variants, gen):
+    """Kernel-only diagnostics at one T on one routing: gather, fsi kernel per variant (event time, TB/s of the
+    active experts' NVFP4 bytes, units / waves / co-resident clusters) and the combine, each cold-L2 and timed alone.
+    Returns printed lines. y32 is zeroed again after the kernel-only launches (they accumulate)."""
+    out = []
+    ext = state["fsi_ext"]
+    data = _fsi_data(tokens, ids, gen, device, cfg_base)
+    x, tw = data["hidden_states"], data["topk_weights"]
+    start, count = bank["start"], bank["count"]
+    local_ids, (sorted_ids, block_experts, n_padded) = _align_small(ids, start, count, 32)
+    routes = tokens * TOP_K
+    ext.fsi_gather(x, sorted_ids, block_experts, n_padded, routes, count, state["fsi_xs"])
+    torch.cuda.synchronize()
+    active = int(n_padded.item()) // 32
+    wb = state["wg_banks"][(start, count)]
+    t_align = _wg_med_cold(lambda: _align_small(ids, start, count, 32), flush)
+    t_gather = _wg_med_cold(lambda: ext.fsi_gather(x, sorted_ids, block_experts, n_padded, routes, count,
+                                                    state["fsi_xs"]), flush)
+    out.append(f"{FSI_TAG} DIAG T={tokens}: align(bsm 32) alone {t_align:.2f} us, gather alone {t_gather:.2f} us "
+               f"(active experts {active}, {active * FSI_EXPERT_BYTES / 1e6:.0f} MB of NVFP4 weights)")
+    for v in variants:
+        row = rows[v]
+        torch.cuda.synchronize()
+        print(f"{FSI_TAG}     [DIAG {_fsi_label(v)}] launching fsi kernel alone", flush=True)
+        t_k = _wg_med_cold(lambda v=v, row=row: ext.fsi_run(v[0], v[1], state["fsi_xs"], wb["q13"], wb["gs13"],
+                                                             wb["q2"], wb["gs2"], sorted_ids, block_experts, n_padded,
+                                                             routes, state["fsi_y32"], state["fsi_err"], row["grid"]),
+                           flush)
+        torch.cuda.synchronize()
+        print(f"{FSI_TAG}     [DIAG {_fsi_label(v)}] ok", flush=True)
+        state["fsi_y32"].zero_()
+        tbs = active * FSI_EXPERT_BYTES / max(t_k, 1e-3) / 1e6
+        out.append(f"{FSI_TAG} DIAG T={tokens} {_fsi_units_text(v, row, active)}; fsi kernel alone {t_k:.2f} us = "
+                   f"{tbs:.2f} TB/s")
+    t_comb = _wg_med_cold(lambda: _fsi_combine(state["fsi_y32"], local_ids, tw.to(torch.float32).contiguous(),
+                                                state["post_norm_w"], tokens, cfg_base["d_hidden"]), flush)
+    out.append(f"{FSI_TAG} DIAG T={tokens}: combine alone {t_comb:.2f} us (printed separately from the fsi kernel: the "
+               f"combine replaces master's post-norm kernel)")
+    state["fsi_y32"].zero_()
+    torch.cuda.synchronize()
+    return out
+
+
+def _fsi_gate_class(state, bank, device, flush, empty, cls_info, variants, cfg_base, t_prepare, lines):
+    """Two interleaved cold-L2 graph rounds of master's routed path against every viable variant, on the judge-like
+    (zipf) and the random-local routing at the class's judged T. A variant passes only if, in every round on both
+    routings, master median / its median >= FSI_MIN_SPEEDUP and its IQR <= FSI_IQR_FACTOR x master's. Returns
+    (winner variant or None, PATH CHOSEN line)."""
+    cls, lo, hi, tokens, label = cls_info
+    start, count = bank["start"], bank["count"]
+    local_set = list(range(start, start + count))
+    gen = torch.Generator().manual_seed(20261110 + tokens)
+    routs = _fsi_routings(tokens, gen, local_set, device)
+    fails = {}                                  # variant -> why
+    cell = {v: [] for v in variants}            # variant -> [(ratio, iqr ratio ok)] over routings x rounds
+    medians = {}                                # (routing, round) -> {name: (med, q1, q3)}
+    for r in FSI_ROUTINGS:
+        if time.perf_counter() - t_prepare > FSI_DEADLINES_S["timing"]:
+            raise _FsiSkip(f"timing not started: past {FSI_DEADLINES_S['timing']:.0f} s")
+        data = _fsi_data(tokens, routs[r], gen, device, cfg_base)
+        graphs = {"master": _fsi_graph_for(state, data, {})}
+        for v in variants:
+            if v in fails:
+                continue
+            try:
+                graphs[v] = _fsi_graph_for(state, data, {cls: v})
+            except Exception as e:
+                fails[v] = f"graph capture raised {type(e).__name__}: {str(e)[:120]}"
+        for rd in range(FSI_ROUNDS):
+            st = _fsi_round(graphs, flush, empty, FSI_REPS, 2 * rd + 1)
+            medians[(r, rd)] = st
+            m_med, m_q1, m_q3 = st["master"]
+            parts = [f"master {m_med:.2f} us [IQR {m_q3 - m_q1:.2f}]"]
+            for v in variants:
+                if v not in st:
+                    continue
+                med, q1, q3 = st[v]
+                ratio = m_med / max(med, 1e-3)
+                iqr_ok = (q3 - q1) <= FSI_IQR_FACTOR * max(m_q3 - m_q1, FSI_IQR_FLOOR_US)
+                cell[v].append((ratio, iqr_ok))
+                parts.append(f"{_fsi_label(v)} {med:.2f} us [IQR {q3 - q1:.2f}] x{ratio:.3f}{'' if iqr_ok else ' IQR-WIDE'}")
+            gate_line = (f"{FSI_TAG} GATE class={label} T={tokens} routing={r} round {rd + 1}/{FSI_ROUNDS}: "
+                         + "; ".join(parts))
+            print(gate_line, flush=True)
+            lines.append(gate_line)
+        del graphs
+        torch.cuda.synchronize()
+    scores = {}
+    for v in variants:
+        if v in fails:
+            continue
+        cs = cell[v]
+        ok = len(cs) == len(FSI_ROUTINGS) * FSI_ROUNDS and all(c[0] >= FSI_MIN_SPEEDUP and c[1] for c in cs)
+        scores[v] = (min(c[0] for c in cs), ok)
+        if not ok:
+            fails[v] = (f"min ratio {min(c[0] for c in cs):.3f} (need >= {FSI_MIN_SPEEDUP}); IQR ok "
+                        f"{all(c[1] for c in cs)}")
+    passing = [v for v in scores if scores[v][1]]
+    kernels = ("master = align + moe_wna16_marlin_gemm x2 + silu_and_mul + post-norm; fsi = _align_small(bsm 32) + "
+               "fsi_midt_gather_kernel + fsi_midt_kernel<NT,CL> + _fsi_combine_kernel")
+    if passing:
+        win = max(passing, key=lambda v: scores[v][0])
+        for key, st in medians.items():
+            assert st[win][0] < st["master"][0], f"fsi {label}: chosen {win} is not faster than master in {key}"
+        line = (f"{FSI_TAG} PATH CHOSEN class={label} (T={tokens}) = FSI {_fsi_label(win)}: worst cell master/fsi "
+                f"{scores[win][0]:.3f} (>= {FSI_MIN_SPEEDUP} in {FSI_ROUNDS} rounds x {len(FSI_ROUTINGS)} routings); "
+                f"others: " + ", ".join(f"{_fsi_label(v)} {'x%.3f' % scores[v][0] if v in scores else 'failed'}"
+                                        for v in variants if v != win) + f"; {kernels}")
+        return win, line
+    line = (f"{FSI_TAG} PATH CHOSEN class={label} (T={tokens}) = MASTER: no variant cleared {FSI_MIN_SPEEDUP}x with "
+            f"IQR <= {FSI_IQR_FACTOR}x in both rounds on both routings: "
+            + "; ".join(f"{_fsi_label(v)}: {fails.get(v, 'n/a')}" for v in variants) + f"; {kernels}")
+    return None, line
+
+
+def _fsi_copy_check(state, bank, device, wref, cfg_base):
+    """The judge prepares two states and rotates them: for every ON class (T = its lowest and its judged T) capture
+    kernel_fn as a graph on this state and on a tensor-cloning copy, alternate replays with refilled inputs on the
+    zipf and random-local routings, compare each against the fp32-dequant reference (the correctness bound) and
