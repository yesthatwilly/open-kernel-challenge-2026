+__device__ __forceinline__ uint32_t cluster_ctarank() {
+  uint32_t r;
+  asm volatile("mov.u32 %0, %%cluster_ctarank;\n" : "=r"(r));
+  return r;
+}
+__device__ __forceinline__ uint32_t cluster_nctarank() {
+  uint32_t r;
+  asm volatile("mov.u32 %0, %%cluster_nctarank;\n" : "=r"(r));
+  return r;
+}
+__device__ __forceinline__ void cluster_barrier_all() {  // every thread of every CTA of the cluster (kernel start only)
+  asm volatile("barrier.cluster.arrive.release.aligned;\n" ::: "memory");
+  asm volatile("barrier.cluster.wait.acquire.aligned;\n" ::: "memory");
+}
+__device__ __forceinline__ void fence_cluster() {
+  asm volatile("fence.acq_rel.cluster;\n" ::: "memory");
+}
+__device__ __forceinline__ uint32_t mapa_u32(uint32_t a, uint32_t rank) {
+  uint32_t r;
+  asm volatile("mapa.shared::cluster.u32 %0, %1, %2;\n" : "=r"(r) : "r"(a), "r"(rank));
+  return r;
+}
+__device__ __forceinline__ void mbar_arrive_cluster(uint32_t a) {  // a: a shared::cluster address (from mapa)
+  asm volatile("mbarrier.arrive.shared::cluster.b64 _, [%0];\n" :: "r"(a) : "memory");
+}
+__device__ __forceinline__ float4 ld_cluster_f4(uint32_t a) {
+  float4 v;
+  asm volatile("ld.shared::cluster.v4.f32 {%0, %1, %2, %3}, [%4];\n"
+               : "=f"(v.x), "=f"(v.y), "=f"(v.z), "=f"(v.w) : "r"(a) : "memory");
+  return v;
+}
+// Global fp32 add, result unused (a RED): one 16-byte vector add (FSI_RED_MODE 1) or four scalar adds.
+__device__ __forceinline__ void red_add4(float* p, float a, float b, float c, float d) {
+#if FSI_RED_MODE == 1
+  atomicAdd(reinterpret_cast<float4*>(p), make_float4(a, b, c, d));
+#else
+  atomicAdd(p, a);
+  atomicAdd(p + 1, b);
+  atomicAdd(p + 2, c);
+  atomicAdd(p + 3, d);
+#endif
+}
+// K-major SWIZZLE_128B shared-memory matrix descriptor (see the wgmma module: start >> 4, LBO 1, SBO 1024 B,
+// layout type 1). Every box base is 1024-aligned; the k16 advance of +32 B stays inside the first 128 B.
+__device__ __forceinline__ uint64_t make_desc(uint32_t saddr) {
+  return static_cast<uint64_t>((saddr & 0x3FFFFu) >> 4) | (static_cast<uint64_t>(1) << 16) |
+         (static_cast<uint64_t>(1024 >> 4) << 32) | (static_cast<uint64_t>(1) << 62);
+}
+
+// Dequant, verbatim from the wgmma module (exact E2M1 x E4M3 -> bf16 register A fragments).
+__device__ __forceinline__ void e4m3x4_to_f16x2x2(uint32_t w, uint32_t& lo, uint32_t& hi) {
+  asm("{\n\t.reg .b16 a, b;\n\tmov.b32 {a, b}, %2;\n\t"
+      "cvt.rn.f16x2.e4m3x2 %0, a;\n\tcvt.rn.f16x2.e4m3x2 %1, b;\n\t}\n"
+      : "=r"(lo), "=r"(hi) : "r"(w));
+}
+__device__ __forceinline__ uint32_t bf16x2_bcast(float v) {
+  __nv_bfloat162 b = __float2bfloat162_rn(v);
+  return *reinterpret_cast<uint32_t*>(&b);
+}
+__device__ __forceinline__ uint32_t mul_bf16x2(uint32_t a, uint32_t b) {
+  uint32_t d;
+  asm("fma.rn.bf16x2 %0, %1, %2, %3;\n" : "=r"(d) : "r"(a), "r"(b), "r"(0x80008000u));
+  return d;
+}
+__device__ __forceinline__ void dequant8(uint32_t q, uint32_t sg, uint32_t sg8, uint32_t (&a)[4]) {
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const uint32_t v = (q & 0x80008000u) | ((q & 0x70007000u) >> 6);
+    a[i] = mul_bf16x2(v, (i & 1) ? sg8 : sg);
+    q <<= 4;
+  }
+}
+// SGLang parity: Marlin writes gate and up as bf16, then silu_and_mul computes in fp32.
+__device__ __forceinline__ float silu_mul(float hg, float hu) {
+  hg = __bfloat162float(__float2bfloat16_rn(hg));
+  hu = __bfloat162float(__float2bfloat16_rn(hu));
+  return hg / (1.f + expf(-hg)) * hu;
+}
+
+// Dequantize one pipeline step (two 64-k records) of this warp's 16 weight rows into the 32 bf16x2 register-A
+// fragments (8 k16 steps x 4 registers). `st` points at the pair of records.
+__device__ __forceinline__ void dq_stage(const uint8_t* st, int cw, int lane, uint32_t (&a)[8][4]) {
+  const float P119 = __int_as_float(0x7B000000);  // 2^119
+  const int g = lane >> 2;
+#pragma unroll
+  for (int r = 0; r < 2; ++r) {
+    const uint4 q = *reinterpret_cast<const uint4*>(st + r * REC + cw * 512 + lane * 16);
+    const uint2 sc = *reinterpret_cast<const uint2*>(st + r * REC + REC_CODES + cw * 64 + g * 8);
+    uint32_t hs[4];
+    e4m3x4_to_f16x2x2(sc.x, hs[0], hs[1]);
+    e4m3x4_to_f16x2x2(sc.y, hs[2], hs[3]);
+    const uint32_t qw[4] = {q.x, q.y, q.z, q.w};
+#pragma unroll
+    for (int k = 0; k < 4; ++k) {
+      const float2 fs = __half22float2(*reinterpret_cast<const __half2*>(&hs[k]));
+      dequant8(qw[k], bf16x2_bcast(fs.x * P119), bf16x2_bcast(fs.y * P119), a[r * 4 + k]);
+    }
+  }
+}
+
+// One synchronisation of the consumer warpgroups after the partial-y tiles are written to shared memory.
+// CL == 1: a named barrier over the 256 consumer threads. CL > 1: a cluster barrier built from two alternating
+// mbarriers per CTA (count CL * 8: one arrive per consumer warp of every CTA), so the producer warpgroup never
+// takes part. Sync number ks uses barrier ks & 1, phase parity (ks >> 1) & 1. Release / acquire at cluster scope
+// come from fence.acq_rel.cluster around the (CUTLASS-form) mbarrier arrive / try_wait. The wait is bounded.
+template <int CL>
+__device__ __forceinline__ void tile_sync(uint32_t cb0, uint32_t cb1, int ks, int lane, int* err, bool& dead) {
+  if (CL == 1) {
+    named_bar(1, 256);
+    return;
+  }
+  fence_cluster();
+  __syncwarp();
+  const uint32_t bar = (ks & 1) ? cb1 : cb0;
+  if (lane == 0) {
+#pragma unroll
+    for (int q = 0; q < CL; ++q) mbar_arrive_cluster(mapa_u32(bar, static_cast<uint32_t>(q)));
+  }
+  mbar_wait(bar, (ks >> 1) & 1, err, dead, 3);
+  fence_cluster();
+}
