+constexpr int THREADS = 384;             // WG0 producer, WG1 + WG2 consumers
+constexpr int HID = 4096;                // H
+constexpr int INTER = 4096;              // I
+constexpr int REC = 4608;                // record: 4096 B codes + 512 B scales (one 128-row tile, one 64-k block)
+constexpr int REC_CODES = 4096;
+constexpr int PAIR = 2 * REC;            // two 64-k records = one 128-k pipeline step of one tile (9216 B)
+constexpr int SLAB = 64 * 32 * 2;        // one SWIZZLE_128B box of the token slab: 32 rows x 64 bf16 = 4096 B
+constexpr int PP = 132;                  // fp32 partial-y row pitch (128 H rows + 4 pad: conflict-free scatter)
+constexpr int NTILE13 = INTER / 64;      // w13 tiles per expert (64 gate + 64 up rows each)
+constexpr int NTILE2 = HID / 128;        // w2 tiles per expert (128 H rows each)
+constexpr int KREC = HID / 64;           // 64-k records along K (w13: K = H; w2: K = I; both 4096)
+constexpr int KSTEPS13 = HID / 128;      // w13 pipeline steps per tile
+constexpr int FSI_MAGIC = 0x46534931;    // block 0 writes it into err[1] (launch marker)
+
+// Per (NT, CL) geometry. NT = adjacent w13 tiles per unit (KC = 64 NT intermediate columns), CL = cluster size.
+template <int NT, int CL>
+struct Cf {
+  static constexpr int STAGES = (NT == 4) ? 3 : 5;
+  static constexpr int WSTAGE = NT * PAIR;                 // w13: NT pairs; w2: two H tiles x NT records
+  static constexpr int STAGE_BYTES = WSTAGE + 2 * SLAB;    // + the two token-slab boxes (w13 only)
+  static constexpr int PT = (NT == 2) ? 2 : 1;             // H tiles whose partials share one cluster sync
