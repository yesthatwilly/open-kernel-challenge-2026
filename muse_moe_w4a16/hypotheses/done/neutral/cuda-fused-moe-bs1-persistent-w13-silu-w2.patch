+void moe_bs1(torch::Tensor x, torch::Tensor ids, torch::Tensor tw, torch::Tensor c13, torch::Tensor s13,
+             torch::Tensor gs13, torch::Tensor c2, torch::Tensor s2, torch::Tensor gs2, torch::Tensor post_w,
+             torch::Tensor hbuf, torch::Tensor part, torch::Tensor ybuf, torch::Tensor ctrl, torch::Tensor out,
+             int64_t local_start, int64_t local_count, int64_t grid) {
+  const at::cuda::OptionalCUDAGuard guard(device_of(x));
+  auto stream = at::cuda::getCurrentCUDAStream();
+  moe_bs1_kernel<<<static_cast<int>(grid), THREADS, SMEM, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(x.data_ptr()), ids.data_ptr<int>(), tw.data_ptr<float>(),
+      c13.data_ptr<uint8_t>(), s13.data_ptr<uint8_t>(), gs13.data_ptr<float>(), c2.data_ptr<uint8_t>(),
+      s2.data_ptr<uint8_t>(), gs2.data_ptr<float>(), reinterpret_cast<const __nv_bfloat16*>(post_w.data_ptr()),
+      reinterpret_cast<__nv_bfloat16*>(hbuf.data_ptr()), part.data_ptr<float>(),
+      reinterpret_cast<__nv_bfloat16*>(ybuf.data_ptr()), ctrl.data_ptr<int>(),
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), static_cast<int>(local_start), static_cast<int>(local_count));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// Sets the dynamic smem limit (once, before any launch or capture) and returns
+// [numRegs, localSizeBytes, blocks per SM at SMEM, SMEM, STAGES, C_LEN, C_ERR].
+std::vector<int64_t> moe_bs1_info() {
+  C10_CUDA_CHECK(cudaFuncSetAttribute(moe_bs1_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, SMEM));
+  cudaFuncAttributes a;
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&a, moe_bs1_kernel));
+  int occ = 0;
+  C10_CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, moe_bs1_kernel, THREADS, SMEM));
+  return {a.numRegs, static_cast<int64_t>(a.localSizeBytes), occ, SMEM, STAGES, C_LEN, C_ERR};
+}
+"""
+
+
+def _build_fused():
+    """Compile the bs=1 CUDA module once per process, in prepare (never during graph capture)."""
+    t0 = time.perf_counter()
+    try:
+        from torch.utils.cpp_extension import load_inline
+        ext = load_inline(
+            name="muse_moe_w4a16_fused_bs1_v1",
+            cpp_sources=_FUSED_CPP,
+            cuda_sources=_FUSED_CUDA,
+            functions=["moe_bs1", "moe_bs1_info"],
+            extra_cuda_cflags=["-O3", "-arch=sm_90a"],
+            verbose=False,
+        )
+    except Exception as e:  # keep the master path if the build fails
+        print(f"[cuda-moe-bs1] load_inline failed after {time.perf_counter() - t0:.1f}s: {e!r}")
+        return None
+    print(f"[cuda-moe-bs1] load_inline compiled in {time.perf_counter() - t0:.1f}s")
+    return ext
+
+
+def _unpack_codes(packed):
+    """uint8 [..., K/2] -> uint8 [..., K] of 4-bit codes, element 2i from the low nibble."""
+    return torch.stack((packed & 0xF, packed >> 4), dim=-1).flatten(-2)
+
+
+def _frag_codes(codes):
+    """codes [T, 8 warp, 2 half, 8 g, K] (row in tile = 16 warp + 8 half + g) -> flat bytes in the
+    kernel's order [T][K/256][warp][sub 4][lane 32][16 B]: lane g*4+t, word s = k16 step, nibble
+    p = 4b + 2(1 - h8) + (1 - half) holds (row 8 half + g, k = 16 s + 8 h8 + 2t + b)."""
+    t_, k = codes.shape[0], codes.shape[-1]
+    c = codes.reshape(t_, 8, 2, 8, k // 256, 4, 4, 2, 4, 2).flip(2).flip(7)
+    c = c.permute(*FUSED_PERM).contiguous().view(-1, 8)
+    return (c[:, 0::2] | (c[:, 1::2] << 4)).flatten()
+
+
+def _unfrag_codes(b, shape):
+    """Inverse of _frag_codes, for the round-trip assert."""
+    t_, k = shape[0], shape[-1]
+    n = _unpack_codes(b.view(-1, 4)).view(t_, k // 256, 8, 4, 8, 4, 4, 2, 2, 2)
+    inv = [FUSED_PERM.index(i) for i in range(len(FUSED_PERM))]
+    return n.permute(*inv).flip(2).flip(7).reshape(shape)
+
+
+def _frag_scales(sf):
+    """e4m3 bytes [T, 8 warp, 2 half, 8 g, K/16] -> flat [T][K/256][warp][sub][g][step s][half]."""
+    t_, kb = sf.shape[0], sf.shape[-1] // 16
+    return sf.reshape(t_, 8, 2, 8, kb, 4, 4).permute(*FUSED_SC_PERM).contiguous().flatten()
+
+
+def _unfrag_scales(b, shape):
+    t_, kb = shape[0], shape[-1] // 16
+    inv = [FUSED_SC_PERM.index(i) for i in range(len(FUSED_SC_PERM))]
+    return b.view(t_, kb, 8, 4, 8, 4, 2).permute(*inv).reshape(shape)
+
+
+def _fused_repack(weights, start, count):
+    """Lossless mma-fragment repack of experts [start, start + count): codes and e4m3 scale bytes
+    are only moved (round-trip asserted per expert); global scales times 2^7 (exact)."""
+    hh = FUSED_H
+    t1 = hh // 64
+    w13, w13_sf, w2, w2_sf = weights["w13"], weights["w13_sf"], weights["w2"], weights["w2_sf"]
+    c13 = w13.new_empty((count, 2 * hh * hh // 2))
+    c2 = w2.new_empty((count, hh * hh // 2))
+    s13 = w13.new_empty((count, 2 * hh * hh // 16))
+    s2 = w2.new_empty((count, hh * hh // 16))
+    for e in range(count):
+        ge = start + e
+        codes = _unpack_codes(w13[ge])                                     # [2I, H]
+        rows = torch.stack((codes[:hh].reshape(t1, 8, 8, hh), codes[hh:].reshape(t1, 8, 8, hh)), dim=2)
+        c13[e] = _frag_codes(rows)
+        assert torch.equal(_unfrag_codes(c13[e], rows.shape), rows), "w13 code repack round trip"
+        sf = w13_sf[ge].view(torch.uint8)                                  # [2I, H/16]
+        srows = torch.stack((sf[:hh].reshape(t1, 8, 8, hh // 16), sf[hh:].reshape(t1, 8, 8, hh // 16)), dim=2)
+        s13[e] = _frag_scales(srows)
+        assert torch.equal(_unfrag_scales(s13[e], srows.shape), srows), "w13 scale repack round trip"
+        rows2 = _unpack_codes(w2[ge]).reshape(hh // 128, 8, 2, 8, hh)       # [H, I]
+        c2[e] = _frag_codes(rows2)
+        assert torch.equal(_unfrag_codes(c2[e], rows2.shape), rows2), "w2 code repack round trip"
+        sf2 = w2_sf[ge].view(torch.uint8).reshape(hh // 128, 8, 2, 8, hh // 16)
+        s2[e] = _frag_scales(sf2)
+        assert torch.equal(_unfrag_scales(s2[e], sf2.shape), sf2), "w2 scale repack round trip"
+    return {
+        "c13": c13, "s13": s13, "c2": c2, "s2": s2,
+        "gs13": (weights["w13_gs"][start:start + count].float() * 128.0).contiguous(),
+        "gs2": (weights["w2_gs"][start:start + count].float() * 128.0).contiguous(),
+    }
+
+
+def _fused_forward(data, fused):
+    """bs=1: the whole MoE in one launch of moe_bs1_kernel. Scratch and counters come from prepare;
+    the kernel leaves every counter at 0, so nothing carries between calls."""
+    x = data["hidden_states"].contiguous()
+    if x.data_ptr() % 16:  # pointer alignment for the 16 B loads (an address, not a value)
+        x = x.clone()
+    ids = data["topk_ids"].to(torch.int32).contiguous()
+    tw = data["topk_weights"].to(torch.float32).contiguous()
+    out = torch.empty((1, FUSED_H), dtype=torch.bfloat16, device=x.device)
+    fused["ext"].moe_bs1(x, ids, tw, fused["c13"], fused["s13"], fused["gs13"], fused["c2"], fused["s2"],
+                         fused["gs2"], fused["post_norm_w"], fused["hbuf"], fused["part"], fused["ybuf"],
+                         fused["ctrl"], out, fused["start"], fused["count"], fused["grid"])
+    return out
+
+
+def _fused_case(device, gen, n_local, start, count):
+    """Synthetic bs=1 input with exactly n_local local routes in random slots (prepare only)."""
+    local = [start + i for i in torch.randperm(count, generator=gen)[:n_local].tolist()]
+    pool = [e for e in range(N_EXPERTS) if not start <= e < start + count]
+    remote = [pool[i] for i in torch.randperm(len(pool), generator=gen)[:TOP_K - n_local].tolist()]
+    ids = local + remote
+    ids = [ids[i] for i in torch.randperm(TOP_K, generator=gen).tolist()]
+    w = torch.rand((1, TOP_K), generator=gen) + 0.05
+    return {
+        "hidden_states": torch.randn((1, FUSED_H), generator=gen).to(device=device, dtype=torch.bfloat16),
+        "topk_ids": torch.tensor([ids], dtype=torch.int32, device=device),
+        "topk_weights": (w / w.sum()).to(device),
+        "config": {"bs": 1, "d_hidden": FUSED_H, "d_expert": FUSED_H, "n_experts": N_EXPERTS,
+                   "local_start": start, "local_count": count, "top_k": TOP_K, "sharding": "ep8"},
+    }
+
+
+def _fp32_dequant(packed, sf, gs):
+    """Local NVFP4 decode (e2m1 grid, e4m3 block scales, fp32 global scale), fp32 [rows, K]."""
+    codes = _unpack_codes(packed).long()
+    grid = torch.tensor((0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0), device=packed.device)
+    v = torch.where((codes & 8) != 0, -grid[codes & 7], grid[codes & 7])
+    v = v.view(v.shape[0], -1, 16) * (sf.float() * gs.float())[..., None]
+    return v.flatten(-2)
+
+
+def _fp32_moe(data, weights, start, count):
+    """fp32 bs=1 MoE from the raw weights (self-check only)."""
+    x = data["hidden_states"].float()[0]
+    nw = weights["post_norm_w"].float() + 1.0
+    out = torch.zeros_like(x)
+    for s, e in enumerate(data["topk_ids"][0].tolist()):
+        if not start <= e < start + count:
+            continue
+        h = _fp32_dequant(weights["w13"][e], weights["w13_sf"][e], weights["w13_gs"][e]) @ x
+        gate, up = h[:FUSED_H], h[FUSED_H:]
+        y = _fp32_dequant(weights["w2"][e], weights["w2_sf"][e], weights["w2_gs"][e]) @ (torch.nn.functional.silu(gate) * up)
+        v = y * nw
+        out += data["topk_weights"][0, s].float() * v * torch.rsqrt(v.pow(2).mean() + POST_NORM_EPS)
+    return out[None]
+
+
+def _rel(out, ref):
+    ref = ref.float()
+    return float((out.float() - ref).norm() / ref.norm().clamp_min(1e-30))
+
+
+def _fused_setup(weights, state, start, count):
+    """Untimed, prepare() only: build, residency check, repack, self-check. Returns the fused-path
+    state, or None (bs=1 then runs master byte for byte)."""
+    tag = "[cuda-moe-bs1]"
+    device = weights["w13"].device
+    if weights["w13"].shape[1:] != (2 * FUSED_H, FUSED_H // 2) or weights["w2"].shape[1:] != (FUSED_H, FUSED_H // 2):
+        print(f"{tag} shapes differ from the built kernel; PATH CHOSEN = master")
+        return None
+    ext = _build_fused()
+    if ext is None:
+        print(f"{tag} SELF-CHECK FAILED (build); PATH CHOSEN = master")
+        return None
+    try:
+        regs, local_bytes, occ, smem, stages, ctrl_len, err_idx = ext.moe_bs1_info()
+        sms = torch.cuda.get_device_properties(device).multi_processor_count
+        print(f"{tag} regs {regs}, localSizeBytes {local_bytes}, smem {smem} B, stages {stages}, "
+              f"blocks/SM {occ}, SMs {sms}, grid {sms}")
+        assert occ >= 1, "moe_bs1_kernel cannot be resident at 1 CTA per SM"
+        t0 = time.perf_counter()
+        fused = _fused_repack(weights, start, count)
+        print(f"{tag} repack (round trip asserted) in {time.perf_counter() - t0:.1f}s")
+        fused.update({
+            "ext": ext, "start": start, "count": count, "grid": sms,
+            "post_norm_w": weights["post_norm_w"].clone(),  # fresh, 16 B aligned for the uint4 loads
+            "hbuf": torch.zeros((TOP_K, FUSED_H), dtype=torch.bfloat16, device=device),
+            "part": torch.zeros((4, TOP_K, FUSED_H), dtype=torch.float32, device=device),
+            "ybuf": torch.zeros((TOP_K, FUSED_H), dtype=torch.bfloat16, device=device),
+            "ctrl": torch.zeros((ctrl_len,), dtype=torch.int32, device=device),
+        })
+        gen = torch.Generator().manual_seed(20261024)
+        order = (2, 1, 8, 0, 3)
+        worst = 0.0
+        ok = True
+        # 50 back-to-back launches with R changing every call (counter reuse across R).
+        for rnd in range(10):
+            for n_local in order:
+                case = _fused_case(device, gen, n_local, start, count)
+                out = _fused_forward(case, fused)
+                if rnd == 0 and n_local == order[0]:
+                    torch.cuda.synchronize()
+                    if fused["ctrl"][err_idx].item():
+                        print(f"{tag} first launch hit a spin bound")
+                        ok = False
+                        break
+                # master never runs Marlin with zero blocks, so R=0 is checked for exact zeros only
+                ref = _master_kernel_fn(case, state) if n_local else None
+                if n_local == 0:
+                    good = bool((out == 0).all())
+                else:
+                    err = _rel(out, ref)
+                    worst = max(worst, err)
+                    good = err <= 1e-2 and bool(torch.isfinite(out).all())
+                if not good:
+                    print(f"{tag} mismatch round {rnd} R={n_local}")
+                    ok = False
+                    break
+            if not ok:
+                break
+        # One fp32-dequant reference from the raw weights (catches what Marlin would share).
+        for n_local in (1, 2):
+            case = _fused_case(device, gen, n_local, start, count)
+            e32 = _rel(_fused_forward(case, fused), _fp32_moe(case, weights, start, count))
+            em = _rel(_master_kernel_fn(case, state), _fp32_moe(case, weights, start, count))
+            print(f"{tag} R={n_local} vs fp32 dequant: fused {e32:.2e}, master {em:.2e}")
+            ok = ok and e32 <= 1e-2
+        # Graph capture + replays with R varying between replays.
+        static = _fused_case(device, gen, 2, start, count)
+        _fused_forward(static, fused)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            g_out = _fused_forward(static, fused)
+        for n_local in order + order:
+            case = _fused_case(device, gen, n_local, start, count)
+            for key in ("hidden_states", "topk_ids", "topk_weights"):
+                static[key].copy_(case[key])
+            graph.replay()
+            ref = _master_kernel_fn(case, state) if n_local else None
+            if n_local == 0:
+                good = bool((g_out == 0).all())
+            else:
+                err = _rel(g_out, ref)
+                worst = max(worst, err)
+                good = err <= 1e-2
+            if not good:
+                print(f"{tag} graph replay mismatch R={n_local}")
+                ok = False
+                break
+        torch.cuda.synchronize()
+        del graph
+        ctrl = fused["ctrl"].tolist()
+        if ctrl[err_idx]:
+            print(f"{tag} a spin wait hit its bound (error flag set)")
+            ok = False
+        if any(ctrl[:err_idx]):
+            print(f"{tag} counters not reset after the launches: {ctrl[:err_idx]}")
+            ok = False
+    except Exception as e:
+        print(f"{tag} self-check raised: {e!r}")
+        ok, worst = False, float("nan")
+    if not ok:
+        print(f"{tag} SELF-CHECK FAILED (max rel-L2 vs master {worst:.2e}); PATH CHOSEN = master")
+        return None
+    print(f"{tag} SELF-CHECK PASSED: 50 eager + 10 graph replays, R in {{0,1,2,3,8}}, max rel-L2 vs master "
+          f"{worst:.2e}; PATH CHOSEN = fused")
+    return fused
+
