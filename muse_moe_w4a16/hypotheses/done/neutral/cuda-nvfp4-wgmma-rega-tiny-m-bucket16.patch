+# ---------------------------------------------------------------------------------------------
+# Tiny-M wgmma path (hypothesis cuda-nvfp4-wgmma-rega-tiny-m-bucket16, rewrite stage 3): 1 <= num_tokens
+# <= WGT_MAX_TOKENS (7). A SEPARATE module (own load_inline name) with its own N16-only kernel
+# wgt_kernel<GATED>, so the K-split code stays out of stage 2's shared wg_kernel (stage 3 of the
+# sibling hypothesis edits that one). It reuses stage 2's PTX helper head (_WG_SRC_HEAD), the wgmma
+# N16 wrapper, the lossless weight retiling (_wg_bank, identical record layout) and nothing else.
+#
+# Launches per call: FIVE, as master's: _align_small (BSM 16, Triton) + wgt_gather + wgt_kernel<w13+
+# silu> + wgt_kernel<w2> + _post_norm_combine_kernel. (The change text said "two launches": those are
+# the two GEMM launches; the gather and align are still separate.)
+#
+# At 1..7 tokens an expert has at most 7 routes, so every local expert is exactly ONE 16-slot block and
+# an item is (block, 128-row tile, K slice). Review fixes applied (they override the spec):
+#  - 16 pipeline stages (13312 B each, ~213 KB) instead of stage 2's 4, N16-only slab (4 KB/stage);
+#  - register-A rule: wgmma_wait<0> after every stage's wgmmas, before the next dequant overwrites the
+#    A registers, plus register fences on A (stage 2's wait<1> + overwrite is PTX UB). The real
+#    register cap is 168 under __launch_bounds__(384, 1);
+#  - the K split S in {1, 2, 4, 8} is picked ON THE DEVICE from n_padded (the number of local experts
+#    is a routing value), minimising ceil(groups * S / grid) * (100 + 3 log2 S) * 8 / S. Partials go to
+#    an fp32 workspace; the last-arriving CTA of a (block, tile) group (per-group ticket, no spins)
+#    sums them in K-slice order and runs the epilogue. wgt_gather zeroes every ticket at the start of
+#    each call, so an aborted launch cannot poison the next replay; the last CTA also resets its ticket;
+#  - _align_small is called with BSM = 16 (master's bs <= 7 pick is 8), warmed for every T in prepare;
+#  - the prepare gate times this path against master's own path (_forward with w2_mode, i.e. WITH the
+#    w2 atomic add) as CUDA-graph replays with a >= 256 MB cold-L2 flush, interleaved A/B, and prints
+#    per-bucket p10/p50/p90 and one PATH CHOSEN line per bucket.
+# Stage 2's own 128..512-token path is dormant here (WG_S2_ENABLED): bs >= 8 is master byte for byte.
+# ---------------------------------------------------------------------------------------------
+
+WG_S2_ENABLED = False
+WGT_TAG = "[cuda-wgmma-tiny]"
+WGT_MAX_TOKENS = 7
+WGT_BSM = 16
+WGT_STAGES = 16
+WGT_CAP_ROWS = 640            # xs / h_sorted scratch rows (sorted_ids has at most 7 * 8 + 32 * 15 = 536 slots)
+WGT_MAXG = 2304
+WGT_WS_ITEMS = 2048
+WGT_KS = 32                   # K / 128 stages for both GEMMs (K = 4096)
+WGT_STAGE_BYTES = 2 * WG_REC + 2 * 16 * 128
+WGT_SMEM = 1024 + WGT_STAGES * WGT_STAGE_BYTES + 16 * (128 * 2 + 16)
+WGT_EXT_NAME = "muse_moe_w4a16_wgmma_tiny_v1"
+WGT_SETUP_BUDGET_S = 230.0    # from prepare()'s start: past it the remaining phases are skipped (path off)
+WGT_GATE_MARGIN = 0.97        # enable a bucket only if its p50 <= 97% of master's (>= 3% faster)
+WGT_GATE_REPS = 80
+WGT_FLUSH_BYTES = 320 << 20   # > L2 (50 MB) by far; the judge reads a buffer larger than L2 before each replay
+# bucket name -> (timed T values, T values it enables)
+WGT_BUCKETS = {"T=1": ((1,), (1,)), "T=2-7": ((4, 7), (2, 3, 4, 5, 6, 7))}
+WGT_CHECK_TOKENS = (1, 2, 4, 7)
