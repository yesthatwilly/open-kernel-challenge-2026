+_WGT_CPP = r"""
+#include <torch/extension.h>
+#include <vector>
+std::vector<int64_t> wgt_init();
+int64_t wgt_set_maps(torch::Tensor xs, torch::Tensor hs, torch::Tensor maps);
+void wgt_gather(torch::Tensor x, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+                int64_t num_routes, int64_t n_experts, int64_t grid, torch::Tensor xs, torch::Tensor tickets);
+void wgt_gemm(int64_t which, torch::Tensor maps, torch::Tensor wbank, torch::Tensor gs, torch::Tensor sorted_ids,
+              torch::Tensor block_experts, torch::Tensor n_padded, int64_t num_routes, int64_t n_tiles, int64_t K,
+              torch::Tensor out, torch::Tensor ws, torch::Tensor tickets, int64_t grid, int64_t force_split,
+              torch::Tensor err);
+"""
+
+_WGT_SRC_BODY = r"""
+// ---- tiny-M (1..7 tokens) N16-only path: own kernel, own module. One block of 16 slots per local
+// expert (<= 7 routes each), so an item is (block, 128-row tile, K split); no chunking, no buckets.
+constexpr int TS = 16;                         // pipeline stages (weights in flight per SM ~ (TS - 1) * 9216 B)
+constexpr int TSLAB = 16 * 128;                // one SWIZZLE_128B box: 16 token rows x 64 bf16 = 2048 B
+constexpr int TSTAGE = WST + 2 * TSLAB;        // 13312 = 13 * 1024
+constexpr int TEPI = 16 * PITCH2;              // staging tile (w2 pitch is the larger)
+constexpr int TSMEM = 1024 + TS * TSTAGE + TEPI;
+constexpr int KSPLIT_MAX = 8;
+constexpr int WS_ITEMS = 2048;                 // fp32 partial tiles (256 thr x 8 floats = 8 KB each)
+constexpr int MAXG = 2304;                     // (block, tile) groups: 34 blocks x 64 tiles = 2176 at most
+constexpr int NTICK = 2 * MAXG;                // one ticket row per GEMM (w13, w2)
+static_assert(TSTAGE % 1024 == 0, "stage alignment");
+static_assert(TSMEM + 4096 <= 227 * 1024, "shared memory budget");
+
+struct __align__(64) TMaps { CUtensorMap m[2]; };
+
+// K-split chosen ON THE DEVICE from the routing (the number of local experts is a device value):
+// minimise rounds * (100 + 3 log2 S) * (8 / S), where rounds = ceil(groups * S / grid). Integer
+// arithmetic, mirrored exactly by _wgt_pick_split on the host (prepare-time logging).
+__device__ __forceinline__ int pick_split(int groups, int grid, int KS, int force) {
+  if (force > 0) {
+    int s = force > KSPLIT_MAX ? KSPLIT_MAX : force;
+    while (s > 1 && ((s & (s - 1)) != 0 || KS % s != 0 || groups * s > WS_ITEMS)) s >>= 1;
+    return s;
+  }
+  int best = 1, bc = 0x7fffffff;
+  for (int s = 1; s <= KSPLIT_MAX; s <<= 1) {
+    if (KS % s != 0 || (s > 1 && groups * s > WS_ITEMS)) continue;
+    const int rounds = (groups * s + grid - 1) / grid;
+    const int k = s == 1 ? 0 : (s == 2 ? 1 : (s == 4 ? 2 : 3));
+    const int c = rounds * (100 + 3 * k) * (KSPLIT_MAX / s);
+    if (c < bc) { bc = c; best = s; }
+  }
+  return best;
+}
+
+// Keep the A registers live across the asynchronous wgmma that reads them.
+__device__ __forceinline__ void fence_a(uint32_t (&a)[8][4]) {
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+#pragma unroll
+    for (int k = 0; k < 4; ++k) asm volatile("" : "+r"(a[i][k]) :: "memory");
+  }
+}
+
+template <bool G>
+__device__ __forceinline__ void tiny_consume(int j, int ks, int S, int KSP, int e, int gidx, uint8_t* smem,
+                                             uint8_t* ep, uint32_t full0, uint32_t empty0, int& n, int cw, int lane,
+                                             int ctid, int slot0, const float* __restrict__ gs,
+                                             const int* __restrict__ sorted_ids, int num_routes,
+                                             __nv_bfloat16* __restrict__ out, int out_ld, float* __restrict__ ws,
+                                             int* __restrict__ tick, int* s_last, int* err, bool& dead) {
+  const float P119 = __int_as_float(0x7B000000);  // 2^119
+  const int g = lane >> 2;
+  float acc[8];
+#pragma unroll
+  for (int i = 0; i < 8; ++i) acc[i] = 0.f;
+  for (int kb = 0; kb < KSP; ++kb, ++n) {
+    const int s = n % TS;
+    mbar_wait(full0 + 8 * s, (n / TS) & 1, err, dead);
+    const uint8_t* st = smem + s * TSTAGE;
+    uint32_t a[8][4];
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+      const uint4 q = *reinterpret_cast<const uint4*>(st + r * REC + cw * 512 + lane * 16);
+      const uint2 sc = *reinterpret_cast<const uint2*>(st + r * REC + REC_CODES + cw * 64 + g * 8);
+      uint32_t hs[4];
+      e4m3x4_to_f16x2x2(sc.x, hs[0], hs[1]);
+      e4m3x4_to_f16x2x2(sc.y, hs[2], hs[3]);
+      const uint32_t qw[4] = {q.x, q.y, q.z, q.w};
+#pragma unroll
+      for (int k = 0; k < 4; ++k) {
+        const float2 fs = __half22float2(*reinterpret_cast<const __half2*>(&hs[k]));
+        dequant8(qw[k], bf16x2_bcast(fs.x * P119), bf16x2_bcast(fs.y * P119), a[r * 4 + k]);
+      }
+    }
+    const uint32_t slab = smem_u32(st + WST);
+    fence_acc<8>(acc);
+    fence_a(a);
+    wgmma_fence();
+#pragma unroll
+    for (int r = 0; r < 2; ++r) {
+#pragma unroll
+      for (int k = 0; k < 4; ++k) Wg<16>::mma(acc, a[r * 4 + k], make_desc(slab + r * TSLAB + k * 32));
+    }
+    wgmma_commit();
+    // Register-A rule: the A registers are overwritten by the next stage's dequant, so the group
+    // that reads them must be fully retired first (wait<0>, never wait<1>). The stage is released
+    // only after that, which also covers the shared-memory B operand.
+    wgmma_wait<0>();
+    fence_acc<8>(acc);
+    fence_a(a);
+    if (lane == 0) mbar_arrive(empty0 + 8 * s);
+  }
+
+  if (S > 1) {
+    // K split: publish this item's fp32 partial, take a ticket; the LAST arriving CTA of the group
+    // sums all S partials in K-slice order (own slice from registers) and runs the epilogue. No
+    // CTA ever waits for another. The last CTA resets the ticket; the gather kernel also zeroes
+    // every ticket at the start of each call, so an aborted launch cannot poison the next one.
+    float* mine = ws + (static_cast<size_t>(gidx * S + ks) * 256 + ctid) * 8;
+    *reinterpret_cast<float4*>(mine) = make_float4(acc[0], acc[1], acc[2], acc[3]);
+    *reinterpret_cast<float4*>(mine + 4) = make_float4(acc[4], acc[5], acc[6], acc[7]);
+    __threadfence();
+    named_bar(1, 256);
+    if (ctid == 0) *s_last = (atomicAdd(tick + gidx, 1) == S - 1) ? 1 : 0;
+    named_bar(1, 256);
+    if (*s_last == 0) return;
+    __threadfence();
+    float tot[8];
+#pragma unroll
+    for (int i = 0; i < 8; ++i) tot[i] = 0.f;
+    for (int k2 = 0; k2 < S; ++k2) {
+      float v[8];
+      if (k2 == ks) {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) v[i] = acc[i];
+      } else {
+        const float4* p = reinterpret_cast<const float4*>(ws + (static_cast<size_t>(gidx * S + k2) * 256 + ctid) * 8);
+        const float4 p0 = __ldcg(p), p1 = __ldcg(p + 1);
+        v[0] = p0.x; v[1] = p0.y; v[2] = p0.z; v[3] = p0.w;
+        v[4] = p1.x; v[5] = p1.y; v[6] = p1.z; v[7] = p1.w;
+      }
+#pragma unroll
+      for (int i = 0; i < 8; ++i) tot[i] += v[i];
+    }
+#pragma unroll
+    for (int i = 0; i < 8; ++i) acc[i] = tot[i];
+    if (ctid == 0) tick[gidx] = 0;
+  }
+
+  // Epilogue (stage 2's N16 mapping, i = 0): stage the bf16 tile through shared memory
+  // (stmatrix .trans: token rows), then coalesced 16-byte row stores. Barrier 1 = the 256 consumers.
+  const float gsc = __ldg(gs + e);
+  named_bar(1, 256);  // every consumer is done reading the previous item's staging tile
+  if (G) {
+    const uint32_t r0 = pack_bf16(silu_mul(acc[0] * gsc, acc[2] * gsc), silu_mul(acc[1] * gsc, acc[3] * gsc));
+    const uint32_t r1 = pack_bf16(silu_mul(acc[4] * gsc, acc[6] * gsc), silu_mul(acc[5] * gsc, acc[7] * gsc));
+    const int mi = (lane >> 3) & 1, rr = lane & 7;
+    const int tok = 8 * mi + rr;
+    stsm_x2_t(smem_u32(ep + tok * PITCH13 + cw * 16), r0, r1);
+  } else {
+    const uint32_t r0 = pack_bf16(acc[0] * gsc, acc[1] * gsc);
+    const uint32_t r1 = pack_bf16(acc[2] * gsc, acc[3] * gsc);
+    const uint32_t r2 = pack_bf16(acc[4] * gsc, acc[5] * gsc);
+    const uint32_t r3 = pack_bf16(acc[6] * gsc, acc[7] * gsc);
+    const int mi = lane >> 3, rr = lane & 7;
+    const int tok = 8 * (mi >> 1) + rr;
+    const int col = 16 * cw + 8 * (mi & 1);
+    stsm_x4_t(smem_u32(ep + tok * PITCH2 + col * 2), r0, r1, r2, r3);
+  }
+  named_bar(1, 256);
+  if (G) {
+    for (int v = ctid; v < 16 * 8; v += 256) {
+      const int t = v >> 3, c = v & 7;
+      const uint4 val = *reinterpret_cast<const uint4*>(ep + t * PITCH13 + c * 16);
+      *reinterpret_cast<uint4*>(out + static_cast<size_t>(slot0 + t) * out_ld + j * 64 + c * 8) = val;
+    }
+  } else {
+    for (int v = ctid; v < 16 * 16; v += 256) {
+      const int t = v >> 4, c = v & 15;
+      const int sid = __ldg(sorted_ids + slot0 + t);
+      if (sid >= 0 && sid < num_routes) {
+        const uint4 val = *reinterpret_cast<const uint4*>(ep + t * PITCH2 + c * 16);
+        *reinterpret_cast<uint4*>(out + static_cast<size_t>(sid) * out_ld + j * 128 + c * 8) = val;
+      }
+    }
+  }
+}
+
+template <bool G>
+__global__ void __launch_bounds__(THREADS, 1)
+wgt_kernel(const __grid_constant__ TMaps maps,
+           const uint8_t* __restrict__ wbank,        // [E][T][K/64][REC]
+           const float* __restrict__ gs,             // fp32 [E] global scale * 2^7
+           const int* __restrict__ sorted_ids,       // block-16 align of the local ids
+           const int* __restrict__ block_experts,
+           const int* __restrict__ n_padded,
+           int blocks_len, int num_routes, int n_tiles, int K, int n_experts,
+           __nv_bfloat16* __restrict__ out, int out_ld, float* __restrict__ ws, int* __restrict__ tick,
+           int force_split, int* __restrict__ err) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  extern __shared__ __align__(1024) uint8_t smem_raw[];
+  __shared__ __align__(8) uint64_t bars[2 * TS];
+  __shared__ int s_last;
+  const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+  const uint32_t raw = smem_u32(smem_raw);
+  uint8_t* smem = smem_raw + ((1024u - (raw & 1023u)) & 1023u);
+  uint8_t* ep = smem + TS * TSTAGE;
+  const uint32_t full0 = smem_u32(&bars[0]), empty0 = smem_u32(&bars[TS]);
+
+  int nb = __ldg(n_padded) / 16;
+  nb = nb < blocks_len ? nb : blocks_len;
+  const int nbcap = MAXG / n_tiles;
+  nb = nb < nbcap ? nb : nbcap;
+  if (tid == 0) {
+#pragma unroll
+    for (int s = 0; s < TS; ++s) {
+      mbar_init(full0 + 8 * s, 1);
+      mbar_init(empty0 + 8 * s, 8);  // one arrive per consumer warp
+    }
+    fence_barrier_init();
+  }
+  __syncthreads();
+
+  const int KS = K / BK;
+  const int groups = nb * n_tiles;
+  const int S = pick_split(groups, gridDim.x, KS, force_split);
+  const int KSP = KS / S;
+  const int total = groups * S;
+  if (blockIdx.x == 0 && tid == 0) err[G ? 1 : 2] = S;  // diagnostic: the split this launch used
+  bool dead = false;
+  if (warp < 4) {
+    asm volatile("setmaxnreg.dec.sync.aligned.u32 40;\n" ::: "memory");
+    if (tid == 0) {
+      const int KC = K / 64;
+      const uint64_t map = reinterpret_cast<uint64_t>(&maps.m[0]);
+      int n = 0;
+      for (int it = blockIdx.x; it < total; it += gridDim.x) {
+        const int gidx = it / S, ks = it - gidx * S;
+        const int b = gidx / n_tiles, j = gidx - b * n_tiles;
+        const int e = __ldg(block_experts + b);
+        if (e < 0 || e >= n_experts) continue;
+        const uint8_t* wsrc = wbank + (static_cast<size_t>(e) * n_tiles + j) * static_cast<size_t>(KC) * REC;
+        for (int kb = ks * KSP; kb < (ks + 1) * KSP; ++kb, ++n) {
+          const int s = n % TS;
+          mbar_wait(empty0 + 8 * s, ((n / TS) & 1) ^ 1, err, dead);
+          const uint32_t st = smem_u32(smem + s * TSTAGE);
+          const uint32_t fb = full0 + 8 * s;
+          mbar_expect_tx(fb, WST + 2 * TSLAB);
+          bulk_g2s(st, wsrc + static_cast<size_t>(kb) * WST, WST, fb);
+          tma_2d(st + WST, map, kb * BK, b * 16, fb);
+          tma_2d(st + WST + TSLAB, map, kb * BK + 64, b * 16, fb);
+        }
+      }
+    }
+  } else {
+    asm volatile("setmaxnreg.inc.sync.aligned.u32 232;\n" ::: "memory");
+    const int ctid = tid - 128, cw = ctid >> 5;
+    int n = 0;
+    for (int it = blockIdx.x; it < total; it += gridDim.x) {
+      const int gidx = it / S, ks = it - gidx * S;
+      const int b = gidx / n_tiles, j = gidx - b * n_tiles;
+      const int e = __ldg(block_experts + b);
+      if (e < 0 || e >= n_experts) continue;
+      tiny_consume<G>(j, ks, S, KSP, e, gidx, smem, ep, full0, empty0, n, cw, lane, ctid, b * 16, gs, sorted_ids,
+                      num_routes, out, out_ld, ws, tick, &s_last, err, dead);
+    }
+  }
+#else
+  if (threadIdx.x == 0) atomicExch(err, 2);
+#endif
+}
+
+// xs[slot] = x[sorted_ids[slot] / 8] for the slots of the local blocks (sentinel slots: zeros).
+// Block 0 also zeroes every ticket, so each call starts from clean tickets.
+__global__ void __launch_bounds__(256)
+wgt_gather_kernel(const __nv_bfloat16* __restrict__ x, const int* __restrict__ sorted_ids,
+                  const int* __restrict__ block_experts, const int* __restrict__ n_padded, int num_routes, int H,
+                  int n_experts, __nv_bfloat16* __restrict__ xs, int* __restrict__ tickets) {
+  if (blockIdx.x == 0) {
+    for (int i = threadIdx.x; i < NTICK; i += blockDim.x) tickets[i] = 0;
+  }
+  const int slot = blockIdx.x;
+  if (slot >= __ldg(n_padded)) return;
+  const int be = __ldg(block_experts + slot / 16);
+  if (be < 0 || be >= n_experts) return;
+  const int sid = __ldg(sorted_ids + slot);
+  uint4* dst = reinterpret_cast<uint4*>(xs + static_cast<size_t>(slot) * H);
+  const int nv = H / 8;
+  if (sid >= 0 && sid < num_routes) {
+    const uint4* src = reinterpret_cast<const uint4*>(x + static_cast<size_t>(sid >> 3) * H);
+    for (int v = threadIdx.x; v < nv; v += blockDim.x) dst[v] = __ldg(src + v);
+  } else {
+    const uint4 z = make_uint4(0u, 0u, 0u, 0u);
+    for (int v = threadIdx.x; v < nv; v += blockDim.x) dst[v] = z;
+  }
+}
+
+typedef CUresult (*EncodeTiledFn)(CUtensorMap*, CUtensorMapDataType, cuuint32_t, void*, const cuuint64_t*,
+                                  const cuuint64_t*, const cuuint32_t*, const cuuint32_t*, CUtensorMapInterleave,
+                                  CUtensorMapSwizzle, CUtensorMapL2promotion, CUtensorMapFloatOOBfill);
+
+// NO module globals: the judge prepares two states in one process and rotates them, and a captured
+// launch freezes the tensor-map addresses it was given. The encoded maps live in a per-state CPU
+// uint8 tensor (2 x TMaps, then the 2 row counts as int64) and are passed to every launch by value.
+constexpr int64_t MAPS_BYTES = 2 * static_cast<int64_t>(sizeof(TMaps)) + 2 * static_cast<int64_t>(sizeof(int64_t));
+
+EncodeTiledFn get_encode() {
+  void* fn = nullptr;
+  cudaDriverEntryPointQueryResult q = cudaDriverEntryPointSymbolNotFound;
+#if CUDART_VERSION >= 12050
+  const cudaError_t e = cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &fn, 12000, cudaEnableDefault, &q);
+#else
+  const cudaError_t e = cudaGetDriverEntryPoint("cuTensorMapEncodeTiled", &fn, cudaEnableDefault, &q);
+#endif
+  if (e != cudaSuccess || q != cudaDriverEntryPointSuccess || fn == nullptr) {
+    (void)cudaGetLastError();
+    return nullptr;
+  }
+  return reinterpret_cast<EncodeTiledFn>(fn);
+}
+
+template <bool G>
+void info_one(std::vector<int64_t>& r) {
+  const void* fn = reinterpret_cast<const void*>(wgt_kernel<G>);
+  const cudaError_t e1 = cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, TSMEM);
+  cudaFuncAttributes a{};
+  const cudaError_t e2 = cudaFuncGetAttributes(&a, fn);
+  int occ = 0;
+  const cudaError_t e3 = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, fn, THREADS, TSMEM);
+  if (e1 != cudaSuccess || e2 != cudaSuccess || e3 != cudaSuccess) (void)cudaGetLastError();
+  r.push_back(G ? 1 : 0);
+  r.push_back(e1 == cudaSuccess && e2 == cudaSuccess && e3 == cudaSuccess ? 1 : 0);
+  r.push_back(a.numRegs);
+  r.push_back(static_cast<int64_t>(a.localSizeBytes));
+  r.push_back(static_cast<int64_t>(a.sharedSizeBytes));
+  r.push_back(TSMEM);
+  r.push_back(occ);
+  r.push_back(static_cast<int64_t>(e1));
+  r.push_back(a.binaryVersion);
+  r.push_back(a.ptxVersion);
+}
+
+}  // namespace
+
+// Per instantiation (w13 then w2): gated, attribute calls ok, numRegs, localSizeBytes, static smem,
+// dynamic smem, occupancy (CTAs per SM), cudaFuncSetAttribute's error code, binaryVersion, ptxVersion.
+std::vector<int64_t> wgt_init() {
+  std::vector<int64_t> r;
+  info_one<true>(r);
+  info_one<false>(r);
+  return r;
+}
+
+// Encode the 2 tensor maps (xs, h_sorted; box 64 x 16, SWIZZLE_128B) over the persistent scratches.
+// Returns 0, or 1 when the driver entry point is missing, or 100 * (map + 1) + CUresult.
+int64_t wgt_set_maps(torch::Tensor xs, torch::Tensor hs, torch::Tensor maps) {
+  TORCH_CHECK(xs.is_cuda() && hs.is_cuda() && xs.dim() == 2 && hs.dim() == 2 && xs.is_contiguous() &&
+              hs.is_contiguous() && xs.scalar_type() == at::kBFloat16 && hs.scalar_type() == at::kBFloat16,
+              "wgt_set_maps: scratch layout");
+  TORCH_CHECK(!maps.is_cuda() && maps.is_contiguous() && maps.scalar_type() == at::kByte && maps.numel() == MAPS_BYTES,
+              "wgt_set_maps: maps must be a contiguous CPU uint8 tensor of MAPS_BYTES");
+  uint8_t* mp = maps.data_ptr<uint8_t>();
+  __builtin_memset(mp, 0, static_cast<size_t>(MAPS_BYTES));
+  EncodeTiledFn enc = get_encode();
+  if (enc == nullptr) return 1;
+  torch::Tensor src[2] = {xs, hs};
+  for (int w = 0; w < 2; ++w) {
+    const cuuint64_t dims[2] = {static_cast<cuuint64_t>(src[w].size(1)), static_cast<cuuint64_t>(src[w].size(0))};
+    const cuuint64_t strides[1] = {static_cast<cuuint64_t>(src[w].size(1)) * 2};
+    const cuuint32_t es[2] = {1, 1};
+    const cuuint32_t box[2] = {64, 16};
+    TMaps tm{};
+    const CUresult rc = enc(&tm.m[0], CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, src[w].data_ptr(), dims, strides,
+                            box, es, CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                            CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+    if (rc != CUDA_SUCCESS) return 100 * (w + 1) + static_cast<int64_t>(rc);
+    __builtin_memcpy(mp + w * sizeof(TMaps), &tm, sizeof(TMaps));
+    const int64_t rows = src[w].size(0);
+    __builtin_memcpy(mp + 2 * sizeof(TMaps) + w * sizeof(int64_t), &rows, sizeof(int64_t));
+  }
+  return 0;
+}
+
+void wgt_gather(torch::Tensor x, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+                int64_t num_routes, int64_t n_experts, int64_t grid, torch::Tensor xs, torch::Tensor tickets) {
+  TORCH_CHECK(x.is_contiguous() && xs.is_contiguous() && sorted_ids.is_contiguous() && block_experts.is_contiguous() &&
+              x.scalar_type() == at::kBFloat16 && xs.scalar_type() == at::kBFloat16 &&
+              sorted_ids.scalar_type() == at::kInt && block_experts.scalar_type() == at::kInt &&
+              n_padded.scalar_type() == at::kInt && tickets.scalar_type() == at::kInt, "wgt_gather: layout");
+  TORCH_CHECK(x.size(1) == xs.size(1) && x.size(1) % 8 == 0 && sorted_ids.numel() <= xs.size(0) &&
+              block_experts.numel() * 16 >= sorted_ids.numel() && tickets.numel() >= NTICK, "wgt_gather: sizes");
+  const int64_t slots = sorted_ids.numel();
+  int64_t g = grid < slots ? grid : slots;
+  if (g < 1) g = 1;
+  auto stream = at::cuda::getCurrentCUDAStream();
+  wgt_gather_kernel<<<static_cast<unsigned>(g), 256, 0, stream>>>(
+      reinterpret_cast<const __nv_bfloat16*>(x.data_ptr()), sorted_ids.data_ptr<int>(), block_experts.data_ptr<int>(),
+      n_padded.data_ptr<int>(), static_cast<int>(num_routes), static_cast<int>(x.size(1)),
+      static_cast<int>(n_experts), reinterpret_cast<__nv_bfloat16*>(xs.data_ptr()), tickets.data_ptr<int>());
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+void wgt_gemm(int64_t which, torch::Tensor maps, torch::Tensor wbank, torch::Tensor gs, torch::Tensor sorted_ids,
+              torch::Tensor block_experts, torch::Tensor n_padded, int64_t num_routes, int64_t n_tiles, int64_t K,
+              torch::Tensor out, torch::Tensor ws, torch::Tensor tickets, int64_t grid, int64_t force_split,
+              torch::Tensor err) {
+  TORCH_CHECK(which == 0 || which == 1, "wgt_gemm: which");
+  TORCH_CHECK(!maps.is_cuda() && maps.is_contiguous() && maps.scalar_type() == at::kByte && maps.numel() == MAPS_BYTES,
+              "wgt_gemm: maps must be this state's CPU uint8 tensor from wgt_set_maps");
+  const uint8_t* mp = maps.data_ptr<uint8_t>();
+  TMaps tm;
+  __builtin_memcpy(&tm, mp + which * sizeof(TMaps), sizeof(TMaps));
+  int64_t map_rows = 0;
+  __builtin_memcpy(&map_rows, mp + 2 * sizeof(TMaps) + which * sizeof(int64_t), sizeof(int64_t));
+  TORCH_CHECK(map_rows > 0, "wgt_gemm: tensor maps not encoded");
+  TORCH_CHECK(wbank.is_contiguous() && gs.is_contiguous() && sorted_ids.is_contiguous() &&
+              block_experts.is_contiguous() && out.is_contiguous() && ws.is_contiguous() && tickets.is_contiguous() &&
+              wbank.scalar_type() == at::kByte && gs.scalar_type() == at::kFloat &&
+              sorted_ids.scalar_type() == at::kInt && block_experts.scalar_type() == at::kInt &&
+              n_padded.scalar_type() == at::kInt && out.scalar_type() == at::kBFloat16 &&
+              ws.scalar_type() == at::kFloat && tickets.scalar_type() == at::kInt && err.scalar_type() == at::kInt,
+              "wgt_gemm: layout");
+  TORCH_CHECK(K % BK == 0 && block_experts.numel() * n_tiles <= MAXG && sorted_ids.numel() <= map_rows &&
+              ws.numel() >= static_cast<int64_t>(WS_ITEMS) * 2048 && tickets.numel() >= NTICK && err.numel() >= 4,
+              "wgt_gemm: sizes");
+  TORCH_CHECK(wbank.numel() == gs.numel() * n_tiles * (K / 64) * REC, "wgt_gemm: weight bank size");
+  TORCH_CHECK(out.size(1) == (which == 0 ? n_tiles * 64 : n_tiles * 128), "wgt_gemm: output width");
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const int blocks_len = static_cast<int>(block_experts.numel());
+  int* tick = tickets.data_ptr<int>() + which * MAXG;
+#define WGT_LAUNCH(G_)                                                                                        \
+  wgt_kernel<G_><<<static_cast<unsigned>(grid), THREADS, TSMEM, stream>>>(                                   \
+      tm, wbank.data_ptr<uint8_t>(), gs.data_ptr<float>(), sorted_ids.data_ptr<int>(),            \
+      block_experts.data_ptr<int>(), n_padded.data_ptr<int>(), blocks_len, static_cast<int>(num_routes),      \
+      static_cast<int>(n_tiles), static_cast<int>(K), static_cast<int>(gs.numel()),                           \
+      reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), static_cast<int>(out.size(1)), ws.data_ptr<float>(),  \
+      tick, static_cast<int>(force_split), err.data_ptr<int>())
+  if (which == 0) WGT_LAUNCH(true); else WGT_LAUNCH(false);
+#undef WGT_LAUNCH
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+"""
+
+
+def _wgt_src():
+    return _WG_SRC_HEAD + _wg_wgmma_src() + _WGT_SRC_BODY
+
+
+def _wgt_build():
+    """Compile the tiny module (prepare only, never during capture): (ext or None, error text).
+    sm_90a only, exactly as _wg_build: TORCH_CUDA_ARCH_LIST=9.0a around load_inline, restored after;
+    -std=c++20 -O3 -lineinfo and only -gencode compute_90a/sm_90a."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    flags = ["-std=c++20"] + list(WG_CUDA_CFLAGS)
+    ext, err_text = None, ""
+    try:
+        from torch.utils import cpp_extension
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        try:
+            arch_flags = cpp_extension._get_cuda_arch_flags()
+        except Exception as e:  # this torch does not know the 'a' suffix: default list + guards
+            print(f"{WGT_TAG} TORCH_CUDA_ARCH_LIST=9.0a rejected ({e!r}); default list (error word 2 decides)",
+                  flush=True)
+            if prev is None:
+                os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+            else:
+                os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+            try:
+                arch_flags = cpp_extension._get_cuda_arch_flags()
+            except Exception as e2:
+                arch_flags = [f"<unknown: {e2!r}>"]
+        print(f"{WGT_TAG} build arch flags: TORCH_CUDA_ARCH_LIST={os.environ.get('TORCH_CUDA_ARCH_LIST')!r} -> "
+              f"{arch_flags}; extra_cuda_cflags {flags}", flush=True)
+        ext = load_inline(
+            name=WGT_EXT_NAME,
+            cpp_sources=_WGT_CPP,
+            cuda_sources=_wgt_src(),
+            functions=["wgt_init", "wgt_set_maps", "wgt_gather", "wgt_gemm"],
+            extra_cuda_cflags=flags,
+            verbose=False,
+        )
+    except Exception as e:  # keep master's path if the build fails
+        err_text = str(e)
+        ext = None
+        print(f"{WGT_TAG} load_inline failed after {time.perf_counter() - t0:.1f}s: {err_text[:300]!r}", flush=True)
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    if ext is not None:
+        print(f"{WGT_TAG} load_inline compiled in {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext, err_text
+
+
+WGT_MAPS_BYTES = 2 * 256 + 2 * 8  # 2 x TMaps (each 2 x 128-B CUtensorMap, m[0] used) + 2 int64 row counts; C++ checks it
+
+
+def _wgt_scratch(ext, wb, hidden, inter, device):
+    """One state's tiny-path scratch: xs, h_sorted, fp32 split workspace, tickets, error words and the
+    tensor maps over THIS state's xs/hs (a CPU uint8 tensor passed by value at every launch, never a
+    module global: the judge prepares two states in one process and rotates them). Raises on an
+    encode failure."""
+    xs = torch.zeros((WGT_CAP_ROWS, hidden), dtype=torch.bfloat16, device=device)
+    hs = torch.zeros((WGT_CAP_ROWS, inter), dtype=torch.bfloat16, device=device)
+    maps = torch.zeros((WGT_MAPS_BYTES,), dtype=torch.uint8)
+    rc = ext.wgt_set_maps(xs, hs, maps)
+    if rc != 0:
+        raise RuntimeError(f"tensor-map encode failed: {rc}")
+    return {
+        "ext": ext, "bank": wb, "xs": xs, "hs": hs, "maps": maps,
+        "ws": torch.zeros((WGT_WS_ITEMS * 2048,), dtype=torch.float32, device=device),
+        "tick": torch.zeros((2 * WGT_MAXG,), dtype=torch.int32, device=device),
+        "err": torch.zeros((4,), dtype=torch.int32, device=device),
+        "grid": torch.cuda.get_device_properties(device).multi_processor_count,
+    }
+
+
+def _wgt_pick_split(groups, grid, ks, force=0):
+    """Host mirror of the device's pick_split (prepare-time logging and checks only)."""
+    if force > 0:
+        s = min(force, 8)
+        while s > 1 and ((s & (s - 1)) != 0 or ks % s != 0 or groups * s > WGT_WS_ITEMS):
+            s >>= 1
+        return s
+    best, bc = 1, 1 << 30
+    for s in (1, 2, 4, 8):
+        if ks % s != 0 or (s > 1 and groups * s > WGT_WS_ITEMS):
+            continue
+        rounds = (groups * s + grid - 1) // grid
+        k = {1: 0, 2: 1, 4: 2, 8: 3}[s]
+        c = rounds * (100 + 3 * k) * (8 // s)
+        if c < bc:
+            bc, best = c, s
+    return best
+
+
+def _moe_tiny(x, topk_ids, topk_weights, bank, state, force=0):
+    """out [M, H] for 1 <= M <= 7 on the tiny wgmma path: align (BSM 16), gather (+ ticket zeroing),
+    w13 + silu, w2, master's combine. Shape-only host logic; capturable. force: a K split for tests
+    (0 = the device's choice)."""
+    num_tokens, size_k = x.shape
+    size_n = bank["size_n"]
+    t = state["wgt"]
+    ext, wb = t["ext"], t["bank"]
+    topk_weights = topk_weights.to(torch.float32).contiguous()
+    local_ids, (sorted_ids, block_experts, n_padded) = _align_small(topk_ids, bank["start"], bank["count"], WGT_BSM)
+    routes = num_tokens * TOP_K
+    # at most min(routes, count) blocks are used (one per local expert): the gather grid covers them
+    ext.wgt_gather(x, sorted_ids, block_experts, n_padded, routes, bank["count"],
+                   WGT_BSM * min(routes, bank["count"]), t["xs"], t["tick"])
+    ext.wgt_gemm(0, t["maps"], wb["q13"], wb["gs13"], sorted_ids, block_experts, n_padded, routes, size_n // 64, size_k,
+                 t["hs"], t["ws"], t["tick"], t["grid"], force, t["err"])
+    cache3 = torch.empty((routes, size_k), device=x.device, dtype=x.dtype)
+    ext.wgt_gemm(1, t["maps"], wb["q2"], wb["gs2"], sorted_ids, block_experts, n_padded, routes, size_k // 128, size_n,
+                 cache3, t["ws"], t["tick"], t["grid"], force, t["err"])
+    y = cache3.view(num_tokens, TOP_K, size_k)
+    out = torch.empty((num_tokens, size_k), device=x.device, dtype=torch.bfloat16)
+    _post_norm_combine_kernel[(num_tokens,)](
+        y, local_ids, topk_weights, state["post_norm_w"], out, size_k, POST_NORM_EPS,
+        TOP_K_C=TOP_K, BLOCK_H=triton.next_power_of_2(size_k), num_warps=8)
+    return out
+
+
+def _wgt_data(bank, tokens, ids, gen, device):
+    """A synthetic Inputs dict (fixed generator) for the master path and the tiny path."""
+    hidden = 4096
+    tw = torch.rand((tokens, TOP_K), generator=gen)
+    return {
+        "hidden_states": torch.randn((tokens, hidden), generator=gen).to(torch.bfloat16).to(device),
+        "topk_ids": torch.tensor(ids, dtype=torch.int32, device=device),
+        "topk_weights": (tw / tw.sum(-1, keepdim=True)).to(device),
+        "config": {"bs": tokens, "d_hidden": hidden, "d_expert": hidden, "n_experts": N_EXPERTS,
+                   "local_start": bank["start"], "local_count": bank["count"], "top_k": TOP_K, "sharding": "ep8"},
+    }
+
+
+def _wgt_routings(tokens, local_set, remote_set, gen):
+    """name -> topk ids [tokens][8] (global ids; every id within a token distinct)."""
+    def remote(n):
+        return [remote_set[i] for i in torch.randperm(len(remote_set), generator=gen)[:n].tolist()]
+
+    def shuf(row):
+        return [row[i] for i in torch.randperm(len(row), generator=gen).tolist()]
+
+    hot = local_set[:12]
+    r_hot = min(8, 1 + tokens)
+    return {
+        "one-expert": [shuf([local_set[3]] + remote(7)) for _ in range(tokens)],
+        "skewed": [shuf(local_set[:r_hot] + remote(8 - r_hot)) for _ in range(tokens)],
+        "all-local": [shuf(local_set[:8]) for _ in range(tokens)],
+        "rand-local": [[hot[i] for i in torch.randperm(len(hot), generator=gen)[:8].tolist()] for _ in range(tokens)],
+        "random": [torch.randperm(N_EXPERTS, generator=gen)[:TOP_K].tolist() for _ in range(tokens)],
+        "all-remote": [remote(8) for _ in range(tokens)],
+    }
+
+
+def _wgt_reference(weights, bank, x, ids, tw, post_w, cache):
+    """fp32 reference of the whole op from the dequantised NVFP4 weights (no Marlin, no kernel)."""
+    start, count = bank["start"], bank["count"]
+    tokens, hidden = x.shape
+    inter = bank["size_n"]
+    ids_l = ids.tolist()
+    nw = post_w.float() + 1.0
+    out = torch.zeros((tokens, hidden), dtype=torch.float32, device=x.device)
+    for t in range(tokens):
+        for s in range(TOP_K):
+            e = ids_l[t][s]
+            if not (start <= e < start + count):
+                continue
+            if e not in cache:
+                cache[e] = (_wg_decode_nvfp4(weights["w13"][e], weights["w13_sf"][e], weights["w13_gs"][e]),
+                            _wg_decode_nvfp4(weights["w2"][e], weights["w2_sf"][e], weights["w2_gs"][e]))
+            w13f, w2f = cache[e]
+            h = w13f @ x[t].float()
+            hh = torch.nn.functional.silu(h[:inter]) * h[inter:]
+            v = (w2f @ hh) * nw
+            r = torch.rsqrt(v.pow(2).mean() + POST_NORM_EPS)
+            out[t] += tw[t, s].float() * v * r
+    return out
+
+
+def _wgt_err(out, ref):
+    """(aggregate rel-L2, worst per-token rel-L2) of out against ref; a token whose ref is 0 must be
+    exactly 0 (its error is then the absolute max); inf if out has a non-finite entry."""
+    out = out.float()
+    if not bool(torch.isfinite(out).all()):
+        return float("inf"), float("inf")
+    d = (out - ref).norm(dim=-1)
+    r = ref.norm(dim=-1)
+    rows = torch.where(r > 0, d / r.clamp_min(1e-30), (out - ref).abs().amax(dim=-1))
+    rn = float(ref.norm())
+    tot = float((out - ref).norm()) / rn if rn > 0 else float((out - ref).abs().max())
+    return tot, float(rows.max())
+
+
+def _wgt_self_check(weights, bank, state, device):
+    """Untimed, prepare() only, synthetic inputs. For T in (1, 2, 4, 7) x 6 routings (one expert, skewed,
+    all eight local, random among 12 local, uniform random, all remote) x forced K split (device's
+    choice, 1, 2, 4, 8): the tiny path's output against an fp32 dequant reference, with master's own
+    error against the same reference printed beside it; bound = max(2 x master's, 1e-2) in aggregate
+    and max(2 x master's, 4e-2) for the worst token. The device's choice and split 4 are also
+    captured as CUDA graphs and replayed 3x (tickets must come back clean); finally TWO states (own scratch + tensor maps)
+    each capture one graph per T, replayed alternately A/B with 6 routings refilled in place. Returns {T: ok}."""
+    gen = torch.Generator().manual_seed(20261031)
+    start, count = bank["start"], bank["count"]
+    local_set = list(range(start, start + count))
+    remote_set = [e for e in range(N_EXPERTS) if e not in local_set]
+    t = state["wgt"]
+    err = t["err"]
+    ok = {tk: True for tk in WGT_CHECK_TOKENS}
+    n_fail = 0
+    worst_ratio = 0.0
+    cache = {}
+    for tokens in WGT_CHECK_TOKENS:
+        for name, ids in _wgt_routings(tokens, local_set, remote_set, gen).items():
+            data = _wgt_data(bank, tokens, ids, gen, device)
+            x, topk_ids, tw = data["hidden_states"], data["topk_ids"], data["topk_weights"]
+            tag = f"T={tokens} {name}"
+            try:
+                ref = _wgt_reference(weights, bank, x, topk_ids, tw, state["post_norm_w"], cache)
+                m_out = _forward(data, state, state.get("w2_mode", "master"))
+                torch.cuda.synchronize()
+                m_tot, m_row = _wgt_err(m_out, ref)
+                b_tot, b_row = max(2 * m_tot, 1e-2), max(2 * m_row, 4e-2)
+                parts = []
+                case_ok = True
+                for force in (0, 1, 2, 4, 8):
+                    err.zero_()
+                    print(f"{WGT_TAG}     [{tag}] launching tiny path split={force or 'auto'}", flush=True)
+                    out = _moe_tiny(x, topk_ids, tw, bank, state, force)
+                    torch.cuda.synchronize()
+                    print(f"{WGT_TAG}     [{tag}] done split={force or 'auto'}", flush=True)
+                    ev = err.tolist()
+                    if ev[0]:
+                        state["wgt"]["tick"].zero_()
+                        print(f"{WGT_TAG}   device error word {ev[0]} ({WG_ERR_TEXT.get(ev[0], '?')}) at {tag}; "
+                              f"aborting self-check", flush=True)
+                        return {tk: False for tk in WGT_CHECK_TOKENS}
+                    n_tot, n_row = _wgt_err(out, ref)
+                    if ref.norm() == 0:
+                        good = bool(torch.isfinite(out.float()).all()) and float(out.float().abs().max()) == 0.0
+                    else:
+                        good = n_tot <= b_tot and n_row <= b_row
+                    worst_ratio = max(worst_ratio, n_tot / max(m_tot, 1e-6)) if ref.norm() > 0 else worst_ratio
+                    s_used = "w13 S=%d w2 S=%d" % (ev[1], ev[2])
+                    parts.append(f"{force or 'auto'}[{s_used}] {n_tot:.1e}/{n_row:.1e}{'' if good else ' FAIL'}")
+                    case_ok = case_ok and good
+                # graphs: the device's choice and a forced split of 4
+                for force in (0, 4):
+                    err.zero_()
+                    g, g_out = _wgt_capture(lambda f=force: _moe_tiny(x, topk_ids, tw, bank, state, f))
+                    for _ in range(3):
+                        g.replay()
+                    torch.cuda.synchronize()
+                    ev = err.tolist()
+                    eager = _moe_tiny(x, topk_ids, tw, bank, state, force)
+                    torch.cuda.synchronize()
