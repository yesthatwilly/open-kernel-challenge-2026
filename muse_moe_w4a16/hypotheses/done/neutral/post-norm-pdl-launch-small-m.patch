+def _launch_post_norm(y, ids, tw, w, out, H, tokens, use_pdl):
+    """Launch _post_norm_combine_kernel; with use_pdl as a programmatic dependent launch."""
+    extra = {"launch_pdl": True} if use_pdl else {}
+    _post_norm_combine_kernel[(tokens,)](
+        y, ids, tw, w, out, H, POST_NORM_EPS,
+        TOP_K_C=TOP_K, BLOCK_H=triton.next_power_of_2(H), USE_PDL=use_pdl, num_warps=8, **extra)
+
+
+def _pdl_self_test(device, post_norm_w):
+    """In-process (no child process) check that the PDL launch compiles, captures into a CUDA graph
+    and matches the plain launch. Never raises: any exception or mismatch returns (False, reason)."""
+    try:
+        H = post_norm_w.numel()
+        tokens = 2
+        g = torch.Generator(device=device)
+        g.manual_seed(0)
+        src = torch.randn((tokens, TOP_K, H), generator=g, device=device, dtype=torch.float32).to(torch.bfloat16)
+        ids = torch.randint(-1, 32, (tokens, TOP_K), generator=g, device=device, dtype=torch.int32)
+        tw = torch.rand((tokens, TOP_K), generator=g, device=device, dtype=torch.float32)
+        y = torch.zeros_like(src)
+        ref = torch.empty((tokens, H), device=device, dtype=torch.bfloat16)
+        out = torch.zeros_like(ref)
+        y.copy_(src)
+        _launch_post_norm(y, ids, tw, post_norm_w, ref, H, tokens, False)
+        # Warm up (compile) the PDL variant outside capture.
+        _launch_post_norm(y, ids, tw, post_norm_w, out, H, tokens, True)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            y.copy_(src)  # plain elementwise primary, then the dependent PDL launch
+            _launch_post_norm(y, ids, tw, post_norm_w, out, H, tokens, True)
+        for _ in range(3):
+            out.zero_()
+            graph.replay()
+            torch.cuda.synchronize()
+            if not torch.equal(out, ref):
+                return False, "graph replay mismatch vs plain launch"
+        return True, "self-test passed"
+    except Exception as e:  # any failure turns PDL off, never raises
+        return False, "self-test exception %s: %s" % (type(e).__name__, str(e)[:120].replace("\n", " "))
+
+
