+void wg_gemm(int64_t which, torch::Tensor wbank, torch::Tensor gs, torch::Tensor sorted_ids,
+             torch::Tensor block_experts, torch::Tensor n_padded, int64_t num_routes, int64_t n_tiles, int64_t K,
+             torch::Tensor out, int64_t grid, torch::Tensor err);
