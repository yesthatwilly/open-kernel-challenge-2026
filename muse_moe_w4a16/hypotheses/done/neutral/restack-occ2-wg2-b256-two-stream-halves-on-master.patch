+        if not passed[rep]:
+            lines.append(f"{TS_TAG} PATH CHOSEN band [{lo}, {hi}] rep T={rep} = master [{desc}] (H checks failed)")
+            continue
+        if elapsed() > COMBO_TS_TIMING_DEADLINE_S:
+            lines.append(f"{TS_TAG} PATH CHOSEN band [{lo}, {hi}] rep T={rep} = master [{desc}] (skipped: deadline, no "
+                         f"timing past {COMBO_TS_TIMING_DEADLINE_S:.0f}s)")
+            continue
+        res = _sm_time_band(state, device, gen, rep, bank, flush)
+        if res is None:
+            lines.append(f"{TS_TAG} PATH CHOSEN band [{lo}, {hi}] rep T={rep} = master [{desc}] (a graph capture failed)")
+            continue
+        gate_ok, low, text = _sel2_gate(res, "H", "master")
+        for t_ in text:
+            print(f"{TS_TAG} band [{lo}, {hi}] rep T={rep} {t_}", flush=True)
+        live = gate_ok
+        why = ""
+        if live:
+            # Warm every T of the band (the Triton align variants are per T) and check each against master.
+            try:
+                for t in range(lo, hi + 1):
+                    _align_small_halves(torch.full((t, TOP_K), bank["start"], dtype=torch.int32, device=device),
+                                        bank["start"], count, _block_size_m(t, count))
+                torch.cuda.synchronize()
+                g2 = torch.Generator().manual_seed(20261026 + rep)
+                for t in range(lo, hi + 1):
+                    for name in ("skewed", "all-local-saturated"):
+                        ids = _align2_routings(t, bank["start"], count, g2, device)[name]
+                        x, tw = _sm_xw(t, hidden, g2, device)
+                        ref = _sm_master(x, ids, tw, bank, state)[0].clone()
+                        out = _experts_two_stream(x, ids, tw, bank, state, poison=True)
+                        torch.cuda.synchronize()
+                        rel = _wg_rel(out, ref)
+                        if not rel <= SM_TOL:
+                            live, why = False, f"T={t} {name}: rel-L2 vs master {rel:.3g}"
+                            break
+                    if not live:
+                        break
+            except Exception as e:
+                live, why = False, f"band warm-up raised {type(e).__name__}: {str(e)[:120]}"
+        if live:
+            state["sm_mode"][rep] = 1
+        lines.append(f"{TS_TAG} PATH CHOSEN band [{lo}, {hi}] rep T={rep} = "
+                     + (f"{h_name}" if live else f"master [{desc}]")
+                     + f": lowest master/H {low:.3f} over skewed + judge rebuild x {SEL2_ROUNDS} rounds (ON needs "
+                       f"every round >= {SEL2_MIN_SPEEDUP} and H IQR <= {SEL2_IQR_FACTOR}x master's: {gate_ok}); "
+                       f"medians master/H {_sel2_brief(res, 'H', 'master')}; master = [{desc}]"
+                     + (f"; per-T check failed ({why})" if gate_ok and not live else ""))
+    del flush
+    torch.cuda.synchronize()
+    return lines
+
