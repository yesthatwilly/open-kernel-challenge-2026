+    for ln in lines:
+        print(ln, flush=True)
+    if bad:
+        return lines + master_all("halves align self-check failed")
+    reps = [rep for _, _, rep in TWO_STREAM_BANDS]
+    checks = {rep: [(name, ids) + _sm_xw(rep, hidden, gen, device)
+                    for name, ids in _sm_routings(rep, gen, device, bank).items()] for rep in reps}
+    refs = {rep: [_sm_master(x, ids, tw, bank, state)[0].clone() for _, ids, x, tw in checks[rep]] for rep in reps}
+    torch.cuda.synchronize()
+
+    def run_check(label, fn, rep):
+        worst = 0.0
+        for (name, ids, x, tw), ref in zip(checks[rep], refs[rep]):
+            print(f"{TS_TAG} launching {label} T={rep} {name}", flush=True)
+            out = fn(x, ids, tw).clone()
+            torch.cuda.synchronize()
