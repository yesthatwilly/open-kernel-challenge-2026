+        return lines + master_all("cross-half w2 wipe test failed")
+    passed = {}
+    for rep in reps:
+        worst, why = run_check("H", lambda x, ids, tw: _experts_two_stream(x, ids, tw, bank, state, poison=True), rep)
+        passed[rep] = not why
+        lines.append(f"{TS_TAG} H T={rep} (poisoned cache1 junk / cache3 NaN, w2 {state['sm_w2']}): worst rel-L2 vs "
+                     f"master {worst:.3g} " + ("ok" if not why else f"FAIL {why}"))
+        print(lines[-1], flush=True)
+    flush = torch.empty(WG_SEL_FLUSH_BYTES, dtype=torch.uint8, device=device)
+    for lo, hi, rep in TWO_STREAM_BANDS:
+        desc = _sm_master_desc(state, rep)
