+def _wg2_src():
+    """The wg2 module's CUDA source: master's wg head (helpers, wgmma wrappers) verbatim + the wg2 body."""
+    return _WG_SRC_HEAD + _wg_wgmma_src() + _WG2_SRC_BODY
+
+
+def _wg2_build(werror):
+    """Compile the wg2 module (prepare only): (ext or None, captured error text, arch flags). sm_90a only
+    (TORCH_CUDA_ARCH_LIST=9.0a around load_inline, restored after), -O3 -lineinfo; werror adds -Xptxas -Werror so
+    any ptxas warning (setmaxnreg's included) fails the build and its text becomes visible in-process."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    flags = list(WG_CUDA_CFLAGS) + (["-Xptxas", "-Werror"] if werror else [])
+    name = WG2_EXT_NAME + ("_werror" if werror else "")
+    ext, err_text, arch_flags = None, "", None
+    try:
+        from torch.utils import cpp_extension
+        from torch.utils.cpp_extension import load_inline
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        try:
+            arch_flags = cpp_extension._get_cuda_arch_flags()
+        except Exception as e:
+            arch_flags = [f"<rejected: {e!r}>"[:120]]
+        print(f"{WG2_TAG} build {name}: TORCH_CUDA_ARCH_LIST='9.0a' -> {arch_flags}; extra_cuda_cflags {flags}",
+              flush=True)
+        ext = load_inline(name=name, cpp_sources=_WG2_CPP, cuda_sources=_wg2_src(), functions=["wg2_init", "wg2_gemm"],
+                          extra_cuda_cflags=flags, verbose=False)
+    except Exception as e:
+        err_text = str(e)
+        ext = None
+        print(f"{WG2_TAG} load_inline {name} failed after {time.perf_counter() - t0:.1f}s: {err_text[:240]!r}",
+              flush=True)
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    if ext is not None:
+        print(f"{WG2_TAG} load_inline {name} compiled in {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext, err_text, arch_flags
+
