+def _align_halves_self_check(device, count):
+    """Untimed, prepare() only (ported from the source): for each half of _align_small_halves, per-expert
+    route sets and block counts against SGLang's moe_align_block_size(ref_local with the other half set to
+    -1, bsm, count), plus the full and per-half local_ids, on synthetic routings. Returns (cases, bad)."""
+    gen = torch.Generator().manual_seed(20261025)
+    half = count // 2
+    bad = []
+    cases = 0
+    for tokens in (8, 16, 24, 32):
+        for start in (0, 32, N_EXPERTS - count):
+            local_set = list(range(start, start + count))
+            remote_set = [e for e in range(N_EXPERTS) if e not in local_set]
+            rows = {
+                "random": [torch.randperm(N_EXPERTS, generator=gen)[:TOP_K].tolist() for _ in range(tokens)],
+                "skewed": [[local_set[0], local_set[count - 1], local_set[5]] +
+                           [remote_set[i] for i in torch.randperm(len(remote_set), generator=gen)[:5].tolist()]
+                           for _ in range(tokens)],
+                "all-remote": [[remote_set[i] for i in torch.randperm(len(remote_set), generator=gen)[:TOP_K].tolist()]
+                               for _ in range(tokens)],
+                "half-a-only": [local_set[0:8] for _ in range(tokens)],
+                "half-b-only": [local_set[half:half + 8] for _ in range(tokens)],
+                "all-local": [[local_set[i] for i in torch.randperm(count, generator=gen)[:TOP_K].tolist()]
+                              for _ in range(tokens)],
+            }
+            for name, ids in rows.items():
+                cases += 1
+                tag = f"T={tokens} local_start={start} {name}"
+                topk_ids = torch.tensor(ids, dtype=torch.int32, device=device)
+                bsm = _block_size_m(tokens, count)
+                local_ids, local_ids_h, triples = _align_small_halves(topk_ids, start, count, bsm)
+                ref_map = torch.full((N_EXPERTS,), -1, dtype=torch.int32, device=device)
+                ref_map[start:start + count] = torch.arange(count, dtype=torch.int32, device=device)
+                ref_local = ref_map[topk_ids].contiguous()
+                if not torch.equal(local_ids, ref_local):
+                    bad.append(f"{tag}: full local_ids differ")
+                    continue
+                numel = tokens * TOP_K
+                for h, (s_ids, b_exp, n_pad) in enumerate(triples):
+                    in_half = (ref_local >= h * half) & (ref_local < h * half + half)
+                    ref_h = torch.where(in_half, ref_local, torch.full_like(ref_local, -1)).contiguous()
+                    if not torch.equal(local_ids_h[h], ref_h.view(-1)):
+                        bad.append(f"{tag} half {h}: local_ids_h differ")
+                        continue
+                    r_ids, r_exp, r_pad = moe_align_block_size(ref_h, bsm, count)
+                    torch.cuda.synchronize()
+                    s_l, b_l, n_p = s_ids.tolist(), b_exp.tolist(), int(n_pad.item())
+                    r_l, re_l, r_p = r_ids.tolist(), r_exp.tolist(), int(r_pad.item())
+
+                    def per_expert(sorted_ids, block_experts, used):
+                        groups, blocks = {}, {}
+                        for b in range(used // bsm):
+                            e = block_experts[b]
+                            if e < 0:
+                                continue
+                            blocks[e] = blocks.get(e, 0) + 1
+                            groups.setdefault(e, []).extend(i for i in sorted_ids[b * bsm:(b + 1) * bsm] if i < numel)
+                        return groups, blocks
+
+                    mine, mine_blocks = per_expert(s_l, b_l, n_p)
+                    ref, ref_blocks = per_expert(r_l, re_l, r_p)
+                    if {e: sorted(v) for e, v in mine.items()} != {e: sorted(v) for e, v in ref.items()}:
+                        bad.append(f"{tag} half {h}: per-expert routes differ")
+                    if mine_blocks != ref_blocks or n_p != bsm * sum(ref_blocks.values()):
+                        bad.append(f"{tag} half {h}: blocks {mine_blocks} n_padded {n_p} vs SGLang "
+                                   f"{ref_blocks} {r_p}")
+                    used_blocks = n_p // bsm
+                    if any(e < h * half or e >= h * half + half for e in b_l[:used_blocks]) \
+                            or any(e != -1 for e in b_l[used_blocks:]) \
+                            or b_l[:used_blocks] != sorted(b_l[:used_blocks]):
+                        bad.append(f"{tag} half {h}: block_experts layout {b_l}")
+                    real = sum(len(v) for v in mine.values())
+                    if sum(1 for i in s_l if i == numel) != len(s_l) - real or any(i > numel for i in s_l):
+                        bad.append(f"{tag} half {h}: sorted_ids sentinel fill")
+    return cases, bad
+
+def _sm_cross_half(bank, state, device, gen, w2_mode):
+    """Review fix 2, serialized: per representative T and two routings, run both halves' w13 + silu, then
+    for each half h fill cache3 with junk, run ONLY half h's w2 Marlin call (w2_mode's kwargs, its own
+    workspace) and require every row half h does not own (the other half's routes and the remote routes)
+    to be bitwise unchanged, and half h's own rows to have changed. Returns (ok, detail)."""
+    size_n = bank["size_n"]
+    gemm1_n = 2 * size_n
+    hidden = state["post_norm_w"].numel()
+    n_cases = 0
+    for _, _, tokens in TWO_STREAM_BANDS:
+        for name in ("all-local-saturated", "judge-like"):
+            ids = _sm_routings(tokens, gen, device, bank)[name]
+            x, tw = _sm_xw(tokens, hidden, gen, device)
+            routes = tokens * TOP_K
+            bsm = _block_size_m(tokens, bank["count"])
+            _, local_ids_h, triples = _align_small_halves(ids, bank["start"], bank["count"], bsm)
+            cache1 = torch.zeros((2, routes, gemm1_n), device=device, dtype=torch.bfloat16)
+            cache2 = torch.zeros((2, routes, size_n), device=device, dtype=torch.bfloat16)
+            common = dict(moe_block_size=bsm, mul_topk_weights=False, is_ep=True,
+                          b_q_type=scalar_types.float4_e2m1f, is_k_full=True, use_atomic_add=False,
+                          use_fp32_reduce=True, is_zp_float=False)
+            for h in (0, 1):
+                s, b, n = triples[h]
+                moe_wna16_marlin_gemm(
+                    x, cache1[h], bank["w13"], None, bank["w13_s"], bank["w13_gs"], None, None, None,
+                    state["workspace"], s, b, n, tw, top_k=TOP_K, size_m=tokens, size_n=gemm1_n, size_k=hidden,
+                    **common)
+                silu_and_mul(cache1[h], cache2[h], expert_ids=local_ids_h[h], expert_step=1)
+            junk = torch.randn((routes, hidden), generator=gen).to(torch.bfloat16).to(device)
+            w2_kw = common if w2_mode == "master" else dict(common, use_atomic_add=True)
+            for h in (0, 1):
+                s, b, n = triples[h]
+                cache3 = junk.clone()
+                ws = state["workspace"] if h == 0 else state["sm_workspace_b"]
+                print(f"{TS_TAG} cross-half launching half {h} w2 alone ({w2_mode}) T={tokens} {name}", flush=True)
+                moe_wna16_marlin_gemm(
+                    cache2[h], cache3, bank["w2"], None, bank["w2_s"], bank["w2_gs"], None, None, None, ws,
+                    s, b, n, tw, top_k=1, size_m=routes, size_n=hidden, size_k=size_n, **w2_kw)
+                torch.cuda.synchronize()
+                print(f"{TS_TAG} cross-half done half {h} T={tokens} {name}", flush=True)
+                own = local_ids_h[h] >= 0
+                other = ~own
+                n_cases += 1
+                if not torch.equal(cache3[other], junk[other]):
+                    n_bad = int((cache3[other] != junk[other]).any(-1).sum())
+                    return False, (f"T={tokens} {name}: half {h}'s w2 ({w2_mode}) changed {n_bad} of "
+                                   f"{int(other.sum())} rows it does not own")
+                if bool(own.any()) and torch.equal(cache3[own], junk[own]):
+                    return False, f"T={tokens} {name}: half {h}'s w2 ({w2_mode}) left its own rows unwritten"
+    return True, f"{n_cases} half launches, other half's and remote rows bitwise unchanged"
+
+def _sm_master(x, topk_ids, topk_weights, bank, state):
+    """Master's routed small-M path as kernel_fn runs it right now (every landed flag as set)."""
+    return _moe_marlin(x, topk_ids, topk_weights, bank, state, state.get("w2_mode", "master"),
+                       state.get("w13_mode", "master"), state.get("d32_align", 0), state.get("d32_post_norm", 0))
+
+
+def _sm_master_desc(state, tokens):
+    """Kernel names of master's routed small-M path at `tokens` (for the PATH CHOSEN line). Shape and flags only."""
+    cls = _align2_class(tokens)
+    chunk = state["align2_ok"][cls] if cls is not None else 0
+    if state.get("d32_align", 0) and D32_ALIGN_MIN_TOKENS <= tokens <= D32_ALIGN_MAX_TOKENS:
+        align = "_align_parallel_kernel"
+    elif chunk:
+        align = f"_align2 chunk {chunk}"
+    else:
+        align = "_align_small_kernel" if tokens <= ALIGN_FUSED_MAX_TOKENS else "_align_parallel_kernel"
+    if tokens < SMALL_M_POST_NORM:
+        norm = "_post_norm_combine_kernel"
+    elif state.get("d32_post_norm", 0) and tokens == HOISTED_POST_NORM_TOKENS:
+        norm = "_post_norm_combine_hoisted_kernel"
+    else:
+        norm = "fused_post_expert_norm"
+    return f"Marlin w13+silu+w2 + {align} + {norm}"
+
+
+def _sm_routings(tokens, gen, device, bank):
+    """The six _align2_routings (the bank's local_start) plus the judge-like one rebuilt by _wg_judge_ids (C2's
+    port of reference.generate_input), name -> topk_ids on device."""
+    out = dict(_align2_routings(tokens, bank["start"], bank["count"], gen, device))
+    out["judge-like"] = _wg_judge_ids(tokens, gen, bank)[0].to(device).contiguous()
+    return out
+
+
+def _sm_xw(tokens, hidden, gen, device):
+    x = torch.randn((tokens, hidden), generator=gen).to(torch.bfloat16).to(device)
+    tw = torch.rand((tokens, TOP_K), generator=gen)
+    return x, (tw / tw.sum(-1, keepdim=True)).to(device)
+
+
+def _sm_time_band(state, device, gen, rep, bank, flush):
+    """Full kernel_fn, master's routed path (sm_mode[rep] = 0) against H (sm_mode[rep] = 1), each captured as a CUDA
+    graph (the fork / join included) on shared static inputs, timed by _sel2_time (cold L2, two interleaved rounds)
+    on the skewed routing and the _wg_judge_ids rebuild. Returns {routing: {'master': [...], 'H': [...]}} or None
+    if a capture failed."""
+    hidden = state["post_norm_w"].numel()
+    x = torch.zeros((rep, hidden), dtype=torch.bfloat16, device=device)
+    ids = torch.zeros((rep, TOP_K), dtype=torch.int32, device=device)
+    tw = torch.full((rep, TOP_K), 1.0 / TOP_K, dtype=torch.float32, device=device)
+    data = {"hidden_states": x, "topk_ids": ids, "topk_weights": tw,
+            "config": {"local_start": bank["start"], "local_count": bank["count"]}}
+    variants = {}
+    for name, on in (("master", 0), ("H", 1)):
+        st = dict(state)
+        st["sm_mode"] = dict(state["sm_mode"])
+        st["sm_mode"][rep] = on
+        variants[name] = st
+    routes = _sm_routings(rep, gen, device, bank)
+    res = {}
+    for routing in ("skewed", "judge-like"):
+        ids.copy_(routes[routing])
+        xx, ttw = _sm_xw(rep, hidden, gen, device)
+        x.copy_(xx)
+        tw.copy_(ttw)
+        graphs = {}
+        for name, st in variants.items():
+            try:
+                graphs[name] = _align2_graph(lambda st=st: kernel_fn(data, st), device)
+            except Exception as e:
+                print(f"{TS_TAG} T={rep} {routing}: {name} capture raised {type(e).__name__}: {str(e)[:160]}",
+                      flush=True)
+                return None
+        res[routing] = _sel2_time(graphs, device, flush)
+        del graphs
+    return res
+
+
+def _two_stream_phase(weights, state, device, t_prepare):
+    """H (two-stream expert halves), 8 <= T <= 32, per band, after the landed cells and C2. Halves align self-check
+    vs SGLang, the cross-half w2 wipe test, poisoned H runs (stacked cache1 junk, shared cache3 NaN) on six routings
+    plus the judge rebuild against master's routed path at each band's representative T, then per band a cold-L2
+    graph A/B of the full kernel_fn against master's routed path (two interleaved rounds on skewed + _wg_judge_ids,
+    ON only at >= SEL2_MIN_SPEEDUP every round with the IQR bound), a warm-up of the band's other T and a per-T
+    correctness pass. Sets state['sm_mode'][rep]. Returns lines (one PATH CHOSEN per band last)."""
+    bank = state["banks"][(0, 32)]
+    count = bank["count"]
+    hidden = state["post_norm_w"].numel()
+    lines = []
+    state["sm_mode"] = {rep: 0 for _, _, rep in TWO_STREAM_BANDS}
+
+    def elapsed():
+        return time.perf_counter() - t_prepare
+
+    def master_all(why):
+        return [f"{TS_TAG} PATH CHOSEN band [{lo}, {hi}] rep T={rep} = master ({why})"
+                for lo, hi, rep in TWO_STREAM_BANDS]
+
+    # The side stream and half B's Marlin lock workspace are created HERE, once, and held in the state (after
+    # master's _wg_setup and the C2 checks, whose deepcopy of the state never sees a stream).
