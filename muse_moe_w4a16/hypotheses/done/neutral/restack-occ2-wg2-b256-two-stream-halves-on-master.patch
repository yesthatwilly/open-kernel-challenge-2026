+def _c2_front(topk_ids, bank, fe):
+    """The wgmma front end of the current F2 flag for this bucket (kernel-only timing prints; the same three
+    branches as _moe_wgmma): 0 = expert_map gather + SGLang align, WG_ALIGN_PAR = _align_parallel, else align2."""
+    start, count = bank["start"], bank["count"]
+    if fe == WG_ALIGN_PAR:
+        return _align_parallel(topk_ids, start, count, WG_BSM)
+    if fe:
+        return _align_two_phase(topk_ids, start, count, WG_BSM, fe)
+    local_ids = bank["expert_map"][topk_ids.to(torch.int32)].contiguous()
+    return local_ids, moe_align_block_size(local_ids, WG_BSM, count)
