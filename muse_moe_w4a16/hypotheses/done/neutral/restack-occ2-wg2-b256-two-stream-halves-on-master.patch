+
+    # Cross-half w2 wipe test: the halves' w2 calls share one cache3 and must not touch each other's rows.
+    mode = state["sm_w2"]
+    ok, detail = _sm_cross_half(bank, state, device, gen, mode)
+    if not ok and mode != "master":
