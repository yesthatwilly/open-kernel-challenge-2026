+# ---------------------------------------------------------------------------------------------
+# H (ported from hyp/muse_moe_w4a16/combo-smallm-two-stream-halves-x-w13-splitk, job 9a455a2aae7842cb, mode H only):
+# the expert work of 8 <= T <= 32 split by local expert into half A (0-15, current stream) and half B (16-31, side
+# stream), each running w13 Marlin -> silu_and_mul -> w2 Marlin over its own routes with its own workspace. Its OWN
+# bound constants (LESSONS 137: nothing here is derived from ALIGN_FUSED_MAX_TOKENS or any constant master's align /
+# post-norm cells edit). state['sm_mode'] {band representative T: 0 master | 1 H}, set by _two_stream_phase.
+# ---------------------------------------------------------------------------------------------
+TS_TAG = "[two-stream]"
+TWO_STREAM_MIN_T = 8
+TWO_STREAM_MAX_T = 32
+TWO_STREAM_COUNT = 32     # local experts of the bank (EP8): 2 halves of 16
+TWO_STREAM_BANDS = ((8, 12, 8), (13, 24, 16), (25, 32, 32))   # (first T, last T, representative T); shape only
+assert TWO_STREAM_BANDS[0][0] == TWO_STREAM_MIN_T and TWO_STREAM_BANDS[-1][1] == TWO_STREAM_MAX_T
+SM_TOL = 1e-2
+# Row stride (int32 elements) of each half's sorted_ids in the stacked buffer, rounded up so each
+# half's slice starts 256-byte aligned for Marlin's vector loads of sorted_ids.
+HALF_SORTED_ALIGN = 64
+
+
+def _sm_band(num_tokens):
+    """The H band (its representative T) of a token count, or None. Shape only."""
+    for lo, hi, rep in TWO_STREAM_BANDS:
+        if lo <= num_tokens <= hi:
+            return rep
+    return None
+
+@triton.jit(do_not_specialize=["local_start", "local_count", "n", "cap", "cap_stride", "n_blocks"])
+def _align_small_halves_kernel(topk_ids_ptr, local_ids_ptr, local_ids_h_ptr, sorted_ids_ptr,
+                               block_experts_ptr, n_padded_ptr, local_start, local_count, n, cap,
+                               cap_stride, n_blocks, BLOCK_N: tl.constexpr, CAP_BLOCK: tl.constexpr,
+                               MB_BLOCK: tl.constexpr, BSM: tl.constexpr, HALF: tl.constexpr,
+                               HALF_E: tl.constexpr):
+    """_align_small_kernel's work, one program per expert half h (local experts [h*HALF, h*HALF+HALF)).
+
+    Program h treats every route outside its half like a remote route and writes its own
+    sorted_ids[h] (row stride cap_stride, capacity cap, sentinel n in every unused slot),
+    block_experts[h] (expert ids stay bank-local, h*HALF + j; -1 past its used blocks), n_padded[h]
+    and local_ids_h[h] (the local id if in its half, else -1). Program 0 also writes the full
+    local_ids (both halves' routes as local ids, remote routes as -1) for the post-norm."""
+    h = tl.program_id(0)
+    lo = h * HALF
+    offs = tl.arange(0, BLOCK_N)
+    mask = offs < n
+    ids = tl.load(topk_ids_ptr + offs, mask=mask, other=0).to(tl.int32)
+    local = ids - local_start
+    local = tl.where(mask & (local >= 0) & (local < local_count), local, -1)
+    tl.store(local_ids_ptr + offs, local, mask=mask & (h == 0))
+    inhalf = (local >= lo) & (local < lo + HALF)
+    tl.store(local_ids_h_ptr + h * n + offs, tl.where(inhalf, local, -1), mask=mask)
+    rel = tl.where(inhalf, local - lo, -1)
+
+    experts = tl.arange(0, HALF_E)
+    onehot = (rel[:, None] == experts[None, :]).to(tl.int32)          # [BLOCK_N, HALF_E]
+    counts = tl.sum(onehot, axis=0)                                    # [HALF_E]
+    padded = (counts + BSM - 1) // BSM * BSM
+    seg_end = tl.cumsum(padded, axis=0)
+    seg_start = seg_end - padded
+    total = tl.sum(padded, axis=0)
+
+    s_ptr = sorted_ids_ptr + h * cap_stride
+    rank = tl.sum(onehot * (tl.cumsum(onehot, axis=0) - 1), axis=1)
+    pos = tl.sum(onehot * seg_start[None, :], axis=1) + rank
+    tl.store(s_ptr + pos, offs, mask=mask & inhalf)
+    j = tl.arange(0, BSM)
+    pad_ptrs = s_ptr + (seg_start + counts)[:, None] + j[None, :]
+    sentinel = tl.zeros([HALF_E, BSM], dtype=tl.int32) + n
+    tl.store(pad_ptrs, sentinel, mask=j[None, :] < (padded - counts)[:, None])
+    slots = tl.arange(0, CAP_BLOCK)
+    tl.store(s_ptr + slots, tl.zeros([CAP_BLOCK], dtype=tl.int32) + n,
+             mask=(slots >= total) & (slots < cap))
+
+    blocks = tl.arange(0, MB_BLOCK)
+    block_start = blocks * BSM
+    inseg = (block_start[:, None] >= seg_start[None, :]) & (block_start[:, None] < seg_end[None, :])
+    block_expert = tl.sum(tl.where(inseg, experts[None, :] + lo, 0), axis=1)
+    block_expert = tl.where(tl.sum(inseg.to(tl.int32), axis=1) > 0, block_expert, -1)
+    tl.store(block_experts_ptr + h * n_blocks + blocks, block_expert, mask=blocks < n_blocks)
+    tl.store(n_padded_ptr + h, total)
+
+
+def _align_small_halves(topk_ids, local_start, local_count, block_size_m):
+    """Two-half align in one 2-program launch (source marlin-two-stream-expert-halves-small-m).
+
+    Returns the full local_ids [M, 8], local_ids_h [2, M*8] and per half h Marlin's
+    (sorted_ids, block_experts, n_padded) as views into one stacked allocation per kind. Each half
+    covers local_count // 2 experts, so its capacity is M*8 + (local_count // 2)*(block_size_m - 1)."""
+    topk_ids = topk_ids.contiguous()
+    device = topk_ids.device
+    n = topk_ids.numel()
+    half = local_count // 2
+    cap = n + half * (block_size_m - 1)
+    cap_stride = triton.cdiv(cap, HALF_SORTED_ALIGN) * HALF_SORTED_ALIGN
+    n_blocks = triton.cdiv(cap, block_size_m)
+    local_ids = torch.empty(topk_ids.shape, dtype=torch.int32, device=device)
+    local_ids_h = torch.empty((2, n), dtype=torch.int32, device=device)
+    sorted_ids = torch.empty((2, cap_stride), dtype=torch.int32, device=device)
+    block_experts = torch.empty((2, n_blocks), dtype=torch.int32, device=device)
+    n_padded = torch.empty((2,), dtype=torch.int32, device=device)
+    _align_small_halves_kernel[(2,)](
+        topk_ids, local_ids, local_ids_h, sorted_ids, block_experts, n_padded, local_start,
+        local_count, n, cap, cap_stride, n_blocks, BLOCK_N=triton.next_power_of_2(n),
+        CAP_BLOCK=triton.next_power_of_2(cap), MB_BLOCK=triton.next_power_of_2(n_blocks),
+        BSM=block_size_m, HALF=half, HALF_E=triton.next_power_of_2(half), num_warps=4)
+    triples = [(sorted_ids[h, :cap], block_experts[h], n_padded[h:h + 1]) for h in range(2)]
+    return local_ids, local_ids_h, triples
+
+def _sm_post_norm(y, local_ids, topk_weights, state):
+    """Master's post-expert norm for this shape, unchanged: below SMALL_M_POST_NORM the Triton combine (it skips
+    every remote slot, local id -1, and never loads its row, so the halves' separate cache3 junk in remote rows is
+    masked); at T == HOISTED_POST_NORM_TOKENS master's hoisted Triton kernel (C1b) whenever master's own flag
+    state['d32_post_norm'] is on (it masks remote slots the same way, and the NaN-poisoned self-check proves it),
+    else SGLang's fused kernel with slot_expert_ids. So H never changes master's post-norm at T == 32 (LESSONS 137)."""
+    num_tokens, _, size_k = y.shape
+    if num_tokens < SMALL_M_POST_NORM:
+        out = torch.empty((num_tokens, size_k), device=y.device, dtype=torch.bfloat16)
+        _post_norm_combine_kernel[(num_tokens,)](
+            y, local_ids, topk_weights, state["post_norm_w"], out, size_k, POST_NORM_EPS,
+            TOP_K_C=TOP_K, BLOCK_H=triton.next_power_of_2(size_k), num_warps=8)
+        return out
+    if state.get("d32_post_norm", 0) and num_tokens == HOISTED_POST_NORM_TOKENS:
+        return _post_norm_hoisted(y.contiguous(), local_ids, topk_weights, state["post_norm_w"])
+    return fused_post_expert_norm_weighted_sum(
+        y, topk_weights, norm_weight=state["norm_w"], eps=POST_NORM_EPS, weight_first=True,
+        slot_expert_ids=local_ids)
+
+def _experts_two_stream(x, topk_ids, topk_weights, bank, state, poison=False):
+    """H: the expert work split by local expert into half A (0-15) on the
+    current stream and half B (16-31) on the prepare-time side stream state["sm_side"], each running
+    w13 Marlin -> silu_and_mul -> w2 Marlin over its own routes only, with its own Marlin lock workspace
+    (state["workspace"] / state["sm_workspace_b"], both made in prepare).
+
+    Graph-safe fork/join (review fix 3): every buffer is allocated on the current stream BEFORE the fork
+    (stacked cache1 / cache2, one shared cache3, a separate buffer: master's cache13 aliasing would race
+    across streams); any atomic_zero zero_() runs here, on the current stream, before the fork, on every
+    call (review fix 1); the current stream waits on the side stream before the post-norm; no
+    record_stream (the buffers are freed on the current stream after the join). w2 runs with
+    state["sm_w2"], which prepare's cross-half wipe test sets (non-atomic if a half's atomic w2 call
+    touched the other half's rows). poison (prepare self-checks only): junk in the stacked cache1 and NaN
+    in the shared cache3 first."""
+    num_tokens, size_k = x.shape
+    size_n = bank["size_n"]
+    gemm1_n = 2 * size_n
+    routes = num_tokens * TOP_K
+    topk_weights = topk_weights.to(torch.float32).contiguous()
+    block_size_m = _block_size_m(num_tokens, bank["count"])
+    local_ids, local_ids_h, triples = _align_small_halves(topk_ids, bank["start"], bank["count"], block_size_m)
+    cache1 = torch.empty((2, routes, gemm1_n), device=x.device, dtype=x.dtype)
+    cache2 = torch.empty((2, routes, size_n), device=x.device, dtype=x.dtype)
+    cache3 = torch.empty((routes, size_k), device=x.device, dtype=x.dtype)
+    if poison:
+        cache1.fill_(W13_POISON)
+        cache3.fill_(float("nan"))
+    common = dict(moe_block_size=block_size_m, mul_topk_weights=False, is_ep=True,
+                  b_q_type=scalar_types.float4_e2m1f, is_k_full=True, use_atomic_add=False,
+                  use_fp32_reduce=True, is_zp_float=False)
+    w13_kw = common   # w13 non-atomic (mode H; H+A was dropped)
+    w2_kw = common
+    if state["sm_w2"] != "master":
+        w2_kw = dict(common, use_atomic_add=True)
+        if state["sm_w2"] == "atomic_zero":
+            cache3.zero_()
+    current, side = torch.cuda.current_stream(), state["sm_side"]
+    side.wait_stream(current)
+    for h, ws, stream in ((0, state["workspace"], current), (1, state["sm_workspace_b"], side)):
+        sorted_ids, block_experts, n_padded = triples[h]
+        with torch.cuda.stream(stream):
+            c1 = moe_wna16_marlin_gemm(
+                x, cache1[h], bank["w13"], None, bank["w13_s"], bank["w13_gs"], None, None, None, ws,
+                sorted_ids, block_experts, n_padded, topk_weights, top_k=TOP_K,
+                size_m=num_tokens, size_n=gemm1_n, size_k=size_k, **w13_kw)
+            silu_and_mul(c1.view(-1, gemm1_n), cache2[h], expert_ids=local_ids_h[h], expert_step=1)
+            moe_wna16_marlin_gemm(
+                cache2[h], cache3, bank["w2"], None, bank["w2_s"], bank["w2_gs"], None, None, None, ws,
+                sorted_ids, block_experts, n_padded, topk_weights, top_k=1,
