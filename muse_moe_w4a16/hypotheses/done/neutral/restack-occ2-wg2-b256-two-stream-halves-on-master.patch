+def _c2_build_phase(weights, state, device, t_prepare, ctx):
+    """C2 build + hang-safety gate, BEFORE any wg2 launch: -Xptxas -Werror build (a ptxas warning that mentions
+    setmaxnreg = C2 OFF; another warning allows one plain rebuild before the deadline), then per instantiation
+    numRegs == 80, localSizeBytes == 0, CTAs/SM >= 2, smem within budget at 2 CTAs/SM, binaryVersion 90, and the
+    static / global audit of the new source. Sets ctx['c2_ok'] {variant: bool} and state['wg2_ext' / 'wg2_grid']."""
+    ctx["c2_ok"] = {1: False}
+    if not state.get("wgmma_ok", False):
+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (wgmma path off: C2 not built)"]
+    if time.perf_counter() - t_prepare > COMBO_C2_BUILD_DEADLINE_S:
+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (skipped: deadline, build past {COMBO_C2_BUILD_DEADLINE_S:.0f}s)"]
+    findings = _wg_audit_cpp(_WG2_CPP + "\n" + _wg2_src())
+    print(f"{WG2_TAG} static/global audit of the wg2 source: {findings if findings else 'none'}", flush=True)
+    if findings:
+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: audit findings {findings})"[:400]]
+    ext, text, arch = _wg2_build(werror=True)
+    warn_text = "none (the -Werror build passed)"
+    if ext is None:
+        ptx = [ln.strip() for ln in (text or "").splitlines() if "ptxas" in ln]
+        setm = [ln for ln in ptx if "setmaxnreg" in ln]
+        warns = _wg_ptxas_warnings(text)
+        warn_text = f"{len(ptx)} ptxas lines, setmaxnreg lines {len(setm)}: {(setm or warns or ['-'])[0][:200]}"
+        print(f"{WG2_TAG} -Werror build failed: {warn_text}", flush=True)
+        for w in warns:
+            print(f"{WG2_TAG}   ptxas: {w}", flush=True)
+        if setm:
+            return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: setmaxnreg ptxas warning: {setm[0][:200]})"]
+        if time.perf_counter() - t_prepare > COMBO_C2_BUILD_DEADLINE_S + 20.0:
+            return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 OFF: -Werror build failed, skipped: deadline for a rebuild)"]
