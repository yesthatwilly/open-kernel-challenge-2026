+def _c2_select(weights, state, device, t_prepare):
+    """C2 selector (prepare only), B256 only. At T=256 the FULL kernel_fn path as master routes it right now
+    (wg_on_256 as master's selector left it, master's wg_align2 front end: s5 wg_kernel or Marlin; flag-off) against
+    the same kernel_fn with wg2_variant_256 = 1 and wg_on_256 = True (wg2 V64 @ OCC 2), as CUDA graphs on shared
+    static inputs, on two gating routings (the reference.generate_input rebuild _wg_judge_ids and zipf a=0.3).
+    Cold L2 (>= 256 MB flush before every replay), two interleaved rounds of SEL2_REPS replays, empty-graph baseline
+    subtracted. V64 goes live only if it is healthy (error word 0, WG2_MAGIC marker, finite, rel-L2 <= WG_SEL_E2E_TOL
+    vs master's output) AND in BOTH rounds on BOTH routings master / V64 >= SEL2_MIN_SPEEDUP with V64's IQR <=
+    SEL2_IQR_FACTOR x master's. Prints every round's medians / IQRs and the kernel-only w13 / w2 times and TB/s
+    (print only). Returns lines (PATH CHOSEN B256 last)."""
+    bank = state["banks"][(0, 32)]
+    start, count = bank["start"], bank["count"]
+    hidden, inter = weights["w2"].shape[1], bank["size_n"]
+    local_set = list(range(start, start + count))
+    wb = state["wg_banks"][(start, count)]
+    ext = state["wg_ext"]
+    tokens, name = 256, "B256"
+    master_on = bool(state.get("wg_on_256", False))
+    master_name = "wg_kernel<s5> (master's wgmma)" if master_on else "Marlin (master's choice)"
+    v64_name = f"wg2_kernel<G,{WG2_NMAX},{WG2_STAGES},{WG2_OCC}> V64 (2 CTAs/SM)"
+    if time.perf_counter() - t_prepare > COMBO_C2_TIMING_DEADLINE_S:
+        return [f"{WG2_TAG} PATH CHOSEN {name} = master's choice {master_name} (skipped: deadline, no timing past "
+                f"{COMBO_C2_TIMING_DEADLINE_S:.0f}s)"]
+    gen = torch.Generator().manual_seed(20261127)
+    flush = torch.empty(WG_SEL_FLUSH_BYTES, dtype=torch.uint8, device=device)
+    routes = tokens * TOP_K
+    x = torch.randn((tokens, hidden), generator=gen).to(torch.bfloat16).to(device)
+    tw = torch.full((tokens, TOP_K), 1.0 / TOP_K, dtype=torch.float32, device=device)
+    j_ids, j_touched, j_seed = _wg_judge_ids(tokens, gen, bank)
+    routings = [(f"judge-rebuild (draw {j_seed})", j_ids.to(device).contiguous()),
+                ("zipf a=0.3", _wg_zipf_ids(tokens, 0.3, gen, local_set).to(device).contiguous())]
+    cfg = {"bs": tokens, "d_hidden": hidden, "d_expert": inter, "n_experts": N_EXPERTS, "local_start": start,
+           "local_count": count, "top_k": TOP_K, "sharding": "ep8"}
+    data = {"hidden_states": x, "topk_ids": routings[0][1].clone(), "topk_weights": tw, "config": cfg}
+    st0 = dict(state)                                     # master's routed path, flag-off
+    st1 = dict(state, wg2_variant_256=1, wg_on_256=True)  # the candidate
+    g0, out0 = _wg_graph_of(lambda: kernel_fn(data, st0))
+    g1, out1 = _wg_graph_of(lambda: kernel_fn(data, st1))
+    healthy, why = True, ""
+    res = {}
+    lines = []
+    for label, ids in routings:
+        data["topk_ids"].copy_(ids)
+        state["wg_err"].zero_()
+        g1.replay()
+        torch.cuda.synchronize()
+        err_word, marker = [int(t_) for t_ in state["wg_err"].tolist()]
+        g0.replay()
+        torch.cuda.synchronize()
+        rel = _wg_rel(out1, out0)
+        if err_word != 0 or marker != WG2_MAGIC or not bool(torch.isfinite(out1).all()) or rel > WG_SEL_E2E_TOL:
+            healthy = False
+            why = f"{label}: err word {err_word}, marker 0x{marker & 0xffffffff:x}, rel-L2 vs master {rel:.2e}"
+        state["wg_err"].zero_()
+        res[label] = _sel2_time({"master": g0, "v64": g1}, device, flush)
+        # Kernel-only graphs (this routing's front end, one eager gather) for the TB/s prints. Print only.
+        try:
+            _, (sorted_ids, block_experts, n_padded) = _c2_front(ids, bank, _wg_front_flag(state, tokens))
+            ext.wg_gather(x, sorted_ids, block_experts, n_padded, routes, count, state["wg_xs"])
+            cache3 = torch.empty((routes, hidden), dtype=torch.bfloat16, device=device)
+            kg = {}
+            for v in (0, 1):
+                kg[f"w13_{v}"], _ = _wg_graph_of(lambda v=v: _wg_gemm(
+                    state, 0, wb["q13"], wb["gs13"], sorted_ids, block_experts, n_padded, routes, inter // 64, hidden,
+                    state["wg_hs"], v))
+                kg[f"w2_{v}"], _ = _wg_graph_of(lambda v=v: _wg_gemm(
+                    state, 1, wb["q2"], wb["gs2"], sorted_ids, block_experts, n_padded, routes, hidden // 128, inter,
+                    cache3, v))
+            kres = _sel2_time(kg, device, flush, reps=21, rounds=1)
+            st = _wg_route_stats(ids, bank, wb)
+            for v in (0, 1):
+                cs = _wg2_chunk_stats(st, 8 if v == 0 else WG2_NMAX // 16)
+                t13, t2 = kres[f"w13_{v}"][0][0], kres[f"w2_{v}"][0][0]
+                ln = (f"  {name} T={tokens} {label} {WG2_NAMES[v]}: touched {st['touched']}/{count}, max routes "
+                      f"{st['max_routes']} ({st['local_routes']} local), chunks {cs['chunks']} ({cs['split_experts']} "
+                      f"split), weight read twice {cs['reread_bytes'] / 1e6:.0f} MB; w13 {t13:.1f} us "
+                      f"{st['touched'] * st['b13'] / t13 / 1e6:.2f} TB/s, w2 {t2:.1f} us "
+                      f"{st['touched'] * st['b2'] / t2 / 1e6:.2f} TB/s (kernel-only, print only)")
+                print(f"{WG2_TAG} select{ln}", flush=True)
+            del kg, cache3
+        except Exception as e:  # prints only: never changes the choice
+            print(f"{WG2_TAG} select kernel-only prints skipped ({type(e).__name__}: {str(e)[:120]})", flush=True)
+        torch.cuda.synchronize()
+    del g0, g1, out0, out1, flush
+    torch.cuda.synchronize()
+    ok, worst, text = _sel2_gate(res, "v64", "master")
+    for t_ in text:
+        print(f"{WG2_TAG} select {name} {t_}", flush=True)
+    choose = bool(healthy and ok)
+    if choose:
+        state["wg2_master_on_256"] = master_on
+        state["wg2_variant_256"] = 1
+        state["wg_on_256"] = True
+    lines.append(f"{WG2_TAG} PATH CHOSEN {name} = " + (f"{v64_name}" if choose else f"master's choice {master_name}")
+                 + f": lowest master/V64 {worst:.3f} over 2 routings x {SEL2_ROUNDS} rounds (ON needs every round >= "
+                   f"{SEL2_MIN_SPEEDUP} and V64 IQR <= {SEL2_IQR_FACTOR}x master's: {ok}); medians master/V64 "
+                   f"{_sel2_brief(res, 'v64', 'master')}; healthy {healthy}"
+                 + ("" if healthy else f" ({why})") + f"; touched judge rebuild {j_touched}; kernels "
+                 f"{v64_name if choose else master_name}")
+    return lines
