+        return [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (C2 not available)"]
+    # The wg2 checks and the selector run with master's PDL setting as it is now; say so loudly (no silent fallback).
+    pdl_line = (f"{WG2_TAG} PDL state: wg_ext_pdl={state.get('wg_ext_pdl')} (True = master built the PDL module), "
+                f"wg_pdl={state.get('wg_pdl')} (the w2 launch carries the programmatic-serialization attribute); the "
+                f"wg2 canary / self-check / copy check / selector all run with exactly this setting")
+    print(pdl_line, flush=True)
+    lines, passed = _c2_checks(weights, state, device, t_prepare, ctx)
+    lines = [pdl_line] + lines
+    if not passed:
+        return lines + [f"{WG2_TAG} PATH CHOSEN B256 = master's choice (V64 checks did not pass or were skipped)"]
