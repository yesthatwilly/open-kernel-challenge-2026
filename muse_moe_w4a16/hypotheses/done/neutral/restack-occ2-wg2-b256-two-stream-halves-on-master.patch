+# Port of c30fd0cc's reference.generate_input rebuild (review edit 2).
+WG_POPULARITY = 0.03        # reference.POPULARITY (the Student-t popularity scale of generate_input "normal")
+WG_JUDGE_SEEDS = 8          # candidate judge-like routings; the one whose touched-expert count is nearest the target
+WG_JUDGE_TOUCHED = 17       # local experts the judged bs=128 floor implies (101.3 us x 4.8 TB/s / 28.3 MB per expert)
+
+
+def _wg_judge_ids(tokens, gen, bank):
+    """Judge-like routing, rebuilt in prepare from fixed seeds exactly as reference.generate_input builds
+    dist="normal", rank="busiest" (never taken from inputs): top-8 of uniform scores plus a heavy-tailed
+    (Student-t, 2 dof) per-expert popularity, then the expert ids are rotated so the busiest GPU's experts
+    become the bank's. Of WG_JUDGE_SEEDS draws, the one touching the number of local experts nearest
+    WG_JUDGE_TOUCHED is kept. Returns (ids int32 [tokens, 8] on the CPU, touched local experts, draw index)."""
+    start, count = bank["start"], bank["count"]
+    best = None
+    for k in range(WG_JUDGE_SEEDS):
+        scores = torch.rand((tokens, N_EXPERTS), generator=gen)
+        z = torch.randn((N_EXPERTS,), generator=gen)
+        u = torch.rand((N_EXPERTS,), generator=gen).clamp(min=1e-12)
+        scores = scores + WG_POPULARITY * z / (-u.log()).sqrt()
+        ids = scores.topk(TOP_K, dim=-1).indices
+        pairs = torch.bincount((ids // count).flatten(), minlength=N_EXPERTS // count)
+        ids = (ids - count * pairs.argmax() + start) % N_EXPERTS
+        local = ids[(ids >= start) & (ids < start + count)]
+        touched = int(torch.unique(local).numel())
+        gap = abs(touched - WG_JUDGE_TOUCHED)
+        if best is None or gap < best[0]:
+            best = (gap, ids.to(torch.int32), touched, k)
+    return best[1], best[2], best[3]
+
+
+def _wg_route_stats(ids, bank, wb):
+    """Per-routing facts (c30fd0cc): routes per local expert, touched experts, the busiest expert's routes, local
+    routes, and one expert's weight bytes (w13 and w2 records of the retiled bank)."""
+    count = bank["count"]
+    local = bank["expert_map"][ids.to(bank["expert_map"].device).long()].reshape(-1)
+    local = local[local >= 0].long()
+    cnt = torch.bincount(local, minlength=count).tolist()
+    return {"counts": cnt, "touched": sum(1 for c in cnt if c), "max_routes": max(cnt), "local_routes": sum(cnt),
+            "b13": wb["q13"].numel() // count, "b2": wb["q2"].numel() // count}
+
+
+def _wg2_chunk_stats(st, cut):
+    """What a chunk cut of `cut` blocks of 16 does to this routing: chunks and the weight bytes read a second
+    time (an expert split into k chunks streams its weight k times)."""
+    chunks = extra = split = 0
+    for c in st["counts"]:
+        if c:
+            k = (((c + 15) // 16) + cut - 1) // cut
+            chunks += k
+            extra += k - 1
+            split += int(k > 1)
+    return {"chunks": chunks, "reread_bytes": extra * (st["b13"] + st["b2"]), "split_experts": split}
+
+def _c2_checks(weights, state, device, t_prepare, ctx):
+    """V64: master's s5 bucket canary on N16/N32/N64, _wg_self_check and the three-state _wg_copy_check, each
+    run with variant 1 (the copy check forces flags on A, B and C; the real state's flags are restored after).
+    Returns (lines, V64 checked ok)."""
+    bank = state["banks"][(0, 32)]
+    lines = []
+    keys = ("wgmma_ok", "wg_on_128", "wg_on_256", "wg2_variant_128", "wg2_variant_256", "wg_pdl")
+    if time.perf_counter() - t_prepare > COMBO_C2_CHECK_DEADLINE_S:
+        return [f"{WG2_TAG} V64 checks skipped: deadline (start past {COMBO_C2_CHECK_DEADLINE_S:.0f}s)"], False
+    state["wg_err"].zero_()
+    c_ok, _cl, c_fails = _wg_bucket_canary(weights, bank, state, device, variant=1, n_buckets=3)
+    line = f"V64 bucket canary N16/N32/N64: {'PASS' if c_ok else 'FAIL'}"
+    if c_fails:
+        line += f" ({c_fails[0][:160]})"
+    ok = c_ok
+    if ok:
+        s_ok, worst = _wg_self_check(weights, bank, state, device, variant=1)
+        line += (f"; self-check {'PASS' if s_ok else 'FAIL'} (worst rel-L2 vs Marlin "
+                 + " ".join(f"{k} {x:.2e}" for k, x in worst.items()) + ")")
+        ok = ok and s_ok
+        if ok:
+            saved = {k: state.get(k) for k in keys}
+            try:
+                r_ok, launched, rfails, rline = _wg_copy_check(weights, bank, state, device,
+                                                              pdl=bool(state.get("wg_pdl", False)), variant=1)
+            finally:
+                for k, val in saved.items():
+                    state[k] = val
+            line += f"; copy check {'PASS' if r_ok and launched else 'FAIL'} ({rline[:220]})"
+            for f_ in rfails[:3]:
+                print(f"{WG2_TAG}   COPY MISS {f_}"[:300], flush=True)
+            ok = ok and r_ok and launched
+    err_word = int(state["wg_err"][0].item())
+    ok = ok and err_word == 0
+    state["wg_err"].zero_()
+    line += f"; error word {err_word}: {'PASS' if ok else 'FAIL'}"
+    print(f"{WG2_TAG} {line}", flush=True)
+    lines.append(f"{WG2_TAG} {line}"[:600])
+    return lines, bool(ok)
