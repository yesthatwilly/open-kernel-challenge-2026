+        mode = "master"
+        ok, detail = _sm_cross_half(bank, state, device, gen, mode)
+    state["sm_w2"] = mode
+    lines.append(f"{TS_TAG} cross-half w2 wipe test: {'ok' if ok else 'FAILED'} ({detail}); halves w2 mode = "
