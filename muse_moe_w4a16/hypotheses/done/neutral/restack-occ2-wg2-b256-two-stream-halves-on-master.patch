+    s_gk[tid] = k;
+  }
+  __syncthreads();
+
+  const int total = nc * n_tiles;
+  const int KS = K / BK;
+  bool dead = false;
+  if (warp < 4) {
+    asm volatile("setmaxnreg.dec.sync.aligned.u32 %0;\n" :: "n"(Geo::RDEC) : "memory");
+    if (tid == 0) {
+      const int KC = K / 64;
+      int n = 0;
+      for (int it = blockIdx.x; it < total; it += gridDim.x) {
+        const Item m = decode_item2<ORD>(it, n_tiles, s_be, s_cblk, s_cnb, s_gf, s_gk);
+        // Unreachable (a chunk has <= CH blocks): a table bug sets error word 3 and the item is skipped by the
+        // producer and (switch default below) every consumer alike, so the ring stays in step.
+        if (m.bucket > Geo::BMAX) {
+          atomicExch(err, 3);
+          continue;
+        }
+        const uint8_t* wsrc = wbank + (static_cast<size_t>(m.e) * n_tiles + m.j) * static_cast<size_t>(KC) * REC;
+        const uint64_t map = reinterpret_cast<uint64_t>(&maps.m[m.bucket]);
+        const uint32_t tx = WST + 2 * (16 << m.bucket) * 128;
+        for (int kb = 0; kb < KS; ++kb, ++n) {
+          const int s = n % STG;
+          mbar_wait(empty0 + 8 * s, ((n / STG) & 1) ^ 1, err, dead);
+          const uint32_t st = smem_u32(smem + s * Geo::STAGE_B);
+          const uint32_t fb = full0 + 8 * s;
+          mbar_expect_tx(fb, tx);
+          bulk_g2s(st, wsrc + static_cast<size_t>(kb) * WST, WST, fb);  // weights: constant, no dependency
+          // PDL (master's call sites): the B slab is the predecessor's output; nothing reads it before this wait.
+          if (n == 0) griddep_wait();
+          tma_2d(st + WST, map, kb * BK, m.slot0, fb);
+          tma_2d(st + WST + Geo::SLAB_H, map, kb * BK + 64, m.slot0, fb);
+        }
+      }
+    }
+  } else {
+    asm volatile("setmaxnreg.inc.sync.aligned.u32 %0;\n" :: "n"(Geo::RINC) : "memory");
+    const int ctid = tid - 128, cw = ctid >> 5;
+    int n = 0;
+    // PDL: no consumer global store before the predecessor grid has completed (a no-op without the attribute).
+    griddep_wait();
+    for (int it = blockIdx.x; it < total; it += gridDim.x) {
+      const Item m = decode_item2<ORD>(it, n_tiles, s_be, s_cblk, s_cnb, s_gf, s_gk);
+#define WG2_CONSUME(NB_)                                                                                     \
+  consume_item2<NB_, G, NMAX, STG, OCC>(m, smem, ep, full0, empty0, n, KS, cw, lane, ctid, gs, sorted_ids,     \
+                                        num_routes, out, out_ld, err, dead)
+      // A chunk never carries more than NMAX tokens, so the buckets above NMAX are never instantiated.
+      switch (m.bucket) {
+        case 0: WG2_CONSUME(16); break;
+        case 1: if constexpr (NMAX >= 32) { WG2_CONSUME(32); } break;
+        case 2: if constexpr (NMAX >= 64) { WG2_CONSUME(64); } break;
+        default: if constexpr (NMAX >= 128) { WG2_CONSUME(128); } break;
+      }
+#undef WG2_CONSUME
+    }
+  }
+  // PDL: let the next grid's CTAs take the SMs freed in the tail (every thread executes it or has exited).
+  griddep_launch();
+#else
+  // Not the sm_90a image: no wgmma here. Flag it (error word 2) and do nothing else.
+  if (threadIdx.x == 0) atomicExch(err, 2);
+#endif
+}
+
+typedef CUresult (*EncodeTiledFn)(CUtensorMap*, CUtensorMapDataType, cuuint32_t, void*, const cuuint64_t*,
+                                  const cuuint64_t*, const cuuint32_t*, const cuuint32_t*, CUtensorMapInterleave,
+                                  CUtensorMapSwizzle, CUtensorMapL2promotion, CUtensorMapFloatOOBfill);
+
+EncodeTiledFn get_encode2() {
+  void* fn = nullptr;
+  cudaDriverEntryPointQueryResult q = cudaDriverEntryPointSymbolNotFound;
+#if CUDART_VERSION >= 12050
+  const cudaError_t e = cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &fn, 12000, cudaEnableDefault, &q);
+#else
+  const cudaError_t e = cudaGetDriverEntryPoint("cuTensorMapEncodeTiled", &fn, cudaEnableDefault, &q);
+#endif
+  if (e != cudaSuccess || q != cudaDriverEntryPointSuccess || fn == nullptr) {
+    (void)cudaGetLastError();
+    return nullptr;
+  }
+  return reinterpret_cast<EncodeTiledFn>(fn);
+}
+
+template <bool G, int NMAX, int STG, int OCC, int ORD>
+void info2(std::vector<int64_t>& r, int64_t variant) {
+  const void* fn = reinterpret_cast<const void*>(wg2_kernel<G, NMAX, STG, OCC, ORD>);
+  const int bytes = Smem2<G, NMAX, STG, OCC>::BYTES;
+  const cudaError_t e1 = cudaFuncSetAttribute(fn, cudaFuncAttributeMaxDynamicSharedMemorySize, bytes);
+  cudaFuncAttributes a{};
+  const cudaError_t e2 = cudaFuncGetAttributes(&a, fn);
+  int occ = 0;
+  const cudaError_t e3 = cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, fn, THREADS, bytes);
+  if (e1 != cudaSuccess || e2 != cudaSuccess || e3 != cudaSuccess) (void)cudaGetLastError();
+  r.push_back(variant);
+  r.push_back(G ? 1 : 0);
+  r.push_back(e1 == cudaSuccess && e2 == cudaSuccess && e3 == cudaSuccess ? 1 : 0);
+  r.push_back(a.numRegs);
+  r.push_back(static_cast<int64_t>(a.localSizeBytes));
+  r.push_back(static_cast<int64_t>(a.sharedSizeBytes));
+  r.push_back(bytes);
+  r.push_back(occ);
+  r.push_back(static_cast<int64_t>(e1));
+  r.push_back(a.binaryVersion);
+  r.push_back(NMAX * 1000 + STG * 10 + OCC);
+}
