+def _sel2_time(graphs, device, flush, reps=SEL2_REPS, rounds=SEL2_ROUNDS):
+    """Cold-L2 graph replay timing. graphs {name: CUDAGraph}. `rounds` interleaved rounds of `reps` replays; in each
+    round the order rotates and flips every replay, `flush` (>= 256 MB) is written before EVERY replay and the
+    empty-graph baseline of that round is subtracted. Returns {name: [(median us, IQR us) per round]}."""
+    tiny = torch.zeros(16, dtype=torch.float32, device=device)
+    allg = dict(graphs)
+    allg["__empty__"] = _align2_graph(lambda: tiny.zero_(), device)
