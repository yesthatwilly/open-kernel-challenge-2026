+}  // namespace
+
+// Per instantiation (11 values each; variant 1 = V64 w13 then w2): variant, gated,
+// attribute calls ok, numRegs, localSizeBytes, static smem, dynamic smem, CTAs per SM, cudaFuncSetAttribute's rc,
+// binaryVersion, NMAX * 1000 + STG * 10 + OCC. Also sets each one's dynamic smem attribute (needed before launch).
+std::vector<int64_t> wg2_init() {
+  std::vector<int64_t> r;
+  info2<true, 64, 3, 2, 0>(r, 1);
+  info2<false, 64, 3, 2, 0>(r, 1);
+  return r;
+}
+
+// One wg2 launch, plain or (pdl != 0, the w2 launch only, as master) with programmatic stream serialization.
+template <bool G, int ORD>
+void launch2(const Maps& mp, const torch::Tensor& wbank, const torch::Tensor& gs, const torch::Tensor& sorted_ids,
+             const torch::Tensor& block_experts, const torch::Tensor& n_padded, int blocks_len, int64_t num_routes,
+             int64_t n_tiles, int64_t K, const torch::Tensor& out, int64_t grid, const torch::Tensor& err,
+             int64_t pdl, cudaStream_t stream) {
+  const uint8_t* wb = wbank.data_ptr<uint8_t>();
+  const float* g = gs.data_ptr<float>();
+  const int* si = sorted_ids.data_ptr<int>();
+  const int* be = block_experts.data_ptr<int>();
+  const int* np = n_padded.data_ptr<int>();
+  __nv_bfloat16* o = reinterpret_cast<__nv_bfloat16*>(out.data_ptr());
+  int* e = err.data_ptr<int>();
+  const int nr = static_cast<int>(num_routes), nt = static_cast<int>(n_tiles), kk = static_cast<int>(K);
+  const int ne = static_cast<int>(gs.numel()), ld = static_cast<int>(out.size(1));
+  if (pdl == 0) {
+    wg2_kernel<G, 64, 3, 2, ORD><<<static_cast<unsigned>(grid), THREADS, Smem2<G, 64, 3, 2>::BYTES, stream>>>(
+        mp, wb, g, si, be, np, blocks_len, nr, nt, kk, ne, o, ld, e);
+    C10_CUDA_KERNEL_LAUNCH_CHECK();
+    return;
+  }
+  cudaLaunchConfig_t cfg{};
+  cfg.gridDim = dim3(static_cast<unsigned>(grid));
+  cfg.blockDim = dim3(THREADS);
+  cfg.dynamicSmemBytes = Smem2<G, 64, 3, 2>::BYTES;
+  cfg.stream = stream;
+  cudaLaunchAttribute attr[1];
+  attr[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+  attr[0].val.programmaticStreamSerializationAllowed = 1;
+  cfg.attrs = attr;
+  cfg.numAttrs = 1;
+  const cudaError_t le = cudaLaunchKernelEx(&cfg, wg2_kernel<G, 64, 3, 2, ORD>, mp, wb, g, si, be, np, blocks_len,
+                                            nr, nt, kk, ne, o, ld, e);
+  TORCH_CHECK(le == cudaSuccess, "wg2_gemm: PDL launch: ", cudaGetErrorString(le));
+}
+
+void wg2_gemm(int64_t which, int64_t variant, torch::Tensor bsrc, torch::Tensor wbank,
+              torch::Tensor gs, torch::Tensor sorted_ids, torch::Tensor block_experts, torch::Tensor n_padded,
+              int64_t num_routes, int64_t n_tiles, int64_t K, torch::Tensor out, int64_t grid, torch::Tensor err,
+              int64_t pdl) {
+  TORCH_CHECK(which == 0 || which == 1, "wg2_gemm: which");
+  TORCH_CHECK(variant == 1, "wg2_gemm: variant");
+  TORCH_CHECK(bsrc.is_cuda() && bsrc.is_contiguous() && bsrc.dim() == 2 && bsrc.scalar_type() == at::kBFloat16 &&
+              bsrc.size(0) > 0 && bsrc.size(1) > 0 && bsrc.size(1) == K,
+              "wg2_gemm: B-source scratch layout (cuda, contiguous, 2-D bf16, width K)");
+  TORCH_CHECK(wbank.is_contiguous() && gs.is_contiguous() && sorted_ids.is_contiguous() &&
+              block_experts.is_contiguous() && out.is_contiguous() && wbank.scalar_type() == at::kByte &&
+              gs.scalar_type() == at::kFloat && sorted_ids.scalar_type() == at::kInt &&
+              block_experts.scalar_type() == at::kInt && n_padded.scalar_type() == at::kInt &&
+              out.scalar_type() == at::kBFloat16 && err.scalar_type() == at::kInt && err.numel() >= 2,
+              "wg2_gemm: layout");
+  TORCH_CHECK(K % BK == 0 && block_experts.numel() <= MAXB && sorted_ids.numel() <= bsrc.size(0), "wg2_gemm: sizes");
+  TORCH_CHECK(wbank.numel() == gs.numel() * n_tiles * (K / 64) * REC, "wg2_gemm: weight bank size");
+  TORCH_CHECK(out.size(1) == (which == 0 ? n_tiles * 64 : n_tiles * 128), "wg2_gemm: output width");
+  auto stream = at::cuda::getCurrentCUDAStream();
+  const int blocks_len = static_cast<int>(block_experts.numel());
+  EncodeTiledFn enc = get_encode2();
+  TORCH_CHECK(enc != nullptr, "wg2_gemm: cuTensorMapEncodeTiled entry point missing");
+  Maps mp;
+  std::memset(&mp, 0, sizeof(Maps));
+  {
+    const cuuint64_t dims[2] = {static_cast<cuuint64_t>(bsrc.size(1)), static_cast<cuuint64_t>(bsrc.size(0))};
+    const cuuint64_t strides[1] = {static_cast<cuuint64_t>(bsrc.size(1)) * 2};
+    const cuuint32_t es[2] = {1, 1};
+    void* base = bsrc.data_ptr();
+    for (int b = 0; b < 4; ++b) {
+      const cuuint32_t box[2] = {64, static_cast<cuuint32_t>(16 << b)};
+      const CUresult rc = enc(&mp.m[b], CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, base, dims, strides, box, es,
+                              CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                              CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+      TORCH_CHECK(rc == CUDA_SUCCESS, "wg2_gemm: tensor map ", b, " rc ", static_cast<int>(rc));
+    }
+  }
+#define WG2_LAUNCH(G_, ORD_) \
+  launch2<G_, ORD_>(mp, wbank, gs, sorted_ids, block_experts, n_padded, blocks_len, num_routes, n_tiles, K, out, grid, \
+                    err, pdl, stream)
+  if (which == 0) WG2_LAUNCH(true, 0); else WG2_LAUNCH(false, 0);
+#undef WG2_LAUNCH
+}
