+_CMBF_SRC_BODY = r"""
+namespace eacf {
+using namespace ea;
+using eak4::bar_consumers;
+constexpr int H = 4096, LMAX = 16, SKIP = 1 << 15;  // a CTA ends <= 14 super-groups at T <= 128 (more: err 4)
+constexpr int LST = eak4x::SMEM, RED = 1024, OWN = 1600;  // LST past s_gs; RED / OWN in the free ring
+struct Cf {
+  const float* tw;
+  const __nv_bfloat16* w;
+  __nv_bfloat16* out;
+  int* cfc;  // [T], zero between launches
+  float eps;
+};
+__device__ __forceinline__ bool loc(const int* __restrict__ ids, int r, int start, int count) {  // K1's local_ids test
+  return static_cast<unsigned>(ids[r] - start) < static_cast<unsigned>(count);
+}
+__device__ __forceinline__ int nloc(const int* __restrict__ ids, int t, int start, int count) {
+  int n = 0;
+#pragma unroll
+  for (int s = 0; s < 8; ++s) n += loc(ids, t * 8 + s, start, count);
+  return n;
+}
+__device__ __forceinline__ void bf8(const uint4& u, float* f) {  // ea_combine's bf16x8_to_f32
+  const uint32_t q[4] = {u.x, u.y, u.z, u.w};
+#pragma unroll
+  for (int i = 0; i < 4; ++i) f[2 * i] = __uint_as_float(q[i] << 16), f[2 * i + 1] = __uint_as_float(q[i] & 0xffff0000u);
+}
+__device__ __forceinline__ void ldv(const __nv_bfloat16* row, const __nv_bfloat16* w, int c0, float (&v)[16]) {
+  float a[16], b[16];  // v = y * (1 + w) on columns c0.. and 2048 + c0..; y by __ldcg (other SMs wrote it)
+  bf8(__ldcg(reinterpret_cast<const uint4*>(row + c0)), a);
+  bf8(__ldcg(reinterpret_cast<const uint4*>(row + H / 2 + c0)), a + 8);
+  bf8(*reinterpret_cast<const uint4*>(w + c0), b);
+  bf8(*reinterpret_cast<const uint4*>(w + H / 2 + c0), b + 8);
+#pragma unroll
+  for (int i = 0; i < 16; ++i) v[i] = a[i] * (b[i] + 1.0f);
+}
+__device__ __forceinline__ void cf_head(const int* __restrict__ ids, int T, int start, int count, int pdl,
+    const Cf& cf, int* lst) {
+  if (threadIdx.x == 0) lst[LMAX] = 0;
+  const int t = blockIdx.x;
+  if ((pdl & SKIP) || t >= T || threadIdx.x >= 256 || nloc(ids, t, start, count)) return;  // CTA-uniform
+  uint4* o = reinterpret_cast<uint4*>(cf.out + static_cast<size_t>(t) * H);  // no local slot: +0 row
+  o[threadIdx.x] = o[256 + threadIdx.x] = make_uint4(0u, 0u, 0u, 0u);
+}
+__device__ __forceinline__ void cf_note(int* lst, int sgrp, int* err) {  // after every epi<false>; thread 0 only
+  if (threadIdx.x == 0) {
+    const int n = lst[LMAX];
+    if (n < LMAX) lst[n] = sgrp;
+    else atomicExch(err, 4);
+    lst[LMAX] = n + 1;
+  }
+}
+// ea_combine_kernel's body and fp32 order; slots reloaded, not held
+__device__ __forceinline__ void comb_one(int t, const __nv_bfloat16* y, const int* __restrict__ ids, int start,
+    int count, const Cf& cf, float (*red)[8]) {
+  const int tid = threadIdx.x;
+  const __nv_bfloat16* yt = y + static_cast<size_t>(t) * 8 * H;
+  float v[16], acc[16];
+#pragma unroll 1
+  for (int s = 0; s < 8; ++s) {
+    if (!loc(ids, t * 8 + s, start, count)) continue;  // CTA-uniform
+    ldv(yt + s * H, cf.w, tid * 8, v);
+    float ss = 0.f;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) ss += v[i] * v[i];
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+    if ((tid & 31) == 0) red[s][tid >> 5] = ss;
+  }
+  bar_consumers();
+#pragma unroll
+  for (int i = 0; i < 16; ++i) acc[i] = 0.f;
+#pragma unroll 1
+  for (int s = 0; s < 8; ++s) {
+    if (!loc(ids, t * 8 + s, start, count)) continue;
+    float tot = 0.f;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) tot += red[s][i];
+    const float r = rsqrtf(tot / static_cast<float>(H) + cf.eps), g = cf.tw[t * 8 + s];
+    ldv(yt + s * H, cf.w, tid * 8, v);
+#pragma unroll
+    for (int i = 0; i < 16; ++i) acc[i] += g * v[i] * r;
+  }
+  uint32_t o[8];
+#pragma unroll
+  for (int i = 0; i < 8; ++i)
+    o[i] = (static_cast<uint32_t>(__bfloat16_as_ushort(__float2bfloat16_rn(acc[2 * i + 1]))) << 16) |
+           __bfloat16_as_ushort(__float2bfloat16_rn(acc[2 * i]));
+  uint4* orow = reinterpret_cast<uint4*>(cf.out + static_cast<size_t>(t) * H) + tid;
+  orow[0] = make_uint4(o[0], o[1], o[2], o[3]);
+  orow[256] = make_uint4(o[4], o[5], o[6], o[7]);
+}
+// CTA end. Release: barriers order all y stores before warp 0's per-token atom.add.release.gpu (CUTLASS
+// GenericBarrier); the add reaching NS x local slots owns the token: fence (acquire), barrier, __ldcg.
+template <int NS, typename M>
+__device__ __forceinline__ void cf_tail(const M& m, uint8_t* ring, const int* lst, const int* __restrict__ ids,
+    const __nv_bfloat16* y, int T, int start, int count, int pdl, const Cf& cf) {
+  if (pdl & SKIP) return;  // cf0
+  const int tid = threadIdx.x, lane = tid & 31;
+  int *cnt = reinterpret_cast<int*>(ring), *own = reinterpret_cast<int*>(ring + OWN);
+  bar_consumers();  // ring free, y and list complete
+  for (int i = tid; i < T; i += 256) cnt[i] = 0;
+  bar_consumers();
+  if ((tid >> 4) < min(lst[LMAX], LMAX)) {  // list entry tid / 16, route tid % 16
+    const int v = lst[tid >> 4] / NS;
+    if ((tid & 15) < m.v_n[v]) atomicAdd(&cnt[m.pos_r[m.v_beg[v] + (tid & 15)] >> 3], 1);
+  }
+  bar_consumers();
+  if (tid < 32) {
+    int no = 0;
+    for (int t0 = 0; t0 < T; t0 += 32) {
+      const int t = t0 + lane, n = t < T ? cnt[t] : 0;
+      bool mine = false;
+      if (n > 0) {
+        int old;
+        asm volatile("atom.release.gpu.global.add.s32 %0, [%1], %2;\n" : "=r"(old) : "l"(cf.cfc + t), "r"(n) : "memory");
+        if (old + n == NS * nloc(ids, t, start, count)) {
+          eak4x::fence_acq_rel_gpu();
+          cf.cfc[t] = 0;
+          mine = true;
+        }
+      }
+      const unsigned bal = __ballot_sync(0xffffffffu, mine);
+      if (mine) own[no + __popc(bal & ((1u << lane) - 1u))] = t;
+      no += __popc(bal);
+    }
+    if (lane == 0) own[-1] = no;
+  }
+  bar_consumers();
+#pragma unroll 1
+  for (int j = 0; j < own[-1]; ++j)  // red double-buffered
+    comb_one(own[j], y, ids, start, count, cf, reinterpret_cast<float (*)[8]>(ring + RED + (j & 1) * 256));
+}
+}  // namespace eacf
+// ---- CF host ----
+#define R __restrict__
+#define CF_ARGS const __nv_bfloat16* R h, const int* R ids, const uint8_t* R wr, const float* R gs, __nv_bfloat16* R y, \
+    float* R ws, int* R tk, int* err, int T, int start, int count, int pdl, const __grid_constant__ eacf::Cf cf
+#define CF_PASS h, ids, wr, gs, y, nullptr, ws, tk, err, T, start, count, pdl, cf
+__global__ void __launch_bounds__(288, 2) cf_w2s_kernel(CF_ARGS) { eak4xcf::expert_body_x<false, 2, false>(CF_PASS); }
+template <int PF>
+__global__ void __launch_bounds__(288, 2) cf_w2e_kernel(CF_ARGS) { eak4xecf::expert_body_e<false, PF>(CF_PASS); }
+#undef R
+constexpr int CF_SMEM = eak4x::SMEM + 128;  // + the list
+static_assert(eak4::THREADS == 288 && 2 * (CF_SMEM + 1024) <= 233472 && eacf::OWN + 1024 <= eak4::STAGE2, "CF smem");
+std::vector<int64_t> ea4xcf_info() {  // K2 s, e PF 2 / 1 / 0: ok, regs, lmem, smem, CTAs/SM; sets the smem limits
+  std::vector<int64_t> r;
+  for (const void* p : {(const void*)cf_w2s_kernel, (const void*)cf_w2e_kernel<2>, (const void*)cf_w2e_kernel<1>,
+                        (const void*)cf_w2e_kernel<0>}) {
+    cudaFuncAttributes a{};
+    int occ = 0;
+    const bool ok = cudaFuncSetAttribute(p, cudaFuncAttributeMaxDynamicSharedMemorySize, CF_SMEM) == cudaSuccess &&
+                    cudaFuncGetAttributes(&a, p) == cudaSuccess &&
+                    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&occ, p, 288, CF_SMEM) == cudaSuccess;
+    if (!ok) (void)cudaGetLastError();
+    r.insert(r.end(), {ok, a.numRegs, (int64_t)a.localSizeBytes, CF_SMEM, occ});
+  }
+  return r;
+}
+// ea4x_w2's arguments + the combine's; pdl bit 14: EPLF (PF bits 12..13), 15: cf0
+void ea4x_w2cf(torch::Tensor h, torch::Tensor ids, torch::Tensor wr, torch::Tensor gs, torch::Tensor y, torch::Tensor ws,
+               torch::Tensor tk, torch::Tensor err, int64_t T, int64_t start, int64_t count, int64_t grid, int64_t dq,
+               int64_t pdl, torch::Tensor tw, torch::Tensor w, torch::Tensor out, torch::Tensor cfc, double eps) {
+  const int64_t sel = (pdl >> 12) & 3, K = 4096;
+  TORCH_CHECK(T >= 1 && T <= 256 && T <= grid && grid <= 512 && dq == 2 && sel <= 2 && ids.numel() == T * 8 &&
+              tw.numel() == T * 8 && out.numel() == T * K && cfc.numel() >= T && y.numel() >= T * 8 * K, "ea4x_w2cf");
+  cudaLaunchAttribute la{cudaLaunchAttributeProgrammaticStreamSerialization};
+  la.val.programmaticStreamSerializationAllowed = 1;
+  cudaLaunchConfig_t cfg{dim3(grid), dim3(288), CF_SMEM, at::cuda::getCurrentCUDAStream(), &la, unsigned(pdl & 1)};
+  const eacf::Cf cf{tw.data_ptr<float>(), (const __nv_bfloat16*)w.data_ptr(), (__nv_bfloat16*)out.data_ptr(),
+                    cfc.data_ptr<int>(), float(eps)};
+  auto go = [&](auto k) {
+    return cudaLaunchKernelEx(&cfg, k, (const __nv_bfloat16*)h.data_ptr(), ids.data_ptr<int>(), wr.data_ptr<uint8_t>(),
+                              gs.data_ptr<float>(), (__nv_bfloat16*)y.data_ptr(), ws.data_ptr<float>(), tk.data_ptr<int>(),
+                              err.data_ptr<int>(), int(T), int(start), int(count), int(pdl), cf);
+  };
+  const cudaError_t le = !(pdl >> 14 & 1) ? go(cf_w2s_kernel) : sel == 2 ? go(cf_w2e_kernel<2>)
+                         : sel == 1 ? go(cf_w2e_kernel<1>) : go(cf_w2e_kernel<0>);
+  if (le != cudaSuccess) (void)cudaGetLastError();
+  TORCH_CHECK(le == cudaSuccess, "ea4x_w2cf: ", cudaGetErrorString(le));
+}
+"""
+_CMBF_LST = "reinterpret_cast<int*>(smem + eacf::LST)"
+_CMBF_EPI = "    epi<W13>(c, m, v, si, half, wq, g, cq, s_gs[m.v_e[v]], out);\n  }\n"
+_CMBF_TAIL = f"  eacf::cf_tail<NS>(m, ring, {_CMBF_LST}, topk_ids, out, T, start, count, pdl, cf);\n"
+_CMBF_PUB = "  if (es & ES_PUB) publish();  // the head piece was this CTA's last unit\n"
+_CMBF_PATCH = [(" " * 46 + "int pdl) {\n", " " * 46 + "int pdl, const eacf::Cf& cf) {\n  static_assert(!W13, \"CF\");\n"),
+               ("  const int W = m.n_v * NS * NK;\n", f"  eacf::cf_head(topk_ids, T, start, count, pdl, cf, {_CMBF_LST});\n"
+                "  const int W = m.n_v * NS * NK;\n"),
+               (_CMBF_EPI, _CMBF_EPI[:-4] + f"    eacf::cf_note({_CMBF_LST}, sgrp, err);\n  }}\n")]
+_CMBF_CUT = {"eak4x": ("template <int DQ, bool DEFER>\n__global__", _CMBF_PATCH[2][1][-60:]),  # kernels cut;
+             "eak4xe": ("template <int PF>\n__global__", _CMBF_PUB)}  # the tail goes after the second
+
+
+def _cmbf_source():
+    base, out = _stk_source(), []
+    for nm, body in (("eak4x", _EA4X_SRC_BODY), ("eak4xe", _STK_SRC_BODY)):
+        cut, after = _CMBF_CUT[nm]
+        i, b = body.find(f"namespace {nm} {{"), len(nm) + 12
+        text = body[i + b:body.find(cut, i)]
+        for a, r in _CMBF_PATCH + [(after, after + _CMBF_TAIL)]:
+            if text.count(a) != 1 or i < 0 or not base.endswith(_STK_SRC_BODY):
+                raise RuntimeError(f"cmbf: {nm} anchor x{text.count(a)}: {a[:50]!r}")
+            text = text.replace(a, r)
+        out.append(f"namespace {nm}cf {{{text}}}  // namespace {nm}cf\n")
+    dev, host = _CMBF_SRC_BODY.split("// ---- CF host ----\n")
+    return base[:len(base) - len(_STK_SRC_BODY)] + dev + "".join(out) + host
+
+
+def _cmbf_cpp():  # the declarations, from the definitions
+    sig = _CMBF_SRC_BODY[_CMBF_SRC_BODY.find("void ea4x_w2cf("):]
+    return "#include <torch/extension.h>\nstd::vector<int64_t> ea4xcf_info();\n" + sig[:sig.find(" {")] + ";\n"
+
+
+def _cmbf_build_start(t_prepare):
+    def run():  # joins the v4x / EPLF / ea6 builds first, so it never competes with them
+        try:
+            src, ths = _cmbf_source(), [r.get("thread") for r in (_EA4X_BUILD, _STK_BUILD, _EA6_BUILD)]
+            for th in ths:
+                if th is not None:
+                    th.join(max(0.0, CMBF_BUILD_S - (time.perf_counter() - t_prepare)))
+            t0 = _CMBF_BUILD["t0"] = time.perf_counter() - t_prepare
+            _CMBF_BUILD["result"] = (
+                (None, f"not started at {t0:.0f} s", 0.0) if t0 > CMBF_BUILD_S or any(th and th.is_alive() for th in ths)
+                else _rt_build("[cmbf]", "okc_campaign_engine_a_v4xcf_" + hashlib.sha256(src.encode()).hexdigest()[:10],
+                               _cmbf_cpp(), src, ("ea4xcf_info", "ea4x_w2cf")))
+        except BaseException as e:  # prepare only
+            _CMBF_BUILD["result"] = (None, f"build raised {type(e).__name__}: {str(e)[:150]}", 0.0)
+    import hashlib
+    import threading
+    _CMBF_BUILD.clear()
+    CMBF_LINES.clear()
+    _CMBF_BUILD["thread"] = threading.Thread(target=run, name="cmbf-build", daemon=True)
+    _CMBF_BUILD["thread"].start()
+
+
+def _cmbf_run(ea, twin, mode, x, ids, tw, start, count, norm_w, poison=False, cuda_cmb=None):
+    """(out, y): the twin's K1, K2 (inc / cf / cf0) and, but for cf, _ea3_forward_core's combine."""
+    e = twin in STK_EARMS
+    sx, b, kx = ("e", STK_EARMS[twin] | ea.get("e_pf", 0), ea["ext4xe"]) if e else ("x", EA4X_ARMS[twin], ea["ext4x"])
+    T, hidden = x.shape
+    h, y, out = (torch.empty(s, device=x.device, dtype=torch.bfloat16)
+                 for s in ((T * TOP_K, ea["inter"]), (T * TOP_K, hidden), (T, hidden)))
+    lid = torch.empty((T, TOP_K), device=x.device, dtype=torch.int32)
+    for t_ in (h, y, out) if poison else ():
+        t_.fill_(float("nan"))
