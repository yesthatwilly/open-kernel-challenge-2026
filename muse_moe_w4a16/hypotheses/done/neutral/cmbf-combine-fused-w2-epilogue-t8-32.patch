+    getattr(kx, k + "13")(x, ids, ea["w13r"], ea["gs13"], h, lid, ea["ws13" + sx], ea["tk13" + sx], ea["err" + sx], T,
+                          start, count, ea["grid"], ea["dq"], b)
+    a2 = (h, ids, ea["w2r"], ea["gs2"], y, ea["ws2" + sx], ea["tk2" + sx], ea["err" + sx], T, start, count,
+          ea.get("g2_t", {}).get(T, ea["grid"]), ea["dq"], ea["pdl"] | b)
+    if mode == "inc":
+        getattr(kx, k + "2")(*a2)
+    else:  # pdl bit 14: EPLF, 15: cf0
+        ea["extcf"].ea4x_w2cf(*a2[:-1], a2[-1] | (e << 14) | ((mode == "cf0") << 15), tw32, norm_w, out, ea["cfc"],
+                              POST_NORM_EPS)
+    if mode == "cf":
+        pass
+    elif ea.get("cmb_t", {}).get(T, 0) if cuda_cmb is None else cuda_cmb:
+        ea["ext"].ea_combine(y, lid, tw32, norm_w, out, POST_NORM_EPS, 1)
+    else:
+        _post_norm_combine_kernel[(T,)](y, lid, tw32, norm_w, out, hidden, POST_NORM_EPS, TOP_K_C=TOP_K,
+                                        BLOCK_H=triton.next_power_of_2(hidden), num_warps=8)
+    return out, y
+
+
+def _cmbf_sums(ea, sx):
+    return [int(v) for v in torch.stack([ea[k].sum() for k in ("tk13" + sx, "tk2" + sx, "err" + sx, "cfc")]).tolist()]
+
+
+def _cmbf_canary(weights, bank, state, device, t_prepare, cls, twin, gen):
+    """Eager, NaN h / y / out / partials: twin + ea_combine vs cf, cf, cf0, cf0 bitwise (out, y), sums 0."""
+    ea, start, count, sx, runs = state["ea"], bank["start"], bank["count"], "e" if twin in STK_EARMS else "x", 0
+    for T in (t for t in EA4X_CANARY_T if t in EA4X_CLASSES[cls]):
+        if time.perf_counter() - t_prepare > CMBF_GATE_S:
+            return runs, f"deadline at T={T}"
+        routs = _ea_routings(T, gen, list(range(start, start + count)), device) + (
+            list(_ea_judge_routings(T, gen, start, count, device).items()) if T > 32 else
+            [_ea4x_draws(T, gen, start, count, device)[1]] if T >= 8 else [])
+        for label, ids in routs:
+            x = torch.randn((T, weights["w2"].shape[1]), generator=gen).to(torch.bfloat16).to(device)
+            tw = torch.rand((T, TOP_K), generator=gen)
+            a = (x, ids, (tw / tw.sum(-1, keepdim=True)).to(device), start, count, state["post_norm_w"], True, 1)
+            ro, ry = _cmbf_run(ea, twin, "inc", *a)
+            for mode in ("cf", "cf", "cf0", "cf0"):
+                ea["ws13" + sx].fill_(float("nan"))
+                ea["ws2" + sx].fill_(float("nan"))
+                o, y = _cmbf_run(ea, twin, mode, *a)
+                s, runs = _cmbf_sums(ea, sx), runs + 1
+                why = ("out neq" if not torch.equal(o.view(torch.int16), ro.view(torch.int16)) else
+                       "y neq" if not torch.equal(y.view(torch.int16), ry.view(torch.int16)) else f"sums {s}" if any(s)
+                       else "")
+                if why:
+                    return runs, f"{mode} T={T} {label.split(' ')[0]} {why}"
+    return runs, ""
+
+
+def _cmbf_sass(mod, key):  # SASS instructions of the kernel whose mangled name holds key
+    try:
+        with open(mod.__file__, "rb") as f:
+            return next(str(n // 16) for cub in _es_cubins(f.read())[0] for nm, (_, n) in _es_elf_sections(cub).items()
+                        if nm.startswith(".text.") and key in nm)
+    except Exception:
+        return "?"
+
+
+def _cmbf_verdict(res):
+    """The review's (A) / (B) / (C) on pooled p50 d = inc - cf (us) of valid classes; T128 apart."""
+    dv = {c: (e["d"][1], 100.0 * e["d"][1] / e["med"]["inc"][1] / 6.0) for c, e in res.items() if e.get("valid")}
+    if 16 not in dv or 32 not in dv:
+        return [f"[cmbf] VERDICT none: valid {sorted(dv)}, needs T16 and T32"]
+    lo, hi = min(dv[16][0], dv[32][0]), max(dv[16][0], dv[32][0])
+    mid = sum(CMBF_MIDS) + sum(v[1] for c, v in dv.items() if c != 128)  # stack3 mid: EPF + slot rider + sum d/inc/6
+    return [f"[cmbf] VERDICT {'A LEAD: mint stack3' if lo >= 2.0 and mid >= 2.5 else 'C REFUTED' if hi < 1.0 else 'B SHELF'}"
+            f" | min/max(d16, d32) {lo:+.2f}/{hi:+.2f} us | stack3 mid {CMBF_MIDS[0]}+{CMBF_MIDS[1]}+" +
+            "+".join(f"T{c} {v[1]:.2f}" for c, v in dv.items() if c != 128) + f" = {mid:.2f}% (LEAD >= 2.5%) | T128 " +
+            (f"d {dv[128][0]:+.2f} us = {dv[128][1]:.2f}% apart" if 128 in dv else "-")]
+
+
+def _cmbf_stage(weights, bank, state, device, t_prepare):
+    """After _stk_stage: join, admission, per class canary, copy check (the copy clones its own zeroed cfc) and a
+    pooled paired race of inc (routed twin + combine), cf0 and cf. Print-only; never raises."""
+    ea, t0, say, added, res = state["ea"], time.perf_counter(), CMBF_LINES.append, {}, {c: {} for c in EA4X_CLASSES}
+    prev = dict(ea["on"])
+    try:
+        th = _CMBF_BUILD.get("thread")
+        th.join(max(0.0, CMBF_JOIN_S - (time.perf_counter() - t_prepare)))
+        ext, why, dt = _CMBF_BUILD.get("result", (None, "not joined", 0.0))
+        if ext is None or th.is_alive() or ea.get("dq") != 2 or "ext4x" not in ea:
+            raise RuntimeError(f"no CF ({why[:120]}; dq {ea.get('dq')})")
+        pf = (ea.get("e_pf", 0) >> STK_PF_SHIFT[1]) & 3
+        pi = 1 + STK_PF_ORDER.index(pf)
+        info, xe = [int(v) for v in ext.ea4xcf_info()], ea.get("ext4xe")
+        rows = [info[0:5], info[5 * pi:5 * pi + 5], [int(v) for v in ea["ext4x"].ea4x_info()][10:15],
+                [int(v) for v in xe.ea4xe_info()][10 + 5 * pi:15 + 5 * pi] if xe else [0] * 5]
+        ok = [r[0] == 1 and r[1] <= STK_REG_CAP and r[2] == 0 and r[4] == 2 for r in rows[:2]]
+        ok[1] = ok[1] and xe is not None
+        say(f"[cmbf] build {dt:.1f} s from {_CMBF_BUILD.get('t0', 0.0):.0f} s; regs/lmem/occ/sass " + " ".join(
+            f"{nm} {r[1]}/{r[2]}/{r[4]}/{_cmbf_sass(mod, key)}" for nm, r, mod, key in (
+                ("K2s", rows[2], ea["ext4x"], "ea4x_w2_kernelILi2ELb0EE"), ("cf", rows[0], ext, "cf_w2s_kernel"),
+                (f"| K2e p{pf}", rows[3], xe, f"ea4xe_w2_kernelILi{pf}EE"), ("cf", rows[1], ext, f"cf_w2e_kernelILi{pf}EE")))
+            + f" | admit s {ok[0]} e {ok[1]}")
+        ea["extcf"], ea["cfc"] = ext, torch.zeros(EA3_MAX_T, dtype=torch.int32, device=device)
+        added = {f"{a}.{md}": (lambda ea_, x, i, w, s, c, n, trace=None, a=a, md=md:
+                               _cmbf_run(ea_, a, md, x, i, w, s, c, n)[0])
+                 for a in ("v4xs", "v4cxs", "v4xe", "v4cxe") for md in ("cf", "cf0")}
+        _EA4X_CORES.update(added)
+        for cls, ent in res.items():
+            inc = ea["on"].get(cls)
+            twin = (inc if (inc in ("v4xs", "v4cxs") and ok[0]) or (inc in STK_EARMS and ok[1]) else
+                    STK_EBASE[inc] + "xs" if inc in STK_EARMS and ok[0] else None)  # v4xe -> v4xs, v4cxe -> v4cxs
+            ent["why"] = f"inc {inc or 'master'}" + (", no CF twin" if twin is None else ", deadline")
+            if twin is None or time.perf_counter() - t_prepare > CMBF_GATE_S:
+                continue
+            sx, arms, gen = "e" if twin in STK_EARMS else "x", (f"{twin}.cf0", f"{twin}.cf"), torch.Generator()
+            gen.manual_seed(20261106 + cls)
+            ent.update({"twin": twin + (" (EPLF CF not admitted)" if twin != inc else ""), "arms": arms})
+            try:  # a raise loses this class only
+                ent["can"] = _cmbf_canary(weights, bank, state, device, t_prepare, cls, twin, gen)
+                if ent["can"][1]:
+                    raise RuntimeError("canary " + ent["can"][1])
+                ea["cfc"].zero_()  # the copy check's state copy clones it: its own zeroed counters
+                cc = (_stk_copy_check if sx == "e" else _ea4x_copy_check)(weights, bank, state, device, cls, arms[1])
+                ent["copy"] = (cc[0] and ea["cfc"].sum().item() == 0, cc[1][:40])
+                inputs = _ea4x_draws(cls, gen, start=bank["start"], count=bank["count"], device=device)
+                per = {lab: [] for lab, _ in inputs}
+                ea["on"][cls] = twin  # the race's inc: the routed twin (arm s when EPLF's CF is not admitted)
+                for j in range(1 + EA4X_MORE):
+                    if j == 0 or time.perf_counter() - t_prepare < CMBF_GATE_S:
+                        for lab, r in _ea6_race(bank, state, device, cls, inputs, arms, weights["w2"].shape[1],
+                                                20261206 + 977 * j + cls).items():
+                            per[lab].extend(r)
+            except Exception as e:
+                ent["why"] = f"{type(e).__name__}: {str(e)[:80]}"
+                continue
+            finally:
+                ea["on"][cls] = prev[cls]
+            n = min(len(r) for r in per.values())
+            md = ent["med"] = {nm: [_rt_stats([s for r in per[lab][:n] for s in r[nm]])[0] for lab in per]
+                               for nm in ("inc",) + arms}
+            rr, pooled = _ea4x_rstats(per, list(per), arms[1])
+            ent.update({"d": [a - b for a, b in zip(md["inc"], md[arms[1]])], "n": n, "sums": _cmbf_sums(ea, sx),
+                        "wr": (min(r[0] for r in rr), pooled[0])})
+            ent["valid"] = ent["copy"][0] and not any(ent["sums"])
+    except Exception as e:  # prepare only: the routed arms stay
+        ea["on"].clear()
+        ea["on"].update(prev)
+        say(f"[cmbf] stage stopped: {type(e).__name__}: {str(e)[:160]}")
+    for cls, ent in res.items():
+        if "med" not in ent:
+            say(f"[cmbf] T{cls} {ent.get('twin', '-')}: no reading ({ent.get('why')}) | NOT ROUTED (diag)")
+            continue
+        md, (a0, a1) = ent["med"], ent["arms"]
+        f = lambda k: "/".join(f"{v:.1f}" for v in md[k])  # noqa: E731
+        say(f"[cmbf] T{cls} {ent['twin']} us p10/p50/p90 inc {f('inc')} cf0 {f(a0)} cf {f(a1)} | judge row "
+            f"{CMBF_ROW[cls]} us")
+        say(f"[cmbf] T{cls} d inc-cf " + "/".join(f"{v:+.2f}" for v in ent["d"]) + f" tax cf0-inc {md[a0][1] - md['inc'][1]:+.2f}"
+            f" fuse cf0-cf {md[a0][1] - md[a1][1]:+.2f} | inc/cf worst/pooled {ent['wr'][0]:.3f}/{ent['wr'][1]:.3f} "
+            f"r{ent['n']} | canary {ent['can'][0]} copy {ent['copy'][1]} sums {ent['sums']} | NOT ROUTED (diag)")
+    try:
+        CMBF_LINES.extend(_cmbf_verdict(res))
+        for k in ("tk13x", "tk2x", "errx", "tk13e", "tk2e", "erre"):
+            if k in ea:
+                ea[k].zero_()
+        torch.cuda.synchronize()
+    except Exception as e:
+        say(f"[cmbf] verdict / final sync raised {type(e).__name__}: {str(e)[:120]}")
+    for k in added:  # diag: kernel_fn's engine table and the state end as master's
+        _EA4X_CORES.pop(k, None)
+    ea.pop("extcf", None)
+    ea.pop("cfc", None)
+    say(f"[cmbf] stage {time.perf_counter() - t0:.1f} s, at {time.perf_counter() - t_prepare:.1f} s")
+    return [f"{EA_TAG} cmbf stage done in {time.perf_counter() - t0:.1f} s ([cmbf] lines printed last)"]
+
+
+def _cmbf_final(t_prepare):  # prepare()'s end: no CF build outlives prepare(); the [cmbf] lines
+    th = _CMBF_BUILD.get("thread")
+    if th and th.is_alive():
+        th.join(max(0.0, CMBF_REAP_S - (time.perf_counter() - t_prepare)))
+        CMBF_LINES.append(f"[cmbf] build joined at {time.perf_counter() - t_prepare:.1f} s, alive {th.is_alive()}")
+    for ln in CMBF_LINES or ["[cmbf] stage did not run"]:
+        print(ln[:199], flush=True)
+# ---- end include rewrite/lib/cmbf_core.py ----
 # ---- campaign W3: Engine B (128 <= T <= 512); inert until turned on ----
 CAMPAIGN_ENGINE_B = False   # W3: Engine B at 128 <= T <= 512 (cells c2 / c1, per-bucket selector, copy check)
