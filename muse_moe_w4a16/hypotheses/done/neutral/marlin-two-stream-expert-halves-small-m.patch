+def _experts_two_stream(x, topk_ids, topk_weights, bank, state, block_size_m):
+    """Hypothesis marlin-two-stream-expert-halves-small-m: the expert work split by local expert
+    into half A (0-15) on the current stream and half B (16-31) on the prepare-time side stream,
+    each running master's w13 Marlin -> silu_and_mul -> w2 Marlin over its own routes only.
+
+    Each half has its own cache1/cache2 (one stacked allocation each) and its own Marlin lock
+    workspace; both halves write disjoint rows (their own routes) of one shared cache3, which is
+    a separate buffer (master's cache13 aliasing of cache1/cache3 would race across streams).
+    Every buffer is allocated on the current stream before the fork; the join precedes the
+    post-norm. Returns the full local_ids and y [M, 8, H]."""
+    num_tokens, size_k = x.shape
+    size_n = bank["size_n"]
+    gemm1_n = 2 * size_n
+    local_ids, local_ids_h, triples = _align_small_halves(topk_ids, bank["start"], bank["count"], block_size_m)
+    cache1 = torch.empty((2, num_tokens * TOP_K, gemm1_n), device=x.device, dtype=x.dtype)
+    cache2 = torch.empty((2, num_tokens * TOP_K, size_n), device=x.device, dtype=x.dtype)
+    cache3 = torch.empty((num_tokens * TOP_K, size_k), device=x.device, dtype=x.dtype)
+    common = dict(moe_block_size=block_size_m, mul_topk_weights=False, is_ep=True,
+                  b_q_type=scalar_types.float4_e2m1f, is_k_full=True, use_atomic_add=False,
+                  use_fp32_reduce=True, is_zp_float=False)
+    current, side = torch.cuda.current_stream(), state["side_stream"]
+    side.wait_stream(current)
+    for h, (ws, stream) in enumerate(((state["workspace"], current), (state["workspace_b"], side))):
+        sorted_ids, block_experts, n_padded = triples[h]
+        with torch.cuda.stream(stream):
