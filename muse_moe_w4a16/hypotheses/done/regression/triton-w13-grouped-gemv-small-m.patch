+# Small-M w13 path (num_tokens <= GEMV_MAX_TOKENS). Fixed configs, no autotune.
+GEMV_MAX_TOKENS = 8
+GEMV_BLOCK_M = 16   # >= the most slots one expert can get (a token routes to an expert once)
+GEMV_BLOCK_N = 32
+GEMV_BLOCK_K = 256
+GEMV_WARPS = 4
+GEMV_STAGES = 3
+COMPACT_BLOCK_S = 64  # >= GEMV_MAX_TOKENS * TOP_K flat slots
+
+
+@triton.jit
+def _compact_routes_kernel(ids_ptr, cnt_ptr, slot_ptr, n_slots,
+                           BLOCK_S: tl.constexpr, BLOCK_M: tl.constexpr):
+    """Program e: cnt[e] = #slots routed to local expert e, slot[e, :cnt] = those flat slots."""
+    e = tl.program_id(0)
+    offs = tl.arange(0, BLOCK_S)
+    ids = tl.load(ids_ptr + offs, mask=offs < n_slots, other=-1)
+    hit = (ids == e).to(tl.int32)
+    pos = tl.cumsum(hit, axis=0) - 1
+    tl.store(slot_ptr + e * BLOCK_M + pos, offs, mask=(hit != 0) & (pos < BLOCK_M))
+    tl.store(cnt_ptr + e, tl.minimum(tl.sum(hit, axis=0), BLOCK_M))
+
+
+@triton.jit
+def _e2m1_to_f32(c):
+    """4-bit E2M1 code (bit 3 sign) -> float32, built from bits: magnitude grid
+    (0, .5, 1, 1.5, 2, 3, 4, 6) for code & 7, exactly as nvfp4.unpack_e2m1."""
+    c = c.to(tl.int32)
+    ex = (c >> 1) & 3
+    m = c & 1
+    bits = tl.where(ex == 0, m * (126 << 23), ((ex + 126) << 23) | (m << 22))
+    bits = bits | ((c & 8) << 28)
+    return bits.to(tl.float32, bitcast=True)
+
+
+@triton.jit
+def _w13_gemv_kernel(x_ptr, w_ptr, sf_ptr, gs_ptr, cnt_ptr, slot_ptr, out_ptr,
+                     N: tl.constexpr, K: tl.constexpr, TOPK: tl.constexpr,
+                     BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr):
+    """Program (e, n): out[slot, n-tile] = x[slot // TOPK] @ dequant(w13[e])[n-tile].T for the
+    cnt[e] slots of local expert e; returns at once if expert e has no slot."""
+    e = tl.program_id(0)
+    pid_n = tl.program_id(1)
+    cnt = tl.load(cnt_ptr + e)
+    if cnt == 0:
+        return
+    offs_m = tl.arange(0, BLOCK_M)
+    m_mask = offs_m < cnt
+    slots = tl.load(slot_ptr + e * BLOCK_M + offs_m, mask=m_mask, other=0)
+    toks = slots // TOPK
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_kb = tl.arange(0, BLOCK_K // 2)   # packed bytes: byte j holds elements 2j (lo), 2j+1 (hi)
+    offs_k = tl.arange(0, BLOCK_K)
+    e64 = e.to(tl.int64)
+    w_rows = w_ptr + e64 * (N * (K // 2)) + offs_n[:, None].to(tl.int64) * (K // 2)
+    sf_rows = sf_ptr + e64 * (N * (K // 16)) + offs_n[:, None].to(tl.int64) * (K // 16)
+    x_rows = x_ptr + toks[:, None].to(tl.int64) * K
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for k0 in range(0, K, BLOCK_K):
+        kb = k0 // 2 + offs_kb
+        packed = tl.load(w_rows + kb[None, :])
+        # Elements 2j and 2j+1 share block scale (2j) // 16 = j // 8.
+        scale = tl.load(sf_rows + (kb // 8)[None, :]).to(tl.float32)
+        lo = _e2m1_to_f32(packed & 0xF) * scale
+        hi = _e2m1_to_f32(packed >> 4) * scale
+        # e2m1 * e4m3 has <= 6 significant bits: exact in bf16. Natural K order via interleave.
+        w = tl.interleave(lo, hi).to(tl.bfloat16)          # [BLOCK_N, BLOCK_K]
+        xt = tl.load(x_rows + (k0 + offs_k)[None, :], mask=m_mask[:, None], other=0.0)
+        acc = tl.dot(xt, tl.trans(w), acc)
+    # The fp32 per-expert global scale, once, after the K loop.
+    acc = acc * tl.load(gs_ptr + e)
+    out = out_ptr + slots[:, None].to(tl.int64) * N + offs_n[None, :]
+    tl.store(out, acc.to(tl.bfloat16), mask=m_mask[:, None])
+
+
+def _w13_small_m(x, local_ids, cache1, raw, count):
+    """The w13 projection for num_tokens <= GEMV_MAX_TOKENS into cache1 [M*8, 2I] (local slots)."""
+    n_slots = local_ids.numel()
+    cnt = torch.empty((count,), dtype=torch.int32, device=x.device)
+    slot_list = torch.empty((count * GEMV_BLOCK_M,), dtype=torch.int32, device=x.device)
+    _compact_routes_kernel[(count,)](local_ids, cnt, slot_list, n_slots,
+                                     BLOCK_S=COMPACT_BLOCK_S, BLOCK_M=GEMV_BLOCK_M, num_warps=1)
+    n, k = cache1.shape[1], x.shape[1]
+    _w13_gemv_kernel[(count, n // GEMV_BLOCK_N)](
+        x, raw["w13"], raw["w13_sf"], raw["w13_gs"], cnt, slot_list, cache1,
+        N=n, K=k, TOPK=TOP_K, BLOCK_M=GEMV_BLOCK_M, BLOCK_N=GEMV_BLOCK_N, BLOCK_K=GEMV_BLOCK_K,
+        num_warps=GEMV_WARPS, num_stages=GEMV_STAGES)
+    return cache1
+
 
