+@triton.jit(do_not_specialize=["local_start", "local_count"])
+def _l2_prefetch_w2_kernel(topk_ids_ptr, w2_ptr, w2s_ptr, sink_ptr, local_start, local_count,
+                           w2_expert_words, w2s_expert_words, TOP_K_C: tl.constexpr,
+                           BLOCK: tl.constexpr):
+    """Hypothesis w2-l2-prefetch-decode1: read this token's local experts' w2 codes and scales
+    (int32 views of the prepare()-time Marlin banks) with evict_last, so the w2 Marlin call that
+    follows hits L2. One token (M == 1). Each program takes a grid-strided share of BLOCK-word
+    chunks of each distinct local expert's two slabs; remote slots and repeats of an earlier
+    slot's expert are skipped. The XOR of the words read goes to sink[pid], which nothing reads:
+    it only keeps the loads alive."""
+    pid = tl.program_id(0)
+    nprog = tl.num_programs(0)
+    offs = tl.arange(0, BLOCK)
+    acc = tl.zeros([BLOCK], dtype=tl.int32)
+    n_w = tl.cdiv(w2_expert_words, BLOCK)
+    n_s = tl.cdiv(w2s_expert_words, BLOCK)
+    for s in tl.static_range(TOP_K_C):
+        e = tl.load(topk_ids_ptr + s).to(tl.int32) - local_start
+        take = (e >= 0) & (e < local_count)
+        for j in tl.static_range(s):
+            ej = tl.load(topk_ids_ptr + j).to(tl.int32) - local_start
+            take = take & (ej != e)
+        if take:
+            base_w = e.to(tl.int64) * w2_expert_words
+            for c in range(pid, n_w, nprog):
+                o = c.to(tl.int64) * BLOCK + offs
+                acc ^= tl.load(w2_ptr + base_w + o, mask=o < w2_expert_words, other=0,
+                               eviction_policy="evict_last")
+            base_s = e.to(tl.int64) * w2s_expert_words
+            for c in range(pid, n_s, nprog):
+                o = c.to(tl.int64) * BLOCK + offs
+                acc ^= tl.load(w2s_ptr + base_s + o, mask=o < w2s_expert_words, other=0,
+                               eviction_policy="evict_last")
+    tl.store(sink_ptr + pid, tl.xor_sum(acc, axis=0))
+
+
+def _l2_prefetch_w2(topk_ids, pf, local_start, local_count):
+    """Launch _l2_prefetch_w2_kernel on the current stream (M == 1 only). pf holds the bank's
+    int32 views, per-expert word counts, sink and grid, all built in prepare()."""
+    _l2_prefetch_w2_kernel[(pf["programs"],)](
+        topk_ids.contiguous(), pf["w2_words"], pf["w2s_words"], pf["sink"], local_start, local_count,
+        pf["w2_expert_words"], pf["w2s_expert_words"], TOP_K_C=TOP_K, BLOCK=L2_PREFETCH_BLOCK,
+        num_warps=4)
+
+
+def _l2_prefetch_state(bank, device):
+    """Untimed, prepare() only: int32 views of the stacked [count, ...] w2 code and scale banks."""
+    count = bank["count"]
+    views = {}
+    for key in ("w2", "w2_s"):
+        t = bank[key]
+        assert t.shape[0] == count and t.is_contiguous(), (key, t.shape)
+        expert_bytes = t[0].numel() * t.element_size()
+        assert expert_bytes % 4 == 0, (key, expert_bytes)
+        views[key] = (t.reshape(-1).view(torch.int32), expert_bytes // 4)
+    programs = 2 * torch.cuda.get_device_properties(device).multi_processor_count
+    return {
+        "w2_words": views["w2"][0], "w2_expert_words": views["w2"][1],
+        "w2s_words": views["w2_s"][0], "w2s_expert_words": views["w2_s"][1],
+        "programs": programs,
+        # Written by every launch, never read.
+        "sink": torch.empty((programs,), dtype=torch.int32, device=device),
+    }
+
