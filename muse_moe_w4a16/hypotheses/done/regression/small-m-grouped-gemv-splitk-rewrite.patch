 from sgl_kernel.scalar_type import scalar_types
 
 from sglang.kernels.ops.activation.activation import silu_and_mul
@@ -70,6 +82,240 @@ TOP_K = 8
 BLOCK_SIZE_M_CANDIDATES = (8, 16, 32, 48, 64)
 POST_NORM_EPS = 1e-8
 
+# ---- small-M path (num_tokens <= SMALL_MAX_TOKENS): persistent split-K grouped W4A16 GEMV ----
+SMALL_MAX_TOKENS = 16
+SMALL_BLOCK_M = 16     # align block: every touched local expert is ONE block (cnt[e] <= M <= 16)
+SMALL_PART_ROWS = SMALL_MAX_TOKENS * TOP_K   # 128 flat slots at most
+SMALL_NB_PAD = 64      # >= moe_align's static block count at M=16 (~39)
+SMALL_BLOCK_K = 256
+SMALL_WARPS = 4
+SMALL_STAGES = 4
+SMALL_DEFAULT_CTAS_PER_SM = 2
+# Fixed configs (no autotune): (BLOCK_N, SPLIT_K). Items per touched expert = (N/BLOCK_N) * SPLIT_K.
+#   w13: N=8192, K=4096 -> 128 n-tiles x 4 splits (K 1024 = 4 BLOCK_K steps) = 512 items
+#   w2:  N=4096, K=4096 ->  64 n-tiles x 8 splits (K  512 = 2 BLOCK_K steps) = 512 items
+# The item x k-step loop is flattened into one linear loop, so prefetch crosses item boundaries.
+SMALL_W13_CFG = (64, 4)
+SMALL_W2_CFG = (64, 8)
+SMALL_CHECK_TOL = 1e-2
+
+
+@triton.jit(do_not_specialize=["n_valid", "nb_static"])
+def _grouped_gemv_splitk_kernel(
+    a_ptr, w_ptr, sf_ptr, gs_ptr, out_ptr, part_ptr, cnt_ptr,
+    sid_ptr, be_ptr, npad_ptr, n_valid, nb_static,
+    N: tl.constexpr, K: tl.constexpr, TOPK: tl.constexpr,
+    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr, SPLIT_K: tl.constexpr,
+    NB_PAD: tl.constexpr, PART_ROWS: tl.constexpr,
+):
+    """out[slot, :] = a[slot // TOPK] @ dequant(w[e])^T for every local slot, one persistent launch.
+
+    a bf16 [*, K]; w uint8 [32, N, K/2] (element 2j low nibble, 2j+1 high nibble, as stored);
+    sf fp8 e4m3 [32, N, K/16]; gs fp32 [32]; out bf16 [*, N] (row = flat slot; remote and padded
+    slots are never written); part fp32 [SPLIT_K, PART_ROWS, N] scratch; cnt int32 [32, N/BLOCK_N]
+    ticket counters, zero between launches (self-resetting). sid/be/npad: moe_align_block_size at
+    block BLOCK_M. Work item = (live local block, n-tile, k-split); item x k-step is ONE flat loop.
+    """
+    NT: tl.constexpr = N // BLOCK_N
+    K_SPLIT: tl.constexpr = K // SPLIT_K
+    KSTEPS: tl.constexpr = K_SPLIT // BLOCK_K
+    IPB: tl.constexpr = NT * SPLIT_K          # items per live block
+    HALF_K: tl.constexpr = BLOCK_K // 2       # packed bytes per row per k-step
+    GROUPS: tl.constexpr = BLOCK_K // 16      # scale groups per row per k-step (8 bytes each)
+
+    pid = tl.program_id(0)
+    n_prog = tl.num_programs(0)
+
+    # Live blocks, read on device. Blocks of remote routes (block expert -1, as Marlin's is_ep path
+    # skips them) form one contiguous run [r0, r0 + n_neg) (one align bucket); live local block lb
+    # is block lb below r0 and block lb + n_neg from r0 on. The item decode below re-checks e >= 0.
+    n_blocks = tl.minimum(tl.load(npad_ptr) // BLOCK_M, nb_static)
+    bidx = tl.arange(0, NB_PAD)
+    inb = bidx < n_blocks
+    be_all = tl.load(be_ptr + bidx, mask=inb, other=0)
+    neg = inb & (be_all < 0)
+    n_neg = tl.sum(neg.to(tl.int32), axis=0)
+    r0 = tl.min(tl.where(neg, bidx, NB_PAD), axis=0)
+    total = (n_blocks - n_neg) * IPB
+    n_my = tl.where(total > pid, (total - pid + n_prog - 1) // n_prog, 0)
+    n_iters = n_my * KSTEPS
+
+    offs_m = tl.arange(0, BLOCK_M)
+    offs_bn = tl.arange(0, BLOCK_N)
+    offs_k = tl.arange(0, BLOCK_K)
+    offs_g = tl.arange(0, GROUPS)
+    offs_b = tl.arange(0, 8)
+
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for t in range(0, n_iters):
+        j = t // KSTEPS
+        ks = t - j * KSTEPS
+        item = pid + j * n_prog
+        lb = item // IPB
+        rem = item - lb * IPB
+        nt = rem // SPLIT_K
+        sk = rem - nt * SPLIT_K
+        blk = tl.where(lb < r0, lb, lb + n_neg)
+        e = tl.load(be_ptr + blk)
+        e_ok = e >= 0
+        e64 = tl.maximum(e, 0).to(tl.int64)
+        slots = tl.load(sid_ptr + blk * BLOCK_M + offs_m)
+        m_mask = (slots < n_valid) & e_ok
+        k0 = sk * K_SPLIT + ks * BLOCK_K
+        offs_n = nt * BLOCK_N + offs_bn
+
+        # Activations: [BLOCK_M, BLOCK_K] bf16 rows gathered by slot, split into even/odd K so the
+        # low/high nibbles of each weight byte need no interleave.
+        rows = (slots // TOPK).to(tl.int64)
+        xa = tl.load(a_ptr + rows[:, None] * K + (k0 + offs_k)[None, :], mask=m_mask[:, None], other=0.0)
+        x_even, x_odd = tl.split(tl.reshape(xa, (BLOCK_M, HALF_K, 2)))
+
+        # Weights: [BLOCK_N, GROUPS, 8] packed bytes (8 bytes = one 16-element scale group).
+        w_row = w_ptr + e64 * (N * (K // 2)) + offs_n.to(tl.int64)[:, None, None] * (K // 2)
+        wb = tl.load(w_row + (k0 // 2) + offs_g[None, :, None] * 8 + offs_b[None, None, :]).to(tl.uint16)
+        s_row = sf_ptr + e64 * (N * (K // 16)) + offs_n.to(tl.int64)[:, None] * (K // 16)
+        sc = tl.load(s_row + (k0 // 16) + offs_g[None, :]).to(tl.float32) * 16384.0  # sf * 2^14
+        sc = sc[:, :, None]
+        # E2M1 -> fp16 by bit placement: magnitude bits to fp16 bits 11..9, sign to bit 15, giving
+        # e2m1 * 2^-14 exactly (code 0.5 lands on an fp16 subnormal); cvt to fp32 (exact), one fp32
+        # multiply by sf * 2^14, cvt to bf16 (exact: <= 6 significant bits).
+        lo = (((wb & 0x07) << 9) | ((wb & 0x08) << 12)).to(tl.uint16)
+        hi = (((wb & 0x70) << 5) | ((wb & 0x80) << 8)).to(tl.uint16)
+        lo = lo.to(tl.float16, bitcast=True).to(tl.float32) * sc
+        hi = hi.to(tl.float16, bitcast=True).to(tl.float32) * sc
+        w_lo = tl.reshape(lo, (BLOCK_N, HALF_K)).to(tl.bfloat16)   # K = k0 + 2j
+        w_hi = tl.reshape(hi, (BLOCK_N, HALF_K)).to(tl.bfloat16)   # K = k0 + 2j + 1
+        acc = tl.dot(x_even, tl.trans(w_lo), acc)
+        acc = tl.dot(x_odd, tl.trans(w_hi), acc)
+
+        if ks == KSTEPS - 1:
+            # Split-K reduce: partial store -> barrier -> one gpu-scope acq_rel ticket -> barrier ->
+            # the last-arriving split reloads all partials (.cg, L2) in fixed order.
+            part_off = slots.to(tl.int64)[:, None] * N + offs_n[None, :]
+            tl.store(part_ptr + sk * (PART_ROWS * N) + part_off, acc, mask=m_mask[:, None])
+            tl.debug_barrier()
+            cnt_off = e64 * NT + nt
+            ticket = tl.atomic_add(cnt_ptr + cnt_off, 1, sem="acq_rel", scope="gpu")
+            tl.debug_barrier()
+            if ticket == SPLIT_K - 1:
+                tot = tl.load(part_ptr + part_off, mask=m_mask[:, None], other=0.0, cache_modifier=".cg")
+                for ss in tl.static_range(1, SPLIT_K):
+                    tot += tl.load(part_ptr + ss * (PART_ROWS * N) + part_off, mask=m_mask[:, None],
+                                   other=0.0, cache_modifier=".cg")
+                # The expert's fp32 global scale, applied once here.
+                tot = tot * tl.load(gs_ptr + e64)
+                tl.store(out_ptr + part_off, tot.to(tl.bfloat16), mask=m_mask[:, None])
+                tl.atomic_xchg(cnt_ptr + cnt_off, 0, sem="relaxed", scope="gpu")
+            acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+
+
+def _small_gemv(a, out, w, sf, gs, part, cnt, sorted_ids, block_experts, n_padded, n_valid, topk, cfg, grid):
+    """One persistent launch: out[slot] = a[slot // topk] @ dequant(w[e]).T for the local slots."""
+    block_n, split_k = cfg
+    n, k = w.shape[1], w.shape[2] * 2
+    nb_static = block_experts.numel()
+    assert a.shape[1] == k and out.shape[1] == n and n % block_n == 0
+    assert k % (split_k * SMALL_BLOCK_K) == 0 and n_valid <= SMALL_PART_ROWS and nb_static <= SMALL_NB_PAD
+    return _grouped_gemv_splitk_kernel[(grid,)](
+        a, w, sf, gs, out, part, cnt, sorted_ids, block_experts, n_padded, n_valid, nb_static,
+        N=n, K=k, TOPK=topk, BLOCK_M=SMALL_BLOCK_M, BLOCK_N=block_n, BLOCK_K=SMALL_BLOCK_K,
+        SPLIT_K=split_k, NB_PAD=SMALL_NB_PAD, PART_ROWS=SMALL_PART_ROWS,
+        num_warps=SMALL_WARPS, num_stages=SMALL_STAGES)
+
+
+def _small_forward(x, local_ids, small, count):
+    """w13 GEMV -> silu_and_mul -> w2 GEMV on the small path. Returns y [M, 8, H] bf16."""
+    num_tokens, size_k = x.shape
+    gemm1_n = small["w13"].shape[1]
+    size_n = gemm1_n // 2
+    n_slots = num_tokens * TOP_K
+    sorted_ids, block_experts, n_padded = moe_align_block_size(local_ids, SMALL_BLOCK_M, count)
+    cache2 = torch.empty((n_slots, size_n), device=x.device, dtype=x.dtype)
+    cache13 = torch.empty((n_slots * max(gemm1_n, size_k),), device=x.device, dtype=x.dtype)
+    cache1 = cache13[: n_slots * gemm1_n].view(-1, gemm1_n)
+    cache3 = cache13[: n_slots * size_k].view(-1, size_k)
+    grid = small["grid"]
+    _small_gemv(x, cache1, small["w13"], small["w13_sf"], small["w13_gs"], small["part13"], small["cnt13"],
+                sorted_ids, block_experts, n_padded, n_slots, TOP_K, SMALL_W13_CFG, grid)
+    silu_and_mul(cache1, cache2, expert_ids=local_ids.view(-1), expert_step=1)
+    _small_gemv(cache2, cache3, small["w2"], small["w2_sf"], small["w2_gs"], small["part2"], small["cnt2"],
+                sorted_ids, block_experts, n_padded, n_slots, 1, SMALL_W2_CFG, grid)
+    return cache1, cache3.view(num_tokens, TOP_K, size_k)
+
+
+def _ctas_per_sm(compiled, device):
+    """Resident CTAs per SM from the compiled kernel's shared memory and registers (fixed in prepare)."""
+    try:
+        props = torch.cuda.get_device_properties(device)
+        smem = int(getattr(props, "shared_memory_per_multiprocessor", 228 * 1024))
+        regs = int(getattr(props, "regs_per_multiprocessor", 65536))
+        shared = int(compiled.metadata.shared)
+        n_regs = int(compiled.n_regs)
+        by_smem = smem // (shared + 1024) if shared > 0 else 4
+        by_regs = regs // (n_regs * 32 * SMALL_WARPS) if n_regs > 0 else 4
+        return max(1, min(4, by_smem, by_regs)), f"shared={shared}B regs={n_regs}"
+    except Exception as exc:  # metadata layout differs across Triton versions
+        return SMALL_DEFAULT_CTAS_PER_SM, f"occupancy unknown ({type(exc).__name__}), default"
+
+
+def _row_rel_l2(got, ref):
+    return ((got.float() - ref).norm(dim=-1) / ref.norm(dim=-1).clamp(min=1e-12))
+
+
+def _small_self_test(small, count, device):
+    """Untimed. Both GEMVs on synthetic data made only from the weights and a fixed generator,
+    against an fp32 reference from nvfp4.dequantize. Returns (ok, message)."""
+    gen = torch.Generator(device=device).manual_seed(1234)
+    h = small["w13"].shape[2] * 2
+    inter = small["w2"].shape[2] * 2
+    # Routing cases: experts 0, 7, 31 with 1 and 16 slots, remote (-1) slots, M=16 and M=1.
+    rows16 = [[7] + [-1] * (TOP_K - 1) for _ in range(16)]
+    rows16[0][1] = 0
+    rows16[5][2] = 31
+    rows16[9][4] = 3
+    rows1 = [[31, -1, 3, -1, 12, -1, -1, -1]]
+    worst13 = worst2 = 0.0
+    deq = {}
+    for rows in (rows16, rows1, rows16):
+        m = len(rows)
+        ids = torch.tensor(rows, dtype=torch.int32, device=device)
+        x = torch.randn((m, h), generator=gen, device=device).to(torch.bfloat16)
+        a2 = torch.randn((m * TOP_K, inter), generator=gen, device=device).to(torch.bfloat16)
+        sorted_ids, block_experts, n_padded = moe_align_block_size(ids, SMALL_BLOCK_M, count)
+        out13 = torch.full((m * TOP_K, small["w13"].shape[1]), float("nan"), dtype=torch.bfloat16, device=device)
+        out2 = torch.full((m * TOP_K, small["w2"].shape[1]), float("nan"), dtype=torch.bfloat16, device=device)
+        k13 = _small_gemv(x, out13, small["w13"], small["w13_sf"], small["w13_gs"], small["part13"], small["cnt13"],
+                          sorted_ids, block_experts, n_padded, m * TOP_K, TOP_K, SMALL_W13_CFG, small["grid"])
+        k2 = _small_gemv(a2, out2, small["w2"], small["w2_sf"], small["w2_gs"], small["part2"], small["cnt2"],
+                         sorted_ids, block_experts, n_padded, m * TOP_K, 1, SMALL_W2_CFG, small["grid"])
+        torch.cuda.synchronize()
+        if "occupancy" not in small:
+            c13, d13 = _ctas_per_sm(k13, device)
+            c2, d2 = _ctas_per_sm(k2, device)
+            small["occupancy"] = (min(c13, c2), f"w13 {d13}; w2 {d2}")
+        flat = ids.view(-1)
+        for e in sorted({v for row in rows for v in row if v >= 0}):
+            if e not in deq:
+                deq[e] = (nvfp4.dequantize(small["w13"][e], small["w13_sf"][e], small["w13_gs"][e]),
+                          nvfp4.dequantize(small["w2"][e], small["w2_sf"][e], small["w2_gs"][e]))
+            w13f, w2f = deq[e]
+            slots = (flat == e).nonzero().view(-1)
+            ref13 = x[slots // TOP_K].float() @ w13f.T
+            ref2 = a2[slots].float() @ w2f.T
+            worst13 = max(worst13, float(_row_rel_l2(out13[slots], ref13).nan_to_num(1e9).max()))
+            worst2 = max(worst2, float(_row_rel_l2(out2[slots], ref2).nan_to_num(1e9).max()))
+        remote = (flat < 0).nonzero().view(-1)
+        if not (bool(out13[remote].isnan().all()) and bool(out2[remote].isnan().all())):
+            return False, f"remote slots were written (w13 rel-L2 {worst13:.3e}, w2 {worst2:.3e})"
+        if int(small["cnt13"].abs().sum()) or int(small["cnt2"].abs().sum()):
+            return False, f"ticket counters not reset to zero (w13 rel-L2 {worst13:.3e}, w2 {worst2:.3e})"
+        if "grid_final" not in small:
+            small["grid_final"] = True
+            sms = torch.cuda.get_device_properties(device).multi_processor_count
+            small["grid"] = sms * small["occupancy"][0]
+    ok = worst13 < SMALL_CHECK_TOL and worst2 < SMALL_CHECK_TOL
+    return ok, f"max row rel-L2 w13 {worst13:.3e}, w2 {worst2:.3e} (tol {SMALL_CHECK_TOL:g})"
+
 
