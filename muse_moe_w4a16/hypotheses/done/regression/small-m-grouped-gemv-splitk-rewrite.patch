+def _prepare_small(weights, start, count, device):
+    """The small-M path's state, or None (Marlin everywhere) if its self-test fails. The weights
+    are a contiguous copy of the same NVFP4 bytes, fp8 block scales and fp32 global scales."""
+    sl = slice(start, start + count)
+    small = {name: weights[name][sl].clone().contiguous() for name in ("w13", "w13_sf", "w2", "w2_sf")}
+    small["w13_gs"] = weights["w13_gs"][sl].to(torch.float32).contiguous()
+    small["w2_gs"] = weights["w2_gs"][sl].to(torch.float32).contiguous()
+    n13, n2 = small["w13"].shape[1], small["w2"].shape[1]
+    # Split-K scratch (fp32 [SPLIT_K, 128 slots, N]) and self-resetting ticket counters, zeroed once.
+    small["part13"] = torch.empty((SMALL_W13_CFG[1], SMALL_PART_ROWS, n13), dtype=torch.float32, device=device)
+    small["part2"] = torch.empty((SMALL_W2_CFG[1], SMALL_PART_ROWS, n2), dtype=torch.float32, device=device)
+    small["cnt13"] = torch.zeros((count * (n13 // SMALL_W13_CFG[0]),), dtype=torch.int32, device=device)
+    small["cnt2"] = torch.zeros((count * (n2 // SMALL_W2_CFG[0]),), dtype=torch.int32, device=device)
+    sms = torch.cuda.get_device_properties(device).multi_processor_count
+    small["grid"] = sms * SMALL_DEFAULT_CTAS_PER_SM
+    try:
+        ok, msg = _small_self_test(small, count, device)
+    except Exception as exc:  # compile or launch failure: keep Marlin, loudly
+        ok, msg = False, f"self-test raised {type(exc).__name__}: {exc}"
+    occ = small.get("occupancy", (None, "n/a"))
+    banner = "=" * 100
+    print(banner, flush=True)
+    print(f"[small-m-grouped-gemv-splitk] SELF-TEST {'PASSED' if ok else 'FAILED'}: {msg}", flush=True)
+    print(f"[small-m-grouped-gemv-splitk] grid={small['grid']} CTAs ({occ[0]} per SM; {occ[1]}); "
+          f"w13 cfg (BLOCK_N, SPLIT_K)={SMALL_W13_CFG}, w2 cfg={SMALL_W2_CFG}, BLOCK_K={SMALL_BLOCK_K}, "
+          f"stages={SMALL_STAGES}, warps={SMALL_WARPS}", flush=True)
+    print(f"[small-m-grouped-gemv-splitk] PATH CHOSEN for num_tokens <= {SMALL_MAX_TOKENS}: "
+          f"{'TRITON split-K grouped GEMV (w13 + w2)' if ok else 'FALLBACK to Marlin (parity path)'}", flush=True)
+    print(banner, flush=True)
+    if not ok:
+        return None
+    small["cnt13"].zero_()
+    small["cnt2"].zero_()
+    return small
+
