+def _eae_info(ext, w):
+    """[(ok, regs, lmem, occ)] per instance (K1 E4, K1 E5, K2 E4, K2 E5) from ea4x_info (w 5) / ea6_info (w 6)."""
+    v = [int(t) for t in (ext.ea4x_info() if w == 5 else ext.ea6_info())]
