+          mma16816(acc[1][bsel], a, b2, b3);
+        } else if constexpr (XB == 1) {
+          mma16816(acc[0][bsel], a, bk[j][0], bk[j][1]);
+        } else {
+          uint32_t b0, b1;
+          ldsm_x2(xb + static_cast<uint32_t>((kq * 8 + j) * 32), b0, b1);
