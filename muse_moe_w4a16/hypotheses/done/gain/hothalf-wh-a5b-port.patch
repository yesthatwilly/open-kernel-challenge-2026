+def _wh_start(t0):
+    # prepare()'s first step. TORCH_CUDA_ARCH_LIST = 9.0a for all of prepare(), as es1a / ea6 already set it.
+    job = {"res": {}, "th": None, "off": None, "wait": 0.0}
+    try:
+        import hashlib
+        import threading
+        cpp, src = _wh_src()
+        name = "muse_moe_wg_wh_" + hashlib.sha256((cpp + src).encode()).hexdigest()[:10]
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        th = threading.Thread(target=_wh_build_bg, args=(name, cpp, src, job["res"]), name="hh-wh-nvcc", daemon=False)
+        job["t"] = time.perf_counter() - t0
+        th.start()
+        job["th"] = th
+    except Exception as e:
+        job["off"] = f"start {type(e).__name__}: {str(e)[:120]}"
+    return job
