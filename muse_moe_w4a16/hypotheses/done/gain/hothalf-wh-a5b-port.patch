+        if part.count(old) != 1:
+            raise RuntimeError(f"edit target not unique: {old[:60]!r}")
+        if old == _WH_MAPS[0]:
+            head = head.replace(old, new)
+        else:
+            body = body.replace(old, new)
+    return _WH_CPP, head + _wg_wgmma_src((16, 32, 48, 64, 80, 96, 112, 128)) + body
