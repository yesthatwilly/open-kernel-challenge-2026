+def _wh_replay(state, wb, device, gen, gcpu, h, v, draws):
+    # Graphs (gather + w13 + w2) of arm v on two scratch sets, refilled WH_REFILLS times (judge draws and all-N synthetic
+    # routings alternate), replayed in alternating order: each output bitwise vs master's eager pair; err word clean.
+    x0, al0, _ = _wh_inputs(state, device, gen, gcpu, h, ids=draws[0])
+    x, al = x0.clone(), [t.clone() for t in al0]
+    sb = {"wg_xs": torch.zeros_like(state["wg_xs"]), "wg_hs": torch.zeros_like(state["wg_hs"]),
+          "whk_err": torch.zeros_like(state["whk_err"])}
+    outs = [torch.empty((WH_T * TOP_K, 4096), dtype=torch.bfloat16, device=device) for _ in range(2)]
+    gs = [_rt_graph(lambda o=o, s=s: _wh_run(state, wb, v, x, al, o, s))[0] for o, s in zip(outs, (state, sb))]
+    ref_o = torch.empty_like(outs[0])
+    bad = 0
+    for k in range(WH_REFILLS):
+        x1, al1, _ = (_wh_inputs(state, device, gen, gcpu, h, ids=draws[(k // 2) % len(draws)]) if k % 2 == 0
+                      else _wh_inputs(state, device, gen, gcpu, h, synth=(k // 2) % 4))
+        x.copy_(x1)
+        for t, s in zip(al, al1):
+            t.copy_(s)
+        ref = _wh_run(state, wb, None, x, al, ref_o)
+        for g in (gs if k % 2 == 0 else gs[::-1]):
+            g.replay()
+        torch.cuda.synchronize()
+        bad += sum(0 if torch.equal(o, ref) else 1 for o in outs)
+    e = [int(t) for t in sb["whk_err"].tolist()]
+    del gs
+    return bad + (0 if e == [0, WG_MAGIC] else 100), 2 * WH_REFILLS
+
+
+def _wh_fork(state, bank, device, arms, modes):
+    # kernel_fn graphs at T=256 under the routed H, per hot arm and fork mode ('f' forked, 's' serial), on the ROUTE
+    # draws (same seed), 2 read-flushed rounds each: [{name: median us} per round].
+    hm, whk = state["hm"], state["whk"]
+    keep = hm["fon"][WH_T]
+    gen = torch.Generator().manual_seed(WH_SEED)
+    rounds = []
+    try:
+        for ids in _ea_judge_routings(WH_T, gen, bank["start"], bank["count"], device).values():
+            tw = torch.rand((WH_T, TOP_K), generator=gen)
+            x = torch.randn((WH_T, 4096), generator=gen).to(torch.bfloat16).to(device)
+            data = _hm_data(bank, x, ids, (tw / tw.sum(-1, keepdim=True)).to(device))
+            graphs = {}
+            for n, v in (("m", None),) + arms:
+                for md in modes:
+                    whk[WH_T], hm["fon"][WH_T] = v, md == "f"
+                    graphs[n + md], _ = _rt_graph(lambda: kernel_fn(data, state))
+            whk[WH_T], hm["fon"][WH_T] = None, keep
+            rounds += [{k: _rt_stats(t)[0] for k, t in ts.items() if k != "__baseline_us__"}
+                       for ts in _rt_time(graphs, device)]
+            del graphs
+    finally:
+        whk[WH_T], hm["fon"][WH_T] = None, keep
+    return rounds
+
+
+def _wh_fmt(vals):
+    return "/".join(f"{v:.3f}".lstrip("0") for v in vals)
+
+
+def _wh_phase(state, weights, device, t0, job):
+    # After _hm_setup (prepare() only; never raises): any miss leaves state['whk'][256] None (master's hot half).
+    whk = state["whk"] = {WH_T: None}
+    out, t1, pick, why, cpy = [], time.perf_counter(), None, "", ""
+    arms = WH_ARMS
+    names = {v: n for n, v in arms}
+
+    def late(what):
+        if time.perf_counter() - t0 > WH_DL:
+            raise RuntimeError(f"deadline before {what} ({time.perf_counter() - t0:.0f} s)")
+
+    def mark(what):
+        torch.cuda.synchronize()
+        print(f"{WH_TAG} > {what}", flush=True)
+    try:
+        _wh_join(job)
+        res = job["res"]
+        out.append(f"{WH_TAG} BUILD {res.get('secs', 0):.0f}s bg from {job.get('t', 0):.1f}s, join waited "
+                   f"{job['wait']:.0f}s at {t1 - t0:.0f}s; ptxas -Werror {'clean' if res.get('probe') else 'NOT clean'}"
+                   f", C75xx {res.get('c75') or 'none'}")
+        if job.get("off"):
+            raise RuntimeError(job["off"])
+        ext = res.get("ext")
+        if ext is None:
+            raise RuntimeError(f"build failed: {res.get('err', '')[-160:]}")
+        hm = state.get("hm") or {}
+        h = hm.get("on", {}).get(WH_T, 0)
+        if h not in HM_WG_HOT or "wg_banks" not in state:
+            raise RuntimeError(f"T={WH_T} hybrid wg hot half not routed (H {h})")
+        bank = state["banks"][(0, 32)]
+        wb = state["wg_banks"][(0, 32)]
+        mark("wh_init")
+        rows, attrs, good = [int(v) for v in ext.wh_init()], {}, True
+        for i in range(0, len(rows), 10):
+            f, a_ok, regs, lb, ss, ds, occ, _, bv, _ = rows[i:i + 10]
+            ok = (a_ok and occ >= 1 and ss + ds <= WG_SMEM_LIMIT and bv == 90 and lb == 0
+                  and regs * WG_THREADS >= 40 * 128 + 232 * 256)
+            attrs[(f & 1, f >> 1)] = f"r{regs}/l{lb}" + ("" if ok else "/BAD")
+            good = good and bool(ok)
+        out.append(f"{WH_TAG} ATTRS regs/spill " + "; ".join(
+            ("w13 " if g else "w2 ") + " ".join(f"{n} {attrs.get((g, v), '?')}" for n, v in arms) for g in (1, 0)))
+        if not good:
+            raise RuntimeError("kernel attributes (launchable, occupancy, sm_90a image, register pool, no spill)")
+        late("scale scan")
+        tp = time.perf_counter()
+        sc = [wb[k].view(-1, WG_REC)[:, 4096:] for k in ("q13", "q2")]
+        ntot = sum(s.numel() for s in sc)
+        nbad = sum(int(((s < WH_SCALE[0]) | (s > WH_SCALE[1])).sum()) for s in sc)
+        sc = None
+        if nbad:
+            raise RuntimeError(f"{nbad} of {ntot} scale bytes outside 0x08..0x7E")
+        st_err = _wh_selftest(device)
+        if st_err:
+            raise RuntimeError(f"A5b self-test: {st_err}")
+        a3m, e4m = _wh_maps()
+        state["whk_bank"] = _wh_recode(wb, a3m, False)
+        state["whk_x5"] = _wh_recode(wb, e4m, True)
+        state["whk_ext"], state["whk_err"] = ext, torch.zeros((2,), dtype=torch.int32, device=device)
+        torch.cuda.synchronize()
+        out.append(f"{WH_TAG} SCALES {ntot} in 0x08..0x7E; A3 perm + A5b ENC4/pack copies lossless, self-test PASS "
+                   f"({time.perf_counter() - tp:.1f}s)")
+        gen = torch.Generator(device=device).manual_seed(WH_SEED + 1)
+        gcpu = torch.Generator().manual_seed(WH_SEED + 2)
+        draws = list(_ea_judge_routings(WH_T, torch.Generator().manual_seed(WH_SEED), bank["start"], bank["count"],
+                                        device).values())
+        thr = _hm_hot_rows(h)
+        late("exact")
+        mark("exact T=256")
+        ins = [_wh_inputs(state, device, gen, gcpu, h, ids=d) for d in draws]
+        bad = set()
+        for x, al, _ in ins + [_wh_inputs(state, device, gen, gcpu, h, synth=r) for r in range(4)]:
+            bad |= _wh_exact(state, wb, x, al, arms)
+        torch.cuda.synchronize()
+        e = [int(v) for v in state["whk_err"].tolist()]
+        if e != [0, WG_MAGIC]:
+            raise RuntimeError(f"err word {e}")
+        late("time")
+        mark("time T=256")
+        rnd = [r for x, al, _ in ins for r in _wh_time(state, wb, device, x, al, arms)]
+
+        def ratio(a, b):
+            return [r[a] / max(r[b], 1e-3) for r in rnd]
+        mu = {n: sum(r[n] for r in rnd) / len(rnd) for n in ("m",) + tuple(names.values())}
+        fd = ratio("D0", "m")
+        if "D0" in bad:
+            why = "D0 not exact"
+        elif not all(WH_FID[0] <= v <= WH_FID[1] for v in fd):
+            why = "INVALID: D0/m outside 0.97..1.03"
+        cands = []
+        for n, v in arms[1:]:
+            if why or n in bad or max(ratio(n, "m")) > WH_ROUTE or max(ratio(n, "D0")) > WH_ROUTE:
+                continue
+            if n == "wh5ds" and max(ratio("wh5ds", "wh")) > WH_5VSWH:
+                continue
+            cands.append((mu[n], n, v))
+        nrep = ""
+        for _, n, v in sorted(cands):
+            late(f"replay {n}")
+            mark(f"replay {n}")
+            nb, nr = _wh_replay(state, wb, device, gen, gcpu, h, v, draws)
+            nrep += f"; replay {n} {nr - nb}/{nr}" + (" exact" if not nb else "")
+            if not nb:
+                pick = (n, v)
+                break
+        if not why:
+            why = "no arm passes every round" if not cands else ("" if pick else "replay")
+        out.append(f"{WH_TAG} ROUTE T=256 {('pick ' + pick[0]) if pick else 'OFF (' + why + ')'}: wh/m "
+                   f"{_wh_fmt(ratio('wh', 'm'))} wh/D0 {_wh_fmt(ratio('wh', 'D0'))} a3/D0 {_wh_fmt(ratio('a3', 'D0'))} "
+                   f"wh5ds/wh {_wh_fmt(ratio('wh5ds', 'wh'))} D0/m {min(fd):.3f}..{max(fd):.3f}; pair us " + " ".join(
+                       f"{n} {mu[n]:.1f}" for n in mu) + "; hot:N " + " ".join(_wh_hist(c, thr) for _, _, c in ins)
+                   + f"; exact 7/7{' but ' + ','.join(sorted(bad)) if bad else ''}{nrep}")
+        fon = bool(hm["fon"].get(WH_T))
+        modes = ("f", "s") if fon else ("s",)
+        fa = tuple((n, v) for n, v in arms[1:] if n not in bad)
+        late("fork")
+        mark("fork T=256")
+        fr = _wh_fork(state, bank, device, fa, modes)
+        pm = modes[0]
+
+        def fr_(a, b):
+            return [r[a] / max(r[b], 1e-3) for r in fr]
+        fmu = {k: sum(r[k] for r in fr) / len(fr) for k in fr[0]}
+        fl = f"{WH_TAG} FORK T=256 kfn us {'/'.join(modes)} " + " ".join(
+            f"{n} " + "/".join(f"{fmu[n + md]:.1f}" for md in modes) for n in ("m",) + tuple(n for n, _ in fa))
+        fl += f"; {pm}/m " + " ".join(f"{n} {_wh_fmt(fr_(n + pm, 'm' + pm))}" for n, _ in fa)
+        if fon:
+            fl += "; s/m worst " + " ".join(f"{n} {max(fr_(n + 's', 'ms')):.3f}" for n, _ in fa)
+            fl += f"; m f/s {min(fr_('mf', 'ms')):.3f}..{max(fr_('mf', 'ms')):.3f}"
+        fl += f"; hot pair m {mu['m']:.1f} vs kfn serial {fmu['ms']:.1f} (cold+rest {fmu['ms'] - mu['m']:.1f})"
+        if pick and max(fr_(pick[0] + pm, "m" + pm)) > WH_FORK:
+            why, pick = f"{pick[0]} kfn {pm}/m above {WH_FORK} in a round", None
+        out.append(fl)
+        if pick:
+            whk[WH_T] = pick[1]
+            if time.perf_counter() - t0 > HM_COPY_DEADLINE_S:
+                why, pick = "copy check deadline", None
+            else:
+                mark("copy check")
+                cok, line = _hm_copy_check(weights, bank, state, device)
+                cpy = "copy PASS" if cok else line[len(HM_TAG) + 1:][:120]
+                if not cok:
+                    why, pick = "copy check FAIL", None
+    except Exception as e:
+        pick, why = None, f"{type(e).__name__}: {str(e)[:160]}"
+    try:
+        torch.cuda.synchronize()
+    except Exception as e:
+        pick, why = None, f"final sync raised {type(e).__name__}"
+    whk[WH_T] = pick[1] if pick else None
+    if pick:
+        why = cpy
+    if not pick or not pick[1] & 8:
+        state.pop("whk_x5", None)
+    if not pick or not pick[1] & 1:
+        state.pop("whk_bank", None)
+    out += [ln for ln in HMF_LINES if ln.startswith(f"{HMF_TAG} PATH T=")]
+    out.append(f"{WH_TAG} PATH CHOSEN T=256 " + (f"{pick[0]} wg_kernel<G,{pick[1]}> ({why})" if pick else
+                                                 f"master wg_kernel<G> ({why})")
+               + f", T=128 master ({time.perf_counter() - t1:.1f}s, prepare at {time.perf_counter() - t0:.1f}s)")
+    return out
+
+
