+def _wh_bitperm(w, d):
+    p = torch.zeros_like(w)
+    for s in range(32):
+        p |= ((w >> s) & 1) << d[s]
+    return p
+
+
+def _wh_pack(w):  # A5b scale word: fields f = b - 8, f0 bits 4-10, f1 20-26, f2 28-31 + 0-2, f3 12-18
+    f0, f1, f2, f3 = (((w >> (8 * i)) & 0xFF) - 8 for i in range(4))
+    return (f0 << 4) | (f1 << 20) | (f3 << 12) | ((f2 & 0xF) << 28) | (f2 >> 4)
+
+
+def _wh_unpack(p):
+    f2 = ((p >> 28) & 0xF) | ((p & 7) << 4)
+    return (((p >> 4) & 0x7F) + 8) | ((((p >> 20) & 0x7F) + 8) << 8) | ((f2 + 8) << 16) | ((((p >> 12) & 0x7F) + 8) << 24)
+
+
+def _wh_maps():
+    # (A3's word permutation, A4b's ENC4) as d[s] = destination bit of master bit s; each checked a bijection
+    a3 = [0] * 32
+    for p in range(4):
+        dst = [6 - 3 * p, 7 - 3 * p, 8 - 3 * p, 15 - 3 * p] if p < 3 else [13, 10, 11, 14]
+        for h in range(2):
+            for k in range(4):
+                a3[4 * (3 - p) + 16 * h + k] = dst[k] + 16 * h
+    e4 = [0] * 32
+    for j, t in enumerate(WH_ENC4):
+        e4[t] = j
+    if sorted(a3) != list(range(32)) or sorted(e4) != list(range(32)):
+        raise RuntimeError("code map is not a bit permutation")
+    return a3, e4
+
+
+def _wh_i32(w):
+    return (w - ((w >> 31) & 1) * (1 << 32)).to(torch.int32)
+
+
+def _wh_recode(wb, d, pack):
+    # A COPY of the whole wg bank from the weights' bank only: every code word bit-mapped by d; scale words packed (A5b)
+    # or untouched (A3); each chunk checked lossless by the inverse.
+    inv = [0] * 32
+    for s in range(32):
+        inv[d[s]] = s
+    out = {}
+    for key in ("q13", "q2"):
+        src = wb[key].view(-1, WG_REC)
+        dst = src.clone()
+        for i in range(0, src.shape[0], WH_PERM_CHUNK):
+            c = src[i:i + WH_PERM_CHUNK]
+            w = c[:, :4096].contiguous().view(torch.int32).long() & 0xFFFFFFFF
+            p = _wh_bitperm(w, d)
+            if not torch.equal(_wh_bitperm(p, inv), w):
+                raise RuntimeError(f"{key} chunk {i}: code map not lossless")
+            dst[i:i + WH_PERM_CHUNK, :4096] = _wh_i32(p).view(torch.uint8).view(-1, 4096)
+            if pack:
+                sw = c[:, 4096:].contiguous().view(torch.int32).long() & 0xFFFFFFFF
+                ps = _wh_pack(sw)
+                if not torch.equal(_wh_unpack(ps), sw):
+                    raise RuntimeError(f"{key} chunk {i}: scale packing not lossless")
+                dst[i:i + WH_PERM_CHUNK, 4096:] = _wh_i32(ps).view(torch.uint8).view(-1, 512)
+            w = p = c = None
+        if not pack and not torch.equal(dst[:, 4096:], src[:, 4096:]):
+            raise RuntimeError(f"{key}: scale bytes changed")
+        out[key] = dst.view(-1)
+    return out
+
+
+def _wh_selftest(device):
+    # Host model of the two dequant front ends on 2^16 random words + every scale pair: A5b's views of ENC4(q) equal
+    # A3's ext_prop of perm(q), and A5b's LOP3 scale on the packed word equals A3's prmt * 16 + 0x77807780.
+    a3, e4 = _wh_maps()
+    g = torch.Generator(device=device).manual_seed(WH_SEED + 7)
+    q = torch.randint(0, 1 << 32, (1 << 16,), generator=g, device=device, dtype=torch.int64)
+    m, k = 0xFFFFFFFF, 0x81C081C0
+    p, e = _wh_bitperm(q, a3), _wh_bitperm(q, e4)
+    va = (p & k, (p << 3) & k, (p << 6) & k, ((p >> 3) & 0x01800180) | ((p >> 7) & 0x00400040) | ((p << 1) & 0x80008000))
+    vx = (e & k, (e << 6) & k, (((e << 10) | (e >> 22)) & m) & k, ((e << 4) & 0x81808180) | ((e >> 4) & 0x00400040))
+    if not all(torch.equal(a & m, b & m) for a, b in zip(va, vx)):
+        return "code views differ"
+    b = torch.arange(WH_SCALE[0], WH_SCALE[1] + 1, device=device, dtype=torch.int64)
+    b0, b1 = b.repeat_interleave(b.numel()), b.repeat(b.numel())
+    w = b0 | (b1 << 8) | (b1 << 16) | (b0 << 24)
+    pk = _wh_pack(w)
+    for kk in (0, 1):
+        ws = pk if kk == 0 else (((pk << 8) | (pk >> 24)) & m)
+        x5 = (ws & 0x07F007F0) | 0x78007800
+        t = ((w >> (16 * kk)) & 0xFF) | (((w >> (16 * kk + 8)) & 0xFF) << 16)
+        if not torch.equal(x5, (t * 16 + 0x77807780) & m):
+            return f"scale k{kk} differs"
+    return None
+
+
+def _wh_inputs(state, device, gen, gcpu, h, ids=None, synth=None):
+    # ids: a router draw; synth r: every expert of residue r mod 4 hot with a WH_COUNTS route count (N 16..128), the
+    # other slots remote. Returns (x, hot align, host route counts).
+    if synth is not None:
+        ids = torch.arange(32, 32 + TOP_K).repeat(WH_T, 1)
+        for j, e in enumerate(range(synth, 32, 4)):
+            ids[torch.randperm(WH_T, generator=gcpu)[:WH_COUNTS[(j + 2 * synth) % len(WH_COUNTS)]], j] = e
+        ids = ids.to(torch.int32).to(device)
+    _, al = _hm_align(ids, state["hm"]["ls"], h, 32)
+    loc = ids.long().flatten().cpu()
+    cnt = torch.bincount(loc[(loc >= 0) & (loc < 32)], minlength=32).tolist()
+    return torch.randn((WH_T, 4096), generator=gen, device=device).to(torch.bfloat16), al[3:6], cnt
+
+
+def _wh_hist(cnt, thr):
+    hot = [c for c in cnt if c > thr]
+    hist = {}
+    for c in hot:
+        nb = -(-c // 16)
+        for n in [8] * (nb // 8) + ([nb % 8] if nb % 8 else []):
+            hist[16 * n] = hist.get(16 * n, 0) + 1
+    return f"{len(hot)}:" + ",".join(f"{n}x{v}" for n, v in sorted(hist.items()))
+
