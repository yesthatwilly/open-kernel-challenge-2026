+def _wh_exact(state, wb, x, al, arms):
+    nh = int(al[2][0])
+    out = torch.empty((x.shape[0] * TOP_K, x.shape[1]), dtype=x.dtype, device=x.device)
+    ref = _wh_run(state, wb, None, x, al, out).clone()
+    hs = state["wg_hs"][:nh].clone()
+    return {n for n, v in arms if not (torch.equal(_wh_run(state, wb, v, x, al, out), ref)
+                                       and torch.equal(state["wg_hs"][:nh], hs))}
