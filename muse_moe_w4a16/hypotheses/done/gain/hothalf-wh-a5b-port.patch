+def _wh_pair(state, wb, v, sh, bh, nh, routes, size_n, size_k, out, sc=None):
+    # v None: master's dispatched launches (master's module and bank, this state's scratch). Else the wh module's
+    # wg_kernel<G, v> on the A5b bank (v & 8), the A3 permuted bank (v & 1) or master's; sc = the scratch set.
+    if v is None:
+        _wg_gemm(state, 0, wb["q13"], wb["gs13"], sh, bh, nh, routes, size_n // 64, size_k, state["wg_hs"])
+        _wg_gemm(state, 1, wb["q2"], wb["gs2"], sh, bh, nh, routes, size_k // 128, size_n, out)
+        return
+    sc = state if sc is None else sc
+    b = state["whk_x5"] if v & 8 else (state["whk_bank"] if v & 1 else wb)
+    ext, grid, err = state["whk_ext"], state["wg_grid"], sc["whk_err"]
+    ext.wh_gemm(0, sc["wg_xs"], b["q13"], wb["gs13"], sh, bh, nh, routes, size_n // 64, size_k, sc["wg_hs"], grid,
+                err, 0, v)
+    ext.wh_gemm(1, sc["wg_hs"], b["q2"], wb["gs2"], sh, bh, nh, routes, size_k // 128, size_n, out, grid, err,
+                1 if state.get("wg_pdl", False) else 0, v)
+
+
+def _wh_run(state, wb, v, x, al, out, sc=None):
+    sc = state if sc is None else sc
+    sh, bh, nh = al
+    routes = x.shape[0] * TOP_K
+    out.fill_(HM_JUNK)
+    state["wg_ext"].wg_gather(x, sh, bh, nh, routes, 32, sc["wg_xs"])
+    _wh_pair(state, wb, v, sh, bh, nh, routes, 4096, x.shape[1], out, sc)
+    return out
+
