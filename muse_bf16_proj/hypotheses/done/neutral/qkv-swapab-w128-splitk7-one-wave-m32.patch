+                           if not mainloop_only else float("nan"))
+                    row.append(f"{name}={med:.2f}us(st{st},rel={rel:.1e})")
+                    graph = None
+                    del out, ws, cnt
+                print(f"[qkv-ab] route={route} m={m} BLOCK_T={block_t}: " + " ".join(row)
+                      + " [print-only: cold-L2 graph replay, event timing]", flush=True)
+        del wf
+    except Exception as e:   # diagnostic only: never routes, never raises
+        print(f"[qkv-ab] aborted ({type(e).__name__}: {e})", flush=True)
