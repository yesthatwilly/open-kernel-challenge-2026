+# ---------------------------------------------------------------------------------------------
+# DeepGEMM sm90 BF16 kernel, asserted (hypothesis bf16-verify-deepgemm-sm90-kernel-asserted-
+# rewrite). Log tag "[dg]". The previous run (2d522d47) printed PATH CHOSEN deepgemm for every
+# pair but every m >= 128 kernel in the judge profile was cuBLAS nvjet, so this stage proves what
+# launches, with no profiler (no CUPTI):
+#   STEP A (prepare, untimed): print deep_gemm.bf16_gemm_nt's source or docstring and grep it for
+#     cublas; compare its output bit-for-bit with master's cuBLAS dispatch (identical output = it
+#     IS cuBLAS). The API route is used only if the source shows no cuBLAS AND the outputs differ
+#     AND the numeric self-check passes.
+#   STEP B (the real experiment): build DeepGEMM's own sm90 BF16 kernel from the header tree in
+#     the image (impls/sm90_bf16_gemm.cuh + bundled CUTLASS/CuTe) with load_inline for sm_90a
+#     only, instantiate it per (layer, m-group) with DeepGEMM's own tile/stage/multicast
+#     heuristics ported to Python, M runtime (SHAPE_M = 0) with TMA OOB zero-fill and clipped TMA
+#     stores, N and K compile-time. The launcher is ours, so cudaFuncGetAttributes on the
+#     instantiated kernel (regs, local bytes, smem) plus the prepare-time "[dg] ROUTE ..." probe
+#     through kernel_fn are the proof of what ran.
+# The template/argument list is read from the installed header and every name must be one this
+# port knows; any mismatch prints the signature and keeps master (a VOID run, not a design result).
+# Routed ONLY at the exact m values built and verified (DG2_MS); everything else is master.
+# ---------------------------------------------------------------------------------------------
+DG2_LAYERS = ("pooler", "qkv_gate", "unpooler")   # o stays on cuBLAS (short K)
+DG2_SPEC = {"qkv_gate": (2304, 8192), "pooler": (4096, 8192), "unpooler": (8192, 4096)}
+DG2_MS = (128, 130, 200, 256)
+DG2_GROUPS = ((128,), (130, 200, 256))   # one instantiation per (layer, group); group-2 m % 128 != 0
+DG2_NUM_SMS = 132
+DG2_BLOCK_K = 64
+DG2_SMEM_CAP = 232448
+DG2_REL_L2 = 3e-3
+DG2_PROBE_TOL = 1e-4
+DG2_BUILD_START_MAX_S = 110.0    # do not start the header build later than this into prepare()
+DG2_CHECK_STOP_S = 270.0         # stop self-checking past this much of prepare()'s 300 s
+DG2_LOCAL_BYTES_MAX = 512        # reject a variant whose local (spill / stack) bytes exceed this
+_DG2_CLUSTER_ARCH = "9.0a"
+
+try:
+    import deep_gemm as _dg2_mod
+except Exception as _e:  # missing or broken install: master path
+    _dg2_mod = None
+    print(f"[dg] deep_gemm import failed ({type(_e).__name__}: {_e}); master kept", flush=True)
+
+
+def _dg2_flush(msg: str) -> None:
+    print(f"[dg] {msg}", flush=True)
+
+
+DG2_WATCHDOG_S = 10.0   # a launch of these GEMMs takes microseconds; 10 s means a hung kernel
+
+
+class _Dg2Hang(BaseException):
+    """A [dg] launch did not complete within DG2_WATCHDOG_S (DeepGEMM's mbarrier waits are
+    unbounded). A hung kernel cannot be killed, so the run is lost either way; this only makes the
+    log say so early and stops issuing more [dg] work. BaseException so the per-pair
+    `except Exception` handlers do not swallow it; _dg2_prepare catches it."""
+
+
+def _dg2_sync(label: str) -> None:
+    """prepare()-only: host-side watchdog on the current stream (event polling), then sync."""
+    ev = torch.cuda.Event()
+    ev.record()
+    t = time.perf_counter()
+    while not ev.query():
+        if time.perf_counter() - t > DG2_WATCHDOG_S:
+            _dg2_flush(f"WATCHDOG: {label} not complete after {DG2_WATCHDOG_S:.0f} s: the kernel is "
+                       f"hung (unbounded mbarrier wait). The CUDA context cannot recover; this run is "
+                       f"LOST (timeout expected). Stopping all [dg] work.")
+            raise _Dg2Hang(label)
+        time.sleep(0.002)
+    torch.cuda.synchronize()
+
+
+def _dg2_check(forward, layer: str, w: torch.Tensor, m: int, label: str) -> None:
+    """In-process self-check at this exact (layer, m): announce + sync + announce around each
+    launch (a fault names its launch), finite, rel L2 <= 3e-3 vs fp64, one-hot probe, then CUDA
+    graph capture + replay. Prints the bitwise comparison with master's cuBLAS output (information
+    only). Raises on any failure."""
+    dev = w.device
+    k = w.shape[1]
+    x = torch.randn((m, k), device=dev, dtype=torch.float32).to(torch.bfloat16)
+    _dg2_flush(f"launching {label} layer={layer} m={m} (eager, random x)")
+    out = forward(x)
+    _dg2_sync(f"{label} layer={layer} m={m} eager")
+    _dg2_flush(f"done      {label} layer={layer} m={m} (eager, random x)")
+    ref = x.double() @ w.double().T
+    of = out.double()
+    if not bool(torch.isfinite(of).all()):
+        raise RuntimeError("non-finite output")
+    rel = float((of - ref).norm() / ref.norm().clamp_min(1e-30))
+    if not rel <= DG2_REL_L2:
+        raise RuntimeError(f"rel L2 {rel:.3e} > {DG2_REL_L2}")
+    cub = _bf16_gemm_dispatch_impl(x, w, None)
+    bit_equal = bool(torch.equal(out, cub))
+    # One-hot probe: each row selects one weight column exactly (products by 1.0 are exact).
+    cols = (torch.arange(m, device=dev) * 37 + 5) % k
+    xp = torch.zeros((m, k), device=dev, dtype=torch.bfloat16)
+    xp[torch.arange(m, device=dev), cols] = 1.0
+    refp = w[:, cols].T.float()
+    _dg2_flush(f"launching {label} layer={layer} m={m} (eager, one-hot probe)")
+    outp = forward(xp).float()
+    _dg2_sync(f"{label} layer={layer} m={m} probe")
+    _dg2_flush(f"done      {label} layer={layer} m={m} (eager, one-hot probe)")
+    perr = float((outp - refp).abs().max() / refp.abs().max().clamp_min(1e-30))
+    if not perr <= DG2_PROBE_TOL:
+        raise RuntimeError(f"one-hot probe err {perr:.3e} > {DG2_PROBE_TOL}")
+    side = torch.cuda.Stream()
+    side.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(side):
+        forward(x)
+    torch.cuda.current_stream().wait_stream(side)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    _dg2_flush(f"capturing {label} layer={layer} m={m}")
+    with torch.cuda.graph(g):
+        gout = forward(x)
+    g.replay()
+    _dg2_sync(f"{label} layer={layer} m={m} graph replay")
+    _dg2_flush(f"replayed  {label} layer={layer} m={m}")
+    grel = float((gout.double() - ref).norm() / ref.norm().clamp_min(1e-30))
+    if not grel <= DG2_REL_L2:
+        raise RuntimeError(f"graph replay rel L2 {grel:.3e} > {DG2_REL_L2}")
+    _dg2_flush(f"{label} layer={layer} m={m} OK rel_l2={rel:.2e} probe={perr:.1e} "
+               f"graph_rel_l2={grel:.2e} bitwise_equal_to_cublas={bit_equal}")
+
