+# ---- STEP A: what does deep_gemm.bf16_gemm_nt launch? (no profiler) ---------------------------
+def _dg2_step_a(state: dict) -> dict:
+    """Print bf16_gemm_nt's source / docstring, grep it for cuBLAS, and compare its output bitwise
+    with master's cuBLAS dispatch on synthetic x at m in {128, 256} for every layer. Returns
+    {"fn", "cublas_in_source", "equal": {(layer, m): bool}, "api_genuine"}."""
+    res = {"fn": None, "cublas_in_source": None, "equal": {}, "api_genuine": False}
+    if _dg2_mod is None:
+        return res
+    fn = getattr(_dg2_mod, "bf16_gemm_nt", None)
+    if not callable(fn):
+        _dg2_flush("STEP A: deep_gemm.bf16_gemm_nt absent")
+        return res
+    res["fn"] = fn
+    import inspect
+    text = ""
+    try:
+        text = inspect.getsource(fn)
+        _dg2_flush(f"STEP A: bf16_gemm_nt source ({len(text)} chars):")
+        print(text[:3000], flush=True)
+    except Exception as e:
+        doc = getattr(fn, "__doc__", None) or ""
+        text = doc
+        _dg2_flush(f"STEP A: no python source ({type(e).__name__}: {e}); module={getattr(fn, '__module__', '?')} "
+                   f"doc={doc[:600]!r}")
+    try:
+        mod_file = getattr(_dg2_mod, "__file__", "")
+        _dg2_flush(f"STEP A: deep_gemm {getattr(_dg2_mod, '__version__', '?')} at {mod_file}")
+        cfg_names = [n for n in dir(_dg2_mod) if n.startswith(("get_", "set_")) or "config" in n.lower()]
+        _dg2_flush(f"STEP A: deep_gemm getters/setters: {cfg_names[:40]}")
+        envs = sorted(k for k in os.environ if k.startswith("DG_"))
+        _dg2_flush(f"STEP A: DG_* env set: {envs}")
+    except Exception as e:
+        _dg2_flush(f"STEP A: module info unavailable ({type(e).__name__}: {e})")
+    low = text.lower()
+    hits = [t for t in ("cublas", "cublaslt", "nvjet", "gemmsn") if t in low]
+    res["cublas_in_source"] = bool(hits)
+    _dg2_flush(f"STEP A: cuBLAS words in bf16_gemm_nt source/doc: {hits}")
+    dev = state["pooler"].device
+    for layer in DG2_LAYERS:
+        w = state[layer]
+        for m in (128, 256):
+            try:
+                x = torch.randn((m, w.shape[1]), device=dev, dtype=torch.float32).to(torch.bfloat16)
+                out = torch.empty((m, w.shape[0]), dtype=torch.bfloat16, device=dev)
+                _dg2_flush(f"STEP A launching bf16_gemm_nt layer={layer} m={m}")
+                fn(x, w, out)
+                torch.cuda.synchronize()
+                _dg2_flush(f"STEP A done      bf16_gemm_nt layer={layer} m={m}")
+                cub = _bf16_gemm_dispatch_impl(x, w, None)
+                torch.cuda.synchronize()
+                res["equal"][(layer, m)] = bool(torch.equal(out, cub))
+            except Exception as e:
+                _dg2_flush(f"STEP A layer={layer} m={m} call failed: {type(e).__name__}: {e}")
+                res["equal"][(layer, m)] = None
+    _dg2_flush(f"STEP A: bitwise equal to cuBLAS dispatch per pair: {res['equal']}")
+    all_equal = bool(res["equal"]) and all(v is not False for v in res["equal"].values())
+    res["api_genuine"] = (not res["cublas_in_source"]) and (not all_equal) and \
+        all(v is False for v in res["equal"].values())
+    _dg2_flush(f"STEP A verdict: api_genuine={res['api_genuine']} "
+               f"({'API looks like cuBLAS -> STEP B' if not res['api_genuine'] else 'genuine deep_gemm kernel'})")
+    return res
+
