+    w = state[layer]
+    if (cfg["n"] == w.shape[0] and x.dim() == 2 and x.shape[0] == cfg["m"] and x.shape[1] == w.shape[1]
+            and x.dtype == torch.bfloat16 and x.is_contiguous() and x.data_ptr() % 16 == 0):
+        return ent
+    return None
