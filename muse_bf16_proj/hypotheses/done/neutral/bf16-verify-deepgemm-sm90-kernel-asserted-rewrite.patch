+# ---- STEP B: header build ----------------------------------------------------------------------
+def _dg2_scan_balanced(text: str, i: int, open_c: str, close_c: str):
+    """text[i] == open_c; return (inner text, index after the matching close)."""
+    depth = 0
+    for j in range(i, len(text)):
+        if text[j] == open_c:
+            depth += 1
+        elif text[j] == close_c:
+            depth -= 1
+            if depth == 0:
+                return text[i + 1:j], j + 1
+    raise ValueError("unbalanced")
+
+
+def _dg2_split_top(s: str):
+    out, depth, cur = [], 0, []
+    for ch in s:
+        if ch in "<([":
+            depth += 1
+        elif ch in ">)]":
+            depth -= 1
+        if ch == "," and depth == 0:
+            out.append("".join(cur).strip())
+            cur = []
+        else:
+            cur.append(ch)
+    tail = "".join(cur).strip()
+    if tail:
+        out.append(tail)
+    return out
+
+
+def _dg2_param_name(decl: str) -> str:
+    decl = decl.split("=")[0].strip()
+    return re.split(r"[\s*&]+", decl)[-1]
+
+
+def _dg2_parse_kernel(text: str):
+    """Find the __global__ kernel template in the header. Returns {"name", "tparams": [(decl,
+    name)], "fparams": [(decl, name)], "namespaced"}; raises if not found."""
+    clean = re.sub(r"//[^\n]*", "", text)
+    clean = re.sub(r"/\*.*?\*/", "", clean, flags=re.S)
+    # "__global__ void __launch_bounds__(a, b) name(" would otherwise parse as a kernel named
+    # __launch_bounds__ (DeepGEMM writes it both before and after `void`).
+    while True:
+        lb = re.search(r"__launch_bounds__\s*\(", clean)
+        if lb is None:
+            break
+        _inner, lb_end = _dg2_scan_balanced(clean, lb.end() - 1, "(", ")")
+        clean = clean[:lb.start()] + " " + clean[lb_end:]
+    m = None
+    for m_ in re.finditer(r"template\s*<", clean):
+        j = m_.end() - 1
+        try:
+            tp, after = _dg2_scan_balanced(clean, j, "<", ">")
+        except ValueError:
+            continue
+        tail = clean[after:after + 400]
+        if "__global__" in tail.split("(")[0] or "__global__" in tail[:60]:
+            km = re.search(r"\bvoid\s+(\w+)\s*\(", tail)
+            if km:
+                m = (tp, after, km)
+                break
+    if m is None:
+        raise ValueError("no __global__ template kernel found in header")
+    tp, after, km = m
+    fstart = after + km.end() - 1
+    fp, _ = _dg2_scan_balanced(clean, fstart, "(", ")")
+    tparams = [(d, _dg2_param_name(d)) for d in _dg2_split_top(tp)]
+    fparams = [(d, _dg2_param_name(d)) for d in _dg2_split_top(fp)]
+    return {"name": km.group(1), "tparams": tparams, "fparams": fparams,
+            "namespaced": "namespace deep_gemm" in clean}
+
+
+def _dg2_find_header():
+    """(include_dir, relative header path or None, listing). Looks for impls/*sm90*bf16*gemm*.cuh."""
+    if _dg2_mod is None:
+        return None, None, []
+    root = os.path.dirname(getattr(_dg2_mod, "__file__", "") or "")
+    inc = os.path.join(root, "include")
+    impls = os.path.join(inc, "deep_gemm", "impls")
+    listing = sorted(os.listdir(impls)) if os.path.isdir(impls) else []
+    _dg2_flush(f"header tree: include={inc} exists={os.path.isdir(inc)} impls={listing}")
+    pick = None
+    for name in listing:
+        if name == "sm90_bf16_gemm.cuh":
+            pick = name
+            break
+    if pick is None:
+        for name in listing:
+            if "sm90" in name and "bf16" in name and "gemm" in name and name.endswith(".cuh"):
+                pick = name
+                break
+    if pick is None:
+        return inc, None, listing
+    return inc, f"deep_gemm/impls/{pick}", listing
+
+
+def _dg2_grep_tree(inc: str, pattern: str, limit: int = 3):
+    hits = []
+    base = os.path.join(inc, "deep_gemm")
+    for dp, _dn, fns in os.walk(base):
+        for fn_ in sorted(fns):
+            if not fn_.endswith((".cuh", ".hpp", ".h")):
+                continue
+            try:
+                with open(os.path.join(dp, fn_), "r", errors="ignore") as f:
+                    t = f.read()
+            except Exception:
+                continue
+            for mm in re.finditer(pattern, t):
+                hits.append(mm)
+                if len(hits) >= limit:
+                    return hits
+    return hits
+
+
+def _dg2_pick_cfg(n: int, k: int, ms):
+    """DeepGEMM-style heuristic, ported: choose (BLOCK_M, BLOCK_N, multicast, on_a, stages) for a
+    persistent kernel over `ms` (the largest m sets the tile count) by a bytes-and-flops cost
+    model per wave. Block sizes divide n; multicast 2 needs an even number of blocks along the
+    clustered dimension for EVERY m in the group."""
+    mmax = max(ms)
+    best = None
+    for bm in (64, 128):
+        mb = -(-mmax // bm)
+        for bn in range(32, 257, 16):
+            if n % bn:
+                continue
+            smem_d = ((bm * bn * 2 + 1023) // 1024) * 1024
+            per_stage = (bm + bn) * DG2_BLOCK_K * 2 + 16
+            stages = min(12, (DG2_SMEM_CAP - 4096 - smem_d) // per_stage, k // DG2_BLOCK_K)
+            if stages < 3:
+                continue
+            # Cluster 1 only (audit): the port's per-CTA box split (BLOCK/mc) does not match
+            # DeepGEMM's sm90 multicast (rank 0 issues the full box); a tx-byte mismatch is an
+            # unbounded mbarrier hang. Multicast is a follow-up once the kernel is proven to run.
+            for mc, on_a in ((1, False),):
+                if mc == 2:
+                    if on_a and (n // bn) % 2:
+                        continue
+                    if (not on_a) and any(m % (2 * bm) for m in ms):
+                        continue
+                tiles = mb * (n // bn)
+                waves = -(-tiles // DG2_NUM_SMS)
+                a_bytes = bm * k * 2 / (2 if (mc == 2 and on_a) else 1)
+                b_bytes = bn * k * 2 / (2 if (mc == 2 and not on_a) else 1)
+                t_mem = (a_bytes + b_bytes) / 80e9
+                t_math = 2.0 * bm * bn * k / (800e12 / DG2_NUM_SMS)
+                cost = waves * max(t_mem, t_math)
+                key = (round(cost * 1e6, 2), -bm * bn, mc)
+                if best is None or key < best[0]:
+                    best = (key, dict(bm=bm, bn=bn, mc=mc, on_a=on_a, stages=int(stages),
+                                      tiles=tiles, waves=waves, cost_us=cost * 1e6))
+    if best is None:
+        raise ValueError(f"no legal config for n={n} k={k} ms={ms}")
+    return best[1]
+
+
+def _dg2_swizzle_bytes(block_n: int) -> int:
+    nbytes = block_n * 2
+    for s in (128, 64, 32):
+        if nbytes % s == 0:
+            return s
+    return 0
+
+
+def _dg2_make_variants():
+    variants = []
+    for layer in DG2_LAYERS:
+        n, k = DG2_SPEC[layer]
+        for grp in DG2_GROUPS:
+            c = _dg2_pick_cfg(n, k, grp)
+            c.update(layer=layer, n=n, k=k, ms=grp, id=len(variants))
+            c["swz_d"] = _dg2_swizzle_bytes(c["bn"])
+            c["tdn"] = c["bn"] if c["swz_d"] == 0 else c["swz_d"] // 2
+            c["math_threads"] = 128 if c["bm"] <= 64 else 256
+            c["smem_d"] = ((c["bm"] * c["bn"] * 2 + 1023) // 1024) * 1024
+            c["smem"] = min(DG2_SMEM_CAP, c["smem_d"] + c["stages"] * ((c["bm"] + c["bn"]) * DG2_BLOCK_K * 2 + 16) + 4096)
+            variants.append(c)
+    return variants
+
+
+def _dg2_gen_source(parsed: dict, header_rel: str, variants, gemm_enum: str, epi_type: str):
+    """Generate the .cu source from the parsed kernel signature. Returns (src, decls, functions).
+    Raises ValueError (naming the unknown parameter) if any template / function parameter is not
+    one this port knows how to fill."""
+    kq = ("deep_gemm::" if parsed["namespaced"] else "") + parsed["name"]
+    fn_lines, setup_lines = [], []
+    for v in variants:
+        vals = {
+            "SHAPE_M": "0u", "kShapeM": "0u",
+            "SHAPE_N": f"{v['n']}u", "kShapeN": f"{v['n']}u",
+            "SHAPE_K": f"{v['k']}u", "kShapeK": f"{v['k']}u",
+            "kNumGroups": "1u",
+            "BLOCK_M": f"{v['bm']}u", "BLOCK_N": f"{v['bn']}u", "BLOCK_K": f"{DG2_BLOCK_K}u",
+            "kSwizzleAMode": "128u", "kSwizzleBMode": "128u", "kSwizzleDMode": f"{v['swz_d']}u",
+            "kNumStages": f"{v['stages']}u",
+            "kNumLastStages": f"{(v['k'] // DG2_BLOCK_K) % v['stages']}u",
+            "kNumTMAThreads": "128u", "kNumMathThreads": f"{v['math_threads']}u",
+            "kNumTMAMulticast": f"{v['mc']}u", "kNumMulticast": f"{v['mc']}u",
+            "kIsTMAMulticastOnA": "true" if v["on_a"] else "false",
+            "kIsMulticastOnA": "true" if v["on_a"] else "false",
+            "kNumSMs": f"{DG2_NUM_SMS}u",
+            "kGemmType": gemm_enum, "epilogue_type_t": epi_type,
+            "kWithAccumulation": "false",
+            "kMajorA": "cute::UMMA::Major::K", "kMajorB": "cute::UMMA::Major::K",
+            "cd_dtype_t": "cutlass::bfloat16_t",
+        }
+        targs = []
+        for decl, name in parsed["tparams"]:
+            if name not in vals:
+                raise ValueError(f"unknown template parameter '{name}' ({decl!r})")
+            targs.append(vals[name])
+        args = []
+        for decl, name in parsed["fparams"]:
+            if name in ("grouped_layout", "tensor_map_buffer"):
+                args.append("nullptr")
+            elif name == "shape_m":
+                args.append("m")
+            elif name == "shape_n":
+                args.append(f"{v['n']}u")
+            elif name == "shape_k":
+                args.append(f"{v['k']}u")
+            elif name == "tensor_map_a":
+                args.append("ta")
+            elif name == "tensor_map_b":
+                args.append("tb")
+            elif name in ("tensor_map_cd", "tensor_map_d"):
+                args.append("td")
+            else:
+                raise ValueError(f"unknown kernel argument '{name}' ({decl!r})")
+        i = v["id"]
+        kern = f"&{kq}<{', '.join(targs)}>"
+        fn_lines.append(f"""
+static void dgh_run_v{i}(const CUtensorMap& ta, const CUtensorMap& tb, const CUtensorMap& td,
+                        uint32_t m, cudaStream_t s) {{
+    auto kern = {kern};
+    cudaLaunchConfig_t cfg = {{}};
+    cfg.gridDim = dim3({DG2_NUM_SMS}, 1, 1);
+    cfg.blockDim = dim3({128 + v['math_threads']}, 1, 1);
+    cfg.dynamicSmemBytes = {v['smem']};
+    cfg.stream = s;
+    cudaLaunchAttribute at[1];
+    at[0].id = cudaLaunchAttributeClusterDimension;
