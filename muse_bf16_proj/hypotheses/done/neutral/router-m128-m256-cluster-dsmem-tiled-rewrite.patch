+def _router_tiled_prepare(state: dict) -> None:
+    """Choose, per token-tile count mt in {2, 3, 4} (m = 65..128 / 129..192 / 193..256), the
+    cluster size the router runs at: an instance is a candidate when its build has no spills and
+    <= ~110 KB of dynamic smem, cudaOccupancyMaxActiveClusters >= mt * 4 clusters (one wave) and
+    its self-check passes; the candidate with the lowest cold-L2 eager time at the representative
+    m wins if it beats master's _router_hilo_forward (kernel + memset) by 2%, else 0 (master's
+    path, byte for byte). The result is a constant in state, derived from synthetic data and the
+    weights only; it never raises. Also prints the L2 -> SM bytes per tiling vs the incumbent's
+    and cold-L2 timings (full, no-DSMEM-reduce mode, master) at m = 65 / 128 / 130 / 192 / 200 / 256."""
+    choice = {2: 0, 3: 0, 4: 0}
+    state["router_tiled"] = choice
+    router = state["router"]
+    try:
+        if (_RT_EXT is None or router.shape != (ROUTER_N, ROUTER_K) or router.dtype != torch.float32
+                or not router.is_cuda):
+            raise RuntimeError("extension missing or router weight shape/dtype unexpected")
+        infos = {}
+        for cs in ROUTER_TILED_CS:
+            infos[cs] = _RT_EXT.router_tiled_info(cs)
+            regs, spill, ssmem, dsmem, ncl = infos[cs]
+            print(f"[router_tiled] cs={cs}: regs={regs} local(spill)={spill} B static smem={ssmem} B "
+                  f"dynamic smem={dsmem} B max active clusters={ncl} threads=256 mma.sync/CTA/k64-stage="
+                  f"{8 * 4 * 8}", flush=True)
+        for m in (128, 256):
+            bm, bn, _sk = _router_hilo_config(m)
+            print(f"[router_tiled] L2->SM operand bytes m={m}: incumbent {bm}x{bn} tiles "
+                  f"{_rt_traffic_mb(m, bm, bn):.1f} MB; new 64x64 tiles {_rt_traffic_mb(m, 64, 64):.1f} MB",
+                  flush=True)
+        passed = {}
+        for cs in ROUTER_TILED_CS:
+            regs, spill, ssmem, dsmem, ncl = infos[cs]
+            for mt in (2, 3, 4):
+                need = mt * (ROUTER_N // 64)
+                if spill != 0 or dsmem > ROUTER_TILED_MAX_SMEM:
+                    print(f"[router_tiled] mt={mt}: cs={cs} skipped (spill {spill} B, smem {dsmem} B)", flush=True)
+                    continue
+                if ncl < need:
+                    print(f"[router_tiled] mt={mt}: cs={cs} skipped, max active clusters {ncl} < {need}",
+                          flush=True)
+                    continue
+                ms = [m for m in ROUTER_TILED_CHECK_MS if _rt_mt(m) == mt]
+                why = _rt_check(state, cs, ms)
+                if why:
+                    print(f"[router_tiled] mt={mt}: cs={cs} self-check FAILED: {why}", flush=True)
+                    continue
+                print(f"[router_tiled] mt={mt}: cs={cs} self-check passed (m in {ms})", flush=True)
+                passed[(cs, mt)] = True
+        if passed:
+            hi, lo = state["router_hi"], state["router_lo"]
+            timeit = _rt_timer(router.device)
+            rep = {}
+            for m in ROUTER_TILED_TIME_MS:
+                mt = _rt_mt(m)
+                x = torch.randn((m, ROUTER_K), device=router.device, dtype=torch.float32).to(torch.bfloat16)
+                t_master = timeit(lambda: _router_hilo_forward(x, hi, lo))
+                row = []
+                best = None
+                for cs in ROUTER_TILED_CS:
+                    if not passed.get((cs, mt)):
+                        continue
+                    t_full = timeit(lambda: _router_tiled_forward(x, state, cs, 1))
+                    t_nored = timeit(lambda: _router_tiled_forward(x, state, cs, 0))
+                    row.append(f"cs={cs} full {t_full:.2f} | no-DSMEM-reduce {t_nored:.2f}")
+                    if best is None or t_full < best[1]:
+                        best = (cs, t_full)
+                print(f"[router_tiled] m={m} cold-L2 eager median us: master {t_master:.2f} | "
+                      + "; ".join(row), flush=True)
+                if ROUTER_TILED_REP_M.get(mt) == m and best is not None:
+                    rep[mt] = (best, t_master)
+            for mt, ((cs, t), t_master) in rep.items():
+                if t < ROUTER_TILED_WIN * t_master:
+                    choice[mt] = cs
+                else:
+                    print(f"[router_tiled] mt={mt}: best cs={cs} {t:.2f} us does not beat master "
+                          f"{t_master:.2f} us by 2%; master kept", flush=True)
+    except Exception as e:
+        print(f"[router_tiled] prepare failed ({e!r}); master router path for every m", flush=True)
+        for mt in choice:
+            choice[mt] = 0
+    for m in (64, 65, 128, 129, 130, 192, 193, 200, 256, 257):
+        # Resolved through the timed call's own gate (synthetic x / cfg), so the m = 64 / 257
+        # boundaries printed here are the ones kernel_fn actually applies.
+        try:
+            xs = torch.empty((m, ROUTER_K), dtype=torch.bfloat16, device=router.device)
+            cs = _router_tiled_route(xs, {"m": m, "n": ROUTER_N, "k": ROUTER_K, "layer": "router"}, state)
+        except Exception as e:
+            print(f"[router_tiled] route probe m={m} failed ({e!r})", flush=True)
+            cs = 0
+        print(f"[router_tiled] PATH CHOSEN router m={m}: "
+              + (f"CUDA tiled cluster kernel, cluster size {cs}" if cs else "master Triton router"),
+              flush=True)
+
+
