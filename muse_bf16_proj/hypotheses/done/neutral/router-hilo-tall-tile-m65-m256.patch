+def _router_tall_prepare(state: dict, flags=None) -> None:
+    """Fix state["router_tall"] = {bucket: cfg6} (empty = master's config everywhere). State A
+    runs the selector on synthetic x only; state B inherits A's constant and just warms it. Every
+    failure falls back to master's config. Nothing here depends on a later call's inputs."""
+    state["router_tall"] = {}
+    hi, lo = state["router_hi"], state["router_lo"]
+    if tuple(hi.shape) != (ROUTER_N, ROUTER_K):
+        return
+    try:
+        if flags is not None:
+            for bucket, cfg in flags["router_tall"].items():
+                m = max(ROUTER_TALL_CHECK_MS[bucket])
+                x = torch.randn((m, ROUTER_K), device=hi.device, dtype=torch.float32).to(torch.bfloat16)
+                _router_hilo_forward(x, hi, lo, cfg)
+                state["router_tall"][bucket] = cfg
+            return
+        wref = state["router"].double()
+        tall = {}
+        for bucket, cands in ROUTER_TALL_CANDS.items():
+            m_t = max(ROUTER_TALL_CHECK_MS[bucket])
+            x_t = torch.randn((m_t, ROUTER_K), device=hi.device, dtype=torch.float32).to(torch.bfloat16)
+            master = _router_hilo_cfg6(m_t)
+            ok = []
+            for cfg in cands:
+                try:
+                    if not _router_shape_ok(x_t, hi, cfg):
+                        print(f"[router_tall] {bucket}: {cfg} fails shape preconditions", flush=True)
+                        continue
+                    worst = 0.0
+                    for m in ROUTER_TALL_CHECK_MS[bucket]:
+                        x = torch.randn((m, ROUTER_K), device=hi.device, dtype=torch.float32).to(torch.bfloat16)
+                        o = _router_hilo_forward(x, hi, lo, cfg, report=(m == m_t)).double()
+                        ref = x.double() @ wref.T
+                        if not bool(torch.isfinite(o).all()):
+                            raise RuntimeError(f"non-finite output at m={m}")
+                        err = float((o - ref).norm() / ref.norm().clamp_min(1e-30))
+                        worst = max(worst, err)
+                        if err > AB_ROUTER_REL_L2:
+                            raise RuntimeError(f"rel L2 {err:.2e} > {AB_ROUTER_REL_L2:.0e} at m={m}")
+                    print(f"[router_tall] {bucket}: {cfg} self-check OK (m in "
+                          f"{ROUTER_TALL_CHECK_MS[bucket]}), worst rel L2 {worst:.2e}", flush=True)
+                    ok.append(cfg)
+                except Exception as e:   # OutOfResources, compile failure, wrong answer: reject
+                    print(f"[router_tall] {bucket}: {cfg} REJECTED ({type(e).__name__}: {e})", flush=True)
+            if not ok:
+                print(f"[router_tall] {bucket}: PATH CHOSEN master {master} (no usable candidate)", flush=True)
+                continue
+            try:
