+        # Profile one call of each chosen path: the launched kernel must be the hilo kernel.
+        for bucket in list(tall):
+            try:
+                m_t = max(ROUTER_TALL_CHECK_MS[bucket])
+                x = torch.randn((m_t, ROUTER_K), device=hi.device, dtype=torch.float32).to(torch.bfloat16)
+                from torch.profiler import ProfilerActivity, profile
+                with profile(activities=[ProfilerActivity.CUDA]) as prof:
+                    _router_hilo_forward(x, hi, lo, tall[bucket])
