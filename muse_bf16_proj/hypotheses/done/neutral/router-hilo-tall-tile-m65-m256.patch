+def _router_tall_time(fns: dict, reps: int) -> dict:
+    """prepare()-only. CUDA-graph each callable, replay interleaved with a 256 MB L2 flush before
+    every replay, subtract an empty-ish graph's median; returns {key: median ms}. Frees the flush
+    buffer and every graph before returning."""
+    flush = torch.empty(256 * 1024 * 1024, dtype=torch.uint8, device="cuda")
+    graphs = {}
+    try:
+        tiny = torch.zeros((1,), device="cuda")
+        fns = dict(fns)
+        fns["_base"] = lambda: tiny.zero_()
+        for key, fn in fns.items():
+            for _ in range(2):
+                fn()
+            torch.cuda.synchronize()
+            gr = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(gr):
+                fn()
+            torch.cuda.synchronize()
+            graphs[key] = gr
+        times = {key: [] for key in graphs}
+        for _ in range(reps):
+            evs = {}
+            for key, gr in graphs.items():
+                flush.zero_()
+                e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                e0.record()
+                gr.replay()
+                e1.record()
+                evs[key] = (e0, e1)
+            torch.cuda.synchronize()
+            for key, (e0, e1) in evs.items():
+                times[key].append(e0.elapsed_time(e1))
+        med = {key: sorted(v)[len(v) // 2] for key, v in times.items()}
+        base = med.pop("_base")
+        return {key: max(v - base, 1e-6) for key, v in med.items()}
+    finally:
+        graphs.clear()
+        del flush
+        torch.cuda.synchronize()
+
