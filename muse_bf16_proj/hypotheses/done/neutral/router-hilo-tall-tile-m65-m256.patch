+                if med["master"] / med[best] >= ROUTER_TALL_WIN:
+                    tall[bucket] = ok[best]
+                else:
+                    print(f"[router_tall] {bucket}: PATH CHOSEN master {master} (best {ok[best]} wins "
+                          f"only {med['master'] / med[best]:.3f}x < {ROUTER_TALL_WIN}x)", flush=True)
+            except Exception as e:
