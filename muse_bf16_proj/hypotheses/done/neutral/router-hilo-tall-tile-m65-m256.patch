+                med = _router_tall_time(fns, ROUTER_TALL_REPS)
+                best = min(range(len(ok)), key=lambda i: med[i])
+                print(f"[router_tall] {bucket} m={m_t}: master {med['master'] * 1e3:.2f} us; "
