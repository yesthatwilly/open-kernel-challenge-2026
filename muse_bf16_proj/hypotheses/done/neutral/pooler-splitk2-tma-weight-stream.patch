+def _pooler_w_desc(w: torch.Tensor):
+    """TMA descriptor over the pooler weight [4096, 8192] bf16 (strides [8192, 1]), box
+    [BLOCK_N, TMA_BLOCK_K]. Built once in prepare() from the weight alone; None if no API."""
+    if POOLER_TMA_API == "tensor_descriptor":
+        return _TensorDescriptor.from_tensor(w, [POOLER_BLOCK_N, POOLER_TMA_BLOCK_K])
+    if POOLER_TMA_API == "experimental_descriptor":
+        return _create_2d_tma_descriptor(w.data_ptr(), w.shape[0], w.shape[1],
+                                         POOLER_BLOCK_N, POOLER_TMA_BLOCK_K, w.element_size())
+    return None
+
