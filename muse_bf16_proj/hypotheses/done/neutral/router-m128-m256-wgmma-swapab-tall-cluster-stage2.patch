+def _ouns_prepare(state: dict) -> None:
+    """Query co-residency (cluster 8, else cluster 4, else master), self-check the chosen cluster
+    dim, run the graph-replay gate, and fix state["ouns_cl"] (0 = restack's path) for the run."""
