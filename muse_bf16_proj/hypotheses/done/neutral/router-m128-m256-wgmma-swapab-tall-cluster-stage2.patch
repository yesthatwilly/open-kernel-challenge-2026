+_LT_CPP = r"""
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <cublasLt.h>
+#include <cstring>
+#include <vector>
+
+#define MUSE_LT_CHECK(expr)                                                              \
+  do {                                                                                   \
+    cublasStatus_t muse_s_ = (expr);                                                     \
+    TORCH_CHECK(muse_s_ == CUBLAS_STATUS_SUCCESS, #expr " -> cublasStatus ",             \
+                static_cast<int>(muse_s_));                                              \
+  } while (0)
