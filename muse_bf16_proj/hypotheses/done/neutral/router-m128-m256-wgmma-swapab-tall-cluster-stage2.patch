+RT2_BAND_SPLIT = 128                 # band "a": 65..128 (rep m 128), band "b": 129..256 (rep m 256)
+RT2_INSTANCES = ((64, 16), (128, 16), (128, 8))    # compiled (BT, CS); stages 4 / 3 / 3
