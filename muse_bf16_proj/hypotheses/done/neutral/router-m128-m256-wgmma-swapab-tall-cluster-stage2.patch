+_RT2_CUDA_BODY = r"""
+template <int BT, int CS, int ST>
+__global__ void __launch_bounds__(NTHREADS, 2)
+rt2_wgmma_swapab_kernel(const __grid_constant__ CUtensorMap tm_hi,
+                        const __grid_constant__ CUtensorMap tm_lo,
+                        const __grid_constant__ CUtensorMap tm_x,
+                        float* __restrict__ out, int* __restrict__ err, int m, int mode) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  using C = Cfg<BT, CS, ST>;
+  extern __shared__ uint8_t smem_raw[];
+  const uint32_t raw_u = smem_u32(smem_raw);
+  const uint32_t base_u = (raw_u + 1023u) & ~1023u;
+  uint8_t* base = smem_raw + (base_u - raw_u);
+  const uint32_t full_u = base_u + C::RING;
+  const uint32_t empty_u = full_u + ST * 8;
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  const int rank = blockIdx.x % CS;
+  const int tile = blockIdx.x / CS;
+  const int m0 = (tile / NCG) * BT;
+  const int n0 = (tile % NCG) * BW;
+  const int kbase = rank * C::KC;
+
+  if (tid == 0) {
+#pragma unroll
+    for (int s = 0; s < ST; ++s) {
+      mbar_init(full_u + 8 * s, 1);     // one arrive.expect_tx from the producer + the TMA bytes
+      mbar_init(empty_u + 8 * s, 4);    // one arrive per consumer warp
+    }
+    asm volatile("fence.mbarrier_init.release.cluster;\n" ::: "memory");
+  }
+  __syncthreads();
+
+  float d[BT / 2];
+#pragma unroll
+  for (int i = 0; i < BT / 2; ++i) d[i] = 0.f;
+
+  if (warp < 4) {
+    // ---------------- consumer warpgroup ----------------
+    for (int ki = 0; ki < C::NK; ++ki) {
+      const int s = ki % ST;
+      if (!mbar_wait(full_u + 8 * s, (ki / ST) & 1)) {
+        atomicOr(err, 1);
+        break;
+      }
+      const uint32_t a_hi = base_u + s * C::STAGE;
+      const uint32_t a_lo = a_hi + C::A_BYTES;
+      const uint32_t xb = a_lo + C::A_BYTES;
+#pragma unroll
+      for (int i = 0; i < BT / 2; ++i) asm volatile("" : "+f"(d[i]) :: "memory");
+      wgmma_fence();
+#pragma unroll
+      for (int kk = 0; kk < BK / 16; ++kk) {
+        const uint64_t db = make_desc(xb + kk * 32);
+        if constexpr (BT == 64) {
+          wgmma_n64(d, make_desc(a_hi + kk * 32), db);
+          wgmma_n64(d, make_desc(a_lo + kk * 32), db);
+        } else {
+          wgmma_n128(d, make_desc(a_hi + kk * 32), db);
+          wgmma_n128(d, make_desc(a_lo + kk * 32), db);
+        }
+      }
+      wgmma_commit();
+      wgmma_wait0();
+#pragma unroll
+      for (int i = 0; i < BT / 2; ++i) asm volatile("" : "+f"(d[i]) :: "memory");
+      __syncwarp();
+      if (lane == 0) mbar_arrive(empty_u + 8 * s);
+    }
+    // every consumer warp is past its last wgmma before P overwrites the ring
+    asm volatile("bar.sync 1, 128;\n" ::: "memory");
+    float* P = reinterpret_cast<float*>(base);
+    const int rbase = warp * 16 + (lane >> 2);
+#pragma unroll
+    for (int j = 0; j < BT / 2; ++j) {
+      const int r = rbase + 8 * ((j >> 1) & 1);
+      const int c = (j >> 2) * 8 + (lane & 3) * 2 + (j & 1);
+      P[c * PS + r] = d[j];
+    }
+  } else if (lane == 0) {
+    // ---------------- producer (warp 4, lane 0) ----------------
+    for (int ki = 0; ki < C::NK; ++ki) {
+      const int s = ki % ST;
+      if (ki >= ST) {
+        if (!mbar_wait(empty_u + 8 * s, ((ki / ST) - 1) & 1)) {
+          atomicOr(err, 2);
+          break;
+        }
+      }
+      const uint32_t fb = full_u + 8 * s;
+      const uint32_t a_hi = base_u + s * C::STAGE;
+      const uint32_t a_lo = a_hi + C::A_BYTES;
+      const uint32_t xb = a_lo + C::A_BYTES;
+      const int kc = kbase + ki * BK;
+      mbar_expect_tx(fb, C::STAGE);
+      tma_load_2d(a_hi, &tm_hi, kc, n0, fb);
+      tma_load_2d(a_lo, &tm_lo, kc, n0, fb);
+      tma_load_2d(xb, &tm_x, kc, m0, fb);
+    }
+  }
+  __syncthreads();   // P complete in this CTA; producer done
+
+  if (mode != 0) cluster_sync_rel_acq();   // every CTA's P is visible cluster-wide
+  for (int i = tid; i < C::ITEMS; i += NTHREADS) {
+    const int tl = rank * C::TPR + i / (BW / 4);   // token row of the tile this rank owns
+    const int c4 = i % (BW / 4);
+    float4 s4;
+    if (mode != 0) {
+      const uint32_t loc = base_u + (tl * PS + c4 * 4) * 4;
+      float4 v[CS];
+#pragma unroll
+      for (int q = 0; q < CS; ++q) v[q] = ld_cluster_f4(map_rank(loc, q));
+      s4 = v[0];
+#pragma unroll
+      for (int q = 1; q < CS; ++q) {   // fixed rank order: deterministic
+        s4.x += v[q].x; s4.y += v[q].y; s4.z += v[q].z; s4.w += v[q].w;
+      }
+    } else {
+      s4 = *reinterpret_cast<const float4*>(base + (tl * PS + c4 * 4) * 4);
+    }
+    if (m0 + tl < m) *reinterpret_cast<float4*>(out + static_cast<int64_t>(m0 + tl) * N_OUT + n0 + c4 * 4) = s4;
+  }
+  if (mode != 0) cluster_sync_rel_acq();   // peers are done reading this CTA's smem before it exits
+#else
+  if (threadIdx.x == 0) atomicOr(err, 1 << 30);   // built without sm_90a: the self-check reads this
+#endif
+}
+
+using EncodeFn = CUresult (*)(CUtensorMap*, CUtensorMapDataType, cuuint32_t, void*, const cuuint64_t*,
+                              const cuuint64_t*, const cuuint32_t*, const cuuint32_t*, CUtensorMapInterleave,
+                              CUtensorMapSwizzle, CUtensorMapL2promotion, CUtensorMapFloatOOBfill);
+
+EncodeFn get_encode() {
+  static EncodeFn fn = nullptr;   // a host function pointer, not device state
+  if (fn == nullptr) {
+    void* h = dlsym(RTLD_DEFAULT, "cuTensorMapEncodeTiled");
+    if (h == nullptr) {
+      void* lib = dlopen("libcuda.so.1", RTLD_NOW);
+      if (lib != nullptr) h = dlsym(lib, "cuTensorMapEncodeTiled");
+    }
+    fn = reinterpret_cast<EncodeFn>(h);
+  }
+  TORCH_CHECK(fn != nullptr, "rt2: cuTensorMapEncodeTiled not found");
+  return fn;
+}
+
+// bf16 [rows, 8192] row-major (row stride in elements), box [64 K, box_rows], 128B swizzle, OOB = 0.
+void make_map(CUtensorMap* tm, const void* ptr, int64_t rows, int64_t row_stride_elems, int box_rows) {
+  cuuint64_t dims[2] = {static_cast<cuuint64_t>(K_TOT), static_cast<cuuint64_t>(rows)};
+  cuuint64_t strides[1] = {static_cast<cuuint64_t>(row_stride_elems) * 2};
+  cuuint32_t box[2] = {static_cast<cuuint32_t>(BK), static_cast<cuuint32_t>(box_rows)};
+  cuuint32_t estr[2] = {1, 1};
+  CUresult rc = get_encode()(tm, CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, const_cast<void*>(ptr), dims, strides, box, estr,
+                             CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                             CU_TENSOR_MAP_L2_PROMOTION_L2_256B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+  TORCH_CHECK(rc == CUDA_SUCCESS, "rt2: cuTensorMapEncodeTiled failed, code ", static_cast<int>(rc));
+}
+
+template <int BT, int CS, int ST>
+void set_attr() {
+  static bool done = false;
+  if (!done) {
+    C10_CUDA_CHECK(cudaFuncSetAttribute(rt2_wgmma_swapab_kernel<BT, CS, ST>,
+                                        cudaFuncAttributeMaxDynamicSharedMemorySize, Cfg<BT, CS, ST>::SMEM));
+    C10_CUDA_CHECK(cudaFuncSetAttribute(rt2_wgmma_swapab_kernel<BT, CS, ST>,
+                                        cudaFuncAttributePreferredSharedMemoryCarveout, 100));
+    if (CS > 8) {
+      C10_CUDA_CHECK(cudaFuncSetAttribute(rt2_wgmma_swapab_kernel<BT, CS, ST>,
+                                          cudaFuncAttributeNonPortableClusterSizeAllowed, 1));
+    }
+    done = true;
+  }
+}
+
+template <int BT, int CS, int ST>
+void launch(torch::Tensor x, torch::Tensor hi, torch::Tensor lo, torch::Tensor out, torch::Tensor err, int mode) {
+  set_attr<BT, CS, ST>();
+  const int m = static_cast<int>(x.size(0));
+  CUtensorMap tm_hi, tm_lo, tm_x;
+  make_map(&tm_hi, hi.data_ptr(), N_OUT, K_TOT, BW);
+  make_map(&tm_lo, lo.data_ptr(), N_OUT, K_TOT, BW);
+  make_map(&tm_x, x.data_ptr(), m, x.stride(0), BT);   // this call's x pointer, never cached
+  cudaLaunchConfig_t cfg = {};
+  cfg.gridDim = dim3(((m + BT - 1) / BT) * NCG * CS);
+  cfg.blockDim = dim3(NTHREADS);
+  cfg.dynamicSmemBytes = Cfg<BT, CS, ST>::SMEM;
+  cfg.stream = at::cuda::getCurrentCUDAStream();
+  cudaLaunchAttribute attr[1];
+  attr[0].id = cudaLaunchAttributeClusterDimension;
+  attr[0].val.clusterDim.x = CS;
+  attr[0].val.clusterDim.y = 1;
+  attr[0].val.clusterDim.z = 1;
+  cfg.attrs = attr;
+  cfg.numAttrs = 1;
+  C10_CUDA_CHECK(cudaLaunchKernelEx(&cfg, rt2_wgmma_swapab_kernel<BT, CS, ST>, tm_hi, tm_lo, tm_x,
+                                    out.data_ptr<float>(), err.data_ptr<int>(), m, mode));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+template <int BT, int CS, int ST>
+std::vector<int64_t> info() {
+  set_attr<BT, CS, ST>();
+  cudaFuncAttributes fa;
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&fa, rt2_wgmma_swapab_kernel<BT, CS, ST>));
+  cudaLaunchConfig_t cfg = {};
+  cfg.gridDim = dim3(CS * NCG);
+  cfg.blockDim = dim3(NTHREADS);
+  cfg.dynamicSmemBytes = Cfg<BT, CS, ST>::SMEM;
+  cudaLaunchAttribute attr[1];
+  attr[0].id = cudaLaunchAttributeClusterDimension;
+  attr[0].val.clusterDim.x = CS;
+  attr[0].val.clusterDim.y = 1;
+  attr[0].val.clusterDim.z = 1;
+  cfg.attrs = attr;
+  cfg.numAttrs = 1;
+  int nclusters = -1;
+  if (cudaOccupancyMaxActiveClusters(&nclusters, rt2_wgmma_swapab_kernel<BT, CS, ST>, &cfg) != cudaSuccess) {
+    (void)cudaGetLastError();
+    nclusters = -1;
+  }
+  int nblocks = -1;
+  if (cudaOccupancyMaxActiveBlocksPerMultiprocessor(&nblocks, rt2_wgmma_swapab_kernel<BT, CS, ST>, NTHREADS,
+                                                    Cfg<BT, CS, ST>::SMEM) != cudaSuccess) {
+    (void)cudaGetLastError();
+    nblocks = -1;
+  }
+  return {fa.numRegs, static_cast<int64_t>(fa.localSizeBytes), static_cast<int64_t>(fa.sharedSizeBytes),
+          static_cast<int64_t>(Cfg<BT, CS, ST>::SMEM), nclusters, nblocks};
+}
