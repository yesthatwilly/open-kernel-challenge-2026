+
+void rt2_run(torch::Tensor x, torch::Tensor hi, torch::Tensor lo, torch::Tensor out, torch::Tensor err,
+             int64_t bt, int64_t cs, int64_t mode) {
+  const int64_t m = x.size(0);
+  TORCH_CHECK(x.dim() == 2 && m >= 1 && m <= 256 && x.size(1) == K_TOT, "rt2: x shape");
+  TORCH_CHECK(x.scalar_type() == at::kBFloat16 && hi.scalar_type() == at::kBFloat16 &&
+              lo.scalar_type() == at::kBFloat16 && out.scalar_type() == at::kFloat &&
+              err.scalar_type() == at::kInt, "rt2: dtypes");
+  TORCH_CHECK(hi.is_contiguous() && lo.is_contiguous() && hi.size(0) == N_OUT && hi.size(1) == K_TOT &&
+              lo.size(0) == N_OUT && lo.size(1) == K_TOT, "rt2: weights");
+  TORCH_CHECK(x.stride(1) == 1 && x.stride(0) % 8 == 0 &&
+              reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0 &&
+              reinterpret_cast<uintptr_t>(hi.data_ptr()) % 16 == 0 &&
+              reinterpret_cast<uintptr_t>(lo.data_ptr()) % 16 == 0, "rt2: x strides / alignment");
+  TORCH_CHECK(out.is_contiguous() && out.size(0) == m && out.size(1) == N_OUT && err.numel() >= 1, "rt2: out / err");
+  if (bt == 64 && cs == 16) launch<64, 16, 4>(x, hi, lo, out, err, static_cast<int>(mode));
+  else if (bt == 128 && cs == 16) launch<128, 16, 3>(x, hi, lo, out, err, static_cast<int>(mode));
+  else if (bt == 128 && cs == 8) launch<128, 8, 3>(x, hi, lo, out, err, static_cast<int>(mode));
+  else TORCH_CHECK(false, "rt2: unsupported (BT, CS)");
+}
+
+// {regs, local (spill) bytes, static smem, dynamic smem, max active clusters, CTAs/SM (-1: query failed)}
+std::vector<int64_t> rt2_info(int64_t bt, int64_t cs) {
+  if (bt == 64 && cs == 16) return info<64, 16, 4>();
+  if (bt == 128 && cs == 16) return info<128, 16, 3>();
+  if (bt == 128 && cs == 8) return info<128, 8, 3>();
+  TORCH_CHECK(false, "rt2_info: unsupported (BT, CS)");
+  return {};
+}
+"""
+
+
+def _rt2_wgmma_src(n: int) -> str:
+    """wgmma.mma_async m64n{n}k16 bf16 x bf16 -> fp32, both operands K-major from smem descriptors,
+    accumulating in place (scale-d = 1: the caller zeroes the accumulator)."""
+    regs = n // 2
+    outs = ", ".join("%%%d" % i for i in range(regs))
+    cons = ", ".join('"+f"(d[%d])' % i for i in range(regs))
+    return (
+        "#if defined(__CUDA_ARCH_FEAT_SM90_ALL)\n"
+        "__device__ __forceinline__ void wgmma_n%d(float (&d)[%d], uint64_t da, uint64_t db) {\n"
+        "  const int sd = 1;\n"
+        "  asm volatile(\n"
+        '      "{\\n.reg .pred p;\\nsetp.ne.b32 p, %%%d, 0;\\n"\n'
+        '      "wgmma.mma_async.sync.aligned.m64n%dk16.f32.bf16.bf16 "\n'
+        '      "{%s}, %%%d, %%%d, p, 1, 1, 0, 0;\\n}\\n"\n'
+        '      : %s : "l"(da), "l"(db), "r"(sd));\n'
+        "}\n"
+        "#endif\n"
+    ) % (n, regs, regs + 2, n, outs, regs, regs + 1, cons)
+
+
+_RT2_CUDA = _RT2_CUDA_HEAD + _rt2_wgmma_src(64) + _rt2_wgmma_src(128) + _RT2_CUDA_BODY
+
+
+def _build_rt2():
+    """Compile the CUDA module once per process, at import (never during graph capture), for sm_90a
+    only (TORCH_CUDA_ARCH_LIST=9.0a around the build, restored after; the default list adds a plain
+    sm_90 pass that cannot assemble wgmma). Prints the arch flags, nvcc flags and the build seconds.
+    Any failure keeps master's router path; never raises."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+    try:
+        from torch.utils import cpp_extension
+        try:
+            print(f"[rt2] arch flags passed to nvcc: {cpp_extension._get_cuda_arch_flags()}", flush=True)
+        except Exception as e:  # diagnostic only
+            print(f"[rt2] arch flags unavailable ({type(e).__name__}: {e})", flush=True)
+        print(f"[rt2] building {RT2_EXT_NAME}: TORCH_CUDA_ARCH_LIST=9.0a extra_cuda_cflags {RT2_NVCC_FLAGS}",
+              flush=True)
+        ext = cpp_extension.load_inline(
+            name=RT2_EXT_NAME, cpp_sources=_RT2_CPP, cuda_sources=_RT2_CUDA,
+            functions=["rt2_run", "rt2_info"], extra_cuda_cflags=list(RT2_NVCC_FLAGS),
+            extra_ldflags=["-ldl"], verbose=False)
+    except Exception as e:
+        tail = "\n".join(str(e).splitlines()[-60:])
+        print(f"[rt2] build FAILED after {time.perf_counter() - t0:.1f}s ({type(e).__name__}); build log "
+              f"tail:\n{tail}\n[rt2] master router path kept", flush=True)
+        return None
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    print(f"[build-time] rt2 load_inline compiled in {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext
+
+
+_RT2_EXT = _build_rt2() if torch.cuda.is_available() else None
+
+
+def _rt2_route(x: torch.Tensor, cfg, state: dict):
+    """(BT, CS) the CUDA wgmma router runs at for this call, or None for master's hilo path. Branches on
+    cfg, shapes, strides, alignment and the prepare() constants in state only; with the band's flag
+    off this is master's exact path."""
+    if _RT2_EXT is None or x.dim() != 2:
+        return None
+    m = x.shape[0]
+    if not RT2_MIN_M <= m <= RT2_MAX_M:
+        return None
+    key = "a" if m <= RT2_BAND_SPLIT else "b"
+    rc = state.get("rt2_cfg_" + key)
+    if rc is None or not state.get("rt2_" + key + "_ok"):
+        return None
+    if (cfg["m"] == m and cfg["n"] == ROUTER_N and cfg["k"] == ROUTER_K and x.shape[1] == ROUTER_K
+            and x.dtype == torch.bfloat16 and x.is_cuda and x.stride(1) == 1 and x.stride(0) % 8 == 0
+            and x.data_ptr() % 16 == 0):
+        return rc
+    return None
+
+
+def _rt2_forward(x: torch.Tensor, state: dict, rc, mode: int = 1) -> torch.Tensor:
+    """x bf16 [65 <= m <= 256, 8192] @ (hi + lo).T -> fp32 [m, 256]: ONE cluster launch, torch.empty
+    output (no memset node). The error word is per state and only written on a bounded-wait timeout."""
+    out = torch.empty((x.shape[0], ROUTER_N), dtype=torch.float32, device=x.device)
+    _RT2_EXT.rt2_run(x, state["router_hi"], state["router_lo"], out, state["rt2_err"], rc[0], rc[1], mode)
+    return out
+
+
+def _rt2_traffic_mb(m: int, bt: int) -> float:
+    """L2 -> SM operand bytes (MB): x re-read once per column group (4), hi + lo (8.4 MB) once per
+    token tile. Independent of the K split."""
+    tiles = (m + bt - 1) // bt
+    return (m * ROUTER_K * 2 * (ROUTER_N // 64) + 2 * ROUTER_N * ROUTER_K * 2 * tiles) / 1e6
+
+
+def _rt2_check(state: dict, rc, ms) -> str:
+    """In-process self-check of (BT, CS) = rc at the token counts ms. Every launch is announced with a
+    flushed print before it and a synchronize, an error-word read and a flushed print after it, so a
+    fault names its kernel. x has random rows, outlier rows (x64) and entries (x1024), and about one
+    row in eight is a single power-of-two entry (an exact weight column). Bounds: rel L2 vs fp64
+    router <= RT2_REL_L2 (judge 1e-4), vs fp64 hi + lo reconstruction <= RT2_REL_L2_HL, worst row <=
+    RT2_ROW_REL, one-hot rows <= RT2_ONEHOT_REL of the original column, finite, run 2 bit-identical,
+    error word 0. Returns "" on pass, else why."""
+    router, hi, lo = state["router"], state["router_hi"], state["router_lo"]
+    dev = router.device
+    k = router.shape[1]
+    rd = router.double()
+    hld = hi.double() + lo.double()
+    g = torch.Generator(device=dev)
+    g.manual_seed(1357)
+    for m in ms:
+        x = torch.randn((m, k), device=dev, dtype=torch.float32, generator=g)
+        for r in range(m):
+            if r % 9 == 3:
+                x[r] *= 64.0
+            if r % 11 == 5:
+                x[r, (r * 131) % k] = 1024.0
+        x = x.to(torch.bfloat16)
+        oh_rows = sorted({r for r in range(m) if r % 8 == 6} | {m - 1})
+        oh_cols, oh_vals = [], []
+        for r in oh_rows:
+            c = (37 * r + 5 * m + 11) % k
+            v = 2.0 ** ((r % 7) - 3)
+            x[r].zero_()
+            x[r, c] = v
+            oh_cols.append(c)
+            oh_vals.append(v)
+        ref = x.double() @ rd.T
+        ref_hl = x.double() @ hld.T
+        outs = []
+        for run in (1, 2):
+            print(f"[rt2] launching rt2_wgmma_swapab_kernel BT={rc[0]} CS={rc[1]} m={m} run {run}", flush=True)
+            o = _rt2_forward(x, state, rc)
+            torch.cuda.synchronize()
+            code = int(state["rt2_err"].item())
+            state["rt2_err"].zero_()
+            print(f"[rt2] BT={rc[0]} CS={rc[1]} m={m} run {run} finished OK (synced, error word {code})", flush=True)
+            if code:
+                return f"m={m}: error word {code}"
+            outs.append(o)
+        if not torch.equal(outs[0], outs[1]):
+            return f"m={m}: second launch differs from the first"
+        o = outs[0].double()
+        if not bool(torch.isfinite(o).all()):
+            return f"m={m}: non-finite output"
+        err = float((o - ref).norm() / ref.norm().clamp_min(1e-30))
+        err_hl = float((o - ref_hl).norm() / ref_hl.norm().clamp_min(1e-30))
+        row_ref = ref.norm(dim=1)
+        row_den = torch.maximum(row_ref, 0.1 * row_ref.mean()).clamp_min(1e-30)
+        row_err = float(((o - ref).norm(dim=1) / row_den).max())
+        idx = torch.tensor(oh_rows, device=dev)
+        exact = (torch.tensor(oh_vals, device=dev, dtype=torch.float64)[:, None]
+                 * rd[:, torch.tensor(oh_cols, device=dev)].T)
+        oh = float(((o[idx] - exact).norm(dim=1) / exact.norm(dim=1).clamp_min(1e-30)).max())
+        print(f"[rt2] check BT={rc[0]} CS={rc[1]} m={m}: rel L2 {err:.2e} (<= {RT2_REL_L2:g}), vs hi+lo {err_hl:.2e} "
+              f"(<= {RT2_REL_L2_HL:g}), worst row {row_err:.2e} (<= {RT2_ROW_REL:g}), one-hot rows "
+              f"{len(oh_rows)} worst {oh:.2e} (<= {RT2_ONEHOT_REL:g})", flush=True)
+        if not (err <= RT2_REL_L2 and err_hl <= RT2_REL_L2_HL and row_err <= RT2_ROW_REL and oh <= RT2_ONEHOT_REL):
+            return (f"m={m}: rel L2 {err:.2e}, vs hi+lo {err_hl:.2e}, worst row {row_err:.2e}, "
+                    f"one-hot {oh:.2e} out of bounds")
+    return ""
+
+
+def _rt2_quantile(v, q: float) -> float:
+    s = sorted(v)
+    return s[min(len(s) - 1, max(0, int(round(q * (len(s) - 1)))))]
+
+
+def _rt2_gate(state: dict, key: str, m: int, cands):
+    """Model selector for the router band `key` at its representative m. Captures as CUDA graphs, on
+    shallow copies of state and the same synthetic x: master's ACTUALLY ROUTED path (kernel_fn with
+    the band's flag off, i.e. _router_hilo_forward + torch.zeros), kernel_fn with the flag on and each
+    candidate (BT, CS), and each candidate's mode-0 no-DSMEM-reduce diagnostic. RT2_GATE_ROUNDS rounds
+    of RT2_GATE_REPS reps, every graph once per rep in rotating order, a CELL_FLUSH_BYTES write before
+    each replay, medians minus an empty-graph baseline. Prints both rounds' medians / IQRs per
+    candidate, and returns (best candidate or None, {candidate: (ratios, iqr_ok, win)}) where a candidate
+    passes only if BOTH rounds reach RT2_MIN_WIN over master and its IQR <= RT2_MAX_IQR_RATIO x
+    master's in both rounds. prepare()-only."""
+    dev = state["router"].device
+    flag, cfgk = "rt2_" + key + "_ok", "rt2_cfg_" + key
+    x = torch.randn((m, ROUTER_K), device=dev, dtype=torch.float32).to(torch.bfloat16)
+    data = {"x": x, "config": {"m": m, "n": ROUTER_N, "k": ROUTER_K, "layer": "router"}}
+    st_m = dict(state)
+    st_m[flag] = False
+    sts = {}
+    for c in cands:
+        st = dict(state)
+        st[flag] = True
+        st[cfgk] = c
+        sts[c] = st
+    flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def replay_us(gr) -> float:
+        flush.zero_()
+        ev[0].record()
+        gr.replay()
+        ev[1].record()
+        ev[1].synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1e3
+
+    g_base = _cell_capture(lambda: scratch.add_(1.0))
+    base = _ouns_median([replay_us(g_base) for _ in range(RT2_GATE_REPS)])
+    graphs = {"master": _cell_capture(lambda: kernel_fn(data, st_m))}
+    for c in cands:
+        graphs[c] = _cell_capture(lambda c=c: kernel_fn(data, sts[c]))
+        graphs[("nored",) + c] = _cell_capture(lambda c=c: _rt2_forward(x, state, c, 0))
+    names = list(graphs)
+    rounds = []
+    for rnd in range(RT2_GATE_ROUNDS):
+        samples = {n: [] for n in names}
+        for rep in range(RT2_GATE_REPS):
+            rot = rep % len(names)
+            for n in names[rot:] + names[:rot]:
+                samples[n].append(replay_us(graphs[n]))
+        rounds.append(samples)
+    code = int(state["rt2_err"].item())
+    state["rt2_err"].zero_()
+
+    def net(v):
+        return max(_ouns_median(v) - base, 0.25)
+
+    lines = []
+    data_out = {}
+    best, best_score = None, 0.0
+    for c in cands:
+        ratios, iqr_ok, parts = [], [], []
+        for rnd, samples in enumerate(rounds):
+            mm, cm = net(samples["master"]), net(samples[c])
+            im = _rt2_quantile(samples["master"], 0.75) - _rt2_quantile(samples["master"], 0.25)
+            ic = _rt2_quantile(samples[c], 0.75) - _rt2_quantile(samples[c], 0.25)
+            nr = net(samples[("nored",) + c])
+            ratio = mm / cm
+            ok = ic <= RT2_MAX_IQR_RATIO * max(im, RT2_IQR_FLOOR_US)   # absolute floor: a timer-resolution IQR must not veto a win
+            ratios.append(ratio)
+            iqr_ok.append(ok)
+            parts.append(f"round {rnd + 1}: master {mm:.2f} (IQR {im:.2f}) cand {cm:.2f} (IQR {ic:.2f}) "
+                         f"no-reduce {nr:.2f} -> master/cand {ratio:.3f} iqr_ok={ok}")
+        win = all(r >= RT2_MIN_WIN for r in ratios) and all(iqr_ok) and code == 0
+        score = min(ratios)
+        line = (f"[rt2] gate band {key} m={m} BT={c[0]} CS={c[1]} (graph replay, {CELL_FLUSH_BYTES >> 20} MB flush, "
+                f"{RT2_GATE_REPS} reps x {RT2_GATE_ROUNDS} interleaved rounds, baseline {base:.2f} us, net us; need "
+                f">= {RT2_MIN_WIN} both rounds and IQR <= {RT2_MAX_IQR_RATIO}x): " + " | ".join(parts)
+                + f" | pass={win} error word {code}")
+        print(line, flush=True)
+        lines.append(line)
+        data_out[c] = (ratios, iqr_ok, win)
+        if win and score > best_score:
+            best, best_score = c, score
+    del graphs, g_base, flush, rounds
+    torch.cuda.synchronize()
+    return best, data_out
+
+
+def _rt2_prepare(state: dict, t_all: float, flags=None) -> None:
+    """Decide, per band ("a": m 65..128, "b": 129..256), whether the CUDA wgmma router replaces
+    master's hilo kernel + memset, and at which (BT, CS). Sets state["rt2_a_ok"/"rt2_b_ok"] (False
+    unless every step passes), state["rt2_cfg_a"/"rt2_cfg_b"], a per-state error word and the
+    summary lines prepare() repeats last. flags a dict (the A/B check's second state): inherit the
+    flags and configs, own error word. Steps (flags None): module present, per-candidate attribute /
+    occupancy / spill query, self-check at RT2_CHECK_MS, the two-round graph-replay gate against
+    master's routed path, one torch.profiler call asserting the launched kernel names. Own start
+    deadline; never raises."""
+    t0 = time.perf_counter()
+    state["rt2_a_ok"], state["rt2_b_ok"] = False, False
+    state["rt2_cfg_a"], state["rt2_cfg_b"] = None, None
+    state["rt2_summary"] = []
+    router = state["router"]
+    dev = router.device
+    state["rt2_err"] = torch.zeros(1, dtype=torch.int32, device=dev)
+    if flags is not None:
+        for key in ("a", "b"):
+            rc = flags.get("rt2_cfg_" + key)
+            state["rt2_cfg_" + key] = rc
+            state["rt2_" + key + "_ok"] = bool(flags.get("rt2_" + key + "_ok")) and rc is not None
+        return
+    summary = state["rt2_summary"]
+    why_all = ""
+    infos, passed = {}, {}
+    try:
+        if (_RT2_EXT is None or tuple(router.shape) != (ROUTER_N, ROUTER_K) or router.dtype != torch.float32
+                or not router.is_cuda):
+            why_all = "extension missing or router weight shape/dtype unexpected"
+        elif time.perf_counter() - t_all > RT2_START_DEADLINE_S:
+            why_all = f"skipped: deadline (state build already {time.perf_counter() - t_all:.0f}s > {RT2_START_DEADLINE_S:.0f}s)"
+            print(f"[rt2] {why_all}", flush=True)
+    except Exception as e:
+        why_all = f"raised {type(e).__name__}: {e}"
+    if not why_all:
+        try:
+            for m_rep, bts in ((128, (64, 128)), (256, (128,))):
+                for bt in bts:
+                    print(f"[rt2] L2->SM operand bytes m={m_rep}: incumbent {_router_hilo_config(m_rep)[:2]} tiles "
+                          f"{_rt_hilo_traffic_mb(m_rep):.1f} MB; new BT={bt} tiles {_rt2_traffic_mb(m_rep, bt):.1f} MB",
+                          flush=True)
+            for cfg in RT2_INSTANCES:
+                regs, spill, ssmem, dsmem, ncl, nb = [int(v) for v in _RT2_EXT.rt2_info(*cfg)]
+                infos[cfg] = (regs, spill, ssmem, dsmem, ncl, nb)
+                print(f"[rt2] BT={cfg[0]} CS={cfg[1]}: regs={regs} local(spill)={spill} B static smem={ssmem} B "
+                      f"dynamic smem={dsmem} B max active clusters={ncl} CTAs/SM={nb} threads=160", flush=True)
+            for cfg in RT2_INSTANCES:
+                regs, spill, ssmem, dsmem, ncl, nb = infos[cfg]
+                need = max(((RT2_BAND_REP_M[k] + cfg[0] - 1) // cfg[0]) * 4 for k in RT2_BAND_REP_M
+                           if cfg in RT2_BAND_CANDS[k])
+                if time.perf_counter() - t0 > RT2_PHASE_BUDGET_S:
+                    print(f"[rt2] BT={cfg[0]} CS={cfg[1]} skipped: deadline (phase {time.perf_counter() - t0:.0f}s)",
+                          flush=True)
+                    continue
+                if spill != 0 or nb < 2 or ncl < need:
+                    print(f"[rt2] BT={cfg[0]} CS={cfg[1]} skipped: spill {spill} B, CTAs/SM {nb} (needs 2), max "
+                          f"active clusters {ncl} (needs {need})", flush=True)
+                    continue
+                why = _rt2_check(state, cfg, RT2_CHECK_MS)
+                if why:
+                    print(f"[rt2] BT={cfg[0]} CS={cfg[1]} self-check FAILED: {why}", flush=True)
+                    continue
+                print(f"[rt2] BT={cfg[0]} CS={cfg[1]} self-check passed (m in {RT2_CHECK_MS})", flush=True)
+                passed[cfg] = True
+        except Exception as e:
+            why_all = f"raised {type(e).__name__}: {str(e)[-300:]}"
+            print(f"[rt2] prepare failed ({why_all}); master router path for every m", flush=True)
+            passed = {}
+            state["rt2_err"].zero_()
+    for key in ("a", "b"):
+        m = RT2_BAND_REP_M[key]
+        result = "master"
+        detail = why_all or "no candidate passed its self-check / occupancy"
+        try:
+            cands = tuple(c for c in RT2_BAND_CANDS[key] if passed.get(c))
+            if cands and not why_all:
+                if time.perf_counter() - t0 > RT2_PHASE_BUDGET_S:
+                    detail = f"skipped: deadline (phase {time.perf_counter() - t0:.0f}s)"
+                    print(f"[rt2] gate band {key} m={m} {detail}", flush=True)
+                else:
+                    best, res = _rt2_gate(state, key, m, cands)
+                    detail = "; ".join(f"BT={c[0]}/CS={c[1]} master/cand "
+                                       + "/".join(f"{r:.3f}" for r in res[c][0])
+                                       + f" iqr_ok={all(res[c][1])}" for c in cands)
+                    if best is None:
+                        detail += "; no candidate won both rounds with a tight IQR"
+                    else:
+                        st_on = dict(state)
+                        st_on["rt2_" + key + "_ok"] = True
+                        st_on["rt2_cfg_" + key] = best
+                        xd = torch.randn((m, ROUTER_K), device=dev, dtype=torch.float32).to(torch.bfloat16)
+                        data = {"x": xd, "config": {"m": m, "n": ROUTER_N, "k": ROUTER_K, "layer": "router"}}
+                        try:
+                            kn = _cell_kernels(lambda: kernel_fn(data, st_on))
+                            print(f"[rt2] band {key} m={m} chosen BT={best[0]} CS={best[1]}: profiled kernels {kn}", flush=True)
+                            if kn and not (len(kn) == 1 and "rt2_wgmma_swapab_kernel" in kn[0]):
+                                detail += f"; profiled kernels {kn}: expected exactly one rt2_wgmma_swapab_kernel"
+                                best = None
+                            elif not kn:
+                                print(f"[rt2] band {key}: profiler returned no CUDA kernel events; route kept "
+                                      f"(kernel_fn calls rt2_run directly)", flush=True)
+                        except Exception as e:  # own extension, direct launch: keep the route
+                            print(f"[rt2] band {key}: profiler unavailable ({type(e).__name__}: {e}); route kept "
+                                  f"(kernel_fn calls rt2_run directly)", flush=True)
+                        if best is not None:
+                            state["rt2_cfg_" + key] = best
+                            state["rt2_" + key + "_ok"] = True
+                            result = f"CUDA wgmma BT={best[0]} CS={best[1]}"
+        except Exception as e:  # never raises: any surprise keeps master's path for this band
+            detail = f"raised {type(e).__name__}: {str(e)[-300:]}"
+            state["rt2_" + key + "_ok"] = False
+            state["rt2_cfg_" + key] = None
+        state["rt2_err"].zero_()
+        line = f"PATH CHOSEN router band {key} (m {'65..128' if key == 'a' else '129..256'}, rep m={m}): {result} [{detail}]"
+        print(line, flush=True)
+        summary.append(line)
+    torch.cuda.synchronize()
+    print(f"[prepare-time] rt2 phase total: {time.perf_counter() - t0:.2f}s", flush=True)
+
+
+def _rt_hilo_traffic_mb(m: int) -> float:
+    """Master's hilo tiles (BLOCK_M x BLOCK_N from _router_hilo_config) L2 -> SM operand MB."""
+    bm, bn, _sk = _router_hilo_config(m)
+    return (m * ROUTER_K * 2 * (ROUTER_N // bn) + 2 * ROUTER_N * ROUTER_K * 2 * ((m + bm - 1) // bm)) / 1e6
+
+
+def _prepare_state(weights: Weights, flags=None) -> dict:
+    """Build one state. flags None: run the router-cluster and unpooler-cluster self-checks and the
+    unpooler gate (the state the judge keeps). flags a dict: the second state of the prepare()-time
+    A/B self-check, which inherits the first state's three dispatch flags instead of re-deciding."""
+    t_all = time.perf_counter()
+    marks = []
+
+    def tick(label, t0):
+        dt = time.perf_counter() - t0
+        marks.append((label, dt))
+        print(f"[prepare-time] {label}: {dt:.2f}s", flush=True)
+        return time.perf_counter()
+
+    t = time.perf_counter()
+    state = {name: w.contiguous() for name, w in weights.items()}
+    router = state["router"]
+    hi = router.to(torch.bfloat16).contiguous()
+    lo = (router - hi.float()).to(torch.bfloat16).contiguous()
+    state["router_hi"] = hi
+    state["router_lo"] = lo
+    # Lossless transposed bf16 copies [K, N] row-major (truly contiguous, not a .t() view) for
