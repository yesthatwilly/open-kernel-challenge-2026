 # Above this many tokens the router runs as the bf16 hi + lo pair instead of fp32 F.linear.
 ROUTER_FP32_MAX_TOKENS = 8
 
+# The pooler's Triton skinny GEMM: only for m <= POOLER_SKINNY_MAX_M at exactly this [N, K];
+# everything else (pooler at m > 32, any other n / k, every other layer) keeps cuBLAS.
+POOLER_SKINNY_MAX_M = 32
+POOLER_N = 4096
+POOLER_K = 8192
+POOLER_BLOCK_N = 32    # 4096 / 32 = 128 programs: one wave on 132 SMs, one program per SM
+POOLER_BLOCK_K = 256   # 8192 / 256 = 32 K steps per program
+POOLER_NUM_WARPS = 4
+POOLER_NUM_STAGES = 4  # 4 x (32 x 256 x 2 B) = 64 KB of weight in flight per program
+
+
+@triton.jit(do_not_specialize=["M"])
+def _pooler_skinny_kernel(
+    x_ptr, w_ptr, out_ptr,
+    M,
+    stride_xm, stride_wn, stride_om,
+    K: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    """out[:M, n0:n0+BLOCK_N] = x[:M, :K] @ w[n0:n0+BLOCK_N, :K].T for program n0 = pid * BLOCK_N.
+
+    One program owns BLOCK_N rows of the row-major [N, K] weight and walks the whole K in
+    BLOCK_K steps, so each weight byte is read once and there is no split-K reduce. Rows of x
+    at or past M load as zero and are not stored, so M need not fill BLOCK_M. The dot is bf16 x
+    bf16 with an fp32 accumulator; the only bf16 rounding is at the store."""
+    pid = tl.program_id(0)
+    offs_m = tl.arange(0, BLOCK_M)
+    offs_n = pid * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_k = tl.arange(0, BLOCK_K)
+    row_ok = offs_m < M
+
+    x_ptrs = x_ptr + offs_m[:, None] * stride_xm + offs_k[None, :]   # [BLOCK_M, BLOCK_K]
+    w_ptrs = w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :]   # [BLOCK_N, BLOCK_K], as stored
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for _ in range(0, K, BLOCK_K):
+        x_tile = tl.load(x_ptrs, mask=row_ok[:, None], other=0.0)
+        w_tile = tl.load(w_ptrs)
+        acc = tl.dot(x_tile, tl.trans(w_tile), acc)
+        x_ptrs += BLOCK_K
+        w_ptrs += BLOCK_K
+
+    out_ptrs = out_ptr + offs_m[:, None] * stride_om + offs_n[None, :]
+    tl.store(out_ptrs, acc.to(tl.bfloat16), mask=row_ok[:, None])
+
+
+def _pooler_skinny_applies(x: torch.Tensor, cfg: Config) -> bool:
+    """Shape- and config-only guard for the Triton pooler path."""
+    m, n, k = cfg["m"], cfg["n"], cfg["k"]
+    return (m <= POOLER_SKINNY_MAX_M and n == POOLER_N and k == POOLER_K
+            and x.dim() == 2 and x.shape[0] == m and x.shape[1] == k and x.stride(1) == 1
+            and x.dtype == torch.bfloat16)
+
+
+def _pooler_skinny_gemm(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    """x [m, 8192] bf16 @ w [4096, 8192] bf16 .T -> [m, 4096] bf16, m <= 32."""
+    m = x.shape[0]
+    block_m = 16 if m <= 16 else 32
+    out = torch.empty((m, POOLER_N), dtype=torch.bfloat16, device=x.device)
+    _pooler_skinny_kernel[(POOLER_N // POOLER_BLOCK_N,)](
+        x, w, out,
+        m,
+        x.stride(0), w.stride(0), out.stride(0),
+        K=POOLER_K, BLOCK_M=block_m, BLOCK_N=POOLER_BLOCK_N, BLOCK_K=POOLER_BLOCK_K,
+        num_warps=POOLER_NUM_WARPS, num_stages=POOLER_NUM_STAGES,
+    )
+    return out
+
+
+def _pooler_skinny_warmup(w: torch.Tensor) -> None:
+    """Compile every specialization the timed path can hit (BLOCK_M 16 and 32; M is not
+    specialized) on synthetic inputs, so no call to kernel_fn compiles. Outputs are dropped."""
+    for m in range(1, POOLER_SKINNY_MAX_M + 1):
+        x = torch.zeros((m, POOLER_K), dtype=torch.bfloat16, device=w.device)
+        _pooler_skinny_gemm(x, w)
+
 
