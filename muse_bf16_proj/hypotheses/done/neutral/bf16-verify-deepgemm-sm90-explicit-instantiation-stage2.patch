+        r = {"base": base, "cand": med["cand"], "master": med["master"], "cand_iqr": iqr["cand"],
+             "master_iqr": iqr["master"], "ratio": med["master"] / med["cand"]}
+        rounds.append(r)
+        print(f"[dg] gate {tag} {layer} m={m} round {rnd + 1}/{DG_GATE_ROUNDS} (graph replay, "
+              f"{CELL_FLUSH_BYTES >> 20} MB flush, {DG_GATE_REPS} reps, interleaved, baseline {base:.2f} us "
+              f"subtracted): cand median {r['cand']:.2f} us IQR {r['cand_iqr']:.2f}; master median "
+              f"{r['master']:.2f} us IQR {r['master_iqr']:.2f}; master/cand {r['ratio']:.3f} "
