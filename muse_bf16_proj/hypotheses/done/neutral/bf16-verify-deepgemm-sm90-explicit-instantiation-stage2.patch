+    k = w.shape[1]
+    g = torch.Generator(device=dev)
+    g.manual_seed(5150 + m)
+    x = torch.randn((m, k), device=dev, dtype=torch.float32, generator=g).to(torch.bfloat16)
+    _dg_say(f"launching {label} m={m} (eager, random x)")
+    out = fwd(x)
+    _dg_sync(f"{label} m={m} eager")
+    _dg_say(f"done      {label} m={m} (eager, random x)")
+    out2 = fwd(x)
+    _dg_sync(f"{label} m={m} eager again")
+    if not bool(torch.equal(out, out2)):
+        raise RuntimeError("second launch differs from the first")
+    ref = x.double() @ w.double().T
+    if not bool(torch.isfinite(out.float()).all()):
+        raise RuntimeError("non-finite output")
+    rel = float((out.double() - ref).norm() / ref.norm().clamp_min(1e-30))
+    if not rel <= CELL_REL_L2:
+        raise RuntimeError(f"rel L2 {rel:.3e} > {CELL_REL_L2:g}")
+    cub = _bf16_gemm_dispatch_impl(x, w, None)
