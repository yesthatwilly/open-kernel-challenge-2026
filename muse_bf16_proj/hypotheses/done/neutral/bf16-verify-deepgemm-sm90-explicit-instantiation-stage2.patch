+template <int CS, int NT>
+void set_attr() {
+  static bool done = false;
+  if (!done) {
+    C10_CUDA_CHECK(cudaFuncSetAttribute(router_kernel<CS, NT>, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                        Cfg<CS, NT>::SMEM));
+    done = true;
+  }
