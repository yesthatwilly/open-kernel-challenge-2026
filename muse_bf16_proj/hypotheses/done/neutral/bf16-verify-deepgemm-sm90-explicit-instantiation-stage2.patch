+def _dg_gate(tag: str, layer: str, m: int, n: int, k: int, flag: str, state: dict):
+    """Two INDEPENDENT interleaved rounds of the model selector (_cell_gate's method): kernel_fn
+    captured with the cell's flag on (candidate) and off (master's real routed path), fresh x and
+    fresh graphs per round, DG_GATE_REPS interleaved replays (order swapped every rep and
+    flipped between rounds), a CELL_FLUSH_BYTES write before each, medians minus an empty-graph
+    baseline, plus each side's IQR. Returns the list of per-round dicts. prepare()-only."""
