+def _dg_check(fwd, w: torch.Tensor, m: int, label: str) -> None:
+    """In-process self-check at this exact (layer, m): announce + sync + announce around every
+    launch, finite, rel L2 vs fp64, a second launch bit-identical, one-hot probe (exact weight
+    columns), then CUDA-graph capture + replay. Information only: bitwise equality with cuBLAS.
+    Raises on any failure."""
