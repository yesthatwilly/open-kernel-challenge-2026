+def _unpooler_skinny_applies(x: torch.Tensor, cfg: Config) -> bool:
+    """Shape- and config-only guard for the Triton unpooler path (full weight, 8 < m <= 32)."""
+    m, n, k = cfg["m"], cfg["n"], cfg["k"]
+    return (UNPOOLER_SKINNY_MIN_M <= m <= UNPOOLER_SKINNY_MAX_M
+            and n == UNPOOLER_N and k == UNPOOLER_K
+            and x.dim() == 2 and x.shape[0] == m and x.shape[1] == k and x.stride(1) == 1
+            and x.dtype == torch.bfloat16)
+
+
+def _unpooler_skinny_gemm(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    """x [m, 4096] bf16 @ w [8192, 4096] bf16 .T -> [m, 8192] bf16, 8 < m <= 32."""
+    m = x.shape[0]
+    block_m = 16 if m <= 16 else 32
+    out = torch.empty((m, UNPOOLER_N), dtype=torch.bfloat16, device=x.device)
+    _pooler_skinny_kernel[(UNPOOLER_N // UNPOOLER_BLOCK_N,)](
+        x, w, out,
+        m,
+        x.stride(0), w.stride(0), out.stride(0),
+        K=UNPOOLER_K, BLOCK_M=block_m, BLOCK_N=UNPOOLER_BLOCK_N, BLOCK_K=UNPOOLER_BLOCK_K,
+        num_warps=UNPOOLER_NUM_WARPS, num_stages=UNPOOLER_NUM_STAGES,
+    )
+    return out
+
+
+def _unpooler_skinny_warmup(w: torch.Tensor) -> None:
