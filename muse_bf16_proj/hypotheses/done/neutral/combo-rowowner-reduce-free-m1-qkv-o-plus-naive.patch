+#include <torch/extension.h>
+#include <vector>
+void bulk_run(torch::Tensor wt, torch::Tensor x, torch::Tensor out, torch::Tensor err, int64_t inst, int64_t m);
+std::vector<int64_t> bulk_setup(int64_t inst);
