+@triton.jit(do_not_specialize=["M"])
+def _unpooler_two_tile_kernel(
+    x_ptr, w_ptr, out_ptr,
+    M,
+    stride_xm, stride_wn, stride_om,
+    K: tl.constexpr, BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr, BLOCK_K: tl.constexpr,
+):
+    """_pooler_skinny_kernel for BLOCK_M < M <= 2 * BLOCK_M, as two BLOCK_M-row tiles.
+
+    Per K step the one [BLOCK_N, BLOCK_K] weight tile is loaded once and used by two tl.dot
+    calls, one per BLOCK_M-row x tile (rows 0..BLOCK_M-1 and BLOCK_M..2*BLOCK_M-1), each into
+    its own fp32 accumulator. Rows at or past M load as zero and are not stored. Same K order,
+    so each output row's arithmetic is the single-tile kernel's."""
+    pid = tl.program_id(0)
+    offs_m1 = tl.arange(0, BLOCK_M)
+    offs_m2 = BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = pid * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_k = tl.arange(0, BLOCK_K)
+    row_ok1 = offs_m1 < M
+    row_ok2 = offs_m2 < M
+
+    x1_ptrs = x_ptr + offs_m1[:, None] * stride_xm + offs_k[None, :]  # [BLOCK_M, BLOCK_K]
+    x2_ptrs = x_ptr + offs_m2[:, None] * stride_xm + offs_k[None, :]  # [BLOCK_M, BLOCK_K]
+    w_ptrs = w_ptr + offs_n[:, None] * stride_wn + offs_k[None, :]    # [BLOCK_N, BLOCK_K], as stored
+    acc1 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    acc2 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    for _ in range(0, K, BLOCK_K):
+        x1_tile = tl.load(x1_ptrs, mask=row_ok1[:, None], other=0.0)
+        x2_tile = tl.load(x2_ptrs, mask=row_ok2[:, None], other=0.0)
+        w_tile = tl.load(w_ptrs)
+        w_t = tl.trans(w_tile)
+        acc1 = tl.dot(x1_tile, w_t, acc1)
+        acc2 = tl.dot(x2_tile, w_t, acc2)
+        x1_ptrs += BLOCK_K
+        x2_ptrs += BLOCK_K
+        w_ptrs += BLOCK_K
+
+    out1_ptrs = out_ptr + offs_m1[:, None] * stride_om + offs_n[None, :]
+    out2_ptrs = out_ptr + offs_m2[:, None] * stride_om + offs_n[None, :]
+    tl.store(out1_ptrs, acc1.to(tl.bfloat16), mask=row_ok1[:, None])
+    tl.store(out2_ptrs, acc2.to(tl.bfloat16), mask=row_ok2[:, None])
+
