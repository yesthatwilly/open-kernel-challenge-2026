+def _swapab16_route_ok(key: str, x: torch.Tensor, w: torch.Tensor, cfg) -> bool:
+    """m <= 16 swap-AB path: 1 <= cfg m <= 16 with the key's n/k. pooler / qkv_gate / o need the
