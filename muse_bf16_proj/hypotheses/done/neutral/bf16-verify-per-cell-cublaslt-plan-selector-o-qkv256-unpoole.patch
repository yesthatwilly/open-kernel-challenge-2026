+    g_base = _cell_capture(lambda: scratch.add_(1.0))
+    base = _ouns_median([replay_us(g_base) for _ in range(PC_GATE_REPS)])
+    graphs = {"cand": _cell_capture(lambda: kernel_fn(data, st_c)),
