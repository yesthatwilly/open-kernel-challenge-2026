+// out[m, n] = x[m, k] @ W^T with the given algo on the current stream. transa != 0: w is [n, k];
+// else w is the transposed copy [k, n]. No sync, no allocation; the workspace is the caller's
+// prepare()-allocated per-state tensor (graph-capturable).
+void lt2_run(torch::Tensor x, torch::Tensor w, torch::Tensor out, torch::Tensor algo_row,
