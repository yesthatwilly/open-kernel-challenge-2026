+    const cublasLtMatmulAlgo_t& a = res[i].algo;
+    std::memcpy(ap + 8 * i, &a, sizeof(a));
+    ip[8 * i + 0] = muse_lt2_cfg<int32_t>(a, CUBLASLT_ALGO_CONFIG_ID);
+    ip[8 * i + 1] = muse_lt2_cfg<uint32_t>(a, CUBLASLT_ALGO_CONFIG_TILE_ID);
+    ip[8 * i + 2] = muse_lt2_cfg<uint32_t>(a, CUBLASLT_ALGO_CONFIG_STAGES_ID);
+    ip[8 * i + 3] = muse_lt2_cfg<uint32_t>(a, CUBLASLT_ALGO_CONFIG_SPLITK_NUM);
+    ip[8 * i + 4] = muse_lt2_cfg<uint32_t>(a, CUBLASLT_ALGO_CONFIG_REDUCTION_SCHEME);
+    ip[8 * i + 5] = static_cast<int64_t>(res[i].workspaceSize);
+    ip[8 * i + 6] = static_cast<int64_t>(res[i].wavesCount * 1000.0f);
+    ip[8 * i + 7] = static_cast<int64_t>(res[i].state);
+  }
+  return {algos, info};
+}
