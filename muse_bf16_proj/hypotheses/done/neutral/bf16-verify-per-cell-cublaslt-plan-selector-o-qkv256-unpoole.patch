+def _pc_forward(key: str, plan: dict, x: torch.Tensor, state: dict) -> torch.Tensor:
+    """One cell's candidate: a fixed cuBLASLt plan on the TN weight or the NN view, or the K-halves
+    bmm with fp32 partials (S=2) on the NN copy. No sync; allocations are shapes only."""
+    n = PC_CELLS[key][2]
+    if plan["kind"] == "lt":
+        out = torch.empty((x.shape[0], n), dtype=torch.bfloat16, device=x.device)
+        _LT2_EXT.lt2_run(x, state[plan["w_name"]], out, plan["algo"], state["pc_ws"], plan["transa"])
+        return out
+    m, k = x.shape
+    xh = x.view(m, 2, k // 2).transpose(0, 1)
+    wh = state[plan["w_name"]].view(2, k // 2, n)
+    part = torch.bmm(xh, wh, out_dtype=torch.float32)    # fp32 partials: one bf16 rounding at the end
+    return (part[0] + part[1]).to(torch.bfloat16)
