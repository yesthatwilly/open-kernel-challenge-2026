+  const int64_t m = x.size(0), k = x.size(1);
+  const int64_t n = transa ? w.size(0) : w.size(1);
+  TORCH_CHECK((transa ? w.size(1) : w.size(0)) == k && out.size(0) == m && out.size(1) == n,
