+def _pc_print_summary(state: dict) -> None:
+    """Compact last lines of prepare(): one line per PC cell with its FINAL flag (after the A/B
+    self-check), so the judge's log tail keeps every PATH CHOSEN / GATE result."""
+    for key, spec in PC_CELLS.items():
+        note = state.get("pc_note", {}).get(key, "")
+        print(f"PC-SUMMARY PATH CHOSEN {key} ({spec[0]} m={spec[1]}): "
+              f"{'ROUTED' if state[spec[4]] else 'master'} | {note[:600]}", flush=True)
+
