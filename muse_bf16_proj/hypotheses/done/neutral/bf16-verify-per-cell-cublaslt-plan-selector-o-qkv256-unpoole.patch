+def _pc_prepare(state: dict, t_start: float, flags=None) -> None:
+    """PC cells. Every flag starts False. flags None (the judge's state): per cell _pc_cell behind
+    its own start deadline (prints 'skipped: deadline'), any exception keeps master for that cell
+    only. flags a dict (the A/B check's second state): inherit each flag and plan (own algo row
+    copies), allocate the state's own workspace and NN view."""
+    for spec in PC_CELLS.values():
+        state[spec[4]] = False
+    state["pc_plan"] = {}
+    state["pc_ws"] = None
+    state["o_t"] = None
+    state["pc_note"] = {}
+    if flags is not None:
+        plans = flags.get("_pc_plans") or {}
+        need_ws = False
+        for key, spec in PC_CELLS.items():
+            plan = plans.get(key)
+            if not flags.get(spec[4]) or plan is None:
+                continue
+            if plan["w_name"] == "o_t" and state["o_t"] is None:
+                state["o_t"] = state["o"].t().contiguous()
+            new = dict(plan)
+            if plan["algo"] is not None:
+                new["algo"] = plan["algo"].clone()
+            state["pc_plan"][key] = new
+            state[spec[4]] = True
+            need_ws = need_ws or plan["kind"] == "lt"
+        if need_ws:
+            state["pc_ws"] = torch.empty(PC_WS_BYTES, dtype=torch.uint8, device=state["o"].device)
+        return
+    if _LT2_EXT is None:
+        for key in PC_CELLS:
+            state["pc_note"][key] = "no lt2 module"
+        return
+    t_phase = time.perf_counter()
+    try:
+        dev = state["o"].device
+        state["pc_ws"] = torch.empty(PC_WS_BYTES, dtype=torch.uint8, device=dev)
+        state["o_t"] = state["o"].t().contiguous()   # lossless [1024, 8192] NN view of W_o, built once
+    except Exception as e:
+        for key in PC_CELLS:
+            state["pc_note"][key] = f"setup raised {type(e).__name__}: {str(e)[-120:]}"
+        state["pc_ws"], state["o_t"] = None, None
+        return
+    for key, spec in PC_CELLS.items():
+        now = time.perf_counter()
+        if now - t_start > PC_START_DEADLINE_S or now - t_phase > PC_PHASE_BUDGET_S:
+            print(f"[pc] {key}: skipped: deadline (phase {now - t_phase:.1f}s of {PC_PHASE_BUDGET_S:.0f}s, "
+                  f"prepare {now - t_start:.1f}s of {PC_START_DEADLINE_S:.0f}s)", flush=True)
+            state["pc_note"][key] = "skipped: deadline"
+            continue
+        tc = time.perf_counter()
+        try:
+            _pc_cell(state, key)
+        except Exception as e:   # never raises: this cell keeps master's path, no other flag moves
+            state[spec[4]] = False
+            state["pc_plan"].pop(key, None)
+            state["pc_note"][key] = f"raised {type(e).__name__}: {str(e)[-200:]}"
+        if not state[spec[4]]:
+            state["pc_plan"].pop(key, None)
+        torch.cuda.synchronize()
+        print(f"[prepare-time] pc cell {key}: {time.perf_counter() - tc:.2f}s", flush=True)
+        print(f"PATH CHOSEN PC {spec[0]} m={spec[1]}: {'candidate' if state[spec[4]] else 'master'}; "
+              f"{state['pc_note'].get(key, '')}", flush=True)
+    if not any(p["kind"] == "lt" for p in state["pc_plan"].values()):
+        state["pc_ws"] = None
+    if not any(p["w_name"] == "o_t" for p in state["pc_plan"].values()):
+        state["o_t"] = None
+
