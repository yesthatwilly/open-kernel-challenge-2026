+def _pc_gate_round(layer: str, m: int, n: int, k: int, st_c: dict, st_i: dict) -> dict:
+    """One independent interleaved round of the model selector: a FRESH x, both kernel_fn graphs
+    RE-CAPTURED, PC_GATE_REPS replays (order swapped every rep) with a CELL_FLUSH_BYTES write before
+    each, medians and IQRs, empty-graph baseline subtracted from the medians. prepare()-only."""
+    dev = st_c["router"].device
+    x = torch.randn((m, k), device=dev, dtype=torch.float32).to(torch.bfloat16)
+    data = {"x": x, "config": {"m": m, "n": n, "k": k, "layer": layer}}
+    flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def replay_us(gr) -> float:
+        flush.zero_()
+        ev[0].record()
+        gr.replay()
+        ev[1].record()
+        ev[1].synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1e3
