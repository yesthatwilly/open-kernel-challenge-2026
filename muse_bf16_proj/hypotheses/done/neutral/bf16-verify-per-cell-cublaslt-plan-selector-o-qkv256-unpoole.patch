+def _pc_route(layer: str, x: torch.Tensor, cfg, state: dict):
+    """PC cell key if (layer, cfg m) is one of the five cells, its prepare()-set flag and plan exist,
+    cfg n / k and the weight are the cell's full shape and x is a contiguous 256-byte-aligned bf16
+    [m, k]. cfg, shapes and state only; else None (master's routing, untouched)."""
+    key = PC_BY_LM.get((layer, cfg["m"]))
+    if key is None:
+        return None
+    spec = PC_CELLS[key]
+    if not state[spec[4]] or key not in state["pc_plan"]:
+        return None
+    n, k, m = spec[2], spec[3], spec[1]
+    w = state[layer]
+    if (cfg["n"] == n and cfg["k"] == k and w.dim() == 2 and tuple(w.shape) == (n, k)
+            and x.dim() == 2 and x.shape[0] == m and x.shape[1] == k and x.dtype == torch.bfloat16
+            and x.is_contiguous() and x.data_ptr() % LT_ALIGN == 0):
+        return key
