+def _lt_find_plan(x: torch.Tensor, w: torch.Tensor, ref: torch.Tensor, inc_err: float):
+    """Search cuBLASLt for a splitK == 1 algo for qkv_gate m=128: heuristic results under each
+    workspace cap in LT_WS_TRY, plus every split-K result with SPLITK_NUM forced to 1 (validated by
+    cublasLtMatmulAlgoCheck). Each candidate is checked (finite, rel L2 vs fp64 <= CELL_REL_L2 and
+    <= 1.10x master's, probe row <= CELL_PROBE_TOL) and screened by cold-L2 graph replay. Returns
+    (us, algo row CPU int64 [8], workspace bytes, description) for the fastest, or None."""
+    n, k = w.shape
+    m = x.shape[0]
+    dev = x.device
+    seen = set()
+    cands = []
+
+    def add(row, inf, src):
+        key = tuple(int(v) for v in row.tolist())
+        if key in seen:
+            return
+        seen.add(key)
+        algo_id, tile, stages, splitk, red, ws_need, waves, st = inf
+        desc = (f"{src}: algo={algo_id} tile={tile} stages={stages} splitK={splitk} red={red} "
+                f"ws={ws_need} waves={waves / 1000:.2f}")
+        if st != 0 or splitk != 1 or ws_need < 0 or ws_need > max(LT_WS_TRY):
+            print(f"[lt]   {desc}: excluded (state {st}, splitK must be 1, workspace bound)", flush=True)
+            return
+        cands.append((row.clone().contiguous(), int(ws_need), desc))
+
+    for ws_bytes in LT_WS_TRY:
+        try:
+            algos, info = _LT_EXT.lt_candidates(n, k, m, LT_MAX_ALGOS, ws_bytes)
+        except Exception as e:
+            print(f"[lt] heuristic query ws cap {ws_bytes} B raised {type(e).__name__}: {e}", flush=True)
+            continue
+        print(f"[lt] heuristic query ws cap {ws_bytes} B: {algos.shape[0]} results", flush=True)
+        for i in range(algos.shape[0]):
+            inf = [int(v) for v in info[i].tolist()]
+            add(algos[i], inf, f"ws{ws_bytes >> 10}K#{i}")
+            if inf[3] > 1:
+                try:
+                    fa, fi = _LT_EXT.lt_force_splitk1(algos[i].clone().contiguous(), n, k, m)
+                except Exception as e:
+                    print(f"[lt]   ws{ws_bytes >> 10}K#{i}: forcing splitK=1 raised {type(e).__name__}: {e}",
+                          flush=True)
+                    continue
+                if fa.shape[0]:
+                    add(fa[0], [int(v) for v in fi[0].tolist()], f"ws{ws_bytes >> 10}K#{i}->splitK1")
+    print(f"[lt] {len(cands)} distinct splitK=1 candidates (screening at most {LT_MAX_CANDS})", flush=True)
+    if not cands:
+        return None
+    flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    best = None
+    try:
+        for row, ws_need, desc in cands[:LT_MAX_CANDS]:
+            ws = torch.empty(max(ws_need, LT_ALIGN), dtype=torch.uint8, device=dev)
+            out = torch.empty((m, n), dtype=torch.bfloat16, device=dev)
+            try:
+                print(f"[lt]   LAUNCH lt_run {desc} ...", flush=True)
+                _LT_EXT.lt_run(x, w, out, row, ws)
+                torch.cuda.synchronize()
+                print(f"[lt]   DONE   lt_run {desc}", flush=True)
+                finite = bool(torch.isfinite(out.float()).all())
+                err = _cell_rel(out, ref)
+                prel = _cell_rel(out[m - 1], ref[m - 1])
+                if not (finite and err <= CELL_REL_L2 and err <= LT_MAX_ERR_VS_INCUMBENT * inc_err
+                        and prel <= CELL_PROBE_TOL):
+                    print(f"[lt]   {desc}: excluded (finite={finite} rel_vs_fp64={err:.3e} master {inc_err:.3e} "
+                          f"probe {prel:.2e})", flush=True)
+                    continue
+                g = _cell_capture(lambda: _LT_EXT.lt_run(x, w, out, row, ws))
+                ts = []
+                for _ in range(LT_SCREEN_REPS):
+                    flush.zero_()
+                    a = torch.cuda.Event(enable_timing=True)
+                    b = torch.cuda.Event(enable_timing=True)
+                    a.record()
+                    g.replay()
+                    b.record()
+                    b.synchronize()
+                    ts.append(a.elapsed_time(b) * 1e3)
+                del g
+                us = _cell_median(ts)
+            except Exception as e:
+                print(f"[lt]   {desc}: excluded (raised {type(e).__name__}: {e})", flush=True)
+                torch.cuda.synchronize()
+                continue
+            print(f"[lt]   {desc}: {us:.2f} us cold graph replay (rel_vs_fp64 {err:.3e}, probe {prel:.2e})",
+                  flush=True)
+            if best is None or us < best[0]:
+                best = (us, row, ws_need, desc)
+    finally:
+        flush = None
+        torch.cuda.synchronize()
+    return best
+
