+def _bulk_check(state: dict) -> str:
+    """Cell A self-check at m == 1, in-process: a random x and a probe x (one power-of-two entry,
+    its output row is a weight column exactly), each launch announced with a flushed print before
+    it and a synchronize, error-word read and flushed print after it. "" on pass, else why."""
