+    except Exception as e:
+        print(f"[ab] cell A inherit failed ({type(e).__name__}: {e}); bulk_p1_ok off", flush=True)
+        state["bulk_p1_ok"] = False
+    state["lt_qkv128"] = int(cells["lt_qkv128"])
+    try:
+        if state["lt_qkv128"] == 1:
