+def _lt_cell_prepare(state: dict, t_prepare0: float) -> None:
+    """Cell B decision for this state. Mode 1 (cuBLASLt splitK=1 plan) is tried first, mode 2
+    (addmm with a zero bf16 bias) only if mode 1 is unavailable or fails. Each mode must pass the
+    correctness check through kernel_fn, the graph-replay gate (<= 0.98x master's path), and the
+    profiler assertion (kernel_fn qkv_gate m=128 launches exactly one kernel and no split-K /
+    splitKreduce kernel). Finally qkv_gate m=256 must launch exactly master's kernels. Never raises;
+    any miss leaves state["lt_qkv128"] = 0 (master path for that cell only)."""
+    state["lt_qkv128"] = 0
+    why = ""
+    cand_us = master_us = float("nan")
+    chosen_desc = ""
+    w = state["qkv_gate"]
+    try:
+        elapsed = time.perf_counter() - t_prepare0
+        if elapsed > LT_DEADLINE_S:
+            raise RuntimeError(f"prepare elapsed {elapsed:.1f}s > {LT_DEADLINE_S:.0f}s deadline")
+        if not (tuple(w.shape) == (LT_QKV_N, LT_QKV_K) and w.dtype == torch.bfloat16 and w.is_cuda
+                and w.is_contiguous()):
+            raise RuntimeError(f"qkv_gate weight {tuple(w.shape)} {w.dtype} unexpected")
+        dev = w.device
+        m = LT_QKV_M
+        cfg = {"m": m, "n": LT_QKV_N, "k": LT_QKV_K, "layer": "qkv_gate"}
+        gen = torch.Generator(device=dev)
+        gen.manual_seed(24680)
+        x = torch.randn((m, LT_QKV_K), device=dev, dtype=torch.float32, generator=gen).to(torch.bfloat16)
+        x[m - 1].zero_()
+        x[m - 1, (37 * m + 5) % LT_QKV_K] = 2.0        # probe row: a weight column times 2, exact
+        ref = x.double() @ w.double().T
+        inc = _bf16_gemm_dispatch_impl(x, w, None)
+        torch.cuda.synchronize()
+        inc_err = _cell_rel(inc, ref)
+        print(f"[lt] master qkv_gate m=128 rel L2 vs fp64 {inc_err:.3e}", flush=True)
+        try:
+            print(f"[lt] profiler: master qkv_gate m=128 launches "
+                  f"{_cell_kernel_names(lambda: _bf16_gemm_dispatch_impl(x, w, None))}", flush=True)
+        except Exception as e:
+            print(f"[lt] profiler unavailable for the master record ({type(e).__name__}: {e})", flush=True)
+        modes = []
+        if _LT_EXT is None:
+            print("[lt] no cuBLASLt plan module: mode 1 unavailable", flush=True)
+        else:
+            plan = _lt_find_plan(x, w, ref, inc_err)
+            if plan is None:
+                print("[lt] NO splitK=1 cuBLASLt algo obtained for qkv_gate m=128: mode 1 (Lt plan) dropped",
+                      flush=True)
+            else:
+                us, row, ws_need, desc = plan
+                print(f"[lt] best splitK=1 plan: {desc} at {us:.2f} us (screen)", flush=True)
+                state["lt_qkv128_algo"] = row
+                state["lt_qkv128_ws"] = torch.empty(max(ws_need, LT_ALIGN), dtype=torch.uint8, device=dev)
+                modes.append((1, f"cuBLASLt plan {desc}"))
+        state["lt_qkv128_bias"] = torch.zeros(LT_QKV_N, dtype=torch.bfloat16, device=dev)
+        modes.append((2, "torch.addmm(zero bf16 bias, x, W.t())"))
+        data = {"x": x, "config": cfg}
+        for mode, desc in modes:
+            if time.perf_counter() - t_prepare0 > LT_DEADLINE_S:
+                why += f"; deadline before mode {mode}"
+                break
+            state["lt_qkv128"] = mode
+            print(f"[lt] LAUNCH kernel_fn qkv_gate m=128 mode {mode} ({desc}) ...", flush=True)
+            out = kernel_fn(data, state)
+            torch.cuda.synchronize()
+            print(f"[lt] DONE   kernel_fn qkv_gate m=128 mode {mode}", flush=True)
+            state["lt_qkv128"] = 0
+            finite = bool(torch.isfinite(out.float()).all())
+            err = _cell_rel(out, ref)
+            prel = _cell_rel(out[m - 1], ref[m - 1])
+            if not (finite and err <= CELL_REL_L2 and err <= LT_MAX_ERR_VS_INCUMBENT * inc_err
+                    and prel <= CELL_PROBE_TOL):
+                why += f"; mode {mode} check miss (finite {finite}, rel {err:.3e}, probe {prel:.2e})"
+                print(f"[lt] mode {mode} self-check MISS: finite {finite}, rel {err:.3e}, probe {prel:.2e}", flush=True)
+                continue
+            print(f"[lt] mode {mode} self-check ok: rel L2 {err:.3e} (master {inc_err:.3e}), probe {prel:.2e}",
+                  flush=True)
+            ratio, c_us, m_us = _cell_gate("lt", state, "lt_qkv128", mode, 0, cfg, x)
+            if not ratio <= CELL_MAX_RATIO:
+                why += f"; mode {mode} gate lost ({ratio:.3f})"
+                cand_us, master_us = c_us, m_us
+                continue
+            state["lt_qkv128"] = mode
+            try:
+                names = _cell_kernel_names(lambda: kernel_fn(data, state))
+            except Exception as e:
+                state["lt_qkv128"] = 0
+                why += f"; mode {mode} profiler unavailable ({type(e).__name__}), kernel name unproven"
+                continue
+            print(f"[lt] profiler: kernel_fn qkv_gate m=128 mode {mode} launches {names}", flush=True)
+            if not (len(names) == 1 and "splitk" not in names[0].lower()):
+                state["lt_qkv128"] = 0
+                why += f"; mode {mode} kernel-name assert failed ({names})"
+                continue
+            cand_us, master_us, chosen_desc = c_us, m_us, f"{desc} -> {names[0]}"
+            break
+        if state["lt_qkv128"]:
+            # verify_32: qkv_gate m=256 must still launch exactly master's kernels.
+            x256 = torch.randn((256, LT_QKV_K), device=dev, dtype=torch.float32, generator=gen).to(torch.bfloat16)
+            d256 = {"x": x256, "config": {"m": 256, "n": LT_QKV_N, "k": LT_QKV_K, "layer": "qkv_gate"}}
+            got = _cell_kernel_names(lambda: kernel_fn(d256, state))
+            want = _cell_kernel_names(lambda: _bf16_gemm_dispatch_impl(x256, w, None))
+            print(f"[lt] profiler: kernel_fn qkv_gate m=256 launches {got}; master {want}", flush=True)
+            if got != want:
+                why += f"; qkv_gate m=256 kernels changed ({got} vs {want})"
+                state["lt_qkv128"] = 0
+    except Exception as e:  # never raises: any surprise keeps master's path for this cell
+        why += f"; raised {type(e).__name__}: {str(e)[-300:]}"
+        state["lt_qkv128"] = 0
+    torch.cuda.synchronize()
+    if state["lt_qkv128"] != 1:
+        state.pop("lt_qkv128_algo", None)
+        state.pop("lt_qkv128_ws", None)
+    if state["lt_qkv128"] != 2:
+        state.pop("lt_qkv128_bias", None)
+    print(f"[lt] PATH CHOSEN B(cublaslt-no-splitk) qkv_gate m=128: "
+          f"{('candidate mode %d (%s)' % (state['lt_qkv128'], chosen_desc)) if state['lt_qkv128'] else 'master'} "
+          f"(cand {cand_us:.2f} us vs master {master_us:.2f} us)"
+          + ("" if state["lt_qkv128"] else f"; why: {why.lstrip('; ') or 'n/a'}"), flush=True)
+
