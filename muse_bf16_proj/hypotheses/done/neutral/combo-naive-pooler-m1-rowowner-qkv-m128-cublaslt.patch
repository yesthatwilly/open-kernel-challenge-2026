+def _cell_gate(tag: str, state: dict, flag: str, on_value, off_value, cfg, x: torch.Tensor):
+    """The model selector (copied from _ouns_gate): capture kernel_fn for this cell twice on the
+    same synthetic x, once with state[flag] = off_value (master's path) and once with on_value (the
+    candidate); replay both CELL_GATE_REPS times interleaved (order alternating every rep), each
+    replay after a 256 MB flush, timed with CUDA events; subtract an empty-graph baseline from both
+    medians. Returns (candidate / master, candidate net us, master net us). state[flag] is restored."""
+    dev = x.device
+    data = {"x": x, "config": cfg}
+    prev = state[flag]
+    flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+    graphs = {}
