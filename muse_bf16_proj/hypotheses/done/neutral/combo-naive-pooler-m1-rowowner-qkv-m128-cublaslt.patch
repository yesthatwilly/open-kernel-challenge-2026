+              f"median {med['master']:.2f} us, empty-graph baseline {base:.2f} us -> net {adj['cand']:.2f} vs "
+              f"{adj['master']:.2f} us, candidate/master {ratio:.3f}x (need <= {CELL_MAX_RATIO}) -> "
+              f"{'WIN' if ratio <= CELL_MAX_RATIO else 'LOSS'}", flush=True)
