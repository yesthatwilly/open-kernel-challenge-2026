+    try:
+        graphs["base"] = _cell_capture(lambda: scratch.add_(1.0))
+        base = _cell_median([replay_us(graphs["base"]) for _ in range(CELL_GATE_REPS)])
+        state[flag] = off_value
+        graphs["master"] = _cell_capture(lambda: kernel_fn(data, state))
+        state[flag] = on_value
+        graphs["cand"] = _cell_capture(lambda: kernel_fn(data, state))
+        state[flag] = prev
+        times = {"cand": [], "master": []}
+        for rep in range(CELL_GATE_REPS):
+            order = ("cand", "master") if rep % 2 == 0 else ("master", "cand")
+            for name in order:
+                times[name].append(replay_us(graphs[name]))
+        med = {name: _cell_median(v) for name, v in times.items()}
+        adj = {name: max(v - base, 0.25) for name, v in med.items()}
+        ratio = adj["cand"] / adj["master"]
+        print(f"[{tag}] gate {cfg['layer']} m={cfg['m']} (graph replay of kernel_fn, {CELL_FLUSH_BYTES >> 20} MB "
