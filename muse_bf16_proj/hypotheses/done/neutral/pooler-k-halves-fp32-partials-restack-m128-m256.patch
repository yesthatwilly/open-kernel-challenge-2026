+def _khalf_forward(x: torch.Tensor, state: dict, kind: str) -> torch.Tensor:
+    """Pooler as two K halves in one strided-batched cuBLAS GEMM over master's NN weight, then one
+    add. x [m, 8192] contiguous; xh is a strided view (no copy), wh = pooler_t.view(2, 4096, 4096).
+    kind "a": bf16 partials, out = p[0] + p[1]. kind "b": fp32 partials (bmm out_dtype=float32), one
+    fp32 add stored once as bf16 into a fresh output (one rounding, like cuBLAS's own split-K)."""
+    m = x.shape[0]
+    xh = x.view(m, 2, KHALF_HALF).permute(1, 0, 2)
+    wh = state["pooler_t"].view(2, KHALF_HALF, POOLER_N)
+    if kind == "a":
+        p = torch.bmm(xh, wh)
+        return torch.add(p[0], p[1])
+    p = torch.bmm(xh, wh, out_dtype=torch.float32)
+    out = torch.empty((m, POOLER_N), dtype=torch.bfloat16, device=x.device)
+    torch.add(p[0], p[1], out=out)
+    return out
+
+
+def _khalf_route_ok(x: torch.Tensor, cfg, state: dict) -> bool:
+    """pooler at cfg m in KHALF_MS with its own flag set and a prepare()-fixed kind: cfg, shapes and
+    state only, never input values."""
+    m = cfg["m"]
+    flag = KHALF_FLAGS.get(m)
+    if flag is None or not state[flag]:
+        return False
+    wt = state["pooler_t"]
+    return (m in state["pooler_khalf_kind"] and cfg["n"] == POOLER_N and cfg["k"] == POOLER_K
+            and tuple(wt.shape) == (POOLER_K, POOLER_N) and wt.is_contiguous()
+            and x.dim() == 2 and x.shape[0] == m and x.shape[1] == POOLER_K
+            and x.dtype == torch.bfloat16 and x.is_contiguous())
+
+
+def _khalf_names_ok(names: list) -> str:
+    """"" if the profiled kernels of a K-halves candidate are acceptable, else why not: needs a GEMM
+    kernel; rejects a copy/contiguous() of xh or wh and any split-K reduce node. Elementwise names
+    are printed, not matched (a mixed-dtype add may be unrolled_elementwise_kernel)."""
+    low = [n.lower() for n in names]
+    if not low:
+        return "profiler saw no CUDA kernels"
+    if any(("memcpy" in n or "copy" in n or "contiguous" in n) for n in low):
+        return "a copy kernel was launched (xh/wh not consumed in place)"
+    if any("splitkreduce" in n or "splitk_reduce" in n for n in low):
+        return "a split-K reduce kernel was launched"
+    if not any(("nvjet" in n or "gemm" in n or "cutlass" in n or "sm90" in n) for n in low):
+        return "no GEMM-like kernel name"
+    return ""
+
+
+def _khalf_cell(state: dict, m: int, dev, flush, g_base, scratch, ev) -> tuple:
+    """One m. Returns (kind or None, summary line). Candidates: valid ones of {"a", "b"}, each
+    numerics-checked through kernel_fn (state copy with the flag on) and kernel-name-checked; then
+    KHALF_ROUNDS independent interleaved rounds (41 reps, 256 MB flush, own empty-graph baseline)
+    of master's ACTUALLY ROUTED path (flag off) against each valid candidate. Routed only if every
+    round has master/cand >= KHALF_MIN_RATIO and cand IQR <= KHALF_MAX_IQR x master IQR."""
+    flag = KHALF_FLAGS[m]
+    cfg = {"m": m, "n": POOLER_N, "k": POOLER_K, "layer": "pooler"}
+    st_i = dict(state)
+    st_i[flag] = False
+    st_c = {}
+    for kind in ("a", "b"):
+        s = dict(state)
+        s[flag] = True
+        s["pooler_khalf_kind"] = {m: kind}
+        st_c[kind] = s
+    x = torch.randn((m, POOLER_K), device=dev, dtype=torch.float32).to(torch.bfloat16)
+    data = {"x": x, "config": cfg}
+    xh = x.view(m, 2, KHALF_HALF).permute(1, 0, 2)
+    print(f"[khalf] m={m}: xh.stride()={tuple(xh.stride())} xh.is_contiguous()={xh.is_contiguous()}", flush=True)
+    try:
+        mnames = _cell_kernels(lambda: kernel_fn(data, st_i))
+    except Exception as e:
+        mnames = [f"profiler unavailable ({type(e).__name__}: {e})"]
+    print(f"[khalf] m={m}: master (flag off, actually routed) kernels {mnames}", flush=True)
+    valid = {}
+    for kind in ("a", "b"):
+        why = ""
+        try:
+            if _khalf_route_ok(x, cfg, st_c[kind]) is not True:
+                why = "route check failed"
+            if not why:
+                why = _cell_check(f"khalf-{kind}", lambda xx, kind=kind: kernel_fn({"x": xx, "config": cfg}, st_c[kind]),
+                                  state["pooler"], m, POOLER_N, POOLER_K)
+            names = []
+            if not why:
+                names = _cell_kernels(lambda kind=kind: kernel_fn(data, st_c[kind]))
+                why = _khalf_names_ok(names)
+            print(f"[khalf] m={m} cand {kind} ({'bf16' if kind == 'a' else 'fp32'} partials): kernels {names}"
+                  + (f" EXCLUDED: {why}" if why else " valid"), flush=True)
+        except Exception as e:
+            why = f"raised {type(e).__name__}: {str(e)[-200:]}"
+            print(f"[khalf] m={m} cand {kind}: EXCLUDED: {why}", flush=True)
+        if not why:
+            valid[kind] = True
+    if not valid:
+        return None, f"PATH CHOSEN khalf pooler m={m}: master (no valid candidate; gate not run, not a measured loss)"
+    graphs = {"master": _cell_capture(lambda: kernel_fn(data, st_i))}
+    for kind in valid:
+        graphs[kind] = _cell_capture(lambda kind=kind: kernel_fn(data, st_c[kind]))
+    live = list(graphs)
+
+    def replay_us(gr) -> float:
+        flush.zero_()
+        ev[0].record()
+        gr.replay()
+        ev[1].record()
+        ev[1].synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1e3
+
+    rounds = []
+    for rnd in range(KHALF_ROUNDS):
+        base = _ouns_median([replay_us(g_base) for _ in range(CELL_GATE_REPS)])
+        times = {n: [] for n in live}
+        for rep in range(CELL_GATE_REPS):
+            sh = (rep + rnd) % len(live)
+            order = live[sh:] + live[:sh]
+            if rep % 2:
+                order = order[::-1]
+            for n in order:
+                times[n].append(replay_us(graphs[n]))
+        res = {}
+        for n, v in times.items():
+            sv = sorted(v)
+            med = sv[len(sv) // 2]
+            res[n] = (med, sv[(3 * len(sv)) // 4] - sv[len(sv) // 4], max(med - base, 0.25))
+        rounds.append(res)
+        for n in live:
+            if n == "master":
+                continue
+            print(f"[khalf] gate m={m} round {rnd + 1}/{KHALF_ROUNDS} cand {n}: master median {res['master'][0]:.2f} us "
+                  f"(IQR {res['master'][1]:.2f}), cand median {res[n][0]:.2f} us (IQR {res[n][1]:.2f}), "
+                  f"baseline {base:.2f} us -> net {res['master'][2]:.2f} vs {res[n][2]:.2f} us, "
+                  f"master/cand {res['master'][2] / res[n][2]:.3f}", flush=True)
+    del graphs
+    torch.cuda.synchronize()
+    score, passed = {}, {}
+    for kind in valid:
+        ratios = [r["master"][2] / r[kind][2] for r in rounds]
+        iqr_ok = all(r[kind][1] <= KHALF_MAX_IQR * max(r["master"][1], 0.5) for r in rounds)
+        score[kind] = min(ratios)
+        passed[kind] = score[kind] >= KHALF_MIN_RATIO and iqr_ok
+        print(f"[khalf] gate m={m} cand {kind}: ratios {[round(v, 3) for v in ratios]} (need all >= "
+              f"{KHALF_MIN_RATIO}), IQR ok {iqr_ok} (cand <= {KHALF_MAX_IQR}x master) -> "
+              f"{'PASS' if passed[kind] else 'REJECT'}", flush=True)
+    chosen = None
+    if passed.get("a") and (not passed.get("b") or score["a"] >= KHALF_PREFER_A * score["b"]):
+        chosen = "a"
+    elif passed.get("b"):
+        chosen = "b"
+    desc = " ".join(f"{k}:min-ratio {score[k]:.3f}" for k in score)
+    if chosen:
+        return chosen, (f"PATH CHOSEN khalf pooler m={m}: K-halves bmm cand {chosen} "
+                        f"({'bf16' if chosen == 'a' else 'fp32'} partials) ({desc}; master med/IQR "
+                        f"{[(round(r['master'][0], 2), round(r['master'][1], 2)) for r in rounds]}, cand med/IQR "
+                        f"{[(round(r[chosen][0], 2), round(r[chosen][1], 2)) for r in rounds]})")
+    return None, (f"PATH CHOSEN khalf pooler m={m}: master (gate rejected, not a measured loss of the row; {desc}; "
+                  f"master med/IQR {[(round(r['master'][0], 2), round(r['master'][1], 2)) for r in rounds]})")
+
+
+def _khalf_prepare(state: dict, t_start: float) -> None:
+    """State A only. Sets state[KHALF_FLAGS[m]] and state['pooler_khalf_kind'] ({m: 'a' | 'b'}); every
+    surprise leaves master's NN path. Own start deadline; prints 'skipped: deadline'. Never raises."""
+    for flag in KHALF_FLAGS.values():
+        state[flag] = False
+    state["pooler_khalf_kind"] = {}
+    t0 = time.perf_counter()
+    lines = []
+    try:
+        if t0 - t_start > KHALF_START_DEADLINE_S:
+            for m in KHALF_MS:
+                _path_print(f"PATH CHOSEN khalf pooler m={m}: master (skipped: deadline, {t0 - t_start:.0f}s into "
+                            f"prepare > {KHALF_START_DEADLINE_S:.0f}s)", flush=True)
+            print("[khalf] skipped: deadline", flush=True)
+            return
+        w, wt = state["pooler"], state["pooler_t"]
+        if not (tuple(w.shape) == (POOLER_N, POOLER_K) and w.dtype == torch.bfloat16 and w.is_contiguous()
+                and tuple(wt.shape) == (POOLER_K, POOLER_N) and wt.dtype == torch.bfloat16 and wt.is_contiguous()):
+            for m in KHALF_MS:
+                _path_print(f"PATH CHOSEN khalf pooler m={m}: master (weight layout unexpected)", flush=True)
+            return
+        try:
+            xs = torch.zeros((KHALF_MS[0], POOLER_K), device=w.device, dtype=torch.bfloat16)
+            torch.bmm(xs.view(KHALF_MS[0], 2, KHALF_HALF).permute(1, 0, 2), wt.view(2, KHALF_HALF, POOLER_N),
+                      out_dtype=torch.float32)
+            torch.cuda.synchronize()
+            print("[khalf] torch.bmm(out_dtype=torch.float32) accepted on this image", flush=True)
+        except Exception as e:
+            print(f"[khalf] torch.bmm(out_dtype=torch.float32) rejected ({type(e).__name__}: {str(e)[-160:]}); "
+                  f"candidate b will be excluded by its check, a only", flush=True)
+        dev = w.device
+        flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+        scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+        ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+        g_base = _cell_capture(lambda: scratch.add_(1.0))
+        for m in KHALF_MS:
+            tm = time.perf_counter()
+            if tm - t_start > KHALF_START_DEADLINE_S + 40.0:
+                line = f"PATH CHOSEN khalf pooler m={m}: master (skipped: deadline)"
+                print("[khalf] skipped: deadline", flush=True)
+            else:
+                try:
+                    kind, line = _khalf_cell(state, m, dev, flush, g_base, scratch, ev)
+                    if kind is not None:
+                        state[KHALF_FLAGS[m]] = True
+                        state["pooler_khalf_kind"][m] = kind
+                except Exception as e:
+                    line = f"PATH CHOSEN khalf pooler m={m}: master (raised {type(e).__name__}: {str(e)[-200:]})"
+                    state[KHALF_FLAGS[m]] = False
+                    state["pooler_khalf_kind"].pop(m, None)
+            lines.append(line)
+            _path_print(line, flush=True)
+            print(f"[prepare-time] khalf pooler m={m}: {time.perf_counter() - tm:.2f}s", flush=True)
+        del g_base, flush
+    except Exception as e:  # never raises
+        print(f"[khalf] prepare raised {type(e).__name__}: {str(e)[-200:]}; master path for both cells", flush=True)
+        for flag in KHALF_FLAGS.values():
+            state[flag] = False
+        state["pooler_khalf_kind"] = {}
+    torch.cuda.synchronize()
+    print(f"[prepare-time] khalf total: {time.perf_counter() - t0:.2f}s", flush=True)
+
