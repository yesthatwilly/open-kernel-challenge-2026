+def _mcx_diag(state: dict, t0: float) -> None:
+    """prepare()-only diagnostic (hypothesis b12mc-multicast-x-pooler-qkv-m8-readflush-diag). Reads state, adds no
+    key to it, frees every tensor / graph it made. Never raises. Rule (restated by the build, see the hypothesis'
+    Implementation notes): b8 / b16 / bq = worst-round min(mc, uc) / inc at pooler m=8 / pooler m=16 / qkv m=8.
+    INVALID if a pooler case is (build, occupancy, round trip, _cell_check, error word or mc != uc bits); else
+    REFUTE if b8 >= MCX_REFUTE; LEAD if b8 <= MCX_LEAD_B8 and b16 <= MCX_LEAD_B16 (qkv m=8 added only at bq <=
+    MCX_LEAD_QKV); SHELF otherwise. mc/uc is attribution only."""
+    if _MCX_EXT is None:
+        _decision(f"[mcx] VERDICT n/a: build ({_MCX_BUILD_WHY}); kernel_fn and routing unchanged")
+        return
+    el = time.perf_counter() - t0
+    if el > MCX_BUDGET_S:
+        _decision(f"[mcx] VERDICT n/a: budget (prepare() already {el:.0f} s > {MCX_BUDGET_S:.0f} s); kernel_fn and "
+                  f"routing unchanged")
+        return
+    t1 = time.perf_counter()
+    res, info, occ_txt = {}, {}, []
+    err = None
+    try:
+        err = torch.zeros(1, dtype=torch.int32, device=state["router"].device)
+        for inst, spec in MCX_INST.items():
+            try:
+                info[inst] = [int(v) for v in _MCX_EXT.mcx_setup(inst, MCX_N[spec[0]])]
+                v = info[inst]
+                occ_txt.append(f"i{inst} {v[5] if v[5] >= 0 else '-'}cl {v[4]}/SM r{v[0]} s{v[1]} {v[3] // 1024}KB")
+                print(f"[mcx] setup {_mcx_label(inst)}: regs={v[0]} local(spill)={v[1]} B static smem={v[2]} B dyn "
+                      f"smem={v[3]} B, {v[4]} CTAs/SM, cudaOccupancyMaxActiveClusters={v[5]} (grid "
+                      f"{MCX_N[spec[0]] // spec[1]})", flush=True)
+            except Exception as e:
+                occ_txt.append(f"i{inst} setup {type(e).__name__}")
+                print(f"[mcx] setup {_mcx_label(inst)} raised {type(e).__name__}: {str(e)[-300:]}", flush=True)
+        for case in MCX_CASES:
+            tc = time.perf_counter()
+            try:
+                res[case[0]] = _mcx_case(state, case, info, err)
+            except Exception as e:
+                res[case[0]] = {"name": case[0], "ok": False, "why": f"raised {type(e).__name__}: {str(e)[-300:]}"}
+            err.zero_()
+            print(f"[prepare-time] mcx case {case[0]}: {time.perf_counter() - tc:.2f}s", flush=True)
+    except Exception as e:
+        print(f"[mcx] diag raised {type(e).__name__}: {str(e)[-300:]}", flush=True)
+    finally:
+        err = None
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+    p8, p16, q8 = (res.get(c[0]) or {"name": c[0], "ok": False, "why": "not run"} for c in MCX_CASES)
+    _decision("[mcx] VERDICT occupancy (cluster 4; MaxActiveClusters, CTAs/SM, regs, spill B, dyn smem; need 32 "
+              "pooler, 36 qkv): " + " | ".join(occ_txt))
+    for r in (p8, p16, q8):
+        _decision(_mcx_case_txt(r))
+    if p8["ok"] and "ref1" in p8["arms"]:
+        _decision("[mcx] VERDICT ref pooler m=1 kernel_fn (master's b12 cell): " + ", ".join(
+            f"r{i + 1} {s['ref1']['net']:.2f}/{s['ref1']['iqr']:.2f} us" for i, s in enumerate(p8["rounds"])))
+    _decision("[mcx] VERDICT attribution, multicast (fewer L2 reads and 4x fewer TMA issues per CTA) vs per-CTA "
+              "boxes: " + "; ".join(f"{r['name']} mc/uc " + "/".join(f"{v:.3f}" for v in r["mc_uc"])
+                                     for r in (p8, p16, q8) if r["ok"]))
+
+    def bt(r, tag):
+        return f"{tag}={r['best']:.3f} ({r['arm']})" if r["ok"] else f"{tag}=INVALID"
+
+    if not (p8["ok"] and p16["ok"]):
+        verdict = "INVALID: fix and rerun the diag once; no claim"
+    elif p8["best"] >= MCX_REFUTE:
+        verdict = (f"REFUTE (b8 {p8['best']:.3f} >= {MCX_REFUTE}: neither tensor-map arm beats the incumbent; "
+                   f"b12x stays closed)")
+    elif p8["best"] <= MCX_LEAD_B8 and p16["best"] <= MCX_LEAD_B16:
+        add_q = q8["ok"] and q8["best"] <= MCX_LEAD_QKV
+        verdict = (f"LEAD (b8 <= {MCX_LEAD_B8}, b16 <= {MCX_LEAD_B16}; arms pooler m8 {p8['arm']}, m16 {p16['arm']}; "
+                   + (f"+ qkv m8 {q8['arm']} (bq <= {MCX_LEAD_QKV})" if add_q else f"qkv m8 not added (bq > "
+                      f"{MCX_LEAD_QKV} or INVALID)") + ")")
+    else:
+        verdict = (f"SHELF (b8 {p8['best']:.3f}: LEAD needs b8 <= {MCX_LEAD_B8} and b16 <= {MCX_LEAD_B16}, REFUTE "
+                   f"b8 >= {MCX_REFUTE})")
+    _decision(f"[mcx] VERDICT {bt(p8, 'pooler m8 b8')} | {bt(p16, 'pooler m16 b16')} | {bt(q8, 'qkv m8 bq')} -> "
+              f"{verdict}; diag {time.perf_counter() - t1:.1f}s")
+
