+// Instance ids: MCX_INST in Python.
+using Mc0 = McInst<32, 8192, 6, 2, 8, 8, true>;     // pooler m=8,  2 CTAs/SM, multicast x
+using Mc1 = McInst<32, 8192, 6, 2, 8, 8, false>;    // pooler m=8,  2 CTAs/SM, per-CTA boxes
+using Mc2 = McInst<32, 8192, 8, 1, 8, 8, true>;     // pooler m=8,  1 CTA/SM (the spec's S=8)
+using Mc3 = McInst<32, 8192, 8, 1, 8, 8, false>;
+using Mc4 = McInst<32, 8192, 4, 2, 8, 16, true>;    // pooler m=16, 2 CTAs/SM
+using Mc5 = McInst<32, 8192, 4, 2, 8, 16, false>;
+using Mc6 = McInst<32, 8192, 8, 1, 8, 16, true>;    // pooler m=16, 1 CTA/SM (the spec's S=8)
+using Mc7 = McInst<32, 8192, 8, 1, 8, 16, false>;
+using Mc8 = McInst<16, 8192, 4, 2, 4, 8, true>;     // qkv_gate m=8, 2 CTAs/SM
+using Mc9 = McInst<16, 8192, 4, 2, 4, 8, false>;
+using Br10 = BrInst<32, 8192, 8, 1, 8, 8>;          // bridge: a7da6fa9 b12x pooler m=8 (inst 6 there)
+
+void mcx_check(const torch::Tensor& wc, const torch::Tensor& esc, const torch::Tensor& x, const torch::Tensor& out,
+               const torch::Tensor& err) {
+  TORCH_CHECK(wc.is_cuda() && esc.is_cuda() && x.is_cuda() && out.is_cuda() && err.is_cuda(), "mcx: cuda tensors");
+  TORCH_CHECK(wc.scalar_type() == at::kByte && esc.scalar_type() == at::kByte && x.scalar_type() == at::kBFloat16 &&
+              out.scalar_type() == at::kBFloat16 && err.scalar_type() == at::kInt, "mcx: dtypes");
+  TORCH_CHECK(wc.is_contiguous() && esc.is_contiguous() && x.is_contiguous() && out.is_contiguous(), "mcx: contiguity");
+  TORCH_CHECK(x.dim() == 2 && out.dim() == 2 && err.numel() >= 1, "mcx: dims / error word");
+  TORCH_CHECK(wc.get_device() == x.get_device() && esc.get_device() == x.get_device() &&
+              out.get_device() == x.get_device() && err.get_device() == x.get_device(), "mcx: one device");
+  TORCH_CHECK(reinterpret_cast<uintptr_t>(wc.data_ptr()) % 16 == 0 && reinterpret_cast<uintptr_t>(esc.data_ptr()) % 16 == 0 &&
+              reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0, "mcx: 16 B alignment");
+}
