+
+def _mcx_build():
+    """Compile the diag module once per process, at import, right after _b12_build (BULK_NVCC_FLAGS, 9.0a only,
+    TORCH_CUDA_ARCH_LIST restored after). Returns (ext, why): ext None on any failure (the diag then prints VERDICT
+    n/a: build and nothing else changes); never raises."""
+    t0 = time.perf_counter()
+    prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+    os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+    try:
+        from torch.utils import cpp_extension
+        print(f"[mcx] building {MCX_EXT_NAME}: extra_cuda_cflags {BULK_NVCC_FLAGS}", flush=True)
+        ext = cpp_extension.load_inline(
+            name=MCX_EXT_NAME, cpp_sources=_MCX_CPP, cuda_sources=_MCX_CUDA,
+            functions=["mcx_run", "mcx_setup"],
+            extra_cuda_cflags=list(BULK_NVCC_FLAGS), verbose=False)
+    except Exception as e:
+        tail = "\n".join(str(e).splitlines()[-60:])
+        print(f"[mcx] build FAILED after {time.perf_counter() - t0:.1f}s ({type(e).__name__}); build log "
+              f"tail:\n{tail}\n[mcx] diag off; kernel_fn and routing unchanged", flush=True)
+        return None, f"{type(e).__name__} after {time.perf_counter() - t0:.1f}s: {str(e)[-200:]}"
+    finally:
+        if prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = prev
+    print(f"[build-time] mcx load_inline compiled in {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext, ""
+
+
+_MCX_EXT, _MCX_BUILD_WHY = _mcx_build() if torch.cuda.is_available() else (None, "no CUDA device")
+
+
+def _mcx_label(inst: int) -> str:
+    layer, rows, nt, s, minb, cw, mc = MCX_INST[inst]
+    kind = "bridge b12x" if mc is None else ("mc" if mc else "uc")
+    return f"i{inst} {layer} R{rows} NT{nt} S{s} MINB{minb} CW{cw} {kind}"
+
+
+def _mcx_codes(state: dict, layer: str, rows: int):
+    """The 12-bit codes at R = rows: state's own (checked bit-exact by _b12_prepare) when its instance has that R,
+    else _b12_encode_checked (host + device round trips bit-exact, through a master instance of that R). prepare()-
+    only; the returned tensors are dropped with the case."""
+    inst = state.get("b12_inst_" + layer)
+    if inst is not None and B12_INST_R.get(inst) == rows and ("b12_wc_" + layer) in state:
+        return (state["b12_wc_" + layer], state["b12_esc_" + layer], state["b12_base_" + layer],
+                f"state's (b12 inst {inst})")
+    if _B12_EXT is None:
+        raise RuntimeError("no b12 module for the device round trip")
+    wc, esc, base = _b12_encode_checked(layer, state[layer], rows, MCX_HOME_INST[rows], verbose=False)
+    return wc, esc, base, "re-encoded (host + device round trips bit-exact)"
+
+
+def _mcx_time(arms: dict, dev) -> list:
+    """_cell_gate's replay loop without a routing flag (prepare()-only): every arm graph-captured (_cell_capture),
+    the CELL_FLUSH_BYTES READ flush (flush_i32.sum(), as the judge reads) before every replay, CELL_GATE_REPS reps in
+    rotating interleaved order, an empty-graph baseline subtracted; MCX_ROUNDS rounds. Returns one dict per round:
+    arm -> {net, iqr, med} (us), plus "_base"."""
+    flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    flush_i32 = flush.view(torch.int32)
+    scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def replay_us(gr) -> float:
+        flush_i32.sum()
+        ev[0].record()
+        gr.replay()
+        ev[1].record()
+        ev[1].synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1e3
+
+    graphs = {}
+    rounds = []
+    try:
+        g_base = _cell_capture(lambda: scratch.add_(1.0))
+        for name, fn in arms.items():
+            graphs[name] = _cell_capture(fn)
+        names = list(arms)
+        for _ in range(MCX_ROUNDS):
+            base = _ouns_median([replay_us(g_base) for _ in range(CELL_GATE_REPS)])
+            times = {name: [] for name in names}
+            for rep in range(CELL_GATE_REPS):
+                for name in names[rep % len(names):] + names[:rep % len(names)]:
+                    times[name].append(replay_us(graphs[name]))
+            st = {"_base": base}
+            for name, v in times.items():
+                sv = sorted(v)
+                med = _ouns_median(v)
+                st[name] = {"net": max(med - base, 0.25), "iqr": sv[(3 * len(sv)) // 4] - sv[len(sv) // 4],
+                            "med": med}
+            rounds.append(st)
+    finally:
+        graphs.clear()
+        g_base = None
+        torch.cuda.synchronize()
+    return rounds
+
+
+def _mcx_case(state: dict, case, info: dict, err: torch.Tensor) -> dict:
+    """One diag case (prepare()-only). Picks the first (mc, uc) instance pair whose MaxActiveClusters both reach the
+    case's cluster count, takes the codes (_mcx_codes), runs _cell_check on every arm, requires mc == uc bit-identical
+    (the bridge's identity is printed only), then times inc = kernel_fn on the final state against the arms
+    (_mcx_time). Returns a dict: ok, why, pair, codes, arms, rounds, per-round ratios, best (worst-round min of
+    mc/inc and uc/inc) and the winning arm."""
+    name, layer, n, k, m, pairs, bridge, with_ref = case
+    r = {"name": name, "ok": False, "why": "", "rounds": [], "pair": None}
+    rows = MCX_INST[pairs[0][0]][1]
+    need = n // rows // MCX_CL
+    for a, b in pairs:
+        if a in info and b in info and min(info[a][5], info[b][5]) >= need:
+            r["pair"] = (a, b)
+            break
+    if r["pair"] is None:
+        r["why"] = ("skipped: MaxActiveClusters " + ", ".join(
+            f"i{a}/i{b} {min(info[a][5], info[b][5]) if a in info and b in info else 'n/a'}" for a, b in pairs)
+            + f" < {need} needed")
+        return r
+    w = state[layer]
+    wc, esc, base, r["codes"] = _mcx_codes(state, layer, rows)
+
+    def runner(inst):
+        def run(xx):
+            out = torch.empty((xx.shape[0], n), dtype=torch.bfloat16, device=xx.device)
+            _MCX_EXT.mcx_run(wc, esc, xx, out, err, inst, base)
+            return out
+        return run
+
+    fns = {"mc": runner(r["pair"][0]), "uc": runner(r["pair"][1])}
+    if bridge is not None:
+        if bridge in info and info[bridge][4] >= 1:
+            fns["br"] = runner(bridge)
+        else:
+            print(f"[mcx] {name}: bridge {_mcx_label(bridge)} not run (setup {info.get(bridge)})", flush=True)
+    for arm in list(fns):
+        inst = r["pair"][0] if arm == "mc" else (r["pair"][1] if arm == "uc" else bridge)
+        bad = _cell_check(f"mcx {name} {arm} {_mcx_label(inst)}", fns[arm], w, m, n, k, err=err)
+        if bad and arm == "br":
+            print(f"[mcx] {name}: bridge check failed ({bad}); bridge arm dropped", flush=True)
+            del fns["br"]
+        elif bad:
+            r["why"] = f"{arm} _cell_check: {bad}"
+            return r
+    g = torch.Generator(device=w.device)
+    g.manual_seed(5309 + m)
+    xx = torch.randn((m, k), device=w.device, dtype=torch.float32, generator=g).to(torch.bfloat16)
+    outs = {arm: fn(xx) for arm, fn in fns.items()}
+    torch.cuda.synchronize()
+    code = int(err.item())
+    if code:
+        r["why"] = f"error word {code} in the bit-identity launches"
+        return r
+    if not torch.equal(outs["mc"], outs["uc"]):
+        r["why"] = "mc and uc outputs are not bit-identical"
+        return r
+    if "br" in outs:
+        r["br_same"] = bool(torch.equal(outs["br"], outs["mc"]))
+    outs.clear()
+    x = torch.randn((m, k), device=w.device, dtype=torch.float32).to(torch.bfloat16)
+    data = {"x": x, "config": {"m": m, "n": n, "k": k, "layer": layer}}
+    arms = {"inc": lambda: kernel_fn(data, state)}
+    for arm, fn in fns.items():
+        arms[arm] = (lambda f=fn: f(x))
+    if with_ref:   # master's own m=1 cell of this layer (kernel_fn, b12 when routed)
+        x1 = torch.randn((1, k), device=w.device, dtype=torch.float32).to(torch.bfloat16)
+        data1 = {"x": x1, "config": {"m": 1, "n": n, "k": k, "layer": layer}}
+        arms["ref1"] = lambda: kernel_fn(data1, state)
+    r["arms"] = list(arms)
+    r["rounds"] = _mcx_time(arms, w.device)
+    arms.clear()
+    fns.clear()
+    code = int(err.item())
+    if code:
+        r["why"] = f"error word {code} after the timing rounds"
+        return r
+    rr = r["rounds"]
+    for arm in ("mc", "uc", "br"):
+        if arm in r["arms"]:
+            r[arm + "_inc"] = [s[arm]["net"] / s["inc"]["net"] for s in rr]
+    r["mc_uc"] = [s["mc"]["net"] / s["uc"]["net"] for s in rr]
+    wm, wu = max(r["mc_inc"]), max(r["uc_inc"])
+    r["best"], r["arm"] = (wm, "mc") if wm <= wu else (wu, "uc")
+    r["ok"] = True
+    return r
+
+
+def _mcx_case_txt(r: dict) -> str:
+    """One VERDICT detail line per case: both rounds' net us / IQR per arm and the ratios."""
+    if not r["ok"]:
+        return f"[mcx] VERDICT case {r['name']}: INVALID ({r['why']})"
+    a, b = r["pair"]
+    parts = []
+    for i, s in enumerate(r["rounds"]):
+        arms = " ".join(f"{arm} {s[arm]['net']:.2f}/{s[arm]['iqr']:.2f}" for arm in r["arms"])
+        rat = f"mc/inc {r['mc_inc'][i]:.3f} uc/inc {r['uc_inc'][i]:.3f} mc/uc {r['mc_uc'][i]:.3f}"
+        if "br_inc" in r:
+            rat += f" br/inc {r['br_inc'][i]:.3f}"
+        parts.append(f"r{i + 1} {arms} (net us/IQR, base {s['_base']:.2f}) {rat}")
+    extra = f"; bridge == mc bits: {r['br_same']}" if "br_same" in r else ""
+    return (f"[mcx] VERDICT case {r['name']} [i{a}/i{b}: R{MCX_INST[a][1]} NT{MCX_INST[a][2]} S{MCX_INST[a][3]} "
+            f"MINB{MCX_INST[a][4]} CW{MCX_INST[a][5]}; codes {r['codes']}]: " + " | ".join(parts)
+            + f"; best {r['arm']}/inc {r['best']:.3f} (worst round){extra}")
+
