+std::vector<int64_t> mcx_setup(int64_t inst, int64_t n) {
+  switch (inst) {
+    case 0: return Mc0::setup(n);
+    case 1: return Mc1::setup(n);
+    case 2: return Mc2::setup(n);
+    case 3: return Mc3::setup(n);
+    case 4: return Mc4::setup(n);
+    case 5: return Mc5::setup(n);
+    case 6: return Mc6::setup(n);
+    case 7: return Mc7::setup(n);
+    case 8: return Mc8::setup(n);
+    case 9: return Mc9::setup(n);
+    case 10: return Br10::setup(n);
+    default: TORCH_CHECK(false, "mcx_setup: unknown instance");
