+}  // namespace
+
+void mcx_run(torch::Tensor wc, torch::Tensor esc, torch::Tensor x, torch::Tensor out, torch::Tensor err,
+             int64_t inst, int64_t base) {
+  mcx_check(wc, esc, x, out, err);
+  TORCH_CHECK(base >= 1 && base <= 120, "mcx_run: base");
+  const uint32_t b = (uint32_t)base;
+  switch (inst) {
+    case 0: Mc0::launch(wc, esc, x, out, err, b); break;
+    case 1: Mc1::launch(wc, esc, x, out, err, b); break;
+    case 2: Mc2::launch(wc, esc, x, out, err, b); break;
+    case 3: Mc3::launch(wc, esc, x, out, err, b); break;
+    case 4: Mc4::launch(wc, esc, x, out, err, b); break;
+    case 5: Mc5::launch(wc, esc, x, out, err, b); break;
+    case 6: Mc6::launch(wc, esc, x, out, err, b); break;
+    case 7: Mc7::launch(wc, esc, x, out, err, b); break;
+    case 8: Mc8::launch(wc, esc, x, out, err, b); break;
+    case 9: Mc9::launch(wc, esc, x, out, err, b); break;
+    case 10: Br10::launch(wc, esc, x, out, err, b); break;
+    default: TORCH_CHECK(false, "mcx_run: unknown instance");
+  }
+}
