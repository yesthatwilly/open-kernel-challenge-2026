+def _cell_gate_rounds(tag: str, layer: str, m: int, n: int, k: int, flag: str, state: dict,
+                      rounds: int = 2):
+    """Hardened model selector: _cell_gate's measurement (kernel_fn captured with the cell's flag on
+    and off on shallow copies of state, one synthetic x, CELL_FLUSH_BYTES write before every replay,
+    CELL_GATE_REPS interleaved replays with the order swapped every rep, medians minus an empty-graph
+    baseline) repeated for `rounds` independent rounds on the same two graphs (each round re-times
+    its own baseline and starts on the opposite order). Returns a list, one dict per round:
+    cand / master net median us, cand_iqr / master_iqr us, ratio = master / cand. prepare()-only."""
+    dev = state["router"].device
+    st_c = dict(state)
+    st_c[flag] = True
+    st_i = dict(state)
+    st_i[flag] = False
+    x = torch.randn((m, k), device=dev, dtype=torch.float32).to(torch.bfloat16)
+    data = {"x": x, "config": {"m": m, "n": n, "k": k, "layer": layer}}
+    flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def replay_us(gr) -> float:
+        flush.zero_()
+        ev[0].record()
+        gr.replay()
+        ev[1].record()
+        ev[1].synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1e3
+
+    g_base = _cell_capture(lambda: scratch.add_(1.0))
+    graphs = {"cand": _cell_capture(lambda: kernel_fn(data, st_c)),
+              "master": _cell_capture(lambda: kernel_fn(data, st_i))}
+    out = []
+    for rnd in range(rounds):
+        base = _ouns_median([replay_us(g_base) for _ in range(CELL_GATE_REPS)])
+        times = {"cand": [], "master": []}
+        for rep in range(CELL_GATE_REPS):
+            order = ("cand", "master") if (rep + rnd) % 2 == 0 else ("master", "cand")
+            for name in order:
+                times[name].append(replay_us(graphs[name]))
+        med = {name: _ouns_median(v) for name, v in times.items()}
+        adj = {name: max(v - base, 0.25) for name, v in med.items()}
+        res = {"cand": adj["cand"], "master": adj["master"], "cand_iqr": _iqr_us(times["cand"]),
+               "master_iqr": _iqr_us(times["master"]), "ratio": adj["master"] / adj["cand"]}
+        out.append(res)
+        print(f"[cell] gate {tag} {layer} m={m} round {rnd + 1}/{rounds} (graph replay, "
+              f"{CELL_FLUSH_BYTES >> 20} MB flush, {CELL_GATE_REPS} reps, interleaved): cand median "
+              f"{med['cand']:.2f} us (IQR {res['cand_iqr']:.2f}), master median {med['master']:.2f} us "
+              f"(IQR {res['master_iqr']:.2f}), empty-graph baseline {base:.2f} us -> net "
+              f"{adj['cand']:.2f} vs {adj['master']:.2f} us, master/cand {res['ratio']:.3f}", flush=True)
+    del graphs, g_base, flush
+    torch.cuda.synchronize()
+    return out
+
