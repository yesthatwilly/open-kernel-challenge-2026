+_SWCL_HEAD = r"""
+#include <torch/extension.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <c10/cuda/CUDAException.h>
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+constexpr int THREADS = 384;
+constexpr int BK = 64;                 // K per pipeline stage: one 128 B swizzled row
+constexpr int TILE_ROWS = 128;         // weight rows per CTA
+constexpr int A_BYTES = TILE_ROWS * 128;
+constexpr int TP = 132;                // padded fp32 per-token row of the epilogue tile (floats)
+
+template <int T>
+struct Cfg {
+  static constexpr int STAGES = (T == 128) ? 6 : 4;
+  static constexpr int B_BYTES = T * 128;
+  static constexpr int STAGE_BYTES = A_BYTES + B_BYTES;
+  static constexpr int RING = STAGES * STAGE_BYTES;
+  static constexpr int EPI = T * TP * 4;
+  static constexpr int SMEM = 1024 + RING;   // + 1 KB so the ring base can be aligned to 1024
+  static_assert(STAGE_BYTES % 1024 == 0 && A_BYTES % 1024 == 0, "swizzle alignment");
+  static_assert(EPI <= RING, "the fp32 epilogue tile aliases the stage ring");
+  static_assert(SMEM + 1024 <= 227 * 1024, "shared memory budget");
+};
+
+__device__ __forceinline__ uint32_t smem_u32(const void* p) {
+  return static_cast<uint32_t>(__cvta_generic_to_shared(p));
+}
+__device__ __forceinline__ void mbar_init(uint32_t a, uint32_t count) {
+  asm volatile("mbarrier.init.shared::cta.b64 [%0], %1;\n" :: "r"(a), "r"(count) : "memory");
+}
+__device__ __forceinline__ void fence_barrier_init() {
+  asm volatile("fence.mbarrier_init.release.cluster;\n" ::: "memory");
+}
+__device__ __forceinline__ void mbar_expect_tx(uint32_t a, uint32_t tx) {
+  asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;\n" :: "r"(a), "r"(tx) : "memory");
+}
+// Arrive on the barrier at the same CTA-relative address in cluster CTA `rank` (own rank allowed).
+__device__ __forceinline__ void mbar_arrive_rank(uint32_t a, uint32_t rank) {
+  asm volatile("{\n\t.reg .b32 ra;\n\t"
+               "mapa.shared::cluster.u32 ra, %0, %1;\n\t"
+               "mbarrier.arrive.release.cluster.shared::cluster.b64 _, [ra];\n\t}\n"
+               :: "r"(a), "r"(rank) : "memory");
+}
+__device__ __forceinline__ bool mbar_try(uint32_t a, uint32_t parity) {
+  uint32_t ok;
+  asm volatile("{\n\t.reg .pred P;\n\t"
+               "mbarrier.try_wait.parity.shared::cta.b64 P, [%1], %2;\n\t"
+               "selp.u32 %0, 1, 0, P;\n\t}\n"
+               : "=r"(ok) : "r"(a), "r"(parity) : "memory");
+  return ok != 0;
+}
+// Bounded wait: after ~2^26 cycles without the phase, record error word 1 and stop waiting.
+__device__ __forceinline__ void mbar_wait(uint32_t a, uint32_t parity, int* err, bool& dead) {
+  if (dead || mbar_try(a, parity)) return;
+  const long long t0 = clock64();
+  while (!mbar_try(a, parity)) {
+    if (clock64() - t0 > (1ll << 26)) {
+      dead = true;
+      atomicExch(err, 1);
+      return;
+    }
+  }
+}
+__device__ __forceinline__ void tma_2d(uint32_t dst, uint64_t map, int c0, int c1, uint32_t bar) {
+  asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes [%0], [%1, {%3, %4}], [%2];\n"
+               :: "r"(dst), "l"(map), "r"(bar), "r"(c0), "r"(c1) : "memory");
+}
+__device__ __forceinline__ void tma_2d_mc(uint32_t dst, uint64_t map, int c0, int c1, uint32_t bar,
+                                          unsigned short mask) {
+  asm volatile("cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes.multicast::cluster [%0], [%1, {%3, %4}], [%2], %5;\n"
+               :: "r"(dst), "l"(map), "r"(bar), "r"(c0), "r"(c1), "h"(mask) : "memory");
+}
+__device__ __forceinline__ void wgmma_fence() {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  asm volatile("wgmma.fence.sync.aligned;\n" ::: "memory");
+#endif
+}
+__device__ __forceinline__ void wgmma_commit() {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  asm volatile("wgmma.commit_group.sync.aligned;\n" ::: "memory");
+#endif
+}
+template <int N>
+__device__ __forceinline__ void wgmma_wait() {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  asm volatile("wgmma.wait_group.sync.aligned %0;\n" :: "n"(N) : "memory");
+#endif
+}
+template <int NA>
+__device__ __forceinline__ void fence_acc(float (&d)[NA]) {
+#pragma unroll
+  for (int i = 0; i < NA; ++i) asm volatile("" : "+f"(d[i]) :: "memory");
+}
+__device__ __forceinline__ void named_bar(int id, int count) {
+  asm volatile("bar.sync %0, %1;\n" :: "r"(id), "r"(count) : "memory");
+}
+__device__ __forceinline__ void cluster_sync() {
+  asm volatile("barrier.cluster.arrive.release.aligned;\n" ::: "memory");
+  asm volatile("barrier.cluster.wait.acquire.aligned;\n" ::: "memory");
+}
+__device__ __forceinline__ uint32_t map_rank(uint32_t addr, uint32_t rank) {
+  uint32_t r;
+  asm volatile("mapa.shared::cluster.u32 %0, %1, %2;\n" : "=r"(r) : "r"(addr), "r"(rank));
+  return r;
+}
+__device__ __forceinline__ float4 ld_cluster_v4(uint32_t addr) {
+  float4 v;
+  asm volatile("ld.shared::cluster.v4.f32 {%0, %1, %2, %3}, [%4];\n"
+               : "=f"(v.x), "=f"(v.y), "=f"(v.z), "=f"(v.w) : "r"(addr) : "memory");
+  return v;
+}
+// K-major SWIZZLE_128B shared-memory matrix descriptor (same form the sm_90a moe build ran):
+// start address >> 4 (bits 0-13), LBO 1 (unused for swizzled K-major), SBO 1024 B between 8-row
+// groups (bits 32-45), layout type 1 = 128B swizzle (bits 62-63). Every tile base is 1024-aligned
+// and the k16 advance of +32 B stays inside the first 128 B.
+__device__ __forceinline__ uint64_t make_desc(uint32_t saddr) {
+  return static_cast<uint64_t>((saddr & 0x3FFFFu) >> 4) | (static_cast<uint64_t>(1) << 16) |
+         (static_cast<uint64_t>(1024 >> 4) << 32) | (static_cast<uint64_t>(1) << 62);
+}
+
+template <int N>
+struct Wg;
+"""
+
+_SWCL_BODY = r"""
+template <int T, bool MC>
+__global__ void __launch_bounds__(THREADS, 1)
+swcl_kernel(const __grid_constant__ CUtensorMap mapW, const __grid_constant__ CUtensorMap mapX,
+            __nv_bfloat16* __restrict__ out, int m, int n, int nkb, int S, int mode,
+            int* __restrict__ err) {
+#if defined(__CUDA_ARCH_FEAT_SM90_ALL)
+  using C = Cfg<T>;
+  constexpr int CX = MC ? 2 : 1;
+  constexpr int STAGES = C::STAGES;
+  extern __shared__ __align__(1024) uint8_t smem_raw[];
+  __shared__ __align__(8) uint64_t bars[2 * STAGES];
+  const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  const uint32_t raw_u = smem_u32(smem_raw);
+  const uint32_t base_u = (raw_u + 1023u) & ~1023u;
+  uint8_t* ring = smem_raw + (base_u - raw_u);
+  const int cx = MC ? static_cast<int>(blockIdx.x & 1) : 0;   // position in the multicast pair
+  const int cy = static_cast<int>(blockIdx.y);                 // K-split index
+  const int tile = static_cast<int>(blockIdx.x);               // 128-row weight tile
+  const uint32_t full0 = smem_u32(&bars[0]);
+  const uint32_t empty0 = smem_u32(&bars[STAGES]);
+  const int kb0 = static_cast<int>((static_cast<long long>(cy) * nkb) / S);
+  const int kb1 = static_cast<int>((static_cast<long long>(cy + 1) * nkb) / S);
+  const int nk = kb1 - kb0;
+
+  if (tid == 0) {
+    uint32_t hw;
+    asm volatile("mov.u32 %0, %%cluster_ctarank;\n" : "=r"(hw));
+    if (static_cast<int>(hw) != cx + CX * cy) atomicExch(err, 3);
+#pragma unroll
+    for (int s = 0; s < STAGES; ++s) {
+      mbar_init(full0 + 8 * s, 1);
+      mbar_init(empty0 + 8 * s, 8 * CX);   // 8 consumer warps of each of the CX CTAs
+    }
+    fence_barrier_init();
+  }
+  __syncwarp();     // warp 0 reconverged before the .aligned cluster barrier
+  cluster_sync();   // barriers of every CTA are initialised before any remote arrive / multicast
+
+  if (warp < 4) {
+    // ---------------- producer warpgroup ----------------
+    asm volatile("setmaxnreg.dec.sync.aligned.u32 40;\n" ::: "memory");
+    if (tid == 0) {
+      bool dead = false;
+      const uint64_t mw = reinterpret_cast<uint64_t>(&mapW);
+      const uint64_t mx = reinterpret_cast<uint64_t>(&mapX);
+      const unsigned short mask = MC ? static_cast<unsigned short>(3u << (2 * cy)) : 0;
+      for (int i = 0; i < nk; ++i) {
+        const int s = i % STAGES;
+        const uint32_t ph = (i / STAGES) & 1;
+        mbar_wait(empty0 + 8 * s, ph ^ 1, err, dead);   // both CTAs' consumers released stage s
+        const uint32_t fb = full0 + 8 * s;
+        const uint32_t st = base_u + s * C::STAGE_BYTES;
+        mbar_expect_tx(fb, A_BYTES + C::B_BYTES);
+        const int kc = (kb0 + i) * BK;
+        tma_2d(st, mw, kc, tile * TILE_ROWS, fb);
+        if (MC) tma_2d_mc(st + A_BYTES + cx * (T / 2) * 128, mx, kc, cx * (T / 2), fb, mask);
+        else tma_2d(st + A_BYTES, mx, kc, 0, fb);
+      }
+    }
+    __syncwarp();
+    cluster_sync();   // every CTA's epilogue tile is complete
+    cluster_sync();   // every peer is done reading this CTA's smem
+  } else {
+    // ---------------- consumer warpgroups ----------------
+    asm volatile("setmaxnreg.inc.sync.aligned.u32 232;\n" ::: "memory");
+    const int cw = warp - 4;       // 0..7
+    const int wg = cw >> 2;        // which 64 weight rows
+    const int wl = cw & 3;         // warp within the warpgroup (16 rows each)
+    float acc[T / 2];
+#pragma unroll
+    for (int i = 0; i < T / 2; ++i) acc[i] = 0.f;
+    bool dead = false;
+    int prev = -1;
+    for (int i = 0; i < nk; ++i) {
+      const int s = i % STAGES;
+      const uint32_t ph = (i / STAGES) & 1;
+      mbar_wait(full0 + 8 * s, ph, err, dead);
+      const uint32_t st = base_u + s * C::STAGE_BYTES;
+      fence_acc<T / 2>(acc);
+      wgmma_fence();
+#pragma unroll
+      for (int k = 0; k < 4; ++k)
+        Wg<T>::mma(acc, make_desc(st + wg * 8192 + k * 32), make_desc(st + A_BYTES + k * 32));
+      wgmma_commit();
+      wgmma_wait<1>();   // the previous block's group has retired: release its stage
+      fence_acc<T / 2>(acc);
+      if (prev >= 0) {
+        __syncwarp();
+        if (lane == 0) {
+#pragma unroll
+          for (int q = 0; q < CX; ++q) mbar_arrive_rank(empty0 + 8 * prev, q + CX * cy);
+        }
+      }
+      prev = s;
+    }
+    wgmma_wait<0>();
+    fence_acc<T / 2>(acc);
+    if (prev >= 0) {
+      __syncwarp();
+      if (lane == 0) {
+#pragma unroll
+        for (int q = 0; q < CX; ++q) mbar_arrive_rank(empty0 + 8 * prev, q + CX * cy);
+      }
+    }
+    named_bar(1, 256);   // both consumer warpgroups are done reading the stage ring
+
+    // fp32 accumulator -> this CTA's smem tile [token][weight row], token stride TP floats
+    float* tile_f = reinterpret_cast<float*>(ring);
+    const int wrow = wg * 64 + wl * 16 + (lane >> 2);
+    const int tq = 2 * (lane & 3);
+#pragma unroll
+    for (int j = 0; j < T / 8; ++j) {
+      const int tok = 8 * j + tq;
+      tile_f[tok * TP + wrow] = acc[4 * j];
+      tile_f[(tok + 1) * TP + wrow] = acc[4 * j + 1];
+      tile_f[tok * TP + wrow + 8] = acc[4 * j + 2];
+      tile_f[(tok + 1) * TP + wrow + 8] = acc[4 * j + 3];
+    }
+    __syncwarp();
+    cluster_sync();   // every CTA's tile is complete and visible cluster-wide (mode 0 keeps it too)
+
+    const int ct = tid - 128;        // 0..255
+    const int g0 = (cy * 32) / S, g1 = ((cy + 1) * 32) / S, ng = g1 - g0;   // 4-row groups
+    const int items = ng * m;
+    for (int it = ct; it < items; it += 256) {
+      const int g = g0 + it % ng, tok = it / ng;
+      const uint32_t loc = base_u + static_cast<uint32_t>((tok * TP + 4 * g) * 4);
+      float4 sum;
+      if (mode != 0) {
+        float4 v[8];
+#pragma unroll
+        for (int s = 0; s < 8; ++s)
+          if (s < S) v[s] = ld_cluster_v4(map_rank(loc, cx + CX * s));
+        sum = v[0];
+#pragma unroll
+        for (int s = 1; s < 8; ++s)
+          if (s < S) { sum.x += v[s].x; sum.y += v[s].y; sum.z += v[s].z; sum.w += v[s].w; }
+      } else {
+        sum = *reinterpret_cast<const float4*>(tile_f + tok * TP + 4 * g);
+      }
+      const __nv_bfloat162 p0 = __floats2bfloat162_rn(sum.x, sum.y);
+      const __nv_bfloat162 p1 = __floats2bfloat162_rn(sum.z, sum.w);
+      uint2 pk;
+      pk.x = *reinterpret_cast<const uint32_t*>(&p0);
+      pk.y = *reinterpret_cast<const uint32_t*>(&p1);
+      *reinterpret_cast<uint2*>(out + static_cast<size_t>(tok) * n + tile * TILE_ROWS + 4 * g) = pk;
+    }
+    __syncwarp();
+    cluster_sync();   // peers are done reading this CTA's smem before it exits
+  }
+#else
+  // Not the sm_90a image: no wgmma here. Flag it (error word 2) and do nothing else.
+  if (threadIdx.x == 0) atomicExch(err, 2);
+#endif
+}
+
+typedef CUresult (*EncodeTiledFn)(CUtensorMap*, CUtensorMapDataType, cuuint32_t, void*, const cuuint64_t*,
+                                  const cuuint64_t*, const cuuint32_t*, const cuuint32_t*, CUtensorMapInterleave,
+                                  CUtensorMapSwizzle, CUtensorMapL2promotion, CUtensorMapFloatOOBfill);
+
+EncodeTiledFn get_encode() {
+  static EncodeTiledFn cached = nullptr;
+  if (cached) return cached;
+  void* fn = nullptr;
+  cudaDriverEntryPointQueryResult q = cudaDriverEntryPointSymbolNotFound;
+#if CUDART_VERSION >= 12050
+  const cudaError_t e = cudaGetDriverEntryPointByVersion("cuTensorMapEncodeTiled", &fn, 12000, cudaEnableDefault, &q);
+#else
+  const cudaError_t e = cudaGetDriverEntryPoint("cuTensorMapEncodeTiled", &fn, cudaEnableDefault, &q);
+#endif
+  if (e != cudaSuccess || q != cudaDriverEntryPointSuccess || fn == nullptr) {
+    (void)cudaGetLastError();
+    TORCH_CHECK(false, "swcl: cuTensorMapEncodeTiled entry point not found");
+  }
+  cached = reinterpret_cast<EncodeTiledFn>(fn);
+  return cached;
+}
+
+// bf16 [outer, inner] row-major (row pitch row_bytes), box {64 inner, box_outer rows}, 128B swizzle.
+CUtensorMap encode_2d(const void* ptr, uint64_t inner, uint64_t outer, uint64_t row_bytes, uint32_t box_outer) {
+  CUtensorMap map;
+  std::memset(&map, 0, sizeof(map));
+  const cuuint64_t dims[2] = {inner, outer};
+  const cuuint64_t strides[1] = {row_bytes};
+  const cuuint32_t box[2] = {64, box_outer};
+  const cuuint32_t es[2] = {1, 1};
+  const CUresult r = get_encode()(&map, CU_TENSOR_MAP_DATA_TYPE_BFLOAT16, 2, const_cast<void*>(ptr), dims,
+                                  strides, box, es, CU_TENSOR_MAP_INTERLEAVE_NONE, CU_TENSOR_MAP_SWIZZLE_128B,
+                                  CU_TENSOR_MAP_L2_PROMOTION_L2_128B, CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE);
+  TORCH_CHECK(r == CUDA_SUCCESS, "swcl: cuTensorMapEncodeTiled failed, rc ", static_cast<int>(r));
+  return map;
+}
+
+template <int T, bool MC>
+void set_attr() {
+  static bool done = false;
+  if (!done) {
+    C10_CUDA_CHECK(cudaFuncSetAttribute(swcl_kernel<T, MC>, cudaFuncAttributeMaxDynamicSharedMemorySize,
+                                        Cfg<T>::SMEM));
+    C10_CUDA_CHECK(cudaFuncSetAttribute(swcl_kernel<T, MC>, cudaFuncAttributeNonPortableClusterSizeAllowed, 1));
+    done = true;
+  }
+}
+
+template <int T, bool MC>
+void launch(const CUtensorMap& mw, const CUtensorMap& mx, torch::Tensor out, torch::Tensor err, int m, int n,
+            int nkb, int S, int mode) {
+  constexpr int CX = MC ? 2 : 1;
+  set_attr<T, MC>();
+  cudaLaunchConfig_t cfg = {};
+  cfg.gridDim = dim3(n / TILE_ROWS, S, 1);
+  cfg.blockDim = dim3(THREADS);
+  cfg.dynamicSmemBytes = Cfg<T>::SMEM;
+  cfg.stream = at::cuda::getCurrentCUDAStream();
+  cudaLaunchAttribute attr[1];
+  attr[0].id = cudaLaunchAttributeClusterDimension;
+  attr[0].val.clusterDim.x = CX;
+  attr[0].val.clusterDim.y = S;
+  attr[0].val.clusterDim.z = 1;
+  cfg.attrs = attr;
+  cfg.numAttrs = 1;
+  C10_CUDA_CHECK(cudaLaunchKernelEx(&cfg, swcl_kernel<T, MC>, mw, mx,
+                                    reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), m, n, nkb, S, mode,
+                                    err.data_ptr<int>()));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+template <int T, bool MC>
+std::vector<int64_t> info(int S, int tiles) {
+  constexpr int CX = MC ? 2 : 1;
+  set_attr<T, MC>();
+  cudaFuncAttributes fa;
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&fa, swcl_kernel<T, MC>));
+  cudaLaunchConfig_t cfg = {};
+  cfg.gridDim = dim3(tiles, S, 1);
+  cfg.blockDim = dim3(THREADS);
+  cfg.dynamicSmemBytes = Cfg<T>::SMEM;
+  cudaLaunchAttribute attr[1];
+  attr[0].id = cudaLaunchAttributeClusterDimension;
+  attr[0].val.clusterDim.x = CX;
+  attr[0].val.clusterDim.y = S;
+  attr[0].val.clusterDim.z = 1;
+  cfg.attrs = attr;
+  cfg.numAttrs = 1;
+  int ncl = -1;
+  if (tiles % CX != 0 || cudaOccupancyMaxActiveClusters(&ncl, swcl_kernel<T, MC>, &cfg) != cudaSuccess) {
+    (void)cudaGetLastError();
+    ncl = -1;
+  }
+  return {fa.numRegs, static_cast<int64_t>(fa.localSizeBytes), static_cast<int64_t>(fa.sharedSizeBytes),
+          static_cast<int64_t>(Cfg<T>::SMEM), ncl, tiles / CX, fa.binaryVersion};
+}
