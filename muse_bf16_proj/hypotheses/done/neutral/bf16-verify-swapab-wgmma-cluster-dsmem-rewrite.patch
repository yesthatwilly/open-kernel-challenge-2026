+_SWCL_CPP = r"""
+#include <torch/extension.h>
+#include <vector>
+torch::Tensor swcl_make_wmap(torch::Tensor w);
+void swcl_run(torch::Tensor x, torch::Tensor wmap, torch::Tensor out, torch::Tensor err,
+              int64_t T, int64_t mc, int64_t S, int64_t mode);
+std::vector<int64_t> swcl_info(int64_t T, int64_t mc, int64_t S, int64_t tiles);
+"""
