+# --- (8) m = 65..256 qkv_gate / pooler / unpooler: swap-AB wgmma + TMA multicast + cluster DSMEM ----
+# (hypothesis bf16-verify-swapab-wgmma-cluster-dsmem-rewrite, rewrite stage 1)
+#
+# One hand-written CUDA kernel (load_inline at import, sm_90a only). CTA = 3 warpgroups: WG0 is the
+# producer (setmaxnreg.dec 40, one thread issues TMA), WG1-2 are consumers (setmaxnreg.inc 232),
+# each issuing wgmma m64nTk16 bf16 -> fp32 with A = 64 weight rows and B = the T-token x tile, both
+# K-major 128B-swizzled in smem, so a CTA tile is 128 weight rows x T tokens (T = 128 for
+# 65 <= m <= 128, T = 256 for 129 <= m <= 256, tokens >= m zero-filled by TMA). BLOCK_K 64.
+# Grid = (n / 128 weight tiles, S K-splits), cluster (CX, S): CX = 2 pairs adjacent weight tiles
+# that share the SAME x K-block, each CTA TMA-loads half of the x tile and multicasts it to both
+# (weights are unique per CTA, never multicast); CX = 1 is the same kernel without multicast.
+# Multicast protocol: every consumer warp arrives on the EMPTY mbarrier of BOTH CTAs of its pair
+# (mapa + mbarrier.arrive.release.cluster) and each EMPTY barrier counts 8 warps x CX arrivals, so
+# a producer reuses a stage only after both CTAs' consumers released it; the FULL barrier of each
+# CTA expects its own 16 KB of weights plus the T x 128 B x tile (own half + the peer's multicast
+# half). After the mainloop each consumer writes its fp32 accumulator to its CTA's smem (aliasing
+# the stage ring, padded token stride so the stores are conflict-free), a cluster barrier, then the
+# CTA with K-split index r sums its integer share of 4-row groups (32 groups split floor(r*32/S)..
+# floor((r+1)*32/S)) over the S peers in fixed order 0..S-1 through mapa + ld.shared::cluster v4,
+# converts to bf16 and stores out[token, n] 8 B per thread; a final cluster barrier keeps every CTA's
+# smem alive. K-blocks per split are the integer split floor(r*nkb/S)..floor((r+1)*nkb/S).
+# Review fixes applied (adversarial review, proceed): (1) prepare prints max-active clusters next to
+# needed clusters (tiles / CX) for every candidate and a candidate whose cluster does not fit in ONE
+# wave is dropped, then the fitting candidates are timed cold-L2 and the fastest is kept; (2) a
+# print-only no-reduce variant (mode 0: mainloop + own-tile bf16 store, no peer reads; the two
+# cluster barriers stay, so its tail is just the barrier cost) is timed beside the full kernel; (3) integer row-group and K-block partitions for S that
+# do not divide 128 / 32 / nkb; (4) the remote empty-barrier protocol above. Gate: per (layer,
+# T class) the kernel is routed only when its cold-L2 CUDA-graph time beats master's cuBLAS (the
+# same x, flush between replays) by SWCL_WIN_RATIO, else master's path for that class. Bound
+# constants are this section's own (SWCL_*), independent of every other path's.
+SWCL_TAG = "[swapab-cl]"
+SWCL_LAYERS = {"pooler": (4096, 8192), "qkv_gate": (2304, 8192), "unpooler": (8192, 4096)}  # (n, k)
+SWCL_MIN_M = 65
+SWCL_MAX_M = {"pooler": 256, "qkv_gate": 256, "unpooler": 128}
+SWCL_T_SPLIT_M = 128   # m <= this: T = 128 (one 128-token tile); above: T = 256
+# (CX, S) candidates per layer, preferred first. Cluster size CX * S; CTAs = n / 128 * S.
+SWCL_CANDS = {
+    "pooler": ((2, 4), (1, 4), (2, 2)),
+    "unpooler": ((2, 2), (1, 2)),
+    "qkv_gate": ((2, 7), (1, 7), (2, 6), (1, 6), (2, 4), (1, 4)),
+}
+SWCL_CHECK_MS = {128: (65, 128), 256: (130, 200, 256)}
+SWCL_WIN_RATIO = 0.98            # kernel cold time must be <= this x master's cuBLAS time
+SWCL_FLUSH_BYTES = 256 * 1024 * 1024
+SWCL_PREP_BUDGET_S = 120.0       # wall budget for candidate checks + timings in prepare
+SWCL_GENCODE = "-gencode=arch=compute_90a,code=sm_90a"
+SWCL_CUDA_CFLAGS = ["-O3", "-lineinfo", "-std=c++20", SWCL_GENCODE]
+SWCL_ERR_TEXT = {0: "ok", 1: "mbarrier wait timed out", 2: "non-sm_90a image ran (wgmma compiled out)",
+                 3: "cluster rank mismatch"}
