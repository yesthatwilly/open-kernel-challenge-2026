+// CPU uint8 [128]: the CUtensorMap of a bf16 weight [N, K] (box 64 x 128), built once in prepare.
+torch::Tensor swcl_make_wmap(torch::Tensor w) {
+  TORCH_CHECK(w.is_cuda() && w.dim() == 2 && w.scalar_type() == at::kBFloat16 && w.is_contiguous(),
+              "swcl_make_wmap: weight must be a contiguous bf16 CUDA matrix");
+  TORCH_CHECK(w.size(1) % 64 == 0 && w.size(0) % TILE_ROWS == 0 &&
+              reinterpret_cast<uintptr_t>(w.data_ptr()) % 16 == 0, "swcl_make_wmap: weight shape / alignment");
+  const CUtensorMap map = encode_2d(w.data_ptr(), w.size(1), w.size(0), w.size(1) * 2, TILE_ROWS);
+  torch::Tensor t = torch::empty({static_cast<int64_t>(sizeof(CUtensorMap))}, torch::dtype(torch::kUInt8));
+  std::memcpy(t.data_ptr(), &map, sizeof(CUtensorMap));
+  return t;
+}
+
+void swcl_run(torch::Tensor x, torch::Tensor wmap, torch::Tensor out, torch::Tensor err, int64_t T, int64_t mc,
+              int64_t S, int64_t mode) {
+  TORCH_CHECK(x.is_cuda() && x.dim() == 2 && x.scalar_type() == at::kBFloat16, "swcl_run: x");
+  const int64_t m = x.size(0), k = x.size(1);
+  TORCH_CHECK(m >= 1 && m <= T && (T == 128 || T == 256), "swcl_run: m / T");
+  TORCH_CHECK(k % BK == 0 && x.stride(1) == 1 && x.stride(0) % 8 == 0 &&
+              reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0, "swcl_run: x strides / alignment");
+  TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 && out.is_contiguous() && out.dim() == 2 &&
+              out.size(0) == m && out.size(1) % TILE_ROWS == 0 &&
+              reinterpret_cast<uintptr_t>(out.data_ptr()) % 16 == 0, "swcl_run: out");
+  TORCH_CHECK(err.is_cuda() && err.scalar_type() == at::kInt && err.numel() >= 1, "swcl_run: err");
+  TORCH_CHECK(wmap.device().is_cpu() && wmap.scalar_type() == at::kByte &&
+              wmap.numel() == static_cast<int64_t>(sizeof(CUtensorMap)), "swcl_run: wmap");
+  TORCH_CHECK(S >= 1 && S <= 8 && (mc == 0 || mc == 1), "swcl_run: S / mc");
+  const int n = static_cast<int>(out.size(1));
+  TORCH_CHECK(!mc || ((n / TILE_ROWS) % 2 == 0), "swcl_run: multicast needs an even tile count");
+  const int nkb = static_cast<int>(k / BK);
+  TORCH_CHECK(nkb >= S, "swcl_run: fewer K blocks than splits");
+  CUtensorMap mw;
+  std::memcpy(&mw, wmap.data_ptr(), sizeof(CUtensorMap));
+  const uint32_t box_rows = mc ? static_cast<uint32_t>(T / 2) : static_cast<uint32_t>(T);
+  const CUtensorMap mx = encode_2d(x.data_ptr(), k, m, x.stride(0) * 2, box_rows);
+  const int mi = static_cast<int>(m), s = static_cast<int>(S), md = static_cast<int>(mode);
+  if (T == 128 && !mc) launch<128, false>(mw, mx, out, err, mi, n, nkb, s, md);
+  else if (T == 128 && mc) launch<128, true>(mw, mx, out, err, mi, n, nkb, s, md);
+  else if (T == 256 && !mc) launch<256, false>(mw, mx, out, err, mi, n, nkb, s, md);
+  else launch<256, true>(mw, mx, out, err, mi, n, nkb, s, md);
+}
+
+// {regs, local (spill) bytes, static smem, dynamic smem, max active clusters (-1: query failed),
+//  needed clusters, binaryVersion}
+std::vector<int64_t> swcl_info(int64_t T, int64_t mc, int64_t S, int64_t tiles) {
+  const int s = static_cast<int>(S), t = static_cast<int>(tiles);
+  if (T == 128 && !mc) return info<128, false>(s, t);
+  if (T == 128 && mc) return info<128, true>(s, t);
+  if (T == 256 && !mc) return info<256, false>(s, t);
+  if (T == 256 && mc) return info<256, true>(s, t);
+  TORCH_CHECK(false, "swcl_info: unsupported T");
+  return {};
+}
+"""
