+def _sp2_time_graphs(graphs: dict, reps: int, flush: torch.Tensor, rot: int = 0) -> dict:
+    """Interleaved cold-L2 graph replays (a flush write before each; the order rotates every rep and
+    by `rot`). Returns {name: [us per replay]}. prepare()-only."""
+    names = list(graphs)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+    times = {nm: [] for nm in names}
+    for rep in range(reps):
