+    }
+    __syncwarp();
+  } else {
+    // ---- consumers: warp cw owns k16 steps [cw*KSW, (cw+1)*KSW) of every chunk ----
+    const int cw = warp - 1;
+    for (int j = 0; j < NCHUNK; ++j) {
+      const int s = j % S;
+      const uint32_t ph = (j / S) & 1;
+      if (!mbar_wait(full0 + 8 * s, ph)) { if (lane == 0) atomicExch(err, 2); break; }
