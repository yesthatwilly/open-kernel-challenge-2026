+      const int s = j % S;
+      const uint32_t eph = ((j / S) & 1) ^ 1;
+      int good = 1;
+      if (lane == 0) {
+        good = mbar_wait(empty0 + 8 * s, eph) ? 1 : 0;
+        if (good) mbar_expect_tx(full0 + 8 * s, tx);
+      }
+      good = __shfl_sync(0xffffffffu, good, 0);
