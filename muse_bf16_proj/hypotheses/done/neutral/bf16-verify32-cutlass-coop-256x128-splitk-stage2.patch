+      const uint32_t xslot = wslot + 16384;
+#pragma unroll
+      for (int i = 0; i < KSW; ++i) {
+        const int kk16 = cw * KSW + i;
+        const int kbi = kk16 >> 2;
+        const int seg = (kk16 & 3) * 2;
+        uint32_t bfr[NN][2];
+        if constexpr (NN == 1) {
+          const int khalf = (lane >> 3) & 1;
+          ldsm_x2(bfr[0][0], bfr[0][1],
+                  xslot + (uint32_t)((lane & 7) * XS + kk16 * 32 + khalf * 16));
+        } else {
