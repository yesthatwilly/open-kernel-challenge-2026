+// Scheduler argument / member names moved across CUTLASS 3.x / 4.x: set or read each only if it exists.
+template <class T, class = void> struct has_decomposition_mode : std::false_type {};
+template <class T>
+struct has_decomposition_mode<T, std::void_t<decltype(std::declval<T&>().decomposition_mode)>>
+    : std::true_type {};
+template <class T, class = void> struct has_reduction_mode : std::false_type {};
+template <class T>
+struct has_reduction_mode<T, std::void_t<decltype(std::declval<T&>().reduction_mode)>>
+    : std::true_type {};
+template <class T, class = void> struct has_splits : std::false_type {};
+template <class T>
+struct has_splits<T, std::void_t<decltype(std::declval<T&>().splits)>> : std::true_type {};
+template <class T, class = void> struct has_sk_tiles : std::false_type {};
+template <class T>
+struct has_sk_tiles<T, std::void_t<decltype(std::declval<T const&>().sk_tiles_)>> : std::true_type {};
+template <class T, class = void> struct has_sk_units : std::false_type {};
+template <class T>
+struct has_sk_units<T, std::void_t<decltype(std::declval<T const&>().sk_units_)>> : std::true_type {};
+
+// SplitK with `splits` static splits and a deterministic fixup. Returns 1 only if BOTH the
+// decomposition mode and the split count could be set (else the query reports 0 and the layer is off).
+template <class SA>
+int64_t set_scheduler(SA& sa, int64_t splits) {
+  int64_t applied = 0;
+  if constexpr (has_decomposition_mode<SA>::value && has_splits<SA>::value) {
+    using DM = std::remove_cv_t<std::remove_reference_t<decltype(sa.decomposition_mode)>>;
+    sa.decomposition_mode = DM::SplitK;
+    sa.splits = static_cast<int>(splits);
+    applied = 1;
+  }
+  if constexpr (has_reduction_mode<SA>::value) {
+    using RM = std::remove_cv_t<std::remove_reference_t<decltype(sa.reduction_mode)>>;
+    sa.reduction_mode = RM::Deterministic;  // fixed summation order
+  }
+  return applied;
+}
+
+template <class P> int64_t get_sk_tiles(P const& p) {
+  if constexpr (has_sk_tiles<P>::value) { return static_cast<int64_t>(p.sk_tiles_); } else { return -1; }
+}
+template <class P> int64_t get_sk_units(P const& p) {
+  if constexpr (has_sk_units<P>::value) { return static_cast<int64_t>(p.sk_units_); } else { return -1; }
+}
+
+Arguments make_args(void const* x, void const* w, void* out, int m, int n, int k, int64_t splits,
+                    int sm_count, int device_id, int64_t* mode_applied) {
+  cutlass::KernelHardwareInfo hw_info;
+  hw_info.device_id = device_id;
+  hw_info.sm_count = sm_count;
+  Arguments args{
+      cutlass::gemm::GemmUniversalMode::kGemm,
+      ProblemShape{m, n, k, 1},
+      {static_cast<ElementA const*>(x), ld_stride<StrideA>(k, static_cast<int64_t>(m) * k),
+       static_cast<ElementB const*>(w), ld_stride<StrideB>(k, static_cast<int64_t>(n) * k)},
+      {{}, nullptr, ld_stride<StrideC>(n, static_cast<int64_t>(m) * n),
+       static_cast<ElementD*>(out), ld_stride<StrideD>(n, static_cast<int64_t>(m) * n)},
+      hw_info};
+  args.epilogue.thread.alpha = 1.0f;
+  args.epilogue.thread.beta = 0.0f;
+  int64_t applied = set_scheduler(args.scheduler, splits);
+  if (mode_applied != nullptr) { *mode_applied = applied; }
+  return args;
+}
+
+void check_operands(torch::Tensor const& x, torch::Tensor const& w, torch::Tensor const& out, int m) {
+  TORCH_CHECK(x.is_cuda() && w.is_cuda() && out.is_cuda(), "cut128: CUDA tensors required");
+  TORCH_CHECK(x.scalar_type() == at::kBFloat16 && w.scalar_type() == at::kBFloat16 &&
+              out.scalar_type() == at::kBFloat16, "cut128: bf16 x / w / out required");
+  TORCH_CHECK(x.dim() == 2 && w.dim() == 2 && out.dim() == 2, "cut128: 2-D tensors required");
+  TORCH_CHECK(x.is_contiguous() && w.is_contiguous() && out.is_contiguous(), "cut128: contiguous required");
+  TORCH_CHECK(x.size(1) == w.size(1) && out.size(1) == w.size(0), "cut128: shape mismatch");
+  TORCH_CHECK(m >= 1 && m <= 128 && m <= x.size(0) && m <= out.size(0), "cut128: m out of range");
+  TORCH_CHECK(w.size(1) % kAlign == 0 && w.size(0) % kAlign == 0, "cut128: n / k not 16 B aligned");
+}
+
+}  // namespace c128
+
+// out[m, n] = x[m, k] @ w[n, k]^T on the current stream. Branches on shapes only.
+void cut128_gemm(torch::Tensor x, torch::Tensor w, torch::Tensor out, torch::Tensor ws,
+                 int64_t splits, int64_t sm_count) {
+  const int m = static_cast<int>(x.size(0));
+  const int n = static_cast<int>(w.size(0));
+  const int k = static_cast<int>(w.size(1));
+  c128::check_operands(x, w, out, m);
+  TORCH_CHECK(out.size(0) == m, "cut128: out rows != m");
+  TORCH_CHECK(ws.is_cuda() && ws.is_contiguous(), "cut128: workspace must be a contiguous CUDA tensor");
+  auto args = c128::make_args(x.data_ptr(), w.data_ptr(), out.data_ptr(), m, n, k, splits,
+                              static_cast<int>(sm_count), x.get_device(), nullptr);
+  cutlass::Status st = c128::Gemm::can_implement(args);
+  TORCH_CHECK(st == cutlass::Status::kSuccess, "cut128: can_implement failed: ", cutlassGetStatusString(st));
+  const size_t need = c128::Gemm::get_workspace_size(args);
+  TORCH_CHECK(need <= static_cast<size_t>(ws.nbytes()), "cut128: workspace too small (need ", need,
+              " B, have ", ws.nbytes(), " B)");
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream(x.get_device()).stream();
+  // GemmUniversalAdapter::initialize() split in two so the timed path does not repeat the
+  // cudaFuncSetAttribute call (done once in prepare() by cut128_set_attr):
+  // (1) zero the split-K barrier region on the stream (one memset node under graph capture),
+  st = c128::GemmKernel::initialize_workspace(args, ws.data_ptr(), stream);
+  TORCH_CHECK(st == cutlass::Status::kSuccess, "cut128: initialize_workspace failed: ",
+              cutlassGetStatusString(st));
+  // (2) host-side params (TMA descriptors from these pointers, scheduler from the shape),
+  auto params = c128::GemmKernel::to_underlying_arguments(args, ws.data_ptr());
+  // (3) one cluster launch of the persistent kernel on the current stream.
+  st = c128::Gemm::run(params, stream);
+  TORCH_CHECK(st == cutlass::Status::kSuccess, "cut128: run failed: ", cutlassGetStatusString(st));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// Host-only query for problem rows m (x / out may be taller; only their pointers are used):
+// {can_implement, workspace bytes, grid x, y, z, smem bytes, threads, split mode applied (1/0),
+//  sk_tiles (-1 n/a), sk_units (-1 n/a), CUTLASS version as MAJOR*10000 + MINOR*100 + PATCH}.
+std::vector<int64_t> cut128_query(torch::Tensor x, torch::Tensor w, torch::Tensor out, int64_t m,
+                                  int64_t splits, int64_t sm_count) {
+  const int mi = static_cast<int>(m);
+  const int n = static_cast<int>(w.size(0));
+  const int k = static_cast<int>(w.size(1));
+  c128::check_operands(x, w, out, mi);
+  int64_t applied = 0;
+  auto args = c128::make_args(x.data_ptr(), w.data_ptr(), out.data_ptr(), mi, n, k, splits,
+                              static_cast<int>(sm_count), x.get_device(), &applied);
+  const int64_t can = c128::Gemm::can_implement(args) == cutlass::Status::kSuccess ? 1 : 0;
+  const int64_t ws = static_cast<int64_t>(c128::Gemm::get_workspace_size(args));
+  auto params = c128::GemmKernel::to_underlying_arguments(args, nullptr);
+  dim3 grid = c128::GemmKernel::get_grid_shape(params);
+  return {can, ws, static_cast<int64_t>(grid.x), static_cast<int64_t>(grid.y), static_cast<int64_t>(grid.z),
+          static_cast<int64_t>(c128::GemmKernel::SharedStorageSize),
+          static_cast<int64_t>(c128::GemmKernel::MaxThreadsPerBlock), applied,
+          c128::get_sk_tiles(params.scheduler), c128::get_sk_units(params.scheduler),
+          static_cast<int64_t>(CUTLASS_MAJOR * 10000 + CUTLASS_MINOR * 100 + CUTLASS_PATCH)};
+}
+
+// Raise the kernel's dynamic shared-memory limit once (prepare()); returns
+// {smem bytes requested, registers, local (spill) bytes, static smem bytes, max threads/block}.
+std::vector<int64_t> cut128_set_attr() {
+  const int smem = static_cast<int>(c128::GemmKernel::SharedStorageSize);
+  C10_CUDA_CHECK(cudaFuncSetAttribute(cutlass::device_kernel<c128::GemmKernel>,
+                                      cudaFuncAttributeMaxDynamicSharedMemorySize, smem));
+  cudaFuncAttributes fa;
+  C10_CUDA_CHECK(cudaFuncGetAttributes(&fa, cutlass::device_kernel<c128::GemmKernel>));
+  return {static_cast<int64_t>(smem), static_cast<int64_t>(fa.numRegs),
+          static_cast<int64_t>(fa.localSizeBytes), static_cast<int64_t>(fa.sharedSizeBytes),
+          static_cast<int64_t>(fa.maxThreadsPerBlock)};
+}
+"""
