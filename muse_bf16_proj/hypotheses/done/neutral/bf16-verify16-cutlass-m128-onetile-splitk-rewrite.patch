+template <class Stride>
+Stride ld_stride(int64_t ld, int64_t batch) {
+  auto s = cute::make_stride(ld, cute::Int<1>{}, batch);
+  static_assert(std::is_same<decltype(s), Stride>::value, "cut128: unexpected CUTLASS stride type");
+  return s;
