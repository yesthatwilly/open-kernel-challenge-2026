+
+def _cutlass_version(include_dir: str):
+    """(MAJOR, MINOR, PATCH) from <include_dir>/cutlass/version.h, or None."""
+    try:
+        with open(os.path.join(include_dir, "cutlass", "version.h")) as f:
+            txt = f.read()
+        ver = []
+        for key in ("MAJOR", "MINOR", "PATCH"):
+            mm = re.search(r"#define\s+CUTLASS_" + key + r"\s+(\d+)", txt)
+            ver.append(int(mm.group(1)) if mm else -1)
+        return tuple(ver)
+    except Exception:
+        return None
+
+
+def _find_cutlass_includes():
+    """Glob the importlib-resolved package dirs of flashinfer / deep_gemm / sgl_kernel / tilelang /
+    cutlass_library plus /usr/local/cutlass and /usr/include for
+    cutlass/gemm/collective/collective_builder.hpp with a sibling cute/ (and the sm90 stream-K
+    scheduler). Prints every hit; returns [(version, include_dir, source)] newest first."""
+    roots = []
+    for pkg in CUT_PKGS:
+        try:
+            spec = importlib.util.find_spec(pkg)
+        except Exception as e:
+            print(f"[cut128] headers: find_spec({pkg}) raised {type(e).__name__}: {e}", flush=True)
+            continue
+        if spec is None:
+            print(f"[cut128] headers: package {pkg} not installed", flush=True)
+            continue
+        locs = list(spec.submodule_search_locations or [])
+        if not locs and spec.origin:
+            locs = [os.path.dirname(spec.origin)]
+        roots += [(pkg, p) for p in locs]
+    roots += [("system", "/usr/local/cutlass"), ("system", "/usr/include")]
+    hits, seen = [], set()
+    for src, root in roots:
+        if not os.path.isdir(root):
+            continue
+        try:
+            found = glob.glob(os.path.join(root, "**", CUT_BUILDER_REL), recursive=True)
+        except Exception as e:
+            print(f"[cut128] headers: glob under {root} raised {type(e).__name__}: {e}", flush=True)
+            continue
+        for path in found:
+            inc = os.path.realpath(path[: -len(CUT_BUILDER_REL)].rstrip(os.sep))
+            if inc in seen:
+                continue
+            seen.add(inc)
+            has_cute = os.path.isdir(os.path.join(inc, "cute"))
+            has_sk = os.path.isfile(os.path.join(inc, "cutlass", "gemm", "kernel",
+                                                 "sm90_tile_scheduler_stream_k.hpp"))
+            ver = _cutlass_version(inc)
+            print(f"[cut128] headers: hit src={src} include={inc} version={ver} cute/={has_cute} "
+                  f"sm90_stream_k={has_sk}", flush=True)
+            if has_cute and has_sk and ver is not None and ver[0] >= 3:
+                hits.append((ver, inc, src))
+    hits.sort(key=lambda h: h[0], reverse=True)
+    return hits
+
+
+def _cut_build():
+    """Compile the CUTLASS split-K module once per process, at import (never during capture), for
+    sm_90a only (TORCH_CUDA_ARCH_LIST=9.0a around the build, restored after). Tries the newest usable
+    CUTLASS tree (a second one only if time allows). Prints arch flags and build seconds. Returns
+    the module or None (master paths everywhere); never raises."""
+    t_all = time.perf_counter()
+    if t_all - _MODULE_T0 > CUT_BUILD_DEADLINE_S:
+        print(f"[cut128] build skipped: deadline ({t_all - _MODULE_T0:.0f}s since import > "
+              f"{CUT_BUILD_DEADLINE_S:.0f}s); master paths kept", flush=True)
+        return None
+    try:
+        hits = _find_cutlass_includes()
+    except Exception as e:
+        print(f"[cut128] header search raised {type(e).__name__}: {e}; master kept", flush=True)
+        return None
+    if not hits:
+        print("[cut128] no CUTLASS headers, master kept", flush=True)
+        return None
+    try:
+        from torch.utils import cpp_extension
+    except Exception as e:
+        print(f"[cut128] cpp_extension unavailable ({e!r}); master kept", flush=True)
+        return None
+    tried = []
+    for ver, inc, src in hits:
