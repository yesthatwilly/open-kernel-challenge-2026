+def _cut_route_ok(layer: str, x: torch.Tensor, cfg, state: dict) -> bool:
+    """CUTLASS split-K cell: layer in CUT_LAYERS with its prepare()-set flag, CUT_MIN_M <= cfg m <=
+    CUT_MAX_M, cfg n / k the layer's full weight, x a contiguous 16-byte-aligned bf16 [m, k].
+    cfg, shapes and state flags only (never input values)."""
+    spec = CUT_LAYERS.get(layer)
+    if spec is None or not state.get(spec[0]):
+        return False
+    w = state[layer]
+    m = cfg["m"]
+    return (CUT_MIN_M <= m <= CUT_MAX_M and cfg["n"] == w.shape[0] and cfg["k"] == w.shape[1]
+            and x.dim() == 2 and x.shape[0] == m and x.shape[1] == w.shape[1]
+            and x.dtype == torch.bfloat16 and x.is_contiguous() and x.data_ptr() % 16 == 0)
+
+
+def _cut_forward(layer: str, x: torch.Tensor, state: dict) -> torch.Tensor:
+    """x bf16 [m, k] @ W[n, k].T -> bf16 [m, n]: one CUTLASS launch (plus the split-K barrier memset)
+    into the state's own prepare()-allocated workspace; nothing is written to state."""
+    w = state[layer]
+    out = torch.empty((x.shape[0], w.shape[0]), dtype=torch.bfloat16, device=x.device)
+    _CUT_EXT.cut128_gemm(x, w, out, state["cut_ws"], state["cut_splits"][layer], state["cut_sms"])
+    return out
+
+
+def _iqr(v) -> float:
+    s = sorted(v)
+    n = len(s)
+    return s[(3 * n) // 4] - s[n // 4]
+
+
+def _cut_gate(layer: str, m: int, n: int, k: int, flag: str, state: dict):
+    """Two-round model selector (LESSONS: one round at 1.02x is not enough). kernel_fn captured with
+    the cell's flag on (candidate) and off (master's ACTUALLY ROUTED path: nn_ok / Lt / cuBLAS, the
+    same kernel_fn) on shallow copies of state and the same synthetic x; per round CELL_GATE_REPS
+    interleaved replays (order swapped every rep), a CELL_FLUSH_BYTES write before each, medians
+    minus an empty-graph baseline. Prints both rounds. Returns (passed, why, rounds) where a round is
+    (cand_us, master_us, cand_iqr, master_iqr). prepare()-only."""
+    dev = state["router"].device
+    st_c = dict(state)
+    st_c[flag] = True
+    st_i = dict(state)
+    st_i[flag] = False
+    x = torch.randn((m, k), device=dev, dtype=torch.float32).to(torch.bfloat16)
+    data = {"x": x, "config": {"m": m, "n": n, "k": k, "layer": layer}}
+    flush = torch.empty(CELL_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+    def replay_us(gr) -> float:
+        flush.zero_()
+        ev[0].record()
+        gr.replay()
+        ev[1].record()
+        ev[1].synchronize()
+        return ev[0].elapsed_time(ev[1]) * 1e3
+
+    g_base = _cell_capture(lambda: scratch.add_(1.0))
+    graphs = {"cand": _cell_capture(lambda: kernel_fn(data, st_c)),
+              "master": _cell_capture(lambda: kernel_fn(data, st_i))}
+    rounds = []
+    ok, why = True, ""
+    for rnd in range(CUT_ROUNDS):
+        base = _ouns_median([replay_us(g_base) for _ in range(CELL_GATE_REPS)])
+        times = {"cand": [], "master": []}
+        for rep in range(CELL_GATE_REPS):
+            order = ("cand", "master") if (rep + rnd) % 2 == 0 else ("master", "cand")
+            for name in order:
+                times[name].append(replay_us(graphs[name]))
+        med = {name: _ouns_median(v) for name, v in times.items()}
+        iqr = {name: _iqr(v) for name, v in times.items()}
+        adj = {name: max(v - base, 0.25) for name, v in med.items()}
+        ratio = adj["cand"] / adj["master"]
+        iqr_cap = max(CUT_MAX_IQR_RATIO * iqr["master"], CUT_IQR_FLOOR_US)
+        print(f"[cut128] gate round {rnd + 1}/{CUT_ROUNDS} {layer} m={m} (graph replay, "
+              f"{CELL_FLUSH_BYTES >> 20} MB flush, {CELL_GATE_REPS} reps interleaved): cand median "
+              f"{med['cand']:.2f} us IQR {iqr['cand']:.2f}, master median {med['master']:.2f} us IQR "
+              f"{iqr['master']:.2f}, empty-graph baseline {base:.2f} us -> net {adj['cand']:.2f} vs "
+              f"{adj['master']:.2f} us, master/cand {1.0 / ratio:.3f}x (need >= {CUT_MIN_WIN}x), cand IQR "
+              f"cap {iqr_cap:.2f} us", flush=True)
+        rounds.append((adj["cand"], adj["master"], iqr["cand"], iqr["master"]))
+        if ok and not 1.0 / ratio >= CUT_MIN_WIN:
+            ok, why = False, f"gate round {rnd + 1}: master/cand {1.0 / ratio:.3f}x < {CUT_MIN_WIN}x"
+        if ok and iqr["cand"] > iqr_cap:
+            ok, why = False, (f"gate round {rnd + 1}: cand IQR {iqr['cand']:.2f} us > cap {iqr_cap:.2f} us "
+                              f"({CUT_MAX_IQR_RATIO}x master's {iqr['master']:.2f}, floor {CUT_IQR_FLOOR_US})")
+    del graphs, g_base, flush
+    torch.cuda.synchronize()
+    return ok, why, rounds
+
