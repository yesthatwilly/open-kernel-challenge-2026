+def _cut_prepare(state: dict, flags=None, t_all=None) -> list:
+    """qkv_gate / o / pooler / unpooler at 65 <= m <= 128. Sets state[flag] per layer (False unless
+    every step passes) plus state['cut_ws'] (this state's OWN split-K workspace), state['cut_splits']
+    and state['cut_sms']. flags None (the judge's state): set the kernel's smem attribute and print
+    regs/spills, per layer choose splits (can_implement + grid <= SMs, with fallbacks), allocate ONE
+    workspace, self-check at m 65 / 100 / 128 (each launch announced and synced), run the two-round
+    gate at m == 128 against master's routed path, assert by torch.profiler the launched kernel
+    names, print one PATH CHOSEN line per layer. flags a dict (the A/B check's second state):
+    inherit the flags and splits, allocate its own workspace. Returns the compact summary lines
+    (prepare() repeats them last). Never raises."""
+    summary = []
+    for spec in CUT_LAYERS.values():
+        state[spec[0]] = False
+    state["cut_ws"] = None
+    state["cut_splits"] = {}
+    state["cut_sms"] = 0
+    dev = state["router"].device
+    if flags is not None:
+        if any(flags.get(spec[0]) for spec in CUT_LAYERS.values()) and flags.get("_cut_ws_bytes"):
+            try:
+                state["cut_ws"] = torch.zeros(((int(flags["_cut_ws_bytes"]) + 7) // 8,), dtype=torch.int64,
+                                              device=dev)
+                state["cut_splits"] = dict(flags["_cut_splits"])
+                state["cut_sms"] = int(flags["_cut_sms"])
+                for spec in CUT_LAYERS.values():
+                    state[spec[0]] = bool(flags.get(spec[0]))
+            except Exception as e:
+                print(f"[cut128] second state: workspace raised {type(e).__name__}: {e}; cells off in "
+                      f"this state", flush=True)
+                for spec in CUT_LAYERS.values():
+                    state[spec[0]] = False
+        return summary
+
+    def done(layer: str, chosen: bool, detail: str) -> None:
+        line = (f"PATH CHOSEN CUT {layer} m={CUT_GATE_M}: {'candidate' if chosen else 'master'}; {detail}")
+        print(line, flush=True)
+        summary.append(line)
+
+    if _CUT_EXT is None:
+        for layer in CUT_LAYERS:
+            done(layer, False, "no cut128 module (build failed or skipped)")
+        return summary
+    t_start = t_all if t_all is not None else time.perf_counter()
+    if time.perf_counter() - t_start > CUT_START_DEADLINE_S:
+        print(f"[cut128] prepare skipped: deadline ({time.perf_counter() - t_start:.0f}s > "
+              f"{CUT_START_DEADLINE_S:.0f}s at phase start)", flush=True)
+        for layer in CUT_LAYERS:
+            done(layer, False, "skipped: deadline")
+        return summary
+    ext = _CUT_EXT
+    t0 = time.perf_counter()
+    sms = int(torch.cuda.get_device_properties(dev).multi_processor_count)
+    try:
+        smem, regs, spill, ssmem, thr = (int(v) for v in ext.cut128_set_attr())
+        print(f"[cut128] kernel cutlass::device_kernel<c128::GemmKernel>: regs={regs} local(spill)={spill} B "
+              f"static smem={ssmem} B dyn smem requested={smem} B max threads/block={thr} sm_count={sms}",
+              flush=True)
+        if spill:
+            print(f"[cut128] WARNING: {spill} B local-memory spill per thread", flush=True)
+    except Exception as e:
+        print(f"[cut128] ALL DISABLED: cudaFuncSetAttribute / attributes failed: {e!r}", flush=True)
+        for layer in CUT_LAYERS:
+            done(layer, False, f"set_attr failed {type(e).__name__}")
+        return summary
+
+    # Pass 1: per layer pick the splits (first candidate that can_implement, sets the split mode and
+    # fits one wave), then the workspace bytes over every m in range. Host-only queries.
+    usable, need = {}, {}
+    why_off = {}
+    for layer, (flag, n, k, cands) in CUT_LAYERS.items():
+        w = state[layer]
+        if not (w.dim() == 2 and tuple(w.shape) == (n, k) and w.dtype == torch.bfloat16 and w.is_contiguous()):
+            why_off[layer] = f"weight {tuple(w.shape)} {w.dtype} unexpected"
+            continue
+        try:
+            xq = torch.zeros((CUT_MAX_M, k), dtype=torch.bfloat16, device=dev)
+            oq = torch.empty((CUT_MAX_M, n), dtype=torch.bfloat16, device=dev)
+            chosen = None
+            for sp in cands:
+                q = [int(v) for v in ext.cut128_query(xq, w, oq, CUT_GATE_M, sp, sms)]
+                grid = q[2] * q[3] * q[4]
+                print(f"[cut128] {layer} m={CUT_GATE_M} n={n} k={k} splits={sp}: can_implement={q[0]} "
+                      f"split_mode_applied={q[7]} grid=({q[2]},{q[3]},{q[4]})={grid} CTAs (<= {sms} needed) "
+                      f"threads={q[6]} smem={q[5]} B workspace={q[1]} B sk_tiles={q[8]} sk_units={q[9]} "
+                      f"CUTLASS={q[10]} decomposition applied: SplitK x{sp} deterministic, cluster 1x2x1",
+                      flush=True)
+                if q[0] == 1 and q[7] == 1 and 0 < grid <= sms:
+                    chosen = sp
+                    break
+            if chosen is None:
+                why_off[layer] = f"no split candidate {cands} passed can_implement / split mode / grid <= {sms}"
+                continue
+            sizes = []
+            for m in range(CUT_MIN_M, CUT_MAX_M + 1):
+                q = ext.cut128_query(xq, w, oq, m, chosen, sms)
+                if int(q[0]) != 1 or int(q[2]) * int(q[3]) * int(q[4]) > sms:
+                    raise RuntimeError(f"can_implement / grid failed at m={m} with splits {chosen}")
+                sizes.append(int(q[1]))
+            need[layer] = max(sizes)
+            usable[layer] = chosen
+            print(f"[cut128] {layer}: splits {chosen}, workspace bytes over m {CUT_MIN_M}..{CUT_MAX_M}: "
+                  f"min {min(sizes)} max {max(sizes)}", flush=True)
+        except Exception as e:
+            why_off[layer] = f"query raised {type(e).__name__}: {str(e)[-200:]}"
+    for layer, why in why_off.items():
+        print(f"[cut128] {layer} DISABLED: {why}", flush=True)
+        done(layer, False, f"DISABLED {why}")
+    if not usable:
+        return summary
+    ws_bytes = max(max(need.values()), 8)
+    state["cut_ws"] = torch.zeros(((ws_bytes + 7) // 8,), dtype=torch.int64, device=dev)
+    state["cut_splits"] = dict(usable)
+    state["cut_sms"] = sms
+    print(f"[cut128] workspace allocated once per state: {ws_bytes} B (per layer {need})", flush=True)
+
+    # Pass 2: self-check, two-round gate at m == 128, kernel-name assertion, per layer.
+    for layer, sp in usable.items():
+        flag, n, k, _ = CUT_LAYERS[layer]
+        w = state[layer]
+        tl0 = time.perf_counter()
+        ok = False
+        why = ""
+        rounds = []
+        names_c = names_m = None
+        try:
+            if time.perf_counter() - t_start > CUT_LAYER_DEADLINE_S:
+                why = "skipped: deadline"
+                print(f"[cut128] {layer}: skipped: deadline ({time.perf_counter() - t_start:.0f}s > "
+                      f"{CUT_LAYER_DEADLINE_S:.0f}s)", flush=True)
+            else:
+                st_on = dict(state)
+                st_on[flag] = True
+                for m in CUT_CHECK_MS:
+                    why = _cell_check(f"CUT {layer} splits={sp}", lambda xx: _cut_forward(layer, xx, st_on),
+                                      w, m, n, k)
+                    if why:
+                        break
+                if not why:
+                    ok, why, rounds = _cut_gate(layer, CUT_GATE_M, n, k, flag, state)
+                data = {"x": torch.randn((CUT_GATE_M, k), device=dev, dtype=torch.float32).to(torch.bfloat16),
+                        "config": {"m": CUT_GATE_M, "n": n, "k": k, "layer": layer}}
+                if rounds:   # kernel names of BOTH sides, printed even when master is kept
+                    st_off = dict(state)
+                    st_off[flag] = False
+                    try:
+                        names_m = _cell_kernels(lambda: kernel_fn(data, st_off))
+                        print(f"[cut128] {layer} m={CUT_GATE_M}: master path profiled kernels {names_m}", flush=True)
+                    except Exception as e:
+                        print(f"[cut128] {layer}: master profile unavailable ({type(e).__name__}: {e})", flush=True)
+                    try:
+                        names_c = _cell_kernels(lambda: kernel_fn(data, st_on))
+                        print(f"[cut128] {layer} m={CUT_GATE_M}: candidate profiled kernels {names_c}", flush=True)
+                    except Exception as e:
+                        print(f"[cut128] {layer}: candidate profile unavailable ({type(e).__name__}: {e}); "
+                              f"route decided by the gate (kernel_fn calls cut128_gemm directly)", flush=True)
+                if ok and names_c is not None:
+                    gemm = [s for s in names_c if "device_kernel" in s and "GemmUniversal" in s]
+                    other = [s for s in names_c if s not in gemm and "memset" not in s.lower()]
+                    if len(gemm) != 1 or other:
+                        ok, why = False, (f"profiled kernels {names_c}: expected exactly one cutlass "
+                                          f"device_kernel<GemmUniversal> (+ memset), got {len(gemm)} and "
+                                          f"{len(other)} others")
+                if ok:
+                    state[flag] = True
+        except Exception as e:   # never raises: any surprise keeps master's path for this layer
+            ok, why = False, f"raised {type(e).__name__}: {str(e)[-300:]}"
+            state[flag] = False
+        r = " ".join(f"r{i + 1}:cand {c:.2f}/master {mm:.2f}us" for i, (c, mm, _, _) in enumerate(rounds))
+        kn = ""
+        if names_c is not None:
+            kn = " kernels=" + ",".join(s.split("<")[0][-24:] for s in names_c)
+        done(layer, state[flag], f"splits {sp} {r or 'no gate'}" + ("" if state[flag] else f"; {why}") + kn)
+        print(f"[prepare-time] cell CUT {layer} total: {time.perf_counter() - tl0:.2f}s", flush=True)
+    torch.cuda.synchronize()
+    print(f"[prepare-time] cut128 phase total: {time.perf_counter() - t0:.2f}s", flush=True)
+    return summary
+
