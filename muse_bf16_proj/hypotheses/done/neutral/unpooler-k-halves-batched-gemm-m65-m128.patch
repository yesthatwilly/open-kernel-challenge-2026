+UNPOOLER_KHALF_N = 8192
+UNPOOLER_KHALF_K = 4096
+UNPOOLER_KHALF_HALF = 2048
+UNPOOLER_KHALF_MS = (128,)      # scored row verify_16 only; m=130 / m=1000 stay on master
+UNPOOLER_KHALF_MIN_WIN = 1.02
+UNPOOLER_KHALF_WEIGHTS = ("N", "T")
+
+
+def _khalf_forward(x: torch.Tensor, state: dict, cand: str) -> torch.Tensor:
+    """Two K-halves of the unpooler as one strided-batched GEMM, then one bf16 add. x [m, 4096]
+    contiguous. Candidate N: contiguous halves of the existing NN weight unpooler_t viewed
+    [2, 2048 k, 8192 n]. Candidate T: TN view of state['unpooler'] [8192, 4096] as
+    [2, 2048 k, 8192 n] (strides 2048, 1, 4096), no copy."""
+    m = x.shape[0]
+    xh = x.view(m, 2, UNPOOLER_KHALF_HALF).permute(1, 0, 2)
+    if cand == "T":
+        wh = state["unpooler"].view(UNPOOLER_KHALF_N, 2, UNPOOLER_KHALF_HALF).permute(1, 2, 0)
+    else:
+        wh = state["unpooler_t"].view(2, UNPOOLER_KHALF_HALF, UNPOOLER_KHALF_N)
+    p = torch.bmm(xh, wh)
+    return torch.add(p[0], p[1])
+
+
+def _khalf_kernel_names(fn) -> list:
+    """Names of the CUDA kernels / copies one eager call of fn launches (torch.profiler). A
+    profiler failure returns [] (name check skipped), it never raises."""
+    try:
+        from torch.profiler import ProfilerActivity, profile
+        fn()
+        torch.cuda.synchronize()
+        with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA]) as prof:
+            fn()
+            torch.cuda.synchronize()
+        return [e.name for e in prof.events() if e.device_type == torch.autograd.DeviceType.CUDA]
+    except Exception as e:
+        print(f"[khalf] profiler failed ({type(e).__name__}: {e}); name check skipped", flush=True)
+        return []
+
+
+def _khalf_names_ok(names: list) -> bool:
+    """Disqualify only a copy of xh/w (torch inserted contiguous()) or a cuBLAS split-K reduce
+    kernel. Kernel counts are printed, not asserted; an empty event list skips the check."""
+    low = [n.lower() for n in names]
+    gemm = [n for n in low if ("nvjet" in n or "cutlass" in n or "gemm" in n or "sm90" in n)
+            and "reduce" not in n and "elementwise" not in n]
+    elem = [n for n in low if "elementwise" in n or "vectorized" in n]
+    copies = [n for n in low if n not in gemm and ("memcpy" in n or "copy" in n or "contiguous" in n)]
+    reduce_k = [n for n in low if "splitkreduce" in n]
+    print(f"[khalf] kernel name check: {len(low)} CUDA events, gemm {len(gemm)}, elementwise {len(elem)}, "
+          f"copies {len(copies)}, splitKreduce {len(reduce_k)}"
+          + ("; profiler saw no CUDA kernels, name check skipped" if not low else ""), flush=True)
+    return not copies and not reduce_k
+
+
+def _khalf_select(state: dict) -> None:
+    """prepare()-only, state A only. For m in UNPOOLER_KHALF_MS: capture master's exact path
+    (torch.mm on unpooler_t) and both K-halves candidates (N, T) as CUDA graphs on the same
+    synthetic x, check numerics (reject > AB_BF16_REL_L2) and kernel names, replay interleaved with
+    a 256 MB flush before each replay (OUNS_GATE_REPS reps, empty-graph baseline subtracted), print
+    medians, IQR, the bmm-only median, kernel names and xh.stride() even when master is kept, and
+    route a candidate only if master / candidate >= UNPOOLER_KHALF_MIN_WIN. Fixes
+    state['unpooler_khalf'] ({m: 'N' or 'T'}) and state[UNPOOLER_KHALF_FLAG]. Never raises."""
+    state["unpooler_khalf"] = {}
+    state[UNPOOLER_KHALF_FLAG] = False
+    chosen = {}
+    flush = scratch = None
+    try:
+        w, wt = state["unpooler"], state["unpooler_t"]
+        if not (w.dim() == 2 and tuple(w.shape) == (UNPOOLER_KHALF_N, UNPOOLER_KHALF_K)
+                and w.dtype == torch.bfloat16 and w.stride(1) == 1 and w.stride(0) == UNPOOLER_KHALF_K
+                and wt.is_contiguous() and tuple(wt.shape) == (UNPOOLER_KHALF_K, UNPOOLER_KHALF_N)):
+            print(f"[khalf] PATH CHOSEN: unpooler m={UNPOOLER_KHALF_MS} -> master: weight layout unexpected",
+                  flush=True)
+            return
+        dev = w.device
+        flush = torch.empty(OUNS_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+        scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+        ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+        def replay_us(g) -> float:
+            flush.zero_()
+            ev[0].record()
+            g.replay()
+            ev[1].record()
+            ev[1].synchronize()
+            return ev[0].elapsed_time(ev[1]) * 1e3
+
+        def capture(fn):
+            for _ in range(3):
+                fn()
+            torch.cuda.synchronize()
+            g = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(g):
+                fn()
+            torch.cuda.synchronize()
+            return g
+
+        g_base = capture(lambda: scratch.add_(1.0))
+        base = _ouns_median([replay_us(g_base) for _ in range(OUNS_GATE_REPS)])
+        wref = w.float()
+        for m in UNPOOLER_KHALF_MS:
+            x = torch.randn((m, UNPOOLER_KHALF_K), device=dev, dtype=torch.float32).to(torch.bfloat16)
+            xh = x.view(m, 2, UNPOOLER_KHALF_HALF).permute(1, 0, 2)
+            print(f"[khalf] m={m}: xh.stride()={tuple(xh.stride())} xh.is_contiguous()={xh.is_contiguous()}",
+                  flush=True)
+            whs = {"N": wt.view(2, UNPOOLER_KHALF_HALF, UNPOOLER_KHALF_N),
+                   "T": w.view(UNPOOLER_KHALF_N, 2, UNPOOLER_KHALF_HALF).permute(1, 2, 0)}
+            print(f"[khalf] m={m}: wh strides N={tuple(whs['N'].stride())} T={tuple(whs['T'].stride())}",
+                  flush=True)
+            fns = {"master": (lambda x=x: torch.mm(x, wt))}
+            for c in UNPOOLER_KHALF_WEIGHTS:
+                fns[c] = (lambda x=x, c=c: _khalf_forward(x, state, c))
+            ref = x.float() @ wref.T
+            valid, names = {}, {}
+            for name, fn in fns.items():
+                print(f"[khalf] m={m}: checking {name} ...", flush=True)
+                o = fn()
+                torch.cuda.synchronize()
+                err = float((o.float() - ref).norm() / ref.norm().clamp_min(1e-30))
+                names[name] = _khalf_kernel_names(fn)
+                ok = bool(torch.isfinite(o).all()) and err <= AB_BF16_REL_L2
+                if name != "master":
+                    ok = ok and _khalf_names_ok(names[name])
+                valid[name] = ok
+                print(f"[khalf] m={m}: {name} rel L2 {err:.2e} kernels {names[name]} valid={ok}", flush=True)
+            live = [n for n in fns if valid[n]]
+            graphs = {name: capture(fns[name]) for name in live}
+            # bmm-only (no add) timing of each live candidate, diagnostic only.
+            for c in UNPOOLER_KHALF_WEIGHTS:
+                if c in graphs:
+                    graphs["bmm" + c] = capture(lambda c=c: torch.bmm(xh, whs[c]))
+            times = {name: [] for name in graphs}
+            for rep in range(OUNS_GATE_REPS):
+                order = list(graphs) if rep % 2 == 0 else list(graphs)[::-1]
+                for name in order:
+                    times[name].append(replay_us(graphs[name]))
+            med, adj, iqr = {}, {}, {}
+            for name, v in times.items():
+                sv = sorted(v)
+                med[name] = sv[len(sv) // 2]
+                iqr[name] = sv[(3 * len(sv)) // 4] - sv[len(sv) // 4]
+                adj[name] = max(med[name] - base, 0.25)
+            best, best_ratio = "master", 1.0
+            for c in UNPOOLER_KHALF_WEIGHTS:
+                if c in adj and "master" in adj:
+                    ratio = adj["master"] / adj[c]
+                    print(f"[khalf] m={m}: master median {med['master']:.2f} us (IQR {iqr['master']:.2f}), cand {c} "
+                          f"median {med[c]:.2f} us (IQR {iqr[c]:.2f}), bmm-only median {med['bmm' + c]:.2f} us "
+                          f"(IQR {iqr['bmm' + c]:.2f}), empty-graph baseline {base:.2f} us -> net "
+                          f"{adj['master']:.2f} vs {adj[c]:.2f} us, master/cand {ratio:.3f}x "
+                          f"(need >= {UNPOOLER_KHALF_MIN_WIN})", flush=True)
+                    if ratio > best_ratio:
+                        best, best_ratio = c, ratio
+                else:
+                    print(f"[khalf] m={m}: cand {c} not timed (invalid)", flush=True)
+            if best != "master" and best_ratio >= UNPOOLER_KHALF_MIN_WIN:
+                chosen[m] = best
+            graphs.clear()
+    except Exception as e:
+        print(f"[khalf] selector failed ({type(e).__name__}: {e}); master path kept", flush=True)
+        chosen = {}
+    finally:
+        flush = None
+        scratch = None
+        try:
+            torch.cuda.synchronize()
+        except Exception:
+            pass
+    state["unpooler_khalf"] = dict(chosen)
+    state[UNPOOLER_KHALF_FLAG] = bool(chosen)
+    for m in UNPOOLER_KHALF_MS:
+        print(f"[khalf] PATH CHOSEN: unpooler m={m} -> "
+              + (f"K-halves bmm candidate {chosen[m]} + add" if m in chosen else "master (NN torch.mm)"),
+              flush=True)
+
+
