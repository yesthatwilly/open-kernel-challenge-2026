+void lossless_gemm(torch::Tensor x, torch::Tensor payload, torch::Tensor hdr, torch::Tensor side,
+                   torch::Tensor out, torch::Tensor ws, torch::Tensor cnt,
+                   int64_t n, int64_t k, int64_t split) {
+  const int64_t m = x.size(0);
+  TORCH_CHECK(m >= 1 && m <= MAXM, "lossless_gemm: m out of range");
+  TORCH_CHECK(x.scalar_type() == torch::kBFloat16 && x.dim() == 2 && x.size(1) == k && x.stride(1) == 1
+              && x.stride(0) % 8 == 0 && reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0, "lossless_gemm: x");
+  TORCH_CHECK(n % BLOCK_N == 0 && k % BLOCK_K == 0 && split >= 1 && k / BLOCK_K >= split, "lossless_gemm: tiling");
+  TORCH_CHECK(payload.scalar_type() == torch::kUInt8 && payload.numel() >= (n / 16) * (k / GROUP_K) * CHUNK
+              && reinterpret_cast<uintptr_t>(payload.data_ptr()) % 16 == 0, "lossless_gemm: payload");
+  TORCH_CHECK(hdr.scalar_type() == torch::kUInt8 && hdr.numel() >= (n / 16) * (k / GROUP_K) * HDR
+              && reinterpret_cast<uintptr_t>(hdr.data_ptr()) % 16 == 0, "lossless_gemm: hdr");
+  TORCH_CHECK(side.scalar_type() == torch::kBFloat16 && side.numel() >= GROUP_K, "lossless_gemm: side");
+  TORCH_CHECK(out.scalar_type() == torch::kBFloat16 && out.size(0) == m && out.size(1) == n && out.stride(1) == 1,
+              "lossless_gemm: out");
+  TORCH_CHECK(split == 1 || (ws.scalar_type() == torch::kFloat32 && ws.numel() >= split * MAXM * n
+                             && cnt.scalar_type() == torch::kInt32 && cnt.numel() >= n / BLOCK_N),
+              "lossless_gemm: workspace");
+  if (m <= 8) launch<8>(x, payload, hdr, side, out, ws, cnt, n, k, split);
+  else if (m <= 16) launch<16>(x, payload, hdr, side, out, ws, cnt, n, k, split);
+  else launch<32>(x, payload, hdr, side, out, ws, cnt, n, k, split);
+}
+
+void lossless_decode(torch::Tensor payload, torch::Tensor hdr, torch::Tensor side, torch::Tensor out,
+                     int64_t n, int64_t k) {
+  TORCH_CHECK(n % 16 == 0 && k % GROUP_K == 0, "lossless_decode: tiling");
+  TORCH_CHECK(payload.scalar_type() == torch::kUInt8 && payload.numel() >= (n / 16) * (k / GROUP_K) * CHUNK,
+              "lossless_decode: payload");
+  TORCH_CHECK(hdr.scalar_type() == torch::kUInt8 && hdr.numel() >= (n / 16) * (k / GROUP_K) * HDR,
+              "lossless_decode: hdr");
+  TORCH_CHECK(out.scalar_type() == torch::kBFloat16 && out.is_contiguous() && out.size(0) == n && out.size(1) == k,
+              "lossless_decode: out");
+  const int64_t warps = (n / 16) * (k / GROUP_K);
+  const unsigned grid = static_cast<unsigned>((warps * 32 + 255) / 256);
+  auto stream = at::cuda::getCurrentCUDAStream();
+  lossless_decode_kernel<<<grid, 256, 0, stream>>>(
+      payload.data_ptr<uint8_t>(), hdr.data_ptr<uint8_t>(), reinterpret_cast<const uint32_t*>(side.data_ptr()),
+      reinterpret_cast<uint32_t*>(out.data_ptr()), static_cast<int>(n), static_cast<int>(k));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// Per NT (8, 16, 32): [NT, registers, local (spill) bytes, dynamic smem bytes, CTAs/SM].
+torch::Tensor lossless_attrs() {
+  auto t = torch::zeros({3, 5}, torch::kInt64);
+  int64_t* p = t.data_ptr<int64_t>();
+  fill_attr<8>(p);
+  fill_attr<16>(p + 5);
+  fill_attr<32>(p + 10);
+  return t;
+}
+"""
+
+
+def _build_lossless():
+    """Compile the CUDA module once per process, at import (never during graph capture). Any
+    failure keeps master's routing everywhere."""
+    t0 = time.perf_counter()
+    try:
+        from torch.utils.cpp_extension import load_inline
+        ext = load_inline(
+            name="muse_bf16_lossless_v1",
+            cpp_sources=_LL_CPP,
+            cuda_sources=_LL_CUDA,
+            functions=["lossless_gemm", "lossless_decode", "lossless_attrs"],
+            extra_cuda_cflags=["-O3", "-arch=sm_90a"],
+            verbose=False,
+        )
+    except Exception as e:
+        print(f"[lossless] load_inline failed after {time.perf_counter() - t0:.1f}s, master path kept: {e!r}",
+              flush=True)
+        return None
+    print(f"[lossless] load_inline compiled in {time.perf_counter() - t0:.1f}s", flush=True)
+    return ext
+
+
+_LL_EXT = _build_lossless() if torch.cuda.is_available() else None
+
+
+def _ll_encode(w: torch.Tensor) -> dict:
+    """Lossless encode of one bf16 [N, K] weight (prepare() only, from the weight alone) into the
+    fragment-ordered payload (uint8), headers (uint8) and escape side table (raw bf16 rows)."""
+    n, k = w.shape
+    kg = k // LL_GROUP_K
+    rt = n // 16
+    dev = w.device
+    wc = w.contiguous()
+    bits = (wc.view(torch.int16).to(torch.int32) & 0xFFFF).view(n, kg, LL_GROUP_K)
+    e = (bits >> 7) & 0xFF
+    sm = ((bits >> 8) & 0x80) | (bits & 0x7F)          # sign << 7 | mantissa7
+    eref = e.amax(dim=2)                                # [n, kg]
+    c = eref.unsqueeze(2) - e                           # >= 0
+    ok = ((e >= 1) & (e <= 254) & (c <= 15)).all(dim=2)
+    esc = ~ok
+    n_esc = int(esc.sum())
+    # Escape slots in row-major (row, group) order, the same order boolean indexing returns.
+    slot = (torch.cumsum(esc.reshape(-1).to(torch.int32), 0, dtype=torch.int32) - 1).view(n, kg)
+    slot = torch.where(esc, slot, torch.zeros_like(slot))
+    shift = (torch.arange(LL_GROUP_K, device=dev, dtype=torch.int32) & 1) * 8
+    sm = torch.where(esc.unsqueeze(2), (slot.unsqueeze(2) >> shift) & 0xFF, sm)
+    c = torch.where(ok.unsqueeze(2), c, torch.zeros_like(c))
+    hdr = torch.where(ok, eref, torch.full_like(eref, 255))
+    sm8 = sm.to(torch.uint8)
+    c8 = c.to(torch.uint8)
+
+    def frag(t):
+        # [n, kg, 64] with n = (rt, rhi, g), k-in-group = (s, khi, tig, half)
+        # -> [rt, kg, lane = (g, tig), element = (s, khi, rhi, half)] = pair p = 4 s + r, r = 2 khi + rhi
+        t = t.reshape(rt, 2, 8, kg, 4, 2, 4, 2).permute(0, 3, 2, 6, 4, 5, 1, 7)
+        return t.reshape(rt, kg, 32, 32)
+
+    smf = frag(sm8).reshape(rt, kg, 32, 2, 16).permute(0, 1, 3, 2, 4)            # [rt, kg, 2, 32, 16]
+    cf = frag(c8).reshape(rt, kg, 32, 4, 2, 2, 2).permute(0, 1, 2, 3, 6, 4, 5)  # [.., s, half, khi, rhi]
+    nib = (cf[..., 0] | (cf[..., 1] << 4)).reshape(rt, kg, 1, 32, 16)
+    payload = torch.cat((smf, nib), dim=2).contiguous().view(-1)
+    hdr_t = hdr.view(rt, 16, kg).permute(0, 2, 1).to(torch.uint8).contiguous().view(-1)
+    if n_esc:
+        side = wc.view(n, kg, LL_GROUP_K)[esc].contiguous()
+    else:
+        side = torch.zeros((1, LL_GROUP_K), dtype=torch.bfloat16, device=dev)
+    nbytes = payload.numel() + hdr_t.numel() + n_esc * LL_GROUP_K * 2
+    return {"payload": payload, "hdr": hdr_t, "side": side, "n_esc": n_esc,
+            "esc_frac": n_esc / float(n * kg), "bytes": nbytes, "ratio": nbytes / float(n * k * 2)}
+
+
+def _ll_route_ok(route: str, x: torch.Tensor, cfg, state: dict) -> bool:
+    """Lossless path: the route passed its prepare() checks, 1 <= cfg m <= its max m, the problem's
+    n / k and 16-byte-aligned bf16 rows. Branches on cfg, shapes, strides and prepare() constants."""
+    spec = LL_CFG.get(route)
+    if spec is None or _LL_EXT is None or not state["lossless"].get(route, False):
+        return False
+    _wname, n, k, _split, max_m = spec
+    m = cfg["m"]
+    return (1 <= m <= max_m and cfg["n"] == n and cfg["k"] == k
+            and x.dim() == 2 and x.shape[0] == m and x.shape[1] == k
+            and x.dtype == torch.bfloat16 and x.stride(1) == 1 and x.stride(0) % 8 == 0
+            and x.data_ptr() % 16 == 0)
+
+
+def _ll_route(layer: str, cfg) -> str:
+    """Route name from cfg only: the unpooler's n == 1024 slice has its own split."""
+    if layer == "unpooler" and cfg["n"] == LL_CFG["unpooler_slice"][1]:
+        return "unpooler_slice"
+    return layer
+
+
+def _ll_forward(route: str, x: torch.Tensor, state: dict) -> torch.Tensor:
+    """x bf16 [m <= 32, k] @ W[:n].T -> bf16 [m, n], ONE launch on the compressed weight."""
+    wname, n, k, split, _ = LL_CFG[route]
+    out = torch.empty((x.shape[0], n), dtype=torch.bfloat16, device=x.device)
+    _LL_EXT.lossless_gemm(x, state["ll_payload_" + wname], state["ll_hdr_" + wname],
+                          state["ll_side_" + wname], out, state["ll_ws_" + route],
+                          state["ll_cnt_" + route], n, k, split)
+    return out
+
+
+def _ll_check_route(route: str, state: dict) -> str:
+    """GEMM self-check of one route on synthetic x against an fp64 reference, each case launched
+    twice in a row (a counter-reset bug shows on the second launch). Returns "" on a pass. The
+    1e-3 rel-L2 bound is against the fp64 reference rounded to bf16; one-hot power-of-two rows must
+    be exact (a column of the original weights)."""
+    wname, n, k, _split, max_m = LL_CFG[route]
+    w = state[wname]
+    dev = w.device
+    wd = w[:n].double()
+    g = torch.Generator(device=dev)
+    g.manual_seed(4321)
+    cases = [(m, m >= 2) for m in LL_CHECK_MS if m <= max_m] + [(1, True)]
+    for m, onehot in cases:
+        x = torch.randn((m, k), device=dev, dtype=torch.float32, generator=g).to(torch.bfloat16)
+        if onehot:
+            x[m - 1].zero_()
+            x[m - 1, (37 * m + 5) % k] = 2.0
+        ref = x.double() @ wd.T
+        ref_b = ref.to(torch.bfloat16).double()
+        out1 = _ll_forward(route, x, state)
+        out2 = _ll_forward(route, x, state)
+        torch.cuda.synchronize()
+        if not torch.equal(out1, out2):
+            return f"m={m}: second launch differs from the first"
+        o = out1.double()
+        if not bool(torch.isfinite(o).all()):
+            return f"m={m}: non-finite output"
+        err = float((o - ref_b).norm() / ref.norm().clamp_min(1e-30))
+        row_ref = ref.norm(dim=1)
+        row_den = torch.maximum(row_ref, 0.1 * row_ref.mean()).clamp_min(1e-30)
+        row_err = float(((o - ref_b).norm(dim=1) / row_den).max())
+        if not (err <= 1e-3 and row_err <= 5e-3):
+            return f"m={m}: rel L2 {err:.2e} (bound 1e-3), worst row {row_err:.2e} (bound 5e-3)"
+        if onehot and not torch.equal(o[m - 1], ref_b[m - 1]):
+            return f"m={m}: one-hot row is not exact"
+    if int(state["ll_cnt_" + route].abs().sum()) != 0:
+        return "ticket counters not reset to 0"
+    return ""
+
+
+def _ll_time_route(route: str, state: dict) -> None:
+    """Diagnostic only (prepare): warm-L2 cudaEvent time per launch with compressed and
+    raw-equivalent TB/s. Prints only; never routes."""
+    wname, n, k, _split, max_m = LL_CFG[route]
+    comp = state["ll_bytes_" + wname] * n / float(state[wname].shape[0])  # this route's share
+    for m in (1, 16, 32):
+        if m > max_m:
+            m = max_m
+        x = torch.randn((m, k), device=state[wname].device, dtype=torch.float32).to(torch.bfloat16)
+        for _ in range(3):
+            _ll_forward(route, x, state)
+        e0 = torch.cuda.Event(enable_timing=True)
+        e1 = torch.cuda.Event(enable_timing=True)
+        reps = 20
+        e0.record()
+        for _ in range(reps):
+            _ll_forward(route, x, state)
+        e1.record()
+        e1.synchronize()
+        us = e0.elapsed_time(e1) * 1e3 / reps
+        print(f"[lossless] route={route} m={m}: {us:.2f} us/launch warm-L2 (eager, incl. launch), "
+              f"{comp / (us * 1e-6) / 1e12:.2f} TB/s compressed, "
+              f"{n * k * 2 / (us * 1e-6) / 1e12:.2f} TB/s raw-equivalent", flush=True)
+        if m == max_m:
+            break
+
+
+def _lossless_prepare(state: dict) -> None:
+    """Encode each bf16 weight losslessly, gate it (exact round trip through the kernel's own
+    decoder, ratio <= 0.80, escapes <= 2.5%), then GEMM-self-check each route and enable it only on a
+    pass (state["lossless"], constants fixed here). The original weights stay in state untouched."""
+    state["lossless"] = {}
+    if _LL_EXT is None:
+        print("[lossless] PATH CHOSEN: master everywhere (no CUDA module)", flush=True)
+        return
+    dev = state["pooler"].device
+    try:
+        attrs = _LL_EXT.lossless_attrs().tolist()
+        for nt, regs, local, smem, occ in attrs:
+            print(f"[lossless] _lossless_swapab_kernel<{nt}>: {regs} regs, {local} B local (spills), "
+                  f"{smem} B dynamic smem ({LL_STAGES} stages), {occ} CTAs/SM", flush=True)
+        if any(a[4] < 1 for a in attrs):
+            print("[lossless] PATH CHOSEN: master everywhere (a kernel cannot launch: 0 CTAs/SM)", flush=True)
+            return
+    except Exception as e:
+        print(f"[lossless] attribute query failed ({e!r}); PATH CHOSEN: master everywhere", flush=True)
+        return
+    ok_w = {}
+    for wname, (n, k) in LL_WEIGHTS.items():
+        w = state[wname]
+        if not (w.dim() == 2 and tuple(w.shape) == (n, k) and w.dtype == torch.bfloat16
+                and n % 64 == 0 and k % 128 == 0):
+            print(f"[lossless] {wname} DISABLED: weight {tuple(w.shape)} {w.dtype} unexpected", flush=True)
+            continue
+        try:
+            t0 = time.perf_counter()
+            enc = _ll_encode(w)
+            t_enc = time.perf_counter() - t0
+            print(f"[lossless] {wname}: {enc['bytes'] * 8 / (n * k):.3f} bits/element, ratio {enc['ratio']:.4f}, "
+                  f"escape groups {enc['n_esc']} ({100 * enc['esc_frac']:.3f}%), "
+                  f"{enc['bytes'] / 1e6:.1f} MB compressed vs {n * k * 2 / 1e6:.1f} MB raw, "
+                  f"encode {t_enc:.2f}s", flush=True)
+            if enc["ratio"] > LL_MAX_RATIO:
+                print(f"[lossless] {wname} DISABLED: ratio {enc['ratio']:.4f} > {LL_MAX_RATIO}", flush=True)
+                continue
+            if enc["esc_frac"] > LL_MAX_ESC or enc["n_esc"] >= 65536:
+                print(f"[lossless] {wname} DISABLED: escape fraction {enc['esc_frac']:.4f} > {LL_MAX_ESC} "
+                      f"(or {enc['n_esc']} slots >= 65536)", flush=True)
+                continue
+            dec = torch.empty_like(w)
+            _LL_EXT.lossless_decode(enc["payload"], enc["hdr"], enc["side"], dec, n, k)
+            torch.cuda.synchronize()
+            exact = torch.equal(dec.view(torch.int16), w.contiguous().view(torch.int16))
+            del dec
+            if not exact:
+                print(f"[lossless] {wname} DISABLED: round trip is not bit-exact", flush=True)
+                continue
+            print(f"[lossless] {wname}: round trip bit-exact through the kernel decoder", flush=True)
+        except Exception as e:
+            print(f"[lossless] {wname} DISABLED: encode/decode raised {e!r}", flush=True)
+            continue
+        state["ll_payload_" + wname] = enc["payload"]
+        state["ll_hdr_" + wname] = enc["hdr"]
+        state["ll_side_" + wname] = enc["side"]
+        state["ll_bytes_" + wname] = enc["bytes"]
+        ok_w[wname] = True
+    for route, (wname, n, k, split, max_m) in LL_CFG.items():
+        state["ll_ws_" + route] = torch.empty((max(split, 1), LL_MAX_M, n), dtype=torch.float32, device=dev)
+        state["ll_cnt_" + route] = torch.zeros(n // 64, dtype=torch.int32, device=dev)
+        if not ok_w.get(wname, False):
+            print(f"[lossless] PATH CHOSEN route={route}: master (weight disabled)", flush=True)
+            continue
+        try:
+            why = _ll_check_route(route, state)
+        except Exception as e:
+            why = f"raised {e!r}"
+        state["ll_cnt_" + route].zero_()
+        if why:
+            print(f"[lossless] {route} DISABLED: GEMM self-check failed: {why}", flush=True)
+            print(f"[lossless] PATH CHOSEN route={route}: master", flush=True)
+            continue
+        state["lossless"][route] = True
+        print(f"[lossless] PATH CHOSEN route={route}: lossless (m 1..{max_m}, grid {(n // 64) * split} = "
+              f"{n // 64} n-tiles x SPLIT_K {split}); self-check passed", flush=True)
+        try:
+            _ll_time_route(route, state)
+        except Exception as e:
+            print(f"[lossless] route={route}: timing diagnostics failed ({e!r})", flush=True)
+        state["ll_cnt_" + route].zero_()
+    torch.cuda.synchronize()
+
