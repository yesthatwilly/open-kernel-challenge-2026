+# --- (6) o (m <= 16) and the unpooler n == 1024 slice (m <= 8): CUDA cluster/DSMEM split-K -----
+# (hypothesis o-unpooler-slice-cuda-cluster-dsmem-rewrite, rewrite stage 1)
+#
+# One templated CUDA kernel (oun_kernel), built with load_inline at import under its OWN
+# extension name and routed through its OWN prepare-time constant state["oun_cl"] (a sibling
+# rewrite uses the same design for the router elsewhere). Weight rows sit on the mma.sync
+# m16n8k16 M side and the tokens on N (NT 8 or 16). A thread-block cluster of CL CTAs splits K:
+# rank r owns K [r*K/CL, (r+1)*K/CL) of the cluster's ROWS output rows. Every CTA issues ALL of
+# its weight loads at once (NG cp.async.cg commit groups, no ring; 64 KB per CTA), the
+# smem tile is XOR-swizzled (16 B chunk c of row r stored at c ^ (r & 7)) in both the cp.async
+# destination and the ldmatrix addresses, the fp32 partial is aliased onto the consumed weight
+# buffer, and the CL partials are reduced through distributed shared memory in fixed rank order
+# (rank r reduces its ROWS/CL rows; mapa + ld.shared::cluster) with one bf16 store: no global
+# workspace, no ticket, no atomics, no memset.
+#   o        n 8192 k 1024: CL 8 -> 32 clusters x 8 = 256 CTAs (2/SM), ROWS 256, K/CTA 128, NG 2
+#                           CL 4 -> 64 clusters x 4 = 256 CTAs (2/SM), ROWS 128, K/CTA 256, NG 2
+#   slice    n 1024 k 4096: CL 8 -> 16 clusters x 8 = 128 CTAs (1/SM), ROWS  64, K/CTA 512, NG 4
+#                           CL 4 -> 32 clusters x 4 = 128 CTAs (1/SM), ROWS  32, K/CTA 1024, NG 4
+# CL 8 is used only if cudaOccupancyMaxActiveClusters reports every cluster co-resident, else CL 4
+# under the same rule, else the layer keeps master's path. All PTX is baseline sm_90.
+OUN_MAX_M = {"o": 16, "unpooler": 8}
+OUN_LAYER_ID = {"o": 0, "unpooler": 1}
+OUN_N = {"o": 8192, "unpooler": 1024}
+OUN_K = {"o": 1024, "unpooler": 4096}
+OUN_CLUSTERS_NEEDED = {("o", 8): 32, ("o", 4): 64, ("unpooler", 8): 16, ("unpooler", 4): 32}
+OUN_CHECK_MS = {"o": (1, 5, 8, 16), "unpooler": (1, 5, 8)}
