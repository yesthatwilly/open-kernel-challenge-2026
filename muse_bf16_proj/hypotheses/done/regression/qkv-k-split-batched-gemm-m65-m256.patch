+def _qk_forward(x: torch.Tensor, state: dict, choice) -> torch.Tensor:
+    """qkv_gate as S K-slices in one strided-batched cuBLAS GEMM plus one bf16 reduce. x [m, 8192]
+    contiguous. choice = (S, 'T' | 'N'). T: TN view of the weight [S, K/S, n] (strides K/S, 1,
+    K). N: view of the one NN repack state['qkv_t'] [K, n] as [S, K/S, n] (contiguous slices)."""
+    s, layout = choice
+    m = x.shape[0]
+    ks = QKV_K // s
+    xs = x.view(m, s, ks).permute(1, 0, 2)
+    if layout == "T":
+        ws = state["qkv_gate"].view(QKV_N, s, ks).permute(1, 2, 0)
+    else:
+        ws = state["qkv_t"].view(s, ks, QKV_N)
+    p = torch.bmm(xs, ws)
+    if s == 2:
+        return torch.add(p[0], p[1])
+    return p.sum(0)
+
+
+def _qk_kernel_names(fn) -> list:
+    """Names of the CUDA kernels one eager call of fn launches (torch.profiler)."""
+    from torch.profiler import ProfilerActivity, profile
+    fn()
+    torch.cuda.synchronize()
+    with profile(activities=[ProfilerActivity.CPU, ProfilerActivity.CUDA]) as prof:
+        fn()
+        torch.cuda.synchronize()
+    return [e.name for e in prof.events() if e.device_type == torch.autograd.DeviceType.CUDA]
+
+
+def _qk_names_ok(names: list) -> bool:
+    """Disqualify only a copy / contiguous kernel (torch copied a slice view) or a cuBLAS splitKreduce.
+    Counts are printed, not asserted (S=4's sum launches a reduce_kernel; CUPTI may return no events)."""
+    low = [n.lower() for n in names]
+    gemm = [n for n in low if ("nvjet" in n or "cutlass" in n or "gemm" in n or "sm90" in n)
+            and "reduce" not in n and "elementwise" not in n]
+    copies = [n for n in low if n not in gemm and ("memcpy" in n or "copy" in n or "contiguous" in n)]
+    reduce_k = [n for n in low if "splitkreduce" in n]
+    print(f"[qksplit] kernel name check: {len(low)} CUDA events, gemm {len(gemm)}, copies {len(copies)}, "
+          f"splitKreduce {len(reduce_k)}"
+          + ("; profiler saw no CUDA kernels, name check skipped" if not low else ""), flush=True)
+    return not copies and not reduce_k
+
+
+def _qk_select(state: dict) -> None:
+    """prepare()-only, state A only, AFTER _lt_prepare (so LT_FLAG is final and kernel_fn with the
+    new flag off is exactly what master runs per m). For m in QKSPLIT_MS: capture master's
+    kernel_fn and the four candidates (S 2/4 x TN/NN) as CUDA graphs on the same synthetic x, check
+    numerics against the fp32 reference and kernel names, replay interleaved with a 256 MB flush
+    before each replay (41 reps, empty-graph baseline subtracted), print medians, IQR and kernel
+    names for every candidate even when master is kept, and route the best only if master /
+    candidate >= QKSPLIT_MIN_WIN. Fixes state['qkv_ksplit'] ({m: (S, layout)}) and
+    state['qkv_ksplit_ok']. Never raises."""
+    state["qkv_ksplit"] = {}
+    state["qkv_ksplit_ok"] = False
+    chosen = {}
+    flush = scratch = None
+    try:
+        w = state["qkv_gate"]
+        wt = state["qkv_t"]
+        if not (w.dim() == 2 and tuple(w.shape) == (QKV_N, QKV_K) and w.dtype == torch.bfloat16
+                and w.is_contiguous() and wt.is_contiguous() and tuple(wt.shape) == (QKV_K, QKV_N)):
+            print(f"[qksplit] PATH CHOSEN: qkv_gate m={QKSPLIT_MS} -> master: weight layout unexpected", flush=True)
+            return
+        dev = w.device
+        flush = torch.empty(OUNS_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+        scratch = torch.zeros(1, dtype=torch.float32, device=dev)
+        ev = [torch.cuda.Event(enable_timing=True) for _ in range(2)]
+
+        def replay_us(g) -> float:
+            flush.zero_()
+            ev[0].record()
+            g.replay()
+            ev[1].record()
+            ev[1].synchronize()
+            return ev[0].elapsed_time(ev[1]) * 1e3
+
+        def capture(fn):
+            for _ in range(3):
+                fn()
+            torch.cuda.synchronize()
+            g = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(g):
+                fn()
+            torch.cuda.synchronize()
+            return g
+
+        g_base = capture(lambda: scratch.add_(1.0))
+        base = _ouns_median([replay_us(g_base) for _ in range(OUNS_GATE_REPS)])
+        wref = w.float()
+        for m in QKSPLIT_MS:
+            x = torch.randn((m, QKV_K), device=dev, dtype=torch.float32).to(torch.bfloat16)
+            cfg = {"m": m, "n": QKV_N, "k": QKV_K, "layer": "qkv_gate"}
+            data = {"x": x, "config": cfg}
+            fns = {"master": (lambda data=data: kernel_fn(data, state))}
+            for c in QKSPLIT_CANDS:
+                fns[c] = (lambda x=x, c=c: _qk_forward(x, state, c))
+            ref = x.float() @ wref.T
+            valid, names = {}, {}
+            for name, fn in fns.items():
+                ok = False
+                try:
+                    print(f"[qksplit] m={m}: checking {name} ...", flush=True)
+                    o = fn()
+                    torch.cuda.synchronize()
+                    err = float((o.float() - ref).norm() / ref.norm().clamp_min(1e-30))
+                    names[name] = _qk_kernel_names(fn)
+                    ok = bool(torch.isfinite(o).all()) and err <= AB_BF16_REL_L2
+                    if name != "master":
+                        ok = ok and _qk_names_ok(names[name])
+                    print(f"[qksplit] m={m}: {name} rel L2 {err:.2e} kernels {names[name]} valid={ok}", flush=True)
+                except Exception as e:
+                    print(f"[qksplit] m={m}: {name} check failed ({type(e).__name__}: {e}); invalid", flush=True)
+                valid[name] = ok
+            if not valid.get("master"):
+                print(f"[qksplit] m={m}: master reference invalid; master kept", flush=True)
+                continue
+            live = [n for n in fns if valid[n]]
+            graphs = {name: capture(fns[name]) for name in live}
+            times = {name: [] for name in live}
+            for rep in range(OUNS_GATE_REPS):
+                order = live if rep % 2 == 0 else live[::-1]
+                for name in order:
+                    times[name].append(replay_us(graphs[name]))
+            med, adj, iqr = {}, {}, {}
+            for name, v in times.items():
+                sv = sorted(v)
+                med[name] = sv[len(sv) // 2]
+                iqr[name] = sv[(3 * len(sv)) // 4] - sv[len(sv) // 4]
+                adj[name] = max(med[name] - base, 0.25)
+            best, best_ratio = None, 1.0
+            for c in QKSPLIT_CANDS:
+                if c in adj:
+                    ratio = adj["master"] / adj[c]
+                    print(f"[qksplit] m={m}: master median {med['master']:.2f} us (IQR {iqr['master']:.2f}), cand "
+                          f"S={c[0]} {c[1]} median {med[c]:.2f} us (IQR {iqr[c]:.2f}), empty-graph baseline "
+                          f"{base:.2f} us -> net {adj['master']:.2f} vs {adj[c]:.2f} us, master/cand {ratio:.3f}x "
+                          f"(need >= {QKSPLIT_MIN_WIN})", flush=True)
+                    if ratio > best_ratio:
+                        best, best_ratio = c, ratio
+                else:
+                    print(f"[qksplit] m={m}: cand S={c[0]} {c[1]} not timed (invalid)", flush=True)
+            if best is not None and best_ratio >= QKSPLIT_MIN_WIN:
+                chosen[m] = best
+            graphs.clear()
+    except Exception as e:
+        print(f"[qksplit] selector failed ({type(e).__name__}: {e}); master path kept", flush=True)
+        chosen = {}
+    finally:
+        flush = None
+        scratch = None
+        try:
+            torch.cuda.synchronize()
+        except Exception:
+            pass
+    state["qkv_ksplit"] = dict(chosen)
+    state["qkv_ksplit_ok"] = bool(chosen)
+    for m in QKSPLIT_MS:
+        print(f"[qksplit] PATH CHOSEN: qkv_gate m={m} -> "
+              + (f"K-split S={chosen[m][0]} {chosen[m][1]} bmm + reduce" if m in chosen else "master"),
+              flush=True)
+
