+
+// (leading, unit, batch) strides built with cute::make_stride (no cutlass/util dependency).
+// A RowMajor [M,K,L], B ColumnMajor [N,K,L], C/D RowMajor [M,N,L] are all Stride<int64_t, _1, int64_t>.
+template <class Stride>
+Stride ld_stride(int64_t ld, int64_t batch) {
+  auto s = cute::make_stride(ld, cute::Int<1>{}, batch);
+  static_assert(std::is_same<decltype(s), Stride>::value, "streamk: unexpected CUTLASS stride type");
+  return s;
+}
+
+// Scheduler argument names moved across CUTLASS 3.x / 4.x: set each only if it exists.
+template <class T, class = void> struct has_decomposition_mode : std::false_type {};
+template <class T>
+struct has_decomposition_mode<T, std::void_t<decltype(std::declval<T&>().decomposition_mode)>>
+    : std::true_type {};
+template <class T, class = void> struct has_reduction_mode : std::false_type {};
+template <class T>
+struct has_reduction_mode<T, std::void_t<decltype(std::declval<T&>().reduction_mode)>>
+    : std::true_type {};
+template <class T, class = void> struct has_sk_tiles : std::false_type {};
+template <class T>
+struct has_sk_tiles<T, std::void_t<decltype(std::declval<T const&>().sk_tiles_)>> : std::true_type {};
+template <class T, class = void> struct has_sk_units : std::false_type {};
+template <class T>
+struct has_sk_units<T, std::void_t<decltype(std::declval<T const&>().sk_units_)>> : std::true_type {};
+
+// mode: 0 Heuristic, 1 DataParallel, 3 StreamK. Returns 1 if the decomposition mode could be set.
+template <class SA>
+int64_t set_scheduler(SA& sa, int64_t mode) {
+  int64_t applied = 0;
+  if constexpr (has_decomposition_mode<SA>::value) {
+    using DM = std::remove_cv_t<std::remove_reference_t<decltype(sa.decomposition_mode)>>;
+    sa.decomposition_mode = mode == 3 ? DM::StreamK : (mode == 1 ? DM::DataParallel : DM::Heuristic);
+    applied = 1;
+  }
+  if constexpr (has_reduction_mode<SA>::value) {
+    using RM = std::remove_cv_t<std::remove_reference_t<decltype(sa.reduction_mode)>>;
+    sa.reduction_mode = RM::Deterministic;  // fixed summation order
+  }
+  return applied;
+}
+
+template <class P> int64_t get_sk_tiles(P const& p) {
+  if constexpr (has_sk_tiles<P>::value) { return static_cast<int64_t>(p.sk_tiles_); } else { return -1; }
+}
+template <class P> int64_t get_sk_units(P const& p) {
+  if constexpr (has_sk_units<P>::value) { return static_cast<int64_t>(p.sk_units_); } else { return -1; }
+}
+
+Arguments make_args(void const* x, void const* w, void* out, int m, int n, int k, int64_t mode,
+                    int sm_count, int device_id, int64_t* mode_applied) {
+  cutlass::KernelHardwareInfo hw_info;
+  hw_info.device_id = device_id;
+  hw_info.sm_count = sm_count;
+  Arguments args{
+      cutlass::gemm::GemmUniversalMode::kGemm,
+      ProblemShape{m, n, k, 1},
+      {static_cast<ElementA const*>(x), ld_stride<StrideA>(k, static_cast<int64_t>(m) * k),
+       static_cast<ElementB const*>(w), ld_stride<StrideB>(k, static_cast<int64_t>(n) * k)},
+      {{}, nullptr, ld_stride<StrideC>(n, static_cast<int64_t>(m) * n),
+       static_cast<ElementD*>(out), ld_stride<StrideD>(n, static_cast<int64_t>(m) * n)},
+      hw_info};
+  args.epilogue.thread.alpha = 1.0f;
+  args.epilogue.thread.beta = 0.0f;
+  int64_t applied = set_scheduler(args.scheduler, mode);
+  if (mode_applied != nullptr) { *mode_applied = applied; }
+  return args;
+}
+
+void check_operands(torch::Tensor const& x, torch::Tensor const& w, torch::Tensor const& out, int m) {
+  TORCH_CHECK(x.is_cuda() && w.is_cuda() && out.is_cuda(), "streamk: CUDA tensors required");
+  TORCH_CHECK(x.scalar_type() == at::kBFloat16 && w.scalar_type() == at::kBFloat16 &&
+              out.scalar_type() == at::kBFloat16, "streamk: bf16 x / w / out required");
+  TORCH_CHECK(x.dim() == 2 && w.dim() == 2 && out.dim() == 2, "streamk: 2-D tensors required");
+  TORCH_CHECK(x.is_contiguous() && w.is_contiguous() && out.is_contiguous(), "streamk: contiguous required");
+  TORCH_CHECK(x.size(1) == w.size(1) && out.size(1) == w.size(0), "streamk: shape mismatch");
+  TORCH_CHECK(m >= 1 && m <= x.size(0) && m <= out.size(0), "streamk: m out of range");
+  TORCH_CHECK(w.size(1) % kAlign == 0 && w.size(0) % kAlign == 0, "streamk: n / k not 16 B aligned");
+}
