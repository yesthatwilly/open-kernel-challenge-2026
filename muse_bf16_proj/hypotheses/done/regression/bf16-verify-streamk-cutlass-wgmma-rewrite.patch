+def _streamk_prepare(state: dict) -> None:
+    """Per-layer setup and SELF-CHECK of the stream-K path. Sets state['streamk_ok'][layer], a
+    constant fixed here; every failure prints '[streamk] <layer> DISABLED: <reason>' and keeps
