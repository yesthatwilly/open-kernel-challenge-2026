+              flush=True)
+    except Exception as e:
+        print(f"[streamk] ALL DISABLED: cudaFuncSetAttribute failed: {e!r}", flush=True)
+        return
+
+    # Workspace: query every m in 129..256 for every layer; allocate the max once.
