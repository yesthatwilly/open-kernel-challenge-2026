+}  // namespace sk
+
+// out[m, n] = x[m, k] @ w[n, k]^T on the current stream. Branches on shapes only.
+void streamk_gemm(torch::Tensor x, torch::Tensor w, torch::Tensor out, torch::Tensor ws,
+                  int64_t mode, int64_t sm_count) {
+  const int m = static_cast<int>(x.size(0));
+  const int n = static_cast<int>(w.size(0));
+  const int k = static_cast<int>(w.size(1));
+  sk::check_operands(x, w, out, m);
+  TORCH_CHECK(out.size(0) == m, "streamk: out rows != m");
+  TORCH_CHECK(ws.is_cuda() && ws.is_contiguous(), "streamk: workspace must be a contiguous CUDA tensor");
+  auto args = sk::make_args(x.data_ptr(), w.data_ptr(), out.data_ptr(), m, n, k, mode,
+                            static_cast<int>(sm_count), x.get_device(), nullptr);
+  cutlass::Status st = sk::Gemm::can_implement(args);
+  TORCH_CHECK(st == cutlass::Status::kSuccess, "streamk: can_implement failed: ", cutlassGetStatusString(st));
+  const size_t need = sk::Gemm::get_workspace_size(args);
+  TORCH_CHECK(need <= static_cast<size_t>(ws.nbytes()), "streamk: workspace too small (need ", need,
+              " B, have ", ws.nbytes(), " B)");
+  cudaStream_t stream = at::cuda::getCurrentCUDAStream(x.get_device()).stream();
+  // GemmUniversalAdapter::initialize() split in two so the timed path does not repeat the
+  // cudaFuncSetAttribute call (done once in prepare() by streamk_set_attr):
+  // (1) zero the stream-K barrier region on the stream (one memset node under graph capture),
+  st = sk::GemmKernel::initialize_workspace(args, ws.data_ptr(), stream);
+  TORCH_CHECK(st == cutlass::Status::kSuccess, "streamk: initialize_workspace failed: ",
+              cutlassGetStatusString(st));
+  // (2) host-side params (TMA descriptors from these pointers, scheduler from the shape),
+  auto params = sk::GemmKernel::to_underlying_arguments(args, ws.data_ptr());
+  // (3) one cluster launch of the persistent kernel on the current stream.
+  st = sk::Gemm::run(params, stream);
+  TORCH_CHECK(st == cutlass::Status::kSuccess, "streamk: run failed: ", cutlassGetStatusString(st));
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
+
+// Host-only query for problem rows m (x / out may be taller; only their pointers are used):
+// {can_implement, workspace bytes, grid x, y, z, smem bytes, threads, decomposition-mode applied,
+//  sk_tiles (-1 n/a), sk_units (-1 n/a), CUTLASS version as MAJOR*10000 + MINOR*100 + PATCH}.
+std::vector<int64_t> streamk_query(torch::Tensor x, torch::Tensor w, torch::Tensor out, int64_t m,
+                                   int64_t mode, int64_t sm_count) {
+  const int mi = static_cast<int>(m);
+  const int n = static_cast<int>(w.size(0));
+  const int k = static_cast<int>(w.size(1));
+  sk::check_operands(x, w, out, mi);
+  int64_t applied = 0;
+  auto args = sk::make_args(x.data_ptr(), w.data_ptr(), out.data_ptr(), mi, n, k, mode,
+                            static_cast<int>(sm_count), x.get_device(), &applied);
+  const int64_t can = sk::Gemm::can_implement(args) == cutlass::Status::kSuccess ? 1 : 0;
+  const int64_t ws = static_cast<int64_t>(sk::Gemm::get_workspace_size(args));
+  auto params = sk::GemmKernel::to_underlying_arguments(args, nullptr);
+  dim3 grid = sk::GemmKernel::get_grid_shape(params);
+  return {can, ws, static_cast<int64_t>(grid.x), static_cast<int64_t>(grid.y), static_cast<int64_t>(grid.z),
+          static_cast<int64_t>(sk::GemmKernel::SharedStorageSize),
+          static_cast<int64_t>(sk::GemmKernel::MaxThreadsPerBlock), applied,
+          sk::get_sk_tiles(params.scheduler), sk::get_sk_units(params.scheduler),
+          static_cast<int64_t>(CUTLASS_MAJOR * 10000 + CUTLASS_MINOR * 100 + CUTLASS_PATCH)};
+}
+
+// Raise the kernel's dynamic shared-memory limit once (prepare()); returns the bytes requested.
+int64_t streamk_set_attr() {
+  const int smem = static_cast<int>(sk::GemmKernel::SharedStorageSize);
+  C10_CUDA_CHECK(cudaFuncSetAttribute(cutlass::device_kernel<sk::GemmKernel>,
+                                      cudaFuncAttributeMaxDynamicSharedMemorySize, smem));
+  return static_cast<int64_t>(smem);
+}
+"""
+
+
+def _cutlass_version(include_dir: str):
+    """(MAJOR, MINOR, PATCH) from <include_dir>/cutlass/version.h, or None."""
+    try:
+        with open(os.path.join(include_dir, "cutlass", "version.h")) as f:
+            txt = f.read()
+        ver = []
+        for key in ("MAJOR", "MINOR", "PATCH"):
+            mm = re.search(r"#define\s+CUTLASS_" + key + r"\s+(\d+)", txt)
+            ver.append(int(mm.group(1)) if mm else -1)
+        return tuple(ver)
+    except Exception:
+        return None
+
+
+def _find_cutlass_includes():
+    """Glob the importlib-resolved package dirs of flashinfer / deep_gemm / sgl_kernel / tilelang /
+    cutlass_library plus /usr/local/cutlass and /usr/include for
+    cutlass/gemm/collective/collective_builder.hpp with a sibling cute/ (and the sm90 stream-K
+    scheduler). Prints every hit; returns [(version, include_dir, source)] newest first."""
+    roots = []
+    for pkg in _CUTLASS_PKGS:
+        try:
+            spec = importlib.util.find_spec(pkg)
+        except Exception as e:
+            print(f"[streamk] headers: find_spec({pkg}) raised {type(e).__name__}: {e}", flush=True)
+            continue
+        if spec is None:
+            print(f"[streamk] headers: package {pkg} not installed", flush=True)
+            continue
+        locs = list(spec.submodule_search_locations or [])
+        if not locs and spec.origin:
+            locs = [os.path.dirname(spec.origin)]
+        roots += [(pkg, p) for p in locs]
+    roots += [("system", "/usr/local/cutlass"), ("system", "/usr/include")]
+    hits, seen = [], set()
+    for src, root in roots:
+        if not os.path.isdir(root):
+            continue
+        try:
+            found = glob.glob(os.path.join(root, "**", _CUTLASS_BUILDER_REL), recursive=True)
+        except Exception as e:
+            print(f"[streamk] headers: glob under {root} raised {type(e).__name__}: {e}", flush=True)
+            continue
+        for path in found:
+            inc = os.path.realpath(path[: -len(_CUTLASS_BUILDER_REL)].rstrip(os.sep))
+            if inc in seen:
+                continue
+            seen.add(inc)
+            has_cute = os.path.isdir(os.path.join(inc, "cute"))
+            has_sk = os.path.isfile(os.path.join(inc, "cutlass", "gemm", "kernel",
+                                                 "sm90_tile_scheduler_stream_k.hpp"))
+            ver = _cutlass_version(inc)
+            print(f"[streamk] headers: hit src={src} include={inc} version={ver} cute/={has_cute} "
+                  f"sm90_stream_k={has_sk}", flush=True)
+            if has_cute and has_sk and ver is not None and ver[0] >= 3:
+                hits.append((ver, inc, src))
+    hits.sort(key=lambda h: h[0], reverse=True)
+    return hits
+
+
+def _build_streamk():
+    """Compile the CUTLASS stream-K module once per process, at import (never during capture).
+    Tries the newest usable CUTLASS tree, then one other version if the first build fails and
+    time allows. Returns the module or None (master path everywhere)."""
+    t_all = time.perf_counter()
+    try:
+        hits = _find_cutlass_includes()
+    except Exception as e:
+        print(f"[streamk] header search raised {type(e).__name__}: {e}; master kept", flush=True)
+        return None
+    if not hits:
+        print("[streamk] no CUTLASS headers, master kept", flush=True)
+        return None
+    try:
+        from torch.utils.cpp_extension import load_inline
+    except Exception as e:
+        print(f"[streamk] cpp_extension unavailable ({e!r}); master kept", flush=True)
+        return None
+    tried = []
+    for ver, inc, src in hits:
+        if len(tried) >= 2 or ver in tried:
+            continue
+        if tried and time.perf_counter() - t_all > 150.0:
+            print("[streamk] build: no time for another CUTLASS tree", flush=True)
+            break
+        tried.append(ver)
+        t0 = time.perf_counter()
+        print(f"[streamk] build: CUTLASS {ver} from {src}: {inc}", flush=True)
+        # sm_90a only: torch's cpp_extension otherwise adds its own compute_90 -gencode from
+        # TORCH_CUDA_ARCH_LIST / the device, and that pass cannot assemble wgmma (LESSONS 2026-10-25).
+        _arch_prev = os.environ.get("TORCH_CUDA_ARCH_LIST")
+        os.environ["TORCH_CUDA_ARCH_LIST"] = "9.0a"
+        try:
+            ext = load_inline(
+                name=f"muse_bf16_streamk_v1_c{ver[0]}_{ver[1]}_{ver[2]}",
+                cpp_sources=_STREAMK_CPP,
+                cuda_sources=_STREAMK_CUDA,
+                functions=["streamk_gemm", "streamk_query", "streamk_set_attr"],
+                extra_include_paths=[inc],
+                extra_cflags=["-O3"],
+                extra_cuda_cflags=[
+                    # -std is left to torch (it appends -std=c++17 unless one is given).
+                    "-O3", "-DNDEBUG", "--expt-relaxed-constexpr", "--expt-extended-lambda",
+                    "-gencode=arch=compute_90a,code=sm_90a",
+                    "-U__CUDA_NO_HALF_OPERATORS__", "-U__CUDA_NO_HALF_CONVERSIONS__",
+                    "-U__CUDA_NO_HALF2_OPERATORS__", "-U__CUDA_NO_BFLOAT16_CONVERSIONS__",
+                    "-U__CUDA_NO_BFLOAT16_OPERATORS__",
+                    "-DCUTLASS_DEBUG_TRACE_LEVEL=0",
+                ],
+                verbose=False,
+            )
+        except Exception as e:
+            msg = repr(e)
+            if _arch_prev is None:
+                os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+            else:
+                os.environ["TORCH_CUDA_ARCH_LIST"] = _arch_prev
+            print(f"[streamk] build FAILED after {time.perf_counter() - t0:.1f}s with CUTLASS {ver}: "
+                  f"{msg[-3000:]}", flush=True)
+            continue
+        if _arch_prev is None:
+            os.environ.pop("TORCH_CUDA_ARCH_LIST", None)
+        else:
+            os.environ["TORCH_CUDA_ARCH_LIST"] = _arch_prev
+        print(f"[streamk] build OK: load_inline compiled in {time.perf_counter() - t0:.1f}s "
+              f"(CUTLASS {ver}, {inc})", flush=True)
+        return ext
+    print("[streamk] build: every attempt failed, master kept", flush=True)
+    return None
+
+
+_STREAMK_EXT = None
+if torch.cuda.is_available():
+    _STREAMK_EXT = _build_streamk()
+
+
+def _streamk_route_ok(layer: str, x: torch.Tensor, state: dict, cfg) -> bool:
+    """Stream-K path: a bf16 layer whose prepare() self-check passed, 129 <= cfg m <= 256, cfg n/k
+    equal to the full weight, x a contiguous bf16 [m, k]. Branches on cfg and shapes only."""
+    ok = state.get("streamk_ok")
+    if _STREAMK_EXT is None or not ok or not ok.get(layer, False):
+        return False
+    w = state[layer]
+    m = cfg["m"]
+    return (STREAMK_MIN_M <= m <= STREAMK_MAX_M and cfg["n"] == w.shape[0] and cfg["k"] == w.shape[1]
+            and x.dim() == 2 and x.shape[0] == m and x.shape[1] == w.shape[1]
+            and x.dtype == torch.bfloat16 and x.is_contiguous() and x.data_ptr() % 16 == 0)
+
+
+def _streamk_forward(layer: str, x: torch.Tensor, state: dict) -> torch.Tensor:
+    """x bf16 [m, k] @ W[n, k].T -> bf16 [m, n], one CUTLASS launch (plus the stream-K barrier
+    memset initialize() may issue) into the prepare()-allocated workspace."""
+    w = state[layer]
+    out = torch.empty((x.shape[0], w.shape[0]), dtype=torch.bfloat16, device=x.device)
+    _STREAMK_EXT.streamk_gemm(x, w, out, state["streamk_ws"], STREAMK_MODES[layer], state["streamk_sms"])
+    return out
+
+
+def _streamk_time_us(fn, iters: int = 20) -> float:
+    """Warm-L2 cudaEvent time per call in us (prepare-time diagnostics only; never routes)."""
+    for _ in range(3):
+        fn()
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(iters):
+        fn()
+    end.record()
+    end.synchronize()
+    return start.elapsed_time(end) * 1000.0 / iters
+
