+              "129 <= m <= 256", flush=True)
+        return
+    ext = _STREAMK_EXT
+    dev = state["qkv_gate"].device
+    sms = torch.cuda.get_device_properties(dev).multi_processor_count
+    state["streamk_sms"] = sms
