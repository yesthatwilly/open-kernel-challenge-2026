+                oq = torch.empty((STREAMK_MAX_M, w.shape[0]), dtype=torch.bfloat16, device=dev)
+                sizes = []
+                for m in range(STREAMK_MIN_M, STREAMK_MAX_M + 1):
+                    q = ext.streamk_query(xq, w, oq, m, mode, sms)
+                    if q[0] != 1:
+                        reason = f"can_implement failed at m={m}"
+                        break
+                    sizes.append(q[1])
+                    if m in (STREAMK_MIN_M, 200, STREAMK_MAX_M):
+                        print(f"[streamk] {layer} m={m} n={w.shape[0]} k={w.shape[1]} "
+                              f"requested={_STREAMK_MODE_NAMES.get(mode, mode)} mode_set={bool(q[7])} "
+                              f"grid=({q[2]},{q[3]},{q[4]}) threads={q[6]} smem={q[5]} B "
+                              f"workspace={q[1]} B sk_tiles={q[8]} sk_units={q[9]} "
+                              f"(DataParallel if sk_tiles == 0) CUTLASS={q[10]}", flush=True)
+                if reason is None:
+                    need[layer] = max(sizes)
+                    print(f"[streamk] {layer} workspace bytes over m 129..256: min {min(sizes)} "
+                          f"max {max(sizes)}", flush=True)
+            except Exception as e:
+                reason = f"query raised {e!r}"
+        if reason is not None:
+            print(f"[streamk] {layer} DISABLED: {reason}", flush=True)
+        else:
+            usable[layer] = True
+    if not usable:
+        print("[streamk] PATH CHOSEN: every layer keeps master cuBLAS at 129 <= m <= 256", flush=True)
+        return
+    ws_bytes = max(max(need.values()), 8)
+    state["streamk_ws"] = torch.zeros(((ws_bytes + 7) // 8,), dtype=torch.int64, device=dev)
+    print(f"[streamk] workspace allocated once: {ws_bytes} B (max over layers {need})", flush=True)
+    for layer, nb in need.items():
+        assert nb <= state["streamk_ws"].numel() * 8, f"streamk workspace too small for {layer}"
+
+    # SELF-CHECK on synthetic x (weights only): m in {130, 200, 256}, two runs each through the
+    # shared workspace.
+    gen = torch.Generator(device=dev)
+    gen.manual_seed(1234)
+    for layer in usable:
+        w = state[layer]
+        n, k = w.shape
+        reason = None
+        try:
+            wd = w.double()
+            for m in _STREAMK_SELF_CHECK_MS:
+                x = torch.randn((m, k), device=dev, dtype=torch.float32, generator=gen).to(torch.bfloat16)
+                probe_col = (37 * m) % k
+                x[0].zero_()
+                x[0, probe_col] = 2.0  # one-hot power-of-two row: output must be 2 * W[:, col] exactly
+                out1 = torch.empty((m, n), dtype=torch.bfloat16, device=dev)
+                out2 = torch.empty((m, n), dtype=torch.bfloat16, device=dev)
+                ext.streamk_gemm(x, w, out1, state["streamk_ws"], STREAMK_MODES[layer], sms)
+                ext.streamk_gemm(x, w, out2, state["streamk_ws"], STREAMK_MODES[layer], sms)
+                ref = x.double() @ wd.T
+                o1 = out1.double()
+                err = ((o1 - ref).norm() / ref.norm().clamp_min(1e-30)).item()
+                pref = 2.0 * wd[:, probe_col]
+                perr = ((o1[0] - pref).norm() / pref.norm().clamp_min(1e-30)).item()
+                finite = bool(torch.isfinite(out1).all().item())
+                same = bool(torch.equal(out1, out2))
+                print(f"[streamk] self-check {layer} m={m}: rel L2 {err:.2e} probe {perr:.2e} "
+                      f"finite {finite} run2-bit-identical {same}", flush=True)
+                if not finite:
+                    reason = f"non-finite output at m={m}"
+                elif err > 3e-3:
+                    reason = f"rel L2 {err:.2e} > 3e-3 at m={m}"
+                elif perr > 1e-4:
+                    reason = f"one-hot probe rel err {perr:.2e} > 1e-4 at m={m}"
+                elif not same:
+                    reason = f"second run not bit-identical at m={m}"
+                if reason is not None:
+                    break
+        except Exception as e:
+            reason = f"self-check raised {e!r}"
+        if reason is not None:
+            print(f"[streamk] {layer} DISABLED: {reason}", flush=True)
+            continue
+        state["streamk_ok"][layer] = True
+
+    # DIAGNOSTICS (print-only, never routing): warm-L2 kernel time at m=256, CUTLASS vs master cuBLAS.
+    for layer, enabled in state["streamk_ok"].items():
+        if not enabled:
+            continue
+        try:
+            w = state[layer]
+            n, k = w.shape
+            x = torch.randn((STREAMK_MAX_M, k), device=dev, dtype=torch.float32, generator=gen).to(torch.bfloat16)
+            out = torch.empty((STREAMK_MAX_M, n), dtype=torch.bfloat16, device=dev)
+            mode = STREAMK_MODES[layer]
+            t_sk = _streamk_time_us(lambda: ext.streamk_gemm(x, w, out, state["streamk_ws"], mode, sms))
+            t_cb = _streamk_time_us(lambda: _bf16_gemm_dispatch_impl(x, w, None))
+            flop = 2.0 * STREAMK_MAX_M * n * k
+            print(f"[streamk] diag {layer} m=256 warm-L2: cutlass {t_sk:.2f} us "
+                  f"({flop / t_sk * 1e-6:.0f} TFLOP/s) vs cuBLAS {t_cb:.2f} us "
+                  f"({flop / t_cb * 1e-6:.0f} TFLOP/s)", flush=True)
+        except Exception as e:
+            print(f"[streamk] diag {layer}: unavailable ({type(e).__name__}: {e})", flush=True)
+
+    for layer, enabled in state["streamk_ok"].items():
+        if enabled:
+            print(f"[streamk] PATH CHOSEN {layer}: 129 <= m <= 256 -> CUTLASS sm90 stream-K "
+                  f"({_STREAMK_MODE_NAMES[STREAMK_MODES[layer]]}, tile 128x128x64, cluster 2x1x1)",
+                  flush=True)
+        else:
+            print(f"[streamk] PATH CHOSEN {layer}: 129 <= m <= 256 -> master cuBLAS", flush=True)
+
