+# ---------------------------------------------------------------------------------------------
+# Bulk-TMA row-owner stream (hypothesis pooler-unpooler-full-bulk-tma-row-owner-stream-rewrite):
+# pooler (n=4096, k=8192) at 1 <= m <= 32 and the full unpooler (n=8192, k=4096) at 9 <= m <= 32.
+# One CUDA kernel (load_inline, mma.sync, plain sm_90 instructions), grid 128 CTAs, 1 CTA/SM,
+# 160 threads: warp 0 is the producer (cp.async.bulk + mbarrier full/empty ring, 6 stages), warps
+# 1-4 are consumers (each owns a quarter of every chunk's K). Each CTA owns R output rows (32 for
+# the pooler, 64 for the unpooler) over the WHOLE K: no split-K, no workspace, no ticket, no tail.
+# prepare() repacks each weight losslessly (a pure permutation of bf16 values) into
+# Wt[cta][kblock][row][64 k] with the 16 B segments of every 128 B row XOR-swizzled by (row & 7),
+# so a CTA's 512 KB is one contiguous span and each 16 KB chunk is one 1-D bulk copy that lands
+# ldmatrix-ready. The x chunk [m tokens x CKK] rides in the same slot (m row copies of CKK*2 B,
+# row stride padded by 16 B in smem). Slot columns >= m are never written: MMA columns are
+# independent and those accumulators are never stored, so stale smem there is harmless.
+# ---------------------------------------------------------------------------------------------
+BULK_EXT_NAME = "okc_bf16_bulk_rowown_s1"
+BULK_POOLER_N, BULK_POOLER_K = 4096, 8192
+BULK_UNPOOLER_N, BULK_UNPOOLER_K = 8192, 4096
+# This hypothesis's OWN gate constants (never derived from the other paths' bounds).
+BULK_POOLER_MIN_M, BULK_POOLER_MAX_M = 1, 32
+BULK_UNPOOLER_MIN_M, BULK_UNPOOLER_MAX_M = 9, 32
+# Every routed m bucket (NT 8 / 16 / 32) is checked at an interior m as well as its scored ends.
+BULK_SELFCHECK_MS = {"pooler": (1, 7, 8, 12, 16, 24, 32), "unpooler": (9, 16, 24, 32)}
+BULK_REL_L2 = 3e-3
+BULK_PROBE_TOL = 1e-4
+BULK_READ_GATE_TBS = 3.8   # in-run kill gate: cold pure-read below this disables the route
+BULK_STREAM_BYTES = 128 * 512 * 1024  # 67,108,864 B per layer
+BULK_FLUSH_BYTES = 256 * 1024 * 1024
+
+# Master's numbers (run 1602a4e947e64090) the review asked to restate; print-only.
+BULK_INCUMBENT_US = {("pooler", 1): 19.0, ("pooler", 8): 19.3, ("pooler", 16): 19.5,
+                     ("pooler", 32): 20.5, ("unpooler", 16): 18.5, ("unpooler", 32): 18.9}
