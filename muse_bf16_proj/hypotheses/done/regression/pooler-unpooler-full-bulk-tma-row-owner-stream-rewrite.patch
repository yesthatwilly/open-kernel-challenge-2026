+def _bulk_median_us(fn, flush: torch.Tensor, reps: int = 25) -> float:
+    """Cold-L2 per-launch time: a 256 MB flush is enqueued, then start event, launch, stop event
+    (the host enqueues them while the flush runs, so there is no idle gap). Prepare-time only."""
+    for _ in range(3):
+        flush.zero_()
+        fn()
+    torch.cuda.synchronize()
+    ts = []
+    for _ in range(reps):
+        flush.zero_()
+        a = torch.cuda.Event(enable_timing=True)
+        b = torch.cuda.Event(enable_timing=True)
+        a.record()
+        fn()
+        b.record()
+        torch.cuda.synchronize()
+        ts.append(a.elapsed_time(b) * 1000.0)
+    ts.sort()
+    return ts[len(ts) // 2]
+
