+            rates[layer] = tbs_c
+            print(f"[bulk] pure-read error word after timing: {int(err.item())}", flush=True)
+            err.zero_()
+            print(f"[bulk] PURE-READ layer={layer} contiguous repacked: {t_c:.2f} us cold-L2 = {tbs_c:.2f} TB/s; "
+                  f"strided ORIGINAL layout (R row segments, same ring/issue): {t_s:.2f} us = {tbs_s:.2f} TB/s "
+                  f"-> {'repack is the lever' if t_c < 0.95 * t_s else 'repack is NOT the lever (bulk issue / no split-K is)'}",
+                  flush=True)
