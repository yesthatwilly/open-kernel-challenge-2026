+                except Exception as e:  # diagnostic only
+                    t_m = float("nan")
+                    print(f"[bulk] master timing unavailable for {layer} m={m}: {type(e).__name__}", flush=True)
+                inc = BULK_INCUMBENT_US.get((layer, m), float("nan"))
+                print(f"[bulk] TIME layer={layer} m={m}: bulk {t_f:.2f} us ({BULK_STREAM_BYTES / (t_f * 1e-6) / 1e12:.2f} TB/s eff), "
+                      f"pure-read {t_c:.2f} us, gap {t_f - t_c:+.2f} us; master path {t_m:.2f} us "
+                      f"(run 1602a4e947e64090 kernel {inc:.1f} us); eager cold-L2 prepare timings undercount the "
+                      f"judge profile by ~20-25%", flush=True)
