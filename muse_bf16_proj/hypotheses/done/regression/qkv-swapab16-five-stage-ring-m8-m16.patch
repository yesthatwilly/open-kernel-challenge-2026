+def _qkv16_s5_warm(state: dict) -> None:
+    """prepare()-only, every state (A and B), before any graph capture. Compile the 5-stage qkv_gate swapab16
+    variant on synthetic x, print its n_regs and compiled metadata.shared, and keep it only if shared <=
+    QKV16_S5_MAX_SHARED (2 CTAs/SM still fit); then warm every m in 1..16 at 5 stages (no Triton JIT inside a
+    capture or a timed call) and run the canary: at m in QKV16_S5_CANARY_MS the 5-stage output must be
+    torch.equal to the incumbent stage count's on the same x. Sets state["qkv16_s5_ready"] (and a reason in
+    state["qkv16_s5_info"]); the routing flag itself is decided by _qkv16_s5_prepare (A) or inherited (B).
+    Never raises."""
+    state["qkv16_s5_ready"] = False
+    state["qkv16_s5_info"] = "qkv_gate swapab16 path not prepared"
+    key = "qkv_gate"
+    if key not in state["swapab16_stages"]:
+        print(f"[qkv16-s5] {state['qkv16_s5_info']}: 5-stage variant off", flush=True)
+        return
+    n, k, split_k, block_k, _ = SWAPAB16_CFG[key]
+    w = state[key]
+    dev = w.device
+    ws, cnt = _swapab16_buffers(state, key)
+    base_stages = state["swapab16_stages"][key]
+    try:
+        x = torch.randn((SWAPAB16_MAX_M, k), device=dev, dtype=torch.float32).to(torch.bfloat16)
+        comp = []
+        _swapab16_forward(key, x, w, ws, cnt, QKV16_S5_STAGES, report=True, compiled_out=comp)
+        c = comp[0] if comp else None
+        md = getattr(c, "metadata", None)
+        shared = getattr(md, "shared", None)
+        if shared is None:
+            shared = getattr(c, "shared", None)
+        n_regs = getattr(c, "n_regs", None)
+        state["qkv16_s5_smem"] = shared
+        print(f"[qkv16-s5] qkv_gate swapab16 m<=16 N={n} K={k} SPLIT_K={split_k} BLOCK_K={block_k} "
+              f"stages={QKV16_S5_STAGES}: compiled.metadata.shared={shared} B (limit {QKV16_S5_MAX_SHARED} B for "
+              f"2 CTAs/SM), n_regs={n_regs}; incumbent stages={base_stages}", flush=True)
+        if shared is None:
+            state["qkv16_s5_info"] = "compiled.metadata.shared unavailable (cannot prove 2 CTAs/SM)"
+        elif int(shared) > QKV16_S5_MAX_SHARED:
+            state["qkv16_s5_info"] = (f"shared {int(shared)} B > {QKV16_S5_MAX_SHARED} B: 1 CTA/SM would push "
+                                      f"12 of 144 CTAs into a second wave")
+        else:
+            for m in range(1, SWAPAB16_MAX_M + 1):
+                xm = torch.randn((m, k), device=dev, dtype=torch.float32).to(torch.bfloat16)
+                _swapab16_forward(key, xm, w, ws, cnt, QKV16_S5_STAGES)
+            g = torch.Generator(device=dev)
+            g.manual_seed(24680)
+            bad = ""
+            for m in QKV16_S5_CANARY_MS:
+                xm = torch.randn((m, k), device=dev, dtype=torch.float32, generator=g).to(torch.bfloat16)
