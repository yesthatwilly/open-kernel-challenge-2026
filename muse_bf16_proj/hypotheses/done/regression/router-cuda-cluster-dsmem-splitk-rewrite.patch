+def _rc_check(state: dict, cs: int, ms) -> str:
+    """In-process self-check of cluster size cs at the token counts ms, each launched twice, with a
+    flushed print before and a synchronize + flushed print after every launch so a fault names its
+    kernel. Returns "" if it passes, else why. Bounds: rel L2 <= 2e-5 against x.double() @
+    router.double().T, worst row <= 1e-4 (5x), the one-hot power-of-two row within 1e-6 of the
+    hi + lo reconstruction, finite, run 2 bit-identical."""
+    router, hi, lo = state["router"], state["router_hi"], state["router_lo"]
+    dev = router.device
+    k = router.shape[1]
+    rd = router.double()
+    hld = hi.double() + lo.double()
+    g = torch.Generator(device=dev)
+    g.manual_seed(2468)
+    for m in ms:
+        x = torch.randn((m, k), device=dev, dtype=torch.float32, generator=g).to(torch.bfloat16)
+        if m >= 2:  # last row: a single power-of-two entry, its output is a (hi + lo) weight column
+            x[m - 1].zero_()
+            x[m - 1, (37 * m + 5) % k] = 2.0 ** ((m % 5) - 2)
+        ref = x.double() @ rd.T
+        ref_hl = x.double() @ hld.T
+        outs = []
+        for run in (1, 2):
+            print(f"[router_cluster] launching cs={cs} m={m} run {run}", flush=True)
+            o = _router_cluster_forward(x, state, cs)
+            torch.cuda.synchronize()
+            print(f"[router_cluster] cs={cs} m={m} run {run} finished OK", flush=True)
+            outs.append(o)
+        if not torch.equal(outs[0], outs[1]):
+            return f"m={m}: second launch differs from the first"
+        o = outs[0].double()
+        if not bool(torch.isfinite(o).all()):
+            return f"m={m}: non-finite output"
+        err = float((o - ref).norm() / ref.norm().clamp_min(1e-30))
+        row_ref = ref.norm(dim=1)
+        row_den = torch.maximum(row_ref, 0.1 * row_ref.mean()).clamp_min(1e-30)
+        row_err = float(((o - ref).norm(dim=1) / row_den).max())
+        if not (err <= 2e-5 and row_err <= 1e-4):
+            return f"m={m}: rel L2 {err:.2e} (bound 2e-5), worst row {row_err:.2e} (bound 1e-4)"
+        if m >= 2:
+            oh = float((o[m - 1] - ref_hl[m - 1]).norm() / ref_hl[m - 1].norm().clamp_min(1e-30))
+            if not oh <= 1e-6:
+                return f"m={m}: one-hot row off the hi+lo reconstruction by {oh:.2e} (bound 1e-6)"
+    return ""
+
+
+def _rc_time(state: dict) -> None:
+    """Diagnostic only (prepare): warm-L2 and cold-L2 cudaEvent time per launch, eager (so each
+    includes the launch), for the cluster kernel, the same kernel without the DSMEM reduce (mode
+    0: mainloop + partial store, no barriers) and master's _router_forward on the same x."""
+    hi, lo = state["router_hi"], state["router_lo"]
+    dev = hi.device
+    flush = torch.empty(ROUTER_CLUSTER_FLUSH_BYTES, dtype=torch.uint8, device=dev)
+    reps = 20
+
+    def timeit(fn, cold: bool) -> float:
+        for _ in range(3):
+            fn()
+        evs = []
+        for _ in range(reps):
+            if cold:
+                flush.zero_()
+            a = torch.cuda.Event(enable_timing=True)
+            b = torch.cuda.Event(enable_timing=True)
+            a.record()
+            fn()
+            b.record()
+            evs.append((a, b))
+        torch.cuda.synchronize()
+        ts = sorted(a.elapsed_time(b) * 1e3 for a, b in evs)
+        return ts[len(ts) // 2]
+
+    for m in (1, 8, 16, 32):
+        cs = state["router_cluster"][_rc_nt(m)]
+        if not cs:
+            continue
+        x = torch.randn((m, ROUTER_K), device=dev, dtype=torch.float32).to(torch.bfloat16)
+        row = {}
+        for cold in (False, True):
+            tag = "cold" if cold else "warm"
+            row[tag] = (timeit(lambda: _router_cluster_forward(x, state, cs, 1), cold),
+                        timeit(lambda: _router_cluster_forward(x, state, cs, 0), cold),
+                        timeit(lambda: _router_forward(x, hi, lo), cold))
+        print(f"[router_cluster] m={m} cs={cs} median us/launch (eager, incl. launch): "
+              + "; ".join(f"{t}-L2 cluster {v[0]:.2f} | no-DSMEM-reduce {v[1]:.2f} | master {v[2]:.2f}"
+                          for t, v in row.items()), flush=True)
+
+
+def _router_cluster_prepare(state: dict) -> None:
+    """Choose, per token tile NT in {8, 16, 32}, the cluster size the router runs at: CS = 8 if
+    cudaOccupancyMaxActiveClusters reports >= 16 clusters and the self-check passes, else CS = 4
+    (needs >= 32 clusters) likewise, else 0 (master's path, byte for byte). The result is a
+    constant in state, derived from synthetic data and the weights only; it never raises."""
+    choice = {8: 0, 16: 0, 32: 0}
+    state["router_cluster"] = choice
+    router = state["router"]
+    try:
+        if (_RC_EXT is None or router.shape != (ROUTER_N, ROUTER_K) or router.dtype != torch.float32
+                or not router.is_cuda):
+            raise RuntimeError("extension missing or router weight shape/dtype unexpected")
+        infos = {}
+        for cs in (8, 4):
+            for nt in (8, 16, 32):
+                infos[(cs, nt)] = _RC_EXT.router_info(cs, nt)
+                regs, spill, ssmem, dsmem, ncl = infos[(cs, nt)]
+                print(f"[router_cluster] cs={cs} nt={nt}: regs={regs} local(spill)={spill} B "
+                      f"static smem={ssmem} B dynamic smem={dsmem} B max active clusters={ncl}", flush=True)
+        for nt in (8, 16, 32):
+            ms = [m for m in ROUTER_CLUSTER_CHECK_MS if _rc_nt(m) == nt]
+            for cs, need in ((8, 16), (4, 32)):
+                ncl = infos[(cs, nt)][4]
+                if ncl < need:
+                    print(f"[router_cluster] nt={nt}: cs={cs} skipped, max active clusters {ncl} < {need}",
+                          flush=True)
+                    continue
+                why = _rc_check(state, cs, ms)
+                if why:
+                    print(f"[router_cluster] nt={nt}: cs={cs} self-check FAILED: {why}", flush=True)
+                    continue
+                print(f"[router_cluster] nt={nt}: cs={cs} self-check passed (m in {ms})", flush=True)
+                choice[nt] = cs
+                break
+    except Exception as e:
+        print(f"[router_cluster] prepare failed ({e!r}); master router path for every m", flush=True)
+        for nt in choice:
+            choice[nt] = 0
+    for m in range(1, ROUTER_CLUSTER_MAX_M + 1):
+        cs = choice[_rc_nt(m)]
+        print(f"[router_cluster] PATH CHOSEN router m={m}: "
+              + (f"CUDA cluster kernel, cluster size {cs}, NT {_rc_nt(m)}" if cs else "master Triton router"),
+              flush=True)
+    print("[router_cluster] PATH CHOSEN router m>32: master Triton router", flush=True)
+    if any(choice.values()):
+        try:
+            _rc_time(state)
+        except Exception as e:
+            print(f"[router_cluster] timing diagnostics failed: {e!r}", flush=True)
+
